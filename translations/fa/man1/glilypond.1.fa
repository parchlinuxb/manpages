.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_glilypond_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23\x27s MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY glilypond
.RB [ \-k ]
.RB [{ \-\-ly2eps | \-\-pdf2eps }]
.RB [ \-e
.IR directory ]
.RB [ \-o
.IR output-file ]
.RB [ \-p
.IR filename-prefix ]
.RB [ \-t
.IR tdir ]
.RB [{ \-v | \-V }]
.RB [ \-\- ]
.RI [ file\~ .\|.\|.]
.YS
.
.SY glilypond
.RB [{ \-\-ly2eps | \-\-pdf2eps }]
.RB [ \-\-eps_dir
.IR directory ]
.RB [ \-\-keep_all ]
.RB [ \-\-output
.IR output-file ]
.RB [ \-\-prefix
.IR filename-prefix ]
.RB [ \-\-temp_dir
.IR tdir ]
.RB [ \-\-verbose ]
.RB [ \-\- ]
.RI [ file\~ .\|.\|.]
.YS
.
.
.P
.SY glilypond
.B \-?
.YS
.
.SY glilypond
.B \-h
.YS
.
.SY glilypond
.B \-\-help
.YS
.
.SY glilypond
.B \-\-usage
.YS
.
.
.P
.SY glilypond
.B \-l
.YS
.
.SY glilypond
.B \-\-license
.YS
.
.
.P
.SY glilypond
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
دستور
.I glilypond
یک پیش‌پردازنده
.MR groff 7
است که امکان گنجاندن پارتیتورهای موسیقی LilyPond را در اسناد
.I groff
فراهم می‌سازد.
.
اگر هیچ عملوندی ارائه نشود،
یا اگر
.I file
برابر با
.RB \[lq] \- \[rq]
باشد،
.I glilypond
جریان ورودی استاندارد را می‌خواند.
.
یک آرگومان دوخط‌تیره
.RB (\[lq] \-\- \[rq])
باعث می‌شود تمامی آرگومان‌های پس از آن،
حتی اگر نام آن‌ها با خط تیره آغاز شود، به عنوان عملوندهای
.I file
تفسیر شوند.
.
.
.P
دستور
.I \%glilypond
به ماژول پرل
.I \%File::\:HomeDir
نیاز دارد که از طریق
.UR \%https://\:www\:.cpan\:.org
CPAN
.UE
در دسترس است.
.
.
.\" ====================================================================
.SH "کاربرد (USAGE)"
.\" ====================================================================
.
در حال حاضر،
.I glilypond
با دستگاه‌های خروجی
.BR ps ،
.BR dvi ،
.BR html
و
.B xhtml
در
.I groff
کار می‌کند.
.
دستگاه‌های
.B lbp
و
.B lj4
هنوز آزمایش نشده‌اند.
.
متأسفانه، دستگاه
.B pdf
هنوز کار نمی‌کند.
.
.
.\" ====================================================================
.SH "بررسی اجمالی گزینه‌ها (OPTION OVERVIEW)"
.\" ====================================================================
.
.
.TP
.BR \-? | \-h | \-\-help | \-\-usage
نمایش اطلاعات نحوه استفاده و خروج.
.
.TP
.B \%\-\-version
نمایش اطلاعات نسخه و خروج.
.
.TP
.BR \-l | \-\-license
نمایش اطلاعات مجوز حق نشر و خروج.
.
.
.\" ====================================================================
.SS "گزینه‌های ساخت فایل‌های EPS"
.\" ====================================================================
.
.TP
.B \-\-ly2eps
هدایت
.MR lilypond 1
برای ایجاد فایل‌های PostScript کپسوله‌شده (EPS).
.
این مقدار پیش‌فرض است.
.
.
.TP
.B \-\-pdf2eps
برنامه
.I glilypond
با استفاده از
.IR lilypond
یک فایل PDF تولید می‌کند.
.
سپس فایل EPS توسط
.I pdf2ps
و
.IR ps2eps
ایجاد می‌شود.
.
.
.\" ====================================================================
.SS "دایرکتوری‌ها و فایل‌ها"
.\" ====================================================================
.
.TP
.BR \-e | \-\-eps_dir "\fI directory_name\fP"
به‌طور معمول تمام فایل‌های
.I EPS
به دایرکتوری موقت ارسال می‌شوند.
.
با استفاده از این گزینه، می‌توانید دایرکتوری دلخواه خود را بسازید
که تمام فایل‌های مفید
.I EPS
به آن ارسال شوند.
.
بدین ترتیب در پایان، دایرکتوری موقت می‌تواند حذف شود.
.
.
.TP
.BR \-p | \-\-prefix "\fI begin_of_name\fP"
به‌طور معمول تمام فایل‌های موقت نام‌هایی دریافت می‌کنند که با پیشوند
.BI ly .\|.\|.\&
آغاز می‌شوند.
.
با استفاده از این گزینه، می‌توانید آزادانه این پیشوند را تغییر دهید.
.
.
.TP
.BR \-k | \-\-keep_all
به‌طور معمول تمام فایل‌های موقت به جز فایل‌های
.I eps
حذف می‌شوند.
.
با استفاده از این گزینه، تمام فایل‌های تولیدشده توسط برنامه
.I lilypond
یا سایر مبدل‌های فرمت نگه‌داشته می‌شوند.
.
.
.TP
.BR \-t | \-\-temp_dir "\fI dir\fP"
با استفاده از این گزینه، دایرکتوری پایه‌ای را برای دایرکتوری موقت مشخص می‌کنید.
.
نام این دایرکتوری عیناً و بدون هیچ پسوندی استفاده می‌شود.
.
اگر این دایرکتوری وجود نداشته باشد ایجاد می‌شود.
.
دایرکتوری موقت از طریق عملیات امنیتی پرل مستقیماً در زیر این دایرکتوری ایجاد می‌گردد.
.
فایل‌های موقت در این دایرکتوری موقت ذخیره می‌شوند.
.
.
.\" ====================================================================
.SS "خروجی"
.\" ====================================================================
.
.TP
.BR \-o | \-\-output "\fI file_name\fP"
به‌طور معمول تمام خروجی
.I groff
این برنامه به
.BR STDOUT
(خروجی استاندارد) ارسال می‌شود.
.
با استفاده از این گزینه، می‌توان آن را تغییر داد به طوری که خروجی در فایلی با نام مشخص‌شده در آرگومان گزینه
.IR file_name
ذخیره شود.
.
.
.TP
.BR \-v | \-V | \-\-verbose
اطلاعات بسیار بیشتری به STDERR (خطای استاندارد) ارسال می‌شود.
.
.
.\" ====================================================================
.SS "مجموعه گزینه‌های کوتاه"
.\" ====================================================================
.
مدیریت آرگومان‌های گزینه‌ها
.
.
.P
.I "گزینه‌های کوتاه"
آرگومان‌هایی هستند که با یک خط تیره تکی
.BR \-
آغاز می‌شوند.
.
چنین آرگومانی می‌تواند از تعداد دلخواهی گزینه بدون آرگومان تشکیل شود،
که به صورت مجموعه‌ای از نویسه‌های گزینه پس از خط تیره تکی قرار گرفته‌اند.
.
.
.P
چنین مجموعه‌ای می‌تواند با نویسه گزینه‌ای که به یک آرگومان گزینه نیاز دارد خاتمه یابد.
.
اگر این نویسه گزینه آخرین نویسه آرگومان نباشد، بخش پایانی آرگومان به عنوان آرگومان گزینه در نظر گرفته می‌شود.
.
اگر آخرین نویسه آرگومان باشد، آرگومان بعدی به عنوان آرگومان گزینه در نظر گرفته می‌شود.
.
.
.P
این رفتار، استاندارد مدیریت گزینه‌ها در
.I POSIX
و
.I GNU
است.
.
.
.P
برای مثال،
.
.TP
.BI \-kVe " some_dir"
مجموعه‌ای از گزینه‌های کوتاه
.B \-k
و
.B \-V
بدون آرگومان گزینه است، که به دنبال آن گزینه کوتاه
.B \-e
همراه با آرگومان گزینه که بخش بعدی آرگومان یعنی
.IR some_dir
است، قرار دارد.
.
بنابراین این آرگومان را می‌توان به صورت چند آرگومان مجزا نیز نوشت:
.B \-k \-V \-e
.IR some_dir .
.
.
.\" ====================================================================
.SS "مدیریت گزینه‌های بلند"
.\" ====================================================================
.
آرگومان‌هایی که با دو خط تیره
.B \-\-
آغاز می‌شوند، اصطلاحاً
.I "گزینه‌های بلند"
نامیده می‌شوند.
.
هر آرگومان دارای دو خط تیره تنها می‌تواند شامل یک گزینه بلند باشد.
.
.
.P
.I "گزینه‌های بلند"
می‌توانند دارای آرگومان گزینه باشند یا نباشند.
.
یک آرگومان گزینه می‌تواند آرگومان بعدی باشد یا با علامت مساوی
.B =
به همان آرگومان گزینه بلند متصل شود.
.
.
.TP
.B \-\-help
یک گزینه بلند بدون آرگومان گزینه است.
.
.TP
.BI \-\-eps_dir " some_dir"
.TQ
.BI \-\-eps_dir= some_dir
گزینه بلند
.B \-\-eps_dir
همراه با آرگومان گزینه
.IR some_dir
است.
.
.
.P
علاوه بر این، برنامه تا جای ممکن امکان خلاصه کردن گزینه‌های بلند را فراهم می‌سازد.
.
.
.P
گزینه بلند
.B \-\-keep_all
می‌تواند از
.B \-\-keep_al
تا
.B \-\-k
خلاصه شود، زیرا برنامه گزینه بلند دیگری ندارد که نام آن با نویسه
.BR k
آغاز شود.
.
.
.P
از سوی دیگر، گزینه
.B \%\-\-version
را نمی‌توان بیشتر از
.B \-\-vers
خلاصه کرد، زیرا گزینه بلند دیگری به نام
.B \-\-verbose
نیز وجود دارد که می‌تواند تا
.B \-\-verb
خلاصه شود.
.
.
.P
همچنین می‌توان یک آرگومان گزینه را به شکل خلاصه‌شده نیز متصل کرد.
.
بنابراین
.BI \-\-e= some_dir
مشابه با
.B \-\-eps_dir
.IR some_dir
است.
.
.
.P
علاوه بر این، این برنامه استفاده اختیاری از حروف کوچک و بزرگ را در نام گزینه‌ها مجاز می‌داند.
.
این سبک زبان
.I Perl
است.
.
.
.P
برای مثال، گزینه بلند
.B \-\-keep_all
می‌تواند به صورت
.B \-\-Keep_All
یا حتی به شکل خلاصه‌ای مانند
.BR \-\-KeE
نوشته شود.
.
.
.br
.ne 6v
.\" ====================================================================
.SH "ناحیه‌های LilyPond در ورودی \f[I]roff\f[]"
.\" ====================================================================
.
.\" ====================================================================
.SS "کد یکپارچه‌شده LilyPond"
.\" ====================================================================
.
یک بخش
.I lilypond
درون ساختاری که به زبان
.I groff
نوشته شده است، کل بخش میان نشانه‌های زیر است:
.RS
.EX
.B ".lilypond start"
.EE
.RE
و
.RS
.EX
.B ".lilypond end"
.EE
.RE
.
یک ورودی
.I groff
می‌تواند چندین مورد از این بخش‌های
.I lilypond
داشته باشد.
.
.
.P
هنگام پردازش چنین بخش
.I lilypond
میان
.B ".lilypond start"
و
.BR ".lilypond end" ،
می‌گوییم برنامه
.B glilypond
در
.IR "حالت lilypond"
(lilypond mode) قرار دارد.
.
.
.P
این بخش‌های
.I lilypond
به فایل‌های موقت
.I lilypond
با پسوند نام فایل
.BR .ly
ارسال می‌شوند.
.
این فایل‌ها بعداً به فایل‌های
.I EPS
تبدیل می‌گردند.
.
.
.\" ====================================================================
.SS "گنجاندن فایل‌های \f[I].ly\f[]"
.\" ====================================================================
.
یک دستور خط فرمان اضافی برای گنجاندن فایل‌های
.I lilypond
به صورت زیر در ورودی
.I groff
ارائه می‌شود:
.EX
.BI ".lilypond include" " file_name"
.EE
.
به ازای هر یک از چنین دستورات
.IR include ،
یک فایل از کدهای
.I lilypond
می‌تواند درون کدهای
.I groff
گنجانده شود.
.
تعداد دلخواهی از این دستورات می‌تواند در ورودی
.I groff
گنجانده شود.
.
.
.P
این دستورات گنجاندن تنها خارج از بخش‌های
.I lilypond
قابل استفاده هستند.
.
درون
.IR "حالت lilypond" ،
این عمل گنجاندن ممکن نیست.
.
بنابراین
.B ".lilypond include"
نباید در
.I "حالت lilypond"
استفاده شود؛ یعنی میان
.B ".lilypond start"
و
.BR ".lilypond end" .
.
.
این فایل‌های
.I ly
گنجانده‌شده نیز به فایل‌های
.I EPS
تبدیل می‌شوند.
.
.
.\" ====================================================================
.SH "فایل‌های تولیدشده (GENERATED FILES)"
.\" ====================================================================
.
در فرایند تبدیل بخش‌های
.I lilypond
به فایل‌های
.IR EPS ،
فایل‌های متعددی تولید می‌شوند.
.
به‌طور پیش‌فرض، این فایل‌ها به عنوان فایل‌های موقت در نظر گرفته شده و به همین صورت در یک دایرکتوری موقت ذخیره می‌شوند.
.
این فرایند را می‌توان با گزینه‌های خط فرمان تغییر داد.
.
.
.\" ====================================================================
.SS "گزینه‌های خط فرمان برای دایرکتوری‌ها"
.\" ====================================================================
.
دایرکتوری موقت برای این برنامه یا به‌طور خودکار ایجاد می‌شود یا می‌توان آن را با گزینه
.BR \-t | \-\-temp_dir
.IR dir
نام‌گذاری کرد.
.
.
.P
علاوه بر این، فایل‌های
.I EPS
که بعداً توسط دستور
.B .PSPIC
در خروجی نهایی
.I groff
ارجاع داده می‌شوند را می‌توان در دایرکتوری دیگری ذخیره کرد که توسط گزینه خط فرمان
.BR \-e | \-\-eps_dir
.IR directory_name
تعیین می‌شود.
.
با این گزینه، دایرکتوری موقت را می‌توان در پایان اجرای برنامه کاملاً حذف کرد.
.
.
.P
ابتدای نام فایل‌های موقت را می‌توان با گزینه‌های خط فرمان
.B \-p
یا
.BR \-\-prefix
تنظیم کرد.
.
.
.P
تمام فایل‌های موقت به جز فایل‌های
.I EPS
در نهایت حذف می‌شوند.
.
این رفتار را می‌توان با تنظیم گزینه‌های خط فرمان
.B \-k
یا
.BR \-\-keep_files
تغییر داد.
.
با این کار، تمام فایل‌ها و دایرکتوری‌های موقت نگه‌داشته شده و حذف نمی‌شوند.
.
.
.P
این فایل‌های
.I EPS
در یک دایرکتوری موقت یا دایرکتوری
.I EPS
ذخیره می‌شوند.
.
اما فرایند تبدیل نمی‌تواند آن‌ها را حذف کند، زیرا برای نمایش مورد نیاز هستند که ممکن است زمان زیادی به طول انجامد.
.
.
.\" ====================================================================
.SH "فرایندهای تبدیل برای تولید فایل‌های EPS"
.\" ====================================================================
.
.\" ====================================================================
.SS "حالت pdf2eps"
.\" ====================================================================
.
در این حالت، که پیش‌فرض فعلی است، فایل‌های
.B .ly
توسط برنامه
.MR lilypond 1
با استفاده از
.RS
.EX
.BI "lilypond \-\-pdf \-\-output=" file-name
.EE
.RE
به ازای هر فایل
.B .ly
به فایل‌های
.I PDF
تبدیل می‌شوند.
.
مقدار
.I file-name
باید بدون پسوند
.BR .pdf
ارائه شود.
.
از طریق این فرایند، فایلی به نام
.IB file-name .pdf
تولید می‌شود.
.
.
.P
گام بعدی تبدیل این فایل‌های
.I PDF
به یک فایل
.I PS
است.
.
این کار توسط برنامه
.MR pdf2ps 1
با استفاده از
.RS
.EX
$\~\c
.B pdf2ps\~\c
.IB file-name .pdf\~\c
.IB file-name .pds
.EE
.RE
انجام می‌شود.
.
.
گام بعدی، یک فایل
.I EPS
از فایل
.I PS
ایجاد می‌کند.
.
این کار توسط برنامه
.MR ps2eps 1
با استفاده از
.RS
.EX
.RB "$ " "ps2eps " \fIfile-name\fP ".ps"
.EE
.RE
انجام می‌شود.
.
.
.P
بدین ترتیب، یک فایل
.IB file-name .eps
برای هر بخش
.I lilypond
در فایل
.I groff
یا ورودی استاندارد ایجاد می‌شود.
.
.
.P
آخرین گام که باید انجام شود، جایگزینی تمام بخش‌های
.I lilypond
با دستور
.I groff
زیر است:
.RS
.EX
.BI ".PSPIC " file-name .eps
.EE
.RE
.
.
.\" ====================================================================
.SS "حالت ly2eps"
.\" ====================================================================
.
در گذشته، این حالت پیش‌فرض بود.
.
اما اکنون دیگر کار نمی‌کند، بنابراین حالت پیش‌فرض جدید یعنی
.I pdf2eps
را بپذیرید.
.
برای آزمایش، این حالت را نیز می‌توان با گزینه
.BR \-\-ly2eps
در
.I glilypond
انتخاب کرد.
.
.
.P
در این حالت، فایل‌های
.B .ly
توسط برنامه
.I lilypond
با استفاده از دستور
.RS
.EX
$\~\c
.B lilypond \-\-ps \-dbackend=eps \-dgs\-load\-fonts \-\-output=\c
.I file-name
.EE
.RE
به ازای هر فایل
.B .ly
به فایل‌های متعدد با فرمت‌های گوناگون از جمله فایل‌های
.I eps
تبدیل می‌شوند.
.
نام فایل خروجی
.I file\-name
باید بدون پسوند ارائه شود و دایرکتوری آن موقت است.
.
.
.P
فایل‌های
.I EPS
متعددی ایجاد می‌شوند.
.
یکی شامل فایل تبدیل‌شده کامل
.BR ly ،
به نام
.IB file\-name .eps \fR.\fP
.
.
.P
علاوه بر این، فایل‌های
.I EPS
برای هر صفحه وجود دارد، به نام
.IB file\-name \- digit .eps \fR.\fP
.
.
.P
آخرین مرحله، جایگزینی تمام بخش‌های
.I lilypond
با مجموعه‌ای از فایل‌های صفحات
.I EPS
مربوطه است.
.
این کار با دستورات
.I groff
زیر انجام می‌شود:
.EX
.BI ".PSPIC " file-name \- digit .eps
.EE
.
.
.\" ====================================================================
.SH "خروجی \f[I]groff\f[] تولیدشده"
.\" ====================================================================
.
ساختار جدید
.MR groff 7
تولیدشده توسط
.I glilypond
یا:
.
.TP
1)
به خروجی استاندارد ارسال می‌شود و در آنجا می‌تواند در یک فایل ذخیره شده یا به
.MR groff 1
پایپ (هدایت) شود، و یا
.
.TP
2)
با تعیین گزینه
.BR \-o\ \~| \~\-\-output
.I file_name
در یک فایل ذخیره شود.
.
.
.\" ====================================================================
.SH "نویسندگان (AUTHORS)"
.\" ====================================================================
.
برنامه
.I glilypond
توسط
.MT groff\-bernd\:.warken\-72@\:web\:.de
Bernd Warken
.ME
نوشته شده است.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.TP
.MR groff 1
نحوه استفاده از دستور
.I groff
را شرح می‌دهد و حاوی ارجاعاتی به مستندات تکمیلی سیستم
.I groff
است.
.
.
.TP
.MR groff_tmac 5
درخواست
.B .PSPIC
را شرح می‌دهد.
.
.
.TP
.MR lilypond 1
به طور خلاصه دستور
.I lilypond
را شرح می‌دهد و حاوی ارجاعاتی به مستندات تکمیلی است.
.
.
.TP
.MR pdf2ps 1
یک فایل
.I PDF
را به فرمت
.I PostScript
تبدیل می‌کند.
.
.
.TP
.MR ps2eps 1
یک فایل
.I PS
را به فرمت
.I EPS
تبدیل می‌کند.
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_glilypond_1_man_C]
.do rr *groff_glilypond_1_man_C
.
.
