.TH "dsr2html" 1 "Thu Jul 9 2026 18:43:40" "Version 3.7.0" "OFFIS DCMTK" \" -*- nroff -*-
.nh
.SH "نام (NAME)"
dsr2html \- تبدیل و رندر فایل و مجموعه‌داده DICOM SR به HTML/XHTML
.PP

.SH "خلاصه دستور (SYNOPSIS)"
.PP
.PP
.nf
dsr2html [options] dsrfile-in [htmlfile-out]
.fi
.PP
.SH "توضیحات (DESCRIPTION)"
.PP
ابزار \fBdsr2html\fP محتوای یک سند گزارش‌دهی ساختاریافته دایکام (DICOM SR) را (در قالب فایل یا مجموعه‌داده خام) به فرمت HTML (زبان نشانه‌گذاری ابرمتن) نسخه 3\&.2 یا 4\&.01 و همچنین XHTML (زبان نشانه‌گذاری ابرمتن توسعه‌پذیر) نسخه 1\&.1 تبدیل و رندر می‌کند\&.

.PP
اگر \fBdsr2html\fP یک مجموعه‌داده خام (داده‌های دایکام فاقد فراداده هدر فایل) را بخواند، تلاش می‌کند سینتکس انتقال (Transfer Syntax) را با بررسی چند بایت اول فایل حدس بزند\&. حدس زدن صحیح سینتکس انتقال همیشه ممکن نیست و بهتر است در صورت امکان، مجموعه‌داده با استفاده از ابزار \fBdcmconv\fP به قالب فایل استاندارد تبدیل شود\&. همچنین می‌توان از گزینه‌های \fI-f\fP و \fI-t[ieb]\fP برای اجبار \fBdsr2html\fP به خواندن مجموعه‌داده با یک سینتکس انتقال مشخص استفاده کرد\&.
.SH "پارامترها (PARAMETERS)"
.PP
.PP
.nf
dsrfile-in    نام فایل ورودی DICOM SR برای رندر شدن ("-" برای ورودی استاندارد stdin)

htmlfile-out  نام فایل خروجی HTML/XHTML (پیش‌فرض: خروجی استاندارد stdout)
.fi
.PP
.SH "گزینه‌ها (OPTIONS)"
.PP
.SS "گزینه‌های عمومی (general options)"
.PP
.nf
  -h   --help
         چاپ این متن راهنما و خروج

       --version
         چاپ اطلاعات نسخه و خروج

       --arguments
         چاپ آرگومان‌های بسط‌یافته خط فرمان

  -q   --quiet
         حالت بی‌صدا، عدم چاپ هشدارها و خطاها

  -v   --verbose
         حالت پرگو، چاپ جزئیات پردازش

  -d   --debug
         حالت اشکال‌زدایی، چاپ اطلاعات دیباگ

  -ll  --log-level  [l]evel: string constant
         (fatal, error, warn, info, debug, trace)
         استفاده از سطح l برای ثبت‌کننده گزارش

  -lc  --log-config  [f]ilename: string
         استفاده از فایل پیکربندی f برای ثبت‌کننده گزارش
.fi
.PP
.SS "گزینه‌های ورودی (input options)"
.PP
.nf
قالب فایل ورودی:

  +f   --read-file
         خواندن قالب فایل یا مجموعه‌داده (پیش‌فرض)

  +fo  --read-file-only
         خواندن فقط قالب فایل

  -f   --read-dataset
         خواندن مجموعه‌داده بدون اطلاعات فراداده فایل

سینتکس انتقال ورودی:

  -t=  --read-xfer-auto
         استفاده از تشخیص خودکار سینتکس انتقال (پیش‌فرض)

  -td  --read-xfer-detect
         نادیده گرفتن سینتکس انتقال مشخص‌شده در هدر فایل

  -te  --read-xfer-little
         خواندن با سینتکس انتقال explicit VR little endian

  -tb  --read-xfer-big
         خواندن با سینتکس انتقال explicit VR big endian

  -ti  --read-xfer-implicit
         خواندن با سینتکس انتقال implicit VR little endian
.fi
.PP
.SS "گزینه‌های پردازش (processing options)"
.PP
.nf
اطلاعات تکمیلی:

  -Ip  --processing-details
         نمایش آیتم محتوایی که هم‌اکنون در حال پردازش است

مدیریت خطا:

  -Er  --unknown-relationship
         پذیرش نوع رابطه ناشناخته یا ناموجود

  -Ev  --invalid-item-value
         پذیرش مقدار نامعتبر برای آیتم محتوا
         (برای مثال، نقض تعریف VR یا VM)

  -Ec  --ignore-constraints
         نادیده گرفتن محدودیت‌های محتوایی رابطه

  -Ee  --ignore-item-errors
         عدم توقف در صورت بروز خطای آیتم محتوا، فقط هشدار دادن
         (برای مثال، عدم وجود مشخصه‌های خاص نوع مقدار)

  -Ei  --skip-invalid-items
         رد کردن آیتم‌های محتوای نامعتبر (شامل زیردرخت آن‌ها)

  -Dv  --disable-vr-checker
         غیرفعال کردن بررسی انطباق مقادیر رشته‌ای با VR

مجموعه نویسه‌های خاص (specific character set):

  +Cr  --charset-require
         الزام اعلام مجموعه نویسه توسعه‌یافته (پیش‌فرض)

  +Ca  --charset-assume  [c]harset: string
         فرض کردن مجموعه نویسه c در صورت عدم اعلام مجموعه نویسه توسعه‌یافته

       --charset-check-all
         بررسی تمام عناصر داده با مقادیر رشته‌ای
         (پیش‌فرض: فقط PN, LO, LT, SH, ST, UC و UT)

         # این گزینه فقط برای بررسی توسعه‌یافته جهت لزوم حضور
         # مشخصه Specific Character Set (0008,0005) استفاده می‌شود،
         # اما برای تبدیل مقادیر عناصر نامتأثر به UTF-8 کاربرد ندارد
         # (مانند مقادیر عنصری با VR از نوع CS)

  +U8  --convert-to-utf8
         تبدیل تمام مقادیر عناصر متأثر از
         Specific Character Set (0008,0005) به UTF-8

         # نیازمند پشتیبانی از سوی کتابخانه کدگذاری نویسه زیرین است
         # (برای اطلاع از اینکه کدام‌یک موجود است، به خروجی --version مراجعه کنید)
.fi
.PP
.SS "گزینه‌های خروجی (output options)"
.PP
.nf
سازگاری HTML/XHTML:

  +H3  --html-3\&.2
         استفاده از ویژگی‌های سازگار با HTML نسخه 3\&.2 تنها

  +H4  --html-4\&.0
         مجاز دانستن تمام ویژگی‌های HTML نسخه 4\&.01 (پیش‌فرض)

  +X1  --xhtml-1\&.1
         انطباق با مشخصات XHTML نسخه 1\&.1

  +Hd  --add-document-type
         افزودن ارجاع به تعریف نوع سند SGML

شیوه‌نامه آبشاری (CSS)، همراه با HTML 3\&.2 قابل استفاده نیست:

  +Sr  --css-reference  URL: string
         افزودن ارجاع به CSS مشخص‌شده در سند

  +Sf  --css-file  [f]ilename: string
         قراردادن مستقیم محتوای CSS مشخص‌شده درون سند

رندر عمومی:

  +Ri  --expand-inline
         بسط آیتم‌های محتوای کوتاه درون‌خطی (پیش‌فرض)

  -Ri  --never-expand-inline
         هرگز بسط ندادن آیتم‌های محتوا به صورت درون‌خطی

  +Ra  --always-expand-inline
         همیشه بسط دادن آیتم‌های محتوا به صورت درون‌خطی

  +Rd  --render-full-data
         رندر کامل داده‌های آیتم‌های محتوا

  +Rt  --section-title-inline
         رندر عنوان‌های بخش به صورت درون‌خطی، نه جداگانه

  +Rh  --hyperlink-url-prefix  [p]refix: string
         استفاده از پیشوند URL p برای پیوندها به اشیاء ترکیبی
         (پیش‌فرض: http://localhost/dicom\&.cgi)

رندر سند:

  +Dt  --document-type-title
         استفاده از نوع سند به عنوان عنوان سند (پیش‌فرض)

  +Dp  --patient-info-title
         استفاده از اطلاعات بیمار به عنوان عنوان سند

  -Dh  --no-document-header
         عدم رندر اطلاعات عمومی سند

رندر کدها:

  +Ci  --render-inline-codes
         رندر کدها در بلوک‌های متنی پیوسته

  +Cn  --concept-name-codes
         رندر کد نام‌های مفهوم (Concept Names)

  +Cu  --numeric-unit-codes
         رندر کد واحدهای سنجش عددی

  +Cv  --code-value-unit
         استفاده از مقدار کد به عنوان واحد سنجش (پیش‌فرض)

  +Cm  --code-meaning-unit
         استفاده از مفهوم کد به عنوان واحد سنجش

  +Cc  --render-all-codes
         رندر تمام کدها (شامل +Ci، +Cn و +Cu)

  +Ct  --code-details-tooltip
         رندر جزئیات کد به صورت تول‌تیپ (راهنمای شناور) (شامل +Cc)
.fi
.PP
.SH "نکات (NOTES)"
.PP
.SS "انطباق با دایکام (DICOM Conformance)"
