.B class sphinx.addnodes.desc_sig_literal_number(rawsource: str \%<https://\:docs\:.python\:.org/\:3/\:library/\:stdtypes\:.html#\:str> = \(aq\(aq, text: str \%<https://\:docs\:.python\:.org/\:3/\:library/\:stdtypes\:.html#\:str> = \(aq\(aq, *children: Element, **attributes: Any)
