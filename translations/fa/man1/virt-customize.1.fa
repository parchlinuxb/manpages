\&\fBvirt\-sparsify\fR\|(1),
\&\fBvirt\-sysprep\fR\|(1),
\&\fBvirsh\fR\|(1),
\&\fBlvcreate\fR\|(8),
\&\fBqemu\-img\fR\|(1),
\&\fBscrub\fR\|(1),
http://libguestfs.org/,
http://libvirt.org/.
