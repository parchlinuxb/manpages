.ie \n(.g .ds Aq \(aq
.el .ds Aq '
.TH vmexec-manpage 1  "manpage " 
.SH "نام (NAME)"
vmexec\-manpage \- Print man page
.SH "خلاصه دستور (SYNOPSIS)"
\fBvmexec manpage\fR [\fB\-h\fR|\fB\-\-help\fR] <\fIOUT_DIR\fR> 
.SH "توضیحات (DESCRIPTION)"
Print man page
.SH "گزینه‌ها (OPTIONS)"
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
<\fIOUT_DIR\fR>

