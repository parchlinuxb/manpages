.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-cluster-agent-token-list \- List tokens for a GitLab Agent for Kubernetes.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab cluster agent token list  [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Lists all tokens for the specified agent. Requires the numeric agent ID.


.SH "گزینه‌ها (OPTIONS)"
\fB--jq\fP=""
	Filter JSON output with a jq expression.

.PP
\fB-F\fP, \fB--output\fP="text"
	Format output as: text, json.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-h\fP, \fB--help\fP[=false]
	Show help for this command.

.PP
\fB-R\fP, \fB--repo\fP=""
	Select another repository. You can use either OWNER/REPO or GROUP/NAMESPACE/REPO. The full URL or Git URL is also accepted.


.SH "مثال (EXAMPLE)"
.EX
# List tokens for agent 123
glab cluster agent token list 123

# List tokens in JSON format
glab cluster agent token list 123 --output json
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-cluster-agent-token(1)\fP
