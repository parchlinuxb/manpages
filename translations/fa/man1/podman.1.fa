podman-restart(1)	T{
راه‌اندازی مجدد یک یا چند کانتینر.
T}
podman-rm(1)	حذف یک یا چند کانتینر.
podman-rmi(1)	T{
حذف یک یا چند ایمیج ذخیره‌شده به صورت محلی.
T}
podman-run(1)	T{
اجرای یک دستور در یک کانتینر جدید.
T}
podman-save(1)	T{
ذخیره ایمیج(ها) در یک فایل آرشیو یا دایرکتوری.
T}
podman-search(1)	T{
جستجوی یک ایمیج در یک رجیستری.
T}
podman-secret(1)	مدیریت داده‌های محرمانه (Secrets) در پودمن.
podman-start(1)	شروع یک یا چند کانتینر.
podman-stats(1)	T{
نمایش جریان زنده آمارهای مصرف منابع یک یا چند کانتینر.
T}
podman-stop(1)	T{
متوقف کردن یک یا چند کانتینر در حال اجرا.
T}
podman-system(1)	مدیریت پودمن.
podman-tag(1)	T{
افزودن یک نام اضافی (تگ) به یک ایمیج محلی.
T}
podman-top(1)	T{
نمایش فرایندهای در حال اجرای یک کانتینر.
T}
podman-unmount(1)	T{
آزاد کردن مانت فایل‌سیستم ریشه یک کانتینر فعال.
T}
