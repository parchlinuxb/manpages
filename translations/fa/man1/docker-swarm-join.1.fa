.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-swarm-join \- پیوستن به یک swarm به‌صورت یک گره و/یا مدیر


.SH "خلاصه (SYNOPSIS)"
\fBdocker swarm join [OPTIONS] HOST:PORT\fP


.SH "شرح (DESCRIPTION)"
پیوستن به یک swarm به‌صورت یک گره و/یا مدیر


.SH "گزینه‌ها (OPTIONS)"
\fB--advertise-addr\fP=""
	نشانی تبلیغ‌شده (فرمت: "[:port]")

.PP
\fB--availability\fP="active"
	در دسترس بودن گره ("active"، "pause"، "drain")

.PP
\fB--data-path-addr\fP=""
	نشانی یا رابط مورد استفاده برای ترافیک مسیر داده (فرمت: "")

.PP
\fB--listen-addr\fP=0.0.0.0:2377
	نشانی شنود (فرمت: "[:port]")

.PP
\fB--token\fP=""
	توکن برای ورود به swarm


.SH "ببینید (SEE ALSO)"
\fBdocker-swarm(1)\fP
