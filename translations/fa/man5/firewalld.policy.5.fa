.\"  Language: Persian
.\"
.TH "FIREWALLD\&.POLICY" "5" "" "firewalld 2.5.1" "firewalld.policy"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
firewalld.policy \- پرونده‌های پیکربندی سیاست firewalld
.SH "خلاصه دستور (SYNOPSIS)"
.PP
\fI/etc/firewalld/policies/policy\&.xml\fR
.PP
\fI/usr/lib/firewalld/policies/policy\&.xml\fR
.SH "توضیحات (DESCRIPTION)"
.PP
یک پرونده پیکربندی سیاست firewalld شامل اطلاعات مربوط به یک سیاست (policy) است. این موارد شامل توضیحات سیاست، سرویس‌ها، درگاه‌ها، پروتکل‌ها، icmp\-blockها، مبدل‌سازی نشانی (masquerade)، فوروارد درگاه‌ها (forward\-ports) و قواعد زبان پیشرفته (rich language rules) در قالب یک پرونده XML است. نام پرونده باید
\fIpolicy_name\fR\&.xml باشد که در آن طول
\fIpolicy_name\fR
در حال حاضر به ۱۷ نویسه محدود شده است.
.PP
ساختار یک پرونده پیکربندی سیاست به شرح زیر است:
.sp
.if n \{\
.RS 4
.\}
.nf
<?xml version="1\&.0" encoding="utf\-8"?>
<policy [version="\fIversionstring\fR"] [target="\fICONTINUE\fR|\fIACCEPT\fR|\fIREJECT\fR|\fIDROP\fR"] [priority="\fIpriority\fR"]>
    [ <disable/> ]
    [ <ingress\-zone name="\fIzone\fR"/> ]
    [ <egress\-zone name="\fIzone\fR"/> ]

    



    [ <short>\fIshort description\fR</short> ]
    [ <description>\fIdescription\fR</description> ]
    [ <service name="\fIstring\fR"/> ]
    [ <port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"/> ]
    [ <protocol value="\fIprotocol\fR"/> ]
    [ <icmp\-block name="\fIstring\fR"/> ]
    [ <masquerade/> ]
    [ <forward\-port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR" [to\-port="\fIportid\fR[\-\fIportid\fR]"] [to\-addr="\fIIP address\fR"]/> ]
    [ <source\-port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"/> ]
    [
        <rule [family="\fIipv4\fR|\fIipv6\fR"] [priority="\fIpriority\fR"]>
            [ <source address="\fIaddress\fR[/\fImask\fR]"|mac="\fIMAC\fR"|ipset="\fIipset\fR" [invert="\fITrue\fR"]/> ]
            [ <destination address="\fIaddress\fR[/\fImask\fR]"|ipset="\fIipset\fR" [invert="\fITrue\fR"]/> ]
            [
                <service name="\fIstring\fR"/> |
                <port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"/> |
                <protocol value="\fIprotocol\fR"/> |
                <icmp\-block name="\fIicmptype\fR"/> |
                <icmp\-type name="\fIicmptype\fR"/> |
                <masquerade/> |
                <forward\-port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR" [to\-port="\fIportid\fR[\-\fIportid\fR]"] [to\-addr="\fIaddress\fR"]/>
            ]
            [
                <log [prefix="\fIprefix text\fR"] [level="\fIemerg\fR|\fIalert\fR|\fIcrit\fR|\fIerr\fR|\fIwarn\fR|\fInotice\fR|\fIinfo\fR|\fIdebug\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </log> |
                <nflog [group="\fIgroup id\fR"] [prefix="\fIprefix text\fR"] [queue\-size="\fIthreshold\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </nflog>
            ]
            [ <audit> [<limit value="\fIrate\fR/\fIduration\fR"/>] </audit> ]
            [
                <accept> [<limit value="\fIrate\fR/\fIduration\fR"/>] </accept> |
                <reject [type="\fIrejecttype\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </reject> |
                <drop> [<limit value="\fIrate\fR/\fIduration\fR"/>] </drop> |
                <mark set="\fImark\fR[/\fImask\fR]"> [<limit value="\fIrate\fR/\fIduration\fR"/>] </mark>
            ]
        </rule>
    ]


</policy>
            
.fi
.if n \{\
.RE
.\}
.PP
پیکربندی می‌تواند شامل این برچسب‌ها و ویژگی‌ها باشد. برخی از آن‌ها اجباری و برخی دیگر اختیاری هستند\&.
.SS "policy"
.PP
برچسب آغازین و پایانی اجباری policy سیاست را تعریف می‌کند\&. این برچسب تنها یک‌بار می‌تواند در یک پرونده پیکربندی سیاست استفاده شود\&. ویژگی‌های اختیاری برای policy عبارتند از:
.PP
version="\fIstring\fR"
.RS 4
برای تعیین نگارش سیاست\&.
.RE
.PP
target="\fICONTINUE\fR|\fIACCEPT\fR|\fIREJECT\fR|\fIDROP\fR"
.RS 4
می‌تواند برای پذیرش (accept)، رد کردن (reject) یا انداختن (drop) هر بسته‌ای که با هیچ قاعده‌ای (درگاه، سرویس و غیره) تطابق ندارد استفاده شود\&. مقدار
\fICONTINUE\fR
پیش‌فرض است و برای سیاست‌هایی که پایانه‌دار نیستند (non\-terminal) استفاده می‌شود\&.
.RE
.SS "disable"
.PP
یک برچسب عنصر خالی اختیاری است\&. این برچسب تنها یک‌بار می‌تواند استفاده شود\&. در صورت وجود، سیاست غیرفعال شده و اعمال نخواهد شد\&.
.SS "ingress\-zone"
.PP
یک عنصر اختیاری که می‌تواند چندین بار استفاده شود\&. این عنصر می‌تواند نام یک ناحیه (zone) در firewalld یا یکی از نواحی نمادین HOST یا ANY باشد\&. برای اطلاعات بیشتر در مورد نواحی نمادین،
\fBfirewalld.policies\fR(5)
را ببینید\&.
.SS "egress\-zone"
.PP
یک عنصر اختیاری که می‌تواند چندین بار استفاده شود\&. این عنصر می‌تواند نام یک ناحیه (zone) در firewalld یا یکی از نواحی نمادین HOST یا ANY باشد\&. برای اطلاعات بیشتر در مورد نواحی نمادین،
\fBfirewalld.policies\fR(5)
را ببینید\&.
.SS "short"
.PP
یک برچسب اختیاری آغازین و پایانی است و برای ارائه یک نام خواناتر به کار می‌رود\&.
.SS "description"
.PP
یک برچسب اختیاری آغازین و پایانی است و برای درج توضیحات به کار می‌رود\&.
.SS "service"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای فعال‌سازی بیش از یک مدخل سرویس استفاده شود\&. یک مدخل سرویس دقیقاً یک ویژگی دارد:
.PP
name="\fIstring\fR"
.RS 4
نام سرویسی که باید فعال شود\&. برای دریافت فهرستی از نام‌های معتبر سرویس‌ها می‌توان از دستور
\fBfirewall\-cmd \-\-get\-services\fR
استفاده کرد\&.
.RE
.SS "port"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک مدخل درگاه استفاده شود\&. تمام ویژگی‌های یک مدخل درگاه اجباری هستند:
.PP
port="\fIportid\fR[\-\fIportid\fR]"
.RS 4
درگاه می‌تواند یک شماره درگاه تکی
\fIportid\fR
یا یک محدوده درگاه
\fIportid\fR\-\fIportid\fR
باشد\&.
.RE
.PP
protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"
.RS 4
پروتکل می‌تواند یکی از موارد
\fItcp\fR،
\fIudp\fR،
\fIsctp\fR
یا
\fIdccp\fR
باشد\&.
.RE
.SS "protocol"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک مدخل پروتکل استفاده شود\&. هر پروتکل دقیقاً یک ویژگی دارد:
.PP
value="\fIstring\fR"
.RS 4
پروتکل می‌تواند هر پروتکلی باشد که توسط سیستم پشتیبانی می‌شود\&. لطفاً برای پروتکل‌های پشتیبانی‌شده به
\fI/etc/protocols\fR
نگاهی بیندازید\&.
.RE
.SS "icmp\-block"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک مدخل icmp\-block استفاده شود\&. هر برچسب icmp\-block دقیقاً یک ویژگی اجباری دارد:
.PP
name="\fIstring\fR"
.RS 4
نام نوع پروتکل پیام کنترل اینترنت (ICMP) که باید مسدود شود\&. برای دریافت فهرستی از انواع معتبر ICMP می‌توان از دستور
\fBfirewall\-cmd \-\-get\-icmptypes\fR
استفاده کرد\&.
.RE
.SS "masquerade"
.PP
یک برچسب عنصر خالی اختیاری است\&. این برچسب تنها یک‌بار می‌تواند استفاده شود\&. در صورت وجود، مبدل‌سازی نشانی (masquerading) فعال می‌شود\&.
.SS "forward\-port"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک مدخل بازوجایابی (فوروارد) درگاه یا بسته استفاده شود\&. ویژگی‌های اجباری و همچنین اختیاری برای forward\-port وجود دارند:
.sp
.it 1 an-trap
.nr an-no-space-flag 1
.nr an-break-flag 1
.br
.ps +1
\fBویژگی‌های اجباری:\fR
.RS 4
.PP
درگاه و پروتکل محلی که باید فوروارد شوند\&.
.PP
port="\fIportid\fR[\-\fIportid\fR]"
.RS 4
درگاه می‌تواند یک شماره درگاه تکی
\fIportid\fR
یا یک محدوده درگاه
\fIportid\fR\-\fIportid\fR
باشد\&.
.RE
.PP
protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"
.RS 4
پروتکل می‌تواند یکی از موارد
\fItcp\fR،
\fIudp\fR،
\fIsctp\fR
یا
\fIdccp\fR
باشد\&.
.RE
.RE
.sp
.it 1 an-trap
.nr an-no-space-flag 1
.nr an-break-flag 1
.br
.ps +1
\fBویژگی‌های اختیاری:\fR
.RS 4
.PP
مقصد فوروارد\&. برای فوروارد محلی تنها
\fBto\-port\fR
را اضافه کنید\&. برای فوروارد از راه دور
\fBto\-addr\fR
را اضافه کرده و در صورتی که درگاه مقصد در رایانه مقصد متفاوت باشد، به صورت اختیاری از
\fBto\-port\fR
استفاده کنید\&.
.PP
to\-port="\fIportid\fR[\-\fIportid\fR]"
.RS 4
درگاه مقصد یا محدوده درگاه مقصد برای فوروارد به آن\&. در صورت حذف، مقدار ویژگی port= به همراه ویژگی to\-addr استفاده خواهد شد\&.
.RE
.PP
to\-addr="\fIaddress\fR"
.RS 4
نشانی IP مقصد برای IPv4 یا IPv6\&.
.RE
.RE
.SS "source\-port"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک مدخل درگاه مبدا استفاده شود\&. تمام ویژگی‌های یک مدخل درگاه مبدا اجباری هستند:
.PP
port="\fIportid\fR[\-\fIportid\fR]"
.RS 4
درگاه می‌تواند یک شماره درگاه تکی
\fIportid\fR
یا یک محدوده درگاه
\fIportid\fR\-\fIportid\fR
باشد\&.
.RE
.PP
protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"
.RS 4
پروتکل می‌تواند یکی از موارد
\fItcp\fR،
\fIudp\fR،
\fIsctp\fR
یا
\fIdccp\fR
باشد\&.
.RE
.SS "rule"
.PP
یک برچسب عنصر اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک مدخل قاعده زبان پیشرفته (rich language) استفاده شود\&.
.PP
ساختار کلی قاعده:
.PP
.if n \{\
.RS 4
.\}
.nf
<rule [family="\fIipv4\fR|\fIipv6\fR"] [priority="\fIpriority\fR"]>
    [ <source address="\fIaddress\fR[/\fImask\fR]"|mac="\fIMAC\fR"|ipset="\fIipset\fR" [invert="\fITrue\fR"]/> ]
    [ <destination address="\fIaddress\fR[/\fImask\fR]"|ipset="\fIipset\fR" [invert="\fITrue\fR"]/> ]
    [
        <service name="\fIstring\fR"/> |
        <port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"/> |
        <protocol value="\fIprotocol\fR"/> |
        <icmp\-block name="\fIicmptype\fR"/> |
        <icmp\-type name="\fIicmptype\fR"/> |
        <masquerade/> |
        <forward\-port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR" [to\-port="\fIportid\fR[\-\fIportid\fR]"] [to\-addr="\fIaddress\fR"]/> |
        <source\-port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"/> |
    ]
    [
        <log [prefix="\fIprefix text\fR"] [level="\fIemerg\fR|\fIalert\fR|\fIcrit\fR|\fIerr\fR|\fIwarn\fR|\fInotice\fR|\fIinfo\fR|\fIdebug\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </log> |
        <nflog [group="\fIgroup id\fR"] [prefix="\fIprefix text\fR"] [queue\-size="\fIthreshold\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </nflog>
    ]
    [ <audit> [<limit value="\fIrate\fR/\fIduration\fR"/>] </audit> ]
    [
        <accept> [<limit value="\fIrate\fR/\fIduration\fR"/>] </accept> |
        <reject [type="\fIrejecttype\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </reject> |
        <drop> [<limit value="\fIrate\fR/\fIduration\fR"/>] </drop> |
        <mark set="\fImark\fR[/\fImask\fR]"> [<limit value="\fIrate\fR/\fIduration\fR"/>] </mark>
    ]
</rule>
        
.fi
.if n \{\
.RE
.\}
.PP
ساختار قاعده برای فهرست سیاه یا سفید مبدا:
.PP
.if n \{\
.RS 4
.\}
.nf
<rule [family="\fIipv4\fR|\fIipv6\fR"] [priority="\fIpriority\fR"]>
    <source address="\fIaddress\fR[/\fImask\fR]"|mac="\fIMAC\fR"|ipset="\fIipset\fR" [invert="\fITrue\fR"]/>
    [
        <log [prefix="\fIprefix text\fR"] [level="\fIemerg\fR|\fIalert\fR|\fIcrit\fR|\fIerr\fR|\fIwarn\fR|\fInotice\fR|\fIinfo\fR|\fIdebug\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </log> |
        <nflog [group="\fIgroup id\fR"] [prefix="\fIprefix text\fR"] [queue\-size="\fIthreshold\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </nflog>
    ]
    [ <audit> [<limit value="\fIrate\fR/\fIduration\fR"/>] </audit> ]
    <accept> [<limit value="\fIrate\fR/\fIduration\fR"/>] </accept> |
    <reject [type="\fIrejecttype\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </reject> |
    <drop> [<limit value="\fIrate\fR/\fIduration\fR"/>] </drop>
</rule>
        
.fi
.if n \{\
.RE
.\}
.PP
برای توضیحات کامل درباره قواعد زبان پیشرفته، لطفاً به
\fBfirewalld.richlanguage\fR(5)
مراجعه کنید\&.
.SH "همچنین ببینید (SEE ALSO)"
\fBfirewall-applet\fR(1), \fBfirewalld\fR(1), \fBfirewall-cmd\fR(1), \fBfirewall-config\fR(1), \fBfirewalld.conf\fR(5), \fBfirewalld.direct\fR(5), \fBfirewalld.dbus\fR(5), \fBfirewalld.icmptype\fR(5), \fBfirewall-offline-cmd\fR(1), \fBfirewalld.richlanguage\fR(5), \fBfirewalld.service\fR(5), \fBfirewalld.zone\fR(5), \fBfirewalld.zones\fR(5), \fBfirewalld.policy\fR(5), \fBfirewalld.policies\fR(5), \fBfirewalld.ipset\fR(5), \fBfirewalld.helper\fR(5)
.SH "یادداشت‌ها (NOTES)"
.PP
صفحه خانگی firewalld:
.RS 4
\m[blue]\fB\%http://firewalld.org\fR\m[]
.RE
.SH "نویسندگان (AUTHORS)"
.PP
