.SS too\-complex / R1260
.sp
\fBMessage emitted:\fP
.sp
\fB%s is too complex. The McCabe rating is %d\fP
.sp
\fBDescription:\fP
.sp
\fIUsed when a method or function is too complex based on McCabe Complexity Cyclomatic\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
def fifty_percent_off(whole):
    return (float(whole)) * 50 / 100


def calculate_sum_and_display_price_of_fruits(*fruits):  # [too\-complex]
    # McCabe rating is 13 here (by default 10)
    shopping_list = []

    if \(dqapple\(dq in fruits:
        v = fifty_percent_off(1.1)
        shopping_list.append(v)
    if \(dqpear\(dq in fruits:
        shopping_list.append(0.8)
    if \(dqbanana\(dq in fruits:
