'\" t
.TH "ORG\&.FREEDESKTOP\&.HOME1" "5" "" "systemd 261.2" "org.freedesktop.home1"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
