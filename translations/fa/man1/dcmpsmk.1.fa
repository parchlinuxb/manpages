.TH "dcmpsmk" 1 "Thu Jul 9 2026 18:43:40" "Version 3.7.0" "OFFIS DCMTK" \" -*- nroff -*-
.nh
.SH "نام (NAME)"
dcmpsmk \- ایجاد شیء حالت نمایش نسخه دیجیتال غیررنگی دایکام (DICOM GSPS)
.PP

.SH "خلاصه دستور (SYNOPSIS)"
.PP
.PP
.nf
dcmpsmk [options] dcmfile-in dcmfile-out
.fi
.PP
.SH "توضیحات (DESCRIPTION)"
.PP
ابزار \fBdcmpsmk\fP یک فایل تصویر DICOM را می‌خواند و یک شیء حالت نمایش نسخه دیجیتال غیررنگی (grayscale softcopy presentation state) مطابق با الحاقیه ۳۳ (Supplement 33) ایجاد می‌کند\&. شیء حالت نمایش تولیدشده مجدداً در قالب فایل ذخیره می‌شود\&. تعدادی از گزینه‌های خط فرمان به کاربر امکان می‌دهند مشخص کند که ساختارهای خاص موجود در فایل تصویر چگونه در حالت نمایش ارجاع داده شده یا فعال شوند\&. حالت نمایش جدیداً ایجاد شده به تصویر منبع ارجاع می‌دهد و حاوی مقادیری است که امکان نمایش «مناسب» تصویر را هنگام رندر شدن تحت کنترل حالت نمایش فراهم می‌سازد\&.
.SH "پارامترها (PARAMETERS)"
.PP
.PP
.nf
dcmfile-in   فایل(های) تصویر DICOM ورودی جهت خواندن ("-" برای stdin)

dcmfile-out  فایل حالت نمایش DICOM خروجی جهت ایجاد ("-" برای stdout)
.fi
.PP
.SH "گزینه‌ها (OPTIONS)"
.PP
.SS "گزینه‌های عمومی (general options)"
.PP
.nf
  -h   --help
         چاپ متن راهنما و خروج

       --version
         چاپ اطلاعات نسخه و خروج

       --arguments
         چاپ آرگومان‌های بسط‌یافته خط فرمان

  -q   --quiet
         حالت بی‌صدا، عدم چاپ هشدارها و خطاها

  -v   --verbose
         حالت پرگو، چاپ جزئیات پردازش

  -d   --debug
         حالت اشکال‌زدایی، چاپ اطلاعات دیباگ

  -ll  --log-level  [l]evel: string constant
         (fatal, error, warn, info, debug, trace)
         استفاده از سطح l برای ثبت‌کننده لاگ

  -lc  --log-config  [f]ilename: string
         استفاده از فایل پیکربندی f برای ثبت‌کننده لاگ
.fi
.PP
.SS "گزینه‌های ورودی (input options)"
.PP
.nf
قالب فایل ورودی:

  +f   --read-file
         خواندن قالب فایل یا مجموعه داده (پیش‌فرض)

  +fo  --read-file-only
         فقط خواندن قالب فایل

  -f   --read-dataset
         خواندن مجموعه داده بدون اطلاعات فرا‌داده فایل

سینتکس انتقال ورودی:

  -t=  --read-xfer-auto
         استفاده از تشخیص خودکار سینتکس انتقال (پیش‌فرض)

  -td  --read-xfer-detect
         نادیده گرفتن سینتکس انتقال مشخص‌شده در هدر فراداده فایل

  -te  --read-xfer-little
         خواندن با سینتکس انتقال صریح VR Little Endian

  -tb  --read-xfer-big
         خواندن با سینتکس انتقال صریح VR Big Endian

  -ti  --read-xfer-implicit
         خواندن با سینتکس انتقال ضمنی VR Little Endian
.fi
.PP
.SS "گزینه‌های پردازش (processing options)"
.PP
.nf
مدیریت تبدیل VOI:

  +Vl  --voi-lut
         استفاده از نخستین VOI LUT در صورت وجود (پیش‌فرض)

  +Vw  --voi-window
         استفاده از نخستین مرکز/عرض پنجره در صورت وجود

  -V   --voi-ignore
         نادیده گرفتن VOI LUT و مرکز/عرض پنجره

مدیریت منحنی (curve):

  +c   --curve-activate
         فعال‌سازی داده‌های منحنی در صورت وجود (پیش‌فرض)

  -c   --curve-ignore
         نادیده گرفتن داده‌های منحنی

مدیریت هم‌پوشانی (overlay):

  +oc  --overlay-copy
         کپی هم‌پوشانی‌ها در صورت عدم تعبیه، در غیر این صورت فعال‌سازی (پیش‌فرض)

  +oa  --overlay-activate
         فعال‌سازی هم‌پوشانی‌ها

  -o   --overlay-ignore
         نادیده گرفتن هم‌پوشانی‌ها

مدیریت شاتر (shutter):

  +s   --shutter-activate
         استفاده از شاتر در صورت وجود در تصویر (پیش‌فرض)

  -s   --shutter-ignore
         نادیده گرفتن شاتر

مدیریت شکل LUT نمایش:

  +p   --plut-activate
         استفاده از شکل LUT نمایش در صورت وجود (پیش‌فرض)

  -p   --plut-ignore
         نادیده گرفتن شکل LUT نمایش

لایه‌بندی (layering):

  +l1  --layer-single
         قرارگیری تمام منحنی‌ها و هم‌پوشانی‌ها در یک لایه

  +l2  --layer-double
         یک لایه برای منحنی‌ها و یک لایه برای هم‌پوشانی‌ها (پیش‌فرض)

  +ls  --layer-separate
         لایه‌های مجزا برای هر منحنی و هم‌پوشانی

موقعیت تصویر ارجاع‌شده:

  -lx  --location-none
         ارجاع تصویر بدون موقعیت مکانی (پیش‌فرض)

  -ln  --location-network  [a]etitle: string
         تصویر واقع در موجودیت کاربردی (Application Entity) a

  -lm  --location-media  [f]ilesetID, fileset[UID]: string
         تصویر واقع در رسانه ذخیره‌سازی
.fi
.PP
.SS "گزینه‌های اعتبارسنجی (validation options)"
.PP
.nf
       --validate-std
          تصاویر ارجاع‌شده توسط GSPS باید متعلق به همان
          رده SOP باشند (پیش‌فرض)

       --validate-related
          تصاویر ارجاع‌شده توسط GSPS ممکن است متعلق به رده‌های SOP
          مرتبط 'for presentation' و 'for processing' باشند

       --validate-relaxed
          تصاویر ارجاع‌شده توسط GSPS می‌توانند از هر رده SOP باشند
.fi
.PP
.SS "گزینه‌های خروجی (output options)"
.PP
.nf
سینتکس انتقال خروجی:

  +t=   --write-xfer-same
          نوشتن با همان سینتکس انتقال فایل تصویر (پیش‌فرض)

  +te   --write-xfer-little
          نوشتن با سینتکس انتقال صریح VR Little Endian

  +tb   --write-xfer-big
          نوشتن با سینتکس انتقال صریح VR Big Endian

  +ti   --write-xfer-implicit
          نوشتن با سینتکس انتقال ضمنی VR Little Endian
.fi
.PP
.SH "نکات (NOTES)"
.PP
اگر بیش از یک فایل ورودی (\fIdcmfile-in\fP) مشخص شود، فایل‌های تصویر اضافی تنها از فایل حالت نمایش ایجادشده ارجاع داده می‌شوند، اما اطلاعات بیشتری (مانند اطلاعات مربوط به نمایش) از آن‌ها منتقل نخواهد شد\&.
.SH "گزارش‌گیری (LOGGING)"
.PP
سطح خروجی گزارش‌گیری ابزارهای مختلف خط فرمان و کتابخانه‌های زیربنایی را می‌توان توسط کاربر مشخص کرد\&. به طور پیش‌فرض، تنها خطاها و هشدارها در جریان خطای استاندارد (stderr) نوشته می‌شوند\&. با استفاده از گزینه \fI--verbose\fP پیام‌های اطلاع‌رسانی مانند جزئیات پردازش نیز گزارش می‌شوند\&. گزینه \fI--debug\fP می‌تواند برای دریافت جزئیات بیشتر در مورد فعالیت‌های داخلی، به عنوان مثال برای اهداف اشکال‌زدایی، استفاده شود\&. سطوح دیگر گزارش‌گیری را می‌توان با استفاده از گزینه \fI--log-level\fP انتخاب کرد\&. در حالت \fI--quiet\fP فقط خطاهای مهلک گزارش می‌شوند\&. در چنین شرایط خطای بسیار شدیدی، برنامه معمولاً متوقف می‌شود\&. برای جزئیات بیشتر در مورد سطوح مختلف گزارش‌گیری، مستندات ماژول «oflog» را مشاهده کنید\&.

.PP
در صورتی که خروجی گزارش‌گیری باید در یک فایل نوشته شود (اختیاری با چرخش فایل لاگ)، در syslog (یونیکس) یا گزارش رویداد event log (ویندوز)، می‌توان از گزینه \fI--log-config\fP استفاده کرد\&. این فایل پیکربندی همچنین امکان هدایت تنها پیام‌های خاص به یک جریان خروجی مشخص و فیلتر کردن برخی پیام‌ها بر اساس ماژول یا برنامه‌ای که در آن تولید می‌شوند را فراهم می‌کند\&. یک فایل پیکربندی نمونه در \fI<etcdir>/logger\&.cfg\fP ارائه شده است\&.
.SH "خط فرمان (COMMAND LINE)"
.PP
تمامی ابزارهای خط فرمان از نمادگذاری زیر برای پارامترها استفاده می‌کنند: کروشه‌ها مقادیر اختیاری (۰-۱) را در بر می‌گیرند، سه نقطه انتهایی نشان می‌دهد که مقادیر متعدد مجاز است (۱-n)، و ترکیبی از هر دو به معنای ۰ تا n مقدار است\&.

.PP
گزینه‌های خط فرمان با علامت '+' یا '-' در ابتدا از پارامترها متمایز می‌شوند\&. معمولاً ترتیب و موقعیت گزینه‌های خط فرمان اختیاری است (یعنی می‌توانند در هر جایی ظاهر شوند)\&. با این حال، اگر گزینه‌ها مانعة‌الجمع باشند، راست‌ترین گزینه استفاده می‌شود\&. این رفتار مطابق با قوانین استاندارد ارزیابی پوسته‌های رایج یونیکس است\&.

.PP
علاوه بر این، یک یا چند فایل حاوی دستورات را می‌توان با استفاده از علامت '@' به عنوان پیشوند نام فایل مشخص کرد (به عنوان مثال \fI@command\&.txt\fP)\&. چنین آرگومان دستوری قبل از هرگونه ارزیابی بیشتر، با محتوای فایل متنی مربوطه جایگزین می‌شود (فاصله‌های خالی متعدد به عنوان یک جداکننده واحد در نظر گرفته می‌شوند مگر اینکه بین دو علامت نقل‌قول قرار گیرند)\&. لطفاً توجه داشته باشید که یک فایل دستوری نمی‌تواند حاوی فایل دستوری دیگری باشد\&. این رویکرد ساده اما مؤثر امکان خلاصه کردن ترکیب‌های رایج گزینه‌ها/پارامترها را فراهم می‌کند و از خطوط فرمان طولانی و گیج‌کننده جلوگیری می‌کند (یک مثال در فایل \fI<datadir>/dumppat\&.txt\fP ارائه شده است)\&.
.SH "محیط (ENVIRONMENT)"
.PP
ابزار \fBdcmpsmk\fP تلاش خواهد کرد دیکشنری‌های داده DICOM مشخص‌شده در متغیر محیطی \fIDCMDICTPATH\fP را بارگذاری کند\&. به طور پیش‌فرض، یعنی اگر متغیر محیطی \fIDCMDICTPATH\fP تنظیم نشده باشد، فایل \fI<datadir>/dicom\&.dic\fP بارگذاری می‌شود مگر اینکه دیکشنری در داخل برنامه تعبیه شده باشد (پیش‌فرض برای ویندوز)\&.

.PP
رفتار پیش‌فرض ارجح است و متغیر محیطی \fIDCMDICTPATH\fP تنها زمانی باید استفاده شود که دیکشنری‌های داده جایگزین مورد نیاز باشد\&. فرمت متغیر محیطی \fIDCMDICTPATH\fP همانند متغیر \fIPATH\fP در پوسته یونیکس است که در آن دو نقطه (":") ورودی‌ها را جدا می‌کند\&. در سیستم‌های ویندوز، از نقطه ویرگول (";") به عنوان جداکننده استفاده می‌شود\&. کد دیکشنری داده تلاش خواهد کرد تا هر فایل مشخص‌شده در متغیر محیطی \fIDCMDICTPATH\fP را بارگذاری کند\&. در صورتی که هیچ دیکشنری داده‌ای بارگذاری نشود، یک خطا رخ خواهد داد\&.
