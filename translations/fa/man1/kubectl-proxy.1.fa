.nh
.TH KUBERNETES 1 "Jan 2015" "Eric Paris" "راهنمای کاربر kubernetes"

.SH "نام (NAME)"
kubectl-proxy \- اجرای یک پروکسی به سمت سرور Kubernetes API


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubectl proxy\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
یک سرور پروکسی یا درگاه در سطح لایه کاربرد بین localhost و سرور Kubernetes API ایجاد می‌کند. همچنین امکان ارائه محتوای ایستا (static content) را روی مسیر HTTP مشخص‌شده فراهم می‌آورد. تمام داده‌های ورودی از طریق یک پورت وارد شده و به پورت دوردست سرور Kubernetes API هدایت می‌شوند، به جز مسیری که با مسیر محتوای ایستا مطابقت دارد.


.SH "گزینه‌ها (OPTIONS)"
\fB--accept-hosts\fP="^localhost$,^127\\\&.0\\\&.0\\\&.1$,^\\[::1\\]$"
	عبارت باقاعده (regular expression) برای هاست‌هایی که پروکسی باید بپذیرد.

.PP
\fB--accept-paths\fP="^.*"
	عبارت باقاعده برای مسیرهایی که پروکسی باید بپذیرد.

.PP
\fB--address\fP="127.0.0.1"
	آدرس IP که سرویس‌دهی روی آن انجام می‌شود.

.PP
\fB--api-prefix\fP="/"
	پیشوندی که API تحت پروکسی تحت آن ارائه می‌شود.

.PP
\fB--append-server-path\fP=false
	در صورت true بودن، افزودن خودکار مسیر سرور کانتکست kube به هر درخواست را فعال می‌کند.

.PP
\fB--disable-filter\fP=false
	در صورت true بودن، فیلتر کردن درخواست‌ها در پروکسی غیرفعال می‌شود. این کار خطرناک است و در صورت استفاده با یک پورت در دسترس، می‌تواند شما را در برابر حملات XSRF آسیب‌پذیر کند.

.PP
\fB--keepalive\fP=0s
	مدت زمان زنده نگه‌داشتن (keep-alive) را برای یک اتصال شبکه فعال مشخص می‌کند. برای غیرفعال کردن keepalive روی 0 تنظیم کنید.

.PP
\fB-p\fP, \fB--port\fP=8001
	پورتی که پروکسی روی آن اجرا می‌شود. برای انتخاب یک پورت تصادفی روی 0 تنظیم کنید.

.PP
\fB--reject-methods\fP="^$"
	عبارت باقاعده برای متدهای HTTP که پروکسی باید رد کند (مثال: \-\-reject-methods='POST,PUT,PATCH').

.PP
\fB--reject-paths\fP="^/api/.\fI/pods/.\fP/exec,^/api/.\fI/pods/.\fP/attach"
	عبارت باقاعده برای مسیرهایی که پروکسی باید رد کند. مسیرهای مشخص‌شده در اینجا حتی در صورت پذیرفته شدن توسط \-\-accept-paths نیز رد خواهند شد.

.PP
\fB-u\fP, \fB--unix-socket\fP=""
	سوکت یونیکس که پروکسی روی آن اجرا می‌شود.

.PP
\fB-w\fP, \fB--www\fP=""
	همچنین فایل‌های ایستا را از دایرکتوری داده‌شده تحت پیشوند مشخص‌شده ارائه می‌دهد.

.PP
\fB-P\fP, \fB--www-prefix\fP="/static/"
	پیشوندی برای ارائه فایل‌های ایستا، در صورتی که دایرکتوری فایل‌های ایستا مشخص شده باشد.


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--as\fP=""
	نام کاربری برای جعل هویت (impersonate) در این عملیات. کاربر می‌تواند یک کاربر معمولی یا یک حساب خدمت (service account) در یک فضای نام (namespace) باشد.

.PP
\fB--as-group\fP=[]
	گروه برای جعل هویت در این عملیات؛ این گزینه می‌تواند برای تعیین چندین گروه تکرار شود.

.PP
\fB--as-uid\fP=""
	شناسه کاربری (UID) برای جعل هویت در این عملیات.

.PP
\fB--as-user-extra\fP=[]
	اطلاعات تکمیلی کاربر (user extras) برای جعل هویت در این عملیات؛ این گزینه می‌تواند برای مشخص کردن چندین مقدار برای یک کلید یکسان تکرار شود.

.PP
\fB--cache-dir\fP="/home/username/.kube/cache"
	دایرکتوری پیش‌فرض کش

.PP
\fB--certificate-authority\fP=""
	مسیر فایل گواهینامه برای مرجع صدور گواهینامه (certificate authority)

.PP
\fB--client-certificate\fP=""
	مسیر فایل گواهینامه کلاینت برای TLS

.PP
\fB--client-key\fP=""
	مسیر فایل کلید کلاینت برای TLS

.PP
\fB--cluster\fP=""
	نام کلاستر kubeconfig برای استفاده

.PP
\fB--context\fP=""
	نام کانتکست kubeconfig برای استفاده

.PP
\fB--disable-compression\fP=false
	در صورت true بودن، از فشرده‌سازی پاسخ‌ها برای تمام درخواست‌ها به سرور صرف‌نظر می‌شود

.PP
\fB--insecure-skip-tls-verify\fP=false
	در صورت true بودن، اعتبار گواهینامه سرور بررسی نخواهد شد. این کار اتصالات HTTPS شما را ناامن می‌کند

.PP
\fB--kubeconfig\fP=""
	مسیر فایل kubeconfig برای استفاده در درخواست‌های CLI.

.PP
\fB--kuberc\fP=""
	مسیر فایل kuberc برای تنظیمات ترجیحی (preferences). این قابلیت می‌تواند با export کردن feature gate به صورت KUBECTL_KUBERC=false یا خاموش کردن ویژگی با KUBERC=off غیرفعال شود.

.PP
\fB--match-server-version\fP=false
	الزام به تطابق نسخه سرور با نسخه کلاینت

.PP
\fB-n\fP, \fB--namespace\fP=""
	در صورت وجود، حوزه فضای نام (namespace) برای این درخواست CLI

.PP
\fB--password\fP=""
	رمز عبور برای احراز هویت پایه (basic authentication) در سرور API

.PP
\fB--profile\fP="none"
	نام پروفایل برای ثبت. یکی از موارد (none|cpu|heap|goroutine|threadcreate|block|mutex|trace)

.PP
\fB--profile-output\fP="profile.pprof"
	نام فایلی که داده‌های پروفایل در آن ذخیره می‌شود

.PP
\fB--request-timeout\fP="0"
	مدت زمان انتظار پیش از انصراف از یک درخواست به سرور. مقادیر غیر صفر باید شامل واحد زمانی متناظر باشند (مانند 1s، 2m، 3h). مقدار صفر یعنی درخواست‌ها هرگز دچار وقفه زمانی (timeout) نشوند.

.PP
\fB-s\fP, \fB--server\fP=""
	آدرس و پورت سرور Kubernetes API

.PP
\fB--tls-server-name\fP=""
	نام سرور برای اعتبارسنجی گواهینامه سرور. در صورت عدم ارائه، از نام هاست (hostname) استفاده‌شده برای برقراری ارتباط با سرور استفاده می‌شود

.PP
\fB--token\fP=""
	توکن Bearer برای احراز هویت در سرور API

.PP
\fB--user\fP=""
	نام کاربر kubeconfig برای استفاده

.PP
\fB--username\fP=""
	نام کاربری برای احراز هویت پایه در سرور API

.PP
\fB--version\fP=false
	گزینه \fB\-\-version\fP یا \fB\-\-version=raw\fP اطلاعات نسخه را چاپ کرده و خارج می‌شود؛ \fB\-\-version=vX.Y.Z...\fP نسخه گزارش‌شده را تنظیم می‌کند

.PP
\fB--warnings-as-errors\fP=false
	در نظر گرفتن هشدارهای دریافتی از سرور به عنوان خطا و خروج با کد وضعیت غیر صفر


.SH "مثال‌ها (EXAMPLES)"
.EX
  # پروکسی کردن تمام Kubernetes API و نه چیز دیگر
  kubectl proxy --api-prefix=/
  
  # پروکسی کردن تنها بخشی از Kubernetes API و همچنین برخی فایلهای ایستا
  # می‌توانید اطلاعات پادها را با دستور 'curl localhost:8001/api/v1/pods' دریافت کنید
  kubectl proxy --www=/my/files --www-prefix=/static/ --api-prefix=/api/
  
  # پروکسی کردن کل Kubernetes API در یک ریشه متفاوت
  # می‌توانید اطلاعات پادها را با دستور 'curl localhost:8001/custom/api/v1/pods' دریافت کنید
  kubectl proxy --api-prefix=/custom/
  
  # اجرای یک پروکسی به سمت سرور Kubernetes API روی پورت 8011، ارائه محتوای ایستا از ./local/www/
  kubectl proxy --port=8011 --www=./local/www/
  
  # اجرای یک پروکسی به سمت سرور Kubernetes API روی یک پورت محلی دلخواه
  # پورت انتخاب‌شده برای سرور در خروجی استاندارد (stdout) چاپ خواهد شد
  kubectl proxy --port=0
  
  # اجرای یک پروکسی به سمت سرور Kubernetes API با تغییر پیشوند API به k8s-api
  # این کار مثلاً API پادها را در آدرس localhost:8001/k8s-api/v1/pods/ در دسترس قرار می‌دهد
  kubectl proxy --api-prefix=/k8s-api
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubectl(1)\fP


.SH "تاریخچه (HISTORY)"
ژانویه ۲۰۱۵، در ابتدا توسط Eric Paris (eparis at redhat dot com) بر پایه محتوای منبع kubernetes گردآوری شد، اما امید است که از آن زمان به بعد به طور خودکار تولید شده باشند!
