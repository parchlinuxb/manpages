0060  04 08 02 01  0a 37 18 00  04 06 03 00  0b 37 08 00
0070  04 02 1e 00  0d 37 1c 00  04 07 1e 00  0e 37 40 00
0080  04 10 02 01  0f 37 30 00  04 0c 1e 00  11 37 34 00
0090  04 0d 1e 00  12 37 3c 00  04 0f 1e 00  13 37 38 00
00A0  04 0e 03 00  f2 67 00 00  04 00 03 00  f3 67 04 00
00B0  04 01 03 00  09 69 44 00  04 11 03 00  fa 7f 5c 00
00C0  04 15 40 00  fb 7f 4c 00  08 13 40 00  fc 7f 54 00
00D0  08 14 03 00  fd 7f 48 00  04 12 0b 00  fe 7f 60 00
00E0  01 16 0b 00  ff 7f 61 00  01 17 45 82  00 00 00 00
00F0  45 82 00 00  78 3c 00 00  ff ff ff ff  49 1e 00 00
0100  06 00 00 00  00 00 00 00  a0 00 00 00  00 00 00 00
0110  00 00 00 00  00 00 00 00  00 00 00 00  c0 00 00 00
0120  00 00 00 00  00 00 00 00  00 00 00 00  00 00 00 00
0130  00 00 00 00  00 00 00 00  00 00 00 00  00 40 dd a3
0140  57 45 b3 0c  00 40 dd a3  57 45 b3 0c  02 00 00 00
0150  00 00 fa 10  3e 2a 86 48  86 f7 14 03  0a 03 02 01
0160  4a 2e 20 44  61 76 69 64  20 4b 61 72  61 6d 27 73
0170  20 42 69 72  74 68 64 61  79 00 06 00  00 00 0c 00
0180  14 00 ea 00  f0 00 55 01  60 01 79 01

0000  indexOffset     [2 bytes] 0x017a     in this case
0002  signature       [2 bytes] 0x7cec     constant
0004  7coffset        [4 bytes] 0x0040     index reference
.fi
.if n \{\
.RE
.\}
.PP
به امضای
.B 0x7cec
توجه نمایید\&. قالب‌های بلوک توصیف‌گر دیگری نیز با امضاهای متفاوت وجود دارند\&. به
.B indexOffset
با مقدار
.B 0x017a
توجه کنید \- با شروع از آن موقعیت در بلوک توصیف‌گر، آرایه‌ای از اعداد صحیح دو بایتی داریم\&. اولین عدد صحیح (0x0006) بیانگر (تعداد منهای ۱) از جفت‌های همپوشانی است که بعد از تعداد می‌آیند\&. اولین جفت (0, 0xc)، جفت بعدی (0xc, 0x14) و آخرین جفت (هفتمین) (0x160, 0x179) است\&. این جفت‌ها آفست‌های (start,end+1) آیتم‌ها در این بلوک هستند؛ بنابراین count+2 عدد صحیح به دنبال مقدار count خواهیم داشت\&.
.PP
به
.B 7coffset
با مقدار
.B 0x0040
توجه نمایید که یک ارجاع ایندکس است\&. در این حالت، این یک اشاره‌گر ارجاع داخلی است که باید ۴ بیت به راست شیفت داده شود تا به
.B 0x0004
تبدیل شود، که سپس یک آفست بایتی است که باید به
.B indexOffset
فوق به علاوه دو (جهت رد شدن از count) اضافه شود تا به جفت (0x14, 0xea) اشاره کند\&. ما آفست و اندازه بلوک «7c» واقع در آفست 0x14 با اندازه ۲۱۴ بایت در این مورد را داریم\&. بلوک «7c» با هدر زیر آغاز می‌شود:
.sp
.if n \{\
.RS 4
.\}
.nf
0000  signature       [1 bytes] 0x7c       constant
0001  itemCount       [1 bytes] 0x18       in this case
0002  unknown         [2 bytes] 0x0060     in this case
0004  unknown         [2 bytes] 0x0060     in this case
0006  unknown         [2 bytes] 0x0062     in this case
0008  recordSize      [2 bytes] 0x0065     in this case
000a  b5Offset        [4 bytes] 0x0020     index reference
000e  index2Offset    [4 bytes] 0x0080     index reference
0012  unknown         [2 bytes] 0x0000     in this case
0014  unknown         [2 bytes] 0x0000     in this case
.fi
.if n \{\
.RE
.\}
.PP
به
.B b5Offset
با مقدار
.B 0x0020
توجه فرمایید که یک ارجاع ایندکس است\&. در این حالت، این یک اشاره‌گر ارجاع داخلی است که باید ۴ بیت به راست شیفت داده شود تا به
.B 0x0002
تبدیل شود، که سپس یک آفست بایتی است که باید به
.B indexOffset
فوق به علاوه دو (جهت رد شدن از count) اضافه شود تا به جفت (0xc, 0x14) اشاره نماید\&. در نهایت، آفست و اندازه بلوک «b5» واقع در آفست 0xc با اندازه ۸ بایت در این بلوک توصیف‌گر را داریم\&. بلوک «b5» دارای قالب زیر است:
.sp
.if n \{\
.RS 4
.\}
.nf
0000  signature       [2 bytes] 0x04b5     constant
0002  datasize        [2 bytes] 0x0002     +4 for 6 byte entries in this case
0004  descoffset      [4 bytes] 0x0060     index reference
.fi
.if n \{\
.RE
.\}
.PP
به
.B descoffset
با مقدار
.B 0x0060
توجه نمایید که باز هم یک ارجاع ایندکس است\&. در این حالت، این یک ارجاع اشاره‌گر داخلی است که باید ۴ بیت به راست شیفت داده شود تا به
.B 0x0006
تبدیل شود، که سپس یک آفست بایتی است که باید به
.B indexOffset
فوق به علاوه دو (جهت رد شدن از count) اضافه شود تا به جفت (0xea, 0xf0) اشاره کند\&. مقدار datasize‏ (۲) به علاوه کد b5‏ (۰۴) اندازه ورودی‌ها را مشخص می‌کند که در این مورد ۶ بایت است\&. اکنون آفست 0xea از یک بلوک داده استفاده‌نشده با قالبی ناشناخته را داریم که از ورودی‌های ۶ بایتی تشکیل شده است\&. این رابطه (0xf0 \- 0xea)/6 = 1 را به ما می‌دهد، بنابراین مقدار
.B recordCount
برابر یک خواهد بود\&.
.PP
مواردی مشاهده شده است که
.B descoffset
در بلوک b5 برابر صفر و
.B index2Offset
در بلوک 7c برابر با صفر بوده است\&. این حالت برای اشیایی مشاهده شده که به نظر می‌رسد پیوست‌هایی روی پیام‌های خوانده‌شده باشند؛ قبل از اینکه پیام خوانده شود، هیچ پیوستی نداشت\&.
.PP
به
.B index2Offset
فوق با مقدار
.B 0x0080
توجه کنید که باز هم یک ارجاع ایندکس است\&. در این مورد، این یک ارجاع اشاره‌گر داخلی است که باید ۴ بیت به راست شیفت یابد تا به
.B 0x0008
تبدیل گردد، که سپس یک آفست بایتی است که باید به
.B indexOffset
فوق به علاوه دو (جهت رد شدن از count) اضافه شود تا به جفت (0xf0, 0x155) اشاره کند\&. این یک آرایه از جداول اعداد صحیح چهار بایتی است\&. ما این‌ها را جداول IND2 می‌نامیم\&. اندازه هر یک از این جداول توسط فیلد
.B recordSize
در هدر «7c» تعیین می‌شود\&. تعداد این جداول برابر با همان مقدار
.B recordCount
فوق است که از بلوک «b5» به دست آمده است\&.
.PP
اکنون داده‌های باقیمانده در بلوک «7c» پس از هدر از آفست 0x2a آغاز می‌شود\&. در اینجا باید به تعداد
.B itemCount
آیتم ۸ بایتی با قالب زیر موجود باشد:
.sp
.if n \{\
.RS 4
.\}
.nf
0000  referenceType   [2 bytes]
0002  itemType        [2 bytes]
0004  ind2Offset      [2 bytes]
0006  size            [1 byte]
0007  unknown         [1 byte]
.fi
.if n \{\
.RE
.\}
.PP
مقدار
.B ind2Offset
یک آفست بایتی به مقداری درون جدول IND2 فعلی است\&. اگر آن مقدار یک عدد صحیح چهار بایتی باشد، پس از واکشی آن، همان سه‌تایی
.B (item type, reference type, value)
را خواهیم داشت که در بلوک‌های توصیف‌گر نوع 0xbcec می‌یابیم\&. در غیر این صورت، این مقدار مستقیماً استفاده می‌شود\&. این توصیف‌گرهای ۸ بایتی به تعداد
.B recordCount
بار پردازش می‌شوند و هر بار از جدول IND2 بعدی استفاده می‌شود\&. انواع آیتم و ارجاع مشابه مواردی هستند که در بالا برای بلوک توصیف‌گر قالب 0xbcec توضیح داده شد\&.
.SH "آیتم توصیف‌گر مرتبط ۳۲ بیتی 0X0101 (32 BIT ASSOCIATED DESCRIPTOR ITEM 0X0101)"
.PP
این بلوک توصیف‌گر حاوی فهرستی از مقادیر
.B I_ID
است\&. این بلوک زمانی استفاده می‌شود که یک
.B I_ID
(که معمولاً به یک بلوک توصیف‌گر نوع 0x7cec یا 0xbcec اشاره می‌کند)
حاوی داده‌های بیشتری نسبت به گنجایش یک توصیف‌گر منفرد از آن انواع باشد\&.
در این حالت، به یک بلوک نوع
.B 0x0101
اشاره می‌کند که شامل فهرستی از مقادیر
.B I_ID
است که خود به بلوک‌های توصیف‌گر واقعی اشاره دارند\&.
مقدار طول کل (total length) در هدر 0x0101 مجموع طول بلوک‌هایی است
که توسط فهرست مقادیر
.B I_ID
به آن‌ها اشاره شده است\&.
نتیجه یک آرایه از زیربلوک‌ها است که ممکن است حاوی ارجاعات ایندکسی باشند
که در آن‌ها ۱۶ بیت پرارزش مشخص می‌کند از کدام زیربلوک توصیف‌گر باید استفاده شود\&.
فقط اولین زیربلوک توصیف‌گر حاوی امضا (0xbcec یا 0x7cec) است\&.
.sp
.if n \{\
.RS 4
.\}
.nf
0000  01 01 02 00  26 28 00 00  18 77 0c 00  b8 04 00 00

0000  signature       [2 bytes] 0x0101     constant
0002  count           [2 bytes] 0x0002     in this case
0004  total length    [4 bytes] 0x002826   in this case
  repeating
0008  i_id            [4 bytes] 0x0c7718   in this case
000c  i_id            [4 bytes] 0x0004b8   in this case
.fi
.if n \{\
.RE
.\}
.SH "آیتم توصیف‌گر مرتبط ۶۴ بیتی 0X0101 (64 BIT ASSOCIATED DESCRIPTOR ITEM 0X0101)"
.PP
این بلوک توصیف‌گر حاوی فهرستی از مقادیر
.B I_ID
است، مشابه با نسخه ۳۲ بیتی که در بالا شرح داده شد\&.
.sp
.if n \{\
.RS 4
.\}
.nf
0000  01 01 02 00  ea 29 00 00  10 83 00 00  00 00 00 00
0010  1c 83 00 00  00 00 00 00

0000  signature       [2 bytes] 0x0101     constant
0002  count           [2 bytes] 0x0002     in this case
0004  total length    [4 bytes] 0x0029ea   in this case
  repeating
0008  i_id            [8 bytes] 0x008310   in this case
0010  i_id            [8 bytes] 0x00831c   in this case
.fi
.if n \{\
.RE
.\}
.SH "همچنین ببینید (SEE ALSO)"
.PP
\fBreadpst\fR(1)
.SH "نویسندگان (AUTHORS)"
.PP
این مستندات بخشی از ابزارهای
.B libpst
است\&.
