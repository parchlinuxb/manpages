'\" t
.\"
.TH "\fBMARIADB-DUMPSLOW\fR" "1" "5 March 2025" "MariaDB 11.8" "MariaDB Database System"
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.\" mariadb-dumpslow
.SH "نام (NAME)"
mariadb-dumpslow \- تجزیه و خلاصه‌سازی فایل لاگ پرس‌وجوهای کند MariaDB
.SH "خلاصه دستور (SYNOPSIS)"
.HP \w'\fBmariadb-dumpslow\ [\fR\fBoptions\fR\fB]\ [\fR\fB\fIlog_file\fR\fR\fB\ \&.\&.\&.]\fR\ 'u
\fBmariadb-dumpslow [\fR\fBگزینه‌ها\fR\fB] [\fR\fB\fIlog_file\fR\fR\fB \&.\&.\&.]\fR
.SH "توضیحات (DESCRIPTION)"
.PP
لاگ پرس‌وجوهای کند MariaDB شامل اطلاعاتی درباره پرس‌وجوهایی است که اجرای آن‌ها زمان زیادی می‌برد\&.
\fBmariadb\-dumpslow\fR
فایل‌های لاگ پرس‌وجوهای کند MariaDB را تجزیه کرده و خلاصه‌ای از محتوای آن‌ها را چاپ می‌کند\&.
.PP
به‌طور معمول،
\fBmariadb\-dumpslow\fR
پرس‌وجوهایی را که به جز در مقادیر داده‌های عددی و رشته‌ای مشابه هستند، گروه‌بندی می‌کند\&. این ابزار هنگام نمایش خروجی خلاصه، این مقادیر را به N و 'S'
\(lqانتزاعی\(rq
می‌کند\&. برای تغییر رفتار انتزاعی‌سازی مقادیر می‌توان از گزینه‌های
\fB\-a\fR
و
\fB\-n\fR
استفاده کرد\&.
.PP
دستور
\fBmariadb\-dumpslow\fR
را به این صورت اجرا کنید:
.sp
.if n \{\
.RS 4
.\}
.nf
shell> \fBmariadb-dumpslow [\fR\fB\fIoptions\fR\fR\fB] [\fR\fB\fIlog_file\fR\fR\fB \&.\&.\&.]\fR
.fi
.if n \{\
.RE
.\}
.PP
دستور
\fBmariadb\-dumpslow\fR
از گزینه‌های زیر پشتیبانی می‌کند\&.
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
.\" mariadb-dumpslow: help option
.\" help option: mariadb-dumpslow
\fB\-\-help\fR
.sp
نمایش پیام راهنما و خروج\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-a\fR
.sp
عدم انتزاعی‌سازی تمامی اعداد به N و رشته‌ها به 'S'\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
.\" mariadb-dumpslow: debug option
.\" debug option: mariadb-dumpslow
\fB\-\-debug\fR,
\fB\-d\fR
.sp
اجرا در حالت اشکال‌زدایی\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-g \fR\fB\fIpattern\fR\fR
.sp
تنها پرس‌وجوهایی را در نظر بگیر که با الگوی مورد نظر (به سبک \fBgrep\fR) مطابقت دارند\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-h \fR\fB\fIhost_name\fR\fR
.sp
نام میزبان سرور MariaDB برای نام فایل
*\-slow\&.log
است\&. مقدار می‌تواند شامل نویسه‌های عام (wildcard) باشد\&. مقدار پیش‌فرض
*
(مطابقت با همه) است\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-i \fR\fB\fIname\fR\fR
.sp
نام نمونه سرور (در صورت استفاده از اسکریپت راه‌اندازی
\fBmariadb\&.server\fR)\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-l\fR
.sp
زمان قفل را از زمان کل کسر نکن\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-n \fR\fB\fIN\fR\fR
.sp
انتزاعی‌سازی اعداد با دست‌کم
\fIN\fR
رقم درون نام‌ها\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-r\fR
.sp
معکوس کردن ترتیب مرتب‌سازی\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-s \fR\fB\fIsort_type\fR\fR
.sp
نحوه مرتب‌سازی خروجی\&. مقدار
\fIsort_type\fR
باید از فهرست زیر انتخاب شود:
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
t,
aa: مرتب‌سازی بر اساس سطرهای تحت‌تأثیر یا میانگین سطرهای تحت‌تأثیر
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
l,
ae: مرتب‌سازی بر اساس سطرهای بررسی‌شده یا مجموع سطرهای بررسی‌شده
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
l,
at: مرتب‌سازی بر اساس زمان پرس‌وجو یا میانگین زمان پرس‌وجو
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
l,
al: مرتب‌سازی بر اساس زمان قفل یا میانگین زمان قفل
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
s,
as: مرتب‌سازی بر اساس سطرهای ارسال‌شده یا میانگین سطرهای ارسال‌شده
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
c: مرتب‌سازی بر اساس تعداد
.RE
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-t \fR\fB\fIN\fR\fR
.sp
تنها نمایش
\fIN\fR
پرس‌وجوی اول در خروجی\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
.\" mariadb-dumpslow: verbose option
.\" verbose option: mariadb-dumpslow
\fB\-\-verbose\fR,
\fB\-v\fR
.sp
حالت پرگو\&. چاپ اطلاعات بیشتر درباره عملکرد برنامه\&.
.RE
.PP
مثال استفاده:
.sp
.if n \{\
.RS 4
.\}
.nf
shell> \fBmariadb-dumpslow\fR
Reading mariadb slow query log from /usr/local/mysql/data/mysqld51\-apple\-slow\&.log
Count: 1  Time=4\&.32s (4s)  Lock=0\&.00s (0s)  Rows=0\&.0 (0), root[root]@localhost
 insert into t2 select * from t1
Count: 3  Time=2\&.53s (7s)  Lock=0\&.00s (0s)  Rows=0\&.0 (0), root[root]@localhost
 insert into t2 select * from t1 limit N
Count: 3  Time=2\&.13s (6s)  Lock=0\&.00s (0s)  Rows=0\&.0 (0), root[root]@localhost
 insert into t1 select * from t1
.fi
.if n \{\
.RE
.\}
