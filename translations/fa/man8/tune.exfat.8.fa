.TH tune.exfat 8
.SH "نام (NAME)"
tune.exfat \- تنظیم پارامترهای قابل‌تنظیم سامانه پرونده روی سامانه پرونده exFAT
.SH "خلاصه دستور (SYNOPSIS)"
.B tune.exfat
[
.B \-l
.I print-label
] [
.B \-L
.I set-label
] [
.B \-u
.I print-guid
] [
.B \-U
.I set-guid
] [
.B \-i
.I print-serial
] [
.B \-I
.I set-serial
] [
.B \-v
]
.I device
.br
.B tune.exfat \-V
.SH "توضیحات (DESCRIPTION)"
دستور
.B tune.exfat
پارامترهای قابل‌تنظیم روی دیسک را در یک سامانه پرونده موجود exFAT تغییر می‌دهد.
.PP
.SH "گزینه‌ها (OPTIONS)"
.TP
.BI \-l " print-label"
چاپ برچسب حجم سامانه پرونده exFAT.
.TP
.BI \-L " set-label"
تنظیم برچسب حجم سامانه پرونده روی آرگومان مشخص‌شده.
.TP
.BI \-u " print-guid"
چاپ شناسه یکتای سراسری (GUID) حجم سامانه پرونده exFAT.
.TP
.BI \-U " set-guid"
تنظیم شناسه یکتای سراسری (GUID) حجم سامانه پرونده روی آرگومان مشخص‌شده.
.TP
.BI \-i " print-serial"
چاپ شماره سریال حجم سامانه پرونده exFAT.
.TP
.BI \-I " set-serial"
تنظیم شماره سریال حجم سامانه پرونده روی آرگومان مشخص‌شده.
.TP
.BI \-v
چاپ اطلاعات تفصیلی اشکال‌زدایی هنگام استخراج یا تنظیم پارامترهای سامانه پرونده exFAT.
.TP
.B \-V
چاپ نسخه برنامه و خروج.
