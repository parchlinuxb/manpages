lt lt
lt lt
lt lt
lt lt.
T{
.sp
%(head)
T}:T{
.sp
شناسه \fIhead\fR که هم‌اکنون مشاهده می‌شود\&. مقدار پیش‌فرض HEAD است\&.
T}
T{
.sp
%(commit)
T}:T{
.sp
شناسه کامیت انتخاب‌شده فعلی\&.
T}
T{
.sp
%(blob)
T}:T{
.sp
شناسه blob انتخاب‌شده فعلی\&.
T}
T{
.sp
%(branch)
T}:T{
.sp
نام شاخه انتخاب‌شده فعلی\&.
T}
T{
.sp
%(remote)
T}:T{
.sp
نام مخزن دوردست (remote) انتخاب‌شده فعلی\&. برای شاخه‌های دوردست %(branch) حاوی نام شاخه خواهد بود\&.
T}
T{
.sp
%(tag)
T}:T{
.sp
نام تگ انتخاب‌شده فعلی\&.
T}
T{
.sp
%(refname)
T}:T{
.sp
نام مرجع انتخاب‌شده فعلی شامل نام مخزن دوردست برای شاخه‌های دوردست\&.
T}
T{
.sp
%(stash)
T}:T{
.sp
نام stash انتخاب‌شده فعلی\&.
T}
T{
.sp
%(directory)
T}:T{
.sp
مسیر دایرکتوری جاری در نمای درخت یا "\&." در صورت تعریف‌نشده بودن\&.
T}
T{
.sp
%(file)
T}:T{
.sp
فایل انتخاب‌شده فعلی\&.
T}
T{
.sp
