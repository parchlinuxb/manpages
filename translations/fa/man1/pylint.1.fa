.SS boolean\-datetime / W1502
.sp
\fBMessage emitted:\fP
.sp
\fBUsing datetime.time in a boolean context.\fP
.sp
\fBDescription:\fP
.sp
\fIUsing datetime.time in a boolean context can hide subtle bugs when the time they represent matches midnight UTC. This behaviour was fixed in Python 3.5. See https://bugs.python.org/issue13936 for reference.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
import datetime

if datetime.time():  # [boolean\-datetime]
    print(\(dqIt is time.\(dq)


if datetime.datetime.now().time():  # [boolean\-datetime]
    print(\(dqNow or never.\(dq)

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
import datetime

time_now_utc = datetime.datetime.now(tz=datetime.UTC).time()

if time_now_utc > datetime.time(6, 0):
    print(\(dqDaytime!\(dq)

if time_now_utc < datetime.time(6, 0):
    print(\(dqNighttime!\(dq)

.EE
