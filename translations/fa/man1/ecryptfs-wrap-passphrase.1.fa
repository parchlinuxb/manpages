.TH ecryptfs-wrap-passphrase 1 2008-07-21 ecryptfs-utils "eCryptfs"
.SH "نام (NAME)"
ecryptfs-wrap-passphrase \- بسته‌بندی عبارت عبور سوار کردن eCryptfs

.SH "خلاصه دستور (SYNOPSIS)"
\fBecryptfs-wrap-passphrase [file]\fP

printf "%s\\n%s" "passphrase to wrap" "wrapping passphrase" | \fBecryptfs-wrap-passphrase [file] -\fP

.SH "توضیحات (DESCRIPTION)"
دستور \fBecryptfs-wrap-passphrase\fP ابزاری است برای بسته‌بندی یک عبارت عبور سوار کردن eCryptfs، با استفاده از یک عبارت عبور بسته‌بندی مشخص، و نوشتن خروجی رمزنگاری‌شده در فایل.

.SH "همچنین ببینید (SEE ALSO)"
.PD 0
.TP
\fBecryptfs\fP(7), \fBecryptfs-rewrap-passphrase\fP(1), \fBecryptfs-unwrap-passphrase\fP(1)

.TP
\fI/usr/share/doc/ecryptfs-utils/ecryptfs-faq.html\fP

.TP
\fIhttp://ecryptfs.org\fP
.PD

