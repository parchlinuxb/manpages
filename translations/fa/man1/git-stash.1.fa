.\"    Author: [FIXME: author] [see http://www.docbook.org/tdg5/en/html/author]
.\" Generator: DocBook XSL Stylesheets vsnapshot <http://docbook.sf.net>
.\"      Date: 2026-06-29
.\"    Manual: دستورات عمومی کاربر
.\"    Source: Git 2.55.0
.\"  Language: Persian
.\"
.TH "GIT\-STASH" "1" "2026\-06\-29" "Git 2\&.55\&.0" "دستورات عمومی کاربر"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
git-stash \- ذخیره موقت تغییرات در یک پوشه کاری کثیف
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.nf
\fBgit\fR \fBstash\fR \fBlist\fR [\fI<log\-options>\fR]
\fBgit\fR \fBstash\fR \fBshow\fR [\fB\-u\fR | \fB\-\-include\-untracked\fR | \fB\-\-only\-untracked\fR] [\fI<diff\-options>\fR] [\fI<stash>\fR]
\fBgit\fR \fBstash\fR \fBdrop\fR [\fB\-q\fR | \fB\-\-quiet\fR] [\fI<stash>\fR]
\fBgit\fR \fBstash\fR \fBpop\fR [\fB\-\-index\fR] [\fB\-q\fR | \fB\-\-quiet\fR] [\fI<stash>\fR]
\fBgit\fR \fBstash\fR \fBapply\fR [\fB\-\-index\fR] [\fB\-q\fR | \fB\-\-quiet\fR] [\fB\-\-label\-ours=\fR\fI<label>\fR] [\fB\-\-label\-theirs=\fR\fI<label>\fR] [\fB\-\-label\-base=\fR\fI<label>\fR] [\fI<stash>\fR]
\fBgit\fR \fBstash\fR \fBbranch\fR \fI<branchname>\fR [\fI<stash>\fR]
\fBgit\fR \fBstash\fR [\fBpush\fR] [\fB\-p\fR | \fB\-\-patch\fR] [\fB\-S\fR | \fB\-\-staged\fR] [\fB\-k\fR | \fB\-\-\fR[\fBno\-\fR]\fBkeep\-index\fR] [\fB\-q\fR | \fB\-\-quiet\fR]
             [\fB\-u\fR | \fB\-\-include\-untracked\fR] [\fB\-a\fR | \fB\-\-all\fR] [(\fB\-m\fR | \fB\-\-message\fR) \fI<message>\fR]
             [\fB\-\-pathspec\-from\-file=\fR\fI<file>\fR [\fB\-\-pathspec\-file\-nul\fR]]
             [\fB\-\-\fR] [\fI<pathspec>\fR\&...]
\fBgit\fR \fBstash\fR \fBsave\fR [\fB\-p\fR | \fB\-\-patch\fR] [\fB\-S\fR | \fB\-\-staged\fR] [\fB\-k\fR | \fB\-\-\fR[\fBno\-\fR]\fBkeep\-index\fR] [\fB\-q\fR | \fB\-\-quiet\fR]
           [\fB\-u\fR | \fB\-\-include\-untracked\fR] [\fB\-a\fR | \fB\-\-all\fR] [\fI<message>\fR]
\fBgit\fR \fBstash\fR \fBclear\fR
\fBgit\fR \fBstash\fR \fBcreate\fR [\fI<message>\fR]
\fBgit\fR \fBstash\fR \fBstore\fR [(\fB\-m\fR | \fB\-\-message\fR) \fI<message>\fR] [\fB\-q\fR | \fB\-\-quiet\fR] \fI<commit>\fR
\fBgit\fR \fBstash\fR \fBexport\fR (\fB\-\-print\fR | \fB\-\-to\-ref\fR \fI<ref>\fR) [\fI<stash>\fR\&...]
\fBgit\fR \fBstash\fR \fBimport\fR \fI<commit>\fR
.fi
.sp
.SH "توضیحات (DESCRIPTION)"
.sp
هنگامی که می‌خواهید وضعیت فعلی پوشه کاری و ایندکس را ثبت کنید، اما در عین حال مایلید به یک پوشه کاری تمیز برگردید، از
\fBgit\fR \fBstash\fR
استفاده کنید\&. این دستور تغییرات محلی شما را به صورت موقت ذخیره کرده و پوشه کاری را به گونه‌ای بازمی‌گرداند که با کامیت
\fBHEAD\fR
مطابقت داشته باشد\&.
.sp
تغییرات ذخیره‌شده توسط این دستور را می‌توان با
\fBgit\fR \fBstash\fR \fBlist\fR
فهرست کرد، با
\fBgit\fR \fBstash\fR \fBshow\fR
مورد بازبینی قرار داد، و با
\fBgit\fR \fBstash\fR \fBapply\fR
(احتمالاً بر روی یک کامیت متفاوت) بازیابی نمود\&. فراخوانی
\fBgit\fR \fBstash\fR
بدون هیچ آرگومانی معادل
\fBgit\fR \fBstash\fR \fBpush\fR
است\&. یک استش به طور پیش‌فرض به صورت "WIP on \fI<branchname>\fR \&..." فهرست می‌شود، اما شما می‌توانید هنگام ایجاد آن، پیام توصیفی‌تری را در خط فرمان مشخص کنید\&.
.sp
جدیدترین استشی که ایجاد کرده‌اید در
\fBrefs/stash\fR
ذخیره می‌شود؛ استش‌های قدیمی‌تر در وقایع ارجاع (reflog) این مرجع یافت می‌شوند و می‌توان آن‌ها را با استفاده از نحو معمول reflog نام‌گذاری کرد (برای مثال،
\fBstash@\fR{0}
جدیدترین استش ایجادشده است،
\fBstash@\fR{1}
مربوط به قبل از آن است، و
\fBstash@\fR{2\&.hours\&.ago}
نیز امکان‌پذیر است)\&. همچنین می‌توان به استش‌ها تنها با مشخص کردن نمایه (index) استش ارجاع داد (به عنوان مثال، عدد صحیح
\fI<n>\fR
معادل
\fBstash@\fR{\fI<n>\fR}
است)\&.
.SH "دستورها (COMMANDS)"
.PP
\fBpush\fR [\fB\-p\fR | \fB\-\-patch\fR] [\fB\-S\fR | \fB\-\-staged\fR] [\fB\-k\fR | \fB\-\-\fR[\fBno\-\fR]\fBkeep\-index\fR] [\fB\-u\fR | \fB\-\-include\-untracked\fR] [ \fB\-a\fR | \fB\-\-all\fR] [\fB\-q\fR | \fB\-\-quiet\fR] [(\fB\-m\fR|\fB\-\-message\fR) \fI<message>\fR] [\fB\-\-pathspec\-from\-file=\fR\fI<file>\fR [\fB\-\-pathspec\-file\-nul\fR]] [\fB\-\-\fR] [\fI<pathspec>\fR\&.\&.\&.]
.RS 4
تغییرات محلی شما را در یک
\fIstash entry\fR
(مدخل استش) جدید ذخیره کرده و آن‌ها را (هم در درخت کاری و هم در ایندکس) به
\fBHEAD\fR
برمی‌گرداند\&. بخش
\fI<message>\fR
اختیاری است و توضیحی را همراه با وضعیت استش‌شده ارائه می‌دهد\&.
.sp
برای ثبت سریع یک تصویر لحظه‌ای (snapshot)، می‌توانید "push" را حذف کنید\&. در این حالت، عناصر pathspec تنها پس از یک خط تیره دوگانه
\fB\-\-\fR
مجاز هستند تا از ایجاد ناخواسته یک مدخل استش به دلیل املای اشتباه زیردستور جلوگیری شود\&.
.RE
.PP
\fBsave\fR [\fB\-p\fR | \fB\-\-patch\fR] [\fB\-S\fR | \fB\-\-staged\fR] [\fB\-k\fR | \fB\-\-\fR[\fBno\-\fR]\fBkeep\-index\fR] [\fB\-u\fR | \fB\-\-include\-untracked\fR] [\fB\-a\fR | \fB\-\-all\fR] [\fB\-q\fR | \fB\-\-quiet\fR] [\fI<message>\fR]
.RS 4
این دستور منسوخ شده و استفاده از
\fIgit stash push\fR
به جای آن توصیه می‌شود\&. تفاوت آن با "stash push" در این است که نمی‌تواند pathspec دریافت کند\&. در عوض، تمام آرگومان‌های غیرگزینه‌ای برای تشکیل پیام استش به یکدیگر متصل می‌شوند\&.
.RE
.PP
\fBlist\fR [\fI<log\-options>\fR]
.RS 4
مدخل‌های استشی را که در حال حاضر دارید فهرست می‌کند\&. هر
\fIstash entry\fR
همراه با نام آن (به عنوان مثال
\fBstash@\fR{0}
جدیدترین مدخل است،
\fBstash@\fR{1}
مدخل ماقبل آن است، و غیره)، نام شاخه‌ای که هنگام ایجاد مدخل فعال بوده، و توضیحی کوتاه از کامیتی که مدخل بر اساس آن ساخته شده، فهرست می‌شود\&.
.sp
.if n \{\
.RS 4
.\}
.nf
stash@{0}: WIP on submit: 6ebd0e2\&.\&.\&. Update git\-stash documentation
stash@{1}: On master: 9cc0589\&.\&.\&. Add git\-stash
.fi
.if n \{\
.RE
.\}
.sp
این دستور گزینه‌های قابل استفاده در دستور
\fIgit log\fR
را می‌پذیرد تا نحوه و نوع نمایش را کنترل کند\&. به
\fBgit-log\fR(1)
مراجعه کنید\&.
.RE
.PP
\fBshow\fR [\fB\-u\fR | \fB\-\-include\-untracked\fR | \fB\-\-only\-untracked\fR] [\fI<diff\-options>\fR] [\fI<stash>\fR]
.RS 4
تغییرات ثبت‌شده در مدخل استش را به صورت یک تفاوت (diff) میان محتویات استش‌شده و کامیتی که مدخل استش در ابتدا بر پایه آن ایجاد شده بود، نشان می‌دهد\&. این دستور به طور پیش‌فرض آمار تفاوت‌ها (diffstat) را نشان می‌دهد، اما هر قالبی را که برای
\fIgit diff\fR
شناخته‌شده باشد می‌پذیرد (مانند
\fBgit\fR
\fBstash\fR
\fBshow\fR
\fB\-p\fR
\fBstash@\fR{1}
برای مشاهده دومین مدخل اخیر در قالب وصله/patch)\&. اگر هیچ
\fI<diff\-option>\fR
مشخص نشود، رفتار پیش‌فرض توسط متغیرهای پیکربندی
\fBstash\&.showStat\fR
و
\fBstash\&.showPatch\fR
تعیین می‌شود\&. همچنین می‌توانید از
\fBstash\&.showIncludeUntracked\fR
برای تعیین این که آیا
\fB\-\-include\-untracked\fR
به طور پیش‌فرض فعال باشد یا خیر استفاده کنید\&.
.RE
.PP
\fBpop\fR [\fB\-\-index\fR] [\fB\-q\fR | \fB\-\-quiet\fR] [\fI<stash>\fR]
.RS 4
یک وضعیت ذخیره‌شده را از فهرست استش‌ها حذف کرده و آن را بر روی وضعیت فعلی درخت کاری اعمال می‌کند؛ یعنی عملیات معکوس
\fBgit\fR
\fBstash\fR
\fBpush\fR
را انجام می‌دهد\&. پوشه کاری باید با ایندکس مطابقت داشته باشد\&.
.sp
اعمال وضعیت ممکن است به دلیل بروز تداخل‌ها (conflicts) با شکست مواجه شود؛ در این حالت، مدخل از فهرست استش‌ها حذف نخواهد شد\&. شما باید تداخل‌ها را به صورت دستی حل کرده و سپس به صورت دستی
\fBgit\fR
\fBstash\fR
\fBdrop\fR
را فراخوانی کنید\&.
.RE
.PP
\fBapply\fR [\fB\-\-index\fR] [\fB\-q\fR | \fB\-\-quiet\fR] [\fI<stash>\fR]
.RS 4
مشابه
\fBpop\fR
عمل می‌کند، اما وضعیت را از فهرست استش‌ها حذف نمی‌کند\&. بر خلاف
\fBpop\fR،
مقدار
\fI<stash>\fR
می‌تواند هر کامیتی باشد که شبیه به یک کامیت ایجادشده توسط
\fBstash\fR
\fBpush\fR
یا
\fBstash\fR
\fBcreate\fR
به نظر برسد\&.
.RE
.PP
\fBbranch\fR \fI<branchname>\fR [\fI<stash>\fR]
.RS 4
یک شاخه جدید به نام
\fI<branchname>\fR
شروع‌شده از کامیتی که
\fI<stash>\fR
در اصل روی آن ایجاد شده بود ایجاد کرده و به آن تغییر وضعیت می‌دهد (تحویل می‌گیرد)، و تغییرات ثبت‌شده در
\fI<stash>\fR
را بر روی درخت کاری و ایندکس جدید اعمال می‌کند\&. اگر این کار موفقیت‌آمیز باشد و
\fI<stash>\fR
مرجعی به شکل
\fBstash@\fR{\fI<revision>\fR}
باشد، آنگاه
\fI<stash>\fR
را حذف (drop) می‌کند\&.
.sp
این دستور زمانی مفید است که شاخه‌ای که
\fBgit\fR
\fBstash\fR
\fBpush\fR
را روی آن اجرا کرده‌اید به اندازه‌ای تغییر کرده باشد که
\fBgit\fR
\fBstash\fR
\fBapply\fR
به دلیل بروز تداخل‌ها با خطا مواجه شود\&. از آنجا که مدخل استش بر روی کامیتی اعمال می‌شود که در زمان اجرای
\fBgit\fR
\fBstash\fR
به عنوان HEAD فعال بوده است، وضعیت استش‌شده اولیه را بدون هیچ تداخلی بازیابی می‌کند\&.
.RE
.PP
\fBclear\fR
.RS 4
تمام مدخل‌های استش را حذف می‌کند\&. توجه داشته باشید که این مدخل‌ها پس از آن مشمول هرس کردن (pruning) خواهند شد و بازیابی آن‌ها ممکن است غیرممکن باشد (برای یک راهکار احتمالی به بخش
\fIمثال‌ها (EXAMPLES)\fR
در زیر مراجعه کنید)\&.
.RE
.PP
\fBdrop\fR [\fB\-q\fR | \fB\-\-quiet\fR] [\fI<stash>\fR]
.RS 4
یک مدخل استش منفرد را از فهرست مدخل‌های استش حذف می‌کند\&.
.RE
.PP
\fBcreate\fR
.RS 4
یک مدخل استش (که یک شیء کامیت معمولی است) ایجاد کرده و نام شیء آن را بدون ذخیره در هیچ‌کدام از فضاهای نام ارجاع برمی‌گرداند\&. هدف از این دستور کاربرد در اسکریپت‌ها است\&. احتمالاً این دستوری نیست که به دنبال استفاده از آن باشید؛ بخش "push" را در بالا ببینید\&.
.RE
.PP
\fBstore\fR
.RS 4
استش داده‌شده را که از طریق
\fIgit stash create\fR
ایجاد شده است (که یک کامیت ادغام معلق است) در مرجع استش ذخیره کرده و وقایع ارجاع (reflog) استش را به‌روزرسانی می‌کند\&. هدف از این دستور کاربرد در اسکریپت‌ها است\&. احتمالاً این دستوری نیست که به دنبال استفاده از آن باشید؛ بخش "push" را در بالا ببینید\&.
.RE
.PP
\fBexport\fR ( \fB\-\-print\fR | \fB\-\-to\-ref\fR \fI<ref>\fR ) [\fI<stash>\fR\&.\&.\&.]
.RS 4
استش‌های مشخص‌شده، یا تمام آن‌ها را در صورت عدم تعیین، به زنجیره‌ای از کامیت‌ها صادر می‌کند که می‌توان آن‌ها را با استفاده از سازوکارهای عادی fetch و push انتقال داد، و سپس با زیردستور
\fBimport\fR
وارد کرد\&.
.RE
.PP
\fBimport\fR \fI<commit>\fR
.RS 4
استش‌های مشخص‌شده را از کامیت تعیین‌شده که حتماً باید توسط
\fBexport\fR
ایجاد شده باشد وارد کرده و آن‌ها را به فهرست استش‌ها می‌افزاید\&. برای جایگزینی استش‌های موجود، ابتدا از
\fBclear\fR
استفاده کنید\&.
.RE
.SH "گزینه‌ها (OPTIONS)"
.PP
\fB\-a\fR, \fB\-\-all\fR
.RS 4
این گزینه تنها برای دستورهای
\fBpush\fR
و
\fBsave\fR
معتبر است\&.
.sp
تمام فایل‌های نادیده‌گرفته‌شده (ignored) و ردگیری‌نشده (untracked) نیز استش شده و سپس با
\fBgit\fR
\fBclean\fR
پاک‌سازی می‌شوند\&.
.RE
.PP
\fB\-u\fR, \fB\-\-include\-untracked\fR, \fB\-\-no\-include\-untracked\fR
.RS 4
هنگامی که با دستورهای
\fBpush\fR
و
\fBsave\fR
استفاده شود، تمام فایل‌های ردگیری‌نشده نیز استش شده و سپس با
\fBgit\fR
\fBclean\fR
پاک‌سازی می‌شوند\&.
.sp
هنگامی که با دستور
\fBshow\fR
استفاده شود، فایل‌های ردگیری‌نشده در مدخل استش را به عنوان بخشی از تفاوت (diff) نشان می‌دهد\&.
.RE
.PP
\fB\-\-only\-untracked\fR
.RS 4
این گزینه تنها برای دستور
\fBshow\fR
معتبر است\&.
.sp
تنها فایل‌های ردگیری‌نشده در مدخل استش را به عنوان بخشی از تفاوت (diff) نشان می‌دهد\&.
.RE
.PP
\fB\-\-index\fR
.RS 4
این گزینه تنها برای دستورهای
\fBpop\fR
و
\fBapply\fR
معتبر است\&.
.sp
تلاش می‌کند تا نه تنها تغییرات درخت کاری، بلکه تغییرات ایندکس را نیز بازگرداند\&. با این حال، در صورت وجود تداخل‌ها این کار ممکن است با شکست مواجه شود (چرا که تداخل‌ها در ایندکس ذخیره می‌شوند و بنابراین دیگر نمی‌توانید تغییرات را به همان شکل اولیه اعمال کنید)\&.
.RE
.PP
\fB\-\-label\-ours=\fR\fI<label>\fR, \fB\-\-label\-theirs=\fR\fI<label>\fR, \fB\-\-label\-base=\fR\fI<label>\fR
.RS 4
این گزینه‌ها تنها برای دستور
\fBapply\fR
معتبر هستند\&.
.sp
از برچسب‌های ارائه‌شده در نشانگرهای تداخل به جای موارد پیش‌فرض "Updated upstream"، "Stashed changes" و "Stash base" استفاده می‌کند\&. گزینه
\fB\-\-label\-base\fR
تنها زمانی که merge\&.conflictStyle=diff3 باشد تأثیر دارد\&.
.RE
.PP
\fB\-k\fR, \fB\-\-keep\-index\fR, \fB\-\-no\-keep\-index\fR
.RS 4
این گزینه تنها برای دستورهای
\fBpush\fR
و
\fBsave\fR
معتبر است\&.
.sp
تمام تغییراتی که قبلاً به ایندکس اضافه شده‌اند دست‌نخورده باقی می‌مانند\&.
.RE
.PP
\fB\-p\fR, \fB\-\-patch\fR
.RS 4
این گزینه تنها برای دستورهای
\fBpush\fR
و
\fBsave\fR
معتبر است\&.
.sp
تکه‌های تغییر (hunk) را به صورت تعاملی از تفاوت میان HEAD و درخت کاری برای ذخیره در استش انتخاب می‌کند\&. مدخل استش به گونه‌ای ساخته می‌شود که وضعیت ایندکس آن همان وضعیت ایندکس مخزن شما باشد، و درخت کاری آن تنها شامل تغییراتی باشد که به صورت تعاملی انتخاب کرده‌اید\&. سپس تغییرات انتخاب‌شده از درخت کاری شما به عقب بازگردانده می‌شوند\&. برای آشنایی با نحوه کار با حالت
\fB\-\-patch\fR،
بخش \(lqInteractive Mode\(rq از
\fBgit-add\fR(1)
را ببینید\&.
.sp
گزینه
\fB\-\-patch\fR
متضمن
\fB\-\-keep\-index\fR
است\&. برای لغو این رفتار می‌توانید از
\fB\-\-no\-keep\-index\fR
استفاده کنید\&.
.RE
.PP
\fB\-U\fR\fI<n>\fR, \fB\-\-unified=\fR\fI<n>\fR
.RS 4
تفاوت‌ها را با
\fI<n>\fR
خط از متن پیرامون (context) تولید می‌کند\&. تعداد خطوط متن پیرامون به طور پیش‌فرض برابر با مقدار متغیر
\fBdiff\&.context\fR
یا در صورت عدم تنظیم برابر ۳ است\&. (گزینه
\fB\-U\fR
بدون
\fI<n>\fR
به دلایل تاریخی به عنوان مترادفی برای
\fB\-p\fR
بدون ایجاد خطا پذیرفته می‌شود)\&.
.RE
.PP
\fB\-\-inter\-hunk\-context=\fR\fI<n>\fR
.RS 4
متن پیرامون میان تکه‌های تفاوت (diff hunks) را تا
\fI<number>\fR
خطِ مشخص‌شده نشان می‌دهد، و بدین ترتیب تکه‌هایی را که به یکدیگر نزدیک هستند ادغام می‌کند\&. پیش‌فرض آن مقدار
\fBdiff\&.interHunkContext\fR
یا در صورت عدم تنظیم گزینه پیکربندی برابر با ۰ است\&.
.RE
.PP
\fB\-S\fR, \fB\-\-staged\fR
.RS 4
این گزینه تنها برای دستورهای
\fBpush\fR
و
\fBsave\fR
معتبر است\&.
.sp
تنها تغییراتی را که در حال حاضر استیج شده‌اند (در ایندکس قرار دارند) استش می‌کند\&. این مشابه دستور پایه
\fBgit\fR
\fBcommit\fR
است با این تفاوت که وضعیت به جای شاخه فعلی، در استش کامیت می‌شود\&.
.sp
گزینه
\fB\-\-patch\fR
نسبت به این گزینه اولویت دارد\&.
.RE
.PP
\fB\-\-pathspec\-from\-file=\fR\fI<file>\fR
.RS 4
این گزینه تنها برای دستور
\fBpush\fR
معتبر است\&.
.sp
مسیر مشخص‌شده (pathspec) به جای آرگومان‌های خط فرمان، از طریق
\fI<file>\fR
داده می‌شود\&. اگر
\fI<file>\fR
دقیقاً
\fB\-\fR
باشد، ورودی استاندارد استفاده خواهد شد\&. عناصر pathspec با LF یا CR/LF از یکدیگر جدا می‌شوند\&. عناصر pathspec را می‌توان طبق توضیحات ارائه‌شده برای متغیر پیکربندی
\fBcore\&.quotePath\fR
در نقل‌قول (کوتیشن) قرار داد (به
\fBgit-config\fR(1)
مراجعه کنید)\&. همچنین به
\fB\-\-pathspec\-file\-nul\fR
و گزینه سراسری
\fB\-\-literal\-pathspecs\fR
نگاه کنید\&.
.RE
.PP
\fB\-\-pathspec\-file\-nul\fR
.RS 4
این گزینه تنها برای دستور
\fBpush\fR
معتبر است\&.
.sp
تنها همراه با
\fB\-\-pathspec\-from\-file\fR
معنا دارد\&. عناصر pathspec با کاراکتر NUL از یکدیگر جدا می‌شوند و تمام کاراکترهای دیگر دقیقاً همان‌گونه که هستند تفسیر خواهند شد (شامل خطوط جدید و علامت‌های نقل‌قول)\&.
.RE
.PP
\fB\-q\fR, \fB\-\-quiet\fR
.RS 4
این گزینه تنها برای دستورهای
\fBapply\fR،
\fBdrop\fR،
\fBpop\fR،
\fBpush\fR،
\fBsave\fR
و
\fBstore\fR
معتبر است\&.
.sp
حالت بی‌صدا، از نمایش پیام‌های بازخورد جلوگیری می‌کند\&.
.RE
.PP
\fB\-\-print\fR
.RS 4
این گزینه تنها برای دستور
\fBexport\fR
معتبر است\&.
.sp
زنجیره کامیت‌های ارائه‌دهنده استش‌های صادرشده را بدون ذخیره آن در هیچ‌یک از فضاهای نام ارجاع ایجاد کرده و شناسه شیء (object ID) را در خروجی استاندارد چاپ می‌کند\&. این گزینه برای استفاده در اسکریپت‌ها طراحی شده است\&.
.RE
.PP
\fB\-\-to\-ref\fR
.RS 4
این گزینه تنها برای دستور
\fBexport\fR
معتبر است\&.
.sp
زنجیره کامیت‌های ارائه‌دهنده استش‌های صادرشده را ایجاد کرده و آن را در ارجاع (ref) مشخص‌شده ذخیره می‌کند\&.
.RE
.PP
\fB\-\-\fR
.RS 4
این گزینه تنها برای دستور
\fBpush\fR
معتبر است\&.
.sp
مسیر (pathspec) را به منظور رفع ابهام از گزینه‌ها جدا می‌کند\&.
.RE
.PP
\fI<pathspec>\fR\&.\&.\&.
.RS 4
این گزینه تنها برای دستور
\fBpush\fR
معتبر است\&.
.sp
مدخل استش جدید، وضعیت‌های تغییریافته را تنها برای فایل‌هایی ثبت می‌کند که با الگوی pathspec مطابقت دارند\&. سپس مدخل‌های ایندکس و فایل‌های درخت کاری تنها برای همین فایل‌ها نیز به وضعیت HEAD بازگردانده می‌شوند، و فایل‌هایی که با pathspec تطابق ندارند دست‌نخورده باقی می‌مانند\&.
.sp
برای جزئیات بیشتر، مدخل
\fIpathspec\fR
را در
\fBgitglossary\fR(7)
ببینید\&.
.RE
.PP
\fI<stash>\fR
.RS 4
این گزینه تنها برای دستورهای
\fBapply\fR،
\fBbranch\fR،
\fBdrop\fR،
\fBpop\fR،
\fBshow\fR
و
\fBexport\fR
معتبر است\&.
.sp
ارجاعی به صورت
\fBstash@\fR{\fI<revision>\fR}\&.
هنگامی که هیچ
\fI<stash>\fR
مشخص نشده باشد، جدیدترین استش در نظر گرفته می‌شود (یعنی
\fBstash@\fR{0})\&.
.RE
.SH "بحث و بررسی (DISCUSSION)"
.sp
یک مدخل استش به عنوان کامیتی نشان داده می‌شود که درخت آن وضعیت پوشه کاری را ثبت می‌کند، و والد اول آن همان کامیت موجود در
\fBHEAD\fR
در زمان ایجاد مدخل است\&. درخت والد دوم وضعیت ایندکس را در زمان ایجاد مدخل ثبت می‌کند، و به عنوان فرزندی از کامیت
\fBHEAD\fR
قرار می‌گیرد\&. نمودار تبارشناسی به صورت زیر است:
.sp
.if n \{\
.RS 4
.\}
.nf
       \&.\-\-\-\-W
      /    /
\-\-\-\-\-H\-\-\-\-I
.fi
.if n \{\
.RE
.\}
.sp
که در آن
\fBH\fR
کامیت
\fBHEAD\fR،
\fBI\fR
کامیتی که وضعیت ایندکس را ثبت می‌کند، و
\fBW\fR
کامیتی است که وضعیت درخت کاری را ثبت می‌کند\&.
.SH "مثال‌ها (EXAMPLES)"
.PP
دریافت تغییرات (pull) در یک درخت کاری کثیف
.RS 4
هنگامی که در میانه انجام کاری هستید، متوجه می‌شوید که تغییراتی در بالادست (upstream) وجود دارد که احتمالاً به کار شما مرتبط است\&. اگر تغییرات محلی شما با تغییرات بالادست تداخل نداشته باشند، یک دستور ساده
\fBgit\fR
\fBpull\fR
به شما امکان می‌دهد کار را به جلو ببرید\&.
.sp
با این حال، مواردی وجود دارد که در آن تغییرات محلی شما با تغییرات بالادست تداخل دارند و
\fBgit\fR
\fBpull\fR
از بازنویسی تغییرات شما امتناع می‌ورزد\&. در چنین شرایطی، می‌توانید تغییرات خود را استش کنید، pull را انجام دهید، و سپس تغییرات را از استش خارج کنید (unstash)، به این صورت:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git pull
 \&.\&.\&.
file foobar not up to date, cannot merge\&.
$ git stash
$ git pull
$ git stash pop
.fi
.if n \{\
.RE
.\}
.sp
.RE
.PP
جریان کاری قطع‌شده (وقفه در کار)
.RS 4
هنگامی که مشغول انجام کاری هستید، مدیرتان می‌آید و می‌خواهد بلافاصله مشکلی را برطرف کنید\&. به طور سنتی، برای ذخیره تغییرات خود یک کامیت در شاخه‌ای موقت ایجاد می‌کردید و برای انجام اصلاح اضطراری به شاخه اصلی خود بازمی‌گشتید، مانند این:
.sp
.if n \{\
.RS 4
.\}
.nf
# \&.\&.\&. hack hack hack \&.\&.\&.
$ git switch \-c my_wip
$ git commit \-a \-m "WIP"
$ git switch master
$ edit emergency fix
$ git commit \-a \-m "Fix in a hurry"
$ git switch my_wip
$ git reset \-\-soft HEAD^
# \&.\&.\&. continue hacking \&.\&.\&.
.fi
.if n \{\
.RE
.\}
.sp
می‌توانید برای ساده‌تر کردن فرآیند بالا از
\fIgit stash\fR
استفاده کنید، به این صورت:
.sp
.if n \{\
.RS 4
.\}
.nf
# \&.\&.\&. hack hack hack \&.\&.\&.
$ git stash
$ edit emergency fix
$ git commit \-a \-m "Fix in a hurry"
$ git stash pop
# \&.\&.\&. continue hacking \&.\&.\&.
.fi
.if n \{\
.RE
.\}
.sp
.RE
.PP
آزمایش کامیت‌های جزئی
.RS 4
هنگامی که می‌خواهید از تغییرات موجود در درخت کاری دو یا چند کامیت بسازید و مایلید هر تغییر را قبل از کامیت کردن آزمایش کنید، می‌توانید از
\fBgit\fR
\fBstash\fR
\fBpush\fR
\fB\-\-keep\-index\fR
استفاده نمایید:
.sp
.if n \{\
.RS 4
.\}
.nf
# \&.\&.\&. hack hack hack \&.\&.\&.
$ git add \-\-patch foo            # add just first part to the index
$ git stash push \-\-keep\-index    # save all other changes to the stash
$ edit/build/test first part
$ git commit \-m \*(AqFirst part\*(Aq     # commit fully tested change
$ git stash pop                  # prepare to work on all other changes
# \&.\&.\&. repeat above five steps until one commit remains \&.\&.\&.
$ edit/build/test remaining parts
$ git commit foo \-m \*(AqRemaining parts\*(Aq
.fi
.if n \{\
.RE
.\}
.sp
.RE
.PP
ذخیره تغییرات غیرمرتبط برای استفاده‌های بعدی
.RS 4
هنگامی که در میانه تغییرات گسترده‌ای هستید و به موضوع نامرتبطانه‌ای برمی‌خورید که نمی‌خواهید اصلاح آن را فراموش کنید، می‌توانید تغییر(ها) را انجام داده، آن‌ها را استیج کنید و از
\fBgit\fR
\fBstash\fR
\fBpush\fR
\fB\-\-staged\fR
برای استش کردن آن‌ها جهت استفاده بعدی بهره ببرید\&. این کار مشابه کامیت کردن تغییرات استیج‌شده است، با این تفاوت که کامیت به جای شاخه فعلی، در استش قرار می‌گیرد\&.
.sp
.if n \{\
.RS 4
.\}
.nf
# \&.\&.\&. hack hack hack \&.\&.\&.
$ git add \-\-patch foo           # add unrelated changes to the index
$ git stash push \-\-staged       # save these changes to the stash
# \&.\&.\&. hack hack hack, finish current changes \&.\&.\&.
$ git commit \-m \*(AqMassive\*(Aq       # commit fully tested changes
$ git switch fixup\-branch       # switch to another branch
$ git stash pop                 # to finish work on the saved changes
.fi
.if n \{\
.RE
.\}
.sp
.RE
.PP
بازیابی مدخل‌های استش که به اشتباه پاک یا حذف شده‌اند
.RS 4
اگر به اشتباه مدخل‌های استش را حذف (drop) یا پاک (clear) کنید، از طریق سازوکارهای ایمنی معمول قابل بازیابی نیستند\&. با این حال، می‌توانید دستور زیر را برای دریافت فهرستی از مدخل‌های استش که هنوز در مخزن شما موجودند اما دیگر قابل دسترسی نیستند، امتحان کنید:
.sp
.if n \{\
.RS 4
.\}
.nf
git fsck \-\-unreachable |
grep commit | cut \-d\e  \-f3 |
xargs git log \-\-merges \-\-no\-walk \-\-grep=WIP
.fi
.if n \{\
.RE
.\}
.sp
.RE
.SH "پیکربندی (CONFIGURATION)"
.sp
تمام موارد زیر در این بخش به طور گزینشی از مستندات
\fBgit-config\fR(1)
آورده شده است\&. محتوا دقیقاً همان چیزی است که در آنجا یافت می‌شود:
.PP
\fBstash\&.index\fR
.RS 4
اگر این متغیر روی true تنظیم شود،
\fBgit\fR
\fBstash\fR
\fBapply\fR
و
\fBgit\fR
\fBstash\fR
\fBpop\fR
به گونه‌ای رفتار خواهند کرد که گویی گزینه
\fB\-\-index\fR
داده شده است\&. مقدار پیش‌فرض آن false است\&.
.RE
.PP
\fBstash\&.showIncludeUntracked\fR
.RS 4
اگر این متغیر روی true تنظیم شود، دستور
\fBgit\fR
\fBstash\fR
\fBshow\fR
فایل‌های ردگیری‌نشده یک مدخل استش را نمایش خواهد داد\&. مقدار پیش‌فرض آن false است\&.
.RE
.PP
\fBstash\&.showPatch\fR
.RS 4
اگر این متغیر روی true تنظیم شود، دستور
\fBgit\fR
\fBstash\fR
\fBshow\fR
بدون هیچ گزینه‌ای، مدخل استش را در قالب وصله (patch) نشان خواهد داد\&. مقدار پیش‌فرض آن false است\&.
.RE
.PP
\fBstash\&.showStat\fR
.RS 4
اگر این متغیر روی true تنظیم شود، دستور
\fBgit\fR
\fBstash\fR
\fBshow\fR
بدون هیچ گزینه‌ای، آمار تفاوت‌ها (diffstat) را برای مدخل استش نشان خواهد داد\&. مقدار پیش‌فرض آن true است\&.
.RE
.SH "همچنین ببینید (SEE ALSO)"
.sp
\fBgit-checkout\fR(1), \fBgit-commit\fR(1), \fBgit-reflog\fR(1), \fBgit-reset\fR(1), \fBgit-switch\fR(1)
.SH "گیت (GIT)"
.sp
بخشی از مجموعه \fBgit\fR(1)
