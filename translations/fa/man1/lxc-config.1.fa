.\" -*- coding: UTF-8 -*-
.if \n(.g .ds T< \\FC
.if \n(.g .ds T> \\F[\n[.fam]]
.de URL
\\$2 \(la\\$1\(ra\\$3
..
.if \n(.g .mso www.tmac
.TH lxc-config 1 2026-08-01 "" ""
.SH "نام (NAME)"
lxc-config \- query LXC system configuration 
.SH "خلاصه دستور (SYNOPSIS)"
'nh
.fi
.ad l
\fBlxc-config\fR \kx
.if (\nx>(\n(.l/2)) .nr x (\n(.l/5)
'in \n(.iu+\nxu
[-l] [\fIitem\fR]
'in \n(.iu-\nxu
.ad b
'hy
.SH "توضیحات (DESCRIPTION)"
\fBlxc-config\fR queries the lxc system
configuration and lets you list all valid keys or query
individual keys for their value.
.SH "گزینه‌ها (OPTIONS)"
.TP 
\*(T<\fB\-l\fR\*(T> 
List all supported keys.
.TP 
\*(T<\fBitem\fR\*(T> 
Query the value of the specified key.
.SH "همچنین ببینید (SEE ALSO)"
\fBlxc\fR(7),
\fBlxc-create\fR(1),
\fBlxc-copy\fR(1),
\fBlxc-destroy\fR(1),
\fBlxc-start\fR(1),
\fBlxc-stop\fR(1),
\fBlxc-execute\fR(1),
\fBlxc-console\fR(1),
\fBlxc-monitor\fR(1),
\fBlxc-wait\fR(1),
\fBlxc-cgroup\fR(1),
\fBlxc-ls\fR(1),
\fBlxc-info\fR(1),
\fBlxc-freeze\fR(1),
\fBlxc-unfreeze\fR(1),
\fBlxc-attach\fR(1),
\fBlxc.conf\fR(5)
