.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-service-update \- به‌روزرسانی یک سرویس


.SH "خلاصه (SYNOPSIS)"
\fBdocker service update [OPTIONS] SERVICE\fP


.SH "شرح (DESCRIPTION)"
به‌روزرسانی یک سرویس


.SH "گزینه‌ها (OPTIONS)"
\fB--args\fP=
	آرگومان‌های دستور سرویس

.PP
\fB--cap-add\fP=
	افزودن قابلیت‌های لینوکس (Linux capabilities)

.PP
\fB--cap-drop\fP=
	حذف قابلیت‌های لینوکس (Linux capabilities)

.PP
\fB--config-add\fP=
	افزودن یا به‌روزرسانی یک فایل پیکربندی روی یک سرویس

.PP
\fB--config-rm\fP=
	حذف یک فایل پیکربندی

.PP
\fB--constraint-add\fP=
	افزودن یا به‌روزرسانی یک قید جای‌گذاری (placement constraint)

.PP
\fB--constraint-rm\fP=
	حذف یک قید

.PP
\fB--container-label-add\fP=
	افزودن یا به‌روزرسانی برچسب یک کانتینر

.PP
\fB--container-label-rm\fP=
	حذف برچسب کانتینر با کلید آن

.PP
\fB--credential-spec\fP=
	مشخصات اعتبارنامه (Credential spec) برای حساب سرویس مدیریت‌شده (فقط ویندوز)

.PP
\fB-d\fP, \fB--detach\fP[=false]
	خروج فوری به‌جای انتظار برای همگرایی سرویس

.PP
\fB--dns-add\fP=
	افزودن یا به‌روزرسانی سرور DNS سفارشی

.PP
\fB--dns-option-add\fP=
	افزودن یا به‌روزرسانی گزینه DNS

.PP
\fB--dns-option-rm\fP=
	حذف یک گزینه DNS

.PP
\fB--dns-rm\fP=
	حذف سرور DNS سفارشی

.PP
\fB--dns-search-add\fP=
	افزودن یا به‌روزرسانی دامنه جستجوی DNS سفارشی

.PP
\fB--dns-search-rm\fP=
	حذف یک دامنه جستجوی DNS

.PP
\fB--endpoint-mode\fP=""
	حالت نقطه پایانی (vip یا dnsrr)

.PP
\fB--entrypoint\fP=
	بازنویسی ENTRYPOINT پیش‌فرض ایمیج

.PP
\fB--env-add\fP=
	افزودن یا به‌روزرسانی یک متغیر محیطی

.PP
\fB--env-rm\fP=
	حذف یک متغیر محیطی

.PP
\fB--force\fP[=false]
	اجبار به به‌روزرسانی حتی در صورتی که هیچ تغییری لازم نباشد

.PP
\fB--generic-resource-add\fP=
	افزودن یک منبع عمومی (Generic resource)

.PP
\fB--generic-resource-rm\fP=
	حذف یک منبع عمومی (Generic resource)

.PP
\fB--group-add\fP=
	افزودن گروه کاربری تکمیلی اضافی به کانتینر

.PP
\fB--group-rm\fP=
	حذف یک گروه کاربری تکمیلی اضافه‌شده پیشین از کانتینر

.PP
\fB--health-cmd\fP=""
	دستور اجرایی برای بررسی سلامت

.PP
\fB--health-interval\fP=
	فاصله زمانی میان اجرای بررسی‌ها (ms|s|m|h)

.PP
\fB--health-retries\fP=0
	تعداد شکست‌های پیاپی لازم برای گزارش ناسالم بودن

.PP
\fB--health-start-interval\fP=
	فاصله زمانی میان اجرای بررسی‌ها در طول دوره راه‌اندازی (ms|s|m|h)

.PP
\fB--health-start-period\fP=
	دوره اولیه راه‌اندازی کانتینر پیش از احتساب تلاش‌های مجدد در ناپایداری (ms|s|m|h)

.PP
\fB--health-timeout\fP=
	حداکثر زمان مجاز برای اجرای یک بررسی (ms|s|m|h)

.PP
\fB--host-add\fP=
	افزودن یک نگاشت سفارشی میزبان به آی‌پی ("host:ip")

.PP
\fB--host-rm\fP=
	حذف یک نگاشت سفارشی میزبان به آی‌پی ("host:ip")

.PP
\fB--hostname\fP=""
	نام میزبان (hostname) کانتینر

.PP
\fB--image\fP=""
	تگ ایمیج سرویس

.PP
\fB--init\fP[=false]
	استفاده از یک init درون هر کانتینر سرویس جهت هدایت سیگنال‌ها و جمع‌آوری پردازه‌ها

.PP
\fB--isolation\fP=""
	حالت جداسازی (isolation mode) کانتینر سرویس

.PP
\fB--label-add\fP=
	افزودن یا به‌روزرسانی برچسب سرویس

.PP
\fB--label-rm\fP=
	حذف یک برچسب با کلید آن

.PP
\fB--limit-cpu\fP=
	محدود کردن پردازنده‌ها (CPUs)

.PP
\fB--limit-memory\fP=0
	محدود کردن حافظه

.PP
\fB--limit-pids\fP=0
	محدود کردن حداکثر تعداد پردازه‌ها (پیش‌فرض 0 = نامحدود)

.PP
\fB--log-driver\fP=""
	درایور ثبت وقایع (logging) برای سرویس

.PP
\fB--log-opt\fP=
	گزینه‌های درایور ثبت وقایع

.PP
\fB--max-concurrent\fP=
	تعداد وظایف کاری (job tasks) همزمان برای اجرا (پیش‌فرض برابر با --replicas)

.PP
\fB--memory-swap\fP=0
	بایت‌های حافظه swap (مقدار -1 برای نامحدود)

.PP
\fB--memory-swappiness\fP=-1
	تنظیم میزان swappiness حافظه (0-100)، -1 برای بازنشانی به مقدار پیش‌فرض

.PP
\fB--mount-add\fP=
	افزودن یا به‌روزرسانی نقطه اتصال (mount) روی یک سرویس

.PP
\fB--mount-rm\fP=
	حذف یک نقطه اتصال (mount) با مسیر مقصد آن

.PP
\fB--network-add\fP=
	افزودن یک شبکه

.PP
\fB--network-rm\fP=
	حذف یک شبکه

.PP
\fB--no-healthcheck\fP[=false]
	غیرفعال‌سازی هرگونه HEALTHCHECK تعیین‌شده توسط کانتینر

.PP
\fB--no-resolve-image\fP[=false]
	عدم ارسال درخواست به مخزن رجیستری برای حل دایجست ایمیج و پلتفرم‌های پشتیبانی‌شده

.PP
\fB--oom-score-adj\fP=0
	تنظیم ترجیحات OOM میزبان (-1000 تا 1000)

.PP
\fB--placement-pref-add\fP=
	افزودن یک ترجیح جای‌گذاری (placement preference)

.PP
\fB--placement-pref-rm\fP=
	حذف یک ترجیح جای‌گذاری

.PP
\fB--publish-add\fP=
	افزودن یا به‌روزرسانی درگاه منتشرشده (published port)

.PP
\fB--publish-rm\fP=
	حذف یک درگاه منتشرشده با پورت مقصد آن

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	پنهان‌سازی خروجی پیشرفت

.PP
\fB--read-only\fP[=false]
	اتصال سیستم‌فایل ریشه کانتینر به‌صورت فقط‌خواندنی

.PP
\fB--replicas\fP=
	تعداد وظایف (tasks)

.PP
\fB--replicas-max-per-node\fP=0
	حداکثر تعداد وظایف در هر گره (پیش‌فرض 0 = نامحدود)

.PP
\fB--reserve-cpu\fP=
	رزرو پردازنده‌ها (CPUs)

.PP
\fB--reserve-memory\fP=0
	رزرو حافظه

.PP
\fB--restart-condition\fP=""
	راه‌اندازی مجدد در صورت برقراری شرط ("none"، "on-failure"، "any")

.PP
\fB--restart-delay\fP=
	تاخیر بین تلاش‌های راه‌اندازی مجدد (ns|us|ms|s|m|h)

.PP
\fB--restart-max-attempts\fP=
	حداکثر تعداد تلاش‌های راه‌اندازی مجدد پیش از انصراف

.PP
\fB--restart-window\fP=
	بازه زمانی مورد استفاده برای ارزیابی سیاست راه‌اندازی مجدد (ns|us|ms|s|m|h)

.PP
\fB--rollback\fP[=false]
	بازگردانی (rollback) به مشخصات قبلی

.PP
\fB--rollback-delay\fP=0s
	تاخیر بین بازگردانی وظایف (ns|us|ms|s|m|h)

.PP
\fB--rollback-failure-action\fP=""
	عملکرد در صورت شکست بازگردانی ("pause"، "continue")

.PP
\fB--rollback-max-failure-ratio\fP=0
	نرخ شکست قابل‌تحمل در حین بازگردانی

.PP
\fB--rollback-monitor\fP=0s
	مدت‌زمان پس از بازگردانی هر وظیفه برای پایش شکست (ns|us|ms|s|m|h)

.PP
\fB--rollback-order\fP=""
	ترتیب بازگردانی ("start-first"، "stop-first")

.PP
\fB--rollback-parallelism\fP=0
	حداکثر تعداد وظایف بازگردانی‌شده به‌صورت همزمان (0 برای بازگردانی یک‌باره همه)

.PP
\fB--secret-add\fP=
	افزودن یا به‌روزرسانی یک داده محرمانه (secret) روی سرویس

.PP
\fB--secret-rm\fP=
	حذف یک داده محرمانه (secret)

.PP
\fB--stop-grace-period\fP=
	زمان انتظار پیش از خاتمه اجباری کانتینر (ns|us|ms|s|m|h)

.PP
\fB--stop-signal\fP=""
	سیگنال برای توقف کانتینر

.PP
\fB--sysctl-add\fP=
	افزودن یا به‌روزرسانی یک گزینه Sysctl

.PP
\fB--sysctl-rm\fP=
	حذف یک گزینه Sysctl

.PP
\fB-t\fP, \fB--tty\fP[=false]
	اختصاص یک TTY شبه‌شبیه‌ساز (pseudo-TTY)

.PP
\fB--ulimit-add\fP=[]
	افزودن یا به‌روزرسانی یک گزینه ulimit

.PP
\fB--ulimit-rm\fP=
	حذف یک گزینه ulimit

.PP
\fB--update-delay\fP=0s
	تاخیر بین به‌روزرسانی‌ها (ns|us|ms|s|m|h)

.PP
\fB--update-failure-action\fP=""
	عملکرد در صورت شکست به‌روزرسانی ("pause"، "continue"، "rollback")

.PP
\fB--update-max-failure-ratio\fP=0
	نرخ شکست قابل‌تحمل در حین به‌روزرسانی

.PP
\fB--update-monitor\fP=0s
	مدت‌زمان پس از به‌روزرسانی هر وظیفه برای پایش شکست (ns|us|ms|s|m|h)

.PP
\fB--update-order\fP=""
	ترتیب به‌روزرسانی ("start-first"، "stop-first")

.PP
\fB--update-parallelism\fP=0
	حداکثر تعداد وظایف به‌روزرسانی‌شده به‌صورت همزمان (0 برای به‌روزرسانی یک‌باره همه)

.PP
\fB-u\fP, \fB--user\fP=""
	نام کاربری یا شناسه کاربری (فرمت: [:])

.PP
\fB--with-registry-auth\fP[=false]
	ارسال جزئیات احراز هویت رجیستری به عامل‌های swarm

.PP
\fB-w\fP, \fB--workdir\fP=""
	پوشه کاری درون کانتینر


.SH "ببینید (SEE ALSO)"
\fBdocker-service(1)\fP
