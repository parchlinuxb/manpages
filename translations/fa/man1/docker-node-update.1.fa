.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-node-update \- به‌روزرسانی یک گره


.SH "خلاصه دستور (SYNOPSIS)"
\fBdocker node update [OPTIONS] NODE\fP


.SH "شرح (DESCRIPTION)"
به‌روزرسانی یک گره


.SH "گزینه‌ها (OPTIONS)"
\fB--availability\fP=""
	وضعیت دردسترس‌بودن گره ("active"، "pause"، "drain")

.PP
\fB--label-add\fP=
	افزودن یا به‌روزرسانی یک برچسب گره ("key=value")

.PP
\fB--label-rm\fP=
	حذف یک برچسب گره در صورت وجود

.PP
\fB--role\fP=""
	نقش گره ("worker"، "manager")


.SH "ببینید (SEE ALSO)"
\fBdocker-node(1)\fP
