.nh
.TH "restic backup" "1" "Jan 2017" "generated by \fBrestic generate\fR" ""

.SH "نام (NAME)"
restic-cache \- مدیریت و کار با دایرکتوری‌های حافظه موقت (کش) محلی


.SH "خلاصه دستور (SYNOPSIS)"
\fBrestic cache [flags]\fP


.SH "توضیحات (DESCRIPTION)"
دستور «cache» امکان فهرست کردن و پاک‌سازی دایرکتوری‌های حافظه موقت (کش) محلی را فراهم می‌کند.


.SH "وضعیت خروج (EXIT STATUS)"
در صورت موفقیت‌آمیز بودن دستور، وضعیت خروج ۰ است.
در صورت بروز هرگونه خطا، وضعیت خروج ۱ است.


.SH "گزینه‌ها (OPTIONS)"
\fB--cleanup\fP[=false]
	حذف دایرکتوری‌های قدیمی کش

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنمای cache

.PP
\fB--max-age\fP=30
	حداکثر عمر بر حسب \fBروز\fR برای اینکه دایرکتوری‌های کش قدیمی در نظر گرفته شوند

.PP
\fB--no-size\fP[=false]
	عدم نمایش اندازه دایرکتوری‌های کش در خروجی


.SH "گزینه‌های به ارث رسیده از دستورهای والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--cacert\fP=[]
	\fBفایل\fR برای بارگذاری گواهی‌های ریشه از آن (پیش‌فرض: استفاده از گواهی‌های سیستم یا $RESTIC_CACERT)

.PP
\fB--cache-dir\fP=""
	تنظیم \fBدایرکتوری\fR کش\&. (پیش‌فرض: استفاده از دایرکتوری کش پیش‌فرض سیستم)

.PP
\fB--cleanup-cache\fP[=false]
	حذف خودکار دایرکتوری‌های قدیمی کش

.PP
\fB--compression\fP=auto
	حالت فشرده‌سازی (تنها برای فرمت مخزن نسخه ۲ در دسترس است)، یکی از (auto|off|fastest|better|max) (پیش‌فرض: $RESTIC_COMPRESSION)

.PP
\fB--http-user-agent\fP=""
	تنظیم user agent پروتکل http برای درخواست‌های خروجی http

.PP
\fB--insecure-no-password\fP[=false]
	استفاده از گذرواژه خالی برای مخزن، باید به تمام دستورهای restic داده شود (ناامن)

.PP
\fB--insecure-tls\fP[=false]
	صرف‌نظر کردن از اعتبارسنجی گواهی TLS هنگام اتصال به مخزن (ناامن)

.PP
\fB--json\fP[=false]
	تنظیم حالت خروجی به JSON برای دستوراتی که از آن پشتیبانی می‌کنند

.PP
\fB--key-hint\fP=""
	شناسه \fBکلید\fR برای تلاش اول در رمزگشایی (پیش‌فرض: $RESTIC_KEY_HINT)

.PP
\fB--limit-download\fP=0
	محدود کردن بارگیری به حداکثر \fBنرخ\fR بر حسب KiB/s\&. (پیش‌فرض: نامحدود)

.PP
\fB--limit-upload\fP=0
	محدود کردن بارگذاری به حداکثر \fBنرخ\fR بر حسب KiB/s\&. (پیش‌فرض: نامحدود)

.PP
\fB--no-cache\fP[=false]
	عدم استفاده از کش محلی

.PP
\fB--no-extra-verify\fP[=false]
	صرف‌نظر کردن از اعتبارسنجی اضافی داده‌ها پیش از بارگذاری (مستندات را ببینید)

.PP
\fB--no-lock\fP[=false]
	قفل نکردن مخزن، این گزینه امکان انجام برخی عملیات را روی مخازن فقط‌خواندنی فراهم می‌کند

.PP
\fB-o\fP, \fB--option\fP=[]
	تنظیم گزینه پیشرفته (\fBkey=value\fR، می‌تواند چندین بار مشخص شود)

.PP
\fB--pack-size\fP=0
	تنظیم \fBاندازه\fR هدف بسته‌ها بر حسب MiB، فایل‌های بسته ایجادشده ممکن است بزرگ‌تر باشند (پیش‌فرض: $RESTIC_PACK_SIZE)

.PP
\fB--password-command\fP=""
	\fBدستور\fR شل برای دریافت گذرواژه مخزن از آن (پیش‌فرض: $RESTIC_PASSWORD_COMMAND)

.PP
\fB-p\fP, \fB--password-file\fP=""
	\fBفایل\fR برای خواندن گذرواژه مخزن از آن (پیش‌فرض: $RESTIC_PASSWORD_FILE)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	عدم نمایش گزارش جامع پیشرفت در خروجی

.PP
\fB-r\fP, \fB--repo\fP=""
	\fBمخزن\fR برای پشتیبان‌گیری در آن یا بازیابی از آن (پیش‌فرض: $RESTIC_REPOSITORY)

.PP
\fB--repository-file\fP=""
	\fBفایل\fR برای خواندن مکان مخزن از آن (پیش‌فرض: $RESTIC_REPOSITORY_FILE)

.PP
\fB--retry-lock\fP=0s
	تلاش مجدد برای قفل کردن مخزن در صورتی که پیش‌تر قفل شده است، مقداری مانند 5m یا 2h می‌پذیرد (پیش‌فرض: بدون تلاش مجدد)

.PP
\fB--stuck-request-timeout\fP=5m0s
	\fBمدت‌زمان\fR پیش از تلاش مجدد برای درخواست‌های متوقف‌شده

.PP
\fB--tls-client-cert\fP=""
	مسیر یک \fBفایل\fR حاوی گواهی کلاینت TLS و کلید خصوصی با کدگذاری PEM (پیش‌فرض: $RESTIC_TLS_CLIENT_CERT)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	خروجی با جزئیات بیشتر (می‌تواند چندین بار مشخص شود یا سطح آن با استفاده از verbose=n-- تعیین گردد، حداکثر سطح/دفعات ۲ است)


.SH "همچنین ببینید (SEE ALSO)"
\fBrestic(1)\fP