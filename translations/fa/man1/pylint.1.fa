.SS non\-parent\-init\-called / W0233
.sp
\fBMessage emitted:\fP
.sp
\fB__init__ method from a non direct base class %r is called\fP
.sp
\fBDescription:\fP
.sp
\fIUsed when an __init__ method is called on a class which is not in the direct ancestors for the analysed class.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
class Animal:
    def __init__(self):
        self.is_multicellular = True


class Vertebrate(Animal):
    def __init__(self):
        super().__init__()
        self.has_vertebrae = True


class Cat(Vertebrate):
    def __init__(self):
        Animal.__init__(self)  # [non\-parent\-init\-called]
        self.is_adorable = True

.EE
