.UNINDENT
.INDENT 0.0
.TP
.B type uv_timeval_t
نوع داده ناامن در برابر مسئله سال ۲۰۳۸ (Y2K38\-unsafe) برای ذخیره زمان با دقت میکروثانیه.
در نسخه libuv v2.0 با \fBuv_timeval64_t\fP جایگزین خواهد شد.
.INDENT 7.0
.INDENT 3.5
.sp
.EX
typedef struct {
    long tv_sec;
    long tv_usec;
} uv_timeval_t;
.EE
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B type uv_timeval64_t
نوع داده امن در برابر مسئله سال ۲۰۳۸ (Y2K38\-safe) برای ذخیره زمان با دقت میکروثانیه.
.INDENT 7.0
.INDENT 3.5
.sp
.EX
typedef struct {
    int64_t tv_sec;
    int32_t tv_usec;
} uv_timeval64_t;
.EE
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B type uv_timespec64_t
نوع داده امن در برابر مسئله سال ۲۰۳۸ (Y2K38\-safe) برای ذخیره زمان با دقت نانوثانیه.
.INDENT 7.0
.INDENT 3.5
.sp
.EX
typedef struct {
    int64_t tv_sec;
    int32_t tv_nsec;
} uv_timespec64_t;
.EE
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B enum uv_clock_id
منبع ساعت برای \fBuv_clock_gettime()\fP\&.
.INDENT 7.0
.INDENT 3.5
.sp
.EX
typedef enum {
  UV_CLOCK_MONOTONIC,
  UV_CLOCK_REALTIME
} uv_clock_id;
.EE
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B type uv_rusage_t
نوع داده برای نتایج مصرف منابع (Resource usage).
.INDENT 7.0
.INDENT 3.5
.sp
.EX
typedef struct {
    uv_timeval_t ru_utime; /* user CPU time used */
    uv_timeval_t ru_stime; /* system CPU time used */
    uint64_t ru_maxrss; /* maximum resident set size */
    uint64_t ru_ixrss; /* integral shared memory size (X) */
    uint64_t ru_idrss; /* integral unshared data size (X) */
    uint64_t ru_isrss; /* integral unshared stack size (X) */
    uint64_t ru_minflt; /* page reclaims (soft page faults) (X) */
    uint64_t ru_majflt; /* page faults (hard page faults) */
    uint64_t ru_nswap; /* swaps (X) */
    uint64_t ru_inblock; /* block input operations */
    uint64_t ru_oublock; /* block output operations */
    uint64_t ru_msgsnd; /* IPC messages sent (X) */
    uint64_t ru_msgrcv; /* IPC messages received (X) */
    uint64_t ru_nsignals; /* signals received (X) */
    uint64_t ru_nvcsw; /* voluntary context switches (X) */
    uint64_t ru_nivcsw; /* involuntary context switches (X) */
} uv_rusage_t;
.EE
.UNINDENT
.UNINDENT
.sp
اعضای علامت‌گذاری شده با \fI(X)\fP در ویندوز پشتیبانی نمی‌شوند.
برای فیلدهای پشتیبانی‌شده در بسترهای شبه‌یونیکس به getrusage(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:getrusage\:.2\:.html> مراجعه کنید.
.sp
حداکثر اندازه مقیم در حافظه (RSS) بر حسب کیلوبایت گزارش می‌شود که واحد بومی اکثر پلتفرم‌ها است.
.UNINDENT
.INDENT 0.0
.TP
.B type uv_cpu_info_t
نوع داده برای اطلاعات پردازنده (CPU).
.INDENT 7.0
.INDENT 3.5
.sp
.EX
typedef struct uv_cpu_info_s {
    char* model;
    int speed;
    struct uv_cpu_times_s {
        uint64_t user; /* milliseconds */
        uint64_t nice; /* milliseconds */
        uint64_t sys; /* milliseconds */
        uint64_t idle; /* milliseconds */
        uint64_t irq; /* milliseconds */
    } cpu_times;
} uv_cpu_info_t;
.EE
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B type uv_interface_address_t
نوع داده برای آدرس‌های رابط شبکه.
.INDENT 7.0
.INDENT 3.5
.sp
.EX
typedef struct uv_interface_address_s {
    char* name;
    char phys_addr[6];
    int is_internal;
    union {
        struct sockaddr_in address4;
        struct sockaddr_in6 address6;
    } address;
    union {
        struct sockaddr_in netmask4;
        struct sockaddr_in6 netmask6;
    } netmask;
} uv_interface_address_t;
.EE
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B type uv_passwd_t
نوع داده برای اطلاعات فایل گذرواژه (Passwd).
.INDENT 7.0
.INDENT 3.5
.sp
.EX
typedef struct uv_passwd_s {
    char* username;
    long uid;
    long gid;
    char* shell;
    char* homedir;
} uv_passwd_t;
.EE
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
