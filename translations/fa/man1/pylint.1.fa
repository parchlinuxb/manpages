    __match_args__ = (\(dqtitle\(dq, \(dqyear\(dq)

    def __init__(self, title, year, author):
        self.title = title
        self.year = year
        self.author = author


def func(item: Book):
    match item:
        case Book(\(dqtitle\(dq, 2000, \(dqauthor\(dq):  # [too\-many\-positional\-sub\-patterns]
            ...

