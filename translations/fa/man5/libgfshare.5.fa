.\" This is the man page for libgfshare
.TH LIBGFSHARE "5" "June 2015" "2.0.0" "Shamir Secret Sharing in gf(2**8)"
.SH "نام (NAME)"
libgfshare \- قالب پرونده اشتراک‌گذاری راز گالوا فیلد
.SH "خلاصه دستور (SYNOPSIS)"
.nf
.B #include <libgfshare.h>
.sp
.BI "gfshare_rand_func_t gfshare_fill_rand;"
.sp
.BI "gfshare_rand_func_t gfshare_bad_idea_but_fill_rand_using_random;"
.sp
.BI "gfshare_ctx *gfshare_ctx_init_enc( unsigned char *" sharenrs ,
.br
.BI "                                   unsigned int   " sharecount ,
.br
.BI "                                   unsigned char  " threshold ,
.br
.BI "                                   unsigned int   " size " );"
.sp
.BI "gfshare_ctx *gfshare_ctx_init_dec( unsigned char *" sharenrs ,
.br
.BI "                                   unsigned int   " sharecount ,
.br
.BI "                                   unsigned int   " size " );"
.sp
.BI "void gfshare_ctx_free( gfshare_ctx *" ctx " );"
.sp
.BI "void gfshare_ctx_enc_setsecret( gfshare_ctx   *" ctx ,
.br
.BI "                                unsigned char *" secret " );"
.sp
.BI "void gfshare_ctx_enc_getshare( gfshare_ctx   *" ctx ,
.br
.BI "                               unsigned char  " sharenr ,
.br
.BI "                               unsigned char *" share " );"
.sp
.BI "void gfshare_ctx_dec_newshares( gfshare_ctx   *" ctx ,
.br
.BI "                                unsigned char *" sharenrs " );"
.sp
.BI "void gfshare_ctx_dec_giveshare( gfshare_ctx   *" ctx ,
.br
.BI "                                unsigned char  " sharenr ,
.br
.BI "                                unsigned char *" share " );"
.sp
.BI "void gfshare_ctx_dec_extract( gfshare_ctx   *" ctx ,
.br
.BI "                              unsigned char *" secretbuf " );"
.fi
.SH "توضیحات (DESCRIPTION)"
متغیر
.BR gfshare_fill_rand
باید حاوی اشاره‌گری به تابعی باشد که یک
.BR unsigned
.BR char
.BR *
و یک
.BR unsigned
.BR int
می‌گیرد و بافر داده‌شده را با تعداد بایت‌های تصادفی مشخص پر می‌کند، پیش از آنکه هر یک از توابعی که زمینه‌ها را می‌سازند یا مقداردهی می‌کنند فراخوانی شوند.
.br
اگر نمی‌توانید این کار را با یک سازوکار امن از نظر رمزنگاری انجام دهید، کتابخانه مقدار
.BR gfshare_bad_idea_but_fill_rand_using_random
را فراهم می‌کند که می‌توانید آن را درون
.BR gfshare_fill_rand
قرار دهید و از تابع کتابخانه استاندارد C یعنی
.BR random ()
برای پر کردن بافر استفاده خواهد کرد. با این حال، باید اطمینان حاصل کنید که دست‌کم یک بار پیش از استفاده از هر یک از توابع دیگر،
.BR srandom ()
را فراخوانی کرده‌اید.
.PP
تابع
.BR gfshare_ctx_init_enc ()
یک شیء زمینه (context) برمی‌گرداند که می‌تواند برای کدگذاری سهم‌های یک راز استفاده شود. زمینه بر اساس
.IR sharecount
سهم که در آرایه
.IR sharenrs
شماره‌گذاری شده‌اند کدگذاری می‌کند. راز همیشه طولی به اندازه
.IR size
بایت دارد و سهم‌های حاصل برای بازترکیب دست‌کم به حضور
.IR threshold
سهم نیاز خواهند داشت. بسیار حیاتی است که
.IR threshold
دست‌کم یک واحد کمتر از
.IR sharecount
باشد.
.PP
تابع
.BR gfshare_ctx_init_dec ()
یک شیء زمینه برمی‌گرداند که می‌تواند برای بازترکیب سهم‌ها جهت بازیابی یک راز استفاده شود. هر سهم و راز حاصل طولی برابر با
.IR size
بایت خواهند داشت. از این زمینه می‌توان برای بازترکیب
.IR sharecount
سهم که در آرایه
.IR sharenrs
شماره‌گذاری شده‌اند استفاده کرد.
.PP
تابع
.BR gfshare_ctx_free ()
تمام حافظه مرتبط با یک زمینه gfshare، از جمله حافظه متعلق به خود شیء زمینه را آزاد می‌کند.
.PP
تابع
.BR gfshare_ctx_enc_setsecret ()
رازی را که می‌خواهید کدگذاری کنید در اختیار زمینه قرار می‌دهد.
.IR secret
در بافر داخلی کتابخانه کپی خواهد شد.
.PP
تابع
.BR gfshare_ctx_enc_getshare ()
یک سهم مشخص را از زمینه استخراج می‌کند. بافر
.IR share
باید از پیش به اندازه سهم‌ها تخصیص یافته باشد و پارامتر
.IR sharenr
یک اندیس درون آرایه
.IR sharenrs
است که برای مقداردهی اولیه زمینه استفاده شده است.
.PP
تابع
.BR gfshare_ctx_dec_newshares ()
زمینه رمزگشایی را از تغییر در شماره سهم‌های در دسترس زمینه آگاه می‌کند. تعداد سهم‌ها قابل تغییر نیست، اما
.IR sharenrs
می‌تواند صفر باشد تا نشان دهد یک سهم خاص در حال حاضر ناموجود است.
.PP
تابع
.BR gfshare_ctx_dec_giveshare ()
یک سهم داده‌شده را به زمینه رمزگشایی تحویل می‌دهد. شماره سهم پیش‌تر درون آرایه
.IR sharenrs
ارائه شده بود و پارامتر
.IR sharenr
اندیسی به آن آرایه برای شماره سهمی است که در بلوک حافظه
.IR share
داده شده است.
.PP
تابع
.BR gfshare_ctx_dec_extract ()
سهم‌های ارائه‌شده را برای محاسبه مجدد راز ترکیب می‌کند. توصیه می‌شود پیش از فراخوانی این تابع،
.IR secretbuf
را با
.BR mlock ()
قفل کنید تا راز بازترکیب‌شده هرگز در swap نوشته نشود. این کار به جلوگیری از کشف محتوای راز شما توسط افراد بدخواه کمک می‌کند. همچنین باید پس از اتمام استفاده از راز بازترکیب‌شده، محتوای بافر را تصادفی‌سازی کنید.
.SH "خطاها (ERRORS)"
هر تابعی که به هر دلیلی با شکست مواجه شود، در صورت بروز خطا NULL برمی‌گرداند.
.SH "نویسنده (AUTHOR)"
نوشته‌شده توسط Daniel Silverstone.
.SH "گزارش باگ‌ها (REPORTING BUGS)"
