.nh
.TH "UPTERM" "1" "May 2026" "Upterm 0.0.0+dev" "Upterm Manual"

.SH "نام (NAME)"
upterm-config-path \- Show the path to the config file


.SH "خلاصه دستور (SYNOPSIS)"
\fBupterm config path [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Show the path to the config file.

.PP
Config file: /build/.config/upterm/config.yaml

.PP
The config file is optional and created manually by users.


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	help for path


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	enable debug level logging (log file: /build/.upterm/upterm.log).


.SH "مثال (EXAMPLE)"
.EX
  # Show config file path:
  upterm config path

  # Create config file directory:
  mkdir -p "$(dirname "$(upterm config path)")"
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBupterm-config(1)\fP


