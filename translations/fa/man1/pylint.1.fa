.SS singledispatch\-method / E1519
.sp
\fBMessage emitted:\fP
.sp
\fBsingledispatch decorator should not be used with methods, use singledispatchmethod instead.\fP
.sp
\fBDescription:\fP
.sp
\fIsingledispatch should decorate functions and not class/instance methods. Use singledispatchmethod for those cases.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
from functools import singledispatch


class Board:
    @singledispatch  # [singledispatch\-method]
    def convert_position(self, position):
        pass

    @convert_position.register  # [singledispatch\-method]
    def _(self, position: str) \-> tuple:
        position_a, position_b = position.split(\(dq,\(dq)
        return (int(position_a), int(position_b))

    @convert_position.register  # [singledispatch\-method]
    def _(self, position: tuple) \-> str:
        return f\(dq{position[0]},{position[1]}\(dq

.EE
