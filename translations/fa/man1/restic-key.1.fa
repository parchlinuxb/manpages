.nh
.TH "restic backup" "1" "Jan 2017" "generated by \fBrestic generate\fR" ""

.SH "نام (NAME)"
restic-key \- مدیریت کلیدها (گذرواژه‌ها)


.SH "خلاصه دستور (SYNOPSIS)"
\fBrestic key [flags]\fP


.SH "توضیحات (DESCRIPTION)"
دستور «key» امکان تنظیم چندین کلید دسترسی یا گذرواژه را به ازای هر مخزن فراهم می‌کند.


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	راهنمای دستور key


.SH "گزینه‌های به ارث‌رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--cacert\fP=[]
	\fBفایل\fR برای بارگذاری گواهی‌های ریشه از آن (پیش‌فرض: استفاده از گواهی‌های سیستم یا $RESTIC_CACERT)

.PP
\fB--cache-dir\fP=""
	تنظیم \fBدایرکتوری\fR کَش\&. (پیش‌فرض: استفاده از دایرکتوری پیش‌فرض کَش سیستم)

.PP
\fB--cleanup-cache\fP[=false]
	حذف خودکار دایرکتوری‌های قدیمی کَش

.PP
\fB--compression\fP=auto
	حالت فشرده‌سازی (تنها برای نسخه ۲ قالب مخزن در دسترس است)، یکی از حالت‌های (auto|off|fastest|better|max) (پیش‌فرض: $RESTIC_COMPRESSION)

.PP
\fB--http-user-agent\fP=""
	تنظیم یک عامل کاربر http (user agent) برای درخواست‌های خروجی http

.PP
\fB--insecure-no-password\fP[=false]
	استفاده از گذرواژه خالی برای مخزن، باید به هر دستور restic ارسال شود (ناامن)

.PP
\fB--insecure-tls\fP[=false]
	صرف‌نظر از بررسی اعتبار گواهی TLS هنگام اتصال به مخزن (ناامن)

.PP
\fB--json\fP[=false]
	تنظیم حالت خروجی به JSON برای دستورهایی که از آن پشتیبانی می‌کنند

.PP
\fB--key-hint\fP=""
	شناسه \fBکلید\fR برای نخستین تلاش جهت رمزگشایی (پیش‌فرض: $RESTIC_KEY_HINT)

.PP
\fB--limit-download\fP=0
	محدود کردن دانلود به یک حداکثر \fBنرخ\fR بر حسب KiB/s\&. (پیش‌فرض: نامحدود)

.PP
\fB--limit-upload\fP=0
	محدود کردن آپلود به یک حداکثر \fBنرخ\fR بر حسب KiB/s\&. (پیش‌فرض: نامحدود)

.PP
\fB--no-cache\fP[=false]
	عدم استفاده از کَش محلی

.PP
\fB--no-extra-verify\fP[=false]
	صرف‌نظر از اعتبارسنجی اضافی داده‌ها پیش از بارگذاری (مستندات را ببینید)

.PP
\fB--no-lock\fP[=false]
	قفل نکردن مخزن، این گزینه اجازه انجام برخی عملیات‌ها روی مخازن فقط‌خواندنی را می‌دهد

.PP
\fB-o\fP, \fB--option\fP=[]
	تنظیم گزینه توسعه‌یافته (\fBkey=value\fR، می‌تواند چندین بار مشخص شود)

.PP
\fB--pack-size\fP=0
	تنظیم \fBاندازه\fR بسته هدف بر حسب MiB، ممکن است فایل‌های بسته ایجادشده بزرگ‌تر باشند (پیش‌فرض: $RESTIC_PACK_SIZE)

.PP
\fB--password-command\fP=""
	\fBدستور\fR شل برای دریافت گذرواژه مخزن از آن (پیش‌فرض: $RESTIC_PASSWORD_COMMAND)

.PP
\fB-p\fP, \fB--password-file\fP=""
	\fBفایل\fR برای خواندن گذرواژه مخزن از آن (پیش‌فرض: $RESTIC_PASSWORD_FILE)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	عدم نمایش گزارش جامع پیشرفت در خروجی

.PP
\fB-r\fP, \fB--repo\fP=""
	\fBمخزن\fR برای پشتیبان‌گیری در آن یا بازیابی از آن (پیش‌فرض: $RESTIC_REPOSITORY)

.PP
\fB--repository-file\fP=""
	\fBفایل\fR برای خواندن مکان مخزن از آن (پیش‌فرض: $RESTIC_REPOSITORY_FILE)

.PP
\fB--retry-lock\fP=0s
	تلاش مجدد برای قفل کردن مخزن در صورت قفل بودن آن، مقداری مانند 5m یا 2h می‌پذیرد (پیش‌فرض: بدون تلاش مجدد)

.PP
\fB--stuck-request-timeout\fP=5m0s
	\fBمدت‌زمانی\fR که پس از آن برای درخواست‌های گیرکرده تلاش مجدد انجام می‌شود

.PP
\fB--tls-client-cert\fP=""
	مسیر یک \fBفایل\fR حاوی گواهی کلاینت TLS و کلید خصوصی با کدگذاری PEM (پیش‌فرض: $RESTIC_TLS_CLIENT_CERT)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	حالت پرگو (چندین بار مشخص شود یا یک سطح با استفاده از --verbose=n تعیین شود، حداکثر سطح/دفعات ۲ است)


.SH "همچنین ببینید (SEE ALSO)"
\fBrestic(1)\fP, \fBrestic-key-add(1)\fP, \fBrestic-key-list(1)\fP, \fBrestic-key-passwd(1)\fP, \fBrestic-key-remove(1)\fP