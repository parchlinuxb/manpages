.ps +1
\fBکلیدهای میانبر حالت ویرایش خط (Line Editing Mode Key Bindings)\fR
.RS 4
.PP
از
\fBline_mode\fR
برای
\fIcontext\fR
جهت تعریف کلیدهای میانبر حالت ویرایش خط استفاده کنید\&. مقادیر زیر برای
\fIaction\fR
معتبر هستند:
.PP
\fBenter_align_mode\fR
.RS 4
ورود به حالت ویرایش تراز
.sp
Default:
space
.RE
.PP
\fBenter_character_mode\fR
.RS 4
ورود به حالت ویرایش نویسه
.sp
Defaults:
Return,
KP_Enter
.RE
.PP
\fBfirst_line\fR
.RS 4
انتقال مکان‌نما به خط اول
.sp
Defaults:
Home,
g
.RE
.PP
\fBextend_first_line\fR
.RS 4
انتقال مکان‌نما به خط اول، همراه با گسترش انتخاب
.sp
Default:
Shift+Home
.RE
.PP
\fBlast_line\fR
.RS 4
انتقال مکان‌نما به خط آخر
.sp
Defaults:
End,
Shift+G
.RE
.PP
\fBextend_last_line\fR
.RS 4
انتقال مکان‌نما به خط آخر، همراه با گسترش انتخاب
.sp
Default:
Shift+End
.RE
.PP
\fBup\fR
.RS 4
انتقال مکان‌نما یک خط به بالا
.sp
Defaults:
Up,
k
.RE
.PP
\fBextend_up\fR
.RS 4
انتقال مکان‌نما یک خط به بالا، همراه با گسترش انتخاب
.sp
Defaults:
Shift+Up,
Shift+K
.RE
.PP
\fBdown\fR
.RS 4
انتقال مکان‌نما یک خط به پایین
.sp
Defaults:
Down,
j
.RE
.PP
\fBextend_down\fR
.RS 4
انتقال مکان‌نما یک خط به پایین، همراه با گسترش انتخاب
.sp
Defaults:
