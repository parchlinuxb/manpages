.TH "GIT-BUG" "1" "Apr 2019" "Generated from git-bug's source code" ""

.SH "نام (NAME)"
git-bug-bug-new \- ایجاد یک باگ جدید


.SH "خلاصه دستور (SYNOPSIS)"
\fBgit-bug bug new [flags]\fP


.SH "توضیحات (DESCRIPTION)"
ایجاد یک باگ جدید


.SH "گزینه‌ها (OPTIONS)"
\fB-t\fP, \fB--title\fP=""
	ارائه عنوان برای توصیف مسئله

.PP
\fB-m\fP, \fB--message\fP=""
	ارائه پیام برای توصیف مسئله

.PP
\fB-F\fP, \fB--file\fP=""
	دریافت پیام از فایل مشخص‌شده. برای خواندن پیام از ورودی استاندارد از \- استفاده کنید

.PP
\fB--non-interactive\fP[=false]
	عدم درخواست ورودی از کاربر

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای new


.SH "همچنین ببینید (SEE ALSO)"
\fBgit-bug-bug(1)\fP
