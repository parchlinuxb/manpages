.SH "نام (NAME)"
buf-registry-module-settings-update \- Update BSR module settings


.SH "خلاصه دستور (SYNOPSIS)"
\fBbuf registry module settings update  [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Update BSR module settings


.SH "گزینه‌ها (OPTIONS)"
\fB--default-label-name\fP=""
	The label that commits are pushed to by default

.PP
\fB--description\fP=""
	The new description for the module

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--url\fP=""
	The new URL for the module

.PP
\fB--visibility\fP=""
	The module's visibility setting. Must be one of [public,private]


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Turn on debug logging

.PP
\fB--log-format\fP="color"
	The log format [text,color,json]

.PP
\fB--timeout\fP=0s
	The duration until timing out, setting it to 0 means no timeout


