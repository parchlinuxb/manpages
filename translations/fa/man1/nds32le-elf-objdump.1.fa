.IX Title "OBJDUMP 1"
.TH OBJDUMP 1 2026-01-23 binutils-2.45.1 "GNU Development Tools"
.\" For nroff, turn off justification.  Always turn off hyphenation; it makes
.\" way too many mistakes in technical documents.
.if n .ad l
.nh
.SH "نام (NAME)"
nds32le-elf-objdump \- نمایش اطلاعات و دیکامپایل فایل‌های باینری معماری Andes NDS32
.SH "خلاصه دستور (SYNOPSIS)"
.IX Header "SYNOPSIS"
objdump [\fB\-a\fR|\fB\-\-archive\-headers\fR]
        [\fB\-b\fR \fIbfdname\fR|\fB\-\-target=\fR\fIbfdname\fR]
        [\fB\-C\fR|\fB\-\-demangle\fR[=\fIstyle\fR] ]
        [\fB\-d\fR|\fB\-\-disassemble\fR[=\fIsymbol\fR]]
        [\fB\-D\fR|\fB\-\-disassemble\-all\fR]
        [\fB\-z\fR|\fB\-\-disassemble\-zeroes\fR]
        [\fB\-EB\fR|\fB\-EL\fR|\fB\-\-endian=\fR{big | little }]
        [\fB\-f\fR|\fB\-\-file\-headers\fR]
        [\fB\-F\fR|\fB\-\-file\-offsets\fR]
        [\fB\-\-file\-start\-context\fR]
        [\fB\-g\fR|\fB\-\-debugging\fR]
        [\fB\-e\fR|\fB\-\-debugging\-tags\fR]
        [\fB\-h\fR|\fB\-\-section\-headers\fR|\fB\-\-headers\fR]
        [\fB\-i\fR|\fB\-\-info\fR]
        [\fB\-j\fR \fIsection\fR|\fB\-\-section=\fR\fIsection\fR]
        [\fB\-l\fR|\fB\-\-line\-numbers\fR]
        [\fB\-S\fR|\fB\-\-source\fR]
        [\fB\-\-source\-comment\fR[=\fItext\fR]]
        [\fB\-m\fR \fImachine\fR|\fB\-\-architecture=\fR\fImachine\fR]
        [\fB\-M\fR \fIoptions\fR|\fB\-\-disassembler\-options=\fR\fIoptions\fR]
        [\fB\-p\fR|\fB\-\-private\-headers\fR]
        [\fB\-P\fR \fIoptions\fR|\fB\-\-private=\fR\fIoptions\fR]
        [\fB\-r\fR|\fB\-\-reloc\fR]
        [\fB\-R\fR|\fB\-\-dynamic\-reloc\fR]
        [\fB\-s\fR|\fB\-\-full\-contents\fR]
        [\fB\-Z\fR|\fB\-\-decompress\fR]
        [\fB\-W[lLiaprmfFsoORtUuTgAck]\fR|
         \fB\-\-dwarf\fR[=rawline,=decodedline,=info,=abbrev,=pubnames,=aranges,=macro,=frames,=frames\-interp,=str,=str\-offsets,=loc,=Ranges,=pubtypes,=trace_info,=trace_abbrev,=trace_aranges,=gdb_index,=addr,=cu_index,=links]]
        [\fB\-WK\fR|\fB\-\-dwarf=follow\-links\fR]
        [\fB\-WN\fR|\fB\-\-dwarf=no\-follow\-links\fR]
        [\fB\-wD\fR|\fB\-\-dwarf=use\-debuginfod\fR]
        [\fB\-wE\fR|\fB\-\-dwarf=do\-not\-use\-debuginfod\fR]
        [\fB\-L\fR|\fB\-\-process\-links\fR]
        [\fB\-\-ctf=\fR\fIsection\fR]
        [\fB\-\-sframe=\fR\fIsection\fR]
        [\fB\-G\fR|\fB\-\-stabs\fR]
        [\fB\-t\fR|\fB\-\-syms\fR]
        [\fB\-T\fR|\fB\-\-dynamic\-syms\fR]
        [\fB\-x\fR|\fB\-\-all\-headers\fR]
        [\fB\-w\fR|\fB\-\-wide\fR]
        [\fB\-\-start\-address=\fR\fIaddress\fR]
        [\fB\-\-stop\-address=\fR\fIaddress\fR]
        [\fB\-\-no\-addresses\fR]
        [\fB\-\-prefix\-addresses\fR]
        [\fB\-\-[no\-]show\-raw\-insn\fR]
        [\fB\-\-adjust\-vma=\fR\fIoffset\fR]
        [\fB\-\-show\-all\-symbols\fR]
        [\fB\-\-dwarf\-depth=\fR\fIn\fR]
        [\fB\-\-dwarf\-start=\fR\fIn\fR]
        [\fB\-\-ctf\-parent=\fR\fIsection\fR]
        [\fB\-\-no\-recurse\-limit\fR|\fB\-\-recurse\-limit\fR]
        [\fB\-\-special\-syms\fR]
        [\fB\-\-prefix=\fR\fIprefix\fR]
        [\fB\-\-prefix\-strip=\fR\fIlevel\fR]
        [\fB\-\-insn\-width=\fR\fIwidth\fR]
        [\fB\-\-visualize\-jumps[=color|=extended\-color|=off]\fR
        [\fB\-\-disassembler\-color=[off|terminal|on|extended]\fR
        [\fB\-U\fR \fImethod\fR] [\fB\-\-unicode=\fR\fImethod\fR]
        [\fB\-V\fR|\fB\-\-version\fR]
        [\fB\-H\fR|\fB\-\-help\fR]
        \fIobjfile\fR...
.SH "توضیحات (DESCRIPTION)"
.IX Header "DESCRIPTION"
دستور
\&\fBobjdump\fR
اطلاعات مربوط به یک یا چند فایل شیء (object file) را نمایش می‌دهد.
گزینه‌ها مشخص می‌کنند چه نوع اطلاعاتی نمایش داده شود. این اطلاعات عمدتاً برای برنامه‌نویسانی که روی ابزارهای کامپایل و توسعه کار می‌کنند کاربردی است، بر خلاف برنامه‌نویسانی که صرفاً می‌خواهند برنامه‌شان کامپایل شده و به درستی اجرا شود.
.PP
شناسه‌های
\&\fIobjfile\fR...
فایل‌های شیء مورد بررسی هستند. هنگامی که یک فایل آرشیو مشخص شود،
\&\fBobjdump\fR
اطلاعات هر یک از فایل‌های شیء عضو آن آرشیو را نمایش می‌دهد.
.SH "گزینه‌ها (OPTIONS)"
.IX Header "OPTIONS"
فرم‌های کوتاه و بلند گزینه‌ها که در اینجا به عنوان جایگزین نشان داده شده‌اند، معادل یکدیگرند. حداقل باید یکی از گزینه‌های فهرست
\&\fB\-a,\-d,\-D,\-e,\-f,\-g,\-G,\-h,\-H,\-p,\-P,\-r,\-R,\-s,\-S,\-t,\-T,\-V,\-x\fR
مشخص شود.
.IP \fB\-a\fR 4
.IX Item "-a"
.PD 0
.IP \fB\-\-archive\-header\fR 4
.IX Item "--archive-header"
.PD
اگر هر یک از فایل‌های
\&\fIobjfile\fR
از نوع آرشیو باشند، اطلاعات هدر آرشیو را (در قالبی مشابه
\&\fBls \-l\fR)
نمایش می‌دهد. علاوه بر اطلاعاتی که با
\&\fBar tv\fR
قابل مشاهده است، گزینه
\&\fBobjdump \-a\fR
فرمت فایل شیء هر یک از اعضای آرشیو را نیز نشان می‌دهد.
.IP \fB\-\-adjust\-vma=\fR\fIoffset\fR 4
.IX Item "--adjust-vma=offset"
هنگام نمایش اطلاعات، ابتدا مقدار
\&\fIoffset\fR
را به تمام آدرس‌های بخش‌ها اضافه می‌کند. این گزینه زمانی کاربرد دارد که آدرس بخش‌ها با جدول نمادها همخوانی ندارد؛ وضعیتی که ممکن است هنگام قرار دادن بخش‌ها در آدرس‌های خاص در فرمت‌هایی که امکان نمایش آدرس بخش‌ها را ندارند (مانند a.out) رخ دهد.
.IP "\fB\-b\fR \fIbfdname\fR" 4
.IX Item "-b bfdname"
.PD 0
.IP \fB\-\-target=\fR\fIbfdname\fR 4
.IX Item "--target=bfdname"
.PD
فرمت کد شیء را برای فایل‌های ورودی برابر با
\&\fIbfdname\fR
قرار می‌دهد. این گزینه معمولاً ضروری نیست زیرا
\&\fIobjdump\fR
می‌تواند بسیاری از فرمت‌ها را به صورت خودکار تشخیص دهد.
.Sp
به عنوان مثال:
.Sp
.Vb 1
\&        objdump \-b oasys \-m vax \-h fu.o
.Ve
.Sp
اطلاعات خلاصه هدرهای بخش‌ها (\fB\-h\fR) را از فایل
\&\fIfu.o\fR
نمایش می‌دهد، که به صراحت با (\fB\-m\fR) به عنوان فایل شیء VAX در فرمت تولید شده توسط کامپایلرهای Oasys مشخص شده است. فرمت‌های در دسترس با گزینه
\&\fB\-i\fR
قابل مشاهده هستند.
.IP \fB\-C\fR 4
.IX Item "-C"
.PD 0
.IP \fB\-\-demangle[=\fR\fIstyle\fR\fB]\fR 4
.IX Item "--demangle[=style]"
.PD
رمزگشایی (\fIdemangle\fR) نام‌های سطح پایین نمادها به نام‌های خوانای سطح کاربر. علاوه بر حذف زیرخط ابتدایی اضافه شده توسط سیستم، نام توابع ++C را خوانا می‌کند. کامپایلرهای مختلف شیوه‌های نام‌گذاری متفاوتی دارند. آرگومان اختیاری سبک نام‌گشایی برای انتخاب شیوه مناسب کامپایلر شما قابل استفاده است.
.IP \fB\-\-recurse\-limit\fR 4
.IX Item "--recurse-limit"
.PD 0
.IP \fB\-\-no\-recurse\-limit\fR 4
.IX Item "--no-recurse-limit"
.IP \fB\-\-recursion\-limit\fR 4
.IX Item "--recursion-limit"
.IP \fB\-\-no\-recursion\-limit\fR 4
.IX Item "--no-recursion-limit"
.PD
محدودیت عمق بازگشت در طول نام‌گشایی (demangling) رشته‌ها را فعال یا غیرفعال می‌کند. از آنجا که فرمت‌های دستکاری نام اجازه بازگشت نامحدود را می‌دهند، ممکن است رشته‌هایی ایجاد شوند که رمزگشایی آنها تمام فضای پشته سیستم میزبان را مصرف کرده و باعث خطای حافظه (memory fault) شود. این محدودیت با محدود کردن بازگشت به ۲۰۴۸ سطح تودرتو مانع این اتفاق می‌شود.
.Sp
این محدودیت به صورت پیش‌فرض فعال است، اما غیرفعال کردن آن ممکن است برای نام‌گشایی نام‌های بسیار پیچیده لازم باشد. توجه داشته باشید در صورت غیرفعال کردن محدودیت، احتمال سرریز پشته وجود داشته و گزارش باگ‌های مربوط به چنین رویدادی پذیرفته نخواهد شد.
.IP \fB\-g\fR 4
.IX Item "-g"
.PD 0
.IP \fB\-\-debugging\fR 4
.IX Item "--debugging"
.PD
نمایش اطلاعات دیباگ. این گزینه تلاش می‌کند اطلاعات فرمت دیباگ STABS ذخیره‌شده در فایل را تجزیه کرده و با نحو شبیه زبان C چاپ کند. اگر اطلاعات STABS پیدا نشود، به گزینه
\&\fB\-W\fR
برای چاپ اطلاعات DWARF فایل رجوع می‌کند.
.IP \fB\-e\fR 4
.IX Item "-e"
.PD 0
.IP \fB\-\-debugging\-tags\fR 4
.IX Item "--debugging-tags"
.PD
مشابه
\&\fB\-g\fR،
اما اطلاعات در قالبی سازگار با ابزار ctags تولید می‌شود.
.IP \fB\-d\fR 4
.IX Item "-d"
.PD 0
.IP \fB\-\-disassemble\fR 4
.IX Item "--disassemble"
.IP \fB\-\-disassemble=\fR\fIsymbol\fR 4
.IX Item "--disassemble=symbol"
.PD
نمایش نمادهای اسمبلی (mnemonics) برای دستورالعمل‌های ماشین از فایل ورودی. این گزینه فقط بخش‌هایی را دیکامپایل می‌کند که انتظار می‌رود شامل دستورالعمل باشند. اگر آرگومان اختیاری
\&\fIsymbol\fR
مشخص شود (حتی چندین بار)، دیکامپایل از نماد(های) مشخص‌شده آغاز می‌شود. اگر
\&\fIsymbol\fR
نام یک تابع باشد، دیکامپایل در انتهای تابع متوقف می‌شود، در غیر این صورت با رسیدن به نماد بعدی خاتمه می‌یابد. اگر هیچ تطابقی با نماد یافت نشود، چیزی نمایش داده نمی‌شود.
.Sp
توجه داشته باشید که اگر گزینه
\&\fB\-\-dwarf=follow\-links\fR
فعال باشد، تمام جدول‌های نماد در فایل‌های اطلاعات دیباگ پیوند داده‌شده خوانده شده و هنگام دیکامپایل استفاده می‌شوند.
.IP \fB\-D\fR 4
.IX Item "-D"
.PD 0
.IP \fB\-\-disassemble\-all\fR 4
.IX Item "--disassemble-all"
.PD
مشابه
\&\fB\-d\fR،
اما محتوای تمامی بخش‌های غیرخالی و غیر bss را دیکامپایل می‌کند، نه فقط بخش‌هایی که انتظار می‌رود حاوی دستورالعمل باشند. از گزینه
\&\fB\-j\fR
می‌توان برای انتخاب بخش‌های خاص استفاده کرد.
.Sp
این گزینه همچنین تأثیر ظریفی روی دیکامپایل دستورالعمل‌ها در بخش‌های کد دارد. هنگامی که گزینه
\&\fB\-d\fR
فعال است، objdump فرض می‌کند هر نمادی در بخش کد روی مرز بین دستورالعمل‌ها قرار دارد و از دیکامپایل در عرض چنین مرزی خودداری می‌کند. اما هنگامی که گزینه
\&\fB\-D\fR
فعال باشد، این فرض نادیده گرفته می‌شود. این بدان معناست که اگر داده‌ها در بخش کد ذخیره شده باشند، ممکن است خروجی
\&\fB\-d\fR
و
\&\fB\-D\fR
متفاوت باشد.
.Sp
اگر معماری هدف ARM باشد، این سوییچ دیکامپایلر را مجبور می‌کند داده‌های موجود در بخش‌های کد را به گونه‌ای رمزگشایی کند که گویی دستورالعمل هستند.
.Sp
توجه داشته باشید که اگر گزینه
\&\fB\-\-dwarf=follow\-links\fR
فعال باشد، تمام جدول‌های نماد در فایل‌های اطلاعات دیباگ پیوند داده‌شده خوانده شده و در دیکامپایل به کار می‌روند.
.IP \fB\-\-no\-addresses\fR 4
.IX Item "--no-addresses"
هنگام دیکامپایل، آدرس‌ها روی هر خط یا برای نمادها و آفست‌های بازآرایی چاپ نمی‌شوند. در ترکیب با
\&\fB\-\-no\-show\-raw\-insn\fR
این گزینه برای مقایسه خروجی کامپایلرها بسیار کاربردی است.
.IP \fB\-\-prefix\-addresses\fR 4
.IX Item "--prefix-addresses"
هنگام دیکامپایل، آدرس کامل در هر خط چاپ می‌شود. این فرمت قدیمی‌تر دیکامپایل است.
.IP \fB\-EB\fR 4
.IX Item "-EB"
.PD 0
.IP \fB\-EL\fR 4
.IX Item "-EL"
.IP \fB\-\-endian={big|little}\fR 4
.IX Item "--endian={big|little}"
.PD
مشخص کردن ترتیب بایت‌ها (endianness) در فایل‌های شیء. این گزینه تنها بر دیکامپایل تأثیر می‌گذارد. هنگام دیکامپایل فرمت‌های فایلی که اطلاعات ترتیب بایت‌ها را ندارند (مانند S-records) کاربرد دارد.
.IP \fB\-f\fR 4
.IX Item "-f"
.PD 0
.IP \fB\-\-file\-headers\fR 4
.IX Item "--file-headers"
.PD
نمایش اطلاعات خلاصه هدر کلی هر یک از فایل‌های
\&\fIobjfile\fR.
.IP \fB\-F\fR 4
.IX Item "-F"
.PD 0
.IP \fB\-\-file\-offsets\fR 4
.IX Item "--file-offsets"
.PD
هنگام دیکامپایل بخش‌ها، هر زمان که نمادی نمایش داده می‌شود، آفست فایل ناحیه داده‌ای که قرار است استخراج شود نیز چاپ می‌شود. در صورت رد شدن از بایت‌های صفر، پس از ادامه دیکامپایل، تعداد صفرهای رد شده و آفست محلی که دیکامپایل از آن ادامه یافته گزارش می‌شود. هنگام استخراج بخش‌ها، آفست شروع استخراج نمایش داده می‌شود.
.IP \fB\-\-file\-start\-context\fR 4
.IX Item "--file-start-context"
مشخص می‌کند هنگامی که سورس‌کد و دیکامپایل درهم‌آمیخته نمایش داده می‌شوند (با فرض فعال بودن \fB\-S\fR)، برای فایلی که هنوز نمایش داده نشده، زمینه تا ابتدای فایل گسترش یابد.
.IP \fB\-h\fR 4
.IX Item "-h"
.PD 0
.IP \fB\-\-section\-headers\fR 4
.IX Item "--section-headers"
.IP \fB\-\-headers\fR 4
.IX Item "--headers"
.PD
نمایش اطلاعات خلاصه هدرهای بخش‌های فایل شیء.
.Sp
قطعات فایل ممکن است با استفاده از گزینه‌های
\&\fB\-Ttext\fR، \fB\-Tdata\fR
یا
\&\fB\-Tbss\fR
در
\&\fBld\fR
به آدرس‌های غیر استاندارد بازآرایی شوند. با این حال برخی فرمت‌های فایل شیء مانند a.out آدرس شروع قطعات فایل را ذخیره نمی‌کنند. در این شرایط با وجودی که
\&\fBld\fR
بخش‌ها را به درستی بازآرایی کرده است، استفاده از
\&\fBobjdump \-h\fR
برای فهرست هدرهای بخش نمی‌تواند آدرس‌های صحیح را نشان دهد و در عوض آدرس‌های پیش‌فرض هدف را نمایش می‌دهد.
.Sp
توجه: در برخی موارد ممکن است یک بخش هم ویژگی READONLY و هم NOREAD را داشته باشد. در چنین مواردی ویژگی NOREAD اولویت دارد، اما
\&\fBobjdump\fR
هر دو را گزارش می‌کند زیرا تنظیم دقیق بیت‌های فلگ ممکن است اهمیت داشته باشد.
.IP \fB\-H\fR 4
.IX Item "-H"
.PD 0
.IP \fB\-\-help\fR 4
.IX Item "--help"
.PD
چاپ خلاصه گزینه‌های
\&\fBobjdump\fR
و خروج.
.IP \fB\-i\fR 4
.IX Item "-i"
.PD 0
.IP \fB\-\-info\fR 4
.IX Item "--info"
.PD
نمایش فهرستی از تمام معماری‌ها و فرمت‌های شیء موجود برای استفاده با گزینه‌های
\&\fB\-b\fR
یا
\&\fB\-m\fR.
.IP "\fB\-j\fR \fIname\fR" 4
.IX Item "-j name"
.PD 0
.IP \fB\-\-section=\fR\fIname\fR 4
.IX Item "--section=name"
.PD
نمایش اطلاعات مربوط به بخش
\&\fIname\fR.
این گزینه می‌تواند چندین بار مشخص شود.
.IP \fB\-L\fR 4
.IX Item "-L"
.PD 0
.IP \fB\-\-process\-links\fR 4
.IX Item "--process-links"
.PD
نمایش محتوای بخش‌های غیردیباگ موجود در فایل‌های debuginfo جداگانه که به فایل اصلی لینک شده‌اند. این گزینه به طور خودکار گزینه
\&\fB\-WK\fR
را در بر دارد و فقط بخش‌های درخواست‌شده توسط سایر گزینه‌ها نمایش داده می‌شوند.
.IP \fB\-l\fR 4
.IX Item "-l"
.PD 0
.IP \fB\-\-line\-numbers\fR 4
.IX Item "--line-numbers"
.PD
برچسب‌گذاری خروجی با استفاده از اطلاعات دیباگ شامل نام فایل و شماره خطوط سورس متناظر با کد شیء یا بازآرایی‌های نمایش داده شده. فقط با گزینه‌های
\&\fB\-d\fR، \fB\-D\fR
یا
\&\fB\-r\fR
کاربرد دارد.
.IP "\fB\-m\fR \fImachine\fR" 4
.IX Item "-m machine"
.PD 0
.IP \fB\-\-architecture=\fR\fImachine\fR 4
.IX Item "--architecture=machine"
.PD
تعیین معماری مورد استفاده هنگام دیکامپایل فایل‌های شیء. هنگام دیکامپایل فایل‌هایی که فاقد اطلاعات معماری هستند (مانند S-records) کاربرد دارد. معماری‌های موجود با گزینه
\&\fB\-i\fR
قابل مشاهده‌اند.
.Sp
برای اکثر معماری‌ها می‌توان نام معماری و نوع ماشین را با علامت دونقطه جدا کرد، مانند
\&\fBfoo:bar\fR
که به نوع ماشین
\&\fBbar\fR
در معماری
\&\fBfoo\fR
اشاره دارد. این قابلیت زمانی که objdump برای پشتیبانی از چندین معماری پیکربندی شده باشد کاربرد دارد.
.Sp
اگر هدف معماری ARM باشد، این سوییچ تأثیر مضاعفی دارد و دیکامپایل را تنها به دستورالعمل‌های پشتیبانی‌شده در معماری تعیین‌شده توسط
\&\fImachine\fR
محدود می‌کند. اگر فایل ورودی فاقد اطلاعات معماری است اما مایلید تمام دستورالعمل‌ها دیکامپایل شوند، از
\&\fB\-marm\fR
استفاده کنید.
.IP "\fB\-M\fR \fIoptions\fR" 4
.IX Item "-M options"
.PD 0
.IP \fB\-\-disassembler\-options=\fR\fIoptions\fR 4
.IX Item "--disassembler-options=options"
.PD
ارسال اطلاعات خاص معماری هدف به دیکامپایلر. فقط روی برخی معماری‌ها پشتیبانی می‌شود. در صورت نیاز به تعیین چند گزینه، می‌توان چندین بار از
\&\fB\-M\fR
استفاده کرد یا آنها را با کاما از هم جدا نمود.
.Sp
برای معماری ARC گزینه \fBdsp\fR چاپ دستورالعمل‌های DSP، گزینه \fBspfp\fR چاپ دستورالعمل‌های ممیز شناور دقت تکی FPX، گزینه \fBdpfp\fR چاپ دستورالعمل‌های ممیز شناور دقت دوگانه FPX، گزینه \fBquarkse_em\fR چاپ دستورالعمل‌های خاص QuarkSE-EM، گزینه \fBfpuda\fR چاپ دستورالعمل‌های کمکی دقت دوگانه، گزینه \fBfpus\fR چاپ دستورالعمل‌های ممیز شناور دقت تکی FPU و گزینه \fBfpud\fR چاپ دستورالعمل‌های ممیز شناور دقت دوگانه FPU را انتخاب می‌کند. همچنین می‌توان با \fBhex\fR مقادیر بی‌درنگ (immediates) را در مبنای ۱۶ چاپ کرد. به طور پیش‌فرض مقادیر بی‌درنگ کوتاه در مبنای ۱۰ و مقادیر بلند در مبنای ۱۶ چاپ می‌شوند.
.Sp
گزینه \fBcpu=...\fR اجازه می‌دهد هنگام دیکامپایل دستورالعمل‌ها یک ISA خاص اعمال شود و مقدار \fB\-m\fR یا مقادیر موجود در فایل ELF بازنویسی گردد. این برای انتخاب ISA در ARC EM یا HS کاربرد دارد زیرا معماری برای هر دو یکسان است. این گزینه می‌تواند چندین بار مشخص شود و فقط آخرین مقدار اعمال می‌گردد. مقادیر معتبر مشابه گزینه \fB\-mcpu=...\fR در اسمبلر هستند.
.Sp
اگر هدف معماری ARM باشد، این سوییچ برای انتخاب مجموعه نام ثبات‌ها در طول دیکامپایل به کار می‌رود. گزینه \fB\-M reg\-names\-std\fR (پیش‌فرض) نام ثبات‌ها را مطابق مستندات مجموعه دستورالعمل ARM انتخاب می‌کند، اما ثبات ۱۳ را \*(Aqsp\*(Aq، ثبات ۱۴ را \*(Aqlr\*(Aq و ثبات ۱۵ را \*(Aqpc\*(Aq می‌نامد. گزینه \fB\-M reg\-names\-apcs\fR نام‌های استاندارد فراخوانی رویه ARM را انتخاب می‌کند و \fB\-M reg\-names\-raw\fR از حرف \fBr\fR به همراه شماره ثبات استفاده می‌کند.
.Sp
دو حالت دیگر برای نام‌گذاری ثبات‌های APCS شامل \fB\-M reg\-names\-atpcs\fR و \fB\-M reg\-names\-special\-atpcs\fR هستند که از قواعد نام‌گذاری استاندارد فراخوانی رویه ARM/Thumb استفاده می‌کنند.
.Sp
همچنین در معماری‌های ARM می‌توان دیکامپایلر را مجبور کرد تمام دستورالعمل‌ها را به عنوان دستورات Thumb تفسیر کند، با استفاده از سوییچ \fB\-\-disassembler\-options=force\-thumb\fR. این هنگام دیکامپایل کدهای Thumb تولید شده توسط سایر کامپایلرها کاربرد دارد.
.Sp
برای اهداف AArch64 این سوییچ می‌تواند با \fB\-M no\-aliases\fR دستورالعمل‌ها را به کلی‌ترین شکل دیکامپایل کند یا با \fB\-M notes\fR یادداشت‌های دستورالعمل را به صورت توضیح در دیکامپایل درج نماید.
.Sp
برای x86 برخی گزینه‌ها عملکردهای مشابه سوییچ \fB\-m\fR دارند اما امکان کنترل دقیق‌تری را فراهم می‌کنند:
.RS 4
.ie n .IP """x86\-64""" 4
.el .IP \f(CWx86\-64\fR 4
.IX Item "x86-64"
.PD 0
.ie n .IP """i386""" 4
.el .IP \f(CWi386\fR 4
.IX Item "i386"
.ie n .IP """i8086""" 4
.el .IP \f(CWi8086\fR 4
.IX Item "i8086"
.PD
انتخاب دیکامپایل برای معماری داده‌شده.
.ie n .IP """intel""" 4
.el .IP \f(CWintel\fR 4
.IX Item "intel"
.PD 0
.ie n .IP """att""" 4
.el .IP \f(CWatt\fR 4
.IX Item "att"
.PD
انتخاب بین حالت نگارش Intel و نگارش AT&T.
.ie n .IP """amd64""" 4
.el .IP \f(CWamd64\fR 4
.IX Item "amd64"
.PD 0
.ie n .IP """intel64""" 4
.el .IP \f(CWintel64\fR 4
.IX Item "intel64"
.PD
انتخاب بین AMD64 ISA و Intel64 ISA.
.ie n .IP """intel\-mnemonic""" 4
.el .IP \f(CWintel\-mnemonic\fR 4
.IX Item "intel-mnemonic"
.PD 0
.ie n .IP """att\-mnemonic""" 4
.el .IP \f(CWatt\-mnemonic\fR 4
.IX Item "att-mnemonic"
.PD
انتخاب بین حالت نمادهای اینتل و نمادهای AT&T.
توجه: \f(CW\*(C`intel\-mnemonic\*(C'\fR حالت \f(CW\*(C`intel\*(C'\fR را در بر دارد و \f(CW\*(C`att\-mnemonic\*(C'\fR حالت \f(CW\*(C`att\*(C'\fR را در بر دارد.
.ie n .IP """addr64""" 4
.el .IP \f(CWaddr64\fR 4
.IX Item "addr64"
.PD 0
.ie n .IP """addr32""" 4
.el .IP \f(CWaddr32\fR 4
.IX Item "addr32"
.ie n .IP """addr16""" 4
.el .IP \f(CWaddr16\fR 4
.IX Item "addr16"
.ie n .IP """data32""" 4
.el .IP \f(CWdata32\fR 4
.IX Item "data32"
.ie n .IP """data16""" 4
.el .IP \f(CWdata16\fR 4
.IX Item "data16"
.PD
تعیین اندازه پیش‌فرض آدرس و عملوند. این پنج گزینه در صورت حضور \f(CW\*(C`x86\-64\*(C'\fR، \f(CW\*(C`i386\*(C'\fR یا \f(CW\*(C`i8086\*(C'\fR در ادامه رشته گزینه‌ها بازنویسی خواهند شد.
.ie n .IP """suffix""" 4
.el .IP \f(CWsuffix\fR 4
.IX Item "suffix"
در حالت AT&T و همچنین برای مجموعه محدودی از دستورالعمل‌ها در حالت اینتل، دیکامپایلر را ملزم به چاپ پسوند نماد می‌کند حتی اگر پسوند از عملوندها یا حالت اجرای پیش‌فرض قابل استنباط باشد.
.RE
.RS 4
.Sp
برای PowerPC آرگومان \fBraw\fR در \fB\-M\fR دیکامپایل دستورالعمل‌های سخت‌افزاری را به جای نام‌های مستعار انتخاب می‌کند. به عنوان مثال \f(CW\*(C`rlwinm\*(C'\fR را به جای \f(CW\*(C`clrlwi\*(C'\fR و \f(CW\*(C`addi\*(C'\fR را به جای \f(CW\*(C`li\*(C'\fR مشاهده خواهید کرد. تمامی آرگومان‌های \fB\-m\fR برای \fBgas\fR که پردازنده را انتخاب می‌کنند پشتیبانی می‌شوند، از جمله:
\&\fB403\fR, \fB405\fR, \fB440\fR, \fB464\fR, \fB476\fR,
\&\fB601\fR, \fB603\fR, \fB604\fR, \fB620\fR, \fB7400\fR,
\&\fB7410\fR, \fB7450\fR, \fB7455\fR, \fB750cl\fR,
\&\fB821\fR, \fB850\fR, \fB860\fR, \fBa2\fR, \fBbooke\fR,
\&\fBbooke32\fR, \fBcell\fR, \fBcom\fR, \fBe200z2\fR, \fBe200z4\fR,
\&\fBe300\fR, \fBe500\fR, \fBe500mc\fR, \fBe500mc64\fR,
\&\fBe500x2\fR, \fBe5500\fR, \fBe6500\fR, \fBefs\fR,
\&\fBpower4\fR, \fBpower5\fR, \fBpower6\fR, \fBpower7\fR,
\&\fBpower8\fR, \fBpower9\fR, \fBpower10\fR, \fBpower11\fR,
\&\fBppc\fR, \fBppc32\fR, \fBppc64\fR, \fBppc64bridge\fR,
\&\fBppcps\fR, \fBpwr\fR, \fBpwr2\fR, \fBpwr4\fR, \fBpwr5\fR,
\&\fBpwr5x\fR, \fBpwr6\fR, \fBpwr7\fR, \fBpwr8\fR, \fBpwr9\fR,
\&\fBpwr10\fR, \fBpwr11\fR, \fBpwrx\fR, \fBtitan\fR, \fBvle\fR
و \fBfuture\fR.
گزینه‌های \fB32\fR و \fB64\fR انتخاب قبلی یا پیش‌فرض پردازنده را تغییر داده و دستورات ۶۴ بیتی را به ترتیب غیرفعال و فعال می‌کنند. علاوه بر این، گزینه‌های \fBaltivec\fR، \fBany\fR، \fBlsp\fR، \fBhtm\fR، \fBvsx\fR، \fBspe\fR و \fBspe2\fR قابلیت‌هایی را به انتخاب پردازنده قبلی \fIیا بعدی\fR می‌افزایند.
گزینه \fBany\fR هر آپ‌کدی که برای binutils شناخته‌شده باشد را دیکامپایل می‌کند، اما اگر آپ‌کدی دو معنی یا عملوند متفاوت داشته باشد ممکن است نتیجه مورد انتظار حاصل نشود. اگر بدون انتخاب پردازنده دیکامپایل کنید، یک مقدار پیش‌فرض بر اساس هدر فایل شیء توسط BFD انتخاب می‌شود.
.Sp
برای RISC-V گزینه‌های زیر پشتیبانی می‌شوند:
.ie n .IP """max""" 4
.el .IP \f(CWmax\fR 4
.IX Item "max"
دیکامپایل بدون بررسی رشته معماری. در این حالت برای پسوندهای تداخلی ISA، اولین تطابق برای رمزگشایی دستور استفاده می‌شود. زمانی مفید است که فایل ELF رشته ISA را مشخص نکرده باشد یا رشته پیش‌فرض (\f(CW\*(C`rv64gc\*(C'\fR) تمام دستورات را پوشش ندهد.
.ie n .IP """numeric""" 4
.el .IP \f(CWnumeric\fR 4
.IX Item "numeric"
چاپ نام عددی ثبات‌ها به جای نام‌های ABI (مثلاً چاپ \f(CW\*(C`x2\*(C'\fR به جای \f(CW\*(C`sp\*(C'\fR).
.ie n .IP """no\-aliases""" 4
.el .IP \f(CWno\-aliases\fR 4
.IX Item "no-aliases"
دیکامپایل تنها به دستورالعمل‌های استاندارد پایه. به عنوان مثال دستورات فشرده به همان شکل نمایش داده می‌شوند (\f(CW\*(C`addi sp,sp,\-128\*(C'\fR به صورت \f(CW\*(C`c.addi16sp sp,\-128\*(C'\fR نمایش می‌یابد).
.ie n .IP """priv\-spec=\fISPEC\fR""" 4
.el .IP \f(CWpriv\-spec=\fR\f(CISPEC\fR\f(CW\fR 4
.IX Item "priv-spec=SPEC"
چاپ ثبات‌های CSR بر اساس نسخه مشخصات سطح دسترسی انتخاب‌شده (مانند \f(CW1.10\fR، \f(CW1.11\fR، \f(CW1.12\fR، \f(CW1.13\fR).
.RE
.RS 4
.Sp
برای MIPS این گزینه چاپ نام نمادین دستورالعمل‌ها و نام ثبات‌ها را کنترل می‌کند. گزینه‌های زیر با کاما قابل تفکیک هستند و گزینه‌های نامعتبر نادیده گرفته می‌شوند:
.ie n .IP """no\-aliases""" 4
.el .IP \f(CWno\-aliases\fR 4
.IX Item "no-aliases"
چاپ دستورالعمل اصلی به جای دستورات شبه‌اسمبلی (pseudo-instructions). به عنوان مثال چاپ \*(Aqdaddu\*(Aq یا \*(Aqor\*(Aq به جای \*(Aqmove\*(Aq، و \*(Aqsll\*(Aq به جای \*(Aqnop\*(Aq.
.ie n .IP """msa""" 4
.el .IP \f(CWmsa\fR 4
.IX Item "msa"
دیکامپایل دستورالعمل‌های MSA.
.ie n .IP """virt""" 4
.el .IP \f(CWvirt\fR 4
.IX Item "virt"
دیکامپایل دستورالعمل‌های مجازی‌سازی ASE.
.ie n .IP """xpa""" 4
.el .IP \f(CWxpa\fR 4
.IX Item "xpa"
دیکامپایل دستورالعمل‌های آدرس‌دهی فیزیکی توسعه‌یافته (XPA) ASE.
.ie n .IP """gpr\-names=\fIABI\fR""" 4
.el .IP \f(CWgpr\-names=\fR\f(CIABI\fR\f(CW\fR 4
.IX Item "gpr-names=ABI"
چاپ نام ثبات‌های عمومی (GPR) متناسب با ABI مشخص‌شده. به طور پیش‌فرض بر اساس ABI باینری ورودی انتخاب می‌شود.
.ie n .IP """fpr\-names=\fIABI\fR""" 4
.el .IP \f(CWfpr\-names=\fR\f(CIABI\fR\f(CW\fR 4
.IX Item "fpr-names=ABI"
چاپ نام ثبات‌های ممیز شناور (FPR) متناسب با ABI مشخص‌شده. به طور پیش‌فرض شماره ثبات‌ها به جای نام چاپ می‌شود.
.ie n .IP """cp0\-names=\fIARCH\fR""" 4
.el .IP \f(CWcp0\-names=\fR\f(CIARCH\fR\f(CW\fR 4
.IX Item "cp0-names=ARCH"
چاپ نام ثبات‌های کمک‌پردازنده کنترل سیستم (CP0) متناسب با معماری مشخص‌شده با \fIARCH\fR. به طور پیش‌فرض بر اساس معماری باینری تعیین می‌شود.
.ie n .IP """hwr\-names=\fIARCH\fR""" 4
.el .IP \f(CWhwr\-names=\fR\f(CIARCH\fR\f(CW\fR 4
.IX Item "hwr-names=ARCH"
چاپ نام ثبات‌های سخت‌افزاری HWR (مورد استفاده در دستور \f(CW\*(C`rdhwr\*(C'\fR) متناسب با پردازنده یا معماری مشخص‌شده در \fIARCH\fR.
.ie n .IP """reg\-names=\fIABI\fR""" 4
.el .IP \f(CWreg\-names=\fR\f(CIABI\fR\f(CW\fR 4
.IX Item "reg-names=ABI"
چاپ نام ثبات‌های GPR و FPR متناسب با ABI انتخاب‌شده.
.ie n .IP """reg\-names=\fIARCH\fR""" 4
.el .IP \f(CWreg\-names=\fR\f(CIARCH\fR\f(CW\fR 4
.IX Item "reg-names=ARCH"
چاپ نام ثبات‌های اختصاصی پردازنده (ثبات‌های CP0 و HWR) متناسب با پردازنده یا معماری انتخاب‌شده.
.RE
.RS 4
.Sp
برای هر یک از گزینه‌های بالا، می‌توان \fIABI\fR یا \fIARCH\fR را برابر با \fBnumeric\fR قرار داد تا به جای نام‌ها، شماره‌های عددی برای ثبات‌ها چاپ شوند. مقادیر موجود با گزینه \fB\-\-help\fR قابل مشاهده‌اند.
.Sp
برای VAX می‌توانید آدرس‌های ورودی تابع را با \fB\-M entry:0xf00ba\fR مشخص کنید. از این گزینه می‌توان چندین بار برای دیکامپایل باینری‌های VAX فاقد جدول نمادها استفاده کرد تا ماسک ورودی تابع اشتباهاً به عنوان دستورات VAX تفسیر نشود.
.RE
.IP \fB\-p\fR 4
.IX Item "-p"
.PD 0
.IP \fB\-\-private\-headers\fR 4
.IX Item "--private-headers"
.PD
چاپ اطلاعات اختصاصی فرمت فایل شیء. اطلاعات دقیق چاپ‌شده به فرمت فایل بستگی دارد و برای برخی فرمت‌ها اطلاعات بیشتری چاپ نمی‌شود.
.IP "\fB\-P\fR \fIoptions\fR" 4
.IX Item "-P options"
.PD 0
.IP \fB\-\-private=\fR\fIoptions\fR 4
.IX Item "--private=options"
.PD
چاپ اطلاعات اختصاصی فرمت فایل شیء. آرگومان \fIoptions\fR فهرستی از گزینه‌های جداشده با کاما است که به فرمت بستگی دارد (فهرست گزینه‌ها در خروجی help نمایش داده می‌شود).
.Sp
برای XCOFF گزینه‌های موجود عبارتند از:
.RS 4
.ie n .IP """header""" 4
.el .IP \f(CWheader\fR 4
.IX Item "header"
.PD 0
.ie n .IP """aout""" 4
