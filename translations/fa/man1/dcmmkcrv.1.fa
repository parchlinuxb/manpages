.TH "dcmmkcrv" 1 "Thu Jul 9 2026 18:43:40" "Version 3.7.0" "OFFIS DCMTK" \" -*- nroff -*-
.nh
.SH "نام (NAME)"
dcmmkcrv \- افزودن داده‌های منحنی دوبعدی به تصویر دایکام (DICOM)
.PP

.SH "خلاصه دستور (SYNOPSIS)"
.PP
.PP
.nf
dcmmkcrv [options] dcmfile-in curvedata-in dcmfile-out
.fi
.PP
.SH "توضیحات (DESCRIPTION)"
.PP
ابزار \fBdcmmkcrv\fP امکان ایجاد تصاویر دایکام حاوی داده‌های منحنی را فراهم می‌کند. از آنجا که امروزه داده‌های منحنی به ندرت توسط تولیدکنندگان استفاده می‌شوند، این ابزار به عنوان روشی برای آزمایش پیاده‌سازی‌هایی است که می‌توانند داده‌های منحنی را بخوانند. این ابزار یک تصویر دایکام موجود و یک فایل متنی حاوی داده‌های منحنی به صورت متنی را می‌خواند. یک گروه تکرارشونده داده‌های منحنی دایکام بر اساس گزینه‌های مشخص‌شده در خط فرمان ایجاد می‌شود، به تصویر موجود افزوده شده و دوباره در فایل نوشته می‌شود. فایل خروجی با همان نحو انتقال (transfer syntax) استفاده‌شده برای فایل ورودی کدگذاری می‌شود. این ابزار تنها از ایجاد منحنی‌های دو بعدی پشتیبانی می‌کند.
.SH "پارامترها (PARAMETERS)"
.PP
.PP
.nf
dcmfile-in    فایل تصویر ورودی دایکام ("-" برای ورودی استاندارد)

curvedata-in  فایل ورودی داده‌های منحنی (متن)

dcmfile-out   نام فایل خروجی دایکام ("-" برای خروجی استاندارد)
.fi
.PP
.SH "گزینه‌ها (OPTIONS)"
.PP
.SS "گزینه‌های عمومی (general options)"
.PP
.nf
  -h   --help
         چاپ این راهنما و خروج

       --version
         چاپ اطلاعات نسخه و خروج

       --arguments
         چاپ آرگومان‌های بسط‌یافته خط فرمان

  -q   --quiet
         حالت بی‌صدا، عدم چاپ هشدارها و خطاها

  -v   --verbose
         حالت پرگو، چاپ جزئیات پردازش

  -d   --debug
         حالت اشکال‌زدایی، چاپ اطلاعات دیباگ

  -ll  --log-level  [l]evel: string constant
         (fatal, error, warn, info, debug, trace)
         استفاده از سطح l برای ثبت‌کننده وقایع

  -lc  --log-config  [f]ilename: string
         استفاده از فایل پیکربندی f برای ثبت‌کننده وقایع
.fi
.PP
.SS "گزینه‌های ایجاد منحنی (curve creation options)"
.PP
.nf
curve type:

  -r  --poly
        ایجاد به عنوان منحنی POLY (پیش‌فرض)

  +r  --roi
        ایجاد به عنوان منحنی ROI

curve value representation:

  +v  --data-vr  [n]umber: integer 0\&.\&.4 (پیش‌فرض: 4)
        انتخاب نوع نمایش مقدار منحنی (VR): 0=US, 1=SS, 2=FL, 3=FD, 4=SL

  -c  --curve-vr  [n]umber: integer 0\&.\&.2 (پیش‌فرض: 0)
        انتخاب VR که با آن عنصر داده منحنی نوشته می‌شود
        0=VR مطابق با --data-vr، 1=OB، 2=OW

repeating group:

  -g  --group  [n]umber: integer 0\&.\&.15 (پیش‌فرض: 0)
        انتخاب گروه تکرارشونده: 0=0x5000, 1=0x5002 و غیره

curve description:

  -l  --label  s: string
        تنظیم برچسب منحنی به s (پیش‌فرض: بدون برچسب)

  +d  --description  s: string
        تنظیم شرح منحنی به s (پیش‌فرض: بدون شرح)

  -a  --axis  x: string, y: string
        تنظیم واحدهای محورها به x\\y (پیش‌فرض: تنظیم‌نشده)
.fi
.PP
.SH "نکات (NOTES)"
.PP
.SS "ساختار فایل داده‌های منحنی (Syntax of the Curve Data File)"
فایل داده‌های منحنی باید یک فایل متنی اسکی ساده حاوی اعداد (صحیح یا ممیز شناور) باشد که مقادیر مختصات نقاط را تشکیل می‌دهند. اعداد باید با فاصله سفید از هم جدا شوند. هیچ‌گونه بررسی محدوده مقادیر یا تبدیل محدوده مقادیر انجام نمی‌شود. مثال:

.PP
.PP
.nf
 256\&.451947    1\&.000000
 477\&.689863  128\&.822080
 128\&.822080  477\&.689863
  35\&.310137  128\&.822080
 256\&.451947    1\&.000000
.fi
.PP
.SH "ثبت وقایع (LOGGING)"
.PP
سطح خروجی ثبت وقایع ابزارهای مختلف خط فرمان و کتابخانه‌های زیربنایی می‌تواند توسط کاربر مشخص شود. به طور پیش‌فرض، تنها خطاها و هشدارها در خروجی استاندارد خطا نوشته می‌شوند. با استفاده از گزینه \fI--verbose\fP پیام‌های اطلاع‌رسانی مانند جزئیات پردازش نیز گزارش می‌شوند. گزینه \fI--debug\fP می‌تواند برای دریافت جزئیات بیشتر درباره فعالیت‌های داخلی، برای نمونه جهت اشکال‌زدایی، استفاده شود. سایر سطوح لاگ را می‌توان با گزینه \fI--log-level\fP انتخاب کرد. در حالت \fI--quiet\fP تنها خطاهای مهلک گزارش می‌شوند. در چنین رخدادهای خطای بسیار شدیدی، برنامه معمولاً خاتمه می‌یابد. برای جزئیات بیشتر درباره سطوح مختلف لاگ، به مستندات ماژول "oflog" مراجعه کنید.

.PP
در صورتی که خروجی ثبت وقایع باید در فایل نوشته شود (اختیاراً همراه با چرخش فایل لاگ)، در syslog (یونیکس) یا گزارش رویدادها (ویندوز)، گزینه \fI--log-config\fP می‌تواند استفاده شود. این فایل پیکربندی همچنین امکان هدایت پیام‌های خاص به جریان خروجی مشخص و فیلتر کردن پیام‌ها بر اساس ماژول یا برنامه‌ای که در آن تولید شده‌اند را فراهم می‌کند. یک نمونه فایل پیکربندی در \fI<etcdir>/logger\&.cfg\fP ارائه شده است.
.SH "خط فرمان (COMMAND LINE)"
.PP
تمام ابزارهای خط فرمان از نشانه‌گذاری زیر برای پارامترها استفاده می‌کنند: براکت‌های مربعی مقادیر اختیاری را احاطه می‌کنند (0-1)، سه نقطه پایانی نشان می‌دهد که مقادیر متعدد مجاز است (1-n)، و ترکیبی از هر دو به معنی 0 تا n مقدار است.

.PP
گزینه‌های خط فرمان با علامت پیشوند '+' یا '-' از پارامترها متمایز می‌شوند. معمولاً ترتیب و موقعیت گزینه‌های خط فرمان اختیاری است (یعنی می‌توانند در هر کجای خط فرمان ظاهر شوند). با این حال، اگر گزینه‌ها ناسازگار با یکدیگر باشند، آخرین گزینه در سمت راست استفاده می‌شود. این رفتار مطابق با قوانین ارزیابی استاندارد پوسته‌های متداول یونیکس است.

.PP
علاوه بر این، یک یا چند فایل دستور را می‌توان با پیشوند '@' قبل از نام فایل تعیین کرد (مانند \fI@command\&.txt\fP). چنین آرگومان دستوری پیش از هرگونه ارزیابی بیشتر، با محتوای فایل متنی مربوطه جایگزین می‌شود (چندین فاصله سفید به عنوان یک جداکننده منفرد در نظر گرفته می‌شوند مگر اینکه بین دو گیومه باشند). لطفاً توجه داشته باشید که یک فایل دستور نمی‌تواند حاوی فایل دستور دیگری باشد. این رویکرد ساده اما مؤثر امکان خلاصه‌سازی ترکیب‌های متداول گزینه‌ها/پارامترها را می‌دهد و از خطوط فرمان طولانی و گیج‌کننده جلوگیری می‌کند (یک مثال در فایل \fI<datadir>/dumppat\&.txt\fP ارائه شده است).
.SH "متغیرهای محیطی (ENVIRONMENT)"
.PP
ابزار \fBdcmmkcrv\fP تلاش خواهد کرد فرهنگ‌های داده دایکام را که در متغیر محیطی \fIDCMDICTPATH\fP مشخص شده‌اند، بارگذاری کند. به طور پیش‌فرض، یعنی اگر متغیر محیطی \fIDCMDICTPATH\fP تنظیم نشده باشد، فایل \fI<datadir>/dicom\&.dic\fP بارگذاری خواهد شد مگر اینکه فرهنگ داده درون برنامه ساخته شده باشد (پیش‌فرض برای ویندوز).

.PP
رفتار پیش‌فرض ارجح است و متغیر محیطی \fIDCMDICTPATH\fP تنها زمانی باید استفاده شود که فرهنگ‌های داده جایگزین مورد نیاز باشد. متغیر محیطی \fIDCMDICTPATH\fP همان قالبی را دارد که متغیر \fIPATH\fP پوسته یونیکس دارد، به این صورت که علامت دونقطه (":") ورودی‌ها را جدا می‌کند. در سیستم‌های ویندوز، نقطه ویرگول (";") به عنوان جداکننده استفاده می‌شود. کد فرهنگ داده تلاش خواهد کرد هر فایل مشخص‌شده در متغیر محیطی \fIDCMDICTPATH\fP را بارگذاری کند. اگر هیچ فرهنگ داده‌ای بارگذاری نشود، یک خطا محسوب می‌شود.
