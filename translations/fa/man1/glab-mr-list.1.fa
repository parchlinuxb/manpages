.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-mr-list \- List merge requests.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab mr list [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Defaults to open merge requests. Use \fB--all\fR to include closed
and merged requests. Use \fB--group\fR to list for a group instead
of the current project.


.SH "گزینه‌ها (OPTIONS)"
\fB-A\fP, \fB--all\fP[=false]
	Get all merge requests.

.PP
\fB-a\fP, \fB--assignee\fP=[]
	Get only merge requests assigned to users. Multiple users can be comma-separated or specified by repeating the flag.

.PP
\fB--author\fP=""
	Filter merge request by author \&.

.PP
\fB-c\fP, \fB--closed\fP[=false]
	Get only closed merge requests.

.PP
\fB--created-after\fP=
	Filter merge requests created after a certain date (ISO 8601 format).

.PP
\fB--created-before\fP=
	Filter merge requests created before a certain date (ISO 8601 format).

.PP
\fB--deployed-after\fP=
	Filter merge requests deployed after a certain date (ISO 8601 format).

.PP
\fB--deployed-before\fP=
	Filter merge requests deployed before a certain date (ISO 8601 format).

.PP
\fB-d\fP, \fB--draft\fP[=false]
	Filter by draft merge requests.

.PP
\fB--environment\fP=""
	Filter merge requests deployed to the given environment \&.

.PP
\fB-g\fP, \fB--group\fP=""
	Select a group/subgroup. This option is ignored if a repo argument is set.

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression.

.PP
\fB-l\fP, \fB--label\fP=[]
	Filter merge request by label \&. Multiple labels can be comma-separated or specified by repeating the flag.

.PP
\fB-M\fP, \fB--merged\fP[=false]
	Get only merged merge requests.

.PP
\fB-m\fP, \fB--milestone\fP=""
	Filter merge request by milestone \&.

.PP
\fB--not-draft\fP[=false]
	Filter by non-draft merge requests.

.PP
\fB--not-label\fP=[]
	Filter merge requests by not having label \&. Multiple labels can be comma-separated or specified by repeating the flag.

.PP
\fB-o\fP, \fB--order\fP=""
	Order merge requests by \&. Order options: created_at, updated_at, merged_at, title, priority, label_priority, milestone_due, and popularity.

.PP
\fB-F\fP, \fB--output\fP="text"
	Format output as: text, json.

.PP
\fB-p\fP, \fB--page\fP=1
	Page number.

.PP
\fB-P\fP, \fB--per-page\fP=30
	Number of items to list per page.

.PP
\fB-R\fP, \fB--repo\fP=""
	Select another repository. You can use either OWNER/REPO or GROUP/NAMESPACE/REPO. The full URL or Git URL is also accepted.

.PP
\fB-r\fP, \fB--reviewer\fP=[]
	Get only merge requests with users as reviewer. Multiple users can be comma-separated or specified by repeating the flag.

.PP
\fB--search\fP=""
	Filter by  in title and description.

.PP
\fB-S\fP, \fB--sort\fP=""
	Sort direction for --order field: asc or desc.

.PP
\fB-s\fP, \fB--source-branch\fP=""
	Filter by source branch \&.

.PP
\fB-t\fP, \fB--target-branch\fP=""
	Filter by target branch \&.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-h\fP, \fB--help\fP[=false]
	Show help for this command.


.SH "مثال (EXAMPLE)"
.EX
glab mr list --all
glab mr ls -a
glab mr list --assignee=@me
glab mr list --reviewer=@me
glab mr list --source-branch=new-feature
glab mr list --target-branch=main
glab mr list --search "this adds feature X"
glab mr list --label needs-review
glab mr list --not-label waiting-maintainer-feedback,subsystem-x
glab mr list -M --per-page 10
glab mr list --draft
glab mr list --not-draft
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-mr(1)\fP
