.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-service-logs \- دریافت لاگ‌های یک سرویس یا وظیفه (تسک)


.SH "خلاصه (SYNOPSIS)"
\fBdocker service logs [OPTIONS] SERVICE|TASK\fP


.SH "شرح (DESCRIPTION)"
دریافت لاگ‌های یک سرویس یا وظیفه (تسک)


.SH "گزینه‌ها (OPTIONS)"
\fB--details\fP[=false]
	نمایش جزئیات بیشتر ارائه‌شده برای لاگ‌ها

.PP
\fB-f\fP, \fB--follow\fP[=false]
	پیگیری زنده خروجی لاگ

.PP
\fB--no-resolve\fP[=false]
	شناسه‌ها (IDs) در خروجی به نام‌ها نگاشت نشوند

.PP
\fB--no-task-ids\fP[=false]
	شناسه‌های وظایف (task IDs) در خروجی قرار نگیرند

.PP
\fB--no-trunc\fP[=false]
	خروجی کوتاه نشود

.PP
\fB--raw\fP[=false]
	لاگ‌ها قالب‌بندی و تمیز نشوند

.PP
\fB--since\fP=""
	نمایش لاگ‌ها از زمان مشخص‌شده (مانند "2013-01-02T13:23:37Z") یا نسبی (مانند "42m" برای ۴۲ دقیقه پیش)

.PP
\fB-n\fP, \fB--tail\fP="all"
	تعداد خطوط برای نمایش از انتهای لاگ‌ها

.PP
\fB-t\fP, \fB--timestamps\fP[=false]
	نمایش برچسب‌های زمانی


.SH "ببینید (SEE ALSO)"
\fBdocker-service(1)\fP
