.INDENT 0.0
.INDENT 3.5
.sp
.EX
{
    \(dqcommand\(dq: \(dqinterface\-list\(dq
}
.EE
.UNINDENT
.UNINDENT
.sp
Response syntax:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
{
    \(dqresult\(dq: 0,
    \(dqtext\(dq: \(dq2 interfaces detected.\(dq,
    \(dqarguments\(dq: {
        \(dqinterfaces\(dq: [ {
            \(dqname\(dq: \(dqeth0\(dq,
            \(dqindex\(dq: 4,
            \(dqmac\(dq: \(dq00:11:22:33:44:55\(dq,
            \(dqtype\(dq: 6,
            \(dqaddresses\(dq: [ \(dq192.168.1.1\(dq, \(dq10.10.1.1\(dq,
                             \(dq2003:db8:1::1\(dq, \(dq3001:db8:1::1\(dq,
                             \(dqfe80::3a60:77ff:fed5:abcd\(dq ],
            \(dqflag\-loopback\(dq: false,
            \(dqflag\-up\(dq: true,
            \(dqflag\-running\(dq: true,
            \(dqflag\-multicast\(dq: false,
            \(dqflag\-broadcast\(dq: false,
            \(dqin\-use\(dq: true
        }, {
            \(dqname\(dq: \(dqeth1\(dq,
            \(dqindex\(dq: 7,
            \(dqmac\(dq: \(dq11:22:33:44:55:66\(dq,
            \(dqtype\(dq: 6,
            \(dqaddresses\(dq: [ \(dq10.10.1.2\(dq,
                             \(dq2003:db8:1::2\(dq,
                             \(dqfe80::3a60:77ff:fed5:1234\(dq ],
            \(dqflag\-loopback\(dq: false,
            \(dqflag\-up\(dq: true,
            \(dqflag\-running\(dq: true,
            \(dqflag\-multicast\(dq: false,
            \(dqflag\-broadcast\(dq: false,
            \(dqin\-use\(dq: false
        }]
    }
}
