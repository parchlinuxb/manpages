.TH "UPTERM" "1" "May 2026" "Upterm 0.0.0+dev" "Upterm Manual"

.SH "نام (NAME)"
upterm-upgrade \- Upgrade the CLI


.SH "خلاصه دستور (SYNOPSIS)"
\fBupterm upgrade [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Upgrade the CLI


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	help for upgrade


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	enable debug level logging (log file: /build/.upterm/upterm.log).


.SH "مثال (EXAMPLE)"
.EX
  # Upgrade to the latest version:
  upterm upgrade

  # Upgrade to a specific version:
  upterm upgrade 0.2.0
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBupterm(1)\fP


