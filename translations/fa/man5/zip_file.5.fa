.Dd May 5, 2025
.Dt ZIP_FILE 5
.Os
.SH "نام (NAME)"
zip_file \- توصیف‌گر پرونده باز در آرشیو zip
.Sh "کتابخانه (LIBRARY)"
libzip (-lzip)
.Sh "خلاصه دستور (SYNOPSIS)"
.In zip.h
.Vt zip_file_t *file ;
.Sh "توضیحات (DESCRIPTION)"
یک
.Nm zip_file
نمایانگر یک پرونده درون یک آرشیو است که برای خواندن باز شده است.
این ساختار با
.Xr zip_fopen 3 ،
.Xr zip_fopen_index 3 ،
.Xr zip_fopen_encrypted 3
یا
.Xr zip_fopen_index_encrypted 3
ایجاد می‌شود.
.Pp
داده‌ها با
.Xr zip_fread 3 ،
.Xr zip_file_is_seekable 3 ،
.Xr zip_ftell 3
یا
.Xr zip_fseek 3
قابل دسترسی هستند.
.Pp
این ساختار با
.Xr zip_fclose 3
بسته می‌شود.
.Pp
اگر
.Vt zip_t
حاوی آن بسته شود، تمام استفاده‌های بعدی از
.Vt zip_file_t
یک خطا برمی‌گردانند.
این یک پوشش کمکی (wrapper) پیرامون یک
.Vt zip_source_t
است، همان‌طور که توسط
.Xr zip_source_zip 3
ایجاد می‌شود.
.Sh "همچنین ببینید (SEE ALSO)"
.Xr zip_fclose 3 ,
.Xr zip_file_is_seekable 3 ,
.Xr zip_fopen 3 ,
.Xr zip_fopen_encrypted 3 ,
.Xr zip_fopen_index 3 ,
.Xr zip_fopen_index_encrypted 3 ,
.Xr zip_fread 3 ,
.Xr zip_fseek 3 ,
.Xr zip_ftell 3 ,
.Xr zip_source_zip 3
.Sh "نویسندگان (AUTHORS)"
.An -nosplit
.An Dieter Baron Aq Mt dillo@nih.at
و
.An Thomas Klausner Aq Mt wiz@gatalith.at
