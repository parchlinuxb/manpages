.TH "mtx-unzip" "1" "01-01-2026" "version 0.10" "Simple Unzipper"
.SH "نام (NAME)"
 mtx-unzip \- Simple Unzipper
.SH "خلاصه دستور (SYNOPSIS)"
.B mtxrun --script unzip [
.I OPTIONS ...
.B ] [
.I FILENAMES
.B ]
.SH "توضیحات (DESCRIPTION)"
.B Simple Unzipper
.SH "گزینه‌ها (OPTIONS)"
.TP
.B --list
list files in archive
.TP
.B --extract
extract files [--silent --steps]
.SH "نویسنده (AUTHOR)"
