.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
pam_matrix \- ماژول آزمایشی PAM برای بازیابی موارد خاص ماژول در PAM
.SH "خلاصه دستور (SYNOPSIS)"
.sp
pam_matrix\&.so [\&...]
.SH "توضیحات (DESCRIPTION)"
.sp
آزمایش برنامه‌های PAM اغلب نیازمند راه‌اندازی یک بک‌اند احراز هویت با کمترین زحمت ممکن است\&. ماژول \fBpam_matrix\fR امکان احراز هویت در برابر یک فایل متنی کلید\-مقدار را که از طریق یک گزینه یا با یک متغیر محیطی ارائه می‌شود، فراهم می‌کند\&.
.SH "مهم (IMPORTANT)"
.sp
دستور pam_matrix یک \fBابزار آزمایش\fR است\&. این ابزار باید کاملاً ناامن در نظر گرفته شود و هرگز خارج از محیط‌های آزمایشی استفاده نشود! همان‌طور که هنگام خواندن توضیحات گزینه‌ها و اقدامات مشاهده خواهید کرد، بسیاری از آن‌ها در دنیای واقعی هیچ کاربردی ندارند و صرفاً برای امکان‌پذیر ساختن آزمایش‌ها افزوده شده‌اند\&.
.SH "پایگاه‌داده گذرواژه (PASSWORD DATABASE)"
.sp
ماژول pam_matrix کاربر را در برابر یک فایل متنی ساده CSV احراز هویت می‌کند\&. قالب این فایل به صورت زیر است:
.sp
.if n \{\
.RS 4
.\}
.nf
username:password:allowed_service
.fi
.if n \{\
.RE
.\}
.sp
مثال: کاربر bob مجاز است با سرویس sshd احراز هویت کند
.sp
.if n \{\
.RS 4
.\}
.nf
bob:secret:sshd
.fi
.if n \{\
.RE
.\}
.SH "گزینه‌ها (OPTIONS)"
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fBpassdb=/path/to/file\fR
\- مسیر پایگاه‌داده گذرواژه\&. اگر پایگاه‌داده با این گزینه ماژول ارائه نشود، pam_matrix\&.so متغیر محیطی PAM_MATRIX_PASSWD را می‌خواند و تلاش می‌کند فایل را از آنجا بارگذاری کند\&. اگر آن هم با شکست مواجه شود، PAM_AUTHINFO_UNAVAIL برگردانده می‌شود\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fBecho\fR
\- اگر این گزینه ارائه شود، pam_matrix\&.so با استفاده از PAM_PROMPT_ECHO_ON گذرواژه را درخواست می‌کند، بدین معنا که گذرواژه به کاربر نمایش داده می‌شود (echo می‌شود)\&. این گزینه برای امکان‌پذیر ساختن آزمایش بهتر توابع گفتگو (conversation) افزوده شده است\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fBverbose\fR
\- اگر این گزینه ارائه شود، pam_matrix\&.so هنگام موفقیت‌آمیز بودن احراز هویت یک پیام PAM_TEXT_INFO و در صورت شکست آن یک پیام PAM_ERROR_MSG نمایش می‌دهد\&. این گزینه برای امکان‌پذیر ساختن آزمایش بهتر توابع گفتگو (conversation) افزوده شده است\&.
.RE
.SH "انواع ماژول‌های ارائه‌شده (MODULE TYPES PROVIDED)"
.sp
تمامی انواع ماژول‌ها (\fBaccount\fR، \fBauth\fR، \fBpassword\fR و \fBsession\fR) پشتیبانی می‌شوند\&.
.sp
ماژول \fBauth\fR کاربر را در فایل passdb جستجو کرده و گذرواژه ارائه‌شده را با گذرواژه موجود در فایل passdb مقایسه می‌کند\&.
.sp
ماژول \fBpassword\fR قادر است گذرواژه را در فایل passdb به‌روزرسانی کند\&.
.sp
ماژول \fBaccess\fR نام سرویسی را که گفتگوی PAM با آن فراخوانی شده است، با سرویس مجاز برای کاربر مطابق آنچه در فایل passdb تنظیم شده مقایسه می‌کند\&.
.sp
ماژول \fBsession\fR متغیر محیطی PAM موسوم به HOMEDIR را برابر با "/home/%u" قرار می‌دهد که در آن %u نشان‌دهنده کاربری است که نشست را باز می‌کند\&. این متغیر هنگام بسته شدن نشست لغو تنظیم (unset) می‌شود\&.
.SH "مثال‌ها (EXAMPLES)"
.sp
.if n \{\
.RS 4
.\}
.nf
auth        required    pam_matrix\&.so passdb=/tmp/passdb verbose
account     required    pam_matrix\&.so passdb=/tmp/passdb verbose
password    required    pam_matrix\&.so passdb=/tmp/passdb verbose
session     required    pam_matrix\&.so passdb=/tmp/passdb verbose
.fi
.if n \{\
.RE
.\}
