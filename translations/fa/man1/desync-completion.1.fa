.TH "desync" "1" "Sep 2026" "desync" ""

.SH "نام (NAME)"
desync-completion \- Generate the autocompletion script for the specified shell


.SH "خلاصه دستور (SYNOPSIS)"
\fBdesync completion [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Generate the autocompletion script for desync for the specified shell.
See each sub-command's help for details on how to use the generated script.


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	help for completion


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config file (default $HOME/.config/desync/config.json)

.PP
\fB--digest\fP="sha512-256"
	digest algorithm, sha512-256 or sha256

.PP
\fB--verbose\fP[=false]
	verbose mode


.SH "همچنین ببینید (SEE ALSO)"
\fBdesync(1)\fP, \fBdesync-completion-bash(1)\fP, \fBdesync-completion-fish(1)\fP, \fBdesync-completion-powershell(1)\fP, \fBdesync-completion-zsh(1)\fP


