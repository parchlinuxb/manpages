.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
opensc-notify \- پایش رویدادهای کارت هوشمند و ارسال اعلان‌ها
.SH "خلاصه دستور (SYNOPSIS)"
.HP \w'\fBopensc\-notify\fR\ 'u
\fBopensc\-notify\fR [\fIگزینه‌ها\fR]
.SH "توضیحات (DESCRIPTION)"
.PP
ابزار
\fBopensc\-notify\fR
برای پایش رویدادهای کارت هوشمند و ارسال اعلان‌های مناسب به‌کار می‌رود\&.
.SH "گزینه‌ها (OPTIONS)"
.PP
.PP
\fB\-\-help\fR, \fB\-h\fR
.RS 4
چاپ راهنما و خروج\&.
.RE
.PP
\fB\-\-version\fR, \fB\-V\fR
.RS 4
چاپ نسخه و خروج\&.
.RE
.SS "حالت: سفارشی (customized)"
.PP
ارسال اعلان‌های سفارشی\&.
.PP
\fB\-\-title\fR [\fISTRING\fR], \fB\-t\fR [\fISTRING\fR]
.RS 4
مشخص کردن عنوان اعلان\&.
.RE
.PP
\fB\-\-message\fR [\fISTRING\fR], \fB\-m\fR [\fISTRING\fR]
.RS 4
مشخص کردن متن اصلی اعلان\&.
.RE
.SS "حالت: استاندارد (standard)"
.PP
ارسال دستی اعلان‌های استاندارد\&.
.PP
\fB\-\-notify\-card\-inserted\fR, \fB\-I\fR
.RS 4
به
\fInotify_card_inserted\fR
در
opensc\&.conf
مراجعه کنید
(پیش‌فرض=off)\&.
.RE
.PP
\fB\-\-notify\-card\-removed\fR, \fB\-R\fR
.RS 4
به
\fInotify_card_removed\fR
در
opensc\&.conf
مراجعه کنید
(پیش‌فرض=off)\&.
.RE
.PP
\fB\-\-notify\-pin\-good\fR, \fB\-G\fR
.RS 4
به
\fInotify_pin_good\fR
در
opensc\&.conf
مراجعه کنید
(پیش‌فرض=off)\&.
.RE
.PP
\fB\-\-notify\-pin\-bad\fR, \fB\-B\fR
.RS 4
به
\fInotify_pin_bad\fR
در
opensc\&.conf
مراجعه کنید
(پیش‌فرض=off)\&.
.RE
.SH "نویسندگان (AUTHORS)"
.PP
\fBopensc\-notify\fR
توسط Frank Morgner
<frankmorgner@gmail\&.com>
نوشته شده است\&.