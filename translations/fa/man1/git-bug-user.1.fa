.TH "GIT-BUG" "1" "Apr 2019" "Generated from git-bug's source code" ""

.SH "نام (NAME)"
git-bug-user \- فهرست کردن هویت‌ها


.SH "خلاصه دستور (SYNOPSIS)"
\fBgit-bug user [flags]\fP


.SH "توضیحات (DESCRIPTION)"
فهرست کردن هویت‌ها


.SH "گزینه‌ها (OPTIONS)"
\fB-f\fP, \fB--format\fP="default"
	انتخاب سبک قالب‌بندی خروجی. مقادیر معتبر عبارتند از [default,json]

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای user


