.\" -*- nroff -*-
.\" ovs.tmac
.\"
.\" Open vSwitch troff macro library
.
.
.\" Continuation line for .IP.
.de IQ
.  br
.  ns
.  IP "\\$1"
..
.
.\" Introduces a sub-subsection
.de ST
.  PP
.  RS -0.15in
.  I "\\$1"
.  RE
..
.
.\" The content between the lines below is from an-ext.tmac in groff
.\" 1.21, with some modifications.
.\" ----------------------------------------------------------------------
.\" an-ext.tmac
.\"
.\" Written by Eric S. Raymond <esr@thyrsus.com>
.\"            Werner Lemberg <wl@gnu.org>
.\"
.\" Version 2007-Feb-02
.\"
.\" Copyright (C) 2007, 2009, 2011 Free Software Foundation, Inc.
.\" You may freely use, modify and/or distribute this file.
.\"
.\"
.\" The code below provides extension macros for the `man' macro package.
.\" Care has been taken to make the code portable; groff extensions are
.\" properly hidden so that all troff implementations can use it without
.\" changes.
.\"
.\" With groff, this file is sourced by the `man' macro package itself.
.\" Man page authors who are concerned about portability might add the
.\" used macros directly to the prologue of the man page(s).
.
.
.\" Convention: Auxiliary macros and registers start with `m' followed
.\"             by an uppercase letter or digit.
.
.
.\" Declare start of command synopsis.  Sets up hanging indentation.
.de SY
.  ie !\\n(mS \{\
.    nh
.    nr mS 1
.    nr mA \\n(.j
.    ad l
.    nr mI \\n(.i
.  \}
.  el \{\
.    br
.    ns
.  \}
.
.  HP \w'\fB\\$1\fP\ 'u
.  B "\\$1"
..
.
.
.\" End of command synopsis.  Restores adjustment.
.de YS
.  in \\n(mIu
.  ad \\n(mA
.  hy \\n(HY
.  nr mS 0
..
.
.
.\" Declare optional option.
.de OP
.  ie \\n(.$-1 \
.    RI "[\fB\\$1\fP" "\ \\$2" "]"
.  el \
.    RB "[" "\\$1" "]"
..
.
.
.\" Start URL.
.de UR
.  ds m1 \\$1\"
.  nh
.  if \\n(mH \{\
.    \" Start diversion in a new environment.
.    do ev URL-div
.    do di URL-div
.  \}
..
.
.
.\" End URL.
.de UE
.  ie \\n(mH \{\
.    br
.    di
.    ev
.
.    \" Has there been one or more input lines for the link text?
.    ie \\n(dn \{\
.      do HTML-NS "<a href=""\\*(m1"">"
.      \" Yes, strip off final newline of diversion and emit it.
.      do chop URL-div
.      do URL-div
\c
.      do HTML-NS </a>
.    \}
.    el \
.      do HTML-NS "<a href=""\\*(m1"">\\*(m1</a>"
\&\\$*\"
.  \}
.  el \
\\*(la\\*(m1\\*(ra\\$*\"
.
.  hy \\n(HY
..
.
.
.\" Start email address.
.de MT
.  ds m1 \\$1\"
.  nh
.  if \\n(mH \{\
.    \" Start diversion in a new environment.
.    do ev URL-div
.    do di URL-div
.  \}
..
.
.
.\" End email address.
.de ME
.  ie \\n(mH \{\
.    br
.    di
.    ev
.
.    \" Has there been one or more input lines for the link text?
.    ie \\n(dn \{\
.      do HTML-NS "<a href=""mailto:\\*(m1"">"
.      \" Yes, strip off final newline of diversion and emit it.
.      do chop URL-div
.      do URL-div
\c
.      do HTML-NS </a>
.    \}
.    el \
.      do HTML-NS "<a href=""mailto:\\*(m1"">\\*(m1</a>"
\&\\$*\"
.  \}
.  el \
\\*(la\\*(m1\\*(ra\\$*\"
.
.  hy \\n(HY
..
.
.
.\" Continuation line for .TP header.
.de TQ
.  br
.  ns
.  TP \\$1\" no doublequotes around argument!
..
.
.
.\" Start example.
.de EX
.  nr mE \\n(.f
.  nf
.  nh
.  ft CR
..
.
.
.\" End example.
.de EE
.  ft \\n(mE
.  fi
.  hy \\n(HY
..
.
.\" EOF
.\" ----------------------------------------------------------------------
.TH ovs\-dpctl 8 "4.0.0" "Open vSwitch" "Open vSwitch Manual"
.ds PN ovs\-dpctl
.
.SH "نام (NAME)"
ovs\-dpctl \- مدیریت مسیرهای داده Open vSwitch
.
.SH "خلاصه دستور (SYNOPSIS)"
.B ovs\-dpctl
[\fIگزینه‌ها\fR] \fIدستور \fR[\fIسوئیچ\fR] [\fIآرگومان‌ها\fR\&...]
.
.SH "توضیحات (DESCRIPTION)"
.PP
برنامه
.B ovs\-dpctl
می‌تواند مسیرهای داده (datapath) متعلق به Open vSwitch را ایجاد، ویرایش و حذف کند. یک ماشین واحد می‌تواند میزبان هر تعداد مسیر داده باشد.
.PP
این برنامه تنها با مسیرهای داده‌ای کار می‌کند که خارج از خود
.B ovs\-vswitchd
پیاده‌سازی شده‌اند، مانند مسیر داده هسته لینوکس. برای مدیریت مسیرهای داده‌ای که با
.B ovs\-vswitchd
یکپارچه شده‌اند، مانند مسیر داده فضای کاربری (\fBnetdev\fR)، از
.BR ovs\-appctl (8)
برای فراخوانی دستورات
.B dpctl/*
استفاده کنید که در
.BR ovs\-vswitchd (8)
مستند شده‌اند.
.PP
یک مسیر داده تازه‌ساخته‌شده تنها با یک دستگاه شبکه مرتبط است؛ یک دستگاه شبکه مجازی که گاهی «درگاه محلی» (local port) مسیر داده نامیده می‌شود. با این حال، یک مسیر داده تازه‌ساخته‌شده با هیچ‌یک از دیگر دستگاه‌های شبکه میزبان مرتبط نیست. برای رهگیری و پردازش ترافیک در یک دستگاه شبکه معین، از دستور
.B add\-if
استفاده کنید تا آن دستگاه شبکه را به‌صراحت به مسیر داده اضافه نمایید.
.PP
اگر
.BR ovs\-vswitchd (8)
در حال استفاده است، به‌جای
.B ovs\-dpctl
از
.BR ovs\-vsctl (8)
استفاده کنید.
.PP
بیشتر دستورات
.B ovs\-dpctl
که با مسیرهای داده کار می‌کنند، آرگومانی می‌گیرند که نام مسیر داده را مشخص می‌کند. نام‌های مسیر داده به شکل
[\fItype\fB@\fR]\fIname\fR
هستند که در آن
.I name
دستگاه شبکه مرتبط با درگاه محلی مسیر داده است. اگر
.I type
مشخص شده باشد، ارائه‌دهنده مسیر داده
.I name
را تعیین می‌کند؛ در غیر این صورت، ارائه‌دهنده پیش‌فرض
.B system
در نظر گرفته می‌شود.
.PP
دستورات زیر مسیرهای داده را مدیریت می‌کنند.
.
.ds DX
.de DO
\\$1 \\$2 \\$3
..
اگر
.B ovs\-vswitchd
در حال اجراست، از دستورات افزودن، حذف یا تغییر مسیرهای داده استفاده نکنید؛ زیرا این کار با مدیریت اختصاصی مسیر داده توسط
.B ovs\-vswitchd
تداخل پیدا می‌کند.
.TP
\*(DX\fBadd\-dp \fIdp\fR [\fInetdev\fR[\fB,\fIoption\fR]...]
مسیر داده
.I dp
را ایجاد می‌کند، همراه با یک درگاه محلی که آن نیز
.I dp
نامیده می‌شود. اگر دستگاه شبکه‌ای با نام
.I dp
از قبل وجود داشته باشد، این دستور با شکست مواجه می‌شود.
.IP
اگر
.I netdev
ها مشخص شده باشند،
.B \*(PN
آن‌ها را به مسیر داده جدید اضافه می‌کند، درست مانند اینکه
.B add\-if
مشخص شده باشد.
.
.TP
\*(DX\fBdel\-dp \fIdp\fR
مسیر داده
.I dp
را حذف می‌کند. اگر
.I dp
با هر دستگاه شبکه‌ای مرتبط باشد، آن‌ها به‌طور خودکار حذف می‌شوند.
.
.TP
\*(DX\fBadd\-if \fIdp netdev\fR[\fB,\fIoption\fR]...
هر
.I netdev
را به مجموعه دستگاه‌های شبکه‌ای که مسیر داده
.I dp
نظارت می‌کند اضافه می‌نماید، که در آن
.I dp
نام یک مسیر داده موجود، و
.I netdev
نام یکی از دستگاه‌های شبکه میزبان (مانند \fBeth0\fR) است. پس از افزودن دستگاه شبکه به مسیر داده، مسیر داده مالکیت کامل ترافیک آن دستگاه شبکه را در دست می‌گیرد و دستگاه شبکه برای سایر بخش‌های سیستم خاموش و بدون ترافیک به نظر می‌رسد.
.IP
یک
.I netdev
می‌تواند با فهرستی از گزینه‌ها که با کاما از هم جدا شده‌اند دنبال شود. گزینه‌های زیر در حال حاضر پشتیبانی می‌شوند:
.
.RS
.IP "\fBtype=\fItype\fR"
نوع درگاه برای افزودن را مشخص می‌کند. نوع پیش‌فرض \fBsystem\fR است.
.IP "\fBport_no=\fIport\fR"
یک شماره درگاه خاص در مسیر داده را درخواست می‌کند. اگر این گزینه مشخص نشود، شماره‌ای به‌طور خودکار اختصاص می‌یابد.
.IP "\fIkey\fB=\fIvalue\fR"
یک گزینه کلید-مقدار دلخواه به پیکربندی درگاه اضافه می‌کند.
.RE
.IP
صفحه راهنمای
.BR ovs\-vswitchd.conf.db (5)
انواع درگاه‌ها و گزینه‌های موجود را مستند کرده است.
.
.IP "\*(DX\fBset\-if \fIdp port\fR[\fB,\fIoption\fR]..."
هر
.I port
در
.I dp
را طبق موارد مشخص‌شده مجدداً پیکربندی می‌کند. گزینه‌ای به فرم
\fIkey\fB=\fIvalue\fR
گزینه کلید-مقدار مشخص‌شده را به درگاه اضافه کرده یا مقدار کلید موجود را بازنویسی می‌کند. گزینه‌ای به فرم
\fIkey\fB=\fR
(یعنی بدون مقدار)، کلید-مقدار با نام
.I key
را حذف می‌کند. نوع و شماره یک درگاه قابل تغییر نیستند، بنابراین
.B type
و
.B port_no
تنها در صورتی مجاز هستند که با پیکربندی موجود مطابقت داشته باشند.
.TP
\*(DX\fBdel\-if \fIdp netdev\fR...
هر
.I netdev
را از فهرست دستگاه‌های شبکه‌ای که مسیر داده
.I dp
نظارت می‌کند حذف می‌نماید.
.
.TP
\*(DX\fBdump\-dps\fR
نام هر مسیر داده پیکربندی‌شده را در یک خط جداگانه چاپ می‌کند.
.
.TP
.DO "[\fB\-s\fR | \fB\-\-statistics\fR]" "\*(DX\fBshow" "\fR[\fIdp\fR...]"
خلاصه‌ای از مسیرهای داده پیکربندی‌شده، شامل شماره‌های مسیر داده آن‌ها و فهرستی از درگاه‌های متصل به هر مسیر داده را چاپ می‌کند (درگاه محلی با شماره ۰ مشخص می‌شود). اگر
.B \-s
یا
.B \-\-statistics
مشخص شده باشد، شمارنده‌های بسته و بایت نیز برای هر درگاه چاپ می‌شوند.
.IP
شماره‌های مسیر داده شامل آمار جریان و آمار ماسک مگاجریان است.
.IP
سطر "lookups" سه آمار مرتبط با جستجوی جریان را که بر اثر پردازش بسته‌های ورودی در مسیر داده ایجاد می‌شود نمایش می‌دهد. "hit" تعداد بسته‌های منطبق با جریان‌های موجود را نمایش می‌دهد. "missed" تعداد بسته‌هایی را نمایش می‌دهد که با هیچ جریان موجودی تطبیق نداشته و نیازمند پردازش در فضای کاربری هستند. "lost" تعداد بسته‌های مقصد پردازش در فضای کاربری را نشان می‌دهد که پس از آن پیش از رسیدن به فضای کاربری دور ریخته (drop) شده‌اند. مجموع "hit" و "miss" برابر با کل تعداد بسته‌های پردازش‌شده توسط مسیر داده است.
.IP
سطر "flows" تعداد جریان‌های موجود در مسیر داده را نمایش می‌دهد.
.IP
سطر "masks" آمار ماسک مگاجریان را نمایش می‌دهد. این سطر برای مسیرهای داده‌ای که مگاجریان را پیاده‌سازی نکرده‌اند حذف می‌شود. "hit" تعداد کل ماسک‌های بررسی‌شده برای تطبیق با بسته‌های ورودی را نشان می‌دهد. "total" تعداد ماسک‌های موجود در مسیر داده را نشان می‌دهد. "hit/pkt" میانگین تعداد ماسک‌های بررسی‌شده به ازای هر بسته را نشان می‌دهد؛ یعنی نسبت میان "hit" و کل تعداد بسته‌های پردازش‌شده توسط مسیر داده.
.IP
اگر یک یا چند مسیر داده مشخص شده باشند، اطلاعات تنها مربوط به همان مسیرهای داده نمایش داده می‌شود. در غیر این صورت،
.B \*(PN
اطلاعات مربوط به تمام مسیرهای داده پیکربندی‌شده را نمایش می‌دهد.
.SS "دستورات اشکال‌زدایی جدول جریان مسیر داده (DATAPATH FLOW TABLE DEBUGGING COMMANDS)"
دستورات زیر در درجه اول برای اشکال‌زدایی Open vSwitch مفید هستند. مدخل‌های جدول جریان (هم تطبیق‌ها و هم کنش‌ها) که این دستورات با آن‌ها کار می‌کنند، مدخل‌های جریان OpenFlow نیستند. در عوض، آن‌ها جریان‌هایی متفاوت و به‌مراتب ساده‌تر هستند که توسط ماژول هسته Open vSwitch نگهداری می‌شوند. اگر
.B ovs\-vswitchd
در حال اجرا است، از دستورات افزودن، حذف یا ویرایش جریان‌های مسیر داده استفاده نکنید، زیرا این کار با مدیریت اختصاصی جریان مسیر داده در
.B ovs\-vswitchd
تداخل پیدا می‌کند. در عوض، برای کار با مدخل‌های جریان OpenFlow از
.BR ovs\-ofctl (8)
استفاده کنید.
.
.PP
آرگومان
.I dp
برای هر یک از این دستورات در صورتی که دقیقاً یک مسیر داده وجود داشته باشد اختیاری است؛ در این صورت آن مسیر داده پیش‌فرض خواهد بود. هنگامی که چندین مسیر داده وجود داشته باشند، ذکر نام مسیر داده الزامی است.
.
.TP
.DO "[\fB\-m \fR| \fB\-\-more\fR] [\fB\-\-names \fR| \fB\-\-no\-names\fR]" \*(DX\fBdump\-flows\fR "[\fIdp\fR] [\fBfilter=\fIfilter\fR] [\fBtype=\fItype\fR] [\fBpmd=\fIpmd\fR]"
تمام مدخل‌های جریان در جدول جریان مسیر داده
.I dp
را در کنسول چاپ می‌کند. بدون
.B \-m
یا
.BR \-\-more ،
خروجی فیلدهای تطبیقی را که یک جریان به‌طور کامل با نویسه عام (wildcard) مطابقت می‌دهد حذف می‌کند؛ همراه با
.B \-m
یا
.BR \-\-more ،
خروجی شامل تمام فیلدهای دارای نویسه عام می‌شود.
.IP
اگر
\fBfilter=\fIfilter\fR
مشخص شده باشد، تنها جریان‌هایی را نمایش می‌دهد که با
.I filter
مطابقت دارند.
.I filter
جریانی به فرم مشابه قالب پذیرفته‌شده توسط دستور
.B add\-flow
در
.BR ovs\-ofctl (8)
است (این یک جریان OpenFlow نیست: علاوه بر سایر تفاوت‌ها، هرگز حاوی نویسه‌های عام نیست).
.I filter
همچنین برای تطبیق با فیلدهای عام در جریان مسیر داده مفید است. به عنوان مثال،
\fBfilter='tcp,tp_src=100'\fR
با جریان مسیر داده شامل
'\fBtcp(src=80/0xff00,dst=8080/0xff)\fR'
مطابقت خواهد داشت.
.IP
اگر
\fBpmd=\fIpmd\fR
مشخص شده باشد، تنها جریان‌های مربوط به pmd مشخص‌شده را نمایش می‌دهد. استفاده از
\fBpmd=\fI-1\fR
خروجی را به جریان‌های رشته (thread) اصلی محدود می‌کند. این گزینه تنها توسط
\fBمسیر داده فضای کاربری (userspace datapath)\fR
پشتیبانی می‌شود.
.IP
اگر
\fBtype=\fItype\fR
مشخص شده باشد، تنها جریان‌هایی از انواع مشخص‌شده را نمایش می‌دهد. این گزینه تنها برای
\fBovs\-appctl dpctl/dump\-flows\fR
پشتیبانی می‌شود.
.I type
فهرستی جداشده با کاما است که می‌تواند شامل هر یک از موارد زیر باشد:
.
   \fBovs\fR \- جریان‌های مدیریت‌شده در مسیر داده ovs را نمایش می‌دهد
   \fBtc\fR \- جریان‌های مدیریت‌شده در مسیر داده tc را نمایش می‌دهد
   \fBdpdk\fR \- جریان‌هایی را که کاملاً توسط dpdk باربرداری شده‌اند نمایش می‌دهد
   \fBoffloaded\fR \- جریان‌های باربرداری‌شده به سخت‌افزار را نمایش می‌دهد
   \fBnon-offloaded\fR \- جریان‌هایی را که به سخت‌افزار باربرداری نشده‌اند نمایش می‌دهد
   \fBpartially-offloaded\fR \- جریان‌هایی را که تنها بخشی از پردازش آن‌ها در سخت‌افزار انجام می‌شود نمایش می‌دهد
   \fBall\fR \- تمام انواع جریان‌ها را نمایش می‌دهد
.IP
به‌طور پیش‌فرض تمام انواع جریان‌ها نمایش داده می‌شوند.
.B ovs\-dpctl
همواره طوری عمل می‌کند که گویی
.I type
برابر با
.B ovs
بوده است.
.
.IP "\*(DX\fBadd\-flow\fR [\fIdp\fR] \fIflow actions\fR"
.TP
.DO "[\fB\-\-clear\fR] [\fB\-\-may-create\fR] [\fB\-s\fR | \fB\-\-statistics\fR]" "\*(DX\fBmod\-flow\fR" "[\fIdp\fR] \fIflow actions\fR"
جریانی را به جدول جریان
.I dp
اضافه کرده یا تغییر می‌دهد به‌طوری که هنگام رسیدن بسته‌ای منطبق با
.IR flow ،
کنش‌های
.I actions
اجرا شوند.
.IP
دستور
.B add\-flow
تنها در صورتی موفق می‌شود که
.I flow
از قبل در
.I dp
وجود نداشته باشد. در مقابل،
.B mod\-flow
بدون
.B \-\-may\-create
تنها کنش‌های یک جریان موجود را تغییر می‌دهد. با
.BR \-\-may\-create ،
دستور
.B mod\-flow
جریان جدیدی اضافه می‌کند یا جریان موجود را تغییر می‌دهد.
.IP
اگر
.B \-s
یا
.B \-\-statistics
مشخص شده باشد،
.B mod\-flow
آمار جریان تغییریافته را چاپ می‌کند. آمار یک جریان شامل تعداد بسته‌ها و بایت‌هایی است که از جریان عبور کرده‌اند، زمان سپری‌شده از آخرین باری که جریان بسته‌ای را پردازش کرده است (در صورت وجود)، و (برای جریان‌های TCP) اجتماع پرچم‌های TCP پردازش‌شده از طریق آن جریان.
.IP
همراه با
.BR \-\-clear ،
دستور
.B mod\-flow
آمار جریان را صفر می‌کند. آماری که در صورت مشخص بودن
.B \-s
یا
.B \-\-statistics
چاپ می‌شود، آماری است که دقیقاً پیش از پاک کردن آمار ثبت شده است.
.IP
یادداشت:
.I flow
و
.I actions
با قواعد نگارشی مورداستفاده در دستور
.B add\-flow
متعلق به
.BR ovs\-ofctl (8)
تطبیق ندارند.
.
.IP
\fBمثال‌های کاربردی (Usage Examples)\fR
.
.RS
.PP
هدایت ARP بین درگاه‌های ۱ و ۲ در مسیر داده myDP:
.IP
ovs-dpctl add-flow myDP \\
.
  "in_port(1),eth(),eth_type(0x0806),arp()" 2
.
.IP
ovs-dpctl add-flow myDP \\
.
  "in_port(2),eth(),eth_type(0x0806),arp()" 1
.
.PP
هدایت تمام ترافیک IPv4 بین دو نشانی در درگاه‌های ۱ و ۲:
.
.IP
ovs-dpctl add-flow myDP \\
.
  "in_port(1),eth(),eth_type(0x800),\\
   ipv4(src=172.31.110.4,dst=172.31.110.5)" 2
.
.IP
ovs-dpctl add-flow myDP \\
.
  "in_port(2),eth(),eth_type(0x800),\\
   ipv4(src=172.31.110.5,dst=172.31.110.4)" 1
.
.RE
.TP
\*(DX\fBadd\-flows\fR [\fIdp\fR] \fIfile\fR
.TQ
\*(DX\fBmod\-flows\fR [\fIdp\fR] \fIfile\fR
.TQ
\*(DX\fBdel\-flows\fR [\fIdp\fR] \fIfile\fR
مدخل‌های جریان را از
.I file
(یا
.B stdin
اگر
.I file
برابر با
.B \-
باشد) می‌خواند و هر مدخل را به مسیر داده اضافه کرده، تغییر داده یا حذف می‌کند.
.
هر مشخصه جریان (برای مثال هر خط در
\fIfile\fR)
می‌تواند با کلمه کلیدی
.BR add ،
.B modify
یا
.B delete
آغاز شود تا مشخص کند آیا یک جریان باید اضافه، ویرایش یا حذف گردد. مشخصه جریانی بدون یکی از این کلمات کلیدی، بر اساس دستور مورداستفاده پردازش می‌شود. تمام تغییرات جریان به‌صورت تراکنش‌های مجزا و به ترتیب مشخص‌شده اجرا می‌شوند.
.
.TP
.DO "[\fB\-s\fR | \fB\-\-statistics\fR]" "\*(DX\fBdel\-flow\fR" "[\fIdp\fR] \fIflow\fR"
جریانی را از جدول جریان
.I dp
که با
.I flow
مطابقت دارد حذف می‌کند. اگر
.B \-s
یا
.B \-\-statistics
مشخص شده باشد،
.B del\-flow
آمار جریان حذف‌شده را چاپ می‌کند.
.
.TP
.DO "[\fB\-m \fR| \fB\-\-more\fR] [\fB\-\-names \fR| \fB\-\-no\-names\fR]" "\*(DX\fBget\-flow\fR [\fIdp\fR] ufid:\fIufid\fR"
جریان با شناسه یکتای
.I ufid
را از جدول جریان
.I dp
واکشی می‌کند.
.I ufid
باید به‌صورت رشته‌ای از ۳۲ نویسه هگزادسیمال مشخص شود.
.
.IP "\*(DX\fBdel\-flows\fR [\fIdp\fR]"
تمام مدخل‌های جریان را از جدول جریان مسیر داده
.I dp
حذف می‌کند.
.SS "دستورات حافظه پنهان جریان مسیر داده (DATAPATH FLOW CACHE COMMANDS)"
دستورات زیر برای اشکال‌زدایی و پیکربندی تنظیمات حافظه پنهان (کَش) جریان مسیر داده مفید هستند.
.
.TP
\*(DX\fBcache\-get\-size\fR [\fIdp\fR]
اندازه‌های فعلی حافظه پنهان را در کنسول چاپ می‌کند.
.
.TP
\*(DX\fBcache\-set\-size\fR \fIdp\fR \fIcache\fR \fIsize\fR
حافظه پنهان
.I cache
مشخص‌شده در
.I dp
را روی اندازه داده‌شده
.I size
تنظیم می‌کند. نام حافظه پنهان را می‌توان با استفاده از دستور
.B cache\-get\-size
یافت.
.
.SS "دستورات جدول ردیابی اتصال (CONNECTION TRACKING TABLE COMMANDS)"
دستورات زیر برای اشکال‌زدایی و پیکربندی جدول ردیابی اتصال (connection tracking) در مسیر داده مفید هستند.
.
.PP
آرگومان
.I dp
برای هر یک از این دستورات در صورتی که دقیقاً یک مسیر داده وجود داشته باشد اختیاری است؛ در این صورت همان مسیر داده پیش‌فرض خواهد بود. هنگامی که چندین مسیر داده وجود دارند، ذکر نام مسیر داده الزامی است.
.
.PP
\fBتوجه\fR (مختص لینوکس): مسیرهای داده
.I system
(یعنی مسیرهای داده ماژول هسته لینوکس Open vSwitch) در یک جدول ردیابی اتصال واحد مشترک هستند (که توسط دیگر زیرسیستم‌های هسته، مانند iptables، nftables و پشته عادی میزبان نیز استفاده می‌شود). بنابراین، دستورات زیر به‌طور خاص برای یک مسیر داده اعمال نمی‌شوند.
.
.TP
\*(DX\fBipf\-set\-enabled\fR [\fIdp\fR] \fBv4\fR|\fBv6\fR
.TQ
\*(DX\fBipf\-set\-disabled\fR [\fIdp\fR] \fBv4\fR|\fBv6\fR
مدیریت قطعه‌بندی IP را برای ردیاب اتصال فضای کاربری فعال یا غیرفعال می‌کند. باید یکی از گزینه‌های
.B v4
یا
.B v6
مشخص شود. بازترکیب قطعات هر دو نسخه IPv4 و IPv6 به‌طور پیش‌فرض فعال است. تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
\*(DX\fBipf\-set\-min\-frag\fR [\fIdp\fR] \fBv4\fR|\fBv6\fR \fIminfrag\fR
حداقل اندازه قطعه (سرایند L3 و داده) را برای قطعات غیرنهایی روی
.I minfrag
تنظیم می‌کند. باید یکی از گزینه‌های
.B v4
یا
.B v6
مشخص شود. برای امنیت بیشتر در برابر حملات DoS، معمولاً می‌توان از حداقل اندازه‌های قطعه بزرگ‌تر استفاده کرد. مقدار پیش‌فرض IPv4 برابر با ۱۲۰۰ و حداقل مقیدشده آن ۴۰۰ است. مقدار پیش‌فرض IPv6 برابر با ۱۲۸۰، با حداقل مقیدشده ۴۰۰ برای انعطاف‌پذیری در آزمایش است. حداکثر اندازه قطعه مقید نشده است، اما تنظیم بیش از حد بالای این مقدار ممکن است به دور ریخته شدن قطعات معتبر بیانجامد. تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
\*(DX\fBipf\-set\-max\-nfrags\fR [\fIdp\fR] \fImaxfrags\fR
حداکثر تعداد قطعات ردیابی‌شده توسط ردیاب اتصال مسیر داده در فضای کاربری را روی
.I maxfrags
تنظیم می‌کند. مقدار پیش‌فرض ۱۰۰۰ و حداکثر مقیدشده ۵۰۰۰ است. توجه داشته باشید که بافرهای بسته می‌توانند تا زمانی که قطعات ناقص هستند توسط ماژول قطعه‌بندی نگه‌داشته شوند، اما پس از ۱۵ ثانیه مهلت زمانی آن‌ها تمام می‌شود. هنگام فعال بودن قطعه‌بندی، اندازه مخزن حافظه باید متناسب با آن تنظیم گردد. تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
.DO "[\fB\-m\fR | \fB\-\-more\fR]" "\*(DX\fBipf\-get\-status\fR [\fIdp\fR]"
تنظیمات پیکربندی و شمارنده‌های قطعه مرتبط با مدیریت قطعه‌بندی ردیاب اتصال مسیر داده در فضای کاربری را دریافت می‌کند. همراه با
.B \-m
یا
.BR \-\-more ،
فهرست‌های قطعات IP را نیز تخلیه می‌کند. تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
.DO "[\fB\-m\fR | \fB\-\-more\fR] [\fB\-s\fR | \fB\-\-statistics\fR]" "\*(DX\fBdump\-conntrack\fR" "[\fIdp\fR] [\fBzone=\fIzone\fR]"
تمام مدخل‌های اتصال را در ردیاب مورداستفاده توسط
.I dp
در کنسول چاپ می‌کند. اگر
\fBzone=\fIzone\fR
مشخص شده باشد، تنها اتصالات موجود در
.I zone
را نشان می‌دهد. همراه با
.BR \-\-more ،
برخی جزئیات مختص پیاده‌سازی نیز گنجانده می‌شوند. با
.BR \-\-statistics ،
مهلت‌های زمانی و برچسب‌های زمانی به خروجی افزوده می‌شوند.
.
.TP
\*(DX\fBdump\-conntrack\-exp\fR [\fIdp\fR] [\fBzone=\fIzone\fR]
تمام مدخل‌های انتظار را در ردیاب مورداستفاده توسط
.I dp
در کنسول چاپ می‌کند. اگر
\fBzone=\fIzone\fR
مشخص شده باشد، تنها انتظارات موجود در
.I zone
را نمایش می‌دهد. تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
\*(DX\fBflush\-conntrack\fR [\fIdp\fR] [\fBzone=\fIzone\fR] [\fIct-origin-tuple\fR [\fIct-reply-tuple\fR]]
مدخل‌های اتصال را در ردیاب مورداستفاده توسط
.I dp
بر اساس
.I zone
و تاپل ردیابی اتصال
.I ct-origin-tuple
پاکسازی می‌کند. اگر
.I ct-tuple
ارائه نشود، تمام مدخل‌های اتصال را پاکسازی می‌کند. اگر
\fBzone\fR=\fIzone\fR
مشخص شده باشد، تنها اتصالات موجود در
.I zone
را پاک می‌کند.
.IP
اگر
.I ct-[orig|reply]-tuple
ارائه شده باشد، مدخل اتصال مشخص‌شده توسط
.I ct-[orig|reply]-tuple
را در
.I zone
پاکسازی می‌کند. ناحیه در صورت مشخص نشدن به‌طور پیش‌فرض ۰ در نظر گرفته می‌شود. ردیاب اتصال در فضای کاربری نیازمند پاکسازی با تاپل اصلی پیش از اعمال NAT است و در غیر این صورت یک پیام هشدار در گزارش‌ها ثبت خواهد شد. تاپل می‌تواند جزئی باشد و تمام اتصالاتی را که با فیلدهای مشخص‌شده تطبیق دارند حذف می‌کند. به منظور مشخص کردن تنها
.IR ct-reply-tuple ،
یک رشته خالی به عنوان
.I ct-origin-tuple
ارائه دهید.
.IP
نکته: در حال حاضر برای تطبیق روی ICMP محدودیتی وجود دارد؛ برای تطبیق جزئی روی پارامترهای ICMP، تاپل
.I ct-[orig|reply]-tuple
باید شامل IP مبدأ یا مقصد باشد.
.IP
مثالی از یک تاپل
.I ct-[orig|reply]-tuple
مربوط به IPv4 ICMP:
.IP
"ct_nw_src=10.1.1.1,ct_nw_dst=10.1.1.2,ct_nw_proto=1,icmp_type=8,icmp_code=0,icmp_id=10"
.IP
مثالی از یک تاپل
.I ct-[orig|reply]-tuple
مربوط به IPv6 TCP:
.IP
"ct_ipv6_src=fc00::1,ct_ipv6_dst=fc00::2,ct_nw_proto=6,ct_tp_src=1,ct_tp_dst=2"
.
.TP
.DO "[\fB\-m\fR | \fB\-\-more\fR]" "\*(DX\fBct\-stats\-show\fR [\fIdp\fR] [\fBzone=\fIzone\fR]"
تعداد اتصالات گروه‌بندی‌شده بر اساس پروتکل مورداستفاده توسط
.I dp
را نمایش می‌دهد. اگر
\fBzone=\fIzone\fR
مشخص شده باشد، اعداد به اتصالات موجود در
.I zone
اشاره دارند. همراه با
.BR \-\-more ،
بر اساس وضعیت اتصال برای هر پروتکل گروه‌بندی انجام می‌دهد.
.
.TP
\*(DX\fBct\-bkts\fR [\fIdp\fR] [\fBgt=\fIthreshold\fR]
به ازای هر سطل conntrack، تعداد اتصالات مورداستفاده توسط
.I dp
را نمایش می‌دهد. اگر
\fBgt=\fIthreshold\fR
مشخص شده باشد، شماره سطل‌ها زمانی نمایش داده می‌شوند که تعداد اتصالات در یک سطل بیشتر از
.I threshold
باشد.
.
.TP
\*(DX\fBct\-set\-maxconns\fR [\fIdp\fR] \fImaxconns\fR
سقف حداکثر مدخل‌های ردیاب اتصال را روی
.I dp
برابر با
.I maxconns
تنظیم می‌کند. این دستور می‌تواند برای کاهش بار پردازشی ناشی از ردیابی اتصال روی سیستم یا صرفاً محدود کردن ردیابی اتصال استفاده شود. اگر تعداد اتصالات در حال حاضر بیش از سقف حداکثر جدید درخواستی باشد، سقف جدید زمانی اعمال خواهد شد که تعداد اتصالات به آن سقف کاهش یابد (که معمولاً به دلیل انقضای اتصالات رخ می‌دهد). تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
\*(DX\fBct\-get\-maxconns\fR [\fIdp\fR]
سقف حداکثر مدخل‌های ردیاب اتصال را در
.I dp
چاپ می‌کند. تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
\*(DX\fBct\-get\-nconns\fR [\fIdp\fR]
تعداد فعلی مدخل‌های ردیاب اتصال را در
.I dp
چاپ می‌کند. تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
\*(DX\fBct\-enable\-tcp\-seq\-chk\fR [\fIdp\fR]
.TQ
\*(DX\fBct\-disable\-tcp\-seq\-chk\fR [\fIdp\fR]
بررسی شماره توالی TCP را فعال یا غیرفعال می‌کند. هنگامی که روی غیرفعال تنظیم شود، تمام اعتبارسنجی‌های شماره توالی، از جمله برای بازنشانی‌های TCP، غیرفعال می‌گردد. این حالت مشابه با حالت 'be_liberal' در Netfilter است، اما دقیقاً یکسان نیست. غیرفعال کردن اعتبارسنجی شماره توالی فی‌نفسه یک بهینه‌سازی نیست، اما برای پشتیبانی از برخی قابلیت‌های باربرداری سخت‌افزاری که ممکن است مزایای عملکردی ارائه دهند لازم است. بررسی شماره توالی به‌طور پیش‌فرض برای برقراری امنیت بهتر فعال است و تنها در صورتی باید غیرفعال شود که برای پشتیبانی از باربرداری سخت‌افزاری مورد نیاز باشد. این دستور تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
\*(DX\fBct\-get\-tcp\-seq\-chk\fR [\fIdp\fR]
فعال یا غیرفعال بودن بررسی شماره توالی TCP را در
.I dp
چاپ می‌کند. تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
\*(DX\fBct\-set\-sweep\-interval\fR [\fIdp\fR] \fIms\fR
بازه زمانی پاکسازی (sweep interval) را تنظیم می‌کند. تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
\*(DX\fBct\-get\-sweep\-interval\fR [\fIdp\fR]
بازه زمانی پاکسازی فعلی را بر حسب میلی‌ثانیه چاپ می‌کند. تنها برای مسیر داده فضای کاربری پشتیبانی می‌شود.
.
.TP
\*(DX\fBct\-set\-limits\fR [\fIdp\fR] [\fBdefault=\fIdefault_limit\fR] [\fBzone=\fIzone\fR,\fBlimit=\fIlimit\fR]...
حداکثر تعداد مجاز اتصالات را در یک ناحیه ردیابی اتصال تعیین می‌کند. یک
.I zone
خاص می‌تواند روی
.I limit
تنظیم شود، و چند ناحیه می‌توانند با فهرستی جداشده با کاما مشخص گردند. اگر سقف هر ناحیه برای یک ناحیه خاص در مسیر داده مشخص نشده باشد، سقف پیش‌فرض به ازای هر ناحیه در نظر گرفته می‌شود. یک ناحیه پیش‌فرض را می‌توان با آرگومان
\fBdefault=\fIdefault_limit\fR
مشخص کرد. در ابتدا، سقف پیش‌فرض به ازای هر ناحیه نامحدود است. تعداد نامحدودی از مدخل‌ها را می‌توان با سقف
.B 0
تنظیم نمود.
.
.TP
\*(DX\fBct\-del\-limits\fR [\fIdp\fR] \fBzone=\fIzone[,zone]\fR...
سقف ردیابی اتصال را برای
.I zone
حذف می‌کند. چندین ناحیه را می‌توان با فهرستی جداشده با کاما مشخص کرد.
.
.TP
\*(DX\fBct\-get\-limits\fR [\fIdp\fR] [\fBzone=\fIzone\fR[\fB,\fIzone\fR]...]
حداکثر تعداد مجاز اتصالات و تعداد فعلی را به ازای هر ناحیه دریافت می‌کند. اگر
.I zone
داده شود، تنها ناحیه(های) مشخص‌شده چاپ می‌شوند. اگر هیچ ناحیه‌ای مشخص نشود، تمام سقف‌ها و شمارش‌های نواحی ارائه می‌گردند. این دستور همواره سقف ناحیه پیش‌فرض را نمایش می‌دهد.
.
.SH "گزینه‌ها (OPTIONS)"
.IP "\fB\-t\fR"
.IQ "\fB\-\-timeout=\fIsecs\fR"
زمان اجرای
.B ovs\-dpctl
را به تقریباً
.I secs
ثانیه محدود می‌کند. اگر مهلت زمانی منقضی شود،
.B ovs\-dpctl
با سیگنال
.B SIGALRM
خارج می‌شود.
.
.IP "\fB\-v\fR[\fIspec\fR]
.IQ "\fB\-\-verbose=\fR[\fIspec\fR]
.
سطوح گزارش‌گیری (logging) را تنظیم می‌کند. بدون هیچ
.IR spec ،
سطح گزارش‌گیری برای هر ماژول و مقصد روی
.B dbg
تنظیم می‌شود. در غیر این صورت،
.I spec
فهرستی از کلمات جداشده با فاصله، کاما یا دونقطه است که حداکثر یک مورد از هر یک از دسته‌بندی‌های زیر را شامل می‌شود:
.
.RS
.IP \(bu
یک نام ماژول معتبر، همان‌طور که توسط دستور
.B vlog/list
در
.BR ovs\-appctl (8)
نمایش داده می‌شود، تغییر سطح گزارش‌گیری را به ماژول مشخص‌شده محدود می‌کند.
.
.IP \(bu
یکی از موارد
.BR syslog ،
.B console
یا
.BR file ،
به ترتیب برای محدود کردن تغییر سطح گزارش‌گیری تنها به گزارش سیستم، کنسول یا یک فایل. (اگر
.B \-\-detach
مشخص شده باشد،
.B \*(PN
توصیف‌کننده‌های فایل استاندارد خود را می‌بندد، بنابراین ثبت گزارش در کنسول بی‌اثر خواهد بود).
.
.IP \(bu
یکی از موارد
.BR off ،
.BR emer ،
.BR err ،
.BR warn ،
.B info
یا
.BR dbg ،
برای کنترل سطح گزارش‌گیری. پیام‌های با سطح اهمیت مشخص‌شده یا بالاتر ثبت خواهند شد و پیام‌های با اهمیت کمتر فیلتر می‌شوند.
.B off
تمام پیام‌ها را فیلتر می‌کند. برای تعریف هر سطح گزارش‌گیری به
.BR ovs\-appctl (8)
مراجعه کنید.
.RE
.
.IP
بزرگی و کوچکی حروف در
.I spec
اهمیتی ندارد.
.IP
صرف‌نظر از سطوح گزارش‌گیری تنظیم‌شده برای
.BR file ،
ثبت گزارش در یک فایل انجام نخواهد شد مگر اینکه
.B \-\-log\-file
نیز مشخص شده باشد (به بخش زیر مراجعه کنید).
.IP
برای سازگاری با نسخه‌های قدیمی‌تر OVS، عبارت
.B any
به عنوان یک کلمه پذیرفته می‌شود اما هیچ اثری ندارد.
.
.IP "\fB\-v\fR"
.IQ "\fB\-\-verbose\fR"
حداکثر سطح پرحرفی (verbosity) گزارش‌گیری را تنظیم می‌کند که معادل
\fB\-\-verbose=dbg\fR
است.
.
.IP "\fB\-vPATTERN:\fIdestination\fB:\fIpattern\fR"
.IQ "\fB\-\-verbose=PATTERN:\fIdestination\fB:\fIpattern\fR"
الگوی گزارش را برای
.I destination
روی
.I pattern
تنظیم می‌کند. برای توضیحات ساختار نحوی معتبر برای
.I pattern
به
.BR ovs\-appctl (8)
مراجعه فرمایید.
.
.IP "\fB\-vFACILITY:\fIfacility\fR"
.IQ "\fB\-\-verbose=FACILITY:\fIfacility\fR"
تسهیلات (facility) طبق RFC5424 پیام گزارش را تعیین می‌کند.
.I facility
می‌تواند یکی از موارد
.BR kern ،
.BR user ،
.BR mail ،
.BR daemon ،
.BR auth ،
.BR syslog ،
.BR lpr ،
.BR news ،
.BR uucp ،
.BR clock ،
.BR ftp ،
.BR ntp ،
.BR audit ،
.BR alert ،
.BR clock2 ،
.BR local0 ،
.BR local1 ،
.BR local2 ،
.BR local3 ،
.BR local4 ،
.BR local5 ،
.B local6
یا
.B local7
باشد. اگر این گزینه مشخص نشود،
.B daemon
به‌عنوان پیش‌فرض برای syslog سیستم محلی استفاده می‌شود و
.B local0
هنگام ارسال پیام به مقصدی که از طریق گزینه
.B \-\-syslog\-target
ارائه شده به کار می‌رود.
.
.TP
\fB\-\-log\-file\fR[\fB=\fIfile\fR]
ثبت گزارش در یک فایل را فعال می‌کند. اگر
.I file
مشخص شود، به عنوان نام دقیق فایل گزارش استفاده می‌شود. نام پیش‌فرض فایل گزارش در صورت حذف
.I file
برابر با
\fB/var/log/openvswitch/\*(PN.log\fR
است.
.
.IP "\fB\-\-syslog\-target=\fIhost\fB:\fIport\fR"
پیام‌های syslog را علاوه بر syslog سیستم، به
.I port
پروتکل UDP در
.I host
ارسال می‌کند.
.I host
باید یک نشانی IP عددی باشد، نه یک نام میزبان.
.
.IP "\fB\-\-syslog\-method=\fImethod\fR"
تعیین می‌کند که پیام‌های syslog چگونه باید با
.I method
به دیمن syslog ارسال شوند. اشکال زیر پشتیبانی می‌شوند:
.RS
.IP \(bu
.BR libc ،
استفاده از تابع
.B syslog()
در libc. نکته منفی استفاده از این گزینه این است که libc پیش از ارسال واقعی پیام به دیمن syslog از طریق سوکت دامنه یونیکس
.BR /dev/log ،
یک پیشوند ثابت به هر پیام اضافه می‌کند.
.IP \(bu
\fBunix:\fIfile\fR\fR، استفاده مستقیم از سوکت دامنه یونیکس. با این گزینه امکان مشخص کردن قالب پیام دلخواه وجود دارد. با این حال،
.B rsyslogd 8.9
و نسخه‌های قدیمی‌تر در هر صورت از یک تابع تجزیه‌کننده سخت‌کدشده استفاده می‌کنند که استفاده از سوکت دامنه یونیکس را محدود می‌کند. اگر مایل به استفاده از قالب پیام دلخواه با نسخه‌های قدیمی‌تر
.B rsyslogd
هستید، در عوض از سوکت UDP به نشانی IP لوکال‌هاست استفاده کنید.
.IP \(bu
\fBudp:\fIip\fR:\fIport\fR\fR، استفاده از سوکت UDP. با این روش می‌توان قالب پیام دلخواه را با نسخه‌های قدیمی‌تر
.B rsyslogd
نیز به کار برد. هنگام ارسال پیام‌های syslog از طریق سوکت UDP باید احتیاط‌های بیشتری در نظر گرفته شود؛ برای مثال، دیمن syslog باید طوری پیکربندی شود که به درگاه UDP مشخص‌شده گوش دهد، قوانین تصادفی iptables ممکن است با ترافیک محلی syslog تداخل داشته باشند و برخی ملاحظات امنیتی وجود دارند که در مورد سوکت‌های UDP صدق می‌کنند اما در مورد سوکت‌های دامنه یونیکس اعمال نمی‌شوند.
.IP \(bu
.BR null ،
تمام پیام‌های ثبت‌شده در syslog را دور می‌ریزد.
.RE
.IP
مقدار پیش‌فرض از متغیر محیطی
.B OVS_SYSLOG_METHOD
گرفته می‌شود؛ اگر این متغیر تنظیم نشده باشد، مقدار پیش‌فرض
.B libc
است.
.IP "\fB\-h\fR"
.IQ "\fB\-\-help\fR"
یک پیام راهنمای مختصر را در کنسول چاپ می‌کند.
.
.IP "\fB\-V\fR"
.IQ "\fB\-\-version\fR"
اطلاعات نسخه را در کنسول چاپ می‌کند.
.
.SH "همچنین ببینید (SEE ALSO)"
.
.BR ovs\-appctl (8),
.BR ovs\-vswitchd (8)
