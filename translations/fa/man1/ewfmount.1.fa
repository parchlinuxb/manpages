.Sh "همچنین ببینید (SEE ALSO)"
.Xr ewfacquire 1 ,
.Xr ewfacquirestream 1 ,
.Xr ewfexport 1 ,
.Xr ewfinfo 1 ,
.Xr ewfrecover 1 ,
.Xr ewfverify 1
