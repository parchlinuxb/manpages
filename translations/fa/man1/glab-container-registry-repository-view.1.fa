.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-container-registry-repository-view \- View a container registry repository.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab container-registry repository view  [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Returns the container registry repository's details. Use \fB--include-tags\fR to include its
tags in the output.


.SH "گزینه‌ها (OPTIONS)"
\fB--include-tags\fP[=false]
	Include tags in the response.

.PP
\fB--include-tags-count\fP[=true]
	Include the number of tags in the response.

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression.

.PP
\fB-F\fP, \fB--output\fP="text"
	Format output as: text, json.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-h\fP, \fB--help\fP[=false]
	Show help for this command.

.PP
\fB-R\fP, \fB--repo\fP=""
	Select another repository. You can use either OWNER/REPO or GROUP/NAMESPACE/REPO. The full URL or Git URL is also accepted.


.SH "مثال (EXAMPLE)"
.EX
# View a container registry repository
glab container-registry repository view 123

# Include tag details
glab container-registry repository view 123 --include-tags
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-container-registry-repository(1)\fP
