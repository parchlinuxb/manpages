.TH "Buf" "1" "2026-07-17" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
buf-config-ls-lint-rules \- فهرست‌کردن قواعد اعتبارسنجی (lint)

.SH "خلاصه دستور (SYNOPSIS)"
\fBbuf config ls-lint-rules [flags]\fP

.SH "توضیحات (DESCRIPTION)"
فهرست‌کردن قواعد اعتبارسنجی و نگارشی (lint rules)

.SH "گزینه‌ها (OPTIONS)"
\fB--config\fP=""
	پرونده یا داده buf.yaml برای استفاده در پیکربندی. گزینه --configured-only باید تنظیم شده باشد

.PP
\fB--configured-only\fP[=false]
	فهرست‌کردن قواعدی که پیکربندی شده‌اند به جای فهرست‌کردن تمامی قواعد در دسترس

.PP
\fB--format\fP="text"
	قالب چاپ قواعد. باید یکی از [text,json] باشد

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای ls-lint-rules

.PP
\fB--include-deprecated\fP[=false]
	چاپ قواعد منسوخ‌شده نیز انجام شود. در صورت تنظیم بودن --configured-only تاثیری ندارد.

.PP
\fB--module-path\fP=""
	مسیر ماژول مشخص برای فهرست‌کردن قواعد پیکربندی‌شده آن همان‌طور که در buf.yaml مشخص شده است. اگر در buf.yaml بیش از یک ماژول تعریف شده باشد، این گزینه الزامی است. گزینه --configured-only باید فعال باشد

.PP
\fB--version\fP=""
	فهرست‌کردن تمام قواعد برای نسخه پیکربندی داده‌شده. به طور پیش‌فرض، نسخه موجود در buf.yaml در دایرکتوری جاری استفاده می‌شود، یا در غیر این صورت آخرین نسخه (در حال حاضر v2). اگر --configured-only تنظیم شده باشد نمی‌توان آن را تعیین کرد. باید یکی از [v1beta1,v1,v2] باشد

.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--debug\fP[=false]
	فعال‌سازی گزارش‌گیری اشکال‌زدایی (debug)

.PP
\fB--log-format\fP="color"
	قالب لاگ [text,color,json]

.PP
\fB--timeout\fP=0s
	مدت زمان تا پایان مهلت زمانی (timeout)، تنظیم آن روی 0 یعنی بدون محدودیت زمانی

.SH "همچنین ببینید (SEE ALSO)"
\fBbuf-config(1)\fP

