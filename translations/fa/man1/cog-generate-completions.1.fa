.ie \n(.g .ds Aq \(aq
.el .ds Aq '
.TH cog-generate-completions 1  "cog-generate-completions " 
.SH "نام (NAME)"
cog\-generate\-completions \- Generate shell completions
.SH "خلاصه دستور (SYNOPSIS)"
\fBcog\-generate\-completions\fR [\fB\-h\fR|\fB\-\-help\fR] <\fISHELL\fR> 
.SH "توضیحات (DESCRIPTION)"
Generate shell completions
.SH "گزینه‌ها (OPTIONS)"
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
<\fISHELL\fR>
Shell to generate completions for
.br

.br
[\fIpossible values: \fRbash, elvish, fish, powershell, zsh, nu]
