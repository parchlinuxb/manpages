.TH "SCRIPTREPLAY" "1" "2026-09-02" "util\-linux 2.42.3" "دستورهای کاربری"
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.ss \n[.ss] 0
.nh
.ad l
