.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-container-registry-repository-delete \- Delete a container registry repository.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab container-registry repository delete  [flags]\fP


.SH "توضیحات (DESCRIPTION)"
This action permanently deletes the repository and all images and tags
published to it.


.SH "گزینه‌ها (OPTIONS)"
\fB-y\fP, \fB--yes\fP[=false]
	Skip the confirmation prompt.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-h\fP, \fB--help\fP[=false]
	Show help for this command.

.PP
\fB-R\fP, \fB--repo\fP=""
	Select another repository. You can use either OWNER/REPO or GROUP/NAMESPACE/REPO. The full URL or Git URL is also accepted.


.SH "مثال (EXAMPLE)"
.EX
# Delete a container registry repository with a confirmation prompt
glab container-registry repository delete 123

# Skip the confirmation prompt
glab container-registry repository delete 123 --yes
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-container-registry-repository(1)\fP
