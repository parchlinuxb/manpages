.nh
.TH KUBERNETES 1 "Jan 2015" "Eric Paris" "راهنمای کاربر kubernetes"

.SH "نام (NAME)"
kubectl-exec \- اجرای یک دستور در یک کانتینر


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubectl exec\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
اجرای یک دستور در یک کانتینر.


.SH "گزینه‌ها (OPTIONS)"
\fB-c\fP, \fB--container\fP=""
	نام کانتینر. در صورت حذف، از حاشیه‌نویسی kubectl.kubernetes.io/default-container برای انتخاب کانتینر جهت اتصال استفاده می‌شود، یا اولین کانتینر موجود در پاد انتخاب خواهد شد.

.PP
\fB-f\fP, \fB--filename\fP=[]
	نام فایلی که برای اجرای دستور درون منبع استفاده می‌شود

.PP
\fB--pod-running-timeout\fP=1m0s
	مدت زمان انتظار (مانند 5s، 2m یا 3h، بیشتر از صفر) تا زمانی که حداقل یک پاد در حال اجرا باشد

.PP
\fB-q\fP, \fB--quiet\fP=false
	تنها چاپ خروجی نشست از راه دور (remote session)

.PP
\fB-i\fP, \fB--stdin\fP=false
	ارسال ورودی استاندارد (stdin) به کانتینر

.PP
\fB-t\fP, \fB--tty\fP=false
	ورودی استاندارد یک TTY است


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--as\fP=""
	نام کاربری برای جعل هویت (impersonate) در این عملیات. کاربر می‌تواند یک کاربر معمولی یا یک حساب خدمت (service account) در یک namespace باشد.

.PP
\fB--as-group\fP=[]
	گروه برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای تعیین چندین گروه تکرار شود.

.PP
\fB--as-uid\fP=""
	شناسه UID برای جعل هویت در این عملیات.

.PP
\fB--as-user-extra\fP=[]
	اطلاعات اضافی کاربر برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای مشخص کردن چندین مقدار برای یک کلید یکسان تکرار شود.

.PP
\fB--cache-dir\fP="/home/username/.kube/cache"
	دایرکتوری پیش‌فرض کش

.PP
\fB--certificate-authority\fP=""
	مسیر فایل گواهی برای مرجع صدور گواهی (certificate authority)

.PP
\fB--client-certificate\fP=""
	مسیر فایل گواهی کلاینت برای TLS

.PP
\fB--client-key\fP=""
	مسیر فایل کلید کلاینت برای TLS

.PP
\fB--cluster\fP=""
	نام کلاستر kubeconfig برای استفاده

.PP
\fB--context\fP=""
	نام کانتکست kubeconfig برای استفاده

.PP
\fB--disable-compression\fP=false
	در صورت true بودن، فشرده‌سازی پاسخ‌ها برای تمام درخواست‌ها به سرور غیرفعال می‌شود

.PP
\fB--insecure-skip-tls-verify\fP=false
	در صورت true بودن، اعتبار گواهی سرور بررسی نخواهد شد. این کار اتصالات HTTPS شما را ناامن می‌کند

.PP
\fB--kubeconfig\fP=""
	مسیر فایل kubeconfig برای استفاده در درخواست‌های CLI.

.PP
\fB--kuberc\fP=""
	مسیر فایل kuberc برای استفاده در ترجیحات (preferences). این قابلیت می‌تواند با export کردن feature gate به صورت KUBECTL_KUBERC=false یا خاموش کردن ویژگی با KUBERC=off غیرفعال شود.

.PP
\fB--match-server-version\fP=false
	الزام به تطابق نسخه سرور با نسخه کلاینت

.PP
\fB-n\fP, \fB--namespace\fP=""
	در صورت وجود، حوزه namespace برای این درخواست CLI

.PP
\fB--password\fP=""
	رمز عبور برای احراز هویت پایه (basic authentication) در سرور API

.PP
\fB--profile\fP="none"
	نام پروفایل برای ثبت. یکی از (none|cpu|heap|goroutine|threadcreate|block|mutex|trace)

.PP
\fB--profile-output\fP="profile.pprof"
	نام فایلی که پروفایل در آن ذخیره می‌شود

.PP
\fB--request-timeout\fP="0"
	مدت زمان انتظار پیش از انصراف از یک درخواست به سرور. مقادیر غیر صفر باید شامل واحد زمانی متناظر باشند (مانند 1s، 2m، 3h). مقدار صفر یعنی درخواست‌ها هرگز منقضی نشوند (بدون timeout).

.PP
\fB-s\fP, \fB--server\fP=""
	آدرس و پورت سرور Kubernetes API

.PP
\fB--tls-server-name\fP=""
	نام سرور برای اعتبارسنجی گواهی سرور. در صورت عدم ارائه، از hostname استفاده‌شده برای برقراری ارتباط با سرور استفاده می‌شود

.PP
\fB--token\fP=""
	توکن Bearer برای احراز هویت در سرور API

.PP
\fB--user\fP=""
	نام کاربر kubeconfig برای استفاده

.PP
\fB--username\fP=""
	نام کاربری برای احراز هویت پایه در سرور API

.PP
\fB--version\fP=false
	گزینه \fB\-\-version\fP یا \fB\-\-version=raw\fP اطلاعات نسخه را چاپ کرده و خارج می‌شود؛ \fB\-\-version=vX.Y.Z...\fP نسخه گزارش‌شده را تنظیم می‌کند

.PP
\fB--warnings-as-errors\fP=false
	در نظر گرفتن هشدارهای دریافتی از سرور به عنوان خطا و خروج با کد وضعیت غیر صفر


.SH "مثال‌ها (EXAMPLES)"
.EX
  # دریافت خروجی از اجرای دستور 'date' در پاد mypod با استفاده از اولین کانتینر به صورت پیش‌فرض
  kubectl exec mypod -- date

  # دریافت خروجی از اجرای دستور 'date' در کانتینر ruby-container از پاد mypod
  kubectl exec mypod -c ruby-container -- date

  # رفتن به حالت خام ترمینال (raw terminal mode)؛ ارسال stdin به 'bash' در ruby-container از پاد mypod
  # و بازگرداندن stdout/stderr از 'bash' به کلاینت
  kubectl exec mypod -c ruby-container -i -t -- bash -il

  # فهرست کردن محتویات /usr از اولین کانتینر پاد mypod و مرتب‌سازی بر اساس زمان ویرایش
  # اگر دستوری که می‌خواهید در پاد اجرا کنید دارای فلگ‌های مشترک است (مانند -i)،
  # باید از دو خط تیره (--) برای جداسازی فلگ‌ها/آرگومان‌های دستور خود استفاده کنید
  # همچنین توجه داشته باشید، دستور و فلگ‌ها/آرگومان‌های آن را داخل علامت نقل‌قول (کوتیشن) قرار ندهید
  # مگر اینکه به طور معمول به آن صورت اجرا شود (یعنی ls -t /usr را اجرا کنید، نه "ls -t /usr")
  kubectl exec mypod -i -t -- ls -t /usr

  # دریافت خروجی از اجرای دستور 'date' از اولین پاد deployment به نام mydeployment با استفاده از اولین کانتینر به صورت پیش‌فرض
  kubectl exec deploy/mydeployment -- date

  # دریافت خروجی از اجرای دستور 'date' از اولین پاد service به نام myservice با استفاده از اولین کانتینر به صورت پیش‌فرض
  kubectl exec svc/myservice -- date
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubectl(1)\fP


.SH "تاریخچه (HISTORY)"
ژانویه ۲۰۱۵، در ابتدا توسط Eric Paris (eparis at redhat dot com) بر پایه محتوای منبع kubernetes گردآوری شد، اما امید است که از آن زمان به بعد به طور خودکار تولید شده باشند!
