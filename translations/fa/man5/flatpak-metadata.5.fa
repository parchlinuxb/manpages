.IP " 1." 4
openat2()
.RS 4
\%https://man7.org/linux/man-pages/man2/openat2.2.html
.RE
.IP " 2." 4
steam-runtime-tools
.RS 4
\%https://gitlab.steamos.cloud/steamrt/steam-runtime-tools/-/blob/65adfdd5fc812aeb5f33986755f6ff72c9612afa/steam-runtime-tools/resolve-in-sysroot.c
.RE
.IP " 3." 4
freedesktop.org special directories
.RS 4
\%https://www.freedesktop.org/wiki/Software/xdg-user-dirs
.RE
.IP " 4." 4
freedesktop.org Base Directory Specification
.RS 4
\%https://specifications.freedesktop.org/basedir-spec/basedir-spec-latest.html
.RE
