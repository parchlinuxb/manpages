.\" dict.1 -- 
.\" Copyright 2011 Aleksey Cheusov (vle@gmx.net)
.TH DICT_LOOKUP 1 "9 January 2011" "" ""
.SH "نام (NAME)"
dict_lookup \- کلاینت پروتکل DICT
.SH "خلاصه دستور (SYNOPSIS)"
.nf
.BI dict_lookuop " [options]"
.fi
.SH "توضیحات (DESCRIPTION)"
دستور
.B dict_lookup
متن انتخاب‌شده در سامانه گرافیکی X را می‌خواند، سپس یک شبیه‌ساز
.B ترمینال
را باز کرده و کلاینت
.B dict
را در آن اجرا می‌کند تا کاربر بتواند محتوا را با استفاده از یک
.B صفحه‌بند
مشاهده کند. توصیه می‌شود اجرای dict_lookup را به یک کلید میانبر در مدیر پنجره اختصاص دهید.
.SH "گزینه‌ها (OPTIONS)"
.TP
.B \-h
نمایش پیام راهنما.
.TP
.BI \-x " x"
مختصات X شبیه‌ساز ترمینال.
.TP
.BI \-x " Y"
مختصات Y شبیه‌ساز ترمینال.
.TP
.BI \-s " WxH"
عرض و ارتفاع شبیه‌ساز ترمینال که با 'x' از هم جدا شده‌اند.
.TP
.BI \-q " query"
پرس‌وجو؛ در صورت تعیین شدن، متن انتخاب‌شده در X خوانده نمی‌شود.
.SH "محیط (ENVIRONMENT)"
.B dict_lookup
متغیرهای محیطی زیر را شناسایی می‌کند.
مقدار پیش‌فرض درون براکت‌ها مشخص شده است.
.TP
.B D_AWK_PROG
مفسر AWK مورد استفاده.
.RI [ awk ]
.TP
.B D_XCLIP_PROG
برنامه xclip.
.RI [ xclip ]
.TP
.B D_XTERM_PROG
برنامه xterm یا شبیه‌ساز ترمینال معادل.
.RI [ xterm ]
.TP
.B D_UTF8_LOCALE
مکان‌نمای محلی (لوکال) UTF-8.
.RI [ en_US.UTF-8 ]
.TP
.B D_DICT_PROG
برنامه کلاینت فرهنگ لغت.
.RI [ dict ]
.TP
.B D_DICT_SERVER
گزینه‌ای برای کلاینت فرهنگ لغت جهت مشخص کردن سرور.
.RI [ "-h dict.org" ]
.TP
.B D_DICT_PORT
گزینه‌ای برای کلاینت فرهنگ لغت جهت مشخص کردن درگاه.
.RI [ "-p 2628" ]
.TP
.B D_DICT_DB_OPT
گزینه‌ای برای کلاینت فرهنگ لغت جهت مشخص کردن پایگاه داده.
.RI [ "-d foldoc" ]
.TP
.B D_XTERM_CLASS
گزینه‌ای برای شبیه‌ساز ترمینال جهت مشخص کردن کلاس.
.RI [ "-class XTerm" ]
.TP
.B D_XTERM_NAME
گزینه‌ای برای شبیه‌ساز ترمینال جهت مشخص کردن نام.
.RI [ "-name xterm_dict" ]
.TP
.B D_XTERM_TITLE
گزینه‌ای برای شبیه‌ساز ترمینال جهت مشخص کردن عنوان.
.RI [ "-title dict_lookup" ]
.TP
.B D_TEXT_WIDTH
برنامه محاسبه‌کننده عرض متن برای متن داده‌شده.
.RI [ cyrillic_text_width ]
برنامه cyrillic_text_width برای زبان‌های ژاپنی، کره‌ای، چینی و برخی زبان‌های دیگر به درستی کار نمی‌کند.
.TP
.B D_TERM_X
مختصات X شبیه‌ساز ترمینال.
.RI [ +200 ]
.TP
.B D_TERM_Y
مختصات Y شبیه‌ساز ترمینال.
.RI [ +200 ]
.TP
.B D_TERM_H
ارتفاع شبیه‌ساز ترمینال.
.RI [ +40 ]
.TP
.B D_PAGER
صفحه‌بند.
.RI [ less ]
.SH "همچنین ببینید (SEE ALSO)"
.BR dict (1),
.BR less (1),
.BR xterm (1),
.BR dictd (8),
.BR http://www.dict.org ,
.B RFC 2229

