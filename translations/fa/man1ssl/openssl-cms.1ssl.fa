[\fB\-verify\fR]
[\fB\-resign\fR]
[\fB\-sign_receipt\fR]
[\fB\-verify_receipt\fR \fIreceipt\fR]
[\fB\-digest\fR \fIdigest\fR]
[\fB\-digest_create\fR]
[\fB\-digest_verify\fR]
[\fB\-compress\fR]
[\fB\-uncompress\fR]
[\fB\-EncryptedData_encrypt\fR]
