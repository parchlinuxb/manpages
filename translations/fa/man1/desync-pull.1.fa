.nh
.TH "desync" "1" "Sep 2026" "desync" ""

.SH "نام (NAME)"
desync-pull \- Serve chunks via casync protocol over SSH


.SH "خلاصه دستور (SYNOPSIS)"
\fBdesync pull - - - <store>\fP


.SH "توضیحات (DESCRIPTION)"
Serves up chunks (read-only) from a local store using the casync protocol
via Stdin/Stdout. Functions as a drop-in replacement for casync on remote
stores accessed with SSH. See CASYNC_REMOTE_PATH environment variable.


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	help for pull


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config file (default $HOME/.config/desync/config.json)

.PP
\fB--digest\fP="sha512-256"
	digest algorithm, sha512-256 or sha256

.PP
\fB--verbose\fP[=false]
	verbose mode


.SH "مثال (EXAMPLE)"
.EX
  desync pull - - - /path/to/store
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBdesync(1)\fP


.SH "تاریخچه (HISTORY)"
