.TH "GIT-BUG" "1" "Apr 2019" "Generated from git-bug's source code" ""

.SH "نام (NAME)"
git-bug-user-user \- نمایش هویت یک کاربر


.SH "خلاصه دستور (SYNOPSIS)"
\fBgit-bug user user show [USER_ID] [flags]\fP


.SH "توضیحات (DESCRIPTION)"
نمایش هویت یک کاربر


.SH "گزینه‌ها (OPTIONS)"
\fB-f\fP, \fB--field\fP=""
	انتخاب فیلد برای نمایش. مقادیر معتبر عبارتند از [email,humanId,id,lastModification,lastModificationLamports,login,metadata,name]

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای user


.SH "همچنین ببینید (SEE ALSO)"
