.TH "OSTREE ADMIN SET\-DE" "1" "" "OSTree" "ostree admin set-default"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
ostree-admin-set-default \- Make deployment at a given index the default for the next boot
.SH "خلاصه دستور (SYNOPSIS)"
.HP \w'\fBostree\ admin\ set\-default\fR\ 'u
\fBostree admin set\-default\fR {INDEX}
.SH "توضیحات (DESCRIPTION)"
.PP
Make the deployment at INDEX the default for the next boot\&.
.SH "مثال (EXAMPLE)"
.PP
\fB$ ostree admin status\fR
.sp
.if n \{\
.RS 4
.\}
.nf
        * exampleos 67e382b11d213a402a5313e61cbc69dfd5ab93cb07\&.0
            origin refspec: exampleos/buildmain/x86_64\-runtime
          exampleos ce19c41036cc45e49b0cecf6b157523c2105c4de1c\&.0
            origin refspec: exampleos/buildmain/x86_64\-runtime
.fi
.if n \{\
.RE
.\}
.PP
\fB$ ostree admin set\-default 1\fR
.sp
.if n \{\
.RS 4
.\}
.nf
        Transaction complete; bootconfig swap: deployment count change: 0
.fi
.if n \{\
.RE
.\}
.PP
\fB$ ostree admin status\fR

          exampleos ce19c41036cc45e49b0cecf6b157523c2105c4de1c\&.0
            origin refspec: exampleos/buildmain/x86_64\-runtime
        * exampleos 67e382b11d213a402a5313e61cbc69dfd5ab93cb07\&.0
            origin refspec: exampleos/buildmain/x86_64\-runtime
.sp
.if n \{\
.RS 4
.\}
.nf
.fi
.if n \{\
.RE
.\}
