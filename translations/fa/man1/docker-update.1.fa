.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-update \- به‌روزرسانی پیکربندی یک یا چند کانتینر


.SH "خلاصه دستور (SYNOPSIS)"
\fBdocker update [OPTIONS] CONTAINER [CONTAINER...]\fP


.SH "شرح (DESCRIPTION)"
نام مستعار برای \fBdocker container update\fR\&.


.SH "گزینه‌ها (OPTIONS)"
\fB--blkio-weight\fP=0
	ورودی/خروجی بلوکی (وزن نسبی)، بین ۱۰ تا ۱۰۰۰، یا ۰ برای غیرفعال‌سازی (پیش‌فرض ۰)

.PP
\fB--cpu-period\fP=0
	محدود کردن دوره زمان‌بند کاملاً منصفانه (CFS) پردازنده

.PP
\fB--cpu-quota\fP=0
	محدود کردن سهمیه زمان‌بند کاملاً منصفانه (CFS) پردازنده

.PP
\fB--cpu-rt-period\fP=0
	محدود کردن دوره بی‌درنگ (real-time) پردازنده بر حسب میکروثانیه

.PP
\fB--cpu-rt-runtime\fP=0
	محدود کردن زمان اجرای بی‌درنگ (real-time) پردازنده بر حسب میکروثانیه

.PP
\fB-c\fP, \fB--cpu-shares\fP=0
	سهم‌های پردازنده (وزن نسبی)

.PP
\fB--cpus\fP=
	تعداد پردازنده‌ها

.PP
\fB--cpuset-cpus\fP=""
	پردازنده‌های مجاز برای اجرا (0-3, 0,1)

.PP
\fB--cpuset-mems\fP=""
	گره‌های حافظه (MEMs) مجاز برای اجرا (0-3, 0,1)

.PP
\fB-m\fP, \fB--memory\fP=0
	محدودیت حافظه

.PP
\fB--memory-reservation\fP=0
	محدودیت نرم حافظه

.PP
\fB--memory-swap\fP=0
	محدودیت swap برابر با حافظه به‌علاوه swap: مقدار -1 برای فعال‌سازی swap نامحدود

.PP
\fB--pids-limit\fP=0
	تنظیم محدودیت تعداد شناسه‌های پردازه (PID) کانتینر (تنظیم -1 برای نامحدود)

.PP
\fB--restart\fP=""
	سیاست راه‌اندازی مجدد هنگام خروج کانتینر


.SH "ببینید (SEE ALSO)"
\fBdocker(1)\fP
