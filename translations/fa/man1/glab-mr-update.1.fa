.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-mr-update \- به‌روزرسانی یک درخواست ادغام.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab mr update [ | ] [flags]\fP


.SH "توضیحات (DESCRIPTION)"
به‌طور پیش‌فرض شاخهٔ جاری انتخاب می‌شود. از
\fB--fill\fR
برای پر کردن خودکار عنوان و توضیحات بر اساس تاریخچهٔ کامیت‌ها استفاده کنید.


.SH "گزینه‌ها (OPTIONS)"
\fB-a\fP, \fB--assignee\fP=[]
	محول کردن به کاربران از طریق نام کاربری. برای حذف از افراد محول‌شدهٔ کنونی از پیشوند '!' یا '-'، و برای افزودن از '+' استفاده کنید. در غیر این صورت، افراد محول‌شدهٔ کنونی با کاربران ارائه‌شده جایگزین می‌شوند. می‌توان چند نام کاربری را با کاما جدا کرد یا با تکرار فلگ مشخص نمود.

.PP
\fB-d\fP, \fB--description\fP=""
	توضیحات درخواست ادغام. برای باز کردن یک ویرایشگر، مقدار آن را برابر "-" قرار دهید.

.PP
\fB--description-file\fP=""
	خواندن توضیحات درخواست ادغام از یک فایل. از "-" برای خواندن از ورودی استاندارد استفاده کنید.

.PP
\fB--draft\fP[=false]
	علامت‌گذاری درخواست ادغام به‌عنوان پیش‌نویس (draft).

.PP
\fB-f\fP, \fB--fill\fP[=false]
	درخواست عنوان یا متن نپرسید و صرفاً از اطلاعات کامیت استفاده کنید.

.PP
\fB--fill-commit-body\fP[=false]
	هنگام وجود چندین کامیت، متن توضیحات را با متن هر کامیت پر کنید. فقط همراه با \fB--fill\fR قابل استفاده است.

.PP
\fB-l\fP, \fB--label\fP=[]
	افزودن برچسب‌ها.

.PP
\fB--lock-discussion\fP[=false]
	قفل کردن گفتگو در درخواست ادغام.

.PP
\fB-m\fP, \fB--milestone\fP=""
	عنوان مایل‌استون برای اختصاص دادن. برای لغو انتساب، آن را روی "" یا 0 قرار دهید.

.PP
\fB-r\fP, \fB--ready\fP[=false]
	علامت‌گذاری درخواست ادغام به‌عنوان آماده برای بازبینی و ادغام.

.PP
\fB--remove-source-branch\fP[=false]
	تغییر وضعیت حذف شاخهٔ مبدأ پس از ادغام.

.PP
\fB--reviewer\fP=[]
	درخواست بازبینی از کاربران با نام کاربری آن‌ها. برای حذف از بازبین‌های کنونی از پیشوند '!' یا '-'، و برای افزودن از '+' استفاده کنید. در غیر این صورت، بازبین‌های کنونی با کاربران ارائه‌شده جایگزین می‌شوند. می‌توان چند نام کاربری را با کاما جدا کرد یا با تکرار فلگ مشخص نمود.

.PP
\fB--squash-before-merge\fP[=false]
	تغییر وضعیت گزینهٔ ادغام کامیت‌ها در قالب یک کامیت واحد هنگام ادغام (squash).

.PP
\fB--target-branch\fP=""
	تنظیم شاخهٔ مقصد.

.PP
\fB-t\fP, \fB--title\fP=""
	عنوان درخواست ادغام.

.PP
\fB--unassign\fP[=false]
	لغو انتساب تمام کاربران.

.PP
\fB-u\fP, \fB--unlabel\fP=[]
	حذف برچسب‌ها.

.PP
\fB--unlock-discussion\fP[=false]
	باز کردن قفل گفتگو در درخواست ادغام.

.PP
\fB--wip\fP[=false]
	علامت‌گذاری درخواست ادغام به‌عنوان در حال پیشرفت (WIP). جایگزینی برای \fB--draft\fR.

.PP
\fB-y\fP, \fB--yes\fP[=false]
	رد شدن از اعلان تأیید.


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB-h\fP, \fB--help\fP[=false]
	نمایش راهنما برای این دستور.

.PP
\fB-R\fP, \fB--repo\fP=""
	انتخاب مخزنی دیگر. می‌توانید از OWNER/REPO یا GROUP/NAMESPACE/REPO استفاده کنید. نشانی کامل URL یا آدرس Git نیز پذیرفته می‌شود.


.SH "مثال‌ها (EXAMPLES)"
.EX
# آماده علامت‌گذاری کردن یک درخواست ادغام
glab mr update 23 --ready

# پیش‌نویس علامت‌گذاری کردن یک درخواست ادغام
glab mr update 23 --draft

# به‌روزرسانی درخواست ادغام برای شاخهٔ جاری
glab mr update --draft

# به‌روزرسانی درخواست ادغام با اطلاعات کامیت
glab mr update 23 --fill --fill-commit-body --yes

# خواندن توضیحات از یک فایل
glab mr update 23 --description-file description.md

# خواندن توضیحات از ورودی استاندارد
cat description.md | glab mr update 23 --description-file -
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-mr(1)\fP
