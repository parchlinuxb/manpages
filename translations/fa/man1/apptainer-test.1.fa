.nh
.TH "apptainer" "1" "Jul 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
apptainer-test \- اجرای آزمون‌های تعریف‌شده توسط کاربر درون یک ظرف (کانتینر)


.SH "خلاصه دستور (SYNOPSIS)"
\fBapptainer test [گزینه‌های اجرا...] \fP


.SH "توضیحات (DESCRIPTION)"
دستور 'test' به شما امکان می‌دهد یک اسکریپت آزمون (در صورت وجود) را درون یک
  ظرف داده‌شده اجرا کنید.

.PP
نکته:
      برای نمونه‌ها (instances)، اگر یک فرآیند دیمِن (پس‌زمینه) درون ظرف در حال اجرا باشد،
      دستورات بعدی ظرف همگی درون همان فضاهای نام (namespaces) اجرا خواهند شد. این بدان
      معناست که گزینه‌های writable-- و contain-- اعمال نخواهند شد زیرا فضاهای نام
      پیش‌تر توسط دستور 'apptainer start' پیکربندی شده‌اند.


.SH "گزینه‌ها (OPTIONS)"
\fB--add-caps\fP=""
	فهرستی از قابلیت‌ها (capabilities) جداشده با کاما جهت اضافه کردن

.PP
\fB--allow-setuid\fP[=false]
	اجازه اجرای برنامه‌های با بیت setuid درون ظرف (فقط ریشه/root)

.PP
\fB--app\fP=""
	تنظیم یک برنامه کاربردی برای اجرا درون ظرف

.PP
\fB--apply-cgroups\fP=""
	اعمال cgroups از پرونده برای فرآیندهای ظرف (فقط ریشه/root)

.PP
\fB--authfile\fP=""
	پرونده احراز هویت به سبک داکر جهت استفاده برای نوشتن/خواندن اعتبارنامه‌های سامانه ثبت OCI

.PP
\fB-B\fP, \fB--bind\fP=[]
	مشخصات مسیر پیوند کاربر. این مشخصه قالب src[:dest[:opts]] دارد که در آن src و dest مسیرهای خارج و داخل هستند. در صورت عدم تعیین dest، برابر با src قرار می‌گیرد. گزینه‌های اتصال ('opts') می‌توانند به صورت 'ro' (فقط‌خواندنی) یا 'rw' (خواندنی/نوشتنی، که پیش‌فرض است) مشخص شوند. چند مسیر پیوند را می‌توان با فهرست جداشده با کاما تعیین کرد.

.PP
\fB--blkio-weight\fP=0
	وزن نسبی Block IO در محدوده ۱۰ تا ۱۰۰۰، ۰ برای غیرفعال‌سازی

.PP
\fB--blkio-weight-device\fP=[]
	وزن نسبی Block IO مختص دستگاه

.PP
\fB--cdi-dirs\fP=[]
	فهرست جداشده با کاما از پوشه‌هایی که CDI باید در آن‌ها به دنبال پرونده‌های JSON تعریف دستگاه بگردد. در صورت حذف، پیش‌فرض خواهد بود: etc/cdi,/var/run/cdi/

.PP
\fB-e\fP, \fB--cleanenv\fP[=false]
	پاکسازی متغیرهای محیطی پیش از اجرای ظرف

.PP
\fB--compat\fP[=false]
	اعمال تنظیمات برای افزایش سازگاری با OCI/Docker. گزینه‌های containall، --no-init، --no-umask، --no-eval، --writable-tmpfs-- را در بر می‌گیرد.

.PP
\fB-c\fP, \fB--contain\fP[=false]
	استفاده از dev/ مینیمال و پوشه‌های خالی دیگر (مانند tmp/ و HOME$) به جای اشتراک‌گذاری سامانه‌های پرونده از میزبان شما

.PP
\fB-C\fP, \fB--containall\fP[=false]
	مهار نه تنها سامانه‌های پرونده، بلکه PID، IPC و محیط

.PP
\fB--cpu-shares\fP=-1
	سهم‌های پردازنده (CPU shares) برای ظرف

.PP
\fB--cpus\fP=""
	تعداد پردازنده‌های در دسترس برای ظرف

.PP
\fB--cpuset-cpus\fP=""
	فهرست پردازنده‌های میزبان در دسترس برای ظرف

.PP
\fB--cpuset-mems\fP=""
	فهرست گره‌های حافظه میزبان در دسترس برای ظرف

.PP
\fB--cwd\fP=""
	پوشه کاری اولیه برای فرآیند بار کاری درون ظرف (هم‌معنی با pwd--)

.PP
\fB--device\fP=[]
	نام(های) کامل دستگاه CDI. یک نام کامل دستگاه CDI شامل VENDOR، CLASS و NAME است که به صورت /= ترکیب می‌شوند (مانند vendor.com/device=mydevice). چندین نام کامل دستگاه CDI را می‌توان با فهرستی جداشده با کاما ارائه کرد.

.PP
\fB--disable-cache\fP[=false]
	عدم استفاده یا ایجاد حافظه نهان (کَش)

.PP
\fB--dns\fP=""
	فهرستی از کارسازهای DNS جداشده با کاما برای اضافه شدن به resolv.conf

.PP
\fB--docker-host\fP=""
	مشخص کردن میزبان سفارشی دیمن داکر

.PP
\fB--docker-login\fP[=false]
	ورود به یک مخزن داکر به صورت تعاملی

.PP
\fB--drop-caps\fP=""
	فهرستی از قابلیت‌ها (capabilities) جداشده با کاما جهت حذف

.PP
\fB--env\fP=[]
	ارسال متغیر محیطی به فرآیند مهارشده

.PP
\fB--env-file\fP=[]
	ارسال متغیرهای محیطی از پرونده به فرآیند مهارشده

.PP
\fB-f\fP, \fB--fakeroot\fP[=false]
	اجرای ظرف با ظاهر اجرای کاربر ریشه (root)

.PP
\fB--fusemount\fP=[]
	مشخصات اتصال سامانه پرونده FUSE به شکل 'container:sshfs 10.0.0.1:/ /sshfs' یا موارد مشابه. گزینه pid-- را در بر دارد.

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای test

.PP
\fB-H\fP, \fB--home\fP="/build"
	مشخصات پوشه خانگی. می‌تواند یک مسیر مبدا یا جفت src:dest باشد. مبدا مسیر پوشه خانگی خارج از ظرف است و dest پوشه خانگی درون ظرف را بازنویسی می‌کند.

.PP
\fB--hostname\fP=""
	تنظیم نام میزبان ظرف

.PP
\fB--intel-hpu\fP[=false]
	فعال‌سازی پشتیبانی از شتاب‌دهنده Intel(R) Gaudi هم‌زمان با استفاده از dev/ مینیمال

.PP
\fB-i\fP, \fB--ipc\fP[=false]
	اجرای ظرف در یک فضای نام جدید IPC

.PP
\fB--keep-privs\fP[=false]
	حفظ اختیارات کاربر ریشه در ظرف (فقط ریشه/root)

.PP
\fB--memory\fP=""
	محدودیت حافظه بر حسب بایت

.PP
\fB--memory-reservation\fP=""
	محدودیت نرم (soft limit) حافظه بر حسب بایت

.PP
\fB--memory-swap\fP=""
	محدودیت حافظه تبدیل (Swap)، از ۱- برای حافظه تبدیل نامحدود استفاده کنید

.PP
\fB--mount\fP=[]
	مشخصات اتصال مانند 'type=bind,source=/opt,destination=/hostopt'. پرچم 'nonested' از ارسال این اتصال به ظرف‌های تودرتو از طریق APPTAINER_BIND جلوگیری می‌کند.

.PP
\fB-n\fP, \fB--net\fP[=false]
	اجرای ظرف در یک فضای نام شبکه جدید (به طور پیش‌فرض یک واسط شبکه پلی راه‌اندازی می‌کند)

.PP
\fB--netns-path\fP=""
	پیوستن به فضای نام شبکه در مسیر مشخص‌شده (به عنوان ریشه یا در صورت مجاز بودن در apptainer.conf)

.PP
\fB--network\fP=""
	مشخص کردن نوع شبکه مورد نظر جداشده با کاما، هر شبکه یک واسط اختصاصی درون ظرف ایجاد می‌کند

.PP
\fB--network-args\fP=[]
	مشخص کردن آرگومان‌های شبکه برای ارسال به افزونه‌های CNI

.PP
\fB--no-env\fP=[]
	فهرستی از متغیرهای محیطی برای مسدود کردن واردات آن‌ها از محیط میزبان به ظرف

.PP
\fB--no-eval\fP[=false]
	عدم ارزیابی پوسته روی متغیرهای محیطی یا CMD/ENTRYPOINT/ARGS ظرف‌های OCI

.PP
\fB--no-home\fP[=false]
	عدم اتصال پوشه خانگی کاربران در صورتی که home/ پوشه کاری جاری نباشد

.PP
\fB--no-https\fP[=false]
	استفاده از http به جای https برای شناسه‌های یکتای منابع ://docker:// ،oras و :///...library

.PP
\fB--no-init\fP[=false]
	عدم راه‌اندازی فرآیند shim همراه با pid--

.PP
\fB--no-mount\fP=[]
	غیرفعال‌سازی یک یا چند گزینه 'mount xxx' تنظیم‌شده در apptainer.conf و/یا مشخص کردن مسیر مقصد مطلق برای غیرفعال کردن یک ورودی مسیر پیوند، یا 'bind-paths' برای غیرفعال کردن تمام ورودی‌های مسیر پیوند.

.PP
\fB--no-pid\fP[=false]
	عدم اجرای ظرف در یک فضای نام جدید PID

.PP
\fB--no-privs\fP[=false]
	سلب تمام اختیارات از کاربر ریشه در ظرف

.PP
\fB--no-umask\fP[=false]
	عدم انتقال umask میزبان به ظرف، تنظیم پیش‌فرض 0022 برای umask

.PP
\fB--nv\fP[=false]
	فعال‌سازی پشتیبانی از Nvidia

.PP
\fB--nvccli\fP[=false]
	استفاده از nvidia-container-cli برای راه‌اندازی کارت گرافیک (آزمایشی)

.PP
\fB--oom-kill-disable\fP[=false]
	غیرفعال‌سازی قاتل حافظه ناکافی (OOM killer)

.PP
\fB-o\fP, \fB--overlay\fP=[]
	استفاده از یک تصویر overlayFS برای ذخیره‌سازی داده‌های پایدار یا به عنوان لایه فقط‌خواندنی ظرف

.PP
\fB--passphrase\fP[=false]
	درخواست ورود عبارت عبور رمزگذاری

.PP
\fB--pem-path\fP=""
	وارد کردن یک مسیر به کلید RSA با قالب PEM برای یک ظرف رمزگذاری‌شده

.PP
\fB-p\fP, \fB--pid\fP[=false]
	اجرای ظرف در یک فضای نام جدید PID

.PP
\fB--pids-limit\fP=0
	محدود کردن تعداد شناسه‌های فرآیند (PID) ظرف، از ۱- برای نامحدود استفاده کنید

.PP
\fB--rocm\fP[=false]
	فعال‌سازی پشتیبانی آزمایشی از Rocm

.PP
\fB-S\fP, \fB--scratch\fP=[]
	گنجاندن یک پوشه چرکنویس (scratch) درون ظرف که به یک پوشه موقت پیوند داده شده است (برای تحمیل مکان از W- استفاده کنید)

.PP
\fB--security\fP=[]
	فعال‌سازی ویژگی‌های امنیتی (SELinux، Apparmor، Seccomp)

.PP
\fB--sharens\fP[=false]
	اشتراک‌گذاری فضای نام و تصویر با ظرف‌های دیگری که از همان فرآیند والد راه‌اندازی شده‌اند

.PP
\fB--unsquash\fP[=false]
	تبدیل پرونده SIF به یک سندباکس موقت پیش از اجرا

.PP
\fB-u\fP, \fB--userns\fP[=false]
	اجرای ظرف در یک فضای نام کاربری جدید

.PP
\fB--uts\fP[=false]
	اجرای ظرف در یک فضای نام جدید UTS

.PP
\fB-W\fP, \fB--workdir\fP=""
	پوشه کاری مورد استفاده برای tmp/، /var/tmp و HOME$ (در صورتی که c/--contain- نیز استفاده شده باشد)

.PP
\fB-w\fP, \fB--writable\fP[=false]
	به طور پیش‌فرض تمامی ظرف‌های Apptainer به صورت فقط‌خواندنی در دسترس هستند. این گزینه سامانه پرونده را به صورت خواندنی/نوشتنی در دسترس قرار می‌دهد.

.PP
\fB--writable-tmpfs\fP[=false]
	سامانه پرونده را به صورت خواندنی/نوشتنی با داده‌های ناپایدار در دسترس قرار می‌دهد (تنها با پشتیبانی از overlay)


.SH "مثال (EXAMPLE)"
.EX

  بخش '%test' را با یک پرونده تعریف مانند زیر تنظیم کنید:
  %test
      echo "hello from test" "$@"

  $ apptainer test /tmp/debian.sif command
      hello from test command

  برای راهنمایی بیشتر، لطفاً از صفحات مستندات عمومی ما به نشانی زیر دیدن فرمایید:

      https://apptainer.org/docs/
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBapptainer(1)\fP


.SH "تاریخچه (HISTORY)"
30-Jul-2026 تولید خودکار توسط spf13/cobra
