.IP \fBarmv8\fR 4
.IX Item "armv8"
.IP \fBvfp\fR 4
.IX Item "vfp"
.IP \fBneon\fR 4
.IX Item "neon"
.PD
.RE
.RS 4
.RE
.IP \fBPowerPC\fR 4
.IX Item "PowerPC"
