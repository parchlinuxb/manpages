.if \n(.g .mso www.tmac
.TH lxc-snapshot 1 2026-08-01 "" ""
.SH "نام (NAME)"
lxc-snapshot \- ثبت تصویر لحظه‌ای از یک کانتینر موجود
.SH "خلاصه دستور (SYNOPSIS)"
'nh
.fi
.ad l
\fBlxc-snapshot\fR \kx
.if (\nx>(\n(.l/2)) .nr x (\n(.l/5)
'in \n(.iu+\nxu
{-n, --name \fIname\fR} [-c, --comment \fIfile\fR]
'in \n(.iu-\nxu
.ad b
'hy
'nh
.fi
.ad l
\fBlxc-snapshot\fR \kx
.if (\nx>(\n(.l/2)) .nr x (\n(.l/5)
'in \n(.iu+\nxu
{-n, --name \fIname\fR} {-d, -destroy \fIsnapshot-name\fR}
'in \n(.iu-\nxu
.ad b
'hy
'nh
.fi
.ad l
\fBlxc-snapshot\fR \kx
.if (\nx>(\n(.l/2)) .nr x (\n(.l/5)
'in \n(.iu+\nxu
{-n, --name \fIname\fR} {-L, --list } [-C, --showcomments ]
'in \n(.iu-\nxu
.ad b
'hy
'nh
.fi
.ad l
\fBlxc-snapshot\fR \kx
.if (\nx>(\n(.l/2)) .nr x (\n(.l/5)
'in \n(.iu+\nxu
{-n, --name \fIname\fR} {-r, -restore \fIsnapshot-name\fR} [-N, --newname \fInewname\fR]
'in \n(.iu-\nxu
.ad b
'hy
.SH "توضیحات (DESCRIPTION)"
دستور
\fBlxc-snapshot\fR
برای ایجاد، فهرست‌کردن و بازیابی تصاویر لحظه‌ای کانتینر به کار می‌رود.
.PP
تصاویر لحظه‌ای به عنوان کانتینرهای تصویربرداری‌شده در مسیر پیکربندی کانتینر ذخیره می‌شوند. برای نمونه، اگر مسیر پیکربندی کانتینر \*(T<\fI/var/lib/lxc\fR\*(T> و نام کانتینر \*(T<\fIc1\fR\*(T> باشد، اولین تصویر لحظه‌ای به عنوان کانتینر \*(T<\fIsnap0\fR\*(T> زیر مسیر \*(T<\fI/var/lib/lxc/c1/snaps\fR\*(T> ذخیره خواهد شد.
اگر \*(T<\fI/var/lib/lxcsnaps\fR\*(T>، همان‌طور که در LXC 1.0 استفاده می‌شد، از قبل وجود داشته باشد، همچنان مورد استفاده قرار خواهد گرفت.
.SH "گزینه‌ها (OPTIONS)"
.TP
\*(T<\fB\-c,\-\-comment \fR\*(T>\fIcomment_file\fR
یادداشت موجود در \fIcomment_file\fR را به تصویر لحظه‌ای تازه‌ساخته‌شده پیوند می‌دهد.
.TP
\*(T<\fB\-d,\-\-destroy snapshot\-name\fR\*(T>
تصویر لحظه‌ای مشخص‌شده را حذف می‌کند. اگر نام تصویر لحظه‌ای برابر با ALL باشد، تمام تصاویر لحظه‌ای حذف خواهند شد.
.TP
\*(T<\fB\-L,\-\-list \fR\*(T>
تصاویر لحظه‌ای موجود را فهرست می‌کند.
.TP
\*(T<\fB\-C,\-\-showcomments \fR\*(T>
یادداشت‌های مربوط به تصویر لحظه‌ای را در فهرست تصاویر نشان می‌دهد.
.TP
\*(T<\fB\-r,\-\-restore snapshot\-name\fR\*(T>
تصویر لحظه‌ای مشخص‌شده را بازیابی می‌کند؛ به این معنا که یک کانتینر کاملاً جدید که رونوشتی از آن تصویر لحظه‌ای است ساخته می‌شود.
.TP
\*(T<\fB\-N, \-\-newname\fR\*(T>
هنگام بازیابی یک تصویر لحظه‌ای، در صورتی که آخرین آرگومان اختیاری به طور صریح با \fB\-\-newname\fR مشخص نشده باشد، نام مورد استفاده برای کانتینر بازیابی‌شده خواهد بود. اگر نام جدید با نام اصلی کانتینر یکسان باشد، کانتینر اصلی حذف شده و کانتینر بازیابی‌شده جایگزین آن خواهد شد. توجه داشته باشید که در صورت استفاده از تصاویر لحظه‌ای با پشتیبانی overlayfs یا zfs، حذف تصویر لحظه‌ای اصلی امکان‌پذیر نیست.
.SH "گزینه‌های عمومی (COMMON OPTIONS)"
این گزینه‌ها میان بیشتر دستورات lxc مشترک هستند.
.TP
\*(T<\fB\-?, \-h, \-\-help\fR\*(T>
پیام راهنمای مفصل‌تری نسبت به حالت عادی نمایش می‌دهد.
.TP
\*(T<\fB\-\-usage\fR\*(T>
پیام شیوه استفاده از دستور را نمایش می‌دهد.
.TP
\*(T<\fB\-q, \-\-quiet\fR\*(T>
حالت بی‌صدا را فعال می‌کند.
.TP
\*(T<\fB\-P, \-\-lxcpath=\fR\*(T>\fIPATH\fR
استفاده از یک مسیر کانتینر جایگزین. مقدار پیش‌فرض /var/lib/lxc است.
.TP
\*(T<\fB\-o, \-\-logfile=\fR\*(T>\fIFILE\fR
خروجی لاگ را به یک پرونده لاگ جایگزین
\fIFILE\fR
هدایت می‌کند. حالت پیش‌فرض عدم ثبت لاگ است.
.TP
\*(T<\fB\-l, \-\-logpriority=\fR\*(T>\fILEVEL\fR
اولویت لاگ را روی
\fILEVEL\fR
تنظیم می‌کند. اولویت پیش‌فرض لاگ
\*(T<ERROR\*(T>
است. مقادیر ممکن عبارتند از:
\*(T<FATAL\*(T>، \*(T<ALERT\*(T>،
\*(T<CRIT\*(T>،
\*(T<WARN\*(T>، \*(T<ERROR\*(T>،
\*(T<NOTICE\*(T>، \*(T<INFO\*(T>،
\*(T<DEBUG\*(T>، \*(T<TRACE\*(T>.
.PP
توجه داشته باشید که این گزینه اولویت وقایع ثبت‌شده در فایل لاگ جایگزین را تنظیم می‌کند و بر رویدادهای
ERROR
در خروجی استاندارد خطا (stderr) تأثیری ندارد.
.TP
\*(T<\fB\-n, \-\-name=\fR\*(T>\fINAME\fR
استفاده از شناسه کانتینر \fINAME\fR.
قالب شناسه کانتینر یک رشته الفبایی-عددی است.
.TP
\*(T<\fB\-\-rcfile=\fR\*(T>\fIFILE\fR
فایل پیکربندی را جهت تنظیم عملکردهای مجازی‌سازی و جداسازی برای کانتینر مشخص می‌کند.
.PP
در صورت وجود، این فایل پیکربندی حتی در صورتی که کانتینر قبلاً ایجادشده (از طریق lxc-create) دارای فایل پیکربندی باشد نیز استفاده خواهد شد.
.TP
\*(T<\fB\-\-version\fR\*(T>
شماره نسخه را نمایش می‌دهد.
.SH "همچنین ببینید (SEE ALSO)"
\fBlxc\fR(7),
\fBlxc-create\fR(1),
\fBlxc-copy\fR(1),
\fBlxc-destroy\fR(1),
\fBlxc-start\fR(1),
\fBlxc-stop\fR(1),
\fBlxc-execute\fR(1),
\fBlxc-console\fR(1),
\fBlxc-monitor\fR(1),
\fBlxc-wait\fR(1),
\fBlxc-cgroup\fR(1),
\fBlxc-ls\fR(1),
\fBlxc-info\fR(1),
\fBlxc-freeze\fR(1),
\fBlxc-unfreeze\fR(1),
\fBlxc-attach\fR(1),
\fBlxc.conf\fR(5)
