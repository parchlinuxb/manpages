      readonly t AccuracyUSec = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly t RandomizedDelayUSec = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly b FixedRandomDelay = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly b Persistent = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly b WakeSystem = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly b RemainAfterElapse = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly b DeferReactivation = \&.\&.\&.;
  };
  interface org\&.freedesktop\&.DBus\&.Peer { \&.\&.\&. };
  interface org\&.freedesktop\&.DBus\&.Introspectable { \&.\&.\&. };
  interface org\&.freedesktop\&.DBus\&.Properties { \&.\&.\&. };
  interface org\&.freedesktop\&.systemd1\&.Unit { \&.\&.\&. };
};
.fi
.if n \{\
.RE
.\}
.SS "ویژگی‌ها (Properties)"
.PP
\fIUnit\fR
حاوی نام واحدی است که باید هنگام انقضای تایمر فعال شود\&.
.PP
\fITimersMonotonic\fR
حاوی آرایه‌ای از ساختارها است که شامل اطلاعاتی دربارهٔ تمام تایمرهای یکنواخت این واحد تایمر می‌باشند\&. این ساختارها شامل رشته‌ای هستند که مبنای تایمر را مشخص می‌کند و یکی از مقادیر
"OnActiveUSec"،
"OnBootUSec"،
"OnStartupUSec"،
"OnUnitActiveUSec" یا
"OnUnitInactiveUSec"
است که با تنظیماتی با همین نام در فایل‌های واحد تایمر مطابقت دارند؛ انحراف بر حسب میکروثانیه از این مبنای تایمر در زمان یکنواخت؛ و نقطهٔ انقضای بعدی روی ساعت
\fBCLOCK_MONOTONIC\fR
نسبت به مبدأ آن\&.
.PP
\fITimersCalendar\fR
حاوی آرایه‌ای از ساختارها است که شامل اطلاعاتی دربارهٔ تمام تایمرهای بلادرنگ/تقویمی این واحد تایمر می‌باشند\&. این ساختارها شامل رشته‌ای هستند که مبنای تایمر را مشخص می‌کند، که در حال حاضر تنها می‌تواند
"OnCalendar"
باشد؛ رشتهٔ مشخصات تقویم؛ و نقطهٔ انقضای بعدی روی ساعت
\fBCLOCK_REALTIME\fR
نسبت به مبدأ آن\&.
.PP
\fINextElapseUSecRealtime\fR
حاوی نقطهٔ انقضای بعدی روی ساعت
\fBCLOCK_REALTIME\fR
بر حسب میکروثانیه از مبدأ زمانی است، یا 0 در صورتی که این رویداد تایمر شامل حداقل یک رویداد تقویمی نباشد\&.
.PP
به طور مشابه،
\fINextElapseUSecMonotonic\fR
حاوی نقطهٔ انقضای بعدی روی ساعت
\fBCLOCK_MONOTONIC\fR
بر حسب میکروثانیه از مبدأ زمانی است، یا 0 در صورتی که این رویداد تایمر شامل حداقل یک رویداد یکنواخت نباشد\&.
.PP
\fIResult\fR
مقادیر
"success"
و
"resources"
را با همان معانی مقادیر منطبق در ویژگی مربوطهٔ رابط سرویس می‌شناسد\&.
.SH "اشیاء SWAP UNIT (SWAP UNIT OBJECTS)"
