.nh
.TH podman-secret 1
.SH "نام (NAME)"
podman-secret \- مدیریت سکرت‌های پودمن

.SH "خلاصه دستور (SYNOPSIS)"
\fBpodman secret\fP \fIزیردستور\fP

.SH "توضیحات (DESCRIPTION)"
دستور \fBpodman secret\fP مجموعه‌ای از زیردستورها برای مدیریت سکرت‌ها (داده‌های حساس و محرمانه) است.

.SH "زیردستورها (SUBCOMMANDS)"
.TS
allbox;
l l l 
l l l .
\fBدستور\fP	\fBصفحه راهنما\fP	\fBتوضیحات\fP
create	podman-secret-create(1)	ایجاد یک سکرت جدید
exists	podman-secret-exists(1)	T{
بررسی وجود یک سکرت مشخص
T}
inspect	podman-secret-inspect(1)	T{
نمایش اطلاعات تفصیلی یک یا چند سکرت
T}
ls	podman-secret-ls(1)	فهرست کردن تمام سکرت‌های موجود
rm	podman-secret-rm(1)	حذف یک یا چند سکرت
.TE

.SH "همچنین ببینید (SEE ALSO)"
\fBpodman(1)\fP

.SH "تاریخچه (HISTORY)"
