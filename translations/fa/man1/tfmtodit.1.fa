.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_tfmtodit_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.\" Definitions
.\" ====================================================================
.
.ie t .ds tx T\h'-.1667m'\v'.224m'E\v'-.224m'\h'-.125m'X
.el .ds tx TeX
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY tfmtodit
.RB [ \-s ]
.RB [ \-g\~\c
.IR gf-file ]
.RB [ \-k\~\c
.IR skew-char ]
.I tfm-file
.I map-file
.I font-description
.YS
.
.
.P
.SY tfmtodit
.B \-\-help
.YS
.
.
.P
.SY tfmtodit
.B \-v
.YS
.
.SY tfmtodit
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
دستور
.I tfmtodit
یک فایل توصیف قلم را برای استفاده با دستگاه خروجی
.B dvi
در
.MR groff 1
ایجاد می‌کند.
.
آرگومان
.I tfm-file
نام فایل متریک قلم \*(tx برای این قلم است.
.
فایل
.I map-file
شناسه‌های نویسه‌های معمولی یا ویژه
.I groff
را به اندیس‌های گلیف در قلم اختصاص می‌دهد؛
این فایل باید از دنباله‌ای از خطوط به فرم زیر تشکیل شده باشد:
.
.RS
.IR "i c1" \~\&.\|.\|.\&\~ cn
.RE
.
که در آن
.I i
موقعیت گلیف در قلم بر حسب ده‌دهی است،
و
.I c1
تا
.I cn
شناسه‌های گلیف به شکلی هستند که در توصیف‌های قلم
.I groff
به کار می‌روند.
.
اگر گلیفی هیچ نامی در
.I groff
نداشته باشد اما در
.I tfm-file
موجود باشد، در فایل توصیف قلم
.I groff
به عنوان یک گلیف بدون نام قرار می‌گیرد.
.
خروجی در قالب
.MR groff_font 5
در
.I font-description
نوشته می‌شود؛ فایلی که متناظر با نام مورد نظر برای قلم در
.I groff
نام‌گذاری شده است.
.
.
.P
اگر قلم \[lq]ویژه\[rq] (special) باشد،
به این معنی که
.I groff
باید هر زمان که گلیفی در قلم فعلی پیدا نشد آن را جستجو کند،
از گزینه
.B \-s
استفاده کرده و نام
.I font-description
را در دستورالعمل
.B fonts
در فایل
.I DESC
دستگاه خروجی مشخص کنید.
.
.
.P
برای دستیابی به کیفیت مناسب در حروف‌چینی ریاضی،
.I groff
به اطلاعات متریک قلمی نیاز دارد که در
.I tfm-file
وجود ندارد.
.
علت این امر آن است که \*(tx دارای قلم‌های ایتالیک ریاضی مجزا است،
در حالی که
.I groff
از قلم‌های ایتالیک عادی برای ریاضیات استفاده می‌کند.
.
اطلاعات اضافی مورد نیاز
.I groff
توسط دو آرگومان ماکروی
.B math_fit
در برنامه‌های Metafont برای قلم‌های Computer Modern ارائه می‌شود.
.
در یک قلم متن (قلمی که در آن
.B math_fit
برابر false است)،
برنامه Metafont معمولاً این دو آرگومان را نادیده می‌گیرد.
.
می‌توان Metafont را طوری تنظیم کرد که این اطلاعات را با بارگذاری تعریف زیر پس از
.B cmbase
هنگام ایجاد
.IR cm.base ،
در فایل‌های GF
(\[lq]generic font\[rq])
تولیدی خود قرار دهد:
.
.RS
.EX
def ignore_math_fit(expr left_adjustment,right_adjustment) =
    special "adjustment";
    numspecial left_adjustment*16/designsize;
    numspecial right_adjustment*16/designsize;
    enddef;
.EE
.RE
.
برای خانواده قلم‌های EC،
تعریف زیر را پس از
.B exbase
بارگذاری کنید؛
همچنین می‌توانید وصله زدن محلی فایل
.I exbase.mf
را مد نظر قرار دهید:
.
.RS
.EX
def ignore_math_fit(expr left_adjustment,right_adjustment) =
    ori_special "adjustment";
    ori_numspecial left_adjustment*16/designsize;
    ori_numspecial right_adjustment*16/designsize;
    enddef;
.EE
.RE
.
تنها تفاوت نسبت به مثال پیشین، پیشوند \[lq]ori_\[rq] برای
\[lq]special\[rq]
و
\[lq]numspecial\[rq]
است.
.
فایل GF ایجادشده با استفاده از این
.I cm.base
یا
.I exbase.mf
تغییریافته باید با گزینه
.B \-g
مشخص شود؛
گزینه‌ای که
.I نباید
برای قلمی داده شود که
.B math_fit
در آن true است.
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
گزینه
.B \-\-help
پیام راهنمای استفاده را نمایش می‌دهد، در حالی که
.B \-v
و
.B \%\-\-version
اطلاعات نگارش را نمایش می‌دهند؛
پس از آن همگی خارج می‌شوند.
.
.
.TP
.BI \-g \~gf-file
استفاده از
.I gf-file
تولیدشده توسط Metafont حاوی دستورهای
.RB \[lq] special \[rq]
و
.RB \[lq] numspecial \[rq]
برای دریافت اطلاعات متریک قلم اضافی.
.
.
.TP
.BI \-k \~skew-char
نویسه مورب‌سازی (skew character) این قلم در موقعیت
.I skew-char
قرار دارد.
.
آرگومان
.I skew-char
باید یک عدد صحیح باشد؛
می‌تواند بر حسب ده‌دهی،
با صفر آغازین در هشت‌هشتی (octal)،
یا با 0x آغازین در شانزده‌شانزدهی (hexadecimal) داده شود.
.
هرگونه فاصله‌گذاری جفتی (kern) که مؤلفه دوم آن
.I skew-char
باشد، نادیده گرفته می‌شود.
.
.
.TP
.B \-s
افزودن دستورالعمل
.B special
به فایل توصیف قلم.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
دستور
.I tfmtodit
در صورت اجرای موفق با
.RB وضعیت\~ 0
خارج می‌شود؛
اگر برنامه نتواند آرگومان‌های خط فرمان خود را تفسیر کند با
.RB وضعیت\~ 2
و در صورت مواجهه با خطا در حین اجرا با
.RB وضعیت\~ 1
خارج می‌شود.
.
.
.\" ====================================================================
.SH "فایل‌ها (FILES)"
.\" ====================================================================
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:DESC
دستگاه خروجی
.B dvi
را توصیف می‌کند.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/ F
قلم شناخته‌شده با نام
.I F
را بر روی دستگاه
.B dvi
توصیف می‌کند.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%ec.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%msam.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%msbm.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%tc.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%texb.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%texex.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%texi.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%texitt.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%texmi.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%texr.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%texsy.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%textex.map
.TQ
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:\%generate/\:\%textt.map
اندیس‌های گلیف در قلم‌های \*[tx] را به شناسه‌های نویسه‌های معمولی و ویژه
.I groff
نگاشت می‌کنند.
.
فایل
.I \%ec.map
برای
.BR TREC ،
.BR TIEC ،
.BR TBEC ،
.BR TBIEC ،
.BR HREC ،
.BR HIEC ،
.BR HBEC ،
.BR HBIEC ،
.BR CWEC
و
.BR CWIEC ؛
فایل
.I \%msam.map
برای
.BR SA ؛
فایل
.I \%msbm.map
برای
.BR SB ؛
فایل
.I \%tc.map
برای
.BR TRTC ،
.BR TITC ،
.BR TBTC ،
.BR TBITC ،
.BR HRTC ،
.BR HITC ،
.BR HBTC ،
.BR HBITC ،
.BR CWTC
و
.BR CWITC ؛
فایل
.I \%texb.map
برای
.BR TB ،
.BR HR ،
.BR HI ،
.BR HB
و
.BR HBI ؛
فایل
.I \%texex.map
برای
.BR EX ؛
فایل
.I \%texi.map
برای
.B TI
و
.BR TBI ؛
فایل
.I \%texitt.map
برای
.BR CWI ؛
فایل
.I \%texmi.map
برای
.BR MI ؛
فایل
.I \%texr.map
برای
.BR TR ؛
فایل
.I \%texsy.map
برای
.BR S ؛
فایل
.I \%textex.map
برای
.BR SC ؛
و فایل
.I \%textt.map
برای
.B CW
به کار می‌رود.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.MR groff 1 ,
.MR grodvi 1 ,
.MR groff_font 5
.
.
.\" Clean up.
.rm tx
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_tfmtodit_1_man_C]
.do rr *groff_tfmtodit_1_man_C
.
.
