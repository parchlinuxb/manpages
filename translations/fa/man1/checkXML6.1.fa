.TH "\FBCHECKXML6\FR" "1" "2014\-03\-04" "KDE Frameworks Frameworks 6.0" "checkXML6 User's Manual"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
