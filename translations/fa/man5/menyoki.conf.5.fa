.SH "محیط (ENVIRONMENT)"
.PP
متغیرهای محیطی متناظر را می‌توان برای بازنویسی گزینه‌ها و فلگ‌های خط فرمان تنظیم کرد.
الگوی کلی متغیرهایی که [B]menyoki[R] بررسی می‌کند به صورت زیر است:
.PP
[C]MENYOKI_{SECTION}_{ARGUMENT}=value[R]
.PP
علاوه بر این، [C]MENYOKI_WINDOW_SYSTEM[R] را می‌توان برای بازنویسی سیستم پنجره که در غیر این صورت بر اساس وجود [C]WAYLAND_DISPLAY[R] تشخیص داده می‌شود، روی [C]x11[R] یا [C]wayland[R] تنظیم کرد.
.SS "مثال‌ها (Examples)"
.PP
.TS
tab(@);
lw(35.6n) lw(34.4n).
T{
دستور
T}@T{
متغیرهای محیطی
T}
_
T{
[C]menyoki --quiet[R]
T}@T{
[C]MENYOKI_GENERAL_QUIET=true[R]
T}
T{
[C]menyoki record gif --fps 10 save --timestamp[R]
T}@T{
[C]MENYOKI_GIF_FPS=10 MENYOKI_SAVE_TIMESTAMP=true[R]
T}
T{
[C]menyoki capture --size 200x300 jpg --quality 100[R]
T}@T{
[C]MENYOKI_CAPTURE_SIZE=200x300 MENYOKI_JPG_QUALITY=100[R]
T}
T{
[C]menyoki edit test.png --ratio 2.0 --filter triangle[R]
T}@T{
[C]MENYOKI_EDIT_RATIO=2.0 MENYOKI_EDIT_FILTER=triangle[R]
T}
T{
[C]menyoki split test.gif --dir frames/ pnm --format graymap[R]
T}@T{
[C]MENYOKI_SPLIT_DIR=frames/ MENYOKI_PNM_FORMAT=graymap[R]
T}
T{
[C]menyoki analyze test.png --timestamp save --date %H%M%S[R]
T}@T{
[C]MENYOKI_ANALYZE_TIMESTAMP=true MENYOKI_SAVE_DATE=%H%M%S[R]
T}
T{
[C]menyoki view test.png --transparent[R]
T}@T{
[C]MENYOKI_VIEW_TRANSPARENT=true[R]
T}
.TE
