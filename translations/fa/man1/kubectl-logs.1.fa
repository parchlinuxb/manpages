.nh
.TH KUBERNETES 1 "Jan 2015" "Eric Paris" "راهنمای کاربر kubernetes"

.SH "نام (NAME)"
kubectl-logs \- چاپ لاگ‌های یک کانتینر در یک پاد


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubectl logs\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
چاپ لاگ‌های یک کانتینر در یک پاد یا یک منبع مشخص‌شده. اگر پاد تنها یک کانتینر داشته باشد، نام کانتینر اختیاری است.


.SH "گزینه‌ها (OPTIONS)"
\fB--all-containers\fP=false
	دریافت لاگ‌های تمام کانتینرها در پاد(ها).

.PP
\fB--all-pods\fP=false
	دریافت لاگ‌ها از تمامی پاد(ها). مقدار prefix را روی true تنظیم می‌کند.

.PP
\fB-c\fP, \fB--container\fP=""
	چاپ لاگ‌های این کانتینر

.PP
\fB-f\fP, \fB--follow\fP=false
	مشخص می‌کند که آیا لاگ‌ها باید به صورت زنده و پیوسته (stream) جریان داشته باشند یا خیر.

.PP
\fB--ignore-errors\fP=false
	در هنگام مشاهده / دنبال کردن لاگ‌های پاد، به خطاهای رخ داده اجازه می‌دهد که غیرمهلک (non-fatal) تلقی شوند

.PP
\fB--insecure-skip-tls-verify-backend\fP=false
	صرف‌نظر کردن از تأیید هویت kubelet که لاگ‌ها از آن درخواست می‌شوند. از نظر تئوری، یک مهاجم می‌تواند محتوای لاگ نامعتبر ارسال کند. ممکن است بخواهید زمانی که گواهینامه‌های ارائه سرویس kubelet شما منقضی شده‌اند از این گزینه استفاده کنید.

.PP
\fB--limit-bytes\fP=0
	حداکثر بایت‌های لاگ برای بازگرداندن. پیش‌فرض بدون محدودیت است.

.PP
\fB--max-log-requests\fP=5
	تعیین حداکثر تعداد لاگ‌های همزمانی که هنگام استفاده از طریق selector دنبال می‌شوند. پیش‌فرض ۵ است.

.PP
\fB--pod-running-timeout\fP=20s
	مدت زمان انتظار (مانند 5s، 2m یا 3h، بیشتر از صفر) تا حداقل یک پاد در حال اجرا باشد

.PP
\fB--prefix\fP=false
	افزودن منبع لاگ (نام پاد و نام کانتینر) به عنوان پیشوند به هر خط از لاگ

.PP
\fB-p\fP, \fB--previous\fP=false
	در صورت true بودن، چاپ لاگ‌های نمونه قبلی کانتینر در یک پاد در صورت وجود.

.PP
\fB-l\fP, \fB--selector\fP=""
	انتخاب‌گر (پرس‌وجوی برچسب) برای فیلتر کردن، از '='، '=='، '!='، 'in' و 'notin' پشتیبانی می‌کند (مانند -l key1=value1,key2=value2,key3 in (value3)). اشیای منطبق باید تمام محدودیت‌های برچسب مشخص‌شده را برآورده کنند.

.PP
\fB--since\fP=0s
	فقط بازگرداندن لاگ‌های جدیدتر از یک مدت زمان نسبی مانند 5s، 2m یا 3h. پیش‌فرض تمام لاگ‌ها است. فقط یکی از since-time یا since می‌تواند استفاده شود.

.PP
\fB--since-time\fP=""
	فقط بازگرداندن لاگ‌ها پس از یک تاریخ مشخص (RFC3339). پیش‌فرض تمام لاگ‌ها است. فقط یکی از since-time یا since می‌تواند استفاده شود.

.PP
\fB--tail\fP=-1
	تعداد خطوط اخیر فایل لاگ برای نمایش. در حالت بدون selector پیش‌فرض 1- است که تمام خطوط لاگ را نشان می‌دهد؛ در غیر این صورت، در صورت ارائه یک selector پیش‌فرض 10 است.

.PP
\fB--timestamps\fP=false
	درج برچسب‌های زمانی (timestamps) در هر خط از خروجی لاگ


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--as\fP=""
	نام کاربری برای جعل هویت (impersonate) در این عملیات. کاربر می‌تواند یک کاربر معمولی یا یک حساب خدمت (service account) در یک فضای نام باشد.

.PP
\fB--as-group\fP=[]
	گروه برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای تعیین چندین گروه تکرار شود.

.PP
\fB--as-uid\fP=""
	شناسه UID برای جعل هویت در این عملیات.

.PP
\fB--as-user-extra\fP=[]
	اطلاعات اضافی کاربر برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای مشخص کردن چندین مقدار برای یک کلید یکسان تکرار شود.

.PP
\fB--cache-dir\fP="/home/username/.kube/cache"
	دایرکتوری پیش‌فرض کش

.PP
\fB--certificate-authority\fP=""
	مسیر فایل گواهی برای مرجع صدور گواهی (certificate authority)

.PP
\fB--client-certificate\fP=""
	مسیر فایل گواهی کلاینت برای TLS

.PP
\fB--client-key\fP=""
	مسیر فایل کلید کلاینت برای TLS

.PP
\fB--cluster\fP=""
	نام کلاستر kubeconfig برای استفاده

.PP
\fB--context\fP=""
	نام کانتکست kubeconfig برای استفاده

.PP
\fB--disable-compression\fP=false
	در صورت true بودن، انصراف از فشرده‌سازی پاسخ‌ها برای تمام درخواست‌ها به سرور

.PP
\fB--insecure-skip-tls-verify\fP=false
	در صورت true بودن، اعتبار گواهی سرور بررسی نخواهد شد. این کار اتصالات HTTPS شما را ناامن می‌کند

.PP
\fB--kubeconfig\fP=""
	مسیر فایل kubeconfig برای استفاده در درخواست‌های CLI.

.PP
\fB--kuberc\fP=""
	مسیر فایل kuberc برای استفاده در ترجیحات (preferences). این قابلیت می‌تواند با export کردن feature gate به صورت KUBECTL_KUBERC=false یا خاموش کردن ویژگی با KUBERC=off غیرفعال شود.

.PP
\fB--match-server-version\fP=false
	الزام به تطابق نسخه سرور با نسخه کلاینت

.PP
\fB-n\fP, \fB--namespace\fP=""
	در صورت وجود، دامنهٔ فضای نام (namespace) برای این درخواست CLI

.PP
\fB--password\fP=""
	رمز عبور برای احراز هویت پایه (basic authentication) در سرور API

.PP
\fB--profile\fP="none"
	نام پروفایل برای ثبت. یکی از موارد (none|cpu|heap|goroutine|threadcreate|block|mutex|trace)

.PP
\fB--profile-output\fP="profile.pprof"
	نام فایلی که پروفایل در آن نوشته می‌شود

.PP
\fB--request-timeout\fP="0"
	مدت زمان انتظار پیش از انصراف از یک درخواست به سرور. مقادیر غیر صفر باید شامل واحد زمانی متناظر باشند (مانند 1s، 2m، 3h). مقدار صفر یعنی درخواست‌ها هرگز دچار وقفه زمانی (timeout) نشوند.

.PP
\fB-s\fP, \fB--server\fP=""
	آدرس و پورت سرور Kubernetes API

.PP
\fB--tls-server-name\fP=""
	نام سرور برای استفاده در اعتبارسنجی گواهی سرور. در صورت عدم ارائه، از نام هاست مورد استفاده برای برقراری ارتباط با سرور استفاده می‌شود

.PP
\fB--token\fP=""
	توکن حامل (Bearer token) برای احراز هویت در سرور API

.PP
\fB--user\fP=""
	نام کاربر kubeconfig برای استفاده

.PP
\fB--username\fP=""
	نام کاربری برای احراز هویت پایه در سرور API

.PP
\fB--version\fP=false
	گزینه \fB\-\-version\fP یا \fB\-\-version=raw\fP اطلاعات نسخه را چاپ کرده و خارج می‌شود؛ \fB\-\-version=vX.Y.Z...\fP نسخه گزارش‌شده را تنظیم می‌کند

.PP
\fB--warnings-as-errors\fP=false
	در نظر گرفتن هشدارهای دریافتی از سرور به عنوان خطا و خروج با کد وضعیت غیر صفر


.SH "مثال‌ها (EXAMPLES)"
.EX
  # بازگرداندن تصویر لحظه‌ای (snapshot) لاگ‌ها از پاد nginx با تنها یک کانتینر
  kubectl logs nginx
  
  # بازگرداندن تصویر لحظه‌ای لاگ‌ها از پاد nginx، همراه با پیشوند نام پاد و کانتینر مبدا در هر خط
  kubectl logs nginx --prefix
  
  # بازگرداندن تصویر لحظه‌ای لاگ‌ها از پاد nginx، با محدود کردن خروجی به ۵۰۰ بایت
  kubectl logs nginx --limit-bytes=500
  
  # بازگرداندن تصویر لحظه‌ای لاگ‌ها از پاد nginx، با حداکثر ۲۰ ثانیه انتظار برای شروع به کار آن
  kubectl logs nginx --pod-running-timeout=20s
  
  # بازگرداندن تصویر لحظه‌ای لاگ‌ها از پاد nginx دارای چندین کانتینر
  kubectl logs nginx --all-containers=true
  
  # بازگرداندن تصویر لحظه‌ای لاگ‌ها از تمام پادها در استقرار nginx
  kubectl logs deployment/nginx --all-pods=true
  
  # بازگرداندن تصویر لحظه‌ای لاگ‌ها از تمام کانتینرهای پادهای مشخص‌شده با برچسب app=nginx
  kubectl logs -l app=nginx --all-containers=true
  
  # بازگرداندن تصویر لحظه‌ای لاگ‌ها از تمام پادهای مشخص‌شده با برچسب app=nginx، با محدود کردن درخواست‌های همزمان لاگ به ۱۰ پاد
  kubectl logs -l app=nginx --max-log-requests=10
  
  # بازگرداندن تصویر لحظه‌ای از لاگ‌های کانتینر متوقف‌شده قبلی ruby از پاد web-1
  kubectl logs -p -c ruby web-1
  
  # آغاز جریان زنده لاگ‌ها از پاد nginx، با ادامه دادن حتی در صورت وقوع خطا
  kubectl logs nginx -f --ignore-errors=true
  
  # آغاز جریان زنده لاگ‌های کانتینر ruby در پاد web-1
  kubectl logs -f -c ruby web-1
  
  # آغاز جریان زنده لاگ‌ها از تمام کانتینرهای پادهای مشخص‌شده با برچسب app=nginx
  kubectl logs -f -l app=nginx --all-containers=true
  
  # نمایش تنها ۲۰ خط آخر خروجی در پاد nginx
  kubectl logs --tail=20 nginx
  
  # نمایش تمام لاگ‌های پاد nginx که در یک ساعت گذشته نوشته شده‌اند
  kubectl logs --since=1h nginx
  
  # نمایش تمام لاگ‌ها همراه با برچسب زمانی از پاد nginx از تاریخ ۳۰ اوت ۲۰۲۴ ساعت 06:00:00 UTC به بعد
  kubectl logs nginx --since-time=2024-08-30T06:00:00Z --timestamps=true
  
  # نمایش لاگ‌ها از یک kubelet با گواهینامه ارائه سرویس منقضی‌شده
  kubectl logs --insecure-skip-tls-verify-backend nginx
  
  # بازگرداندن تصویر لحظه‌ای لاگ‌ها از نخستین کانتینر یک job با نام hello
  kubectl logs job/hello
  
  # بازگرداندن تصویر لحظه‌ای لاگ‌ها از کانتینر nginx-1 یک استقرار با نام nginx
  kubectl logs deployment/nginx -c nginx-1
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubectl(1)\fP,


.SH "تاریخچه (HISTORY)"
ژانویه ۲۰۱۵، در ابتدا توسط Eric Paris (eparis at redhat dot com) بر پایه محتوای منبع kubernetes گردآوری شد، اما امید است که از آن زمان به بعد به طور خودکار تولید شده باشند!
