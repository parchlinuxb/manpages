.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-manifest-annotate \- افزودن اطلاعات تکمیلی به یک مانیفست محلی ایمیج


.SH "خلاصه دستور (SYNOPSIS)"
\fBdocker manifest annotate [OPTIONS] MANIFEST_LIST MANIFEST\fP


.SH "شرح (DESCRIPTION)"
افزودن اطلاعات تکمیلی به یک مانیفست محلی ایمیج


.SH "گزینه‌ها (OPTIONS)"
\fB--arch\fP=""
	تنظیم معماری

.PP
\fB--os\fP=""
	تنظیم سیستم‌عامل

.PP
\fB--os-features\fP=[]
	تنظیم ویژگی سیستم‌عامل

.PP
\fB--os-version\fP=""
	تنظیم نگارش سیستم‌عامل

.PP
\fB--variant\fP=""
	تنظیم متغیر معماری


.SH "ببینید (SEE ALSO)"
\fBdocker-manifest(1)\fP
