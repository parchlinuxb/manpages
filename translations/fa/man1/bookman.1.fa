.\" Text automatically generated by txt2man
.TH bookman 1 "14 July 2024" "txt2man-1.7.1" ""
.SH "نام (NAME)"
bookman \- تبدیل کتاب‌های الکترونیکی و متنی به صفحات راهنما
.SH "خلاصه دستور (SYNOPSIS)"
.nf
.fam C
\fBbookman\fP [\fB-pPxn\fP] [\fB-o\fP \fIoutfile\fP] [\fB-a\fP \fIauthor\fP] [\fB-d\fP \fIdate\fP] [\fB-r\fP \fIrelease\fP]
[\fB-t\fP \fItitle\fP] [\fB-v\fP \fIvolume\fP] [\fB-c\fP \fIcoverfile\fP] [\fImanfile\fP]
.fam T
.fi
.SH "توضیحات (DESCRIPTION)"
دستور
\fBbookman\fP
مجموعه‌ای از فایل‌های صفحات راهنما که با آرگومان‌های
\fImanfile\fP
مشخص شده‌اند را کامپایل می‌کند؛ اگر هیچ
\fImanfile\fP
مشخص نشده باشد، نام فایل‌ها از ورودی استاندارد خوانده می‌شوند.
.SH "گزینه‌ها (OPTIONS)"
.TP
.B \-p
قالب خروجی PDF.
.TP
.B \-P
قالب خروجی Postscript.
.TP
.B \-x
پیش‌نمایش X11 با استفاده از
\fBgxditview\fP(1).
.TP
.B \-n
بدون قالب‌بندی؛ خروجی مستقیماً به قالب میانی gtroff ارسال می‌شود.
.TP
.BI \-o " outfile"
خروجی در فایل
\fIoutfile\fP.
پیش‌فرض خروجی استاندارد است.
.TP
.BI \-a " author"
تنظیم
\fIauthor\fP
(نویسنده) در صفحه جلد.
.TP
.BI \-d " date"
تنظیم
\fIdate\fP
(تاریخ) در صفحه جلد.
.TP
.BI \-r " release"
تنظیم نام کتاب و
\fIrelease\fP
(نسخه انتشار) در صفحه جلد.
.TP
.BI \-t " title"
تنظیم
\fItitle\fP
(عنوان) در صفحه جلد.
.TP
.BI \-v " volume"
مشخص کردن نام
\fIvolume\fP
(جلد).
.TP
.BI \-c " coverfile"
استفاده از فایل
\fIcoverfile\fP
برای تولید صفحه جلد؛ یعنی تمام صفحات پیش از فهرست مطالب.
\fIcoverfile\fP
باید در قالب
\fBgroff_ms\fP(7)
باشد.
.SH "متغیرهای محیطی (ENVIRONMENT)"
.TP
.B SOURCE_DATE_EPOCH
برچسب زمانی یونیکس (Unix timestamp) که به جای تاریخ جاری، برای
\fIdate\fP
در سربرگ استفاده می‌شود.
.SH "مثال‌ها (EXAMPLES)"
برای ساخت کتابچه راهنمای مرجع از صفحات بخش ۲ راهنما:
.PP
.nf
.fam C
    $ cd /usr/share/man/man2
    $ bookman -p -t 'Unix Reference Manual' * >book.pdf
.fam T
.fi
.SH "همچنین ببینید (SEE ALSO)"
\fBman\fP(1), \fBmandoc\fP(7), \fBgroff_ms\fP(7), \fBgroff\fP(1), \fBtroff\fP(1), \fBgrops\fP(1),
\fBgxditview\fP(1), \fBps2pdf\fP(1)
.SH "نویسندگان (AUTHORS)"
Marc Vertes <mvertes@free.fr>
