.nh
.TH "desync" "1" "Sep 2026" "desync" ""

.SH "نام (NAME)"
desync-manpage \- Generate manpages for desync


.SH "خلاصه دستور (SYNOPSIS)"
\fBdesync manpage <output-directory> [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Generates man pages for desync and all of its commands into the given directory.


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	help for manpage

.PP
\fB--manual\fP=""
	manual

.PP
\fB--section\fP="1"
	section

.PP
\fB--source\fP="desync"
	source

.PP
\fB--title\fP="desync"
	title


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config file (default $HOME/.config/desync/config.json)

.PP
\fB--digest\fP="sha512-256"
	digest algorithm, sha512-256 or sha256

.PP
\fB--verbose\fP[=false]
	verbose mode


.SH "مثال (EXAMPLE)"
.EX
  desync manpage /tmp/man
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBdesync(1)\fP


