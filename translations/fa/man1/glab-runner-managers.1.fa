.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-runner-managers \- فهرست کردن مدیران رانر.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab runner managers  [flags]\fP


.SH "توضیحات (DESCRIPTION)"
مدیران یک رانر را فهرست می‌کند.


.SH "گزینه‌ها (OPTIONS)"
\fB--jq\fP=""
	فیلتر کردن خروجی JSON با یک عبارت jq.

.PP
\fB-F\fP, \fB--output\fP="text"
	قالب‌بندی خروجی به‌صورت: text یا json.

.PP
\fB-R\fP, \fB--repo\fP=""
	انتخاب مخزنی دیگر. می‌توانید از OWNER/REPO یا GROUP/NAMESPACE/REPO استفاده کنید. نشانی کامل URL یا نشانی Git نیز پذیرفته می‌شود.


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB-h\fP, \fB--help\fP[=false]
	نمایش راهنما برای این دستور.


.SH "مثال‌ها (EXAMPLES)"
.EX
# فهرست کردن مدیران رانر 1
glab runner managers 1

# فهرست کردن مدیران به‌صورت JSON
glab runner managers 1 --output json
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-runner(1)\fP
