.TH podman-machine-os 1
.SH "نام (NAME)"
podman-machine-os \- مدیریت سیستم‌عامل ماشین مجازی پادمن

.SH "خلاصه دستور (SYNOPSIS)"
\fBpodman machine os\fP \fIزیردستور\fP

.SH "توضیحات (DESCRIPTION)"
دستور \fBpodman machine os\fR مجموعه‌ای از زیردستورها برای مدیریت سیستم‌عامل ماشین مجازی پادمن است.

.SH "زیردستورها (SUBCOMMANDS)"
.TS
allbox;
l l l 
l l l .
\fBدستور\fP	\fBصفحه راهنما\fP	\fBتوضیحات\fP
apply	podman-machine-os-apply(1)	T{
اعمال یک ایمیج OCI روی سیستم‌عامل ماشین پادمن
T}
upgrade	podman-machine-os-upgrade(1)	ارتقای سیستم‌عامل ماشین پادمن
.TE

.SH "همچنین ببینید (SEE ALSO)"
\fBpodman(1)\fP, \fBpodman-machine(1)\fP, \fBpodman-machine-os-apply(1)\fP, \fBpodman-machine-os-upgrade(1)\fP

