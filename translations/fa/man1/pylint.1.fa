.SS non\-iterator\-returned / E0301
.sp
\fBMessage emitted:\fP
.sp
\fB__iter__ returns non\-iterator\fP
.sp
\fBDescription:\fP
.sp
\fIUsed when an __iter__ method returns something which is not an iterable (i.e. has no \(ga__next__\(ga method)\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
import random


class GenericAstrology:
    def __init__(self, signs, predictions):
        self.signs = signs
        self.predictions = predictions

    def __iter__(self):  # [non\-iterator\-returned]
        self.index = 0
        self.number_of_prediction = len(self.predictions)
        return self


SIGNS = [\(dqAries\(dq, \(dqTaurus\(dq, \(dqGemini\(dq, \(dqCancer\(dq, \(dqLeo\(dq, \(dqVirgo\(dq, \(dqLibra\(dq]
PREDICTIONS = [\(dqgood things\(dq, \(dqbad thing\(dq, \(dqexistential dread\(dq]
for sign, prediction in GenericAstrology(SIGNS, PREDICTIONS):
    print(f\(dq{sign} : {prediction} today\(dq)

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
import random


class GenericAstrology:
    def __init__(self, signs, predictions):
        self.signs = signs
        self.predictions = predictions

    def __iter__(self):
        self.index = 0
        self.number_of_prediction = len(self.predictions)
        return self

    def __next__(self):
        if self.index == len(self.signs):
            raise StopIteration
        self.index += 1
        prediction_index = random.randint(0, self.number_of_prediction \- 1)
        return self.signs[self.index \- 1], self.predictions[prediction_index]


SIGNS = [\(dqAries\(dq, \(dqTaurus\(dq, \(dqGemini\(dq, \(dqCancer\(dq, \(dqLeo\(dq, \(dqVirgo\(dq, \(dqLibra\(dq]
PREDICTIONS = [\(dqgood things\(dq, \(dqbad thing\(dq, \(dqexistential dread\(dq]
for sign, prediction in GenericAstrology(SIGNS, PREDICTIONS):
    print(f\(dq{sign} : {prediction} today\(dq)

.EE
