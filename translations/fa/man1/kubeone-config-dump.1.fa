.SH "نام (NAME)"
kubeone-config-dump \- Merge the KubeOneCluster manifest with the Terraform state and dump it to the stdout


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubeone config dump [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Merge the KubeOneCluster manifest with the Terraform state and dump it to the stdout


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	help for dump


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--credentials\fP=""
	File to source credentials and secrets from

.PP
\fB-d\fP, \fB--debug\fP[=false]
	debug output with stacktrace

.PP
\fB-l\fP, \fB--log-format\fP="text"
	format for logging

.PP
\fB-m\fP, \fB--manifest\fP="./kubeone.yaml"
	Path to the KubeOne config

.PP
\fB-t\fP, \fB--tfjson\fP=""
	Source for terraform output in JSON - to read from stdin. If path is a file, contents will be used. If path is a dictionary, \fBterraform output -json\fR is executed in this path

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


.SH "مثال (EXAMPLE)"
.EX
kubeone config dump -m kubeone.yaml -t tf.json
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubeone-config(1)\fP


