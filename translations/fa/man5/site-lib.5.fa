\&\ \ \e\c
\&
.br
\&\ \ \ \ metaregistry\c
\&
.br
\&\ \ \ \ |\c
\&
.br
\&\ \ \ \ +-\ META.package1\c
\&
.br
\&\ \ \ \ +-\ META.package2\c
