.SS overlapping\-except / W0714
.sp
\fBMessage emitted:\fP
.sp
\fBOverlapping exceptions (%s)\fP
.sp
\fBDescription:\fP
.sp
\fIUsed when exceptions in handler overlap or are identical\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
def divide_x_by_y(x: float, y: float):
    try:
        print(x / y)
    except (ArithmeticError, FloatingPointError) as e:  # [overlapping\-except]
        print(f\(dqThere was an issue: {e}\(dq)

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.sp
\fBless_generic_first.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
def divide_x_by_y(x: float, y: float):
    try:
        print(x / y)
    except FloatingPointError as e:
        print(f\(dqThere was a FloatingPointError: {e}\(dq)
    except ArithmeticError as e:
        # FloatingPointError  were already caught at this point
        print(f\(dqThere was an OverflowError or a ZeroDivisionError: {e}\(dq)

.EE
.UNINDENT
