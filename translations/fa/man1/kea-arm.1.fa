  map ::= \(dq{\(dq map_content \(dq}\(dq

  map_value ::= map

  map_content ::=
             | not_empty_map

  not_empty_map ::= STRING \(dq:\(dq value
               | not_empty_map \(dq,\(dq STRING \(dq:\(dq value
               | not_empty_map \(dq,\(dq

  list_generic ::= \(dq[\(dq list_content \(dq]\(dq

  list_content ::=
              | not_empty_list

  not_empty_list ::= value
                | not_empty_list \(dq,\(dq value
                | not_empty_list \(dq,\(dq

  unknown_map_entry ::= STRING \(dq:\(dq

  netconf_syntax_map ::= \(dq{\(dq global_object \(dq}\(dq

  global_object ::= \(dqNetconf\(dq \(dq:\(dq \(dq{\(dq global_params \(dq}\(dq
               | global_object_comma

  global_object_comma ::= global_object \(dq,\(dq

  global_params ::=
               | not_empty_global_params

  not_empty_global_params ::= global_param
                         | not_empty_global_params \(dq,\(dq global_param
                         | not_empty_global_params \(dq,\(dq

  global_param ::= boot_update
              | subscribe_changes
              | validate_changes
              | managed_servers
              | hooks_libraries
              | loggers
              | user_context
              | comment
              | unknown_map_entry

  boot_update ::= \(dqboot\-update\(dq \(dq:\(dq BOOLEAN

  subscribe_changes ::= \(dqsubscribe\-changes\(dq \(dq:\(dq BOOLEAN

  validate_changes ::= \(dqvalidate\-changes\(dq \(dq:\(dq BOOLEAN

  user_context ::= \(dquser\-context\(dq \(dq:\(dq map_value

  comment ::= \(dqcomment\(dq \(dq:\(dq STRING

  hooks_libraries ::= \(dqhooks\-libraries\(dq \(dq:\(dq \(dq[\(dq hooks_libraries_list \(dq]\(dq

  hooks_libraries_list ::=
                      | not_empty_hooks_libraries_list

  not_empty_hooks_libraries_list ::= hooks_library
                                | not_empty_hooks_libraries_list \(dq,\(dq hooks_library
                                | not_empty_hooks_libraries_list \(dq,\(dq

  hooks_library ::= \(dq{\(dq hooks_params \(dq}\(dq

  hooks_params ::= hooks_param
              | hooks_params \(dq,\(dq hooks_param
              | hooks_params \(dq,\(dq
              | unknown_map_entry

  hooks_param ::= library
             | parameters

  library ::= \(dqlibrary\(dq \(dq:\(dq STRING

  parameters ::= \(dqparameters\(dq \(dq:\(dq map_value

  managed_servers ::= \(dqmanaged\-servers\(dq \(dq:\(dq \(dq{\(dq servers_entries \(dq}\(dq

  servers_entries ::=
                 | not_empty_servers_entries

  not_empty_servers_entries ::= server_entry
                           | not_empty_servers_entries \(dq,\(dq server_entry
                           | not_empty_servers_entries \(dq,\(dq

  server_entry ::= dhcp4_server
              | dhcp6_server
              | d2_server
              | unknown_map_entry

  dhcp4_server ::= \(dqdhcp4\(dq \(dq:\(dq \(dq{\(dq managed_server_params \(dq}\(dq

  dhcp6_server ::= \(dqdhcp6\(dq \(dq:\(dq \(dq{\(dq managed_server_params \(dq}\(dq

  d2_server ::= \(dqd2\(dq \(dq:\(dq \(dq{\(dq managed_server_params \(dq}\(dq

  managed_server_params ::= managed_server_param
                       | managed_server_params \(dq,\(dq managed_server_param
                       | managed_server_params \(dq,\(dq

  managed_server_param ::= model
                      | boot_update
                      | subscribe_changes
                      | validate_changes
                      | control_socket
                      | user_context
                      | comment
                      | unknown_map_entry

  model ::= \(dqmodel\(dq \(dq:\(dq STRING

  control_socket ::= \(dqcontrol\-socket\(dq \(dq:\(dq \(dq{\(dq control_socket_params \(dq}\(dq

  control_socket_params ::= control_socket_param
                       | control_socket_params \(dq,\(dq control_socket_param
                       | control_socket_params \(dq,\(dq

  control_socket_param ::= socket_type
                      | socket_name
                      | socket_url
                      | user_context
                      | comment
                      | unknown_map_entry

  socket_type ::= \(dqsocket\-type\(dq \(dq:\(dq socket_type_value

  socket_type_value ::= \(dqunix\(dq
                   | \(dqhttp\(dq
                   | \(dqstdout\(dq

  socket_name ::= \(dqsocket\-name\(dq \(dq:\(dq STRING

  socket_url ::= \(dqsocket\-url\(dq \(dq:\(dq STRING

  loggers ::= \(dqloggers\(dq \(dq:\(dq \(dq[\(dq loggers_entries \(dq]\(dq

  loggers_entries ::= logger_entry
                 | loggers_entries \(dq,\(dq logger_entry
                 | loggers_entries \(dq,\(dq

  logger_entry ::= \(dq{\(dq logger_params \(dq}\(dq

  logger_params ::= logger_param
               | logger_params \(dq,\(dq logger_param
               | logger_params \(dq,\(dq

  logger_param ::= name
              | output_options_list
              | debuglevel
              | severity
              | user_context
              | comment
              | unknown_map_entry

  name ::= \(dqname\(dq \(dq:\(dq STRING

  debuglevel ::= \(dqdebuglevel\(dq \(dq:\(dq INTEGER

  severity ::= \(dqseverity\(dq \(dq:\(dq STRING

  output_options_list ::= \(dqoutput\-options\(dq \(dq:\(dq \(dq[\(dq output_options_list_content \(dq]\(dq

  output_options_list_content ::= output_entry
                             | output_options_list_content \(dq,\(dq output_entry
                             | output_options_list_content \(dq,\(dq

  output_entry ::= \(dq{\(dq output_params_list \(dq}\(dq

  output_params_list ::= output_params
                    | output_params_list \(dq,\(dq output_params
                    | output_params_list \(dq,\(dq

  output_params ::= output
               | flush
               | maxsize
               | maxver
               | pattern

  output ::= \(dqoutput\(dq \(dq:\(dq STRING

  flush ::= \(dqflush\(dq \(dq:\(dq BOOLEAN

  maxsize ::= \(dqmaxsize\(dq \(dq:\(dq INTEGER

  maxver ::= \(dqmaxver\(dq \(dq:\(dq INTEGER

  pattern ::= \(dqpattern\(dq \(dq:\(dq STRING
