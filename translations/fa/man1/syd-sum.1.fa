.\" Begin generated content:
.TH "SYD\-SUM" "1" "2026\-09\-01"
.PP
.SH "نام (NAME)"
syd-sum \- محاسبه چکسام و چک‌کردن صحت داده‌ها در سندباکس Syd
.PP
.SH "خلاصه دستور (SYNOPSIS)"
.PP
\fBsyd\-sum\fR \fI\-a alg\fR \fI[\-bhx]\fR \fI<file|\->\fR
.PP
.SH "توضیحات (DESCRIPTION)"
.PP
در صورت دادن یک فایل، چکسام آن فایل را محاسبه می‌کند.\&
.PP
تنها فایل‌های معمولی و لوله‌های FIFO (pipes) قابل هش‌کردن هستند.\&
.PP
در صورت عدم ارائه آرگومان مکانی یا دادن "\-" به عنوان آرگومان، چکسام ورودی استاندارد محاسبه می‌شود.\&
.PP
.SH "گزینه‌ها (OPTIONS)"
.PP
.TS
l lx
l lx
l lx
l lx
l lx
l lx.
T{
\fB\-a\fR \fBalg\fR
T}	T{
الگوریتم هش برای استفاده (الزامی).\&
T}
T{

T}	T{
برای فهرست کردن الگوریتم‌های موجود و اندازه خلاصه (digest) آن‌ها از \fB\-a list\fR استفاده کنید.\&
T}
T{

T}	T{
نمونه‌ها: sha256, sha512, sha3\-512, blake2b\-256, md5, crc32c
T}
T{
\fB\-b\fR
T}	T{
خروجی دودویی (باینری).\&
T}
T{
\fB\-x\fR
T}	T{
خروجی هگزادسیمال (پیش‌فرض).\&
T}
T{
\fB\-h\fR
T}	T{
نمایش راهنما.\&
T}
.TE
.sp 1
.SH "مثال‌ها (EXAMPLES)"
.PP
.nf
.RS 4
syd\-sum \-a sha256 /usr/bin/syd
echo hello | syd\-sum \-a blake2b\-512
syd\-sum \-a crc32c \-b /etc/passwd > /tmp/crc\&.bin
.fi
.RE
.PP
.SH "همچنین ببینید (SEE ALSO)"
.PP
