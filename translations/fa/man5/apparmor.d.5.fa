\&\fBRLIMIT\fR = ( \*(Aqcpu\*(Aq | \*(Aqfsize\*(Aq | \*(Aqdata\*(Aq | \*(Aqstack\*(Aq | \*(Aqcore\*(Aq | \*(Aqrss\*(Aq | \*(Aqnofile\*(Aq | \*(Aqofile\*(Aq | \*(Aqas\*(Aq | \*(Aqnproc\*(Aq | \*(Aqmemlock\*(Aq | \*(Aqlocks\*(Aq | \*(Aqsigpending\*(Aq | \*(Aqmsgqueue\*(Aq | \*(Aqnice\*(Aq | \*(Aqrtprio\*(Aq | \*(Aqrttime\*(Aq )
