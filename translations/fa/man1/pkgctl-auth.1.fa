.SH "نام (NAME)"
pkgctl-auth \- Authenticate with services like GitLab.
.SH "خلاصه دستور (SYNOPSIS)"
.sp
pkgctl auth [OPTIONS] [SUBCOMMAND]
.SH "توضیحات (DESCRIPTION)"
.sp
Manage the authorization for the GitLab instance and show its current status.
.SH "گزینه‌ها (OPTIONS)"
.sp
\fB\-h, \-\-help\fP
.RS 4
Show a help text
.RE
.SH "SUBCOMMANDS"
.sp
pkgctl auth login
.RS 4
Authenticate with the GitLab instance
.RE
.sp
pkgctl auth status
.RS 4
View authentication status
.RE
.SH "همچنین ببینید (SEE ALSO)"
.sp
pkgctl\-auth\-login(1)
pkgctl\-auth\-status(1)
.SH "HOMEPAGE"
.sp
\fI\c
.URL "https://gitlab.archlinux.org/archlinux/devtools" "" "\fP"
.sp
