.
.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_grolbp_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY grolbp
.RB [ \-l ]
.RB [ \-c\~\c
.IR num-copies ]
.RB [ \-F\~\c
.IR font-directory ]
.RB [ \-o\~\c
.IR orientation ]
.RB [ \-p\~\c
.IR paper-format ]
.RB [ \-w\~\c
.IR width ]
.RI [ file\~ .\|.\|.]
.YS
.
.SY grolbp
[\c
.BI \-\-copies= num-copies\c
] [\c
.BI \-\-fontdir= font-directory\c
] [\c
.B \-\-landscape\c
] [\c
.BI \-\-linewidth= width\c
] [\c
.BI \-\-orientation= orientation\c
] [\c
.BI \-\-papersize= paper-format\c
]
.RI [ file\~ .\|.\|.]
.YS
.
.
.P
.SY grolbp
.B \-h
.YS
.
.SY grolbp
.B \-\-help
.YS
.
.
.P
.SY grolbp
.B \-v
.YS
.
.SY grolbp
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
این راه‌انداز خروجی
GNU
.I roff
خروجیِ
.MR \%troff 1
را به یک قالب CaPSL و VDM که برای چاپگرهای Canon LBP-4 و LBP-8 مناسب است ترجمه می‌کند.
.
به‌طور معمول،
.I grolbp
توسط
.MR groff 1
فراخوانی می‌شود، هنگامی که گزینه
.RB \[lq] \-T\~lbp \[rq]
به آن داده شده باشد.
.
(در این نصب،
.B \%ps
دستگاه خروجی پیش‌فرض است.)
.
برای ارسال هر یک از گزینه‌های نشان داده‌شده در بالا به
.IR grolbp ،
از گزینه
.B \-P
در
.I groff
استفاده کنید.
.
اگر هیچ آرگومان
.I file
(فایل) داده نشود،
یا اگر
.I file
برابر با \[lq]\-\[rq] باشد،
.I grolbp
جریان ورودی استاندارد را می‌خواند.
.
این برنامه در جریان خروجی استاندارد می‌نویسد.
.
.
.\" ====================================================================
.SS "قلم‌ها (Typefaces)"
.\" ====================================================================
.
این راه‌انداز از قلم‌های مقیاس‌پذیر Dutch،
Swiss
و Swiss-Narrow پشتیبانی می‌کند که هرکدام در سبک‌های معمولی (regular)،
توپر (bold)،
مورب (italic)
و توپر-مورب (bold-italic) در دسترس هستند.
.
علاوه بر این،
قلم‌های بیت‌مپی و تک‌فاصله (monospaced) با نام‌های Courier و Elite در سبک‌های معمولی،
توپر
و
مورب در دسترس هستند؛
قلم Courier در اندازه‌های ۸ و ۱۲ پوینت،
و قلم Elite در اندازه‌های ۸ و ۱۰ پوینت.
.
جدول زیر نام‌های قلم
.I groff
را که برای دسترسی به آن‌ها استفاده می‌شود خلاصه می‌کند.
.
.
.P
.TS
tab(|) allbox center;
Cb Cb Cb Cb Cb
L L L L L
.
Typeface | Roman | Bold | Italic | Bold-Italic
Dutch | TR | TB | TI | TBI
Swiss | HR | HB | HI | HBI
Swiss Narrow | HNR | HNB | HNI | HNBI
Courier | CR | CB | CI |
Elite | ER | EB | EI |
.TE
.
.
.\" ====================================================================
.SS "قالب کاغذ، جهت‌گیری و فایل توصیف دستگاه (Paper format, orientation, and device description file)"
.\" ====================================================================
.
.I grolbp
از قالب‌های کاغذ
.RB \[lq] A4 \[rq]،
.RB \[lq] letter \[rq]،
.RB \[lq] legal \[rq]
و
.RB \[lq] executive \[rq]
پشتیبانی می‌کند.
.
این مقادیر بدون توجه به بزرگی یا کوچکی حروف مطابقت داده می‌شوند.
.
گزینه
.BR \-p ،
.B \-\-papersize
هرگونه تنظیم موجود در فایل توصیف دستگاه
.IR DESC
را بازنویسی می‌کند.
.
اگر هیچ‌کدام قالب کاغذ را مشخص نکنند،
A4 فرض می‌شود.
.
.
.P
در فایل
.IR DESC ،
برنامه
.I grolbp
(بدون حساسیت به حروف بزرگ و کوچک) دستورالعمل
.B orientation
را شناسایی می‌کند که یک آرگومان اجباری می‌پذیرد:
.B portrait
(عمودی) یا
.BR landscape
(افقی).
.
اولین دستورالعمل معتبر جهت‌گیری (orientation) که با آن برخورد شود اعمال خواهد شد.
.\" XXX: This is inconsistent with other description file processing.
.
گزینه‌های خط فرمان
.BR \-l ،
.BR \-o
و
.B \-\-orientation
هرگونه تنظیم موجود در
.IR DESC
را بازنویسی می‌کنند.
.
اگر هیچ‌یک از موارد یادشده جهت‌گیری را مشخص نکنند،
حالت عمودی (portrait) فرض می‌شود.
.
.
.\" ====================================================================
.SS "فایل‌های توصیف قلم (Font description files)"
.\" ====================================================================
.
علاوه بر دستورالعمل‌های فایل توصیف قلم که در
.MR groff_font 5
مستند شده‌اند،
.I grolbp
دستورالعمل
.B lbpname
را شناسایی می‌کند که نام قلم
.I groff
را به نام قلمی که به‌طور داخلی توسط چاپگر استفاده می‌شود نگاشت می‌کند.
.
نحو آن به صورت زیر است:
.RS
.EX
.RI lbpname\~ printer-font-name
.EE
.RE
.
.
آرگومان
.B lbpname
به بزرگی و کوچکی حروف حساس است.
.
نام‌های قلم چاپگر به صورت زیر کدگذاری می‌شوند.
.
.
.P
برای قلم‌های بیت‌مپی،
.I printer-font_name
دارای ساختار
.B N\c
.RI \[la] base-font-name \[ra]\[la] font-style \[ra]
است.
.
.I base-font-name
نام قلم همان‌گونه است که در فهرست قلم‌های چاپگر بدون حرف اول،
تا
(اما نه شامل)
اندازه قلم ظاهر می‌شود.
.
.I font-style
می‌تواند یکی از حروف
.BR R ،
.BR I
یا
.BR B
.\" The bold-italic style apparently was not supported for bitmap fonts.
باشد که به ترتیب نشان‌دهنده سبک‌های معمولی (roman)،
مورب (italic)
و توپر (bold) هستند.
.
به‌عنوان مثال،
اگر \[lq]فهرست قلم A\[rq] در چاپگر
\%\[lq]Nelite12I.ISO_USA\[rq] را نشان دهد،
مدخل متناظر در فایل توصیف قلم
.I groff
برابر با
.RB \[lq] "lbpname NeliteI" \[rq]
خواهد بود.
.
ممکن است برای افزودن پشتیبانی از قلم‌های بیت‌مپی جدید، لازم باشد
.I grolbp
را ویرایش کنید،
زیرا نام‌ها و اندازه‌های در دسترس قلم‌های بیت‌مپی
(همان‌گونه که در بالا مستند شد)
در داخل برنامه به صورت ثابت (hard-coded) تعریف شده‌اند.
.
.
.br
.ne 2v
.P
برای قلم‌های مقیاس‌پذیر،
.I printer-font-name
دقیقاً مشابه نام قلم است همان‌گونه که در \[lq]فهرست قلم A\[rq] چاپگر ظاهر می‌شود.
.
به‌عنوان مثال،
برای انتخاب قلم \[lq]Swiss\[rq] در سبک توپر-مورب (bold-italic)،
که در فهرست قلم به صورت
\%\[lq]Swiss\-BoldOblique\[rq] ظاهر می‌شود،
دستورالعمل مورد نیاز
.RB \[lq] "lbpname Swiss\-BoldOblique" \[rq]
است،
و این همان چیزی است که در فایل توصیف قلم
.I groff
با نام
.I HBI
برای دستگاه
.B lbp
می‌یابیم.
.
.
.\" ====================================================================
.SS "دستورات رسم (Drawing commands)"
.\" ====================================================================
.
برای سازگاری با
.MR grolj4 1 ،
یک دستور رسم اضافی در دسترس است.
.
.
.TP
.BI \[rs]D\[aq]R\~ "dh dv" \[aq]
یک خط‌کش/مستطیل
(مستطیل سیاه توپر)
با یک گوشه در موقعیت رسم،
و گوشه مقابل قطری آن در موقعیت رسم
.RI +( dh , dv )
رسم می‌کند.
.\" XXX , at which the drawing position will be afterward. ?
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
گزینه‌های
.B \-h
و
.B \-\-help
پیام راهنمای نحوه استفاده را نمایش می‌دهند،
در حالی که
.B \-v
و
.B \%\-\-version
اطلاعات نسخه را نشان می‌دهند؛
همگی پس از آن خارج می‌شوند.
.
.
.TP
.BI \-c " num-copies"
.TQ
.BI \-\-copies= num-copies
تعداد
.I num-copies
نسخه از هر صفحه تولید می‌کند.
.
.
.TP
.BI \-F " font-directory"
.TQ
.BI \-\-fontdir= font-directory
دایرکتوری
.RI font-directory /dev name
را به ابتدای مسیر جستجو برای فایل‌های توصیف قلم و دستگاه اضافه می‌کند؛
.I name
نام دستگاه است که معمولاً
.BR lbp
می‌باشد.
.
.
.TP
.B \-l
.TQ
.B \-\-landscape
سند را در جهت افقی (landscape) قالب‌بندی می‌کند.
.
.
.TP
.BI \-o " orientation"
.TQ
.BI \-\-orientation= orientation
سند را در جهت
.IR orientation
داده‌شده قالب‌بندی می‌کند،
که باید
.RB \%\[lq] portrait \[rq]
یا
.RB \%\[lq] landscape \[rq]
باشد.
.
.
.TP
.BI \-p " paper-format"
.TQ
.BI \-\-papersize= paper-format
قالب کاغذ را بر روی
.IR paper-format
تنظیم می‌کند،
که باید یک قالب کاغذ معتبر همان‌طور که در بالا توضیح داده شد باشد.
.
.
.TP
.BI \-w " width"
.TQ
.BI \-\-linewidth= width
ضخامت پیش‌فرض خط را بر روی
.I width
هزارم یک em تنظیم می‌کند؛
مقدار پیش‌فرض
.B 40
(0.04\~em)
است.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
برنامه
.I \%grolbp
در صورت اجرای موفق با
.RB وضعیت\~ 0 ،
اگر نتواند آرگومان‌های خط فرمان خود را تفسیر کند با
.RB وضعیت\~ 2 ،
و در صورت برخورد با یک خطا در حین عملیات با
.RB وضعیت\~ 1
خارج می‌شود.
.
.
.\" ====================================================================
.SH "محیط (ENVIRONMENT)"
.\" ====================================================================
.
.TP
.I GROFF_FONT_PATH
فهرستی از دایرکتوری‌ها را مشخص می‌کند که در آن‌ها باید به دنبال دایرکتوری فایل‌های توصیف دستگاه و قلم دستگاه خروجی انتخاب‌شده گشت.
.
.MR \%troff 1
و
.MR groff_font 5
را ببینید.
.
.
.\" ====================================================================
.SH "فایل‌ها (FILES)"
.\" ====================================================================
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devlbp/\:DESC
دستگاه خروجی
.B lbp
را توصیف می‌کند.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devlbp/ F
قلم شناخته‌شده با نام
.I F
را بر روی دستگاه
.BR lbp
توصیف می‌کند.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%tmac/\:lbp\:.tmac
ماکروهایی را برای استفاده با دستگاه خروجی
.B lbp
تعریف می‌کند.
.
این فایل هنگام انتخاب دستگاه خروجی
.B lbp
به‌طور خودکار توسط
.I troffrc
بارگذاری می‌شود.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.MR groff 1 ,
.MR \%troff 1 ,
.MR groff_out 5 ,
.MR groff_font 5 ,
.MR groff_char 7
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_grolbp_1_man_C]
.do rr *groff_grolbp_1_man_C
.
.
