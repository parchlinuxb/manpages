.TH mfsmetadump "8" "مه 2026" "MooseFS 4.59.2-1" "این بخشی از MooseFS است"
.ss 12 0
.SH "نام (NAME)"
mfsmetadump \- تخلیه اطلاعات متاداده MooseFS در قالبی خوانا برای انسان
.SH "خلاصه دستور (SYNOPSIS)"
\fBmfsmetadump\fP [\fB-d\fP] [\fB\-s\fP \fIsection_name\fP] \fImetadata_file\fP
.SH "توضیحات (DESCRIPTION)"
دستور
\fBmfsmetadump\fP
اطلاعات متادادهٔ MooseFS را در قالبی خوانا برای انسان تخلیه (dump) می‌کند.
خروجی از چندین بخش با انواع مختلف اطلاعات تشکیل شده است. هر بخش شامل داده‌های هدر (سطرهایی که با نویسه هش (#) آغاز می‌شوند) و داده‌های محتوا (که ممکن است خالی باشد) است.
.SH "گزینه‌ها (OPTIONS)"
.PP
\fB-d\fP \- جایگزینی تمامی نویسه‌های غیرقابل‌چاپ (کدهای کمتر از ۳۲ و بیشتر از ۱۲۶) با '.' (این رفتار پیش‌فرض در نگارش‌های قبل از 3.0.110 بود).
.PP
\fB-s\fP \- فقط بخش مشخص‌شده از پرونده را تخلیه می‌کند. بخش‌های ممکن:
.nf
.ta +0.5i
	HEAD - اطلاعات هدر
	SESS - نشست‌های کلاینت
	LABS - برچسب‌ها (استفاده نمی‌شود)
	SCLA - کلاس‌های ذخیره‌سازی
	PATT - بازنویسی الگوها
	NODE - گره‌های درخت (i-nodeها)
	EDGE - یال‌های درخت (نام پرونده‌ها)
	FREE - گره‌های آزاد (i-nodeهای حذف‌شده)
	QUOT - تعاریف سهمیه (quota)
	XATR - داده‌های ویژگی‌های گسترش‌یافته (xattr)
	PACL - داده‌های posix acl
	OPEN - پرونده‌های باز
	FLCK - داده‌های قفل flock
	PLCK - داده‌های قفل‌های پازیکس (lockf,ioctl)
	CSDB - چانک‌سرورهای فعال
	CHNK - چانک‌ها
.fi
.TP
\fBmetadata_file\fP
مسیر پروندهٔ metadata.mfs
.SH "نکات (NOTES)"
هر بخش متاداده \- به‌استثنای بخش HEAD \- از یک مجموعه ثابت از فیلدهای HEADER و یک مجموعه متغیر از فیلدهای اختصاصی آن بخش تشکیل شده است.
بخش HEAD تنها شامل فیلدهای اختصاصی بخش است.
فیلدهای HEADER و تمامی فیلدهای بخش‌ها در زیر فهرست شده‌اند:
.SS "هدر بخش (SECTION HEADER)"
.TP 20
section header
هدر بخش (نوع بخش + نسخه)
.TP
length
طول بخش
.TP
section type
نام بخش
.TP
version
نمایش هگزادسیمال نسخهٔ بخش
.SS "بخش هدر پرونده (HEAD)"
.TP 20
header
نسخهٔ MooseFS
.TP
version
نسخهٔ پرونده متاداده
.TP
fileid
شناسهٔ پرونده متاداده
.SS "بخش نشست‌ها (SESS)"
.TP 20
nextsessionid
اولین شناسهٔ آزاد نشست
.TP
statscount
تعداد آمارهای ذخیره‌شده در هر نشست
.TP 20
SESSION
سطر توصیف‌کنندهٔ یک نشست مجزا
.nf
.ta +1i
s	شناسه نشست (session id)
e	چک‌سام exports
p	نشانی IP
r	شماره اینود ریشه (root inode)
f	فلگ‌های نشست
u	umask
g	حداقل و حداکثر هدف (سطح افزونگی)
t	حداقل و حداکثر زمان نگهداری در سطل زباله (trash retention)
m	شناسه‌های maproot uid,gid و mapall uid,gid
x	عملیات غیرفعال‌شده
d	زمان قطع اتصال (اختیاری)
c	داده‌های آماری ساعت جاری
l	داده‌های آماری ساعت گذشته
i	نام نشست (معمولاً نقطه اتصال محلی)
.fi
.SS "بخش کلاس ذخیره‌سازی (SCLA)، پیش‌تر بخش برچسب‌ها (LABS)"
.TP 20
LABELDESC
سطر حاوی توصیف برچسب (تنها در LABS وجود داشت)
.nf
.ta +1i
l	حرف برچسب
n	توضیحات برچسب
.fi
.TP 20
SCLASS
(پیش‌تر LABELSET) سطر مربوط به کلاس ذخیره‌سازی استفاده‌شده در سیستم
.nf
.ta +1i
#	شناسه کلاس ذخیره‌سازی
x	تنها مدیر (admin only)
m	حالت (mode)
d	تأخیر بایگانی (arch delay)
c	برچسب‌های ایجاد (create labels)
k	برچسب‌های نگهداری (keep labels)
a	برچسب‌های بایگانی (archive labels)
n	نام
.fi
.TP 20
SCLASSMAIN
(استفاده‌شده در نگارش 4.0+ به‌جای SCLASS) سطر پارامترهای عمومی کلاس ذخیره‌سازی
.nf
.ta +1i
#	شناسه کلاس ذخیره‌سازی
x	تنها مدیر (admin only)
m	حالت ایجاد (create mode)
a	حالت بایگانی (arch mode)
d	تأخیر بایگانی (arch delay)
t	حداقل زمان نگهداری در سطل زباله
n	نام
.fi
.TP 20
SCLASSEXPR
(استفاده‌شده در نگارش 4.0+ به‌جای SCLASS) سطر حاوی عبارت برچسب
.nf
.ta +1i
#	شناسه کلاس ذخیره‌سازی
t	نوع ([C]reate، [K]eep، [A]rchive یا [T]rash)
e	عبارت (expression)
.fi
.SS "بخش الگوها (PATT)"
.TP 20
PATTERN
سطر حاوی تعریف الگو
.nf
.ta +1i
v	اولویت (priority)
#	شناسه کلاس ذخیره‌سازی
t	مدت زمان نگهداری در سطل زباله (trash retention)
e	فلگ‌ها (ویژگی‌های اضافی mfs)
u	uid
g	gid
p	الگو (pattern)
.fi
.SS "بخش گره‌ها (NODE)"
.TP 20
maxinode
حداکثر شماره اینود استفاده‌شده در سیستم
.TP
hashelements
تعداد اینودها در جدول هش
.TP 20
NODE
سطر حاوی توصیف گره (اینود)
.nf
.ta +1i +1i
k	نوع گره (-,D,S,F,B,C,L,T,R)
	-	پرونده (file)
	D	دایرکتوری (directory)
	S	سوکت (socket)
	F	فیفو (fifo)
	B	دستگاه بلوکی (block device)
	C	دستگاه کاراکتری (character device)
	L	پیوند نمادین (symbolic link)
	T	پرونده در سطل زباله (trash file)
	R	پرونده نگه‌داشته‌شده (پرونده بازِ حذف‌شده)
i	شماره اینود
#	شناسه کلاس ذخیره‌سازی
e	فلگ‌ها (ویژگی‌های اضافی mfs)
w	ویژگی‌های ویندوز
m	حالت (mode)
u	uid
g	gid
a,m,c	atime, mtime, ctime
t	مدت زمان نگهداری در سطل زباله
d	rdevhi,rdevlo (فقط دستگاه‌های کاراکتری و بلوکی)
p	مسیر (فقط پیوندهای نمادین)
l	طول پرونده (فقط پرونده‌ها)
c	فهرست چانک‌ها (فقط پرونده‌ها)
r	نشست‌هایی که این پرونده را باز دارند (فقط پرونده‌ها)
.fi
.SS "بخش یال‌ها (EDGE)"
.TP 20
nextedgeid
شناسهٔ یال در دسترس بعدی (نزولی)
.TP 20
EDGE
سطر توصیف‌کنندهٔ یال
.nf
.ta +1i
p	شماره اینود والد
c	شماره اینود فرزند
i	شناسه یال (edge id)
n	نام یال (edge name)
.fi
.SS "بخش گره‌های آزاد (FREE)"
.TP 20
free nodes
تعداد گره‌های آزاد (قابل استفاده مجدد)
.TP 20
FREEID
سطر حاوی توصیف اینود آزاد
.nf
.ta +1i
i	شماره اینود
f	برچسب زمان حذف
.fi
.SS "بخش سهمیه (QUOT)"
.TP 20
quota nodes
تعداد گره‌های دارای سهمیه (quota)
.TP 20
QUOTA
سطر حاوی توصیف سهمیه
.nf
.ta +1i
i	شماره اینود
g	مهلت ارفاق (grace period)
e	تجاوز از حد (exceeded)
f	فلگ‌ها
s	برچسب زمان تجاوز از سهمیه نرم (soft quota)
si	سهمیه نرم اینود
hi	سهمیه سخت اینود
sl	سهمیه نرم طول
hl	سهمیه سخت طول
ss	سهمیه نرم اندازه
hs	سهمیه سخت اندازه
sr	سهمیه نرم اندازه واقعی
hr	سهمیه سخت اندازه واقعی
.fi
.SS "بخش ویژگی‌های گسترش‌یافته (XATR)"
.TP 20
XATTR
سطر حاوی توصیف xattr
.nf
.ta +1i
i	شماره اینود
n	نام xattr
v	مقدار xattr
.fi
.SS "بخش POSIX ACL (PACL)"
.TP 20
POSIXACL
سطر حاوی توصیف acl
.nf
.ta +1i
i	شماره اینود
t	نوع acl
u	مجوزهای کاربر (مالک پرونده)
g	مجوزهای گروه
o	مجوزهای دیگران
m	ماسک مجوز (permission mask)
n	مجوزهای نام‌گذاری‌شده \- فهرستی از اشیاء:
u(U):P	مجوزهای \fIP\fP برای کاربر با شناسهٔ \fIU\fP
g(G):P	مجوزهای \fIP\fP برای گروه با شناسهٔ \fIG\fP
.fi
.SS "بخش پرونده‌های باز (OPEN)"
.TP 20
OPENFILE
سطر حاوی توصیف پروندهٔ باز
.nf
.ta +1i
s	شناسه نشست
i	شماره اینود
.fi
.SS "بخش قفل FLOCK (FLCK)"
.TP 20
FLOCK
سطر حاوی توصیف قفل flock
.nf
.ta +1i
i	شماره اینود
s	شناسه نشست
o	مالک قفل (مالک قفل FUSE)
t	نوع قفل ('R' \- قفل مشترک، 'W' \- قفل انحصاری)
.fi
.SS "بخش قفل پازیکس (PLCK)"
.TP 20
POSIXLOCK
سطر حاوی توصیف قفل posix
.nf
.ta +1i
i	شماره اینود
s	شناسه نشست
o	مالک قفل (مالک قفل FUSE)
p	شناسهٔ محلی فرایند (pid مالک)
r	محدوده قفل در قالب <\fISTART\fP,\fIEND\fP)
t	نوع قفل ('R' \- قفل مشترک، 'W' \- قفل انحصاری)
.fi
.SS "بخش چانک‌سرورها (CSDB)"
.TP 20
chunk servers
تعداد چانک‌سرورها
.TP 20
CHUNCKSERVER
سطر حاوی توصیف چانک‌سرور
.nf
.ta +1i
i	آی‌پی سرور
p	درگاه سرور
#	شناسه سرور
m	حالت تعمیر و نگهداری (maintenance mode)
t	برچسب زمان انقضای زمان تعمیر و نگهداری
.fi
.SS "بخش چانک‌ها (CHNK)"
.TP 20
nextchunkid
اولین شماره چانک در دسترس
.TP 20
CHUNK
سطر حاوی توصیف چانک
.nf
.ta +1i
i	شماره چانک
v	نسخه چانک
t	برچسب زمان؛ در صورت بودن در آینده، یعنی برچسب زمان قفل؛ در صورت بودن در گذشته، برچسب زمان آخرین تغییر
a	فلگ بایگانی
(s,#)	فهرستی از مدخل‌ها؛ s شناسه کلاس ذخیره‌سازی، # تعداد پرونده‌های این کلاس ذخیره‌سازی شامل این چانک است
c	شناسه کلاس ذخیره‌سازی محاسبه‌شده (کلاس عملاً استفاده‌شده، در صورتی که یک چانک بیش از یکی داشته باشد)
.fi
.PP
توجه! اگر برچسب زمان یک چانک برابر با ۰ باشد، به این معنی است که چانک توسط نگارشی از MooseFS قدیمی‌تر از 4.45.0 ایجاد شده و از آن زمان تاکنون قفل یا تغییر داده نشده است.
.SH "گزارش باگ‌ها (REPORTING BUGS)"
گزارش باگ‌ها را به <bugs@moosefs.com> ارسال کنید.
