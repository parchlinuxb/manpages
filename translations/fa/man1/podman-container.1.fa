'\" t
.nh
.TH podman-container 1
.SH "نام (NAME)"
podman-container \- مدیریت کانتینرها

.SH "خلاصه دستور (SYNOPSIS)"
\fBpodman container\fP \fIزیردستور\fP

.SH "توضیحات (DESCRIPTION)"
دستور container امکان مدیریت کانتینرها را فراهم می‌کند.

.SH "دستورات (COMMANDS)"
.TS
allbox;
l l l 
l l l .
\fBدستور\fP	\fBصفحه راهنما\fP	\fBتوضیحات\fP
attach	podman-attach(1)	متصل شدن به یک کانتینر در حال اجرا.
checkpoint	podman-container-checkpoint(1)	T{
ایجاد چک‌پوینت از یک یا چند کانتینر در حال اجرا.
T}
cleanup	podman-container-cleanup(1)	T{
پاکسازی شبکه و نقاط اتصال کانتینر.
T}
clone	podman-container-clone(1)	T{
ایجاد یک کپی از یک کانتینر موجود.
T}
commit	podman-commit(1)	T{
ایجاد ایمیج جدید بر اساس کانتینر تغییریافته.
T}
cp	podman-cp(1)	T{
کپی کردن فایل‌ها/پوشه‌ها بین کانتینر و فایل‌سیستم محلی.
T}
create	podman-create(1)	ایجاد یک کانتینر جدید.
diff	podman-container-diff(1)	T{
بررسی تغییرات روی فایل‌سیستم کانتینر.
T}
exec	podman-exec(1)	T{
اجرای یک دستور درون کانتینر در حال اجرا.
T}
exists	podman-container-exists(1)	T{
بررسی وجود داشتن یک کانتینر در فضای ذخیره‌سازی محلی.
T}
export	podman-export(1)	T{
خروجی گرفتن از محتویات فایل‌سیستم کانتینر در قالب آرشیو tar.
T}
init	podman-init(1)	راه‌اندازی اولیه یک کانتینر.
inspect	podman-container-inspect(1)	T{
نمایش پیکربندی یک کانتینر.
T}
kill	podman-kill(1)	T{
متوقف کردن اجباری فرآیند اصلی در یک یا چند کانتینر.
T}
list	podman-ps(1)	T{
فهرست کردن کانتینرهای موجود در سیستم (نام مستعار: ls).
T}
logs	podman-logs(1)	T{
نمایش لاگ‌های یک کانتینر.
T}
mount	podman-mount(1)	T{
نصب (mount) فایل‌سیستم ریشه یک کانتینر فعال.
T}
pause	podman-pause(1)	مکث یا تعلیق یک یا چند کانتینر.
port	podman-port(1)	T{
فهرست کردن نگاشت‌های پورت کانتینر.
T}
prune	podman-container-prune(1)	T{
حذف تمام کانتینرهای متوقف‌شده از فضای ذخیره‌سازی محلی.
T}
ps	podman-ps(1)	T{
چاپ اطلاعات درباره کانتینرها.
T}
rename	podman-rename(1)	تغییر نام یک کانتینر موجود.
restart	podman-restart(1)	T{
راه‌اندازی مجدد یک یا چند کانتینر.
T}
restore	podman-container-restore(1)	T{
بازیابی یک یا چند کانتینر از یک چک‌پوینت.
T}
rm	podman-rm(1)	حذف یک یا چند کانتینر.
run	podman-run(1)	اجرای یک دستور در یک کانتینر.
runlabel	podman-container-runlabel(1)	T{
اجرای دستور توصیف‌شده توسط برچسب ایمیج کانتینر.
T}
start	podman-start(1)	شروع به کار یک یا چند کانتینر.
stats	podman-stats(1)	T{
نمایش جریان زنده آمار مصرف منابع یک یا چند کانتینر.
T}
stop	podman-stop(1)	T{
متوقف کردن یک یا چند کانتینر در حال اجرا.
T}
top	podman-top(1)	T{
نمایش فرآیندهای در حال اجرای یک کانتینر.
T}
unmount	podman-unmount(1)	T{
پیاده کردن فایل‌سیستم ریشه یک کانتینر فعال (نام مستعار: unmount).
T}
unpause	podman-unpause(1)	T{
از سرگیری فعالیت یک یا چند کانتینر معلق‌شده.
T}
update	podman-update(1)	T{
به‌روزرسانی پیکربندی cgroup یک کانتینر مشخص.
T}
wait	podman-wait(1)	T{
انتظار برای توقف یک یا چند کانتینر و چاپ کدهای خروج آن‌ها.
T}
.TE

.SH "همچنین ببینید (SEE ALSO)"
\fBpodman(1)\fP, \fBpodman-exec(1)\fP, \fBpodman-run(1)\fP
