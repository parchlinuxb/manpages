.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
firewalld.policy-set-gateway \- مجموعه سیاست درگاه (Gateway) برای firewalld
.SH "توضیحات (DESCRIPTION)"
.SS "مجموعه سیاست: درگاه (Policy Set: Gateway)"
.PP
مجموعه سیاست درگاه (Gateway) نقطه شروع مفیدی برای یک مسیریاب خانگی است\&. این مجموعه قابلیت‌های مبدل‌سازی نشانی (masquerading)، کمک‌کننده‌های ردیابی اتصال (conntrack helpers) و فورواردینگ میان ناحیه‌ها را فعال می‌کند\&.
.PP
ناحیه‌های استفاده‌شده در این مجموعه به‌صورت منطقی گروه‌بندی شده‌اند\&. نام‌های این گروه‌ها توسط سیاست‌های از پیش تعریف‌شده استفاده می‌شوند\&.
.sp
.if n \{\
.RS 4
.\}
.nf
            +\-\-\-\-\-\-\-\-\-\-\-+                  +\-\-\-\-\-\-\-\-\-\-\-+
            |    LAN    |                  |   WORLD   |
            |\-\-\-\-\-\-\-\-\-\-\-|                  |\-\-\-\-\-\-\-\-\-\-\-|
            | zones:    |                  | zones:    |
            |  internal |                  |  external |
            |  home     |                  |  public   |
            |  trusted  |                  |           |
            +\-\-\-\-\-\-\-\-\-\-\-+                  +\-\-\-\-\-\-\-\-\-\-\-+
                  |                              |
                  |                              |
                  |         +\-\-\-\-\-\-\-\-\-\-\-+        |
                  +\-\-\-\-\-\-\-\-\-|   HOST    |\-\-\-\-\-\-\-\-+
                            |\-\-\-\-\-\-\-\-\-\-\-|
                            | zones:    |
                  +\-\-\-\-\-\-\-\-\-|  HOST     |\-\-\-\-\-\-\-\-+
                  |         +\-\-\-\-\-\-\-\-\-\-\-+        |
                  |                              |
                  |                              |
            +\-\-\-\-\-\-\-\-\-\-\-+                  +\-\-\-\-\-\-\-\-\-\-\-+
            |   WORK    |                  |    DMZ    |
            |\-\-\-\-\-\-\-\-\-\-\-|                  |\-\-\-\-\-\-\-\-\-\-\-|
            | zones:    |                  | zones:    |
            |  work     |                  |  dmz      |
            +\-\-\-\-\-\-\-\-\-\-\-+                  +\-\-\-\-\-\-\-\-\-\-\-+

.fi
.if n \{\
.RE
.\}
.SS "سیاست‌های موجود در مجموعه درگاه (Policies in the Gateway set)"
.PP
gateway\-dmz\-to\-HOST
.RS 4
سرویس‌هایی را که معمولاً برای یک درگاه مورد نیاز هستند (مانند dns و dhcp) فعال می‌کند\&.
.sp
محل پرونده:
\fI/usr/lib/firewalld/policies/gateway\-dmz\-to\-HOST\&.xml\fR
.RE
.PP
gateway\-lan\-to\-work
.RS 4
همه ترافیک را از LAN به work مجاز می‌کند\&. مبدل‌سازی نشانی (masquerading) و کمک‌کننده‌های رایج ردیابی اتصال را فعال می‌سازد\&.
.sp
محل پرونده:
\fI/usr/lib/firewalld/policies/gateway\-lan\-to\-work\&.xml\fR
.RE
.PP
gateway\-lan\-to\-world
.RS 4
همه ترافیک را از LAN به world مجاز می‌کند\&. اگر یک رابط شبکه به ناحیه «external» افزوده شود، ترافیک مبدل‌سازی (masquerade) خواهد شد\&. همچنین کمک‌کننده‌های ردیابی اتصال را برای سرویس‌های رایج (مانند ftp) فعال می‌کند\&.
.sp
محل پرونده:
\fI/usr/lib/firewalld/policies/gateway\-lan\-to\-world\&.xml\fR
.RE
.PP
gateway\-lan\-to\-HOST
.RS 4
سرویس‌هایی را که معمولاً برای یک درگاه مورد نیاز هستند (مانند dns و dhcp) فعال می‌کند\&.
.sp
محل پرونده:
\fI/usr/lib/firewalld/policies/gateway\-lan\-to\-HOST\&.xml\fR
.RE
.PP
gateway\-world\-to\-HOST
.RS 4
می‌توان از آن برای در دسترس قرار دادن سرویس‌های internal/dmz به world با افزودن یک پورت فوروارد به این سیاست استفاده کرد\&.
.sp
در اینجا مثالی برای افزودن پورت فوروارد آورده شده است\&. این مثال پورت 8080 را به 10\&.1\&.1\&.42:80 فوروارد می‌کند\&.
.sp
.if n \{\
.RS 4
.\}
.nf
# firewall\-cmd \-\-permanent \-\-policy gateway\-world\-to\-HOST \e
               \-\-add\-forward\-port=port=8080:proto=tcp:toport=80:toaddr=10\&.1\&.1\&.42
# firewall\-cmd \-\-reload

.fi
.if n \{\
.RE
.\}
.sp
محل پرونده:
\fI/usr/lib/firewalld/policies/gateway\-world\-to\-HOST\&.xml\fR
.RE
.SH "همچنین ببینید (SEE ALSO)"
\fBfirewall-applet\fR(1), \fBfirewalld\fR(1), \fBfirewall-cmd\fR(1), \fBfirewall-config\fR(1), \fBfirewalld.conf\fR(5), \fBfirewalld.direct\fR(5), \fBfirewalld.dbus\fR(5), \fBfirewalld.icmptype\fR(5), \fBfirewall-offline-cmd\fR(1), \fBfirewalld.richlanguage\fR(5), \fBfirewalld.service\fR(5), \fBfirewalld.zone\fR(5), \fBfirewalld.zones\fR(5), \fBfirewalld.policy\fR(5), \fBfirewalld.policies\fR(5), \fBfirewalld.ipset\fR(5), \fBfirewalld.helper\fR(5)
.SH "نکات (NOTES)"
.PP
صفحه اصلی firewalld:
.RS 4
\m[blue]\fB\%http://firewalld.org\fR\m[]
.RE
