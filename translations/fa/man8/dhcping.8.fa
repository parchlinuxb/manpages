'''
'''     Set up \*(-- to give an unbreakable dash;
'''     string Tr holds user defined translation string.
'''     Bell System Logo is used as a dummy character.
'''
.tr \(*W-|\(bv\*(Tr
.ie n \{\
.ds -- \(*W-
.ds PI pi
.if (\n(.H=4u)&(1m=24u) .ds -- \(*W\h'-12u'\(*W\h'-12u'-\" diablo 10 pitch
.if (\n(.H=4u)&(1m=20u) .ds -- \(*W\h'-12u'\(*W\h'-8u'-\" diablo 12 pitch
.ds L" ""
.ds R" ""
'''   \*(M", \*(S", \*(N" and \*(T" are the equivalent of
'''   \*(L" and \*(R", except that they are used on ".xx" lines,
'''   such as .IP and .SH, which do another additional levels of
'''   double-quote interpretation
.ds M" """
.ds S" """
.ds N" """""
.ds T" """""
.ds L' '
.ds R' '
.ds M' '
.ds S' '
.ds N' '
.ds T' '
'br\}
.el\{\
.ds -- \(em\|
.tr \*(Tr
.ds L" ``
.ds R" ''
.ds M" ``
.ds S" ''
.ds N" ``
.ds T" ''
.ds L' `
.ds R' '
.ds M' `
.ds S' '
.ds N' `
.ds T' '
.ds PI \(*p
'br\}
.\"	If the F register is turned on, we'll generate
.\"	index entries out stderr for the following things:
.\"		TH	Title 
.\"		SH	Header
.\"		Sh	Subsection 
.\"		Ip	Item
.\"		X<>	Xref  (embedded
.\"	Of course, you have to process the output yourself
.\"	in some meaninful fashion.
.if \nF \{
.de IX
.tm Index:\\$1\t\\n%\t"\\$2"
..
.nr % 0
.rr F
.\}
.TH dhcping 8 "Januari 27, 2002" "Januari 27, 2002" "General Commands Manual"
.UC
.if n .hy 0
.if n .na
.ds C+ C\v'-.1v'\h'-1p'\s-2+\h'-1p'+\s0\v'.1v'\h'-1p'
.de CQ          \" put $1 in typewriter font
.ft CW
'if n "\c
'if t \\&\\$1\c
'if n \\&\\$1\c
'if n \&"
\\&\\$2 \\$3 \\$4 \\$5 \\$6 \\$7
'.ft R
..
.\" @(#)ms.acc 1.5 88/02/08 SMI; from UCB 4.2
.	\" AM - accent mark definitions
.bd B 3
.	\" fudge factors for nroff and troff
.if n \{\
.	ds #H 0
.	ds #V .8m
.	ds #F .3m
.	ds #[ \f1
.	ds #] \fP
.\}
.if t \{\
.	ds #H ((1u-(\\\\n(.fu%2u))*.13m)
.	ds #V .6m
.	ds #F 0
.	ds #[ \&
.	ds #] \&
.\}
.	\" simple accents for nroff and troff
.if n \{\
.	ds ' \&
.	ds ` \&
.	ds ^ \&
.	ds , \&
.	ds ~ ~
.	ds ? ?
.	ds ! !
.	ds /
.	ds q
.\}
.if t \{\
.	ds ' \\k:\h'-(\\n(.wu*8/10-\*(#H)'\'\h"|\\n:u"
.	ds ` \\k:\h'-(\\n(.wu*8/10-\*(#H)'\`\h'|\\n:u'
.	ds ^ \\k:\h'-(\\n(.wu*10/11-\*(#H)'^\h'|\\n:u'
.	ds , \\k:\h'-(\\n(.wu*8/10)',\h'|\\n:u'
.	ds ~ \\k:\h'-(\\n(.wu-\*(#H-.1m)'~\h'|\\n:u'
.	ds ? \s-2c\h'-\w'c'u*7/10'\u\h'\*(#H'\zi\d\s+2\h'\w'c'u*8/10'
.	ds ! \s-2\(or\s+2\h'-\w'\(or'u'\v'-.8m'.\v'.8m'
.	ds / \\k:\h'-(\\n(.wu*8/10-\*(#H)'\z\(sl\h'|\\n:u'
.	ds q o\h'-\w'o'u*8/10'\s-4\v'.4m'\z\(*i\v'-.4m'\s+4\h'\w'o'u*8/10'
.\}
.	\" troff and (daisy-wheel) nroff accents
.ds : \\k:\h'-(\\n(.wu*8/10-\*(#H+.1m+\*(#F)'\v'-\*(#V'\z.\h'.2m+\*(#F'.\h'|\\n:u'\v'\*(#V'
.ds 8 \h'\*(#H'\(*b\h'-\*(#H'
.ds v \\k:\h'-(\\n(.wu*9/10-\*(#H)'\v'-\*(#V'\*(#[\s-4v\s0\v'\*(#V'\h'|\\n:u'\*(#]
.ds _ \\k:\h'-(\\n(.wu*9/10-\*(#H+(\*(#F*2/3))'\v'-.4m'\z\(hy\v'.4m'\h'|\\n:u'
.ds . \\k:\h'-(\\n(.wu*8/10)'\v'\*(#V*4/10'\z.\v'-\*(#V*4/10'\h'|\\n:u'
.ds 3 \*(#[\v'.2m'\s-2\&3\s0\v'-.2m'\*(#]
.ds o \\k:\h'-(\\n(.wu+\w'\(de'u-\*(#H)/2u'\v'-.3n'\*(#[\z\(de\v'.3n'\h'|\\n:u'\*(#]
.ds d- \h'\*(#H'\(pd\h'-\w'~'u'\v'-.25m'\f2\(hy\fP\v'.25m'\h'-\*(#H'
.ds D- D\\k:\h'-\w'D'u'\v'-.11m'\z\(hy\v'.11m'\h'|\\n:u'
.ds th \*(#[\v'.3m'\s+1I\s-1\v'-.3m'\h'-(\w'I'u*2/3)'\s-1o\s+1\*(#]
.ds Th \*(#[\s+2I\s-2\h'-\w'I'u*3/5'\v'-.3m'o\v'.3m'\*(#]
.ds ae a\h'-(\w'a'u*4/10)'e
.ds Ae A\h'-(\w'A'u*4/10)'E
.ds oe o\h'-(\w'o'u*4/10)'e
.ds Oe O\h'-(\w'O'u*4/10)'E
.	\" corrections for vroff
.if v .ds ~ \\k:\h'-(\\n(.wu*9/10-\*(#H)'\s-2\u~\d\s+2\h'|\\n:u'
.if v .ds ^ \\k:\h'-(\\n(.wu*10/11-\*(#H)'\v'-.4m'^\v'.4m'\h'|\\n:u'
.	\" for low resolution devices (crt and lpr)
.if \n(.H>23 .if \n(.V>19 \
\{\
.	ds : e
.	ds 8 ss
.	ds v \h'-1'\o'\(aa\(ga'
.	ds _ \h'-1'^
.	ds . \h'-1'.
.	ds 3 3
.	ds o a
.	ds d- d\h'-1'\(ga
.	ds D- D\h'-1'\(hy
.	ds th \o'bp'
.	ds Th \o'LP'
.	ds ae ae
.	ds Ae AE
.	ds oe oe
.	ds Oe OE
.\}
.rm #[ #] #H #V #F C
.SH "نام (NAME)"
dhcping \- ابزار ارسال درخواست DHCP برای بررسی عملکرد سرور
.SH "خلاصه دستور (SYNOPSIS)"
\fBdhcping\fR
[\fB\-v\fR] [\fB\-q\fR] [\fB\-i\fR] [\fB\-r\fR]
\fB\-t\fR \fImaxwait\fR
\fB\-c\fR \fIclient-IP\-address\fR
\fB\-s\fR \fIserver-IP\-address\fR
\fB\-h\fR \fIclient-hardware-address\fR
[\fB\-g\fR \fIgateway-IP\-address\fR]
.SH "توضیحات (DESCRIPTION)"
این دستور به مدیر سیستم امکان می‌دهد تا بررسی کند آیا یک سرور
DHCP دوردست همچنان فعال است و به درستی کار می‌کند یا خیر.
.PP
گزینه‌ها عبارتند از:
.Ip "\fB\-v\fR" 5
حالت پرگو (verbose)، چاپ برخی اطلاعات تشخیصی.
.Ip "\fB\-i\fR" 5
استفاده از بسته‌های \s-1DHCPINFORM\s0.
.Ip "\fB\-r\fR" 5
استفاده از بسته‌های \s-1DHCPREQUEST\s0 (رفتار پیش‌فرض).
.Ip "\fB\-q\fR" 5
حالت ساکت (quiet)، هیچ متنی را روی صفحه چاپ نمی‌کند.
.Ip "\fB\-t\fR \fImaxwait\fR" 5
حداکثر زمان انتظار برای دریافت پاسخ از سرور (بر حسب ثانیه).
مقدار پیش‌فرض ۳ ثانیه است.
.Ip "\fB\-c\fR \fIclient-\s-1IP\s0\-address\fR" 5
درخواست این آدرس \s-1IP\s0. توجه داشته باشید که این همان آدرس \s-1IP\s0 است که
پاسخ نیز به آن ارسال خواهد شد.
.Ip "\fB\-s\fR \fIserver-\s-1IP\s0\-address\fR" 5
ارسال بسته \s-1DHCP\s0 به این آدرس \s-1IP\s0.
.Ip "\fB\-h\fR \fIclient-hardware-address\fR" 5
استفاده از این آدرس سخت‌افزاری (MAC) در درخواست \s-1DHCP\s0. این آدرس می‌تواند تا
شانزده هشت‌بیت (اکتت) باشد که با دونقطه از هم جدا شده‌اند (مانند 01:02:03:04).
.Ip "\fB\-g\fR \fIgateway-\s-1IP\s0\-address\fR" 5
استفاده از این آدرس \s-1IP\s0 به عنوان آدرس گیت‌وی در بسته \s-1DHCP\s0.
این گزینه در حال حاضر کار نمی‌کند و دچار اشکال است.
.SH "مقادیر بازگشتی (RETURN VALUES)"
در صورت موفقیت و اجرای بدون مشکل، مقدار 0 بازگردانده می‌شود. در صورت بروز
هرگونه خطا، مقدار 1 بازگردانده می‌شود.
.SH "راه‌اندازی (SETUP)"
این برنامه باید با مجوز setuid root نصب شود یا فقط توسط کاربر ریشه (root) اجرا گردد.
برای اطلاعات بیشتر، بخش
.B "امنیت (SECURITY)"
را ببینید.
.PP
در سرور DHCP خود، این خطوط را به فایل dhcpd.conf اضافه کنید:
.PP
.Vb 4
\&  host <your monitoring host FQDN> {
\&     hardware ethernet <your monitor host mac address>;
\&     fixed-address     <your monitoring host IP address>;
\&  }
.Ve
سپس آن را امتحان کنید:
.PP
.nf
$ dhcping \-c \fIyour monitoring host IP address\fR \e
          \-s \fIyour DHCP server IP address\fR \e
          \-h \fIyour monitor host mac address\fR
.fi
.PP
این دستور با یکی از دو پیام \*(L"no answer\*(R" یا \*(L"Got answer from: \fIyour DHCP server IP address\fR\*(R" پاسخ خواهد داد.
.PP
فایل ثبت وقایع (logfile) سرور DHCP خروجی زیر را ثبت خواهد کرد:
.PP
.nf
 DHCPREQUEST\ for\ 192.168.1.1\ from\ 00:20:18:56:29:8f\ via\ ed0
 DHCPACK\ on\ 192.168.1.1\ to\ 00:20:18:56:29:8f\ via\ ed0
 DHCPRELEASE\ of\ 192.168.1.1\ from\ 00:20:18:56:29:8f\ via\ ed0\ (found)
.fi
.PP
اجرا در حالت DHCPINFORM با استفاده از گزینه
.BR \-i :
.PP
اگر پیام \*(L"DHCPINFORM from 192.168.1.1 via xl0: not authoritative for subnet 192.168.1.0\*(R" را مشاهده کردید، باید عبارت authoritative را به آن زیرشبکه اضافه کنید. برای جزئیات بیشتر dhcpd.\fIconf\fR\|(5) را ببینید.
.PP
هنگام اجرا در حالت بسیار پرگو (very verbose)، دستور
.B dhcping
تلاش می‌کند تمام داده‌های بسته‌های DHCP ارسالی و دریافتی را تخلیه (dump) کند. این برنامه ابتدا بسته را در قالب هگزادسیمال چاپ کرده، سپس سرآیند و در نهایت گزینه‌ها را تفسیر می‌کند.
.SH "نحوه کارکرد (HOW IT WORKS)"
کلاینت یا یک بسته DHCPREQUEST یا یک بسته DHCPINFORM به سرور ارسال می‌کند و
منتظر دریافت پاسخ می‌ماند. سپس، چنانچه بسته DHCPREQUEST ارسال شده باشد،
یک بسته DHCPRELEASE را مجدداً به سرور بازمی‌فرستد.
.SH "امنیت (SECURITY)"
این برنامه با مجوز setuid root نصب می‌شود، زیرا برای اتصال (bind) به پورت ۶۸ (bootpc)
به دسترسی‌های ویژه نیاز دارد. دسترسی‌های کاربر ریشه (root) به محض اینکه برنامه به این
پورت متصل شد لغو می‌شوند.
.SH "اشکالات (BUGS)"
در حال حاضر (که ممکن است در آینده تغییر کند یا نکند)، دیمن ISC DHCP
اجاره‌ها (leases) با آدرس IP ثابت را در فایل dhcpd.leases ثبت نمی‌کند.
.PP
بسته‌های DHCPINFORM تنها می‌توانند در زیرشبکه‌هایی استفاده شوند که سرور برای آن‌ها
معتبر (authoritative) باشد. اگر اسکریپت پایش در زیرشبکه‌ای اجرا شود که سرور برای آن
authoritative نیست، باید از بسته‌های DHCPREQUEST استفاده کند. نویسنده همچنین مشکلاتی
را با سرورهای ISC DHCPD نسخه ۲ تجربه کرده است که در فایل README آن نیز ذکر شده‌اند.
.PP
گزینه
.B \-V
هنوز کار می‌کند، اما نباید برای اشکال‌زدایی بسته‌ها استفاده شود. بهتر است برای این
کار از
\fIdhcpdump\fR\|(8)
که در وب‌سایت نویسنده در دسترس است استفاده کنید. نویسنده قصد داشت این گزینه را حذف کند،
اما تصمیم گرفت آن را فقط از مستندات بردارد و در کد باقی بگذارد، شاید روزی برای اشکال‌زدایی
لازم شود.
.SH "نویسنده (AUTHOR)"
Edwin Groothuis, edwin@mavetju.org (http://www.mavetju.org)
.SH "همچنین ببینید (SEE ALSO)"
\fIdhcpd\fR\|(8), \fIdhclient\fR\|(8), dhcpd.\fIconf\fR\|(5), \fIdhcpdump\fR\|(8)

.rn }` ''
