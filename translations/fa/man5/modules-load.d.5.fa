'\" t
.TH "MODULES\-LOAD\&.D" "5" "" "systemd 261.2" "modules-load.d"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
modules-load.d \- پیکربندی بارگذاری ماژولهای هسته در هنگام بوت
.SH "خلاصه دستور (SYNOPSIS)"
.PP
.RS 4
/etc/modules\-load\&.d/*\&.conf
.RE
.RS 4
/run/modules\-load\&.d/*\&.conf
.RE
.RS 4
/usr/local/lib/modules\-load\&.d/*\&.conf
.RE
.RS 4
/usr/lib/modules\-load\&.d/*\&.conf
.RE
.SH "توضیحات (DESCRIPTION)"
.PP
\fBsystemd-modules-load.service\fR(8)
فایل‌ها را از دایرکتوری‌های بالا که حاوی ماژول‌های هسته برای بارگذاری در حین بوت در یک فهرست ایستا هستند، می‌خواند\&. هر فایل پیکربندی به سبک
/etc/modules\-load\&.d/\fIprogram\fR\&.conf
نام‌گذاری می‌شود\&. توجه داشته باشید که معمولاً بهتر است به‌جای چنین پیکربندی ایستایی، بر بارگذاری خودکار ماژول‌ها توسط شناسههای PCI، شناسههای USB، شناسههای DMI یا محرک‌های مشابه که در خود ماژول‌های هسته تعبیه شده‌اند تکیه شود\&. در واقع، اکثر ماژول‌های مدرن هسته از قبل برای بارگذاری خودکار آماده شده‌اند\&.
.SH "قالب فایل پیکربندی (CONFIGURATION FILE FORMAT)"
.PP
فایل‌های پیکربندی باید صرفاً شامل فهرستی از نام‌های ماژول‌های هسته برای بارگذاری باشند که با خط جدید از یکدیگر جدا شده‌اند\&. خطوط خالی و خطوطی که اولین نویسه غیرفاصله‌ای آن‌ها # یا ; است، نادیده گرفته می‌شوند\&.
.SH "دایرکتوریهای پیکربندی و اولویت (CONFIGURATION DIRECTORIES AND PRECEDENCE)"
.PP
فایل‌های پیکربندی به ترتیب اولویت، همان‌طور که در بخش خلاصه دستور در بالا ذکر شده است، از دایرکتوری‌های
/etc/،
/run/،
/usr/local/lib/ و
/usr/lib/
خوانده می‌شوند\&. فایل‌ها باید پسوند
"\&.conf"
داشته باشند\&. فایل‌های موجود در
/etc/
فایل‌های هم‌نام در
/run/،
/usr/local/lib/ و
/usr/lib/
را بازنویسی می‌کنند\&. فایل‌های موجود در
/run/
فایل‌های هم‌نام در
/usr/
را بازنویسی می‌کنند\&.
.PP
تمام فایل‌های پیکربندی بدون توجه به این‌که در کدام‌یک از دایرکتوری‌ها قرار دارند، بر اساس نام فایل خود به ترتیب واژه‌نگاری (حروف الفبا) مرتب می‌شوند\&. اگر چند فایل یک گزینه یکسان را مشخص کنند، ورودی موجود در فایلی که نام آن از نظر الفبایی مؤخرتر است اولویت خواهد داشت\&. بنابراین، پیکربندی یک فایل را می‌توان به‌طور کامل جایگزین کرد (با قرار دادن فایلی با همان نام در دایرکتوری با اولویت بالاتر)، یا می‌توان تنظیمات جداگانه را تغییر داد (با تعیین تنظیمات بیشتر در فایلی با نام دیگر که از نظر ترتیبی بعدتر قرار می‌گیرد)\&.
.PP
بسته‌ها باید فایل‌های پیکربندی خود را در
/usr/lib/
(بسته‌های توزیع) یا
/usr/local/lib/
(نصب‌های محلی)
\&\s-2\u[1]\d\s+2
نصب کنند\&. فایل‌های موجود در
/etc/
برای مدیر محلی سیستم رزرو شده‌اند، که می‌تواند از این منطق برای بازنویسی فایل‌های پیکربندی نصب‌شده توسط بسته‌های توزیع‌کننده (vendor) استفاده کند\&.
.PP
توصیه می‌شود برای ساده‌تر کردن ترتیب، نام همه فایل‌ها با یک عدد دورقمی و یک خط تیره شروع شود\&. توصیه می‌شود از محدوده 10\-40 برای فایل‌های پیکربندی در
/usr/
و از محدوده 60\-90 برای فایل‌های پیکربندی در
/etc/
و
/run/
استفاده شود، تا اطمینان حاصل شود که فایل‌های پیکربندی محلی و گذرا همیشه بر فایل‌های پیکربندی عرضه‌شده توسط توزیع‌کننده سیستم‌عامل اولویت خواهند داشت\&.
.PP
اگر مدیر سیستم بخواهد یک فایل پیکربندی عرضه‌شده توسط توزیع‌کننده را غیرفعال کند، راهکار توصیه‌شده قرار دادن یک پیوند نمادین (symlink) به
/dev/null
در دایرکتوری پیکربندی در
/etc/
با همان نام فایل پیکربندی توزیع‌کننده است\&. اگر فایل پیکربندی توزیع‌کننده در تصویر initrd گنجانده شده باشد، آن تصویر باید دوباره بازسازی شود\&.
.SH "مثالها (EXAMPLES)"
.PP
\fBمثال\ \&1.\ \&نمونه فایل /etc/modules\-load\&.d/virtio\-net\&.conf:\fR
.sp
.if n \{\
.RS 4
.\}
.nf
# Load virtio\-net\&.ko at boot
virtio\-net
.fi
.if n \{\
.RE
.\}
.SH "همچنین ببینید (SEE ALSO)"
.PP
\fBsystemd\fR(1), \fBsystemd-modules-load.service\fR(8), \fBsystemd-delta\fR(1), \fBmodprobe\fR(8)
.SH "نکات (NOTES)"
.IP " 1." 4
💣💥🧨💥💥💣 لطفاً توجه داشته باشید که این فایل‌های پیکربندی باید در همه زمان‌ها در دسترس باشند. اگر
/usr/local/
یک پارتیشن جداگانه باشد، ممکن است در مراحل اولیه بوت در دسترس نباشد و نباید برای پیکربندی استفاده شود.
