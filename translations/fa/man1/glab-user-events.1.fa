.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-user-events \- View user events.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab user events [flags]\fP


.SH "توضیحات (DESCRIPTION)"
By default, lists events for the current project. Use \fB--all\fR to
include events from every project you can access.


.SH "گزینه‌ها (OPTIONS)"
\fB-a\fP, \fB--all\fP[=false]
	Get events from all projects.

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression.

.PP
\fB-F\fP, \fB--output\fP="text"
	Format output as: 'text', 'json'.

.PP
\fB-p\fP, \fB--page\fP=1
	Page number.

.PP
\fB-P\fP, \fB--per-page\fP=30
	Number of items to list per page.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-h\fP, \fB--help\fP[=false]
	Show help for this command.


.SH "مثال (EXAMPLE)"
.EX
glab user events
glab user events --all
glab user events -F json
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-user(1)\fP
