.TH IP\-LINK 8 "13 Dec 2012" "iproute2" "Linux"
.SH "نام (NAME)"
ip-link \- پیکربندی و مدیریت رابط‌ها و دستگاه‌های شبکه در لینوکس
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.ad l
.in +8
.ti -8
.B ip link
.RI  " { " COMMAND " | "
.BR help " }"
.sp

.ti -8
.BI "ip link add"
.RB "[ " link
.IR DEVICE " ]"
.RB "[ " name " ]"
.I NAME
.br
.RB "[ " txqueuelen
.IR PACKETS " ]"
.br
.RB "[ " address
.IR LLADDR " ]"
.RB "[ " broadcast
.IR LLADDR " ]"
.br
.RB "[ " mtu
.IR MTU " ]"
.RB "[ " index
.IR IDX " ]"
.br
.RB "[ " numtxqueues
.IR QUEUE_COUNT " ]"
.RB "[ " numrxqueues
.IR QUEUE_COUNT " ]"
.br
.RB "[ " gso_max_size
.IR BYTES " ]"
.RB "[ " gso_ipv4_max_size
.IR BYTES " ]"
.RB "[ " gso_max_segs
.IR SEGMENTS " ]"
.br
.RB "[ " gro_max_size
.IR BYTES " ]"
.RB "[ " gro_ipv4_max_size
.IR BYTES " ]"
.br
.RB "[ " netns " {"
.IR PID " | " NETNSNAME " | " NETNSFILE " } ]"
.br
.BI type " TYPE"
.RI "[ " ARGS " ]"

.ti -8
.BR "ip link delete " {
.IR DEVICE " | "
.BI "group " GROUP
}
.BI type " TYPE"
.RI "[ " ARGS " ]"

.ti -8
.BR "ip link" " { " set " | " change " } " {
.IR DEVICE " | "
.BI "group " GROUP
}
.br
.RB "[ { " up " | " down " } ]"
.br
.RB "[ " type
.IR "ETYPE TYPE_ARGS" " ]"
.br
.RB "[ " arp " { " on " | " off " } ]"
.br
.RB "[ " dynamic " { " on " | " off " } ]"
.br
.RB "[ " multicast " { " on " | " off " } ]"
.br
.RB "[ " allmulticast " { " on " | " off " } ]"
.br
.RB "[ " promisc " { " on " | " off " } ]"
.br
.RB "[ " protodown " { " on " | " off " } ]"
.br
.RB "[ " protodown_reason
.IR PREASON " { " on " | " off " } ]"
.br
.RB "[ " trailers " { " on " | " off " } ]"
.br
.RB "[ " txqueuelen
.IR PACKETS " ]"
.br
.RB "[ " gso_max_size
.IR BYTES " ]"
.RB "[ " gso_ipv4_max_size
.IR BYTES " ]"
.RB "[ " gso_max_segs
.IR SEGMENTS " ]"
.br
.RB "[ " gro_max_size
.IR BYTES " ]"
.RB "[ " gro_ipv4_max_size
.IR BYTES " ]"
.br
.RB "[ " name
.IR NEWNAME " ]"
.br
.RB "[ " address
.IR LLADDR " ]"
.br
.RB "[ " broadcast
.IR LLADDR " ]"
.br
.RB "[ " mtu
.IR MTU " ]"
.br
.RB "[ " netns " {"
.IR PID " | " NETNSNAME " | " NETNSFILE " } ]"
.br
.RB "[ " link-netnsid
.IR ID " ]"
.br
.RB "[ " alias
.IR NAME  " ]"
.br
.RB "[ " vf
.IR NUM " ["
.B  mac
.IR LLADDR " ]"
.br
.in +9
.RI "[ " VFVLAN-LIST " ]"
.br
.RB "[ " rate
.IR TXRATE " ]"
.br
.RB "[ " max_tx_rate
.IR TXRATE " ]"
.br
.RB "[ " min_tx_rate
.IR TXRATE " ]"
.br
.RB "[ " spoofchk " { " on " | " off " } ]"
.br
.RB "[ " query_rss " { " on " | " off " } ]"
.br
.RB "[ " state " { " auto " | " enable " | " disable " } ]"
.br
.RB "[ " trust " { " on " | " off " } ]"
.br
.RB "[ " node_guid " eui64 ]"
.br
.RB "[ " port_guid " eui64 ] ]"
.br
.in -9
.RB "[ { " xdp " | " xdpgeneric  " | " xdpdrv " | " xdpoffload " } { " off " | "
.br
.in +8
.BR object
.IR FILE
.RB "[ { " section " | " program " } "
.IR NAME " ]"
.RB "[ " verbose " ] |"
.br
.BR pinned
.IR FILE " } ]"
.br
.in -8
.RB "[ " master
.IR DEVICE " ]"
.br
.RB "[ " nomaster " ]"
.br
.RB "[ " vrf
.IR NAME " ]"
.br
.RB "[ " addrgenmode " { " eui64 " | " none " | " stable_secret " | " random " } ]"
.br
.RB "[ " inet " [ { " forwarding " | " proxy_arp " | " accept_redirects " |"
.br
.in +8
.BR secure_redirects " | " send_redirects " | " shared_media " |"
.br
.BR accept_source_route " | " bootp_relay " | " log_martians " |"
.br
.BR arp_filter " | " disable_xfrm " | " disable_policy " |"
.br
.BR promote_secondaries " | " arp_notify " | " accept_local " |"
.br
.BR src_vmark " | " proxy_arp_pvlan " | " route_localnet " |"
.br
.BR bc_forwarding " | " ignore_routes_with_linkdown " |"
.br
.BR drop_unicast_in_l2_multicast " |"
.br
.BR drop_gratuitous_arp " | " arp_evict_nocarrier " } { " on " | " off " } ]"
.br
.RB "[ " rp_filter " { " 0 " | " 1 " | " 2 " } ]"
.br
.RB "[ " arp_announce " { " 0 " | " 1 " | " 2 " } ]"
.br
.RB "[ " arp_ignore " { " 0 " | " 1 " | " ... " | " 8 " } ]"
.br
.RB "[ " arp_accept " { " 0 " | " 1 " | " 2 " } ]"
.br
.RB "[ " force_igmp_version " { " 0 " | " 1 " | " 2 " | " 3 " } ]"
.br
.RB "[ " tag " " TAG " ] [ " medium_id " " ID " ]"
.br
.RB "[ " igmpv2_unsolicited_report_interval " " INTERVAL " ]"
.br
.RB "[ " igmpv3_unsolicited_report_interval " " INTERVAL " ] ]"
.br
.in -8
.br
.RB "[ " macaddr
.RI "[ " MACADDR " ]"
.br
.in +10
.RB "[ { " flush " | " add " | " del " } "
.IR MACADDR " ]"
.br
.RB "[ " set
.IR MACADDR " ] ]"
.br

.ti -8
.B ip link show
.RI "[ " DEVICE " | "
.B group
.IR GROUP " ] [ { "
.BR up " | " down " } ] ["
.B master
.IR DEVICE " ] ["
.B type
.IR ETYPE " ] ["
.B vrf
.IR NAME " ] ["
.BR nomaster " ] ["
.BR novf " ]"

.ti -8
.B ip link xstats
.BI type " TYPE"
.RI "[ " ARGS " ]"

.ti -8
.B ip link afstats
.RB "[ " dev
.IR DEVICE " ]"

.ti -8
.B ip link help
.RI "[ " TYPE " ]"

.ti -8
.IR TYPE " := [ "
.BR amt " | "
.BR bareudp " |"
.BR bond " | "
.BR bridge " | "
.BR can " | "
.BR dsa " | "
.BR dummy " | "
.BR erspan " |"
.BR geneve " |"
.BR gre " |"
.BR gretap " |"
.BR gtp " |"
.BR hsr " | "
.BR ifb " | "
.BR ip6erspan " |"
.BR ip6gre " |"
.BR ip6gretap " |"
.BR ip6tnl " |"
.BR ipip " |"
.BR ipoib " |"
.BR ipvlan " |"
.BR ipvtap " |"
.BR lowpan " |"
.BR macsec " |"
.BR macvlan  " | "
.BR macvtap  " | "
.BR netdevsim " |"
.BR netkit " |"
.BR nlmon " |"
.BR pfcp " |"
.BR rmnet " |"
.BR sit " |"
.BR vcan " | "
.BR veth " | "
.BR virt_wifi " |"
.BR vlan " | "
.BR vrf " |"
.BR vti " |"
.BR vxcan " | "
.BR vxlan " |"
.BR xfrm " ]"

.ti -8
.IR ETYPE " := [ " TYPE " |"
.BR bridge_slave " | " bond_slave " ]"

.ti -8
.IR VFVLAN-LIST " := [ "  VFVLAN-LIST " ] " VFVLAN

.ti -8
.IR VFVLAN " := "
.RB "[ " vlan
.IR VLANID " [ "
.B qos
.IR VLAN-QOS " ] ["
.B proto
.IR VLAN-PROTO " ] ]"
.in -8

.ti -8
.BI "ip link property add dev " DEVICE
.RB "[ " altname
.IR NAME " .. ]"

.ti -8
.BI "ip link property del dev " DEVICE
.RB "[ " altname
.IR NAME " .. ]"

.SH "توضیحات (DESCRIPTION)"
.SS ip link add \- افزودن رابط مجازی (add virtual link)

.TP
.BI link " DEVICE "
دستگاه فیزیکی را که عملیات روی آن انجام می‌شود مشخص می‌کند.

.I NAME
نام دستگاه مجازی جدید را مشخص می‌کند.

.I TYPE
نوع دستگاه جدید را مشخص می‌کند.
.sp
انواع پیوند (Link types):

.in +8
.BR amt
\- تونل‌زنی چندپخشی خودکار (Automatic Multicast Tunneling - AMT)
.sp
.BR bareudp
\- پشتیبانی از کپسوله‌سازی لایه ۳ در Bare UDP
.sp
.B bond
\- دستگاه پیوند چندگانه (Bonding device)
.sp
.B bridge
\- دستگاه پل اترنت (Ethernet Bridge device)
.sp
.B can
\- شبکه کنترل‌کننده (Controller Area Network)
.sp
.B dsa
\- معماری سوئیچ توزیع‌شده (Distributed Switch Architecture)
.sp
.B dummy
\- رابط شبکه صوری (Dummy network interface)
.sp
.BR erspan
\- پروتکل Encapsulated Remote SPAN بر روی GRE و IPv4
.sp
.B geneve
\- کپسوله‌سازی عمومی مجازی‌سازی شبکه (GEneric NEtwork Virtualization Encapsulation)
.sp
.B gre
\- رابط تونل مجازی GRE بر روی IPv4
.sp
.BR gretap
\- رابط تونل مجازی لایه ۲ (L2) با GRE بر روی IPv4
.sp
.BR gtp
\- پروتکل تونل‌زنی GPRS (GPRS Tunneling Protocol)
.sp
.B hsr
\- دستگاه افزونگی یکپارچه با دسترس‌پذیری بالا (High-availability Seamless Redundancy)
.sp
.B ifb
\- دستگاه بلوک عملکردی واسط (Intermediate Functional Block)
.sp
.BR ip6erspan
\- پروتکل Encapsulated Remote SPAN بر روی GRE و IPv6
.sp
.BR ip6gre
\- رابط تونل مجازی GRE بر روی IPv6
.sp
.BR ip6gretap
\- رابط تونل مجازی لایه ۲ (L2) با GRE بر روی IPv6
.sp
.BR ip6tnl
\- رابط تونل مجازی IPv4|IPv6 بر روی IPv6
.sp
.BR ipip
\- رابط تونل مجازی IPv4 بر روی IPv4
.sp
.B ipoib
\- دستگاه IP بر روی Infiniband (IPoIB)
.sp
.BR ipvlan
\- رابط برای VLANهای مبتنی بر لایه ۳ (IPv6/IPv4)
.sp
.BR ipvtap
\- رابط برای VLANهای مبتنی بر لایه ۳ (IPv6/IPv4) و TAP
.sp
.BR lowpan
\- رابط برای 6LoWPAN (IPv6) بر روی IEEE 802.15.4 / بلوتوث
.sp
.BR macsec
\- رابط برای امنیت کنترل دسترسی رسانه با استاندارد IEEE 802.1AE (MACsec)
.sp
.B macvlan
\- رابط مجازی بر پایه آدرس لایه پیوند (MAC)
.sp
.B macvtap
\- رابط مجازی بر پایه آدرس لایه پیوند (MAC) و TAP.
.sp
.BR netdevsim
\- رابط برای آزمایش‌های رابط برنامه‌نویسی netdev API
.sp
.BR netkit
\- دستگاه شبکه با قابلیت برنامه‌ریزی BPF
.sp
.BR nlmon
\- دستگاه نظارت و پایش Netlink
.sp
.BR pfcp
\- دستگاه پروتکل کنترل هدایت بسته (Packet Forwarding Control Protocol)
.sp
.BR rmnet
\- دستگاه کوالکام rmnet (Qualcomm rmnet)
.sp
.BR sit
\- رابط تونل مجازی IPv6 بر روی IPv4
.sp
.B vcan
\- رابط مجازی شبکه کنترل‌کننده (Virtual Controller Area Network)
.sp
.B veth
\- رابط اترنت مجازی (Virtual ethernet interface)
.sp
.BR virt_wifi
\- دستگاه شبیه‌سازی وای‌فای rtnetlink
.sp
.BR vlan
\- رابط شبکه محلی مجازی برچسب‌دار 802.1q (802.1q tagged VLAN)
.sp
.BR vrf
\- رابط برای دامنه‌های لایه ۳ VRF
.sp
.BR vti
\- رابط تونل مجازی (Virtual tunnel interface)
.sp
.B vxcan
\- رابط تونل مجازی شبکه کنترل‌کننده (Controller Area Network)
.sp
.BR vxlan
\- شبکه محلی گسترش‌یافته مجازی (Virtual eXtended LAN)
.sp
.BR xfrm
\- رابط مجازی xfrm
.sp
.in -8

.TP
.BI numtxqueues " QUEUE_COUNT "
تعداد صف‌های ارسال (transmit queues) را برای دستگاه جدید مشخص می‌کند.

.TP
.BI numrxqueues " QUEUE_COUNT "
تعداد صف‌های دریافت (receive queues) را برای دستگاه جدید مشخص می‌کند.

.TP
.BI gso_max_size " BYTES "
حداکثر اندازه توصیه‌شده برای یک بسته Generic Segment Offload (GSO) را که دستگاه جدید باید بپذیرد مشخص می‌کند. این گزینه همچنین برای فعال‌سازی BIG TCP برای IPv6 روی این دستگاه در صورتی که اندازه بزرگ‌تر از ۶۵۵۳۶ باشد استفاده می‌شود.

.TP
.BI gso_ipv4_max_size " BYTES "
حداکثر اندازه توصیه‌شده برای یک بسته IPv4 Generic Segment Offload را که دستگاه جدید باید بپذیرد مشخص می‌کند. این گزینه به‌ویژه برای فعال‌سازی BIG TCP برای IPv4 روی این دستگاه با تنظیم اندازه بیشتر از ۶۵۵۳۶ استفاده می‌شود. توجه داشته باشید که برای فعال‌سازی واقعی BIG TCP برای IPv4، مقدار
.B gso_max_size
باید بزرگ‌تر یا مساوی با
.B gso_ipv4_max_size
تنظیم شود.

.TP
.BI gso_max_segs " SEGMENTS "
حداکثر تعداد توصیه‌شده قطعه‌های Generic Segment Offload (GSO) را که دستگاه جدید باید بپذیرد مشخص می‌کند.

.TP
.BI gro_max_size " BYTES "
حداکثر اندازه بسته‌ای را که توسط پشته GRO روی این دستگاه ساخته می‌شود مشخص می‌کند. این گزینه همچنین برای BIG TCP استفاده می‌شود تا اجازه دهد اندازه بسته ادغام‌شده IPv6 GSO روی این دستگاه بزرگ‌تر از ۶۵۵۳۶ باشد.

.TP
.BI gro_ipv4_max_size " BYTES "
حداکثر اندازه بسته IPv4 ساخته‌شده توسط پشته GRO روی این دستگاه را مشخص می‌کند. این گزینه به‌ویژه برای BIG TCP استفاده می‌شود تا اجازه دهد اندازه بسته ادغام‌شده IPv4 GSO روی این دستگاه بزرگ‌تر از ۶۵۵۳۶ باشد.

.TP
.BI index " IDX "
شاخص (index) مورد نظر دستگاه مجازی جدید را مشخص می‌کند. در صورتی که این شاخص در حال استفاده (اشغال) باشد، ایجاد پیوند با شکست مواجه می‌شود.

.TP
.B netns
.RI "{ " PID " | " NETNSNAME " | " NETNSFILE " }"
.br
دستگاه را در فضای نام شبکه (network namespace) مرتبط با فرآیند
.IR "PID " یا
نام
.IR "NETNSNAME " یا
فایل
.IR "NETNSFILE "
ایجاد می‌کند.
.TP
پشتیبانی از نوع VLAN (VLAN Type Support)
برای یک پیوند از نوع
.I VLAN
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add
.BI link " DEVICE "
.BI name " NAME "
.B "type vlan"
[
.BI protocol " VLAN_PROTO "
]
.BI id " VLANID "
[
.BR reorder_hdr " { " on " | " off " } "
]
[
.BR gvrp " { " on " | " off " } "
]
[
.BR mvrp " { " on " | " off " } "
]
[
.BR loose_binding " { " on " | " off " } "
]
[
.BR bridge_binding " { " on " | " off " } "
]
[
.BI ingress-qos-map " QOS-MAP "
]
[
.BI egress-qos-map " QOS-MAP "
]

.in +8
.sp
.BI protocol " VLAN_PROTO "
- یا 802.1Q یا 802.1ad.

.BI id " VLANID "
- شناسه VLAN (شناسه VLANID) مورد استفاده را مشخص می‌کند. توجه داشته باشید اعدادی که با « 0 » یا « 0x » آغاز می‌شوند، به ترتیب به صورت هشت‌هشتی (octal) یا هگزادسیمال تفسیر می‌شوند.

.BR reorder_hdr " { " on " | " off " } "
- مشخص می‌کند که آیا سرآیندهای اترنت مرتب‌سازی مجدد (reorder) می‌شوند یا خیر (پیش‌فرض
.BR on " است)."

.in +4
اگر
.BR reorder_hdr " برابر " on
باشد، سرآیند VLAN بلافاصله درج نخواهد شد، بلکه تنها پیش از ارسال به دستگاه فیزیکی (در صورتی که این دستگاه از بارگذاری سخت‌افزاری VLAN پشتیبانی نکند) درج می‌شود؛ وضعیتی مشابه نیز در جهت RX برقرار است \- به‌طور پیش‌فرض تگ بسته پیش از دریافت توسط دستگاه VLAN برداشته می‌شود (untagged). مرتب‌سازی مجدد اجازه می‌دهد برچسب‌گذاری در جهت خروج (egress) تسریع شود و سرآیند VLAN در جهت ورود (ingress) پنهان بماند تا بسته شبیه یک بسته معمولی اترنت به نظر برسد؛ در عین حال، این امر ممکن است هنگام ضبط بسته‌ها (packet capture) گیج‌کننده باشد زیرا سرآیند VLAN درون بسته وجود ندارد.

بارگذاری سخت‌افزاری VLAN (یا VLAN offloading) را می‌توان توسط
.BR ethtool "(8):"
.in +4
.sp
.B ethtool -k
<phy_dev> |
.RB grep " tx-vlan-offload"
.sp
.in -4
بررسی کرد، که در آن <phy_dev> دستگاه فیزیکی است که دستگاه VLAN به آن متصل شده است.
.in -4

.BR gvrp " { " on " | " off " } "
- مشخص می‌کند که آیا این VLAN باید با استفاده از پروتکل ثبت GARP VLAN ثبت شود یا خیر.

.BR mvrp " { " on " | " off " } "
- مشخص می‌کند که آیا این VLAN باید با استفاده از پروتکل ثبت Multiple VLAN ثبت شود یا خیر.

.BR loose_binding " { " on " | " off " } "
- مشخص می‌کند که آیا وضعیت دستگاه VLAN به وضعیت دستگاه فیزیکی وابسته است یا خیر.

.BR bridge_binding " { " on " | " off " } "
- مشخص می‌کند که آیا وضعیت پیوند دستگاه VLAN وضعیت درگاه‌های پل (bridge) که عضو VLAN هستند را دنبال می‌کند یا خیر.

.BI ingress-qos-map " QOS-MAP "
- نگاشت فیلد prio سرآیند VLAN را به اولویت داخلی بسته در لینوکس برای فریم‌های ورودی تعریف می‌کند. قالب آن به صورت FROM:TO است و نگاشت‌های متعدد با فاصله از هم جدا می‌شوند.

.BI egress-qos-map " QOS-MAP "
- نگاشت اولویت داخلی بسته در لینوکس را به فیلد prio سرآیند VLAN برای فریم‌های خروجی تعریف می‌کند. قالب آن همانند ingress-qos-map است.
.in +4

اولویت بسته لینوکس را می‌توان با
.BR iptables "(8)":
.in +4
.sp
.B iptables
-t mangle -A POSTROUTING [...] -j CLASSIFY --set-class 0:4
.sp
.in -4
تنظیم کرد و این اولویت "4" را می‌توان در نگاشت qos خروجی (egress) برای تنظیم prio مربوط به VLAN روی "5" استفاده کرد:
.sp
.in +4
.B ip
link set veth0.10 type vlan egress 4:5
.in -4
.in -4
.in -8

.TP
پشتیبانی از نوع VXLAN (VXLAN Type Support)
برای یک پیوند از نوع
.I VXLAN
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE
.BI type " vxlan " id " VNI"
[
.BI dev " PHYS_DEV "
.RB " ] [ { " group " | " remote " } "
.I IPADDR
] [
.B local
.RI "{ "IPADDR " | "any " } "
] [
.BI ttl " TTL "
] [
.BI tos " TOS "
] [
.BI df " DF "
] [
.BI flowlabel " FLOWLABEL "
] [
.BI dstport " PORT "
] [
.BI srcport " MIN MAX "
] [
.BI reserved_bits " VALUE "
] [
.RB [ no ] learning
] [
.RB [ no ] proxy
] [
.RB [ no ] rsc
] [
.RB [ no ] l2miss
] [
.RB [ no ] l3miss
] [
.RB [ no ] udpcsum
] [
.RB [ no ] udp6zerocsumtx
] [
.RB [ no ] udp6zerocsumrx
] [
.RB [ no ] localbypass
] [
.BI ageing " SECONDS "
] [
.BI maxaddress " NUMBER "
] [
.RB [ no ] external
] [
.B gbp
] [
.B gpe
] [
.RB [ no ] vnifilter
] [
.RB [ no ] mcroute
]

.in +8
.sp
.BI  id " VNI "
- شناسه شبکه VXLAN (یا شناسه قطعه VXLAN) مورد استفاده را مشخص می‌کند.

.BI dev " PHYS_DEV"
- دستگاه فیزیکی مورد استفاده برای ارتباط نقطه پایانی تونل را مشخص می‌کند.

.sp
.BI group " IPADDR"
- نشانی IP چندپخشی (multicast) برای پیوستن را مشخص می‌کند.
این پارامتر را نمی‌توان همراه با پارامتر
.B remote
مشخص کرد.

.sp
.BI remote " IPADDR"
- نشانی IP مقصد تک‌پخشی (unicast) را برای استفاده در بسته‌های خروجی، زمانی که نشانی لایه پیوند مقصد در پایگاه داده هدایت (forwarding database) دستگاه VXLAN شناخته شده نیست، مشخص می‌کند. این پارامتر را نمی‌توان همراه با پارامتر
.B group
مشخص کرد.

.sp
.BI local " IPADDR"
- نشانی IP مبدأ را برای استفاده در بسته‌های خروجی مشخص می‌کند.

.sp
.BI ttl " TTL"
- مقدار TTL را برای استفاده در بسته‌های خروجی مشخص می‌کند.

.sp
.BI tos " TOS"
- مقدار TOS را برای استفاده در بسته‌های خروجی مشخص می‌کند.

.sp
.BI df " DF"
- استفاده از بیت پرچم Don't Fragment (DF) را در بسته‌های خروجی با سرآیندهای IPv4 مشخص می‌کند. مقدار
.B inherit
باعث می‌شود این بیت از سرآیند IP اصلی کپی شود. مقادیر
.B unset
و
.B set
به ترتیب باعث می‌شوند این بیت همواره غیرفعال یا همواره فعال باشد. به‌طور پیش‌فرض، این بیت تنظیم نشده است.

.sp
.BI flowlabel " FLOWLABEL"
- برچسب جریان (flow label) را برای استفاده در بسته‌های خروجی مشخص می‌کند.

.sp
.BI dstport " PORT"
- درگاه مقصد UDP را برای برقراری ارتباط با نقطه پایانی راه دور تونل VXLAN مشخص می‌کند.

.sp
.BI srcport " MIN MAX"
- محدوده شماره درگاه‌ها را برای استفاده به عنوان درگاه‌های مبدأ UDP جهت برقراری ارتباط با نقطه پایانی راه دور تونل VXLAN مشخص می‌کند.

.sp
.BI reserved_bits " VALUE "
- به‌طور پیش‌فرض هسته بسته‌هایی را که بیت‌های تنظیم‌شده در خارج از فیلدهای مورد نیازِ ویژگی‌های فعال روی دستگاه شبکه VXLAN دارند، رد می‌کند. \fBreserved_bits\fR یک مقدار ۶۴ بیتی است که مشخص می‌کند تنظیم کدام بیت‌ها در یک سرآیند VXLAN باید امکان‌پذیر باشد. هر بیتِ تنظیم‌شده در این مقدار، یک بیتِ قابل‌قبول و مجاز در بسته است.

.sp
.RB [ no ] learning
- مشخص می‌کند که آیا نشانی‌های ناشناخته لایه پیوند و نشانی‌های IP مبدأ در پایگاه داده هدایت (forwarding database) دستگاه VXLAN ثبت شوند یا خیر.

.sp
.RB [ no ] rsc
- مشخص می‌کند که آیا میانبر مسیر (route short circuit) روشن باشد یا خیر.

.sp
.RB [ no ] proxy
- مشخص می‌کند که آیا پراکسی ARP روشن باشد یا خیر.

.sp
.RB [ no ] l2miss
- مشخص می‌کند که آیا اعلان‌های عدم یافتن نشانی لایه پیوند (LLADDR miss) در netlink تولید شوند یا خیر.

.sp
.RB [ no ] l3miss
- مشخص می‌کند که آیا اعلان‌های عدم یافتن نشانی IP (IP ADDR miss) در netlink تولید شوند یا خیر.

.sp
.RB [ no ] udpcsum
- مشخص می‌کند که آیا چک‌سام UDP برای بسته‌های ارسال‌شده روی IPv4 محاسبه شود یا خیر.

.sp
.RB [ no ] udp6zerocsumtx
- از محاسبه چک‌سام UDP برای بسته‌های ارسال‌شده روی IPv6 صرف‌نظر می‌کند.

.sp
.RB [ no ] udp6zerocsumrx
- بسته‌های UDP ورودی روی IPv6 با فیلد چک‌سام صفر را مجاز می‌شمارد.

.sp
.RB [ no ] localbypass
- اگر مقصد FDB محلی باشد، در صورت تنظیم nolocalbypass، بسته‌های کپسوله‌شده به پشته شبکه فضای کاربر (userspace) هدایت می‌شوند. اگر پردازه‌ای در فضای کاربر در حال گوش دادن به این بسته‌ها باشد، فرصت پردازش آن‌ها را خواهد داشت. اگر localbypass فعال باشد (پیش‌فرض)، پشته شبکه هسته دور زده شده و بسته‌ها به دستگاه VXLAN هدف (به فرض وجود) تزریق می‌شوند.

.sp
.BI ageing " SECONDS"
- طول عمر بر حسب ثانیه را برای مدخل‌های FDB که توسط هسته یاد گرفته شده‌اند مشخص می‌کند.

.sp
.BI maxaddress " NUMBER"
- حداکثر تعداد مدخل‌های FDB را مشخص می‌کند.

.sp
.RB [ no ] external
- مشخص می‌کند که آیا یک لایه کنترل خارجی (external control plane)
.RB "(مانند " "ip route encap" )
یا FDB داخلی باید استفاده شود.

.sp
.RB [ no ] vnifilter
- مشخص می‌کند که آیا دستگاه vxlan قابلیت فیلترسازی vni را دارد یا خیر. فقط با دستگاه vxlan که پرچم external روی آن تنظیم شده کار می‌کند. پس از فعال‌سازی، از دستور bridge vni برای مدیریت جدول فیلترسازی vni روی دستگاه استفاده می‌شود. دستگاه فقط می‌تواند بسته‌هایی را با vniهایی دریافت کند که در جدول فیلترسازی vni پیکربندی شده باشند.

.sp
.RB [ no ] mcroute
- زمانی که تونل VXLAN یک مقصد راه دور چندپخشی دارد، مشخص می‌کند که بسته‌های لایه زیرین (underlay) مستقیماً به دستگاه فیزیکی ارسال شوند (پیش‌فرض)، یا اینکه مسیریابی چندپخشی شوند. در حالت دوم، به منظور تطبیق یک مسیر چندپخشی، (S,G) به ترتیب نشانی محلی و راه دور تونل هستند و iif دستگاه فیزیکی تونل است.

.sp
.B gbp
- افزونه سیاست گروهی (VXLAN-GBP) را فعال می‌کند.

.in +4
امکان انتقال زمینه سیاست گروهی را بین گره‌های همتای شبکه VXLAN فراهم می‌کند.
در صورت فعال بودن، نشانه (mark) یک بسته را در سرآیند VXLAN برای بسته‌های خروجی می‌گنجاند و برای بسته‌های ورودی، نشانه بسته را بر اساس اطلاعات موجود در سرآیند VXLAN مقداردهی می‌کند.

قالب ۱۶ بیت بالایی نشانه بسته (پرچم‌ها):

.in +2
+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+
.br
|-|-|-|-|-|-|-|-|-|D|-|-|A|-|-|-|
.br
+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+

.B D :=
بیت Don't Learn (یاد نگیر). وقتی تنظیم شود، این بیت نشان می‌دهد که VTEP خروجی نباید نشانی مبدأ فریم کپسوله‌شده را یاد بگیرد.

.B A :=
نشان می‌دهد که سیاست گروهی قبلاً روی این بسته اعمال شده است. هنگامی که بیت A تنظیم شده باشد، سیاست‌ها نباید توسط دستگاه‌ها اعمال شوند.
.in -2

قالب ۱۶ بیت پایینی نشانه بسته (شناسه سیاست):

.in +2
+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+
.br
|        Group Policy ID        |
.br
+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+
.in -2

مثال:
  iptables -A OUTPUT [...] -j MARK --set-mark 0x800FF

.in -4

.sp
.B gpe
- افزونه پروتکل عمومی (VXLAN-GPE) را فعال می‌کند. در حال حاضر، این قابلیت تنها به همراه کلمه کلیدی
.B external
پشتیبانی می‌شود.

.in -8

.TP
پشتیبانی از نوع VETH، VXCAN (VETH, VXCAN Type Support)
برای یک پیوند از نوع
.I VETH/VXCAN
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE
.BR type " { " veth " | " vxcan " }"
[
.BR peer
.BI "name " NAME
]

.in +8
.sp
.BR peer
.BI "name " NAME
- نام دستگاه جفت مجازیِ تونل
.I VETH/VXCAN
را مشخص می‌کند.

.in -8

.TP
پشتیبانی از نوع netkit (netkit Type Support)
برای یک پیوند از نوع
.I netkit
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE
.BR type " netkit "
[
.BI mode " MODE "
] [
.BI scrub " SCRUB "
] [
.I "POLICY "
] [
.BR peer
[
.BI scrub " SCRUB "
] [
.I "POLICY "
] [
.I "NAME "
] ]

.in +8

.sp
.BI mode " MODE"
- حالت عملکرد دستگاه netkit را با مقادیر ممکن "l3" و "l2" مشخص می‌کند. گزینه پیش‌فرض "l3" است.

.sp
.BI scrub " SCRUB"
- رفتار پاک‌سازی (scrub) دستگاه netkit را با مقادیر ممکن "default" و "none" مشخص می‌کند. با مقدار "default"، هنگامی که دستگاه همتای آن در یک فضای نام شبکه متفاوت قرار دارد، دستگاه فیلدهای skb->{mark,priority} را قبل از فراخوانی برنامه BPF متصل‌شده صفر می‌کند. با مقدار "none"، دستگاه پاک‌سازی skb->{mark,priority} را به برنامه BPF واگذار می‌کند. گزینه پیش‌فرض "default" است. مشخص کردن scrub قبل از گزینه peer به دستگاه اصلی و بعد از گزینه peer به دستگاه همتا اشاره دارد.

.sp
.I "POLICY"
- خط‌مشی پیش‌فرض دستگاه را در صورت عدم اتصال برنامه‌های BPF با مقادیر ممکن "forward" و "blackhole" مشخص می‌کند. گزینه پیش‌فرض "forward" است. مشخص کردن policy قبل از گزینه peer به دستگاه اصلی و بعد از گزینه peer به دستگاه همتا اشاره دارد.

.sp
.I "NAME"
- نام دستگاهِ همتا (peer) را مشخص می‌کند.

.in -8
.TP
پشتیبانی از انواع IPIP و SIT (IPIP, SIT Type Support)
برای پیوندی از نوع
.IR IPIP " یا " SIT
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE
.BR type " { " ipip " | " sit " }"
.BI " remote " ADDR " local " ADDR
[
.BR encap " { " fou " | " gue " | " none " }"
] [
.BR encap-sport " { " \fIPORT " | " auto " }"
] [
.BI "encap-dport " PORT
] [
.RB [ no ] encap-csum
] [
.I " [no]encap-remcsum "
] [
.I " mode " { ip6ip | ipip | mplsip | any } "
] [
.BR external
]

.in +8
.sp
.BI  remote " ADDR "
- آدرس راه دور تونل را تعیین می‌کند.

.sp
.BI  local " ADDR "
- آدرس محلی ثابت را برای بسته‌های تونل‌شده تعیین می‌کند.
این آدرس باید آدرسی روی رابط دیگری در این میزبان باشد.

.sp
.BR encap " { " fou " | " gue " | " none " }"
- نوع کپسوله‌سازی ثانویه UDP را تعیین می‌کند. "fou" نشان‌دهنده
Foo-Over-UDP و "gue" نشان‌دهنده Generic UDP Encapsulation است.

.sp
.BR encap-sport " { " \fIPORT " | " auto " }"
- درگاه مبدأ در کپسوله‌سازی UDP را تعیین می‌کند.
.IR PORT
درگاه را بر اساس شماره مشخص می‌کند، "auto"
مشخص می‌کند که شماره درگاه باید به‌طور خودکار انتخاب شود
(هسته یک جریان را بر اساس هش جریان (flow hash)
بسته کپسوله‌شده انتخاب می‌کند).

.sp
.RB [ no ] encap-csum
- مشخص می‌کند که آیا چکسام‌های UDP در کپسوله‌سازی ثانویه
فعال باشند یا خیر.

.sp
.RB [ no ] encap-remcsum
- مشخص می‌کند که آیا تخلیه بار چکسام راه دور (Remote Checksum Offload) فعال باشد یا خیر. این گزینه فقط
برای Generic UDP Encapsulation کاربرد دارد.

.sp
.BI mode " { ip6ip | ipip | mplsip | any } "
- حالتی را که دستگاه باید در آن کار کند تعیین می‌کند. "ip6ip" نشان‌دهنده
IPv6-Over-IPv4، "ipip" نشان‌دهنده "IPv4-Over-IPv4"، "mplsip" نشان‌دهنده
MPLS-Over-IPv4 و "any" نشان‌دهنده IPv6، IPv4 یا MPLS Over IPv4 است. برای
SIT که پیش‌فرض آن "ip6ip" است و IPIP که پیش‌فرض آن "ipip" است، پشتیبانی می‌شود.
IPv6-Over-IPv4 برای IPIP پشتیبانی نمی‌شود.

.sp
.BR external
- این تونل را تحت کنترل خارجی قرار می‌دهد
.RB "(مانند " "ip route encap" ).

.in -8
.TP
پشتیبانی از نوع GRE (GRE Type Support)
برای پیوندی از نوع
.IR GRE " یا " GRETAP
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE
.BR type " { " gre " | " gretap " }"
.BI " remote " ADDR " local " ADDR
[
.RB [ no ] "" [ i | o ] seq
] [
.RB [ i | o ] key
.I KEY
|
.BR no [ i | o ] key
] [
.RB [ no ] "" [ i | o ] csum
] [
.BI ttl " TTL "
] [
.BI tos " TOS "
] [
.RB [ no ] pmtudisc
] [
.RB [ no ] ignore-df
] [
.BI dev " PHYS_DEV "
] [
.BR encap " { " fou " | " gue " | " none " }"
] [
.BR encap-sport " { " \fIPORT " | " auto " }"
] [
.BI "encap-dport " PORT
] [
.RB [ no ] encap-csum
] [
.RB [ no ] encap-remcsum
] [
.BR external
]

.in +8
.sp
.BI  remote " ADDR "
- آدرس راه دور تونل را تعیین می‌کند.

.sp
.BI  local " ADDR "
- آدرس محلی ثابت را برای بسته‌های تونل‌شده تعیین می‌کند.
این آدرس باید آدرسی روی رابط دیگری در این میزبان باشد.

.sp
.RB  [ no ] "" [ i | o ] seq
- توالی‌بندی بسته‌ها.
پرچم
.B oseq
توالی‌گذاری بسته‌های خروجی را فعال می‌کند.
پرچم
.B iseq
الزام می‌کند که همه بسته‌های ورودی دارای توالی باشند.

.sp
.RB [ i | o ] key
.I KEY
|
.BR no [ i | o ] key
- استفاده از GRE کلیددار با کلید
.IR KEY ". " KEY
یا یک عدد است یا یک چهاربخشی نقطه‌دار مشابه آدرس IPv4.
پارامتر
.B key
همان کلید را برای استفاده در هر دو جهت مشخص می‌کند.
پارامترهای
.BR ikey " و " okey
کلیدهای متفاوتی را برای ورودی و خروجی تعیین می‌کنند.

.sp
.RB  [ no ] "" [ i | o ] csum
- تولید/الزام چکسام برای بسته‌های تونل‌شده.
پرچم
.B ocsum
چکسام را برای بسته‌های خروجی محاسبه می‌کند.
پرچم
.B icsum
الزام می‌کند که همه بسته‌های ورودی دارای چکسام صحیح باشند.
پرچم
.B csum
معادل ترکیب
.B "icsum ocsum"
است.

.sp
.BI ttl " TTL"
- مقدار TTL را برای استفاده در بسته‌های خروجی تعیین می‌کند.

.sp
.BI tos " TOS"
- مقدار TOS را برای استفاده در بسته‌های خروجی تعیین می‌کند.

.sp
.RB [ no ] pmtudisc
- کشف MTU مسیر (Path MTU Discovery) را روی این تونل فعال/غیرفعال می‌کند.
این گزینه به‌طور پیش‌فرض فعال است. توجه داشته باشید که یک ttl ثابت با این گزینه
ناسازگار است: تونل‌سازی با یک ttl ثابت همیشه کشف pmtu را انجام می‌دهد.

.sp
.RB [ no ] ignore-df
- سرکوب فلگ DF در IPv4 را روی این تونل فعال/غیرفعال می‌کند.
به‌طور معمول دیتاگرام‌هایی که از MTU فراتر روند قطعه‌قطعه می‌شوند؛ وجود
فلگ DF مانع از این کار شده و در عوض منجر به پیام ICMP Unreachable
(Fragmentation Required) می‌شود. فعال‌سازی این ویژگی باعث نادیده گرفتن
فلگ DF می‌گردد.

.sp
.BI dev " PHYS_DEV"
- دستگاه فیزیکی مورد استفاده برای ارتباط نقطه پایانی تونل را تعیین می‌کند.

.sp
.BR encap " { " fou " | " gue " | " none " }"
- نوع کپسوله‌سازی ثانویه UDP را تعیین می‌کند. "fou" نشان‌دهنده
Foo-Over-UDP و "gue" نشان‌دهنده Generic UDP Encapsulation است.

.sp
.BR encap-sport " { " \fIPORT " | " auto " }"
- درگاه مبدأ در کپسوله‌سازی UDP را تعیین می‌کند.
.IR PORT
درگاه را بر اساس شماره مشخص می‌کند، "auto"
مشخص می‌کند که شماره درگاه باید به‌طور خودکار انتخاب شود
(هسته یک جریان را بر اساس هش جریان (flow hash)
بسته کپسوله‌شده انتخاب می‌کند).

.sp
.RB [ no ] encap-csum
- مشخص می‌کند که آیا چکسام‌های UDP در کپسوله‌سازی ثانویه
فعال باشند یا خیر.

.sp
.RB [ no ] encap-remcsum
- مشخص می‌کند که آیا تخلیه بار چکسام راه دور (Remote Checksum Offload) فعال باشد یا خیر. این گزینه فقط
برای Generic UDP Encapsulation کاربرد دارد.

.sp
.BR external
- این تونل را تحت کنترل خارجی قرار می‌دهد
.RB "(مانند " "ip route encap" ).

.in -8

.TP
پشتیبانی از انواع IP6GRE و IP6GRETAP (IP6GRE/IP6GRETAP Type Support)
برای پیوندی از نوع
.I IP6GRE/IP6GRETAP
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE
.BR type " { " ip6gre " | " ip6gretap " }"
.BI remote " ADDR " local " ADDR"
[
.RB [ no ] "" [ i | o ] seq
] [
.RB [ i | o ] key
.I KEY
|
.BR no [ i | o ] key
] [
.RB [ no ] "" [ i | o ] csum
] [
.BI hoplimit " TTL "
] [
.BI encaplimit " ELIM "
] [
.BI tclass " TCLASS "
] [
.BI flowlabel " FLOWLABEL "
] [
.BI "dscp inherit"
] [
.BI "[no]allow-localremote"
] [
.BI dev " PHYS_DEV "
] [
.RB external
]

.in +8
.sp
.BI  remote " ADDR "
- آدرس IPv6 راه دور تونل را تعیین می‌کند.

.sp
.BI  local " ADDR "
- آدرس IPv6 محلی ثابت را برای بسته‌های تونل‌شده تعیین می‌کند.
این آدرس باید آدرسی روی رابط دیگری در این میزبان باشد.

.sp
.RB  [ no ] "" [ i | o ] seq
- توالی‌بندی بسته‌ها.
پرچم
.B oseq
توالی‌گذاری بسته‌های خروجی را فعال می‌کند.
پرچم
.B iseq
الزام می‌کند که همه بسته‌های ورودی دارای توالی باشند.

.sp
.RB [ i | o ] key
.I KEY
|
.BR no [ i | o ] key
- استفاده از GRE کلیددار با کلید
.IR KEY ". " KEY
یا یک عدد است یا یک چهاربخشی نقطه‌دار مشابه آدرس IPv4.
پارامتر
.B key
همان کلید را برای استفاده در هر دو جهت مشخص می‌کند.
پارامترهای
.BR ikey " و " okey
کلیدهای متفاوتی را برای ورودی و خروجی تعیین می‌کنند.

.sp
.RB  [ no ] "" [ i | o ] csum
- تولید/الزام چکسام برای بسته‌های تونل‌شده.
پرچم
.B ocsum
چکسام را برای بسته‌های خروجی محاسبه می‌کند.
پرچم
.B icsum
الزام می‌کند که همه بسته‌های ورودی دارای چکسام صحیح باشند.
پرچم
.B csum
معادل ترکیب
.BR "icsum ocsum"
است.

.sp
.BI  hoplimit " TTL"
- مقدار Hop Limit را برای استفاده در بسته‌های خروجی تعیین می‌کند.

.sp
.BI  encaplimit " ELIM"
- یک محدودیت کپسوله‌سازی ثابت را تعیین می‌کند. مقدار پیش‌فرض 4 است.

.sp
.BI  flowlabel " FLOWLABEL"
- یک برچسب جریان ثابت را تعیین می‌کند.

.sp
.BI  [no]allow-localremote
- مشخص می‌کند که آیا به نقطه پایانی راه دور اجازه داده شود آدرسی پیکربندی‌شده روی
میزبان محلی داشته باشد یا خیر.

.sp
.BI  tclass " TCLASS"
- فیلد کلاس ترافیک (traffic class) را روی بسته‌های تونل‌شده
تعیین می‌کند، که می‌تواند به‌صورت یک مقدار هگزادسیمال دو رقمی
(مانند c0) یا یک رشته از پیش‌تعریف‌شده (مانند internet) مشخص شود.
مقدار
.B inherit
باعث می‌شود این فیلد از سرایند اصلی IP کپی شود. مقادیر
.BI "inherit/" STRING
یا
.BI "inherit/" 00 ".." ff
هنگام تونل‌سازی بسته‌های غیر IP، این فیلد را روی
.I STRING
یا
.IR 00 ".." ff
تنظیم می‌کنند. مقدار پیش‌فرض 00 است.

.sp
.RB external
- این تونل را تحت کنترل خارجی قرار می‌دهد (یا خیر، که حالت پیش‌فرض است).
در هسته، به این حالت جمع‌آوری فراداده (collect metadata mode) گفته می‌شود. این پرچم با گزینه‌های
.BR remote ،
.BR local ،
.BR seq ،
.BR key ،
.BR csum ،
.BR hoplimit ،
.BR encaplimit ،
.BR flowlabel " و " tclass
مانعةالجمع (ناسازگار با یکدیگر) است.

.in -8

.TP
پشتیبانی از نوع IPoIB (IPoIB Type Support)
برای پیوندی از نوع
.I IPoIB
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE " name " NAME
.BR "type ipoib " [ " pkey \fIPKEY" " ] [ " mode " \fIMODE \fR]"

.in +8
.sp
.BI  pkey " PKEY "
- کلید IB P-Key مورد استفاده را تعیین می‌کند.

.BI  mode " MODE "
- حالت مورد استفاده (datagram یا connected) را تعیین می‌کند.

.TP
پشتیبانی از نوع ERSPAN (ERSPAN Type Support)
برای پیوندی از نوع
.I ERSPAN/IP6ERSPAN
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE
.BR type " { " erspan " | " ip6erspan " }"
.BI remote " ADDR " local " ADDR " seq
.RB key
.I KEY
.BR erspan_ver " \fIversion "
[
.BR erspan " \fIIDX "
] [
.BR erspan_dir " { " \fIingress " | " \fIegress " }"
] [
.BR erspan_hwid " \fIhwid "
] [
.BI "[no]allow-localremote"
] [
.RB external
]

.in +8
.sp
.BI  remote " ADDR "
- آدرس راه دور تونل را تعیین می‌کند.

.sp
.BI  local " ADDR "
- آدرس محلی ثابت را برای بسته‌های تونل‌شده تعیین می‌کند.
این آدرس باید آدرسی روی رابط دیگری در این میزبان باشد.

.sp
.BR erspan_ver " \fIversion "
- شماره نسخه ERSPAN را تعیین می‌کند.
.IR version
نسخه ERSPAN را که باید ایجاد شود مشخص می‌کند: 0 برای نسخه 0 نوع I،
1 برای نسخه 1 (نوع II) یا 2 برای نسخه 2 (نوع III).

.sp
.BR erspan " \fIIDX "
- فیلد شاخص ERSPAN v1 را تعیین می‌کند.
.IR IDX
یک شماره شاخص/درگاه 20 بیتی مرتبط با درگاه مبدأ و جهت ترافیک ERSPAN را
مشخص می‌کند.

.sp
.BR erspan_dir " { " \fIingress " | " \fIegress " }"
- جهت ترافیک آینه‌شده (mirrored traffic) در ERSPAN v2 را تعیین می‌کند.

.sp
.BR erspan_hwid " \fIhwid "
- یک شناسه یکتا برای یک موتور ERSPAN v2 درون سیستم است.
.IR hwid
یک مقدار 6 بیتی برای پیکربندی توسط کاربر است.

.sp
.BI  [no]allow-localremote
- مشخص می‌کند که آیا به نقطه پایانی راه دور اجازه داده شود آدرسی پیکربندی‌شده روی
میزبان محلی داشته باشد یا خیر.

.sp
.BR external
- این تونل را تحت کنترل خارجی قرار می‌دهد (یا خیر، که حالت پیش‌فرض است).
در هسته، به این حالت جمع‌آوری فراداده (collect metadata mode) گفته می‌شود. این پرچم با گزینه‌های
.BR remote ،
.BR local ،
.BR erspan_ver ،
.BR erspan ،
.BR erspan_dir " و " erspan_hwid
مانعةالجمع (ناسازگار با یکدیگر) است.

.in -8
.TP
پشتیبانی از نوع GENEVE (GENEVE Type Support)
برای پیوندی از نوع
.I GENEVE
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE
.BI type " geneve " id " VNI " remote " IPADDR"
[
.BI local " IPADDR "
] [
.BI ttl " TTL "
] [
.BI tos " TOS "
] [
.BI df " DF "
] [
.BI flowlabel " FLOWLABEL "
] [
.BI dstport " PORT"
] [
.RB [ no ] external
] [
.RB [ no ] udpcsum
] [
.RB [ no ] udp6zerocsumtx
] [
.RB [ no ] udp6zerocsumrx
] [
.B innerprotoinherit
]

.in +8
.sp
.BI  id " VNI "
- شناسه شبکه مجازی (Virtual Network Identifier) را برای استفاده مشخص می‌کند.

.sp
.BI remote " IPADDR"
- آدرس IP مقصد تک‌پخشی (unicast) را برای استفاده در بسته‌های خروجی مشخص می‌کند.

.sp
.BI local " IPADDR"
- آدرس IP مبدأ را برای شنود ترافیک مشخص می‌کند.

.sp
.BI ttl " TTL"
- مقدار TTL را برای استفاده در بسته‌های خروجی مشخص می‌کند. مقدار "0" یا "auto" به معنای
استفاده از مقدار پیش‌فرض است، "inherit" به معنای به ارث بردن ttl پروتکل
داخلی است. گزینه پیش‌فرض "0" است.

.sp
.BI tos " TOS"
- مقدار TOS را برای استفاده در بسته‌های خروجی مشخص می‌کند.

.sp
.BI df " DF"
- استفاده از بیت پرچم Don't Fragment (DF) را در بسته‌های خروجی دارای سرآیندهای
IPv4 مشخص می‌کند. مقدار
.B inherit
باعث کپی شدن بیت از سرآیند اصلی IP می‌شود. مقادیر
.B unset
و
.B set
به ترتیب باعث می‌شوند این بیت همیشه غیرفعال یا همیشه فعال باشد. به‌طور پیش‌فرض،
این بیت تنظیم نشده است (غیرفعال است).

.sp
.BI flowlabel " FLOWLABEL"
- برچسب جریان (flow label) را برای استفاده در بسته‌های خروجی مشخص می‌کند.

.sp
.BI dstport " PORT"
- انتخاب یک درگاه مقصد به غیر از مقدار پیش‌فرض 6081.

.sp
.RB [ no ] external
- این تونل را به‌صورت خارجی کنترل‌شده درمی‌آورد (یا کنترل‌نشده، که حالت پیش‌فرض است). این
پرچم با گزینه‌های
.BR id ,
.BR remote ,
.BR ttl ,
.BR tos " و " flowlabel
مانعةالجمع است.

.sp
.RB [ no ] udpcsum
- مشخص می‌کند که آیا چکسام UDP برای بسته‌های ارسالی روی IPv4 محاسبه شود یا خیر.

.sp
.RB [ no ] udp6zerocsumtx
- صرف‌نظر کردن از محاسبه چکسام UDP برای بسته‌های ارسالی روی IPv6.

.sp
.RB [ no ] udp6zerocsumrx
- مجاز دانستن بسته‌های ورودی UDP روی IPv6 با فیلد چکسام صفر.

.sp
.B innerprotoinherit
- استفاده از IPv4/IPv6 به عنوان پروتکل داخلی به جای Ethernet.

.in -8

.TP
پشتیبانی از نوع Bareudp (Bareudp Type Support)
برای پیوندی از نوع
.I Bareudp
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE
.BI type " bareudp " dstport " PORT " ethertype " PROTO"
[
.BI srcportmin " PORT "
] [
.RB [ no ] multiproto
]

.in +8
.sp
.BI dstport " PORT"
- درگاه مقصد را برای تونل UDP مشخص می‌کند.

.sp
.BI ethertype " PROTO"
- مقدار ethertype پروتکل لایه ۳ که تونل می‌شود را مشخص می‌کند.
.B ethertype
می‌تواند به عنوان شماره پروتکل ساده Ethernet یا با استفاده از نام پروتکل
("ipv4"، "ipv6"، "mpls_uc" و غیره) تعیین شود.

.sp
.BI srcportmin " PORT"
- کمترین مقدار محدوده درگاه مبدأ تونل UDP را انتخاب می‌کند.

.sp
.RB [ no ] multiproto
- پشتیبانی از پروتکل‌های مشابه پروتکل
.RB "مشخص‌شده توسط " ethertype
را فعال می‌کند. هنگامی که
.B ethertype
برابر "mpls_uc" باشد (یعنی MPLS تک‌پخشی)، این گزینه به تونل امکان می‌دهد
MPLS چندپخشی را نیز مدیریت کند.
هنگامی که
.B ethertype
برابر "ipv4" باشد، این گزینه به تونل اجازه می‌دهد IPv6 را نیز مدیریت کند. این گزینه به‌طور پیش‌فرض
غیرفعال است.

.TP
پشتیبانی از نوع AMT (AMT Type Support)
برای پیوندی از نوع
.I AMT
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE
.BI type " AMT " discovery " IPADDR " mode " { " gateway " | " relay " } "
.BI local " IPADDR " dev " PHYS_DEV " [
.BI relay_port " PORT " ]
[
.BI gateway_port " PORT " ]
[
.BI max_tunnels " NUMBER "
]

.in +8
.sp
.BI discovery " IPADDR"
- آدرس IP تک‌پخشی اکتشاف (discovery) را برای یافتن آدرس IP راه دور مشخص می‌کند.

.BR mode " { " gateway " | " relay " } "
- نقش AMT را مشخص می‌کند: Gateway (درگاه) یا Relay (رله)

.BI local " IPADDR "
- آدرس IP مبدأ را برای استفاده در بسته‌های خروجی مشخص می‌کند.

.BI dev " PHYS_DEV "
- رابط فیزیکی زیرین را که ترافیک تبدیل از طریق آن ارسال و دریافت می‌شود مشخص می‌کند.

.BI relay_port " PORT "
- درگاه UDP رله را برای برقراری ارتباط با Relay مشخص می‌کند.

.BI gateway_port " PORT "
- درگاه UDP گیت‌وی را برای برقراری ارتباط با Gateway مشخص می‌کند.

.BI max_tunnels " NUMBER "
- حداکثر تعداد تونل‌ها را مشخص می‌کند.

.in -8

.TP
پشتیبانی از نوع MACVLAN و MACVTAP (MACVLAN and MACVTAP Type Support)
برای پیوندی از نوع
.I MACVLAN
یا
.I MACVTAP
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add link " DEVICE " name " NAME
.BR type " { " macvlan " | " macvtap " } "
.BR mode " { " private " | " vepa " | " bridge " | " passthru
.RB " [ " nopromisc " ] | " source " [ " nodst " ] } "
.RB " [ " bcqueuelen " { " LENGTH " } ] "
.RB " [ " bclim " " LIMIT " ] "

.in +8
.sp
.BR type " { " macvlan " | " macvtap " } "
- نوع پیوند مورد استفاده را مشخص می‌کند.
.BR macvlan " فقط یک رابط مجازی ایجاد می‌کند، در حالی که "
.BR macvtap " علاوه بر آن یک دستگاه کاراکتری (character device) به نام "
.BR /dev/tapX " ایجاد می‌کند تا دقیقاً مانند یک دستگاه " tuntap " استفاده شود."

.B mode private
- اجازه برقراری ارتباط بین نمونه‌های
.B macvlan
روی رابط فیزیکی یکسان را نمی‌دهد، حتی اگر سوئیچ خارجی از حالت hairpin پشتیبانی کند.

.B mode vepa
- حالت Virtual Ethernet Port Aggregator (تجمیع‌کننده پورت اترنت مجازی). داده‌ها از یک نمونه
.B macvlan
به نمونه دیگر روی همان رابط فیزیکی از طریق رابط فیزیکی انتقال می‌یابند. یا سوئیچ متصل باید از حالت hairpin پشتیبانی کند، یا باید یک مسیریاب TCP/IP وجود داشته باشد که بسته‌ها را برای برقراری ارتباط هدایت کند. این حالت پیش‌فرض است.

.B mode bridge
- در حالت bridge (پل)، همه نقاط پایانی مستقیماً به یکدیگر متصل هستند و ارتباط از طریق طرف مقابل رابط فیزیکی بازهدایت نمی‌شود.

.BR mode " " passthru " [ " nopromisc " ] "
- این حالت گذر مستقیم (پاس‌ترو / passthrough) اختیارات بیشتری به یک نقطه پایانی منفرد می‌دهد، معمولاً در حالت
.BR macvtap " . این حالت برای بیش از یک نقطه پایانی روی همان "
رابط فیزیکی مجاز نیست. تمام ترافیک به این نقطه پایانی هدایت خواهد شد، که به مهمان‌های virtio اجازه می‌دهد آدرس MAC را تغییر دهند یا حالت promiscuous را تنظیم کنند تا رابط را پل (bridge) کرده یا رابط‌های vlan را روی آن ایجاد نمایند. به‌طور پیش‌فرض، این حالت رابط زیرین را به حالت promiscuous وادار می‌کند. ارسال پرچم
.BR nopromisc " از این کار جلوگیری می‌کند، بنابراین پرچم promisc می‌تواند "
با استفاده از ابزارهای استاندارد کنترل شود.

.BR mode " " source " [ " nodst " ] "
- امکان تنظیم فهرستی از آدرس‌های mac مجاز را فراهم می‌کند که برای تطبیق با آدرس mac مبدأ از فریم‌های دریافتی روی رابط زیرین استفاده می‌شود. این قابلیت امکان ایجاد ارتباط‌های VLAN مبتنی بر mac را به جای موارد استاندارد مبتنی بر درگاه یا برچسب فراهم می‌آورد. این ویژگی برای پیاده‌سازی رفتار مبتنی بر mac در 802.1x مفید است، در جاهایی که درایورهای رابط‌های زیرین اجازه آن را نمی‌دهند. به‌طور پیش‌فرض، بسته‌ها برای MACVLAN مبتنی بر مقصد نیز در نظر گرفته می‌شوند (تکثیر می‌شوند). ارسال پرچم
.BR nodst " مانع از آن می‌شود که بسته‌های منطبق از جریان مبتنی بر مقصد "
نیز عبور کنند.

.BR bcqueuelen " { " LENGTH " } "
- طول صف RX مورد استفاده برای پردازش بسته‌های همگانی (broadcast) و چندپخشی (multicast) را تنظیم می‌کند.
.BR LENGTH " باید یک عدد صحیح مثبت در محدوده [0-4294967295] باشد."
تنظیم طول 0 به‌طور مؤثری تمام ترافیک همگانی/چندپخشی را دور می‌اندازد (drop می‌کند).
در صورت عدم تعیین، مقدار پیش‌فرض درایور macvlan یعنی (1000) استفاده می‌شود.
توجه داشته باشید که همه macvlanهایی که از یک دستگاه زیرین مشترک استفاده می‌کنند از یک
.RB "صف یکسان بهره می‌برند. پارامتر در اینجا یک " درخواست " است، طول واقعی صف استفاده‌شده"
برابر با حداکثر طولی خواهد بود که هر یک از رابط‌های macvlan درخواست کرده است.
هنگام فهرست کردن پارامترهای دستگاه، هم پارامتر bcqueuelen و هم bcqueuelen واقعی استفاده‌شده فهرست می‌شوند تا به کاربر در درک بهتر این تنظیم کمک کنند.

.BR bclim " " LIMIT
- آستانه صف‌بندی همگانی (broadcast queueing) را تنظیم می‌کند.
.BR LIMIT " باید یک عدد صحیح ۳۲ بیتی باشد."
تنظیم این مقدار روی -1 صف‌بندی همگانی را کاملاً غیرفعال می‌کند. در غیر این صورت، اگر تعداد دستگاه‌هایی که از یک آدرس چندپخشی استفاده می‌کنند بیشتر از مقدار داده‌شده باشد، آن آدرس به عنوان همگانی در صف قرار می‌گیرد.
.in -8

.TP
پشتیبانی از HSR (High-availability Seamless Redundancy)
برای پیوندی از نوع
.I HSR
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add link " DEVICE " name " NAME " type hsr"
.BI slave1 " SLAVE1-IF " slave2 " SLAVE2-IF "
.RB [ " interlink"
.IR INTERLINK-IF " ] "
.RB [ " supervision"
.IR ADDR-BYTE " ] ["
.BR version " { " 0 " | " 1 " } ["
.BR proto " { " 0 " | " 1 " } ]"

.in +8
.sp
.BR type " hsr "
- نوع پیوند مورد استفاده را مشخص می‌کند، در اینجا HSR.

.BI slave1 " SLAVE1-IF "
- دستگاه فیزیکی مورد استفاده برای اولین درگاه از دو درگاه حلقه (ring ports) را مشخص می‌کند.

.BI slave2 " SLAVE2-IF "
- دستگاه فیزیکی مورد استفاده برای دومین درگاه از دو درگاه حلقه را مشخص می‌کند.

.BI interlink " INTERLINK-IF"
- دستگاه میان‌پیوند (interlink) متصل به شبکه HSR برای اتصال دستگاه(های) SAN.

.BI supervision " ADDR-BYTE"
- آخرین بایت آدرس چندپخشی مورد استفاده برای فریم‌های نظارتی HSR.
گزینه پیش‌فرض "0" است، مقادیر ممکن 0-255 هستند.

.BR version " { " 0 " | " 1 " }"
- نسخه پروتکل رابط را انتخاب می‌کند. گزینه پیش‌فرض "0" است که
مربوط به نسخه ۲۰۱۰ استاندارد HSR می‌باشد. گزینه "1" نسخه
۲۰۱۲ را فعال می‌کند.

.BR proto " { " 0 " | " 1 " }"
- پروتکل را در رابط انتخاب می‌کند. گزینه پیش‌فرض "0" است که
مربوط به استاندارد HSR می‌باشد. گزینه "1" پروتکل افزونگی موازی
(Parallel Redundancy Protocol - PRP) را فعال می‌کند.
.
.in -8
.TP
پشتیبانی از نوع BRIDGE (BRIDGE Type Support)
برای پیوندی از نوع
.I BRIDGE
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE " type bridge "
[
.BI ageing_time " AGEING_TIME "
] [
.BI group_fwd_mask " MASK "
] [
.BI group_address " ADDRESS "
] [
.BI forward_delay " FORWARD_DELAY "
] [
.BI hello_time " HELLO_TIME "
] [
.BI max_age " MAX_AGE "
] [
.BI stp_state " STP_STATE "
] [
.BI stp_mode " STP_MODE "
] [
.BI mst_enabled " MST_ENABLED "
] [
.BI priority " PRIORITY "
] [
.BI no_linklocal_learn " NO_LINKLOCAL_LEARN "
] [
.BI fdb_local_vlan_0 " FDB_LOCAL_VLAN_0 "
] [
.BI fdb_max_learned " FDB_MAX_LEARNED "
] [
.BI vlan_filtering " VLAN_FILTERING "
] [
.BI vlan_protocol " VLAN_PROTOCOL "
] [
.BI vlan_default_pvid " VLAN_DEFAULT_PVID "
] [
.BI vlan_stats_enabled " VLAN_STATS_ENABLED "
] [
.BI vlan_stats_per_port " VLAN_STATS_PER_PORT "
] [
.BI mcast_snooping " MULTICAST_SNOOPING "
] [
.BI mcast_vlan_snooping " MULTICAST_VLAN_SNOOPING "
] [
.BI mcast_router " MULTICAST_ROUTER "
] [
.BI mcast_query_use_ifaddr " MCAST_QUERY_USE_IFADDR "
] [
.BI mcast_querier " MULTICAST_QUERIER "
] [
.BI mcast_hash_elasticity " HASH_ELASTICITY "
] [
.BI mcast_hash_max " HASH_MAX "
] [
.BI mcast_last_member_count " LAST_MEMBER_COUNT "
] [
.BI mcast_startup_query_count " STARTUP_QUERY_COUNT "
] [
.BI mcast_last_member_interval " LAST_MEMBER_INTERVAL "
] [
.BI mcast_membership_interval " MEMBERSHIP_INTERVAL "
] [
.BI mcast_querier_interval " QUERIER_INTERVAL "
] [
.BI mcast_query_interval " QUERY_INTERVAL "
] [
.BI mcast_query_response_interval " QUERY_RESPONSE_INTERVAL "
] [
.BI mcast_startup_query_interval " STARTUP_QUERY_INTERVAL "
] [
.BI mcast_stats_enabled " MCAST_STATS_ENABLED "
] [
.BI mcast_igmp_version " IGMP_VERSION "
] [
.BI mcast_mld_version " MLD_VERSION "
] [
.BI nf_call_iptables " NF_CALL_IPTABLES "
] [
.BI nf_call_ip6tables " NF_CALL_IP6TABLES "
] [
.BI nf_call_arptables " NF_CALL_ARPTABLES "
] [
.BI mdb_offload_fail_notification " MDB_OFFLOAD_FAIL_NOTIFICATION "
]

.in +8
.sp
.BI ageing_time " AGEING_TIME "
- پیکربندی زمان کهنگی / انقضا (ageing time) ورودی‌های FDB پل؛ یعنی تعداد ثانیه‌هایی که یک آدرس MAC پس از دریافت بسته از آن آدرس، در FDB نگهداری می‌شود. پس از گذشت این زمان، ورودی‌ها پاکسازی می‌شوند.

.BI group_fwd_mask " MASK "
- تنظیم ماسک هدایت گروهی (group forward mask). این ماسک بیتی است که برای تصمیم‌گیری در مورد هدایت فریم‌های ورودی به مقصد آدرس‌های محلی پیوند (link-local)، یعنی آدرس‌هایی به شکل 01:80:C2:00:00:0X اعمال می‌شود (پیش‌فرض 0 است، یعنی پل هیچ فریم محلی پیوندی را هدایت نمی‌کند).

.BI group_address " ADDRESS "
- تنظیم آدرس MAC گروه چندپخشی که این پل برای درخت پوشا (STP) استفاده می‌کند. آدرس باید یک آدرس محلی پیوند در قالب استاندارد آدرس MAC اترنت باشد، یعنی آدرسی به شکل 01:80:C2:00:00:0X، به طوری که X در بازه [0, 4..f] قرار داشته باشد.

.BI forward_delay " FORWARD_DELAY "
- تنظیم تاخیر هدایت (forwarding delay) بر حسب ثانیه، یعنی مدت زمان سپری‌شده در وضعیت LISTENING (پیش از رفتن به LEARNING) و در وضعیت LEARNING (پیش از رفتن به FORWARDING). تنها در صورت فعال بودن STP مرتبط است. مقادیر معتبر بین 2 و 30 هستند.

.BI hello_time " HELLO_TIME "
- تنظیم زمان بر حسب ثانیه بین بسته‌های hello ارسال‌شده توسط پل، هنگامی که یک پل ریشه یا یک پل تعیین‌شده (designated bridge) است. تنها در صورت فعال بودن STP مرتبط است. مقادیر معتبر بین 1 و 10 هستند.

.BI max_age " MAX_AGE "
- تنظیم مهلت زمانی (timeout) بسته hello، یعنی زمان بر حسب ثانیه تا هنگامی که فرض شود پل دیگری در درخت پوشا (spanning tree) پس از دریافت آخرین پیام hello آن، از کار افتاده است. تنها در صورت فعال بودن STP مرتبط است. مقادیر معتبر بین 6 و 40 هستند.

.BI stp_state " STP_STATE "
- فعال کردن پروتکل درخت پوشا (STP)
.RI ( STP_STATE " > 0) "
یا غیرفعال کردن آن
.RI ( STP_STATE " == 0). "
برای این پل.

.BI stp_mode " STP_MODE "
- تنظیم حالت STP برای این پل. این گزینه نحوه انتخاب پل میان STP فضای کاربری (userspace) و هسته (kernel) را هنگامی که STP از طریق
.BR stp_state
فعال شده باشد، کنترل می‌کند.
.I STP_MODE
می‌تواند یکی از موارد زیر باشد:
.in +8
.sp
.B auto
(پیش‌فرض) - فراخوانی ابزار کمکی
.B /sbin/bridge-stp
برای واگذاری پل به دیمن STP در فضای کاربری. این مورد تنها در فضای نام شبکه اولیه (initial network namespace) انجام می‌شود؛ در سایر فضاهای نام، به STP هسته برمی‌گردد (fallback).

.B user
- فعال‌سازی مستقیم STP در فضای کاربری بدون فراخوانی ابزار کمکی. در هر فضای نام شبکه‌ای کار می‌کند. فراخواننده مسئول ثبت پل در دیمن STP فضای کاربری است.

.B kernel
- فعال‌سازی مستقیم STP هسته بدون فراخوانی ابزار کمکی.
.in -8

تنها زمانی قابل تغییر است که STP غیرفعال باشد. هر دوی
.B stp_mode
و
.B stp_state
را می‌توان در یک دستور تنظیم کرد.

.BI mst_enabled " MST_ENABLED "
- فعال کردن پشتیبانی از درخت پوشای چندگانه (MST)
.RI ( MST_ENABLED " > 0) "
یا غیرفعال کردن آن
.RI ( MST_ENABLED " == 0). "
در صورت فعال بودن، مجموعه‌هایی از VLANها می‌توانند با چندین نمونه درخت پوشا (MSTIs) مرتبط شوند و وضعیت‌های STP برای هر درگاه بر اساس هر MSTI کنترل گردد. توجه: هیچ پیاده‌سازی از پروتکل MSTP ارائه نشده است، بلکه فقط پایه‌های اولیه‌ی مورد نیاز برای پیاده‌سازی آن فراهم شده است. برای جلوگیری از تداخل با وضعیت‌های قدیمی STP به ازای هر VLAN، این تنظیم تنها زمانی قابل تغییر است که هیچ VLAN پلی پیکربندی نشده باشد.

.BI priority " PRIORITY "
- تنظیم اولویت درخت پوشای این پل، که در فرآیند انتخاب پل ریشه STP استفاده می‌شود.
.I PRIORITY
یک عدد صحیح بدون علامت 16 بیتی است.

.BI no_linklocal_learn " NO_LINKLOCAL_LEARN "
- فعال کردن یادگیری محلی پیوند (link-local learning)
.RI ( NO_LINKLOCAL_LEARN " == 0) "
یا غیرفعال کردن آن
.RI ( NO_LINKLOCAL_LEARN " > 0). "
در صورت غیرفعال بودن، پل از فریم‌های محلی پیوند یادگیری انجام نمی‌دهد (پیش‌فرض: فعال).

.BI fdb_local_vlan_0 " FDB_LOCAL_VLAN_0 "
در صورت غیرفعال بودن، ورودی‌های محلی FDB (یعنی ورودی‌های مربوط به آدرس‌های درگاه‌های عضو و آدرس خود پل) علاوه بر هر VLAN عضو، در VLAN 0 نیز نگهداری می‌شوند. وقتی این گزینه فعال باشد، آن‌ها فقط در VLAN 0 نگهداری می‌شوند. این گزینه به‌طور پیش‌فرض غیرفعال است.

هنگامی که این گزینه فعال باشد، هنگام تصمیم‌گیری برای هدایت، پل برای یافتن ورودی منطبقی که دائمی (permanent) است اما توسط کاربر اضافه نشده، VLAN 0 را بررسی می‌کند. با این حال در سایر موارد ورودی فقط روی VLAN 0 وجود دارد. این امر بر خروجی گرفتن (dumping) تأثیر می‌گذارد، به‌طوری که ورودی‌ها در VLANهای غیر صفر نشان داده نمی‌شوند، و عملیات get و flush در FDB نیز ورودی را در VLANهای غیر صفر پیدا نمی‌کنند. هنگامی که ورودی حذف شود، بر هدایت در تمام VLANها تأثیر می‌گذارد.

.BI fdb_max_learned " FDB_MAX_LEARNED "
- تنظیم حداکثر تعداد ورودی‌های FDB یادگرفته‌شده. اگر
.RI ( FDB_MAX_LEARNED " == 0) "
باشد، این قابلیت غیرفعال است. مقدار پیش‌فرض
.BR 0
است.
.I FDB_MAX_LEARNED
یک عدد صحیح بدون علامت 32 بیتی است.

.BI vlan_filtering " VLAN_FILTERING "
- فعال کردن فیلترسازی VLAN
.RI ( VLAN_FILTERING " > 0) "
یا غیرفعال کردن آن
.RI ( VLAN_FILTERING " == 0). "
در صورت غیرفعال بودن، پل هنگام پردازش بسته‌ها برچسب (tag) VLAN را در نظر نمی‌گیرد.

.BR vlan_protocol " { " 802.1Q " | " 802.1ad " } "
- تنظیم پروتکل مورد استفاده برای فیلترسازی VLAN.

.BI vlan_default_pvid " VLAN_DEFAULT_PVID "
- تنظیم PVID پیش‌فرض (شناسه VLAN بومی/بدون برچسب یا native/untagged VLAN ID) برای این پل.

.BI vlan_stats_enabled " VLAN_STATS_ENABLED "
- فعال کردن
.RI ( VLAN_STATS_ENABLED " == 1) "
یا غیرفعال کردن
.RI ( VLAN_STATS_ENABLED " == 0) "
ثبت آمار به ازای هر VLAN.

.BI vlan_stats_per_port " VLAN_STATS_PER_PORT "
- فعال کردن
.RI ( VLAN_STATS_PER_PORT " == 1) "
یا غیرفعال کردن
.RI ( VLAN_STATS_PER_PORT " == 0) "
ثبت آمار به ازای هر درگاه و هر VLAN. تنها در صورتی قابل تغییر است که هیچ VLAN درگاهی پیکربندی نشده باشد.

.BI mcast_snooping " MULTICAST_SNOOPING "
- فعال کردن تجسس چندپخشی (multicast snooping)
.RI ( MULTICAST_SNOOPING " > 0) "
یا غیرفعال کردن آن
.RI ( MULTICAST_SNOOPING " == 0). "

.BI mcast_vlan_snooping " MULTICAST_VLAN_SNOOPING "
- فعال کردن تجسس چندپخشی VLAN
.RI ( MULTICAST_VLAN_SNOOPING " > 0) "
یا غیرفعال کردن آن
.RI ( MULTICAST_VLAN_SNOOPING " == 0). "

.BI mcast_router " MULTICAST_ROUTER "
- تنظیم روتر چندپخشی پل در صورت فعال بودن IGMP snooping.
.I MULTICAST_ROUTER
یک مقدار عددی صحیح با معانی زیر است:
.in +8
.sp
.B 0
- غیرفعال.

.B 1
- خودکار (پرس‌وجو شده / queried).

.B 2
- برای همیشه فعال.
.in -8

.BI mcast_query_use_ifaddr " MCAST_QUERY_USE_IFADDR "
- تعیین اینکه آیا از آدرس IP خود پل به عنوان آدرس مبدا برای پرس‌وجوهای IGMP استفاده شود
.RI ( MCAST_QUERY_USE_IFADDR " > 0) "
یا مقدار پیش‌فرض 0.0.0.0
.RI ( MCAST_QUERY_USE_IFADDR " == 0). "

.BI mcast_querier " MULTICAST_QUERIER "
- فعال کردن
.RI ( MULTICAST_QUERIER " > 0) "
یا غیرفعال کردن
.RI ( MULTICAST_QUERIER " == 0) "
پرس‌وجوکننده IGMP (IGMP querier)، یعنی ارسال پرس‌وجوهای چندپخشی توسط پل (پیش‌فرض: غیرفعال).

.BI mcast_querier_interval " QUERIER_INTERVAL "
- فاصله زمانی بین پرس‌وجوهای ارسال‌شده توسط سایر روترها. اگر پس از سپری شدن این تاخیر هیچ پرس‌وجویی دیده نشود، پل شروع به ارسال پرس‌وجوهای خود خواهد کرد (مانند حالتی که
.BI mcast_querier
فعال شده باشد).

.BI mcast_hash_elasticity " HASH_ELASTICITY "
- تنظیم کشسانی درهم‌سازی (hash elasticity) پایگاه‌داده چندپخشی؛ یعنی حداکثر طول زنجیره در جدول درهم‌سازی (هش) چندپخشی (پیش‌فرض: 4).

.BI mcast_hash_max " HASH_MAX "
- تنظیم حداکثر اندازه جدول درهم‌سازی (هش) چندپخشی (پیش‌فرض: 512، مقدار باید توانی از 2 باشد).

.BI mcast_last_member_count " LAST_MEMBER_COUNT "
- تنظیم شمارش آخرین عضو چندپخشی (multicast last member count)، یعنی تعداد پرس‌وجوهایی که پل پس از دریافت پیام «خروج» (leave) پیش از متوقف کردن هدایت یک گروه چندپخشی ارسال می‌کند (پیش‌فرض: 2).

.BI mcast_last_member_interval " LAST_MEMBER_INTERVAL "
- فاصله زمانی بین پرس‌وجوها برای یافتن اعضای باقی‌مانده یک گروه، پس از دریافت پیام «خروج» (leave).

.BI mcast_startup_query_count " STARTUP_QUERY_COUNT "
- تنظیم تعداد پرس‌وجوهای IGMP ارسالی در طول فاز راه‌اندازی (پیش‌فرض: 2).

.BI mcast_startup_query_interval " STARTUP_QUERY_INTERVAL "
- فاصله زمانی بین پرس‌وجوها در فاز راه‌اندازی.

.BI mcast_query_interval " QUERY_INTERVAL "
- فاصله زمانی بین پرس‌وجوهای ارسال‌شده توسط پل پس از پایان فاز راه‌اندازی.

.BI mcast_query_response_interval " QUERY_RESPONSE_INTERVAL "
- تنظیم حداکثر زمان پاسخ / حداکثر تاخیر پاسخ (Max Response Time/Maximum Response Delay) برای پرس‌وجوهای IGMP/MLD ارسال‌شده توسط پل.

.BI mcast_membership_interval " MEMBERSHIP_INTERVAL "
- تاخیری که پس از آن در صورت عدم دریافت گزارش‌های عضویت برای این گروه، پل گروه را ترک می‌کند.

.BI mcast_stats_enabled " MCAST_STATS_ENABLED "
- فعال کردن
.RI ( MCAST_STATS_ENABLED " > 0) "
یا غیرفعال کردن
.RI ( MCAST_STATS_ENABLED " == 0) "
ثبت آمار چندپخشی (IGMP/MLD).

.BI mcast_igmp_version " IGMP_VERSION "
- تنظیم نسخه IGMP.

.BI mcast_mld_version " MLD_VERSION "
- تنظیم نسخه MLD.

.BI nf_call_iptables " NF_CALL_IPTABLES "
- فعال کردن
.RI ( NF_CALL_IPTABLES " > 0) "
یا غیرفعال کردن
.RI ( NF_CALL_IPTABLES " == 0) "
قلاب‌های (hooks) iptables روی پل.

.BI nf_call_ip6tables " NF_CALL_IP6TABLES "
- فعال کردن
.RI ( NF_CALL_IP6TABLES " > 0) "
یا غیرفعال کردن
.RI ( NF_CALL_IP6TABLES " == 0) "
قلاب‌های ip6tables روی پل.

.BI nf_call_arptables " NF_CALL_ARPTABLES "
- فعال کردن
.RI ( NF_CALL_ARPTABLES " > 0) "
یا غیرفعال کردن
.RI ( NF_CALL_ARPTABLES " == 0) "
قلاب‌های arptables روی پل.

.BI mdb_offload_fail_notification " MDB_OFFLOAD_FAIL_NOTIFICATION "
- فعال کردن اعلان شکست آف‌لود mdb
.RI ( MDB_OFFLOAD_FAIL_NOTIFICATION " > 0) "
یا غیرفعال کردن آن
.RI ( MDB_OFFLOAD_FAIL_NOTIFICATION " == 0). "
مقدار پیش‌فرض
.BR 0
است.

.in -8

.TP
پشتیبانی از نوع MACsec (MACsec Type Support)
برای پیوندی از نوع
.I MACsec
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add link " DEVICE " name " NAME " type macsec"
[ [
.BI address " <lladdr>"
]
.BI port " PORT"
|
.BI sci " SCI"
] [
.BI cipher " CIPHER_SUITE"
] [
.BR icvlen " { "
.IR 8..16 " } ] ["
.BR encrypt " {"
.BR on " | " off " } ] [ "
.BR send_sci " { " on " | " off " } ] ["
.BR end_station " { " on " | " off " } ] ["
.BR scb " { " on " | " off " } ] ["
.BR protect " { " on " | " off " } ] ["
.BR replay " { " on " | " off " }"
.BR window " { "
.IR 0..2^32-1 " } ] ["
.BR validate " { " strict " | " check " | " disabled " } ] ["
.BR encodingsa " { "
.IR 0..3 " } ]"

.in +8
.sp
.BI address " <lladdr> "
- جزء شناسه سیستم (system identifier) کانال امن را برای این دستگاه MACsec تنظیم می‌کند.

.sp
.BI port " PORT "
- جزء شماره درگاه کانال امن را برای این دستگاه MACsec در بازه 1 تا 65535 (شامل هر دو) تنظیم می‌کند. اعدادی با پیشوند «0» یا «0x» به ترتیب به عنوان هشت‌هشتی (octal) و شانزده‌شانزدهی (hexadecimal) تفسیر می‌شوند.

.sp
.BI sci " SCI "
- شناسه کانال امن (SCI) را برای این دستگاه MACsec تنظیم می‌کند.
.I SCI
یک عدد 64 بیتی در قالب شانزده‌شانزدهی (hexadecimal) است.

.sp
.BI cipher " CIPHER_SUITE "
- مجموعه رمز (cipher suite) مورد استفاده را مشخص می‌کند.

.sp
.BI icvlen " LENGTH "
- طول مقدار بررسی یکپارچگی (ICV) را تنظیم می‌کند.

.sp
.BR "encrypt on " یا " encrypt off"
- تغییر وضعیت بین رمزگذاری احراز هویت‌شده یا تنها حالت احراز اصالت.

.sp
.BR "send_sci on " یا " send_sci off"
- مشخص می‌کند که آیا SCI در هر بسته گنجانده شود یا فقط در مواقع ضروری.

.sp
.BR "end_station on " یا " end_station off"
- بیت End Station را تنظیم می‌کند.

.sp
.BR "scb on " یا " scb off"
- بیت Single Copy Broadcast را تنظیم می‌کند.

.sp
.BR "protect on " یا " protect off"
- محافظت MACsec را روی دستگاه فعال می‌کند.

.sp
.BR "replay on " یا " replay off"
- محافظت در برابر بازپخش (replay protection) را روی دستگاه فعال می‌کند.

.in +8

.sp
.BI window " SIZE "
- اندازه پنجره بازپخش (replay window) را تنظیم می‌کند.

.in -8

.sp
.BR "validate strict " یا " validate check " یا " validate disabled"
- حالت اعتبارسنجی را روی دستگاه تنظیم می‌کند.

.sp
.BI encodingsa " AN "
- ارتباط امن فعال (active secure association) را برای ارسال تنظیم می‌کند.

.in -8

.TP
پشتیبانی از نوع VRF (VRF Type Support)
برای پیوندی از نوع
.I VRF
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE " type vrf table " TABLE

.in +8
.sp
.BR table " شناسه جدول (table id) مرتبط با دستگاه VRF"

.in -8

.TP
پشتیبانی از نوع RMNET (RMNET Type Support)
برای پیوندی از نوع
.I RMNET
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add link " DEVICE " name " NAME " type rmnet mux_id " MUXID

.in +8
.sp
.BI mux_id " MUXID "
- شناسه mux را برای دستگاه rmnet مشخص می‌کند؛ مقادیر ممکن 1-254 هستند.

.in -8

.TP
پشتیبانی از نوع XFRM (XFRM Type Support)
برای پیوندی از نوع
.I XFRM
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE " type xfrm dev " PHYS_DEV " [ if_id " IF_ID " ]"
.BR "[ external ]"

.in +8
.sp
.BI dev " PHYS_DEV "
- رابط فیزیکی زیرین را مشخص می‌کند که ترافیک تبدیل (transform) از طریق آن ارسال و دریافت می‌شود.

.sp
.BI if_id " IF-ID "
- کلید جستجوی شانزده‌شانزدهی (hexadecimal) مورد استفاده برای ارسال ترافیک به و از سیاست‌های مشخص xfrm را تعیین می‌کند. سیاست‌ها باید با همان کلید پیکربندی شوند. در صورت عدم تنظیم، مقدار پیش‌فرض کلید 0 خواهد بود و با هر سیاستی که به طور مشابه فاقد پیکربندی کلید جستجو باشد مطابقت خواهد داشت.

.sp
.BI external
- کنترل این دستگاه را خارجی (externally controlled) می‌کند. این پرچم با گزینه‌های
.BR dev " و " if_id
مانعةالجمع (mutually exclusive) است.

.in -8

.TP
پشتیبانی از نوع GTP (GTP Type Support)
برای پیوندی از نوع
.I GTP
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.BI "ip link add " DEVICE " type gtp role " ROLE " hsize " HSIZE

.in +8
.sp
.BI role " ROLE "
- نقش دستگاه GTP را مشخص می‌کند، که می‌تواند sgsn یا ggsn باشد

.sp
.BI hsize " HSIZE "
- اندازه جدول درهم‌سازی (hashtable) را که زمینه‌های PDP (PDP contexts) را ذخیره می‌کند، مشخص می‌نماید

.sp
.BI restart_count " RESTART_COUNT "
- شمارنده راه‌اندازی مجدد (restart counter) نمونه GTP

.TP
پشتیبانی از نوع PFCP (PFCP Type Support)
برای پیوندی از نوع
.I PFCP
هیچ آرگومان اضافی پشتیبانی نمی‌شود

.in -8
.SS ip link delete \- حذف رابط مجازی (delete virtual link)

.TP
.BI dev " DEVICE "
دستگاه مجازی مورد نظر برای انجام عملیات را مشخص می‌کند.

.TP
.BI group " GROUP "
گروهی از رابط‌های مجازی را برای حذف مشخص می‌کند. حذف گروه 0 مجاز نیست زیرا گروه پیش‌فرض است.

.TP
.BI type " TYPE "
نوع دستگاه را مشخص می‌کند.

.SS ip link set \- تغییر ویژگی‌ها و مشخصه‌های دستگاه (change device attributes)

.PP
.B هشدار:
اگر تغییر چندین پارامتر درخواست شود،
.B ip
بلافاصله پس از شکست هر یک از تغییرات متوقف می‌شود.
این تنها حالتی است که در آن
.B ip
می‌تواند سیستم را در وضعیتی غیرقابل پیش‌بینی قرار دهد. راه‌حل این است
که از تغییر هم‌زمان چندین پارامتر در یک فراخوانی
.B ip link set
خودداری کنید.
اصلاح‌کنندهٔ
.B change
معادل
.BR "set"
است.


.TP
.BI dev " DEVICE "
.I DEVICE
دستگاه شبکه‌ای که قرار است روی آن عملیات انجام شود را مشخص می‌کند. هنگام پیکربندی دستگاه‌های
تابع مجازی (VF) در SR-IOV،
این کلیدواژه باید دستگاه تابع فیزیکی (PF) مرتبط را مشخص کند.

.TP
.BI group " GROUP "
.I GROUP
دارای نقش دوگانه است: اگر هر دو مشخصهٔ group و dev وجود داشته باشند، دستگاه به گروه مشخص‌شده منتقل می‌شود. اگر فقط یک گروه مشخص شده باشد، دستور روی تمام دستگاه‌های موجود در آن گروه اعمال می‌شود.

.TP
.BR up " و " down
وضعیت دستگاه را به
.B UP
یا
.BR "DOWN"
تغییر می‌دهد.

.TP
.BR "arp on " یا " arp off"
پرچم
.B NOARP
را روی دستگاه تغییر می‌دهد.

.TP
.BR "multicast on " یا " multicast off"
پرچم
.B MULTICAST
را روی دستگاه تغییر می‌دهد.

.TP
.BR "allmulticast on " یا " allmulticast off"
پرچم
.B ALLMULTI
را روی دستگاه تغییر می‌دهد. هنگامی که فعال باشد، به راه‌انداز شبکه دستور می‌دهد تا تمام بسته‌های چندپخشی را برای پردازش بیشتر از شبکه به هسته تحویل دهد.

.TP
.BR "promisc on " یا " promisc off"
پرچم
.B PROMISC
را روی دستگاه تغییر می‌دهد. هنگامی که فعال باشد، عملکرد بی‌قید (پرومیسکیوس / promiscuous) دستگاه شبکه را فعال می‌کند.

.TP
.BR "trailers on " یا " trailers off"
پرچم
.B NOTRAILERS
را روی دستگاه تغییر می‌دهد، توسط لینوکس استفاده
.B نمی‌شود
و برای سازگاری با BSD وجود دارد.

.TP
.BR "protodown on " یا " protodown off"
وضعیت
.B PROTODOWN
را روی دستگاه تغییر می‌دهد. نشان می‌دهد که خطای پروتکل روی درگاه شناسایی شده است. راه‌اندازهای سوییچ می‌توانند با غیرفعال کردن فیزیکی (phys down) درگاه سوییچ به این خطا واکنش نشان دهند.

.TP
.BR "protodown_reason PREASON on " یا " off"
دلایل
.B PROTODOWN
را روی دستگاه تنظیم می‌کند. نام بیت‌های دلیل protodown را می‌توان ذیل
/etc/iproute2/protodown_reasons.d/
شمرد و فهرست کرد. بیت‌های دلایل احتمالی ۰ تا ۳۱ هستند.

.TP
.BR "dynamic on " یا " dynamic off"
پرچم
.B DYNAMIC
را روی دستگاه تغییر می‌دهد. نشان می‌دهد که در صورت از کار افتادن رابط، نشانی ممکن است تغییر کند (در حال حاضر توسط لینوکس استفاده
.B نمی‌شود
).

.TP
.BI name " NAME"
نام دستگاه را تغییر می‌دهد. این عملیات در صورتی که دستگاه در حال اجرا باشد یا از قبل نشانی‌هایی برای آن پیکربندی شده باشد، توصیه نمی‌شود.

.TP
.BI txqueuelen " NUMBER"
.TP
.BI txqlen " NUMBER"
طول صف ارسال (transmit queue) دستگاه را تغییر می‌دهد.

.TP
.BI mtu " NUMBER"
مقدار
.I MTU
دستگاه را تغییر می‌دهد.

.TP
.BI address " LLADDRESS"
نشانی ایستگاه (station address) رابط را تغییر می‌دهد.

.TP
.BI broadcast " LLADDRESS"
.TP
.BI brd " LLADDRESS"
.TP
.BI peer " LLADDRESS"
نشانی همه‌پخشی لایه پیوند یا نشانی همتا (peer address) را در حالتی که رابط
.IR "POINTOPOINT"
است تغییر می‌دهد.

.TP
.B netns
.RI "{ " PID " | " NETNSNAME " | " NETNSFILE " }"
.br
دستگاه را به فضای نام شبکهٔ مرتبط با شناسه فرایند
.IR "PID " یا
نام
.IR "NETNSNAME " یا
فایل
.IR "NETNSFILE"
منتقل می‌کند.

برخی دستگاه‌ها مجاز به تغییر فضای نام شبکه نیستند: loopback، bridge، wireless. این‌ها دستگاه‌های محلی فضای نام شبکه (network namespace local) هستند. در چنین حالتی، ابزار
.B ip
خطای "Invalid argument" را بازمی‌گرداند. با بررسی پرچم
.B netns-local
در خروجی دستور
.BR ethtool
می‌توان متوجه شد که آیا دستگاه به یک فضای نام شبکهٔ منفرد محلی است یا خیر:

.in +8
.B ethtool -k
.I DEVICE
.in -8

برای تغییر فضای نام شبکه دستگاه‌های بی‌سیم می‌توان از ابزار
.B iw
استفاده کرد. اما این ابزار تنها اجازه تغییر فضای نام شبکه را برای دستگاه‌های فیزیکی و بر اساس شناسه فرایند
.IR PID
می‌دهد.

.TP
.BI alias " NAME"
یک نام نمادین برای ارجاع آسان‌تر به دستگاه اختصاص می‌دهد.

.TP
.BI group " GROUP"
گروهی را که دستگاه به آن تعلق دارد مشخص می‌کند.
گروه‌های موجود در
.BR /usr/share/iproute2/group " یا " /etc/iproute2/group
فهرست شده‌اند (در صورت وجود، اولویت دارد).

.TP
.BI vf " NUM"
یک دستگاه تابع مجازی (Virtual Function) را برای پیکربندی مشخص می‌کند. دستگاه PF مرتبط باید با استفاده از پارامتر
.B dev
مشخص شود.

.in +8
.BI mac " LLADDRESS"
\- تغییر نشانی ایستگاه برای VF مشخص‌شده. پارامتر
.B vf
باید مشخص شود.

.sp
.BI vlan " VLANID"
\- تغییر VLAN اختصاص‌یافته برای VF مشخص‌شده. در صورت مشخص شدن، تمام ترافیک ارسال‌شده از VF با شناسهٔ VLAN مشخص‌شده برچسب‌گذاری می‌شود. ترافیک ورودی بر اساس شناسهٔ VLAN مشخص‌شده فیلتر می‌شود و قبل از ارسال به VF تمام برچسب‌های VLAN از آن حذف خواهد شد. تنظیم این پارامتر روی 0 برچسب‌گذاری و فیلتر کردن VLAN را غیرفعال می‌کند. پارامتر
.B vf
باید مشخص شود.

.sp
.BI qos " VLAN-QOS"
\- تخصیص بیت‌های اولویت VLAN QOS برای برچسب VLAN. در صورت مشخص شدن، تمام برچسب‌های VLAN ارسال‌شده توسط VF شامل بیت‌های اولویت مشخص‌شده در برچسب VLAN خواهند بود. در صورت عدم تعیین، مقدار 0 فرض می‌شود. هر دو پارامتر
.B vf
و
.B vlan
باید مشخص شوند. تنظیم هم‌زمان
.B vlan
و
.B qos
روی 0، برچسب‌گذاری و فیلتر کردن VLAN را برای VF غیرفعال می‌کند.

.sp
.BI proto " VLAN-PROTO"
\- تخصیص پروتکل VLAN برای برچسب VLAN، به صورت 802.1Q یا 802.1ad.
تنظیم روی 802.1ad باعث می‌شود تمام ترافیک ارسال‌شده از VF با VLAN S-Tag برچسب‌گذاری شود. تمام برچسب‌های VLAN S-Tag از ترافیک ورودی قبل از تحویل به VF حذف خواهند شد. تنظیم روی 802.1ad همچنین امکان الحاق یک برچسب VLAN دیگر را فعال می‌کند، بنابراین هر دو S-TAG و C-TAG به ترتیب برای ترافیک خروجی/ورودی درج/حذف می‌شوند. اگر مشخص نشود، مقدار 802.1Q فرض می‌شود. هر دو پارامتر
.B vf
و
.B vlan
باید مشخص شوند.

.sp
.BI rate " TXRATE"
\-\- تغییر پهنای باند ارسال مجاز، بر حسب مگابیت بر ثانیه (Mbps)، برای VF مشخص‌شده.
تنظیم این پارامتر روی 0 محدودیت نرخ را غیرفعال می‌کند.
پارامتر
.B vf
باید مشخص شود.
لطفاً به جای آن از گزینهٔ جدید
.B "max_tx_rate"
در API استفاده کنید.

.sp
.BI max_tx_rate " TXRATE"
\- تغییر حداکثر پهنای باند ارسال مجاز، بر حسب مگابیت بر ثانیه (Mbps)، برای VF مشخص‌شده. تنظیم این پارامتر روی 0 محدودیت نرخ را غیرفعال می‌کند.
پارامتر
.B vf
باید مشخص شود.

.sp
.BI min_tx_rate " TXRATE"
\- تغییر حداقل پهنای باند ارسال مجاز، بر حسب مگابیت بر ثانیه (Mbps)، برای VF مشخص‌شده.
حداقل TXRATE همواره باید <= حداکثر TXRATE باشد.
تنظیم این پارامتر روی 0 محدودیت نرخ را غیرفعال می‌کند.
پارامتر
.B vf
باید مشخص شود.

.sp
.BI spoofchk " on|off"
\- روشن یا خاموش کردن بررسی جعل بسته برای VF مشخص‌شده.
.sp
.BI query_rss " on|off"
\- فعال یا غیرفعال کردن امکان پرس‌وجوی پیکربندی RSS مربوط به یک VF مشخص. اطلاعات RSS مربوط به VF مانند کلید درهم‌سازی RSS ممکن است در برخی دستگاه‌ها که این اطلاعات میان VF و PF به اشتراک گذاشته می‌شود حساس تلقی شود و بنابراین پرس‌وجوی آن به صورت پیش‌فرض ممنوع باشد.
.sp
.BI state " auto|enable|disable"
\- تنظیم وضعیت پیوند مجازی از دید VF مشخص‌شده. تنظیم روی auto به معنی بازتاب وضعیت پیوند PF است، enable به VF اجازه می‌دهد تا حتی در صورت قطع بودن پیوند PF با سایر VFهای روی این میزبان ارتباط برقرار کند، disable باعث می‌شود سخت‌افزار هر بسته‌ای را که توسط VF ارسال می‌شود دور بیندازد.
.sp
.BI trust " on|off"
\- معتمد شمردن کاربر VF مشخص‌شده. این گزینه به کاربر VF اجازه می‌دهد تا ویژگی خاصی را که ممکن است بر امنیت و/یا کارایی تأثیر بگذارد تنظیم کند (مانند حالت بی‌قید (پرومیسکیوس / promiscuous) چندپخشی در VF).
.sp
.BI node_guid " eui64"
\- پیکربندی شناسه سراسری گره (node GUID) برای VFهای Infiniband.
.sp
.BI port_guid " eui64"
\- پیکربندی شناسه سراسری درگاه (port GUID) برای VFهای Infiniband.
.in -8

.TP
.B xdp object "|" pinned "|" off
تنظیم (یا لغو تنظیم) یک برنامهٔ BPF مربوط به XDP ("eXpress Data Path") برای اجرا روی هر بسته در سطح راه‌انداز.
خروجی دستور
.B ip link
پرچم
.B xdp
را برای دستگاه شبکه نشان خواهد داد. اگر راه‌انداز پشتیبانی بومی از XDP نداشته باشد، هسته به گونهٔ کندتر و مستقل از راه‌انداز "generic" مربوط به XDP بازمی‌گردد. در این صورت خروجی
.B ip link
به جای تنها
.B xdp
عبارت
.B xdpgeneric
را نشان خواهد داد. اگر راه‌انداز دارای پشتیبانی بومی از XDP باشد، اما برنامه تحت
.B xdpgeneric object "|" pinned
بارگذاری شده باشد، هسته به جای گونهٔ بومی، از گونهٔ generic مربوط به XDP استفاده خواهد کرد.
گزینهٔ
.B xdpdrv
اثر معکوس دارد و درخواست می‌کند که پس‌گرد خودکار به گونهٔ generic مربوط به XDP غیرفعال شود و در صورتی که راه‌انداز از XDP پشتیبانی نکند، خطا بازگردانده شود.
همچنین
.B xdpdrv
تخلیه بار سخت‌افزاری (hardware offloads) را غیرفعال می‌کند.
عبارت
.B xdpoffload
در خروجی ip link نشان می‌دهد که برنامه به سخت‌افزار واگذار شده است و همچنین می‌تواند برای درخواست حالت "offload" استفاده شود؛ درست مانند
.B xdpgeneric
این گزینه اجبار می‌کند برنامه مشخصاً در سخت‌افزار/سفت‌افزار (HW/FW) آداپتور نصب شود.

.B off
(یا
.B none
)
\- هر برنامهٔ XDP/BPF متصل فعلی را از دستگاه مشخص‌شده جدا می‌کند.

.BI object " FILE "
\- یک برنامهٔ XDP/BPF را به دستگاه مشخص‌شده متصل می‌کند.
.I FILE
به یک فایل BPF ELF (مثلاً تولیدشده توسط LLVM) اشاره دارد که حاوی کد برنامهٔ BPF، مشخصات map و غیره است. اگر قبلاً یک برنامهٔ XDP/BPF به دستگاه متصل شده باشد، خطا ایجاد می‌شود. اگر در حال حاضر هیچ برنامهٔ XDP/BPF متصل نباشد، دستگاه از XDP پشتیبانی کند و برنامهٔ موجود در فایل BPF ELF از تاییدکننده هسته (kernel verifier) عبور کند، به دستگاه متصل خواهد شد. اگر گزینهٔ
.I -force
به
.B ip
داده شود، هر برنامهٔ XDP/BPF متصل قبلی به صورت اتمیک بازنویسی می‌شود و در این حالت خطایی رخ نخواهد داد. اگر هیچ گزینهٔ
.B section
داده نشود، نام بخش پیش‌فرض ("prog") در نظر گرفته می‌شود، در غیر این صورت نام بخش مشخص‌شده استفاده خواهد شد. اگر هیچ گزینهٔ
.B verbose
داده نشود، گزارش ارزیاب تنها هنگام بروز خطای بارگذاری چاپ می‌شود.
همچنین برای نمونه‌های استفاده، بخش
.B EXAMPLES
را ببینید.

.BI section " NAME "
\- نام بخشی را که حاوی کد برنامهٔ BPF است مشخص می‌کند. اگر هیچ نام بخشی مشخص نشود، نام پیش‌فرض ("prog") استفاده خواهد شد. این گزینه باید همراه با گزینهٔ
.B object
ارسال شود.

.BI program " NAME "
\- نام برنامهٔ BPF که باید متصل شود را مشخص می‌کند. هنگامی که نام برنامه مشخص شده باشد، پارامتر نام بخش نادیده گرفته خواهد شد. این گزینه تنها زمانی کار می‌کند که iproute2 با پشتیبانی از
.B libbpf
ساخته شده باشد.

.BI verbose
\- در حالت پرحرف عمل می‌کند. به عنوان مثال، حتی در صورت موفقیت، اگر برنامه‌ای از یک فایل BPF ELF بارگذاری شده باشد، گزارش ارزیاب را چاپ می‌کند.

.BI pinned " FILE "
\- یک برنامهٔ XDP/BPF را به دستگاه مشخص‌شده متصل می‌کند.
.I FILE
به یک برنامهٔ BPF که از قبل در سیستم‌فایل BPF پین شده است اشاره دارد. گزینهٔ
.B section
در اینجا اعمال نمی‌شود، اما در غیر این صورت مفاهیم دقیقاً مانند گزینهٔ
.B object
است که پیش‌تر توضیح داده شد.

.TP
.BI master " DEVICE"
دستگاه master را برای این دستگاه تنظیم می‌کند (دستگاه را برده/عضو دستگاه master می‌کند).

.TP
.BI nomaster
دستگاه master را لغو می‌کند (دستگاه را رها/آزاد می‌کند).

.TP
.BI addrgenmode " eui64|none|stable_secret|random"
حالت تولید نشانی IPv6 را تنظیم می‌کند

.I eui64
\- استفاده از شناسه رابط با قالب اصلاح‌شده EUI-64

.I none
\- غیرفعال کردن تولید خودکار نشانی

.I stable_secret
\- تولید شناسه رابط بر اساس مقدار پیش‌تنظیم در
  /proc/sys/net/ipv6/conf/{default,DEVICE}/stable_secret

.I random
\- مانند stable_secret، اما اگر مقداری تنظیم نشده باشد یک کلید محرمانهٔ تصادفی جدید به صورت خودکار تولید می‌کند

.TP
.B inet
پارامترهای شبکهٔ devconf مربوط به IPv4 را برای دستگاه مشخص‌شده تنظیم می‌کند. این پارامترها مستقیماً به sysctlهای رابط IPv4 هسته نگاشت می‌شوند.

.in +8
.BR forwarding " { " on " | " off " }"
\- فعال یا غیرفعال کردن هدایت (forwarding) بسته در IPv4 روی دستگاه.

.BR proxy_arp ", " accept_redirects ", " secure_redirects ", " send_redirects ", "
.BR shared_media ", " accept_source_route ", " bootp_relay ", " log_martians ", "
.BR arp_filter ", " disable_xfrm ", " disable_policy ", " promote_secondaries ", "
.BR arp_notify ", " accept_local ", " src_vmark ", " proxy_arp_pvlan ", "
.BR route_localnet ", " bc_forwarding ", " ignore_routes_with_linkdown ", "
.BR drop_unicast_in_l2_multicast ", " drop_gratuitous_arp ", " arp_evict_nocarrier ", "
.BR "{ " on " | " off " }"
\- تغییر وضعیت پارامتر بولی متناظر در شبکه.

.BR rp_filter " { " 0 " | " 1 " | " 2 " }"
\- تنظیم فیلتر مسیر معکوس (reverse path filtering).

.BR arp_announce " { " 0 " | " 1 " | " 2 " }"
\- تعریف سطوح مختلف محدودیت برای اعلام نشانی IP مبدا محلی از بسته‌های IP در درخواست‌های ARP.

.BR arp_ignore " { " 0 " | " 1 " | " ... " | " 8 " }"
\- تعریف حالت‌های مختلف برای پاسخ دادن به درخواست‌های ARP که نشانی‌های IP مقصد محلی را ترجمه می‌کنند.

.BR arp_accept " { " 0 " | " 1 " | " 2 " }"
\- تعریف رفتار برای فریم‌های ARP بی‌دلیل (gratuitous ARP).

.BR force_igmp_version " { " 0 " | " 1 " | " 2 " | " 3 " }"
\- اجبار نسخهٔ IGMP.

.BI tag " TAG "
\- تنظیم برچسب (tag) رابط.

.BI medium_id " ID "
\- تنظیم شناسه رسانه (medium ID) رابط.

.BI igmpv2_unsolicited_report_interval " INTERVAL "
.br
.BI igmpv3_unsolicited_report_interval " INTERVAL "
\- تنظیم بازه گزارش ناخواستهٔ پروتکل IGMP بر حسب میلی‌ثانیه.
.in -8

.TP
.BR "link-netnsid "
تنظیم netnsid همتا برای یک رابط فرامرزی بین فضاهای نام شبکه (cross-netns interface)

.TP
.BI type " ETYPE TYPE_ARGS"
تغییر تنظیمات مربوط به نوع دستگاه. برای مشاهدهٔ فهرستی از انواع پشتیبانی‌شده و آرگومان‌ها به توضیحات
.B "ip link add"
در بالا مراجعه کنید. علاوه بر آن، دستکاری تنظیمات برای دستگاه‌های برده (slave) نیز امکان‌پذیر است:
.TP
پشتیبانی از دستگاه‌های متصل به پل (Bridge Slave Support)
برای پیوندی با مستر
.B bridge
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.B "ip link set type bridge_slave"
[
.B fdb_flush
] [
.BI state " STATE"
] [
.BI priority " PRIO"
] [
.BI cost " COST"
] [
.BR guard " { " on " | " off " }"
] [
.BR hairpin " { " on " | " off " }"
] [
.BR fastleave " { " on " | " off " }"
] [
.BR root_block " { " on " | " off " }"
] [
.BR learning " { " on " | " off " }"
] [
.BR flood " { " on " | " off " }"
] [
.BR proxy_arp " { " on " | " off " }"
] [
.BR proxy_arp_wifi " { " on " | " off " }"
] [
.BI mcast_router " MULTICAST_ROUTER"
] [
.BR mcast_fast_leave " { " on " | " off "}"
] [
.BR bcast_flood " { " on " | " off " }"
] [
.BR mcast_flood " { " on " | " off " }"
] [
.BR mcast_to_unicast " { " on " | " off " }"
] [
.BR group_fwd_mask " MASK"
] [
.BR neigh_suppress " { " on " | " off " }"
] [
.BR neigh_vlan_suppress " { " on " | " off " }"
] [
.BR neigh_forward_grat " { " on " | " off " }"
] [
.BR vlan_tunnel " { " on " | " off " }"
] [
.BR isolated " { " on " | " off " }"
] [
.BR locked " { " on " | " off " }"
] [
.BR mab " { " on " | " off " }"
] [
.BR backup_port " DEVICE"
] [
.BR nobackup_port
] [
.BR backup_nhid " NHID"
]

.in +8
.sp
.B fdb_flush
\- پاکسازی ورودی‌های پویای FDB اسلیو پل (bridge slave).

.BI state " STATE"
\- تنظیم وضعیت درگاه.
.I STATE
عددی است که وضعیت‌های زیر را نشان می‌دهد:
.BR 0 " (غیرفعال / disabled)،"
.BR 1 " (شنود / listening)،"
.BR 2 " (یادگیری / learning)،"
.BR 3 " (هدایت / forwarding)،"
.BR 4 " (مسدود / blocking)."

.BI priority " PRIO"
\- تنظیم اولویت درگاه (مقادیر مجاز بین 0 تا 63، شامل هر دو است).

.BI cost " COST"
\- تنظیم هزینه درگاه (مقادیر مجاز بین 1 تا 65535، شامل هر دو است).

.BR guard " { " on " | " off " }"
\- مسدود کردن بسته‌های BPDU ورودی روی این درگاه.

.BR hairpin " { " on " | " off " }"
\- فعال‌سازی حالت hairpin روی این درگاه. این کار اجازه می‌دهد بسته‌های ورودی به این درگاه به خود آن بازتاب داده شوند.

.BR fastleave " { " on " | " off " }"
\- فعال‌سازی خروج سریع چندپخشی (multicast fast leave) روی این درگاه.

.BR root_block " { " on " | " off " }"
\- جلوگیری از تبدیل شدن این درگاه به درگاه ریشه (root port) پل.

.BR learning " { " on " | " off " }"
\- اجازه یادگیری آدرس MAC روی این درگاه.

.BR flood " { " on " | " off " }"
\- باز کردن درگاه به صورت سیل‌آسا (flood)، یعنی تمام فریم‌های تک‌پخشی (unicast) به این درگاه نیز هدایت شوند. نیازمند خاموش بودن
.BR proxy_arp " و " proxy_arp_wifi
است.

.BR proxy_arp " { " on " | " off " }"
\- فعال‌سازی ARP نیابتی (proxy ARP) روی این درگاه.

.BR proxy_arp_wifi " { " on " | " off " }"
\- فعال‌سازی ARP نیابتی روی این درگاه مطابق با نیازمندی‌های توسعه‌یافته بر اساس مشخصات IEEE 802.11 و Hotspot 2.0.

.BI mcast_router " MULTICAST_ROUTER"
\- پیکربندی این درگاه برای داشتن مسیریاب‌های چندپخشی متصل. درگاهی که مسیریاب چندپخشی دارد، تمام ترافیک چندپخشی را دریافت خواهد کرد.
.I MULTICAST_ROUTER
می‌تواند یکی از مقادیر زیر باشد:
.B 0
برای غیرفعال کردن مسیریاب‌های چندپخشی روی این درگاه،
.B 1
برای اینکه سیستم حضور مسیریاب‌ها را تشخیص دهد (این حالت پیش‌فرض است)،
.B 2
برای فعال‌سازی دائمی هدایت ترافیک چندپخشی روی این درگاه یا
.B 3
برای فعال‌سازی موقت مسیریاب‌های چندپخشی روی این درگاه، بدون وابستگی به پرس‌وجوهای ورودی.

.BR mcast_fast_leave " { " on " | " off " }"
\- این گزینه مترادفی برای گزینه
.B fastleave
در بالا است.

.BR bcast_flood " { " on " | " off " }"
\- هدایت سیل‌آسای ترافیک پخشی (broadcast flooding) را روی درگاه مشخص‌شده کنترل می‌کند. به‌طور پیش‌فرض این پرچم روشن است.

.BR mcast_flood " { " on " | " off " }"
\- کنترل می‌کند که آیا درگاه مشخص‌شده ترافیک چندپخشی را که هیچ مدخل MDB برای آن وجود ندارد به صورت سیل‌آسا هدایت کند یا خیر. به‌طور پیش‌فرض این پرچم روشن است.

.BR mcast_to_unicast " { " on " | " off " }"
\- کنترل می‌کند که آیا درگاه مشخص‌شده بسته‌ها را به جای چندپخشی با استفاده از تک‌پخشی (unicast) تکثیر کند یا خیر. به‌طور پیش‌فرض این پرچم خاموش است.

.BI group_fwd_mask " MASK "
\- تنظیم ماسک هدایت گروهی (group forward mask). این ماسک بیتی است که برای تصمیم‌گیری در مورد هدایت فریم‌های ورودی با مقصد آدرس‌های link-local اعمال می‌شود؛ یعنی آدرس‌هایی به شکل 01:80:C2:00:00:0X (پیش‌فرض 0 است، یعنی پل هیچ فریم link-local ورودی به این درگاه را هدایت نمی‌کند).

.BR neigh_suppress " { " on " | " off " }"
\- کنترل می‌کند که آیا پروکسی و مهار کشف همسایه (arp و nd) روی درگاه فعال باشد یا خیر. به‌طور پیش‌فرض این پرچم خاموش است.

.BR neigh_vlan_suppress " { " on " | " off " }"
\- کنترل می‌کند که آیا پروکسی و مهار کشف همسایه (arp و nd) به ازای هر VLAN روی درگاه فعال باشد یا خیر. در صورت روشن بودن، گزینه \fBbridge link\fR
\fBneigh_suppress\fR
بی‌اثر خواهد بود و وضعیت به ازای هر VLAN با استفاده از گزینه \fBbridge vlan\fR
\fBneigh_suppress\fR
تنظیم می‌شود. به‌طور پیش‌فرض این پرچم خاموش است.

.BR neigh_forward_grat " { " on " | " off " }"
\- کنترل می‌کند که آیا بسته‌های gratuitous ARP و بسته‌های ناخواستهٔ اعلان همسایه (unsolicited Neighbor Advertisement) هنگام فعال بودن مهار همسایه روی درگاه هدایت شوند یا خیر. به‌طور پیش‌فرض این پرچم خاموش است، به این معنی که بسته‌های gratuitous ARP و NA ناخواسته در هنگام فعال بودن مهار همسایه مهار خواهند شد. تنظیم این پرچم روی on اجازه می‌دهد این بسته‌ها حتی در صورت فعال بودن مهار همسایه نیز هدایت شوند.

.BR vlan_tunnel " { " on " | " off " }"
\- کنترل می‌کند که آیا نگاشت vlan به تونل روی درگاه فعال باشد یا خیر. به‌طور پیش‌فرض این پرچم خاموش است.

.BR locked " { " on " | " off " }"
\- کنترل می‌کند که آیا درگاه قفل است یا خیر. در حالت قفل، فریم‌های غیر link-local دریافتی از درگاه دور ریخته می‌شوند مگر اینکه یک مدخل FDB با آدرس MAC مبدأ به این درگاه اشاره کند. کاربرد معمول آن در IEEE 802.1X است که در آن میزبان‌ها می‌توانند با تبادل فریم‌های EAPOL با یک احراز هویت‌کننده (authenticator)، خود را احراز هویت کنند. پس از تکمیل احراز هویت، صفحه کنترل فضای کاربری می‌تواند یک مدخل FDB منطبق نصب کند تا اجازه دهد ترافیک میزبان توسط پل هدایت شود. هنگامی که یادگیری (learning) روی یک درگاه قفل‌شده فعال است، گزینه پل
.B no_linklocal_learn
باید روشن باشد تا از یادگیری پل از فریم‌های EAPOL دریافتی جلوگیری شود. به‌طور پیش‌فرض این پرچم خاموش است.

.BR mab " { " on " | " off " }"
\- کنترل می‌کند که آیا دور زدن احراز هویت مک (MAC Authentication Bypass - MAB) روی درگاه فعال است یا خیر. MAB فقط می‌تواند روی درگاه قفل‌شده‌ای که یادگیری روی آن فعال است، فعال شود. در صورت فعال بودن، مدخل‌های FDB از ترافیک دریافتی یاد گرفته می‌شوند و پرچم FDB با عنوان "locked" تنظیم می‌گردد. این پرچم تنها توسط هسته قابل تنظیم است و نشان می‌دهد که مدخل FDB نمی‌تواند برای احراز هویت میزبان مربوطه استفاده شود. فضای کاربر می‌تواند با جایگزین کردن مدخل FDB و پاک کردن پرچم "locked" در FDB، تصمیم به احراز هویت میزبان بگیرد. مدخل‌های FDB قفل‌شده می‌توانند به درگاه‌های قفل‌نشده (مجاز) جابه‌جا شوند (roam کنند) که در این حالت پرچم "locked" پاک می‌شود. مدخل‌های FDB صرف‌نظر از فعال بودن یا نبودن MAB نمی‌توانند به درگاه‌های قفل‌شده جابه‌جا شوند. بنابراین، مدخل‌های FDB قفل‌شده تنها در صورتی ایجاد می‌شوند که مدخل FDB با {MAC, VID} داده‌شده از قبل وجود نداشته باشد. این رفتار مانع از آن می‌شود که میزبان‌های احراز هویت‌نشده ترافیک مقصود میزبان‌های از قبل احراز هویت‌شده را مختل کنند. مدخل‌های FDB قفل‌شده از نظر هدایت و انقضای زمان (aging) مانند مدخل‌های پویای معمولی رفتار می‌کنند. به‌طور پیش‌فرض این پرچم خاموش است.

.BI backup_port " DEVICE"
\- در صورتی که درگاه حامل (carrier) را از دست بدهد، تمام ترافیک به درگاه پشتیبان (backup port) پیکربندی‌شده تغییر مسیر می‌یابد.

.BR nobackup_port
\- درگاه پشتیبان پیکربندی‌شده فعلی را حذف می‌کند.

.BI backup_nhid " NHID"
\- شناسه شیء nexthop در FDB (به \fBip-nexthop\fR(8) مراجعه کنید) برای پیوست شدن به بسته‌هایی که به درگاه پشتیبان با نگاشت تونل VLAN فعال (از طریق گزینه \fBvlan_tunnel\fR) هدایت می‌شوند. تنظیم مقدار 0 (پیش‌فرض) این اثر را دارد که هیچ شناسه‌ای پیوست نمی‌شود.

.in -8

.TP
پشتیبانی از اسلیو بوند (Bond Slave Support)
برای پیوندی با مستر
.B bond
آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.B "ip link set type bond_slave"
[
.BI queue_id " ID"
] [
.BI prio " PRIORITY"
]

.in +8
.sp
.BI queue_id " ID"
\- تنظیم شناسه صف (queue ID) اسلیو (یک مقدار ۱۶ بیتی بدون علامت).

.sp
.BI prio " PRIORITY"
\- تنظیم اولویت اسلیو برای انتخاب مجدد اسلیو فعال در هنگام failover (یک مقدار ۳۲ بیتی علامت‌دار). این گزینه فقط برای حالت‌های active-backup(1)، balance-tlb (5) و balance-alb (6) معتبر است.

.sp
.BI actor_port_prio " PRIORITY"
\- تنظیم اولویت درگاه actor در پروتکل 802.3ad اسلیو برای منطق انتخاب تجمیع 802.3ad در هنگام failover (یک مقدار ۱۶ بیتی بدون علامت). این گزینه فقط برای حالت 802.3ad (4) معتبر است.

.in -8

.TP
پشتیبانی از MACVLAN و MACVTAP (MACVLAN and MACVTAP Support)
تغییر فهرست macaddrهای مجاز برای پیوند در حالت source.

.B "ip link set type { macvlan | macvap } "
[
.BI macaddr " " "" COMMAND " " MACADDR " ..."
]

دستورات:
.in +8
.B add
\- افزودن MACADDR به فهرست مجاز
.sp
.B set
\- جایگزینی فهرست مجاز
.sp
.B del
\- حذف MACADDR از فهرست مجاز
.sp
.B flush
\- پاکسازی تمام فهرست مجاز
.sp
.in -8

به‌روزرسانی طول صف همگانی/چندپخشی (broadcast/multicast).

.B "ip link set type { macvlan | macvap } "
[
.BI bcqueuelen "  LENGTH  "
]
[
.BI bclim " LIMIT "
]

.in +8
.BI bcqueuelen " LENGTH "
\- تنظیم طول صف RX مورد استفاده برای پردازش بسته‌های همگانی و چندپخشی.
.IR LENGTH " باید یک عدد صحیح مثبت در محدوده [0-4294967295] باشد."
تنظیم طول روی 0 عملاً تمام ترافیک همگانی/چندپخشی را دور می‌ریزد (drop می‌کند).
در صورت عدم تعیین، مقدار پیش‌فرض گرداننده macvlan (مقدار 1000) استفاده می‌شود.
توجه داشته باشید که تمام macvlanهایی که از همان دستگاه زیربنایی مشترک استفاده می‌کنند از یک صف مشترک استفاده می‌نمایند.
.RB "پارامتر در اینجا یک «" request "» (درخواست) است، طول صف واقعی مورد استفاده"
حداکثر طولی خواهد بود که هر یک از رابط‌های macvlan درخواست کرده‌اند.
هنگام فهرست کردن پارامترهای دستگاه، هم پارامتر bcqueuelen و هم مقدار bcqueuelen عملاً استفاده‌شده فهرست می‌شوند تا به درک بهتر کاربر از این تنظیم کمک کنند.

.BI bclim " LIMIT "
\- تنظیم آستانه برای صف‌بندی همگانی.
.IR LIMIT " باید یک عدد صحیح ۳۲ بیتی باشد."
تنظیم این مقدار روی -1 صف‌بندی همگانی را کاملاً غیرفعال می‌کند. در غیر این صورت، اگر تعداد دستگاه‌هایی که از آن استفاده می‌کنند بیشتر از مقدار داده‌شده باشد، یک آدرس چندپخشی به عنوان همگانی صف‌بندی خواهد شد.
.in -8

.TP
پشتیبانی از درگاه کاربری DSA (DSA user port support)
برای پیوندی که نوع درگاه کاربری DSA را دارد، آرگومان‌های اضافی زیر پشتیبانی می‌شوند:

.B "ip link set type dsa "
[
.BI conduit " DEVICE"
]

.in +8
.sp
.BI conduit " DEVICE"
\- تغییر conduit مربوط به DSA (رابط شبکه میزبان) که مسئول مدیریت ترافیک خاتمه‌یافته محلی برای درگاه کاربری سوئیچ DSA داده‌شده است. برای توضیح اینکه کدام رابط‌های شبکه برای خدمت به عنوان رابط‌های conduit این درگاه کاربری مناسب هستند، لطفاً ببینید:
.nf
.UR https://docs.kernel.org/networking/dsa/configuration.html#affinity-of-user-ports-to-cpu-ports
.UE
.fi
و همچنین آنچه توسط گرداننده در حال استفاده پشتیبانی می‌شود.

.sp
.BI master " DEVICE"
\- این یک مترادف برای "conduit" است.

.in -8
.SS ip link show \- نمایش مشخصه‌ها و ویژگی‌های دستگاه (display device attributes)

.TP
.BI dev " NAME " (default)
.I NAME
دستگاه شبکه را برای نمایش مشخص می‌کند.

.TP
.BI group " GROUP "
.I GROUP
مشخص می‌کند که کدام گروه از دستگاه‌ها نمایش داده شوند.

.TP
.B up
فقط رابط‌های فعال (در حال اجرا) را نمایش می‌دهد.

.TP
.B down
فقط رابط‌های غیرفعال (غیر در حال اجرا) را نمایش می‌دهد.

.TP
.BI master " DEVICE "
.I DEVICE
دستگاه اصلی (master) را که دستگاه‌های زیرمجموعه آن باید نمایش داده شوند مشخص می‌کند.

.TP
.BI vrf " NAME "
.I NAME
نمونه VRF را که دستگاه‌های زیرمجموعه آن باید نمایش داده شوند مشخص می‌کند.

.TP
.BI type " TYPE "
.I TYPE
نوع دستگاه‌ها را برای نمایش مشخص می‌کند.

توجه داشته باشید که نام نوع با فهرست انواع پشتیبانی‌شده بررسی نمی‌شود - بلکه همان‌طور که هست به هسته ارسال می‌شود. بعداً در صورتی که هسته قبلاً فیلتر نکرده باشد، از آن برای فیلتر کردن فهرست رابط‌های برگشتی از طریق مقایسه با مشخصه مربوطه استفاده می‌شود. بنابراین هر رشته‌ای پذیرفته می‌شود، اما ممکن است به خروجی خالی منجر شود.

.TP
.B nomaster
فقط دستگاه‌های فاقد دستگاه اصلی (master) را نمایش می‌دهد.

.TP
.B novf
فقط دستگاه‌های فاقد اطلاعات VF (توابع مجازی) را نمایش می‌دهد.

.SS ip link xstats \- نمایش آمار تفصیلی و گسترش‌یافته (display extended statistics)

.TP
.BI type " TYPE "
.I TYPE
نوع دستگاه‌ها را برای نمایش آمار تفصیلی و گسترش‌یافته مشخص می‌کند.

.SS ip link afstats \- نمایش آمار مختص خانواده پروتکل (display address-family specific statistics)

.TP
.BI dev " DEVICE "
.I DEVICE
دستگاه را برای نمایش آمار مختص خانواده پروتکل مشخص می‌کند.

.SS ip link help \- نمایش راهنمای دستور (display help)

.PP
.I "TYPE"
مشخص می‌کند که راهنمای کدام نوع پیوند نمایش داده شود.

.SS
.I GROUP
می‌تواند یک عدد یا یک رشته از
.BR /usr/share/iproute2/group " یا " /etc/iproute2/group
باشد که می‌توان آن را به صورت دستی پر کرد و در صورت وجود اولویت دارد.

.SH "مثال‌ها (EXAMPLES)"
.PP
ip link show
.RS 4
وضعیت تمام رابط‌های شبکه روی سیستم را نشان می‌دهد.
.RE
.PP
ip link show type bridge
.RS 4
دستگاه‌های پل (bridge) را نمایش می‌دهد.
.RE
.PP
ip link show type vlan
.RS 4
دستگاه‌های vlan را نمایش می‌دهد.
.RE
.PP
ip link show master br0
.RS 4
دستگاه‌های زیرمجموعه (پیرو) br0 را نشان می‌دهد.
.RE
.PP
ip link set dev ppp0 mtu 1400
.RS 4
مقدار MTU دستگاه ppp0 را تغییر می‌دهد.
.RE
.PP
ip link add link eth0 name eth0.10 type vlan id 10
.RS 4
یک دستگاه vlan جدید به نام eth0.10 روی دستگاه eth0 ایجاد می‌کند.
.RE
.PP
ip link delete dev eth0.10
.RS 4
دستگاه vlan را حذف می‌کند.
.RE

ip link help gre
.RS 4
راهنمای مربوط به نوع پیوند gre را نمایش می‌دهد.
.RE
.PP
ip link add name tun1 type ipip remote 192.168.1.1
local 192.168.1.2 ttl 225 encap gue encap-sport auto
encap-dport 5555 encap-csum encap-remcsum
.RS 4
یک تونل IPIP ایجاد می‌کند که با کپسوله‌سازی Generic UDP کپسوله‌سازی شده است و چکسام بیرونی UDP و باراندازی چکسام راه دور (remote checksum offload) در آن فعال هستند.
.RE
.PP
ip link set dev eth0 xdp obj prog.o
.RS 4
یک برنامه XDP/BPF را به دستگاه eth0 متصل می‌کند، به‌طوری که برنامه در فایل prog.o و در بخش "prog" (بخش پیش‌فرض) قرار دارد. در صورتی که یک برنامه XDP/BPF از قبل متصل شده باشد، خطا صادر می‌کند.
.RE
.PP
ip -force link set dev eth0 xdp obj prog.o sec foo
.RS 4
یک برنامه XDP/BPF را به دستگاه eth0 متصل می‌کند، به‌طوری که برنامه در فایل prog.o و در بخش "foo" قرار دارد. در صورتی که یک برنامه XDP/BPF از قبل متصل شده باشد، با برنامه جدید بازنویسی (جایگزین) خواهد شد.
.RE
.PP
ip -force link set dev eth0 xdp pinned /sys/fs/bpf/foo
.RS 4
یک برنامه XDP/BPF را به دستگاه eth0 متصل می‌کند، در حالی که برنامه قبلاً به عنوان یک گره شیء با نام foo در سیستم‌فایل BPF پین شده بود.
.RE
.PP
ip link set dev eth0 xdp off
.RS 4
اگر یک برنامه XDP/BPF به دستگاه eth0 متصل باشد، آن را جدا کرده و عملاً XDP را برای دستگاه eth0 غیرفعال (خاموش) می‌کند.
.RE
.PP
ip link add link wpan0 lowpan0 type lowpan
.RS 4
یک رابط 6LoWPAN به نام lowpan0 بر روی دستگاه پایه‌ای IEEE 802.15.4 یعنی wpan0 ایجاد می‌کند.
.RE
.PP
ip link add dev ip6erspan11 type ip6erspan seq key 102
local fc00:100::2 remote fc00:100::1
erspan_ver 2 erspan_dir ingress erspan_hwid 17
.RS 4
یک رابط IP6ERSPAN نسخه 2 به نام ip6erspan00 ایجاد می‌کند.
.RE
.PP
ip link set dev swp0 type dsa conduit eth1
.RS 4
رابط مجرای (conduit) درگاه کاربری swp0 را به eth1 تغییر می‌دهد.
.RE

.SH "همچنین ببینید (SEE ALSO)"
.br
