.\" Start URL macro. Copied from an-ext.tmac for portability
.de UR
.  ds m1 \\$1\"
.  nh
.  if \\n(mH \{\
.    \" Start diversion in a new environment.
.    do ev URL-div
.    do di URL-div
.  \}
..
.\" End URL macro. Copied from an-ext.tmac for portability
.de UE
.  ie \\n(mH \{\
.    br
.    di
.    ev
.
.    \" Has there been one or more input lines for the link text?
.    ie \\n(dn \{\
.      do HTML-NS "<a href=""\\*(m1"">"
.      \" Yes, strip off final newline of diversion and emit it.
.      do chop URL-div
.      do URL-div
.    \}
.    el \
.      do HTML-NS "<a href=""\\*(m1"">\\*(m1</a>"
\&\\$*\"
.  \}
.  el \
\\*(la\\*(m1\\*(ra\\$*\"
.
.  hy \\n(HY
..
.TH ZABBIX_SERVER 8 "2022\-01\-06" Zabbix
.SH "نام (NAME)"
zabbix_server \- دیمن سرور زبیکس
.SH "خلاصه دستور (SYNOPSIS)"
.B zabbix_server
.RB [ \-c
.IR config\-file ]
.br
.B zabbix_server
.RB [ \-c
.IR config\-file ]
.B \-R
.I runtime\-option
.br
.B zabbix_server
.RB [ \-c
.IR config\-file ]
.B \-T
.br
.B zabbix_server \-h
.br
.B zabbix_server \-V
.SH "توضیحات (DESCRIPTION)"
.B zabbix_server
دیمن هسته و اصلی نرم‌افزار زبیکس (Zabbix) است\&.
.SH "گزینه‌ها (OPTIONS)"
.IP "\fB\-c\fR, \fB\-\-config\fR \fIconfig\-file\fR"
استفاده از فایل پیکربندی جایگزین \fIconfig\-file\fR به‌جای فایل پیش‌فرض\&.
.IP "\fB\-f\fR, \fB\-\-foreground\fR"
اجرای سرور زبیکس در پیش‌زمینه (foreground)\&.
.IP "\fB\-R\fR, \fB\-\-runtime\-control\fR \fIruntime\-option\fR"
انجام عملکردهای مدیریتی متناسب با گزینه زمان اجرای \fIruntime\-option\fR\&.
.SS
.RS 4
گزینه‌های کنترل زمان اجرا:
.RS 4
.TP 4
.B config_cache_reload
بارگذاری مجدد حافظهٔ پنهان (کَش) پیکربندی\&.
در صورتی که کَش در حال حاضر بارگذاری شود، نادیده گرفته می‌شود\&.
فایل پیکربندی پیش‌فرض (مگر اینکه گزینهٔ \fB\-c\fR مشخص شده باشد) برای یافتن فایل PID استفاده خواهد شد و سیگنال به فرآیندی که در فایل PID فهرست شده ارسال می‌گردد\&.
.RE
.RS 4
.TP 4
.B snmp_cache_reload
بارگذاری مجدد حافظهٔ پنهان SNMP\&.
.RE
.RS 4
.TP 4
.B housekeeper_execute
اجرای housekeeper (پاک‌کننده داده‌های قدیمی)\&.
در صورتی که housekeeper در حال حاضر در حال اجرا باشد، نادیده گرفته می‌شود\&.
.RE
.RS 4
.TP 4
.B trigger_housekeeper_execute
اجرای trigger housekeeper (حذف مشکلات مربوط به تریگرهای حذف‌شده)\&.
در صورتی که trigger housekeeper در حال حاضر در حال اجرا باشد، نادیده گرفته می‌شود\&.
.RE
.RS 4
.TP 4
.B secrets_reload
بارگذاری مجدد اسرار (secrets) از Vault\&.
اگر کَش پیکربندی یا اسرار در حال حاضر در حال بارگذاری باشند، نادیده گرفته می‌شود\&.
.RE
.RS 4
.TP 4
\fBdiaginfo\fR[=\fIsection\fR]
ثبت اطلاعات تشخیصی داخلی بخش مشخص‌شده در گزارش (لاگ)\&. بخش (\fIsection\fR) می‌تواند شامل \fIhistorycache\fR، \fIpreprocessing\fR، \fIalerting\fR، \fIlld\fR، \fIvaluecache\fR، \fIlocks\fR و \fIconnector\fR باشد\&.
به‌طور پیش‌فرض، اطلاعات تشخیصی تمامی بخش‌ها ثبت می‌شود\&.
.RE
.RS 4
.TP 4
\fBprof_enable\fR[=\fItarget\fR]
فعال‌سازی پروفایلینگ (profiling)؛ در صورت مشخص نشدن هدف (\fItarget\fR)، بر تمامی فرآیندها اثر می‌گذارد\&.
.RE
.RS 4
.TP 4
\fBprof_disable\fR[=\fItarget\fR]
غیرفعال‌سازی پروفایلینگ (profiling)؛ در صورت مشخص نشدن هدف (\fItarget\fR)، بر تمامی فرآیندها اثر می‌گذارد\&.
.RE
.RS 4
.TP 4
.B ha_status
نمایش وضعیت کلاستر دسترسی‌پذیری بالا (high availability)\&.
تنها بر روی گره فعال (active node) قابل اجرا است\&.
.RE
.RS 4
.TP 4
.B ha_remove_node
\fBha_remove_node\fR[=\fIname|ID\fR]
حذف گره دسترسی‌پذیری بالا با استفاده از نام یا شناسه آن که در ha_status آمده است\&.
تنها بر روی گره فعال قابل اجرا است\&.
.RE
.RS 4
.TP 4
\fBha_set_failover_delay\fR[=\f delay\fR]
تنظیم تأخیر تغییر خودکار وضعیت (failover delay) برای دسترسی‌پذیری بالا\&.
تأخیر را می‌توان با استفاده از پسوندهای زمانی مشخص کرد\&.
تنها بر روی گره فعال قابل اجرا است\&.
.RE
.RS 4
.TP 4
\fBlog_level_increase\fR[=\fItarget\fR]
افزایش سطح گزارش‌گیری (لاگ)؛ در صورت مشخص نشدن هدف، بر تمامی فرآیندها اثر می‌گذارد\&.
.RE
.RS 4
.TP 4
\fBlog_level_decrease\fR[=\fItarget\fR]
کاهش سطح گزارش‌گیری (لاگ)؛ در صورت مشخص نشدن هدف، بر تمامی فرآیندها اثر می‌گذارد\&.
.RE
.RE
.SS
.RS 4
اهداف کنترل سطح گزارش‌گیری (لاگ):
.RS 4
.TP 4
.I process\-type
تمامی فرآیندهای نوع مشخص‌شده (alerter، alert\ manager، alert\ syncer، availability\ manager، browser\ poller، configuration\ syncer، configuration\ syncer\ worker، connector\ manager، connector\ worker، discovery\ manager، escalator، ha\ manager، history\ poller، history\ syncer، housekeeper، http\ poller، http\ agent\ poller، icmp\ pinger، internal\ poller، ipmi\ manager، ipmi\ poller، java\ poller، lld\ manager، lld\ worker، odbc\ poller، poller، agent\ poller، preprocessing\ manager، preprocessing\ worker، proxy\ poller، proxy\ group\ manager، report\ manager، report\ writer، self\-monitoring، service\ manager، snmp\ poller، snmp\ trapper، task\ manager، timer، trapper، trigger\ housekeeper، unreachable\ poller، vmware\ collector)
.RE
.RS 4
.TP 4
.I process\-type,N
نوع و شماره فرآیند (برای نمونه: poller,3)
.RE
.RS 4
.TP 4
.I pid
شناسه فرآیند
.RE
.RE
.SS
.RS 4
اهداف کنترل پروفایلینگ:
.RS 4
.TP 4
.I process\-type
تمامی فرآیندهای نوع مشخص‌شده (alerter، alert\ manager، alert\ syncer، availability\ manager، browser\ poller، configuration\ syncer، configuration\ syncer\ worker، connector\ manager، connector\ worker، discovery\ manager، escalator، ha\ manager، history\ poller، history\ syncer، housekeeper، http\ poller، http\ agent\ poller، icmp\ pinger، internal\ poller، ipmi\ manager، ipmi\ poller، java\ poller، lld\ manager، lld\ worker، odbc\ poller، poller، agent\ poller، preprocessing\ manager، proxy\ poller، proxy\ group\ manager، report\ manager، report\ writer، self\-monitoring، service\ manager، snmp\ poller، snmp\ trapper، task\ manager، timer، trapper، trigger\ housekeeper، unreachable\ poller، vmware\ collector)
.RE
.RS 4
.TP 4
.I process\-type,N
نوع و شماره فرآیند (برای نمونه: history syncer,1)
.RE
.RS 4
.TP 4
.I pid
شناسه فرآیند
.RE
.RS 4
.TP 4
.I scope
حوزه (scope) شامل rwlock، mutex و processing می‌تواند همراه با نوع فرآیند استفاده شود (برای نمونه: history syncer,1,processing)
.RE
.RE
.IP "\fB\-T\fR, \fB\-\-test-config\fR"
اعتبارسنجی فایل پیکربندی و خروج\&.
.IP "\fB\-h\fR, \fB\-\-help\fR"
نمایش این راهنما و خروج\&.
.IP "\fB\-V\fR, \fB\-\-version\fR"
نمایش اطلاعات نسخه و خروج\&.
.SH "فایل‌ها (FILES)"
.TP
.I /usr/local/etc/zabbix_server.conf
مکان پیش‌فرض فایل پیکربندی سرور زبیکس (اگر در زمان کامپایل تغییر نکرده باشد)\&.
.SH "همچنین ببینید (SEE ALSO)"
.UR https://www.zabbix.com/manuals
مستندات
.UE
.PP
.BR zabbix_agentd (8),
.BR zabbix_get (1),
.BR zabbix_proxy (8),
.BR zabbix_sender (1),
.BR zabbix_js (1),
.BR zabbix_agent2 (8),
.BR zabbix_web_service (8)
