FRUIT_PRICES = {
    \(dqapple\(dq: 1.1,
    \(dqpear\(dq: 0.8,
    \(dqbanana\(dq: 1.2,
    \(dqmango\(dq: 3.5,
    \(dqpeach\(dq: 0.5,
