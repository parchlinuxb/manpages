.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-rename \- تغییر نام یک کانتینر


.SH "خلاصه دستور (SYNOPSIS)"
\fBdocker rename CONTAINER NEW_NAME\fP


.SH "شرح (DESCRIPTION)"
نام مستعار برای \fBdocker container rename\fR\&.


.SH "ببینید (SEE ALSO)"
\fBdocker(1)\fP
