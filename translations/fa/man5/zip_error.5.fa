.Dd May 5, 2025
.Dt ZIP_ERROR 5
.Os
.SH "نام (NAME)"
zip_error \- ساختار خطای libzip
.Sh "کتابخانه (LIBRARY)"
libzip (-lzip)
.Sh "خلاصه دستور (SYNOPSIS)"
.In zip.h
.Vt zip_error_t error ;
.Sh "توضیحات (DESCRIPTION)"
یک
.Nm zip_error
نشان‌دهنده اطلاعات مربوط به یک خطا است.
این ساختار معمولاً مستقیماً روی پشته (stack) یا به عنوان عضوی از ساختاری دیگر تخصیص می‌یابد، نه از طریق اشاره‌گر.
.Pp
این ساختار با
.Xr zip_error_init 3
یا
.Xr zip_error_init_with_code 3
مقداردهی اولیه می‌شود.
.Pp
نوع خطا می‌تواند با
.Xr zip_error_code_zip 3
و
.Xr zip_error_code_system 3
دسترسی پیدا کند.
این اطلاعات می‌تواند با استفاده از
.Xr zip_error_strerror 3
به یک رشته قابل خواندن برای انسان تبدیل شود.
.Pp
پس از استفاده، باید با
.Xr zip_error_fini 3
پاکسازی و رهاسازی شود.
.Sh "همچنین ببینید (SEE ALSO)"
.Xr zip_error_code_system 3 ,
.Xr zip_error_code_zip 3 ,
.Xr zip_error_fini 3 ,
.Xr zip_error_init 3 ,
.Xr zip_error_init_with_code 3 ,
.Xr zip_error_strerror 3
.Sh "نویسندگان (AUTHORS)"
.An -nosplit
.An Dieter Baron Aq Mt dillo@nih.at
و
.An Thomas Klausner Aq Mt wiz@gatalith.at
