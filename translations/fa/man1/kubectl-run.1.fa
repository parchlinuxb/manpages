.nh
.TH KUBERNETES 1 "Jan 2015" "Eric Paris" "راهنمای کاربر kubernetes"

.SH "نام (NAME)"
kubectl-run \- اجرای یک ایمیج مشخص در کلاستر


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubectl run\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
ایجاد و اجرای یک ایمیج مشخص در یک پاد.


.SH "گزینه‌ها (OPTIONS)"
\fB--allow-missing-template-keys\fP=true
	در صورت true بودن، چشم‌پوشی از هرگونه خطا در الگوها هنگامی که یک فیلد یا کلید نگاشت (map key) در الگو وجود ندارد. فقط برای قالب‌های خروجی golang و jsonpath اعمال می‌شود.

.PP
\fB--annotations\fP=[]
	حاشیه‌نویسی‌هایی (annotations) که بر پاد اعمال می‌شوند.

.PP
\fB--attach\fP=false
	در صورت true بودن، منتظر اجرای پاد مانده و سپس به پاد متصل می‌شود به‌گونه‌ای که گویی دستور '... kubectl attach' فراخوانی شده است. مقدار پیش‌فرض false است، مگر آنکه '\-i/\-\-stdin' تنظیم شده باشد که در آن صورت پیش‌فرض true خواهد بود. با گزینه '\-\-restart=Never'، کد خروج (exit code) فرآیند کانتینر بازگردانده می‌شود.

.PP
\fB--cascade\fP="background"
	باید یکی از مقادیر "background"، "orphan" یا "foreground" باشد. راهبرد آبشاری حذف را برای وابسته‌ها (مانند پادهای ایجادشده توسط ReplicationController) انتخاب می‌کند. پیش‌فرض بر روی background است.

.PP
\fB--command\fP=false
	در صورت true بودن و وجود آرگومان‌های اضافی، از آن‌ها به عنوان فیلد 'command' در کانتینر استفاده می‌شود، به جای فیلد 'args' که پیش‌فرض است.

.PP
\fB--detach-keys\fP="ctrl-p,ctrl-q"
	تغییر توالی کلیدها برای جدا شدن (detach) از کانتینر.

.PP
\fB--dry-run\fP="none"
	باید یکی از مقادیر "none"، "server" یا "client" باشد. در راهبرد client، تنها شیئی که ارسال می‌شد چاپ می‌شود، بدون آنکه ارسال گردد. در راهبرد server، درخواست سمت سرور ارسال می‌شود بدون آنکه منبع پایدار و ذخیره شود.

.PP
\fB--env\fP=[]
	متغیرهای محیطی برای تنظیم در کانتینر.

.PP
\fB--expose\fP=false
	در صورت true بودن، یک سرویس ClusterIP مرتبط با پاد ایجاد می‌کند. نیازمند \fB\-\-port\fR\& است.

.PP
\fB--field-manager\fP="kubectl-run"
	نام مدیری که برای ردیابی مالکیت فیلدها استفاده می‌شود.

.PP
\fB-f\fP, \fB--filename\fP=[]
	جهت استفاده برای جایگزینی منبع.

.PP
\fB--force\fP=false
	در صورت true بودن، بلافاصله منابع را از API حذف کرده و از حذف ملایم صرف‌نظر می‌کند. توجه داشته باشید که حذف فوری برخی منابع ممکن است منجر به ناسازگاری یا از دست رفتن داده‌ها شود و نیازمند تایید است.

.PP
\fB--grace-period\fP=-1
	مدت زمان به ثانیه که به منبع داده می‌شود تا به صورت ملایم خاتمه یابد. در صورت منفی بودن نادیده گرفته می‌شود. برای خاموش شدن فوری روی ۱ تنظیم کنید. تنها زمانی می‌تواند روی ۰ تنظیم شود که \fB\-\-force\fP برابر با true باشد (حذف اجباری).

.PP
\fB--image\fP=""
	ایمیجی که کانتینر باید اجرا کند.

.PP
\fB--image-pull-policy\fP=""
	سیاست دریافت ایمیج (image pull policy) برای کانتینر. در صورت خالی ماندن، این مقدار توسط کلاینت تعیین نشده و مقدار پیش‌فرض توسط سرور اعمال می‌شود.

.PP
\fB-k\fP, \fB--kustomize\fP=""
	پردازش دایرکتوری kustomization. این فلگ نمی‌تواند همراه با \fB\-f\fP یا \fB\-R\fP استفاده شود.

.PP
\fB-l\fP, \fB--labels\fP=""
	برچسب‌های جداشده با کاما برای اعمال روی پاد. مقادیر قبلی را بازنویسی خواهد کرد.

.PP
\fB--leave-stdin-open\fP=false
	اگر پاد در حالت تعاملی یا با stdin راه‌اندازی شده باشد، stdin پس از پایان اولین اتصال باز می‌ماند. به طور پیش‌فرض، stdin پس از پایان اولین اتصال بسته خواهد شد.

.PP
\fB-o\fP, \fB--output\fP=""
	قالب خروجی. یکی از موارد: (json, yaml, kyaml, name, go-template, go-template-file, template, templatefile, jsonpath, jsonpath-as-json, jsonpath-file).

.PP
\fB--override-type\fP="merge"
	روشی که برای بازنویسی شیء تولیدشده استفاده می‌شود: json، merge، یا strategic.

.PP
\fB--overrides\fP=""
	یک بازنویسی JSON درون‌خطی برای شیء تولیدشده. اگر این مقدار غیرخالی باشد، برای بازنویسی شیء تولیدشده استفاده می‌شود. نیازمند آن است که شیء یک فیلد apiVersion معتبر ارائه دهد.

.PP
\fB--pod-running-timeout\fP=1m0s
	مدت زمان انتظار (مانند 5s، 2m یا 3h، بیشتر از صفر) تا زمانی که حداقل یک پاد در حال اجرا باشد

.PP
\fB--port\fP=""
	پورتی که این کانتینر در معرض دسترسی قرار می‌دهد (expose می‌کند).

.PP
\fB--privileged\fP=false
	در صورت true بودن، کانتینر در حالت ممتاز (privileged mode) اجرا می‌شود.

.PP
\fB-q\fP, \fB--quiet\fP=false
	در صورت true بودن، پیام‌های اعلان (prompt) نادیده گرفته می‌شوند.

.PP
\fB--record\fP=false
	ثبت دستور فعلی kubectl در حاشیه‌نویسی منبع. در صورت تنظیم روی false، دستور ثبت نمی‌شود. در صورت تنظیم روی true، دستور ثبت می‌شود. در صورت عدم تنظیم، به طور پیش‌فرض مقدار حاشیه‌نویسی موجود تنها در صورتی به‌روزرسانی می‌شود که از قبل وجود داشته باشد.

.PP
\fB-R\fP, \fB--recursive\fP=false
	پردازش بازگشتی دایرکتوری استفاده‌شده در \fB\-f\fP، \fB\-\-filename\fP. زمانی کاربرد دارد که می‌خواهید مانیفست‌های مرتبط سازمان‌یافته در یک دایرکتوری یکسان را مدیریت کنید.

.PP
\fB--restart\fP="Always"
	سیاست راه‌اندازی مجدد (restart policy) برای این پاد. مقادیر مجاز [Always, OnFailure, Never].

.PP
\fB--rm\fP=false
	در صورت true بودن، پاد پس از خروج حذف می‌شود. تنها هنگام اتصال به کانتینر معتبر است، مانند استفاده از '\-\-attach' یا '\-i/\-\-stdin'.

.PP
\fB--save-config\fP=false
	در صورت true بودن، پیکربندی شیء فعلی در حاشیه‌نویسی آن ذخیره می‌شود؛ در غیر این صورت حاشیه‌نویسی بدون تغییر خواهد ماند. این فلگ زمانی مفید است که بخواهید در آینده دستور kubectl apply را بر روی این شیء اجرا کنید.

.PP
\fB--show-managed-fields\fP=false
	در صورت true بودن، فیلدهای managedFields هنگام چاپ اشیاء در قالب‌های JSON یا YAML حفظ می‌شوند.

.PP
\fB-i\fP, \fB--stdin\fP=false
	باز نگه داشتن ورودی استاندارد (stdin) روی کانتینر درون پاد، حتی اگر چیزی به آن متصل نباشد.

.PP
\fB--template\fP=""
	رشته الگو یا مسیر فایل الگو برای استفاده در زمان \fB\-o=go\-template\fP یا \fB\-o=go\-template\-file\fP. فرمت الگو از نوع الگوهای golang است [http://golang.org/pkg/text/template/#pkg-overview].

.PP
\fB--timeout\fP=0s
	مدت زمان انتظار پیش از انصراف از حذف؛ مقدار صفر به معنای تعیین مدت‌زمان انقضا بر اساس اندازه شیء است.

.PP
\fB-t\fP, \fB--tty\fP=false
	اختصاص یک TTY برای کانتینر درون پاد.

.PP
\fB--wait\fP=false
	در صورت true بودن، پیش از بازگشت منتظر از بین رفتن منابع می‌ماند. این گزینه منتظر نهایی‌سازها (finalizers) می‌ماند.


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--as\fP=""
	نام کاربری برای جعل هویت (impersonate) در این عملیات. کاربر می‌تواند یک کاربر معمولی یا یک حساب خدمت (service account) در یک namespace باشد.

.PP
\fB--as-group\fP=[]
	گروه برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای تعیین چندین گروه تکرار شود.

.PP
\fB--as-uid\fP=""
	شناسه UID برای جعل هویت در این عملیات.

.PP
\fB--as-user-extra\fP=[]
	اطلاعات اضافی کاربر برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای مشخص کردن چندین مقدار برای یک کلید یکسان تکرار شود.

.PP
\fB--cache-dir\fP="/home/username/.kube/cache"
	دایرکتوری پیش‌فرض کش

.PP
\fB--certificate-authority\fP=""
	مسیر فایل گواهی برای مرجع صدور گواهی (certificate authority)

.PP
\fB--client-certificate\fP=""
	مسیر فایل گواهی کلاینت برای TLS

.PP
\fB--client-key\fP=""
	مسیر فایل کلید کلاینت برای TLS

.PP
\fB--cluster\fP=""
	نام کلاستر kubeconfig برای استفاده

.PP
\fB--context\fP=""
	نام کانتکست kubeconfig برای استفاده

.PP
\fB--disable-compression\fP=false
	در صورت true بودن، فشرده‌سازی پاسخ‌ها برای تمام درخواست‌ها به سرور غیرفعال می‌شود

.PP
\fB--insecure-skip-tls-verify\fP=false
	در صورت true بودن، اعتبار گواهی سرور بررسی نخواهد شد. این کار اتصالات HTTPS شما را ناامن می‌کند

.PP
\fB--kubeconfig\fP=""
	مسیر فایل kubeconfig برای استفاده در درخواست‌های CLI.

.PP
\fB--kuberc\fP=""
	مسیر فایل kuberc برای استفاده در ترجیحات (preferences). این قابلیت می‌تواند با export کردن feature gate به صورت KUBECTL_KUBERC=false یا خاموش کردن ویژگی با KUBERC=off غیرفعال شود.

.PP
\fB--match-server-version\fP=false
	الزام به تطابق نسخه سرور با نسخه کلاینت

.PP
\fB-n\fP, \fB--namespace\fP=""
	در صورت وجود، حوزه namespace برای این درخواست CLI

.PP
\fB--password\fP=""
	رمز عبور برای احراز هویت پایه (basic authentication) در سرور API

.PP
\fB--profile\fP="none"
	نام پروفایل برای ثبت. یکی از (none|cpu|heap|goroutine|threadcreate|block|mutex|trace)

.PP
\fB--profile-output\fP="profile.pprof"
	نام فایلی که پروفایل در آن ذخیره می‌شود

.PP
\fB--request-timeout\fP="0"
	مدت زمان انتظار پیش از انصراف از یک درخواست به سرور. مقادیر غیر صفر باید شامل واحد زمانی متناظر باشند (مانند 1s، 2m، 3h). مقدار صفر یعنی درخواست‌ها هرگز منقضی نشوند (بدون timeout).

.PP
\fB-s\fP, \fB--server\fP=""
	آدرس و پورت سرور Kubernetes API

.PP
\fB--tls-server-name\fP=""
	نام سرور برای اعتبارسنجی گواهی سرور. در صورت عدم ارائه، از hostname استفاده‌شده برای برقراری ارتباط با سرور استفاده می‌شود

.PP
\fB--token\fP=""
	توکن Bearer برای احراز هویت در سرور API

.PP
\fB--user\fP=""
	نام کاربر kubeconfig برای استفاده

.PP
\fB--username\fP=""
	نام کاربری برای احراز هویت پایه در سرور API

.PP
\fB--version\fP=false
	گزینه \fB\-\-version\fP یا \fB\-\-version=raw\fP اطلاعات نسخه را چاپ کرده و خارج می‌شود؛ \fB\-\-version=vX.Y.Z...\fP نسخه گزارش‌شده را تنظیم می‌کند

.PP
\fB--warnings-as-errors\fP=false
	در نظر گرفتن هشدارهای دریافتی از سرور به عنوان خطا و خروج با کد وضعیت غیر صفر


.SH "مثال‌ها (EXAMPLES)"
.EX
  # راه‌اندازی یک پاد nginx
  kubectl run nginx --image=nginx

  # راه‌اندازی یک پاد hazelcast و قرار دادن پورت 5701 در معرض دسترسی برای کانتینر
  kubectl run hazelcast --image=hazelcast/hazelcast --port=5701

  # راه‌اندازی یک پاد hazelcast و تنظیم متغیرهای محیطی "DNS_DOMAIN=cluster" و "POD_NAMESPACE=default" در کانتینر
  kubectl run hazelcast --image=hazelcast/hazelcast --env="DNS_DOMAIN=cluster" --env="POD_NAMESPACE=default"

  # راه‌اندازی یک پاد hazelcast و تنظیم برچسب‌های "app=hazelcast" و "env=prod" در کانتینر
  kubectl run hazelcast --image=hazelcast/hazelcast --labels="app=hazelcast,env=prod"

  # اجرای آزمایشی (dry run)؛ چاپ اشیاء API مربوطه بدون ایجاد واقعی آن‌ها
  kubectl run nginx --image=nginx --dry-run=client

  # راه‌اندازی یک پاد nginx، اما بازنویسی مشخصات با مجموعه‌ای جزئی از مقادیر ارائه‌شده از JSON
  kubectl run nginx --image=nginx --overrides='{ "apiVersion": "v1", "spec": { ... } }'

  # راه‌اندازی یک پاد busybox و نگه داشتن آن در پیش‌زمینه، عدم راه‌اندازی مجدد در صورت خروج
  kubectl run -i -t busybox --image=busybox --restart=Never

  # راه‌اندازی پاد nginx با استفاده از دستور پیش‌فرض، اما استفاده از آرگومان‌های سفارشی (arg1 .. argN) برای آن دستور
  kubectl run nginx --image=nginx -- <arg1> <arg2> ... <argN>

  # راه‌اندازی پاد nginx با استفاده از یک دستور متفاوت و آرگومان‌های سفارشی
  kubectl run nginx --image=nginx --command -- <cmd> <arg1> ... <argN>
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubectl(1)\fP


.SH "تاریخچه (HISTORY)"
ژانویه ۲۰۱۵، در ابتدا توسط Eric Paris (eparis at redhat dot com) بر پایه محتوای منبع kubernetes گردآوری شد، اما امید است که از آن زمان به بعد به طور خودکار تولید شده باشند!
