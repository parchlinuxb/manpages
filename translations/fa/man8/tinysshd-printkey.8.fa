.TH tinysshd\-printkey 8
.SH "نام (NAME)"
tinysshd\-printkey \- چاپ کلیدهای عمومی TinySSH
.SH "خلاصه دستور (SYNOPSIS)"
.B tinysshd\-printkey
.I keydir
.SH "توضیحات (DESCRIPTION)"
.B tinysshd\-printkey
کلیدهای عمومی TinySSH را در قالب base64 چاپ می‌کند.
.SH "گزینه‌ها (OPTIONS)"
.TP
.I keydir
دایرکتوری حاوی کلیدهای TinySSH، معمولاً
.B /etc/tinyssh/sshkeydir
.SH "مثال (EXAMPLE)"
tinysshd\-printkey /etc/tinyssh/sshkeydir
.SH "همچنین ببینید (SEE ALSO)"
.BR tinysshd (8),
.BR tinysshd\-makekey (8)
.sp
.nf
https://tinyssh.org
.fi
