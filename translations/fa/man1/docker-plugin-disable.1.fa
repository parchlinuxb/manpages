.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-plugin-disable \- غیرفعال‌سازی یک افزونه


.SH "خلاصه (SYNOPSIS)"
\fBdocker plugin disable [OPTIONS] PLUGIN\fP


.SH "شرح (DESCRIPTION)"
غیرفعال‌سازی یک افزونه


.SH "گزینه‌ها (OPTIONS)"
\fB-f\fP, \fB--force\fP[=false]
	اجبار به غیرفعال‌سازی یک افزونه فعال


.SH "ببینید (SEE ALSO)"
\fBdocker-plugin(1)\fP
