.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_groff_font_5_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
.\" BEGIN Keep parallel with groff.texi node "Device and Font
.\" Description Files".
فرمت‌های توصیف قلم و دستگاه خروجی
.I groff
گسترش‌یافته‌های جزئی از فرمت‌های استفاده‌شده توسط
.IR troff \" AT&T
مستقل از دستگاه AT&T هستند.
.
برخلاف پیاده‌سازی AT&T،
.I groff
فاقد فرمت باینری است؛
تمام فایل‌ها متنی هستند.
.
(همچنین
.I troff \" Plan 9
در Plan\~9 فرمت باینری را کنار گذاشته است.)
.
فایل‌های توصیف دستگاه و قلم برای یک دستگاه به نام
.I name
در دایرکتوری
.IR dev name
ذخیره می‌شوند.
.
فایل توصیف دستگاه
.IR DESC
نامیده می‌شود،
و برای هر قلمی که دستگاه پشتیبانی می‌کند،
یک فایل توصیف قلم به نام
.I f
وجود دارد، که در آن
.I f
معمولاً مخفف نام قلم و/یا سبک آن است.
.
به عنوان مثال،
دستگاه
.B ps
(PostScript)
دارای فایل‌های توصیف قلم
.I groff
برای Times roman
.RB ( TR )
و Zapf Chancery Medium italic
.RB ( ZCMI )
در میان موارد بسیار دیگر است،
در حالی که دستگاه
.B utf8
(برای ترمینال‌ها)
دارای توصیف قلم برای سبک‌های roman،
italic،
bold
و bold-italic
(به ترتیب
.BR R ،
.BR I ،
.BR B
و
.BR BI )
است.
.
.
.P
فایل‌های توصیف دستگاه و قلم توسط قالب‌بند،
.IR \%troff ،
و توسط درایورهای خروجی خوانده می‌شوند.
.
برنامه‌ها معمولاً پردازش این فایل‌ها را به یک کتابخانه داخلی،
.IR libgroff ،
محول می‌کنند تا تفسیر یکدست آن‌ها تضمین شود.
.
.
.\" ====================================================================
.SH "فرمت فایل \f[I]DESC\f[] (DESC file format)"
.\" ====================================================================
.
فایل
.I DESC
شامل مجموعه‌ای از دستورالعمل‌ها (directives) است؛
هر دستورالعمل در ابتدای یک خط آغاز می‌شود.
.
ترتیب آن‌ها مهم نیست، به استثنای دو مورد:
(۱) دستورالعمل
.B res
باید پیش از هر دستورالعمل
.B \%papersize
قرار گیرد؛
و
(۲) دستورالعمل
.B charset
باید در انتها بیاید
(در صورت وجود).
.
اگر نام یک دستورالعمل تکرار شود،
مدخل‌های بعدی در فایل جایگزین موارد قبلی می‌شوند
(به جز اینکه ابعاد کاغذ بر اساس دستورالعمل
.B res
که پیش از برخورد با
.B \%papersize
دیده شده محاسبه می‌شود).
.
فاصله‌ها و/یا تب‌ها کلمات را از هم جدا می‌کنند و در مرزهای خط نادیده گرفته می‌شوند.
.
توضیحات (کامنت‌ها) با نویسه
.RB \[lq] # \[rq]
آغاز شده و تا انتهای خط ادامه می‌یابند.
.
خطوط خالی نادیده گرفته می‌شوند.
.
.
.TP 8n \" "vert n" + 2n
.BI family\~ fam
خانواده قلم پیش‌فرض
.IR fam
است.
.
.
.TP
.BI fonts\~ "n F1"\~\c
.RI .\|.\|.\&\~ Fn
قلم‌های
.IR F1 ", \|.\|.\|.\|, " Fn
در موقعیت‌های قلم
.IR m "\|+\|1, \|.\|.\|., " m \|+\| n
مستقر (mount) می‌شوند، که در آن
.I m
تعداد
.B styles
است (به زیر مراجعه کنید).
.
این دستورالعمل می‌تواند در بیش از یک خط ادامه یابد.
.
نام قلم
.RB برابر\~ 0
باعث می‌شود هیچ قلمی در موقعیت مربوطه مستقر نشود.
.
.
.TP
.BI hor\~ n
میزان حرکت افقی برابر با
.IR n \~واحد
پایه است.
.
اندازه‌گیری‌های افقی به مضارب
.RI از\~ n
گرد می‌شوند.
.
.
.TP
.BI image_generator\~ program
استفاده از
.I program
برای تولید تصاویر PNG از ورودی PostScript.
.
در GNU/Linux،
این معمولاً
.MR gs 1
است،
اما در سیستم‌های دیگر
(به‌ویژه Cygwin)
ممکن است به نام دیگری تنظیم شود.
.
درایور
.MR grohtml 1
از این دستورالعمل استفاده می‌کند.
.
.
.TP
.BI paperlength\~ n
بُعد عمودی رسانه خروجی
.IR n \~واحد
پایه است
(منسوخ‌شده: به جای آن از
.B \%papersize
استفاده کنید).
.
.
.TP
.BI papersize\~ format-or-dimension-pair-or-file-name\c
\~.\|.\|.
ابعاد رسانه خروجی بر اساس آرگومان مشخص می‌شود،
که می‌تواند یک فرمت استاندارد کاغذ،
یک جفت ابعاد،
یا نام یک فایل متنی ساده حاوی هر یک از موارد فوق باشد.
.
فرمت‌های کاغذ شناخته‌شده عبارتند از فرمت‌های ISO و DIN شامل
.BR A0 \[en] A7 ،
.BR B0 \[en] B7 ،
.BR C0 \[en] C7
و
.BR D0 \[en] D7 ؛
.\" XXX: tmac/papersize.tmac does not support [ABCD]7.
فرمت‌های ایالات متحده شامل
.BR letter ،
.BR legal ،
.BR tabloid ،
.BR ledger ،
.BR statement
و
.BR executive ؛
و فرمت‌های پاکت‌نامه شامل
.BR com10 ،
.BR monarch
و
.BR DL .
.
تطبیق بدون در نظر گرفتن بزرگی و کوچکی حروف انجام می‌شود.
.
.
.IP
در غیر این صورت،
آرگومان می‌تواند یک فرمت کاغذ سفارشی به صورت
.IB length , width
باشد (بدون فاصله قبل یا بعد از کاما).
.
هر دو مقدار
.I length
و
.I width
باید دارای یک واحد پیوست باشند؛
واحدهای معتبر عبارتند از
.RB \[lq] i \[rq]
برای اینچ،
.RB \[lq] c \[rq]
برای سانتی‌متر،
.RB \[lq] p \[rq]
برای پوینت،
و
.RB \[lq] P \[rq]
برای پایکا (pica).
.
مثال:
.RB \[lq] 12c,235p \[rq].
.
آرگومانی که با یک رقم آغاز شود همواره به عنوان فرمت سفارشی کاغذ در نظر گرفته می‌شود.
.
.
.IP
در نهایت،
آرگومان می‌تواند نام یک فایل باشد
(مانند
.IR /etc/papersize )؛
اگر فایل باز شود،
خط نخست آن خوانده شده و برای تطبیق با اشکال دیگر تلاش می‌شود.
.
هیچ ساختاری برای کامنت‌گذاری پشتیبانی نمی‌شود.
.
.
.IP
می‌توان بیش از یک آرگومان تعیین کرد؛
هر یک به نوبت بررسی شده و نخستین مشخصه معتبر کاغذ استفاده می‌شود.
.
.
.TP
.BI paperwidth\~ n
بُعد افقی رسانه خروجی
.IR n \~واحد
پایه است
(منسوخ‌شده: به جای آن از
.B \%papersize
استفاده کنید).
.
.
.TP
.B pass_filenames
دستور دادن به
.I \%troff
برای ارسال نام فایل منبعی که در حال پردازش است.
.
این کار با دستور خروجی واسط
.RB \[lq] "x F" \[rq]
انجام می‌شود، که
.I \%grohtml
آن را تفسیر می‌کند.
.
.
.TP
.BI postpro\~ program
استفاده از
.I program
به عنوان پس‌پردازشگر (postprocessor).
.
.
.TP
.BI prepro\~ program
استفاده از
.I program
به عنوان پیش‌پردازشگر (preprocessor).
.
دستگاه‌های خروجی
.B html
و
.B xhtml
از این دستورالعمل استفاده می‌کنند.
.
.
.TP
.BI print\~  program
استفاده از
.I program
به عنوان صف‌بندی‌کننده چاپ (print spooler).
.
در صورت حذف،
گزینه‌های
.B \-l
و
.B \-L
در
.I groff
نادیده گرفته می‌شوند.
.
.
.TP
.BI res\~ n
تفکیک‌پذیری (رزولوشن) دستگاه
.I n
واحد پایه در هر اینچ است.
.
.
.TP
.BI sizes\~ s1\~\c
.RI .\|.\|.\&\~ sn\~\c
.B 0
دستگاه دارای قلم‌ها در
.IR s1 ،
\&.\|.\|.،
.I sn
پوینت مقیاس‌شده (scaled points) است
(به زیر مراجعه کنید).
.
فهرست اندازه‌ها باید با یک
.RB عدد\~ 0
خاتمه یابد.
.
هر
.I si
می‌تواند یک بازه از اندازه‌ها به صورت
.IR m \[en] n
نیز باشد.
.
این فهرست می‌تواند در بیش از یک خط ادامه یابد.
.
.
.TP
.BI sizescale\~ n
هر پوینت تایپوگرافی به
.IR n \~پوینت
مقیاس‌شده تقسیم می‌شود.
.
مقدار پیش‌فرض
.RB برابر\~ 1
است.
.
.
.TP
.BI styles\~ S1\~\c
.RI .\|.\|.\&\~ Sm
تعداد
.RI نخستین\~ m
موقعیت استقرار قلم با سبک‌های
.IR S1 ،
\&.\|.\|.،
.IR Sm
مرتبط می‌شوند.
.
.
.TP
.B tcommand
پس‌پردازشگر می‌تواند دستورات خروجی واسط
.B t
.RB و\~ u
را مدیریت کند.
.
.
.TP
.B unicode
دستگاه خروجی از مجموعه کامل یونیکد پشتیبانی می‌کند.
.
این دستورالعمل تنها برای دستگاه‌هایی مفید است که به جای گلیف‌ها، موجودیت‌های نویسه‌ای (character entities) تولید می‌کنند.
.
.
.IP
اگر
.B unicode
حضور داشته باشد، هیچ بخش
.B charset
در فایل‌های توصیف قلم لازم نیست زیرا مدیریت یونیکد داخلی
.I groff
به کار گرفته می‌شود.
.
با این حال،
اگر مدخل‌هایی در بخش
.B charset
یک فایل توصیف قلم وجود داشته باشد،
آن‌ها یا نگاشت‌های پیش‌فرض را برای آن نویسه‌های خاص بازنویسی می‌کنند یا نگاشت‌های جدید اضافه می‌نمایند
(معمولاً برای نویسه‌های ترکیبی).
.
.
.IP
دستگاه‌های خروجی
.BR utf8 ،
.BR html
و
.B xhtml
از این دستورالعمل استفاده می‌کنند.
.
.
.TP
.BI unitwidth\~ n
پایه اختیاری که متریک‌های قلم هنگام رندر کردن گلیف‌ها در اندازه حروفچینیِ یک پوینت، متناسب با آن مقیاس‌بندی می‌شوند.
.
.
.TP
.B unscaled_charwidths
وادار کردن ماژول مدیریت قلم به بازگرداندن همیشگی پهنای گلیف بدون مقیاس‌بندی.
.
درایور
.I \%grohtml
از این دستورالعمل استفاده می‌کند.
.
.
.\" XXX: Savannah #63074 is trying to make this obsolescent.
.TP
.B use_charnames_in_special
قالب‌بند
.I \%troff
باید نویسه‌های خاص را در آرگومان‌های ارسالی به دستورات افزونه دستگاه کدگذاری کند.
.
درایور
.I \%grohtml
از این دستورالعمل استفاده می‌کند.
.
.
.TP
.BI vert\~ n
میزان حرکت عمودی برابر با
.IR n \~واحد
پایه است.
.
اندازه‌گیری‌های عمودی به مضارب
.RI از\~ n
گرد می‌شوند.
.
.
.TP
.B charset
این دستورالعمل و بقیه فایل نادیده گرفته می‌شوند.
.
این مورد برای سازگاری با سایر پیاده‌سازی‌های
.I troff
شناخته می‌شود.
.
در
.IR troff \" GNU
گنو، رپرتوار مجموعه نویسه‌ها به ازای هر قلم توصیف می‌شود.
.
.
.P
قالب‌بند
.I \%troff
دستورالعمل‌های
.BR spare1 ،
.BR spare2
و
.BR biggestfont
را شناسایی اما نادیده می‌گیرد.
.
.
.P
خطوط
.BR res ،
.BR unitwidth ،
.BR fonts
و
.B sizes
اجباری هستند.
.
دستورالعمل‌هایی که در بالا ذکر نشده‌اند توسط
.I \%troff
نادیده گرفته می‌شوند اما ممکن است توسط پس‌پردازشگرها برای کسب اطلاعات بیشتر درباره دستگاه مورد استفاده قرار گیرند.
.
.
.\" ====================================================================
.SH "فرمت فایل توصیف قلم (Font description file format)"
.\" ====================================================================
.
در دستگاه‌های خروجی حروفچینی،
هر قلم معمولاً در چندین اندازه در دسترس است.
.
در حالی که اندازه‌گیری‌های کاغذ در فایل توصیف دستگاه در واحدهای مطلق بیان می‌شوند،
اندازه‌گیری‌های مربوط به قلم‌ها باید متناسب با اندازه حروفچینی باشند.
.
مقدار
.I "unit width"
(پهنای واحد) قلم یک مبنای عددی برقرار می‌سازد
که امکان می‌دهد تمامی متریک‌های آن در صورت رندر شدن در اندازه یک پوینت، به صورت اعداد صحیح بیان شوند.
.
هنگامی که قالب‌بند اندازه حروفچینی را پیکربندی می‌کند،
متریک‌ها را به صورت خطی نسبت به آن مبنا مقیاس‌بندی می‌نماید.
.
پهنای واحد هیچ ارتباط ذاتی با تفکیک‌پذیری دستگاه ندارد،
و همین فرایند تقسیم برای تمامی متریک‌های قلم اعمال می‌شود.
.
دقت کنید که هر واحدی برای پهنای واحد انتخاب شود،
عمل تقسیم ناشی از مقیاس‌بندی آن را خنثی کرده و مقداری بدون بُعد بر جای می‌گذارد.
.
.
.P
به عنوان مثال،
دستگاه
.B lbp
در
.I groff
از یک دستورالعمل
.B \%unitwidth
با آرگومان\~800 استفاده می‌کند.
قلم Times roman آن یعنی
.B TR
دارای یک
.B \%spacewidth
برابر با\~833 است؛
این همچنین پهنای ویرگول،
نقطه،
نقطه مرکزی
و علامت ستاره ریاضی آن است،
در حالی که
.RB \[lq] M \[rq]
آن پهنایی برابر با 2,963 دارد.
بنابراین، یک
.RB \[lq] M \[rq]
روی دستگاه
.B lbp
برابر با 2,963 \[tdi] 800 برابر پهنای واحد،
یا تقریباً 3.7 است.
در یک اندازه حروفچینی 10 پوینتی،
یک
.RB \[lq] M \[rq]
قلم Times roman بنابراین 37 واحد پهنا دارد.
.
.
.P
یک فایل توصیف قلم دارای دو بخش است.
.
بخش نخست دنباله‌ای از دستورالعمل‌ها است،
و همانند فایل
.I DESC
که در بالا شرح داده شد، تجزیه می‌شود.
.
به جز نام‌های دستورالعمل‌هایی که بخش دوم را آغاز می‌کنند،
ترتیب قرارگیری آن‌ها اهمیتی ندارد.
.
دستورالعمل‌های بعدی با نام یکسان، موارد قبلی را بازنویسی می‌کنند،
فاصله‌ها و تب‌ها به همان شکل مدیریت می‌شوند،
و ساختار توضیحات یکسانی پشتیبانی می‌گردد.
.
خطوط خالی در سرتاسر فایل نادیده گرفته می‌شوند.
.
.
.TP 8n \" "name F" + 2n
.BI name\~ F
نام قلم برابر با
.I F
است.
.
.RB \[lq] DESC \[rq]
یک نام نامعتبر برای قلم است.
.
اعداد صحیح ساده معتبر هستند،
اما استفاده از آن‌ها توصیه نمی‌شود.
.
(درخواست‌ها و دنباله‌های گریز
.I groff
اعداد صحیح غیرمنفی را در عوض به عنوان موقعیت‌های استقرار تفسیر می‌کنند.
.
علاوه بر این،
قلمی به نام
.RB \[lq] 0 \[rq]
نمی‌تواند به صورت خودکار توسط دستورالعمل
.B fonts
در فایل
.I DESC
مستقر شود.)
.
.
.TP
.BI spacewidth\~  n
پهنای یک فاصله بین کلمات تنظیم‌نشده (unadjusted) برابر با
.IR n
نسبت به پهنای واحد دستگاه است.
.
.
.P
دستورالعمل‌های فوق باید در بخش نخست قرار گیرند؛
موارد زیر اختیاری هستند.
.
.
.TP
.BI slant\~ n
گلیف‌های قلم دارای شیب (slant) به میزان
.IR n \~درجه
هستند؛
یک
.I n
مثبت در جهت جریان متن شیب ایجاد می‌کند.
.
.
.TP
.BI ligatures\~ lig1\~\c
.RI .\|.\|.\&\~ lign\~\c
.RB [ 0 ]
گلیف‌های
.IR lig1 ،
\&.\|.\|.،
.I lign
لیگاتور (حروف متصل / دوحرفی) هستند؛
لیگاتورهای ممکن عبارتند از
.BR f\&f ،
.BR f\&i ،
.BR f\&l ،
.BR f\&f\&i
و
.BR f\&f\&l .
.
برای سازگاری با سایر پیاده‌سازی‌های
.IR troff ،
فهرست لیگاتورها می‌تواند با یک
.RB عدد\~ 0
خاتمه یابد.
.
فهرست لیگاتورها نباید در بیش از یک خط امتداد یابد.
.
.
.TP
.B special
این قلم
.B special
(ویژه) است:
هنگامی که سند تلاش می‌کند گلیفی را قالب‌بندی کند
که در قلمِ فعلیِ انتخاب‌شده در قالب‌بند وجود ندارد،
گلیف در هر قلم مستقرشده‌ای که دارای این ویژگی باشد جستجو می‌شود.
اغلب،
چنین قلم‌هایی
.B unstyled
(بدون سبک) هستند، و فاقد گونه‌های پررنگ (bold) یا شیب‌دار
(italic یا oblique)
می‌باشند.
.
.
.P
سایر دستورالعمل‌ها در این بخش توسط
.IR troff \" GNU
گنو نادیده گرفته می‌شوند،
اما ممکن است توسط پس‌پردازشگرها برای دریافت اطلاعات بیشتر در مورد قلم استفاده شوند.
.
.
.P
بخش دوم شامل یک تا سه زیربخش است،
که می‌توانند با هر ترتیبی بیایند،
و هر کدام از آن‌ها می‌تواند بخش دوم را آغاز کند.
.
هر یک با دستورالعملی در یک خط مجزا آغاز می‌شود.
.
یک زیربخش
.B charset
اجباری است مگر اینکه فایل
.I DESC
مربوطه حاوی دستورالعمل
.B \%unicode
باشد.
.
زیربخش دیگر،
.BR \%kernpairs ،
اختیاری است.
.
.
.P
دستورالعمل
.B charset
زیربخش مجموعه نویسه‌ها را آغاز می‌کند.
.
(در دستگاه‌های حروفچینی،
این دستورالعمل نام‌گذاری نادرستی دارد زیرا فهرستی از گلیف‌ها را آغاز می‌کند،
نه نویسه‌ها.)
.
این دستورالعمل پیش از مجموعه‌ای از توصیف‌های گلیف،
یک گلیف در هر خط قرار می‌گیرد.
.
هر توصیف گلیف شامل مجموعه‌ای از فیلدها است که با فاصله یا تب از یکدیگر جدا شده و به صورت زیر سازمان‌دهی می‌شوند.
.
.
.IP
.I name metrics type index
.RI [ entity-name ]
.RB [ --
.IR comment ]
.
.
.P
فیلد
.I name
گلیف را مشخص می‌کند:
یک
.RI نویسه\~ c
قابل چاپ با نویسه معمولی
.RI \~ c
در
.I troff
مطابقت دارد،
و یک دنباله چندنویسه‌ای که با
.B \[rs]
شروع نمی‌شود، با دنباله گریز نویسه خاص
.I troff
گنو
\[lq]\c
.BI \[rs][ name ]\c
\[rq]
مطابقت دارد.
.
نامی متشکل از سه علامت منفی،
.RB \[lq] --- \[rq]،
نشان می‌دهد که گلیف بی‌نام است:
به چنین گلیف‌هایی فقط از طریق دنباله گریز
.B \[rs]N
در
.IR troff
می‌توان دسترسی پیدا کرد.
.
یک نویسه خاص با نام
.RB \[lq] --- \[rq]
هنوز هم می‌تواند با استفاده از
.B .char
و درخواست‌های مشابه تعریف شود.
.
مقدار
.I name
به صورت
.RB \[lq] \[rs]\- \[rq]
گلیف علامت منها را تعریف می‌کند.
.
.\" TODO: Withdraw support for this.  No one seems to use it.
در نهایت،
.I name
می‌تواند دنباله‌های گریز حرکت افقی
.B \[rs]|
و
.B \[rs]\[ha]
(به ترتیب فاصله‌های \[lq]نازک (thin)\[rq] و \[lq]مویی (hair)\[rq])
باشد، که در این حالت تنها متریک پهنا که در زیر شرح داده شده اعمال می‌شود؛
بنابراین یک قلم می‌تواند پهنای این فاصله‌ها را سفارشی‌سازی کند.
.\" XXX: For exhaustivity purposes...you can define "\whatever", which
.\" has to be accessed with \C'\\whatever' or \[\\whatever], but the
.\" parser matches predefined escape sequences before looking up special
.\" characters.  Most such definitions are inaccessible from the
.\" language, because nearly every '\x', where 'x' is a Unicode basic
.\" Latin character, is a predefined groff escape sequence.
.
.
.br
.ne 4v \" Keep next paragraph together with (possibly 2-line) synopsis.
.P
ساختار فیلد
.I metrics
به صورت زیر است
(در یک خط؛
در اینجا برای خوانایی شکسته شده است).
.
.
.IP
.\" XXX: Turning off adjustment is ugly; thanks to meter-long specimens
.\" like this, we need an escape sequence that selectively disables
.\" adjustment at the end of a word.
.na
.I width\/\c
.RI [\fB,\fP[ \:height\/\c
.RI [\fB,\fP[ \:depth\/\c
.RI [\fB,\fP[ \:\%italic-correction\/\c
.RI [\fB,\fP[ \:\%left-italic-correction\/\c
.RI [\fB,\fP[ \:\%subscript-correction ]]]]]]]]]]
.\" XXX: cringe
.ie d AD .ad \*[AD]
.el      .ad b
.
.
.P
فاصله‌ها،
تب‌ها
و خطوط جدید میان این
.I زیرفیلدها،
که به صورت اعداد صحیح ده‌دهی بیان می‌شوند، ممنوع است.
.
واحد اندازه‌گیری همان واحد تعیین‌شده توسط دستورالعمل
.B \%unitwidth
است و بر اساس اندازه حروفچینی مقیاس‌بندی می‌شود.
.
زیرفیلدهای نامشخص به طور پیش‌فرض\~0 هستند.
.
از آنجا که فرمت باینری مرتبطی وجود ندارد،
نیازی نیست این مقادیر مانند
.IR troff \" AT&T
مستقل از دستگاه AT&T در نوع داده زبان سی
.I char
بگنجند.
.
.
.P
زیرفیلد
.I width
پهنای گلیف را مشخص می‌کند.
.
زیرفیلد
.I height
ارتفاع گلیف را مشخص می‌کند
(رو به بالا مثبت است)؛
اگر یک گلیف فراتر از خط پایه امتداد نیابد،
به آن ارتفاع صفر بدهید،
نه یک ارتفاع منفی.
.
زیرفیلد
.I depth
عمق گلیف را مشخص می‌کند\[em]\c
یعنی
فاصله‌ای زیر خط پایه که گلیف تا آن امتداد می‌یابد
(رو به پایین مثبت است)؛
اگر گلیف به زیر خط پایه امتداد نیابد،
به آن عمق صفر بدهید،
نه یک عمق منفی.
.
تصحیح‌های خوابیده (italic corrections) زمانی اعمال می‌شوند که سبک‌های عمودی (upright) و شیب‌دار
(italic یا oblique)
در کنار یکدیگر حروفچینی شوند.
.
مقدار
.I italic-correction
میزان فاصله‌ای است که باید پس از یک گلیف شیب‌دار
که بلافاصله با یک گلیف عمودی دنبال می‌شود، اضافه گردد.
.
مقدار
.I left-italic-correction
میزان فاصله‌ای است که باید پیش از یک گلیف شیب‌دار
که بلافاصله قبل از آن یک گلیف عمودی قرار دارد، اضافه گردد.
.
مقدار
.I
subscript-correction
میزان فاصله‌ای است که باید پس از یک گلیف شیب‌دار
که با یک زیرنویس دنبال می‌شود، اضافه گردد؛
این مقدار باید کمتر از تصحیح خوابیده (italic correction) باشد.
.
.
.P
برای قلم‌های مورداستفاده با دستگاه‌های حروفچینی،
فیلد
.I type
توصیفی از ویژگی‌های ساختاری گلیف ارائه می‌دهد:
این یک ماسک بیتی (bit mask) است که ثبت می‌کند آیا گلیف یک بالاآمده (ascender)،
پایین‌آمده (descender)،
هر دو،
یا هیچ‌کدام است.
.
هنگامی که یک دنباله گریز
.B \[rs]w
درون‌یابی می‌شود،
این مقادیر برای هر گلیف به صورت بیتی OR می‌شوند
و در ثبات
.B ct
ذخیره می‌گردند.
.
در توصیف‌های قلم برای ترمینال‌ها،
تمامی گلیف‌ها صرف‌نظر از ظاهرشان ممکن است مقداری برابر با صفر داشته باشند.
.
.
.TP
0
بدین معناست که گلیف به طور کامل میان خط پایه و
یک خط افقی در \[lq]x-height\[rq] قلم قرار می‌گیرد،
مانند \[lq]a\[rq]،
\[lq]c\[rq]
و
\[lq]x\[rq]؛
.
.
.TP
1
بدین معناست که گلیف به زیر خط پایه فرود می‌آید،
مانند \[lq]p\[rq]؛
.
.
.TP
2
بدین معناست که گلیف به بالای x-height قلم صعود می‌کند،
مانند \[lq]A\[rq] یا
\[lq]b\[rq]؛
و
.
.
.TP
3
بدین معناست که گلیف هم بالاآمده و هم پایین‌آمده است\[em]این در مورد پرانتزها در برخی قلم‌ها صدق می‌کند.
.
.
.P
فیلد
.I index
یک عدد صحیح است که گلیف را به صورت یکتا در قلم مشخص می‌سازد؛
هر عدد صحیحی به عنوان ورودی پذیرفته می‌شود،
(یعنی
هر عدد صحیحی که توسط تابع
.MR strtol 3
کتابخانه استاندارد زبان C قابل تجزیه باشد)
اما هیچ قلم کاربردی از تمام مقادیر ممکن استفاده نمی‌کند.
.
یک
.I index
محدود به دامنه نوع داده
.IR int
زبان C در سیستم است.
.
در یک سند
.IR troff ،
از دنباله گریز نویسه نمایه‌گذاری‌شده
.B \[rs]N
برای تعیین یک گلیف از طریق نمایه آن استفاده کنید.
.
.
.P
فیلد
.I entity-name
شناسه‌ای را برای گلیف تعریف می‌کند که پس‌پردازشگر از آن برای چاپ نام گلیف
.IR name
در
.I \%troff
استفاده می‌کند.
.
این فیلد اختیاری است؛
این فیلد معرفی شد تا درایور خروجی
.I \%grohtml
بتواند مجموعه نویسه‌های خود را کدگذاری کند.
.
به عنوان مثال،
گلیف
.B \[rs][Po]
در HTML 4.0 با
.RB \[lq] &pound; \[rq]
نمایش داده می‌شود.
.
برای کارایی بیشتر،
این داده‌ها اکنون مستقیماً درون
.I \%grohtml
کامپایل شده‌اند.
.
ابزار
.I grops
از این فیلد برای ساخت آرایه‌های زیرکدگذاری برای قلم‌های PostScript حاوی بیش از ۲۵۶ گلیف استفاده می‌کند.
.
.
.P
هر چیزی در خط پس از فیلد
.I entity-name
یا
.RB \[lq] -- \[rq]
نادیده گرفته می‌شود.
.
هنگامی که
.I afmtodit
فایل‌های توصیف قلم را برای
.MR gropdf 1
و
.MR grops 1
تولید می‌کند،
کد UTF-16 نویسه را در فیلد توضیح (comment) می‌نویسد.
.
.
.P
یک خط در بخش
.B charset
همچنین می‌تواند شکلی به صورت
.
.RS
.IB name\~ \[dq]
.RE
.
داشته باشد که
.I name
را به عنوان نام دیگری برای گلیف ذکرشده در خط پیشین مشخص می‌کند.
.
چنین نام‌های مستعاری می‌توانند زنجیره‌ای باشند.
.
.
.P
زیربخش
.B \%charset\-range
مشابه دستورالعمل
.B charset
کار می‌کند با این تفاوت که توصیف‌های گلیف از یک
.I name
به فرم
.BI u AAAA ..u FFFF
استفاده می‌کنند،
که در آن
.I AAAA
و
.I FFFF
دنباله‌هایی از ارقام هگزادسیمال هستند؛
متریک‌های مشخص‌شده سپس به طور یکسان بر تمام گلیف‌های موجود در دامنه تعیین‌شده اعمال می‌شوند.
.
.
.P
دستورالعمل
.B \%kernpairs
فهرستی از تنظیمات فاصله جفت‌حروف (kerning adjustments) را آغاز می‌کند که باید روی جفت گلیف‌های مجاور از این قلم اعمال شود.
.
این بخش شامل دنباله‌ای از خطوط با ساختار زیر است:
.
.RS
.I g1 g2 n
.RE
.
عبارت فوق بدین معناست که وقتی گلیف
.I g1
بلافاصله پیش از
.I g2
حروفچینی می‌شود،
فاصله میان آن‌ها باید
.RI به‌میزان\~ n
افزایش یابد.
.
واحد اندازه‌گیری همان واحد تعیین‌شده توسط دستورالعمل
.B \%unitwidth
است و بر اساس اندازه حروفچینی مقیاس‌بندی می‌شود.
.
بیشتر جفت‌های کرنینگ باید مقداری منفی
.RI برای\~ n
داشته باشند.
.\" END Keep parallel with groff.texi node "Device and Font Description
.\" Files".
.
.
.br
.ne 4v
.\" ====================================================================
.SH "فایل‌ها (FILES)"
.\" ====================================================================
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%dev name /\:DESC
دستگاه خروجی
.IR name
را توصیف می‌کند.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%dev name / F
قلم شناخته‌شده با نام
.I F
روی دستگاه
.IR name
را توصیف می‌کند.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.IR "Groff: The GNU Implementation of troff" ،
نوشته Trent A.\& Fisher و Werner Lemberg،
راهنمای اصلی
.I groff
است.
.
می‌توانید آن را به صورت تعاملی با دستور \[lq]info groff\[rq] مرور کنید.
.
.
.P
\[lq]Troff User's Manual\[rq]
نوشته Joseph F.\& Ossanna،
۱۹۷۶
(بازبینی‌شده توسط Brian W.\& Kernighan،
۱۹۹۲)،
گزارش فنی علوم رایانه شماره ۵۴ آزمایشگاه‌های بل AT&T،
که به طور گسترده به سادگی \[lq]CSTR\~#54\[rq] نامیده می‌شود،
زبان، فرمت‌های فایل توصیف دستگاه و قلم، و زبان مستقل از دستگاه شرح صفحه را که در مستندات
.I groff
به مجموع آن‌ها
.RI \[lq]AT&T\~ troff \[rq]
گفته می‌شود، مستند می‌کند.
.
.
.P
\[lq]A Typesetter-independent TROFF\[rq]
نوشته Brian W.\& Kernighan،
۱۹۸۲،
گزارش فنی علوم رایانه شماره ۹۷ آزمایشگاه‌های بل AT&T،
دیدگاه‌های بیشتری در مورد فرمت‌های فایل توصیف قلم و دستگاه و زبان مستقل از دستگاه شرح صفحه ارائه می‌دهد.
.
.
.P
.MR groff 1 ،
زیربخش \[lq]Utilities\[rq]،
برنامه‌های موجود برای توصیف قلم‌ها در فرمت‌های گوناگون را فهرست می‌کند به گونه‌ای که درایورهای خروجی
.I groff
بتوانند از آن‌ها استفاده نمایند.
.
.
.P
.MR \%troff 1
مسیر پیش‌فرض جستجوی فایل‌های توصیف دستگاه و قلم را مستند می‌کند.
.
.
.P
.MR groff_out 5 ،
.MR addftinfo 1
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_groff_font_5_man_C]
.do rr *groff_groff_font_5_man_C
.
.
.\" Local Variables:
.\" fill-column: 72
.\" mode: nroff
.\" End:
.\" vim: set filetype=groff textwidth=72:
