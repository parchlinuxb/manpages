\fBRPMTRANS_FLAG_NODOCS\fP
T}
_
T{
\fBjustdb\fP
T}	T{
\fBRPMTRANS_FLAG_JUSTDB\fP
T}
_
T{
\fBnocontexts\fP
T}	T{
\fBRPMTRANS_FLAG_NOCONTEXTS\fP
T}
_
T{
\fBnocaps\fP
T}	T{
\fBRPMTRANS_FLAG_NOCAPS\fP
T}
_
T{
\fBnocrypto\fP
