fangsong        genericfamily   13
    
.fi
.SS "<OR>, <AND>, <PLUS>, <MINUS>, <TIMES>, <DIVIDE>"
.PP
این عناصر عملیات مشخص‌شده را روی فهرستی از عناصر عبارت انجام می‌دهند. عناصر <or> و <and> منطقی (بولی) هستند، نه بیتی.
.SS "<EQ>, <NOT_EQ>, <LESS>, <LESS_EQ>, <MORE>, <MORE_EQ>, <CONTAINS>, <NOT_CONTAINS>"
.PP
این عناصر دو مقدار را با یکدیگر مقایسه کرده و یک نتیجه بولی تولید می‌کنند.
.SS "<NOT>"
.PP
ارزش بولی تک‌عنصر عبارت خود را معکوس می‌کند.
.SS "<IF>"
.PP
این عنصر سه عنصر عبارت را می‌گیرد؛ اگر مقدار اولی true باشد، مقدار دومی را تولید می‌کند، در غیر این صورت مقدار سومی را بازمی‌گرداند.
.SS "<ALIAS>"
.PP
عناصر alias نماد خلاصه‌شده‌ای برای مجموعه‌ای از عملیات تطبیق رایج جهت جایگزینی یک خانواده قلم با خانواده دیگر ارائه می‌دهند. آن‌ها شامل یک عنصر <family> و به دنبال آن عناصر اختیاری <prefer>، <accept> و <default> هستند. قلم‌های منطبق با عنصر <family> طوری ویرایش می‌شوند که فهرست خانواده‌های <prefer> پیش از <family> منطبق اضافه شده، خانواده‌های <accept> بعد از <family> منطبق درج گردند و خانواده‌های <default> به انتهای فهرست خانواده اضافه شوند.
.SS "<FAMILY>"
.PP
یک نام منفرد از خانواده قلم را نگه می‌دارد.
.SS "<PREFER>, <ACCEPT>, <DEFAULT>"
.PP
این عناصر فهرستی از عناصر <family> را برای استفاده توسط عنصر <alias> نگهداری می‌کنند.
.SH "مثال‌ها (EXAMPLES)"
.SS "پرونده پیکربندی سامانه (SYSTEM CONFIGURATION FILE)"
.PP
این نمونه‌ای از یک پرونده پیکربندی سراسری در سطح سامانه است:

.nf
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- پرونده /etc/fonts/fonts.conf برای پیکربندی دسترسی به قلم‌های سامانه -->
<fontconfig>
  <!--
    یافتن قلم‌ها در این شاخه‌ها
  -->
  <dir>/usr/share/fonts</dir>
  <dir>/usr/X11R6/lib/X11/fonts</dir>

  <!--
    پذیرش نام مستعار منسوخ 'mono' و جایگزینی آن با 'monospace'
  -->
  <match target="pattern">
    <test qual="any" name="family">
      <string>mono</string>
    </test>
    <edit name="family" mode="assign">
      <string>monospace</string>
    </edit>
  </match>

  <!--
    اختصاص 'sans-serif' به نام‌هایی که شامل هیچ نام مستعار شناخته‌شده‌ای نیستند
  -->
  <match target="pattern">
    <test qual="all" name="family" compare="not_eq">
      <string>sans-serif</string>
    </test>
    <test qual="all" name="family" compare="not_eq">
      <string>serif</string>
    </test>
    <test qual="all" name="family" compare="not_eq">
      <string>monospace</string>
    </test>
    <edit name="family" mode="append_last">
      <string>sans-serif</string>
    </edit>
  </match>

  <!--
    بارگذاری پرونده سفارشی‌سازی کاربر، بدون خطا در صورت عدم وجود
  -->
  <include ignore_missing="yes" prefix="xdg">
    fontconfig/fonts.conf
  </include>

  <!--
    بارگذاری پرونده‌های سفارشی‌سازی محلی، بدون خطا در صورت عدم وجود
  -->
  <include ignore_missing="yes">conf.d</include>
  <include ignore_missing="yes">local.conf</include>

  <!--
    نام مستعار قلم‌های شناخته‌شده به قلم‌های موجود TrueType.
    این جایگزینی چهره‌های TrueType به جای Type1 مشابه ظاهر صفحه را بهبود می‌بخشد.
  -->
  <alias>
    <family>Times</family>
    <prefer>
      <family>Times New Roman</family>
    </prefer>
    <default>
      <family>serif</family>
    </default>
  </alias>
  <alias>
    <family>Helvetica</family>
    <prefer>
      <family>Arial</family>
    </prefer>
    <default>
      <family>sans-serif</family>
    </default>
  </alias>
  <alias>
    <family>Courier</family>
    <prefer>
      <family>Courier New</family>
    </prefer>
    <default>
      <family>monospace</family>
    </default>
  </alias>

  <!--
    ارائه نام‌های مستعار لازم برای نام‌های استاندارد.
    این کار پس از پرونده پیکربندی کاربر انجام می‌شود تا نام‌های مستعار کاربر در اولویت باشند.
  -->
  <alias>
    <family>serif</family>
    <prefer>
      <family>Times New Roman</family>
    </prefer>
  </alias>
  <alias>
    <family>sans-serif</family>
    <prefer>
      <family>Arial</family>
    </prefer>
  </alias>
  <alias>
    <family>monospace</family>
    <prefer>
      <family>Andale Mono</family>
    </prefer>
  </alias>

  <!--
    نمونه‌ای از نیازمندی‌های عملگر OR؛
    اگر 'family' شامل 'Courier New' یا 'Courier' باشد، 'monospace' به عنوان جایگزین افزوده شود
  -->
  <match target="pattern">
    <test name="family" compare="eq">
      <string>Courier New</string>
    </test>
    <edit name="family" mode="prepend">
      <string>monospace</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family" compare="eq">
      <string>Courier</string>
    </test>
    <edit name="family" mode="prepend">
      <string>monospace</string>
    </edit>
  </match>

</fontconfig>
    
.fi
.SS "پرونده پیکربندی کاربر (USER CONFIGURATION FILE)"
.PP
این نمونه‌ای از پرونده پیکربندی برای هر کاربر است که در $XDG_CONFIG_HOME/fontconfig/fonts.conf قرار می‌گیرد:

.nf
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  پرونده $XDG_CONFIG_HOME/fontconfig/fonts.conf برای پیکربندی قلم کاربر
-->
<fontconfig>

  <!--
    شاخه اختصاصی قلم‌ها
  -->
  <dir prefix="xdg">fonts</dir>

  <!--
    استفاده از ترتیب زیرپیکسل rgb برای بهبود ظاهر گلیف‌ها در نمایشگرهای LCD.
    تغییراتی که روی رندر اثر می‌گذارند نه تطبیق، همیشه باید از target="font" استفاده کنند.
  -->
  <match target="font">
    <edit name="rgba" mode="assign">
      <const>rgb</const>
    </edit>
  </match>
  <!--
    استفاده از قلم WenQuanYi Zen Hei هنگامی که برای زبان چینی serif درخواست می‌شود
  -->
  <match>
    <!--
      اگر نمی‌خواهید از قلم WenQuanYi Zen Hei برای zh-tw و غیره استفاده کنید،
      می‌توانید از zh-cn به جای zh استفاده کنید.
      توجه داشته باشید حتی اگر zh-cn را تنظیم کنید، باز هم با zh تطبیق داده می‌شود.
      اگر مایل به این رفتار نیستید، می‌توانید از compare="eq" به جای compare="contains" استفاده کنید.
    -->
    <test name="lang" compare="contains">
      <string>zh</string>
    </test>
    <test name="family">
      <string>serif</string>
    </test>
    <edit name="family" mode="prepend">
      <string>WenQuanYi Zen Hei</string>
    </edit>
  </match>
  <!--
    استفاده از قلم VL Gothic هنگامی که برای زبان ژاپنی sans-serif درخواست می‌شود
  -->
  <match>
    <test name="lang" compare="contains">
      <string>ja</string>
    </test>
    <test name="family">
      <string>sans-serif</string>
    </test>
    <edit name="family" mode="prepend">
      <string>VL Gothic</string>
    </edit>
  </match>
</fontconfig>
    
.fi
.SH "فایل‌ها (FILES)"
.PP
\fBfonts.conf\fR
شامل اطلاعات پیکربندی کتابخانه fontconfig است که از شاخه‌های مورد جستجو برای یافتن اطلاعات قلم و همچنین دستورالعمل‌های ویرایش الگوهای مشخص‌شده توسط برنامه قبل از تطبیق با قلم‌های موجود تشکیل شده است. این پرونده در قالب XML است.
.PP
\fBconf.d\fR
نام مرسوم برای شاخه‌ای از پرونده‌های پیکربندی اضافی است که توسط برنامه‌های خارجی یا مدیر محلی سامانه مدیریت می‌شوند. نام پرونده‌هایی که با ارقام ده‌دهی آغاز می‌شوند به ترتیب واژگانی مرتب شده و به عنوان پرونده‌های پیکربندی اضافی استفاده می‌شوند. تمام این پرونده‌ها در قالب XML هستند. پرونده اصلی fonts.conf از طریق یک دستور <include> به این شاخه ارجاع می‌دهد.
.PP
\fBfonts.dtd\fR
یک DTD است که قالب پرونده‌های پیکربندی را توصیف می‌کند.
.PP
\fB$XDG_CONFIG_HOME/fontconfig/conf.d\fR و \fB~/.fonts.conf.d\fR
نام‌های مرسوم برای شاخه پیکربندی‌های اختصاصی هر کاربر (معمولاً تولیدشده به صورت خودکار) هستند، اگرچه مکان واقعی در پرونده سراسری fonts.conf مشخص می‌شود. لطفاً توجه داشته باشید که ~/.fonts.conf.d اکنون منسوخ شده است و در نسخه‌های آینده به طور پیش‌فرض خوانده نخواهد شد.
.PP
\fB$XDG_CONFIG_HOME/fontconfig/fonts.conf\fR و \fB~/.fonts.conf\fR
مکان مرسوم برای پیکربندی قلم اختصاصی هر کاربر هستند، اگرچه مکان واقعی در پرونده سراسری fonts.conf مشخص می‌شود. لطفاً توجه داشته باشید که ~/.fonts.conf اکنون منسوخ شده است و در نسخه‌های آینده به طور پیش‌فرض خوانده نخواهد شد.
.PP
\fB$XDG_CACHE_HOME/fontconfig/*.cache-*\fR و \fB~/.fontconfig/*.cache-*\fR
مخزن مرسوم اطلاعات قلم است که در حافظه پنهان مربوط به هر شاخه یافت نمی‌شود. این پرونده به صورت خودکار توسط fontconfig نگهداری می‌شود. لطفاً توجه داشته باشید که ~/.fontconfig/*.cache-* اکنون منسوخ شده است و در نسخه‌های آینده به طور پیش‌فرض خوانده نخواهد شد.
.SH "محیط (ENVIRONMENT)"
.PP
\fBFONTCONFIG_FILE\fR
برای بازنویسی و تغییر پرونده پیکربندی پیش‌فرض استفاده می‌شود.
.PP
\fBFONTCONFIG_PATH\fR
برای بازنویسی و تغییر شاخه پیکربندی پیش‌فرض استفاده می‌شود.
.PP
\fBFONTCONFIG_SYSROOT\fR
برای تعیین شاخه ریشه سامانه (sysroot) پیش‌فرض استفاده می‌شود.
.PP
\fBFC_DEBUG\fR
برای خروجی دادن پیام‌های تفصیلی اشکال‌زدایی استفاده می‌شود. برای جزئیات بیشتر به بخش «اشکال‌زدایی برنامه‌ها» مراجعه کنید.
.PP
\fBFC_DBG_MATCH_FILTER\fR
برای فیلتر کردن الگوها استفاده می‌شود. این متغیر فهرستی از نام‌های شیء جدا شده با کاما را دریافت می‌کند و تنها زمانی اثر دارد که FC_DEBUG شامل MATCH2 باشد. برای جزئیات بیشتر به بخش «اشکال‌زدایی برنامه‌ها» مراجعه کنید.
.PP
\fBFC_LANG\fR
برای مشخص کردن زبان پیش‌فرض به عنوان پیوند ضعیف در پرس‌وجو استفاده می‌شود. اگر تنظیم نشده باشد، زبان پیش‌فرض از محلی (locale) جاری سامانه تعیین می‌شود.
.PP
\fBFONTCONFIG_USE_MMAP\fR
برای کنترل استفاده از mmap(2) برای پرونده‌های حافظه پنهان در صورت وجود استفاده می‌شود. این متغیر یک مقدار بولی می‌گیرد. کتابخانه Fontconfig بررسی می‌کند که آیا پرونده‌های حافظه پنهان روی سامانه‌پرونده‌ای ذخیره شده‌اند که استفاده از mmap(2) برای آن امن است یا خیر. تنظیم صریح این متغیر محیطی موجب نادیده گرفتن این بررسی و اجبار به استفاده یا عدم استفاده از mmap(2) می‌شود.
.PP
\fBSOURCE_DATE_EPOCH\fR
برای اطمینان از اینکه fc-cache(1) پرونده‌ها را به صورت قطعی و تکرارپذیر جهت پشتیبانی از ساخت‌های تکرارپذیر (reproducible builds) تولید می‌کند استفاده می‌شود. هنگامی که روی یک نمایش عددی از برچسب زمان یونیکس (UNIX timestamp) تنظیم شود، fontconfig این مقدار را بر استفاده از برچسب‌های زمانی تغییر پرونده‌های ورودی ترجیح می‌دهد تا تشخیص دهد کدام پرونده‌های حافظه پنهان نیاز به بازتولید دارند. اگر SOURCE_DATE_EPOCH تنظیم نشده باشد (یا جدیدتر از mtime شاخه باشد)، رفتار پیشین بدون تغییر باقی می‌ماند.
.PP
\fBFONTCONFIG_WARN_INVALID_ATTRS\fR
برای فعال‌سازی مجدد هشدارهای ویژگی‌های نامعتبر در پرونده‌های پیکربندی استفاده می‌شود.
.SH "همچنین ببینید (SEE ALSO)"
.PP
fc-cat(1), fc-cache(1), fc-list(1), fc-match(1), fc-query(1), SOURCE_DATE_EPOCH <URL:https://reproducible-builds.org/specs/source-date-epoch/>\&.
.SH "نسخه (VERSION)"
.PP
Fontconfig نسخه 2.18.3
