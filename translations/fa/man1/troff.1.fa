.\" called FDL in the main directory of the groff source package.
.
.
.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_troff_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY \%troff
.RB [ \-abcCEiRSUz ]
.RB [ \-d\~\c
.IR ctext ]
.RB [ \-d\~\c
.IB string =\c
.IR text ]
.RB [ \-f\~\c
.IR  font-family ]
.RB [ \-F\~\c
.IR  font-directory ]
.RB [ \-I\~\c
.IR  inclusion-directory ]
.RB [ \-m\~\c
.IR  macro-package ]
.RB [ \-M\~\c
.IR  macro-directory ]
.RB [ \-n\~\c
.IR  page-number ]
.RB [ \-o\~\c
.IR  page-list ]
.RB [ \-r\~\c
.IR  cnumeric-expression ]
.RB [ \-r\~\c
.IB register =\c
.IR numeric-expression ]
.RB [ \-T\~\c
.IR  output-device ]
.RB [ \-w\~\c
.IR  warning-category ]
.RB [ \-W\~\c
.IR  warning-category ]
.RI [ file\~ .\|.\|.]
.YS
.
.
.P
.SY \%troff
.B \-\-help
.YS
.
.
.P
.SY \%troff
.B \-v
.YS
.
.SY \%troff
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
برنامه
GNU
.I troff \" GNU
ورودی زبان
.MR groff 7
را به زبان توصیف صفحه مستقل از دستگاه که جزئیات آن در
.MR groff_out 5
شرح داده شده است، تبدیل می‌کند؛
بنابراین
.I \%troff
قلب سامانه قالب‌بندی اسناد
GNU
.I roff
است.
.
اگر هیچ عملوند
.I فایلی
وجود نداشته باشد،
یا اگر
.I فایل
برابر با
.RB \[lq] \- \[rq]
باشد،
.I \%troff
جریان ورودی استاندارد را می‌خواند.
.
.
.P
برنامه
GNU
.I troff \" GNU
از نظر عملکردی با حروف‌چین
AT&T
.I troff \" AT&T
سازگار است و از قابلیت‌های گسترش‌یافته فراوانی بهره می‌برد.
.
بسیاری از افراد ترجیح می‌دهند از دستور
.MR groff 1
استفاده کنند؛
یک پیشخوان که پیش‌پردازنده‌ها و گرداننده‌های خروجی را به ترتیب مناسب و با گزینه‌های درست اجرا می‌کند.
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
گزینه‌های
.B \-h
و
.B \-\-help
پیام راهنمای استفاده را نمایش می‌دهند،
در حالی که
.B \-v
و
.B \%\-\-version
اطلاعات نگارش را نشان می‌دهند؛
همگی پس از آن خارج می‌شوند.
.
.
.TP 9n \" "-m mac" + 2n + hand-tuned for PDF
.B \-a
یک تقریب متنی ساده از خروجی حروف‌چینی‌شده تولید می‌کند.
.
ثبات فقط‌خواندنی
.B .A
بر روی\~1 تنظیم می‌شود.
.
این گزینه گونه‌ای پیش‌نمایش کلی از خروجی قالب‌بندی‌شده ارائه می‌دهد.
.
.
.RS
.IP \[bu] 3n
شکست‌های صفحه با عبارتی در میان قلاب‌های شکسته مشخص می‌شوند؛
برای مثال،
\[lq]<beginning of page>\[rq].
.
.
.IP \[bu]
خطوط دقیقاً در همان‌جایی که در خروجی قالب‌بندی‌شده شکسته می‌شدند، شکسته می‌شوند.
.
.
.IP \[bu]
حرکت عمودی،
به‌جز آن‌چه از یک شکست خط ناشی می‌شود،
نمایش داده نمی‌شود.
.
.
.IP \[bu]
حرکت افقی با هر اندازه‌ای به صورت یک فاصله نمایش داده می‌شود.
.
حرکت‌های افقی مجاور با یکدیگر ترکیب نمی‌شوند.
.
فاصله تکمیلی بین جملات
(که توسط آرگومان دوم درخواست
.B .ss
پیکربندی می‌شود)
نمایش داده نمی‌شود.
.
.
.IP \[bu]
یک نویسه ویژه به صورت شناسه آن در میان قلاب‌های شکسته نمایش داده می‌شود؛
برای مثال،
یک خط تیره به شکل \[lq]<hy>\[rq] ظاهر می‌شود.
.RE
.
.
.IP
توضیحات بالا نباید به عنوان یک مشخصات رسمی در نظر گرفته شود؛
جزئیات خروجی
.B \-a
ممکن است تغییر یابند.
.
.
.TP
.B \-b
به ازای هر پیام تشخیصی، یک گزارش ردگیری (backtrace) از وضعیت تجزیه‌کننده ورودی
.I \%troff
را در جریان خطای استاندارد می‌نویسد.
.
شماره خطوط ارائه‌شده در گزارش ردگیری ممکن است همیشه درست نباشند،
زیرا تصور
.I \%troff
از شماره خطوط می‌تواند به دلیل درخواست‌هایی که به ماکروها محتوا اضافه می‌کنند، دچار اشتباه شود.
.
.
.TP
.B \-c
غیرفعال کردن خروجی چندرنگ و سلب توانایی درخواست
.RB \[lq] color \[rq]
برای فعال‌سازی آن.
.
.
.TP
.B \-C
فعال کردن حالت سازگاری با
AT&T
.IR troff ؛ \" AT&T
متضمن گزینه
.BR \-c
است.
.
رجوع کنید به
.MR groff_diff 7 .
.
.
.TP
.BI \-d\~ ctext
.TQ
.BI \-d\~ string = text
تعریف رشته
.I roff
با نام
.IR c
یا
.I string
به عنوان
.IR text .
.
شناسه
.IR c
باید یک شناسه تک‌نویسه‌ای باشد؛
.I string
می‌تواند دارای طول دلخواه باشد.
.
چنین تخصیص‌هایی پیش از بارگذاری هر فایل ماکرو،
از جمله فایل راه‌اندازی، انجام می‌شوند.
.
به دلیل محدودیت‌های تابع
.MR getopt_long 3 ،
شناسه
.IR c
نمی‌تواند علامت مساوی باشد،
و
.I string
نیز نمی‌تواند حاوی علامت مساوی باشد،
اگرچه مساوی یک نویسه معتبر در شناسه‌های
.I roff
است.
.
.
.TP
.B \-E
جلوگیری از نمایش پیام‌های خطای
.IR \%troff ؛
متضمن گزینه
.BR \-Ww
است.
.
این گزینه پیام‌های ارسال‌شده به جریان خطای استاندارد توسط اسناد یا بسته‌های ماکرو با استفاده از
.B tm
یا درخواست‌های مرتبط را نادیده
.I نمی‌گیرد
(سرکوب نمی‌کند).
.
.
.TP
.BI \-f\~ fam
استفاده از
.I fam
به عنوان خانواده قلم پیش‌فرض.
.
.
.TP
.BI \-F\~ dir
جستجو در دایرکتوری
.I dir
برای یافتن دایرکتوری فایل‌های توصیف قلم و دستگاه خروجی انتخاب‌شده.
.
برای آگاهی از مکان‌های جستجوی پیش‌فرض و اولویت آن‌ها، به توضیحات
.I GROFF_FONT_PATH
در بخش \[lq]محیط\[rq] در ادامه مراجعه کنید.
.
.
.TP
.B \-i
خواندن جریان ورودی استاندارد پس از آن‌که تمامی فایل‌های ورودی نام‌برده پردازش شدند.
.
.
.TP
.BI \-I\~ dir
جستجو در دایرکتوری
.I dir
برای یافتن فایل‌ها
(فایل‌هایی که در خط فرمان نام برده شده‌اند؛ در درخواست‌های
.BR psbb ،
.BR so
و
.BR soquiet ؛
و در توالی‌های گریز گسترش دستگاه
.RB \[lq] "\[rs]X\[aq]ps: import\[aq]" \[rq]،
.RB \[lq] "\[rs]X\[aq]ps: file\[aq]" \[rq]
و
.RB \[lq] "\[rs]X\[aq]pdf: pdfpic\[aq]" \[rq]).
.
گزینه
.B \-I
می‌تواند بیش از یک بار مشخص شود؛
هر
.I dir
به ترتیب داده‌شده جستجو می‌شود.
.
برای جستجوی دایرکتوری جاری کاری پیش از سایرین،
.RB \[lq] "\-I .\&" \[rq]
را در مکان مورد نظر بیفزایید؛
در غیر این صورت در انتهای جستجو بررسی می‌شود.
.
گزینه
.B \-I
مشابه گزینه \[lq]include\[rq] در کامپایلرهای سی یونیکس عمل کرده و نام آن نیز از همان گرفته شده است.
.
.
.TP
.BI \-m\~ mac
جستجو برای بسته ماکروی
.RI mac .tmac
و خواندن آن پیش از هرگونه ورودی.
.
اگر یافت نشد،
.IR tmac. mac
امتحان می‌شود.
.
برای آگاهی از مکان‌های پیش‌فرض جستجو و ترتیب آن‌ها، به توضیحات
.I GROFF_TMAC_PATH
در بخش \[lq]محیط\[rq] در ادامه مراجعه کنید.
.
.
.TP
.BI \-M\~ dir
جستجو در دایرکتوری
.I dir
برای فایل‌های ماکرو.
.
برای آگاهی از مکان‌های پیش‌فرض جستجو و ترتیب آن‌ها، به توضیحات
.I GROFF_TMAC_PATH
در بخش \[lq]محیط\[rq] در ادامه مراجعه کنید.
.
.
.TP
.BI \-n\~ num
آغاز شماره‌گذاری صفحات از
.IR num .
.
مقدار پیش‌فرض
.RB برابر\~ 1
است.
.
.
.TP
.BI \-o\~ list
تنها خروجی دادن صفحات موجود در
.IR list ،
که فهرستی جداشده با کاما از بازه‌های فراگیر صفحات است؛
.I n
به معنای صفحه
.I n
است،
.IB m \- n
به معنای تمامی صفحات بین
.I m
و
.IR n ،
.BI \- n
به معنای تمامی صفحات تا
.IR n ،
و
.IB n \-
به معنای تمامی صفحات از
.I n
به بعد است.
.
.I \%troff
پس از قالب‌بندی آخرین صفحه فهرست‌شده در
.I list
پردازش را متوقف کرده و خارج می‌شود.
.
.
.TP
.BI \-r\~ cnumeric-expression
.TQ
.BI \-r\~ register = numeric-expression
تعریف ثبات
.I roff
با نام
.IR c
یا
.I register
برابر با
.IR numeric-expression .
.
شناسه
.IR c
باید یک شناسه تک‌نویسه‌ای باشد؛
.I register
می‌تواند طول دلخواه داشته باشد.
.
چنین تخصیص‌هایی پیش از بارگذاری هر فایل ماکرو،
از جمله فایل راه‌اندازی، رخ می‌دهند.
.
به دلیل محدودیت‌های تابع
.MR getopt_long 3 ،
شناسه
.IR c
نمی‌تواند علامت مساوی باشد،
و
.I register
نیز نمی‌تواند حاوی علامت مساوی باشد،
اگرچه مساوی یک نویسه معتبر در شناسه‌های
.I roff
است.
.
.
.TP
.B \-R
جلوگیری از بارگذاری
.I troffrc
و
.IR troffrc\-end ؛
این گزینه می‌تواند برای عیب‌یابی سودمند باشد.
.
.
.TP
.B \-S
فعال کردن حالت امن‌تر و نادیده گرفتن هر گزینه بعدی
.BR \-U .
.
.
.TP
.BI \-T\~ dev
آماده‌سازی خروجی برای دستگاه
.IR dev .
.
پیش‌فرض
.BR \%ps
است؛ رجوع کنید به
.MR groff 1 .
.
.
.TP
.B \-U
کارکرد در
.I حالت ناامن،
که درخواست‌های
.BR cf ،
.BR open ،
.BR opena ،
.BR pi ،
.BR pso
و
.B sy
را فعال می‌کند؛
این درخواست‌ها به طور پیش‌فرض غیرفعال هستند زیرا
به یک سند ورودی غیرقابل اعتماد اجازه می‌دهند دستورات دلخواه را اجرا کند،
محتوای دلخواه را در خروجی
.I troff \" generic
قرار دهد،
یا در فایل‌هایی با نام دلخواه بنویسد.
.
(با این حال، برنامه
GNU
.I troff \" GNU
نویسه خط جدید
(line feed)
را در نام فایل‌هایی که به عنوان آرگومان به درخواست‌ها داده می‌شوند نمی‌پذیرد.)
.\" ...nor other characters invalid as input; Savannah #65108.
.
این گزینه همچنین دایرکتوری جاری را به مسیر جستجوی بسته ماکرو می‌افزاید؛
گزینه‌های
.B \-m
و
.B \-M
در بالا را ببینید.
.
.
.TP
.BI \-w\~ cat
.TQ
.BI \-W\~ cat
به ترتیب، فعال‌سازی و غیرفعال‌سازی هشدارها در رده
.IR cat .
.
به بخش \[lq]هشدارها\[rq] در ادامه مراجعه کنید.
.
.
.TP
.B \-z
جلوگیری از تولید خروجی قالب‌بندی‌شده.
.
.
.\" ====================================================================
.SH "هشدارها (WARNINGS)"
.\" ====================================================================
.
.\" BEGIN Keep parallel with groff.texi node "Warnings".
.\" Caveat: the Texinfo manual sorts them by number, not name.
برنامه
GNU
.I troff \" GNU
پیام‌های تشخیصی هشدار خود را به رده‌های نام‌گذاری‌شده و شماره‌دار تقسیم می‌کند.
.
گزینه‌های
.B \-w
و
.B \-W
از نام‌های مرتبط استفاده می‌کنند.
.
یک توان از ۲ شناسه هر رده را مشخص می‌سازد؛
درخواست
.B warn
و ثبات
.B .warn
به ترتیب مجموع کدهای رده‌های فعال‌شده را تنظیم و گزارش می‌کنند.
.
هشدارهای هر رده در شرایط زیر تولید می‌شوند.
.
.
.P
.TS
tab(@), center, box;
C C  C  | C C  C
R Ri Lb | R Ri Lb.
Bit@Code@Category@Bit@Code@Category
_
0@1@char@10@1024@reg
1@2@\fIunused\fP@11@2048@tab
2@4@break@12@4096@\fIunused\fP
3@8@delim@13@8192@missing
4@16@\fIunused\fP@14@16384@input
5@32@scale@15@32768@escape
6@64@range@16@65536@space
7@128@syntax@17@131072@font
8@256@di@18@262144@ig
9@512@mac@19@524288@color
@@@20@1048576@file
.TE
.\" Give the table bottom extra breathing room on typesetters.
.if t .sp \n[PD]u
.
.
.P
.TS
Lb N Lx.
break	4	T{
یک خط خروجی پرشده (filled) نتوانست به گونه‌ای شکسته شود که طول آن کمتر یا مساوی با طول خط خروجی
.RB \[lq] \[rs]n[.l] \[rq]
باشد،
یا به گونه‌ای تراز شود که طول آن دقیقاً برابر با آن گردد.
.
برنامه
GNU
.I troff \" GNU
میزان سرریز (overset) یا کمبود (underset) را بر حسب واحد مقیاسی که توسط درخواست
.B \%warnscale
پیکربندی شده است در حالت
.B troff \" mode
و بر حسب en
.RB (\[oq] n \[cq]؛
سلول‌های نویسه) در حالت
.B nroff \" mode
گزارش می‌دهد.
.
این رده به طور پیش‌فرض فعال است.
T}
.
.
.sp \n[PD]u
char	1	T{
هیچ نویسه تعریف‌شده توسط کاربر با نام یا نمایه درخواستی وجود ندارد
و هیچ قلم نصب‌شده‌ای گلیفی برای آن تعریف نکرده است،
یا این‌که ورودی نتوانست برای خروجی مستقل از دستگاه کدگذاری شود.
.
این رده به طور پیش‌فرض فعال است.
T}
.
.
.sp \n[PD]u
color	524288	T{
یک نام رنگ تعریف‌نشده انتخاب شده است،
تلاشی برای تعریف یک رنگ با استفاده از یک فضای رنگ ناشناخته انجام شده است،
یک مقدار کانال نامعتبر در یک تعریف رنگ مشاهده شده است،
یا تلاشی برای تعریف مجدد یک رنگ پیش‌فرض صورت گرفته است.
T}
.
.
.sp \n[PD]u
delim	8	T{
نویسه جداکننده انتخاب‌شده مبهم بوده است
زیرا هنگام شروع یک عبارت عددی نیز معنادار است،
یا جداکننده پایانی در یک توالی گریز جا افتاده یا ناهماهنگ بوده است.
.
.
.sp \n[PD]u
انتشارهای آینده
.I groff
ممکن است جداکننده‌های مبهم را رد کنند.
.
در حالت سازگاری،
جداکننده‌های مبهم بدون هشدار پذیرفته می‌شوند.
T}
.
.
.sp \n[PD]u
di	256	T{
یک درخواست
.BR di ،
.BR da ،
.BR box
یا
.B boxa
بدون آرگومان فراخوانی شده است در حالی که هیچ انحراف (diversion) جاری وجود نداشته است.
T}
.
.
.\" .TP
.\" .BR el "\t16"
.\" The
.\" .B el
.\" request was encountered with no prior corresponding
.\" .B ie
.\" request.
.
.
.sp \n[PD]u
escape	32768	T{
یک توالی گریز پشتیبانی‌نشده مشاهده شده است.
T}
.
.
.sp \n[PD]u
file	1048576	T{
تلاشی برای خواندن فایلی که وجود ندارد صورت گرفته است،
یا یک جریان در هنگام خروج قالب‌بند باز باقی مانده است.
.
این رده به طور پیش‌فرض فعال است.
T}
.
.
.sp \n[PD]u
font	131072	T{
یک قلم ناموجود انتخاب شده است.
.
این رده به طور پیش‌فرض فعال است.
T}
.
.
.sp \n[PD]u
ig	262144	T{
یک توالی گریز نامعتبر در ورودی نادیده‌گرفته‌شده با استفاده از درخواست
.B ig
رخ داده است.
.
این رده هشدار وضعیتی را تشخیص می‌دهد که در ورودی عادی یک خطا محسوب می‌شود.
T}
.
.
.sp \n[PD]u
input	16384	T{
یک نویسه نامعتبر در جریان ورودی رخ داده است.
T}
.
.
.sp \n[PD]u
mac	512	T{
یک رشته،
ماکرو،
یا انحراف (diversion) تعریف‌نشده استفاده شده است.
.
هنگامی که به چنین شیئی ارجاع داده می‌شود،
یک نمونه خالی از آن نام به طور خودکار ایجاد می‌گردد.
.
بنابراین،
مگر این‌که بعداً حذف شود،
.I \%troff
برای هر کدام حداکثر یک هشدار صادر می‌کند.
.
.
.sp \n[PD]u
برنامه
.I \%troff
همچنین از این رده برای هشدار در مورد تلاش جهت جابجایی یک ماکروی تله (trap macro) کارگذاشته‌نشده استفاده می‌کند.
.
در چنین مواردی،
به ماکروی کارگذاشته‌نشده
.I ارجاعی
داده نمی‌شود،
بنابراین در صورت عدم وجود، ایجاد نخواهد شد.
T}
.
.
.sp \n[PD]u
missing	8192	T{
یک درخواست با غیبت آرگومان اجباری فراخوانی شده است.
T}
.
.
.\" .sp \n[PD]u
.\" number	2	T{
.\" An invalid numeric expression was encountered.
.\" .
.\" This category is enabled by default.
.\" T}
.
.
.sp \n[PD]u
range	64	T{
یک عبارت عددی خارج از محدوده مجاز برای زمینه کاربرد خود بوده است.
T}
.
.
.sp \n[PD]u
reg	1024	T{
یک ثبات تعریف‌نشده استفاده شده است.
.
هنگامی که به یک ثبات تعریف‌نشده ارجاع داده می‌شود،
قالب‌بند به طور خودکار آن را با مقدار\~0 تعریف می‌کند.
.
بنابراین،
مگر این‌که بعداً حذف شود،
برنامه
GNU
.I troff \" GNU
برای هر کدام حداکثر یک هشدار صادر می‌کند.
T}
.
.
.\" .sp \n[PD]u
.\" right\-brace	4096	T{
.\" A right brace escape sequence
.\" .B \[rs]}
.\" was encountered where a number was expected.
.\" T}
.
.
.sp \n[PD]u
scale	32	T{
یک واحد مقیاس نامناسب برای زمینه کاربرد آن در یک عبارت عددی استفاده شده است.
T}
.
.
.sp \n[PD]u
space	65536	T{
یک فاصله بین یک درخواست یا ماکرو و آرگومان آن جا افتاده است.
.
این هشدار هنگامی تولید می‌شود که یک نام تعریف‌نشده طولانی‌تر از دو نویسه مشاهده شود و دو نویسه نخست آن نام تشکیل‌دهنده یک نام تعریف‌شده باشند.
.
هیچ درخواستی اجرا نمی‌شود،
هیچ ماکرویی فراخوانی نمی‌گردد،
و ماکروی خالی نیز تعریف نمی‌شود.
.
این رده به طور پیش‌فرض فعال است.
.
این مورد هرگز در حالت سازگاری رخ نمی‌دهد.
T}
.
.
.sp \n[PD]u
syntax	128	T{
یک حالت خط‌فاصله‌گذاری (hyphenation) خودمتناقض یا پرچم‌های نویسه متعارض درخواست شده است؛
یک عبارت عددی خالی یا ناقص مشاهده شده است؛
یک عملوند برای عملگر عددی جا افتاده است؛
تلاشی برای قالب‌بندی نویسه‌ها یا فاصله‌ها در یک خط ورودی پس از توالی گریز ادامه‌دهنده خط خروجی صورت گرفته است؛
یک توالی گریز شناخته‌شده اما نامناسب
یا کد نویسه غیرقابل‌چاپ
در یک دستور گسترش دستگاه استفاده شده است؛
تلاشی برای تعریف یک رده نویسه بازگشتی،
خالی،
یا بی‌معنی انجام شده است؛
یا یک توالی گریز افزوده
.I groff
یا عملگر عبارات شرطی در هنگام فعال بودن حالت سازگاری به کار رفته است.
T}
.
.
.sp \n[PD]u
tab	2048	T{
یک نویسه تب (tab)
در یک توالی گریز پارامتریک،
در یک آرگومان ماکروی درون گیومه قرار نگرفته،
یا در جایی که یک درخواست انتظار یک آرگومان عبارت عددی را داشته، ظاهر شده است.
T}
.TE
.
.
.P
دو نام هشدار به جهت سهولت، سایر رده‌های هشدار را گروه‌بندی می‌کنند.
.
.
.TP
.B all
تمامی رده‌های هشدار به جز
.BR di ،
.BR mac
و
.BR reg .
.
این گزینه اختصاری برای تولید تمامی هشدارهایی در نظر گرفته شده است که همراه با بسته‌های ماکرو و اسناد نوشته‌شده برای
AT&T
.I troff \" AT&T
و نسل‌های بعدی آن سودمند هستند،
که تشخیص‌های کم‌وسواس‌تری نسبت به
GNU
.IR troff دارند. \" GNU
.
.
.TP
.B w
تمامی رده‌های هشدار.
.
به نویسندگان اسناد و بسته‌های ماکرو که
.I groff
را هدف قرار می‌دهند توصیه می‌شود از این تنظیم استفاده کنند.
.\" END Keep parallel with groff.texi node "Warnings".
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
برنامه
.I \%troff
در صورت اجرای موفق با
.RB وضعیت\~ 0 ،
چنانچه نتواند آرگومان‌های خط فرمان خود را تفسیر کند با
.RB وضعیت\~ 2 ،
و در صورتی که در حین اجرا با خطایی مهلک مواجه شود یا ورودی دستور توقف به آن دهد با
.RB وضعیت\~ 1
خارج می‌شود.
.
.
.\" ====================================================================
.SH "محیط (ENVIRONMENT)"
.\" ====================================================================
.
متغیرهای
.I GROFF_FONT_PATH
و
.I GROFF_TMAC_PATH
هر کدام یک مسیر جستجو از دایرکتوری‌ها را می‌پذیرند؛
بدین معنا که،
فهرستی از نام‌های دایرکتوری هستند که با نویسه جداکننده مؤلفه‌های مسیر در سیستم جدا شده‌اند.
.
در سیستم‌های یونیکس،
این نویسه دو‌نقطه (:) است؛
در سیستم‌های ویندوز،
نقطه-ویرگول (;) است.
.
.
.TP
.I GROFF_FONT_PATH
فهرستی از دایرکتوری‌ها که در آن‌ها دایرکتوری فایل‌های توصیف قلم و دستگاه خروجی انتخاب‌شده جستجو می‌شود.
.
برنامه
.I \%troff
دایرکتوری‌های ارائه‌شده به عنوان آرگومان برای هر گزینه
.B \-F
مشخص‌شده را پیش از این‌ها پیمایش می‌کند،
و سپس یک دایرکتوری ویژه سایت
.RI ( /usr/\:\%share/\:\%groff/\:\%site\-font )،
یک مکان استاندارد
.RI ( /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font )
و یک دایرکتوری سازگاری
.RI ( /usr/\:\%lib/\:\%font )
را پس از آن‌ها بررسی می‌نماید.
.
.
.TP
.I GROFF_TMAC_PATH
فهرستی از دایرکتوری‌ها برای جستجوی فایل‌های ماکرو.
.
برنامه
.I \%troff
دایرکتوری‌های ارائه‌شده به عنوان آرگومان برای هر گزینه
.B \-M
مشخص‌شده را پیش از این‌ها پیمایش می‌کند،
سپس دایرکتوری جاری
(تنها در صورت فعال بودن حالت ناامن)،
دایرکتوری خانگی کاربر،
.if !'no'no' \{\
یک دایرکتوری ویژه بستر
.RI ( /usr/\:\%lib/\:\%groff/\:\%site\-tmac )،
.\}
یک دایرکتوری ویژه سایت
.RI ( /usr/\:\%share/\:\%groff/\:\%site\-tmac )
و یک مکان استاندارد
.RI ( /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%tmac )
را پس از آن‌ها جستجو می‌کند.
.
.
.TP
.I GROFF_TYPESETTER
تنظیم دستگاه خروجی پیش‌فرض.
.
اگر خالی باشد یا تنظیم نشده باشد، از
.B \%ps
استفاده می‌شود.
.
گزینه
.B \-T
بر
.I \%GROFF_TYPESETTER
ارجحیت دارد.
.
.
.TP
.I SOURCE_DATE_EPOCH
برچسب زمانی
(بیان‌شده به صورت ثانیه‌های سپری‌شده از مبدأ زمانی یونیکس)
برای استفاده به عنوان برچسب زمان ایجاد خروجی به جای زمان جاری.
.
این زمان در هنگام راه‌اندازی قالب‌بند با استفاده از
.MR gmtime 3
و
.MR asctime 3
به قالبی خوانا برای انسان تبدیل شده و در ثبات‌های قابل‌استفاده توسط اسناد و بسته‌های ماکرو ذخیره می‌شود.
.
.
.TP
.I TZ
منطقه زمانی مورد استفاده هنگام تبدیل زمان جاری به قالبی خوانا برای انسان؛
رجوع کنید به
.MR tzset 3 .
اگر از
.I SOURCE_DATE_EPOCH
استفاده شود، همواره با استفاده از UTC به قالبی خوانا برای انسان تبدیل می‌گردد.
.
.
.\" ====================================================================
.SH "فایل‌ها (FILES)"
.\" ====================================================================
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%tmac/\:\%troffrc
یک فایل ماکروی مقداردهی اولیه است که پیش از هر بسته ماکروی مشخص‌شده با گزینه‌های
.B \-m
بارگذاری می‌شود.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%tmac/\:\%troffrc\-end
یک فایل ماکروی مقداردهی اولیه است که پس از تمامی بسته‌های ماکروی مشخص‌شده با گزینه‌های
.B \-m
بارگذاری می‌شود.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%tmac/\: name \:.tmac
فایل‌های ماکروی عرضه‌شده به همراه
.IR groff
هستند.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%dev name /\:DESC
دستگاه خروجی
.I name
را توصیف می‌کند.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%dev name / F
قلم
.I F
از دستگاه
.I name
را توصیف می‌کند.
.
.
.P
به دلایل امنیتی،
فایل‌های
.I troffrc
و
.I troffrc\-end
به طور پیش‌فرض نه در دایرکتوری جاری و نه در دایرکتوری خانگی جستجو نمی‌شوند،
حتی اگر گزینه
.B \-U
مشخص شده باشد.
.
در صورت لزوم، از گزینه خط فرمان
.B \-M
یا متغیر محیطی
.I GROFF_TMAC_PATH
برای افزودن این دایرکتوری‌ها به مسیر جستجو استفاده کنید.
.
.
.\" ====================================================================
.SH "نویسندگان (AUTHORS)"
.\" ====================================================================
.
نگارش گنوی
.I troff \" generic
در ابتدا توسط James Clark نوشته شد؛
او همچنین نگارش اصلی این سند را نوشت،
که سپس توسط
.MT wl@\:gnu\:.org
Werner Lemberg
.ME ،
.MT groff\-bernd\:.warken\-72@\:web\:.de
Bernd Warken
.ME
و
.MT g.branden\:.robinson@\:gmail\:.com
G.\& Branden Robinson
.ME
به‌روزرسانی شد.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
کتاب
.IR "Groff: The GNU Implementation of troff" ،
اثر Trent A.\& Fisher و Werner Lemberg،
راهنمای اصلی
.I groff
است.
.
می‌توانید آن را به صورت تعاملی با دستور \[lq]info groff\[rq] مرور کنید.
.
.
.TP
.MR groff 1
نمایی کلی از سامانه
GNU
.I roff
ارائه داده و فایل اجرایی پیشخوان آن را شرح می‌دهد.
.
.
.TP
.MR groff 7
جزئیات زبان
.I groff
را شامل مرجعی کوتاه اما کامل از تمامی درخواست‌ها، ثبات‌ها و توالی‌های گریز از پیش تعریف‌شده تشریح می‌کند.
.
.
.TP
.MR groff_char 7
نحو توالی‌های گریز نویسه‌های ویژه
.I groff
را توضیح داده و تمامی نویسه‌های ویژه از پیش تعریف‌شده در این زبان را فهرست می‌نماید.
.
.
.TP
.MR groff_diff 7
تفاوت‌های میان
.I troff \" AT&T
مستقل از دستگاه AT&T و
.IR groff
را برمی‌شمارد.
.
.
.TP
.MR groff_font 5
قالب فایل‌های توصیف دستگاه و قلم
.I groff
را پوشش می‌دهد.
.
.
.TP
.MR groff_out 5
قالب خروجی
.I \%troff
را شرح می‌دهد.
.
.
.TP
.MR groff_tmac 5
شامل اطلاعاتی درباره فایل‌های ماکروی عرضه‌شده همراه با
.I groff
است.
.
.
.TP
.MR roff 7
اطلاعات زمینه‌ای درباره سامانه‌های
.I roff
به طور کلی ارائه می‌دهد،
شامل اشاره‌گرهایی به مستندات مرتبط بیشتر.
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_troff_1_man_C]
.do rr *groff_troff_1_man_C
.
.
