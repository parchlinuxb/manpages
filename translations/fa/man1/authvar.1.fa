.Dd $Mdocdate: Jun 4 2020$
.Dt AUTHVAR 1
.Os Linux
.Sh "نام (NAME)"
.Nm authvar
.Nd مدیریت متغیرهای احراز هویت‌شده برای pesign
.Sh "خلاصه دستور (SYNOPSIS)"
.Nm
.Bk -words
.Ao
.Fl a |
.Fl c |
.Fl s
.Ac
.Ek
.Bk -words
.Cm Fl N Ar {guid}
.Cm Fl n Ar name
.Ek
.Bk -words
.Ao
.Fl v Ar value |
.Fl f Ar file
.Ac
.Ek
.Bk -words
.Op Fl t Ar time
.Op Fl d Ar directory
.Op Fl S Ar nickname
.Op Fl i Ar file
.Op Fl e Ar file
.Ek
.Sh "توضیحات (DESCRIPTION)"
.Nm
یک ابزار خط فرمانی برای مدیریت متغیرهای احراز هویت‌شده UEFI است.
.Sh "گزینه‌ها (OPTIONS)"
.Bl -tag
.It Fl a | Fl Fl append
الحاق به متغیر
.It Fl c | Fl Fl clear
پاک‌کردن متغیر
.It Fl s | Fl Fl set
تنظیم متغیر
.It Fl N Ao {guid} | namespace Ac | Fl Fl namespace Ao {guid} | namespace Ac
متغیر در
.Ar namespace
یا
.Ar {guid}
قرار دارد
.Po
پیش‌فرض:
.Pa global
.Pc

برای فهرست کردن فضاهای نام از
.Fl N Ar help
استفاده کنید.
.It Fl n Ar name | Fl Fl name Ar name
نام متغیر
.Ar name
.It Fl v Ar value | Fl Fl value Ar value
تنظیم یا الحاق
.Ar value
به متغیر
.It Fl f Ar file | Fl Fl valuefile Ar file
خواندن مقدار از
.Ar file
.It Fl t Ar time | Fl Fl timestamp Ar time
برچسب زمانی برای متغیر
.Po
پیش‌فرض:
.Pa now
.Pc
.It Fl d Ar directory | Fl Fl certdir Ar directory
مشخص‌کردن دایرکتوری
.Ar directory
پایگاه‌داده گواهی NSS
.Po
پیش‌فرض:
.Pa /etc/pki/pesign
.Pc
.It Fl S Ar nickname | Fl Fl sign Ar nickname
امضای متغیر با گواهی
.Ar nickname
از پایگاه‌داده NSS
.It Fl i Ar file | Fl Fl import Ar file
وارد کردن متغیر از
.Ar file
.It Fl e Ar file | Fl Fl export Ar file
صادر کردن متغیر به
.Ar file
به‌جای تنظیم آن در میان‌افزار
.Sh "استانداردها (STANDARDS)"
.Rs
.%A B. Kaliski
.%R RFC 2315
.%B PKCS #7: Cryptographic Message Syntax v1.5
.%I Internet Engineering Task Force
.%D March 1998
.%U https://tools.ietf.org/html/rfc2315\ \&
.Re

.Rs
.%A K. Moriarty
.%A M. Nystr\[u00F6]m
.%A S. Parkinson
.%A A. Rusch
.%A M. Scott
.%R RFC 7292
.%B PKCS #12: Personal Information Exchange Syntax v1.1
.%I Internet Engineering Task Force
.%D July 2014
.%U https://tools.ietf.org/html/rfc7292\ \&
.Re

.Rs
.%A PKCS11 Technical Committee
.%B PKCS#11: Cryptographic Token Interface Standard
.%I OASIS
.%U https://www.cryptsoft.com/pkcs11doc\ \&
.Re

.Rs
.%A UEFI Specification Working Group
.%B Unified Extensible Firmware Interface (UEFI) Specification Version 2.8
.%I Unified Extensible Firmware Interface Forum
.%D March 2019
.%U https://uefi.org/specifications\ \&
.Re
.Sh "همچنین ببینید (SEE ALSO)"
.Xr pesign 1 ,
.Xr certutil 1
.Sh "نویسندگان (AUTHORS)"
.An Peter Jones