.TH man 1 "2026-06-08" "0.18.2" "Profanity XMPP client"

.SH "نام (NAME)"
/cmd

.SH "توضیحات (DESCRIPTION)"
Execute ad hoc commands.

.SH "خلاصه دستور (SYNOPSIS)"
/cmd list [<jid>]

.LP
/cmd exec <command> [<jid>]

.LP

.SH ARGUMENTS
.PP
\fBlist\fR
.RS 4
List supported ad hoc commands.
.RE
.PP
\fBexec <command>\fR
.RS 4
Execute a command.
.RE

.SH "مثال‌ها (EXAMPLES)"
/cmd list

.LP
/cmd exec ping

.LP
