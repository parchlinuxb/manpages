.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-start \- شروع یک یا چند کانتینر متوقف‌شده


.SH "خلاصه دستور (SYNOPSIS)"
\fBdocker start [OPTIONS] CONTAINER [CONTAINER...]\fP


.SH "شرح (DESCRIPTION)"
نام مستعار برای \fBdocker container start\fR\&.


.SH "گزینه‌ها (OPTIONS)"
\fB-a\fP, \fB--attach\fP[=false]
	اتصال STDOUT/STDERR و فوروارد کردن سیگنال‌ها

.PP
\fB--checkpoint\fP=""
	بازیابی از این نقطه بازرسی (checkpoint)

.PP
\fB--checkpoint-dir\fP=""
	استفاده از یک شاخه سفارشی برای ذخیره‌سازی نقطه بازرسی

.PP
\fB--detach-keys\fP=""
	بازنویسی توالی کلیدها برای جدا شدن (detach) از کانتینر

.PP
\fB-i\fP, \fB--interactive\fP[=false]
	اتصال STDIN کانتینر


.SH "ببینید (SEE ALSO)"
\fBdocker(1)\fP
