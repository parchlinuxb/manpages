.SS bad\-chained\-comparison / W3601
.sp
\fBMessage emitted:\fP
.sp
\fBSuspicious %s\-part chained comparison using semantically incompatible operators (%s)\fP
.sp
\fBDescription:\fP
.sp
\fIUsed when there is a chained comparison where one expression is part of two comparisons that belong to different semantic groups (\(dq<\(dq does not mean the same thing as \(dqis\(dq, chaining them in \(dq0 < x is None\(dq is probably a mistake).\fP
.sp
\fBProblematic code:\fP
.sp
\fBparrot.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
shop = {
    # animal: (specie, descriptions)
    \(dqparrot\(dq: (\(dqNorvegian blue\(dq, (\(dqrestin\(aq\(dq, \(dqremarkable\(dq, \(dqbeautiful plumage\(dq)),
}

if \(dqparrot\(dq in shop is \(dqrestin\(aq\(dq:  # [bad\-chained\-comparison]
    print(\(dqHellooooo, Pooolllllyyy ! WAAAAKEEY, WAKKEEEY !\(dq)

.EE
.UNINDENT
.UNINDENT
.sp
\fBxor.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
def xor_check(*, left=None, right=None):
    if left is None != right is None:  # [bad\-chained\-comparison]
        raise ValueError(
            \(dqEither both left= and right= need to be provided or none should.\(dq
        )

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.sp
\fBparrot.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
shop = {
    # animal: (specie, descriptions)
    \(dqparrot\(dq: (\(dqNorvegian blue\(dq, (\(dqrestin\(aq\(dq, \(dqremarkable\(dq, \(dqbeautiful plumage\(dq)),
}

if \(dqparrot\(dq in shop and \(dqrestin\(aq\(dq in shop[\(dqparrot\(dq][1]:
    print(\(dqHellooooo, Pooolllllyyy ! WAAAAKEEY, WAKKEEEY !\(dq)

.EE
.UNINDENT
.UNINDENT
.sp
\fBxor.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
def xor_check(*, left=None, right=None):
    if (left is None) != (right is None):
        raise ValueError(
            \(dqEither both left= and right= need to be provided or none should.\(dq
        )

.EE
.UNINDENT
.UNINDENT
