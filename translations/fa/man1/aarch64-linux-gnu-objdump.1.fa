.IX Title "OBJDUMP 1"
.TH OBJDUMP 1 2026-07-30 binutils-2.47 "GNU Development Tools"
.\" For nroff, turn off justification.  Always turn off hyphenation; it makes
.\" way too many mistakes in technical documents.
.if n .ad l
.nh
.SH "نام (NAME)"
aarch64\-linux\-gnu\-objdump \- نمایش اطلاعات از فایلهای شیء هدف AArch64
.SH "خلاصه دستور (SYNOPSIS)"
.IX Header "SYNOPSIS"
objdump [\fB\-a\fR|\fB\-\-archive\-headers\fR]
        [\fB\-b\fR \fIbfdname\fR|\fB\-\-target=\fR\fIbfdname\fR]
        [\fB\-C\fR|\fB\-\-demangle\fR[=\fIstyle\fR] ]
        [\fB\-d\fR|\fB\-\-disassemble\fR[=\fIsymbol\fR]]
        [\fB\-D\fR|\fB\-\-disassemble\-all\fR]
        [\fB\-z\fR|\fB\-\-disassemble\-zeroes\fR]
        [\fB\-EB\fR|\fB\-EL\fR|\fB\-\-endian=\fR{big | little }]
        [\fB\-f\fR|\fB\-\-file\-headers\fR]
        [\fB\-F\fR|\fB\-\-file\-offsets\fR]
        [\fB\-\-file\-start\-context\fR]
        [\fB\-g\fR|\fB\-\-debugging\fR]
        [\fB\-e\fR|\fB\-\-debugging\-tags\fR]
        [\fB\-h\fR|\fB\-\-section\-headers\fR|\fB\-\-headers\fR]
        [\fB\-i\fR|\fB\-\-info\fR]
        [\fB\-j\fR \fIsection\fR|\fB\-\-section=\fR\fIsection\fR]
        [\fB\-l\fR|\fB\-\-line\-numbers\fR]
        [\fB\-S\fR|\fB\-\-source\fR]
        [\fB\-\-source\-comment\fR[=\fItext\fR]]
        [\fB\-m\fR \fImachine\fR|\fB\-\-architecture=\fR\fImachine\fR]
        [\fB\-M\fR \fIoptions\fR|\fB\-\-disassembler\-options=\fR\fIoptions\fR]
        [\fB\-p\fR|\fB\-\-private\-headers\fR]
        [\fB\-P\fR \fIoptions\fR|\fB\-\-private=\fR\fIoptions\fR]
        [\fB\-r\fR|\fB\-\-reloc\fR]
        [\fB\-R\fR|\fB\-\-dynamic\-reloc\fR]
        [\fB\-s\fR|\fB\-\-full\-contents\fR]
        [\fB\-Z\fR|\fB\-\-decompress\fR]
        [\fB\-W\fR|\fB\-\-dwarf\fR]
        [\fB\-Wa\fR|\fB\-\-dwarf=abbrev\fR]
        [\fB\-WA\fR|\fB\-\-dwarf=addr\fR]
        [\fB\-Wr\fR|\fB\-\-dwarf=aranges\fR]
        [\fB\-Wc\fR|\fB\-\-dwarf=cu_index\fR]
        [\fB\-WL\fR|\fB\-\-dwarf=decodedline\fR]
        [\fB\-Wf\fR|\fB\-\-dwarf=frames\fR]
        [\fB\-WF\fR|\fB\-\-dwarf=frames\-interp\fR]
        [\fB\-Wg\fR|\fB\-\-dwarf=gdb_index\fR]
        [\fB\-Wi\fR|\fB\-\-dwarf=info\fR]
        [\fB\-Wk\fR|\fB\-\-dwarf=links\fR]
        [\fB\-Wo\fR|\fB\-\-dwarf=loc\fR]
        [\fB\-Wm\fR|\fB\-\-dwarf=macro\fR]
        [\fB\-Wp\fR|\fB\-\-dwarf=pubnames\fR]
        [\fB\-Wt\fR|\fB\-\-dwarf=pubtypes\fR]
        [\fB\-WR\fR|\fB\-\-dwarf=Ranges\fR]
        [\fB\-Wl\fR|\fB\-\-dwarf=rawline\fR]
        [\fB\-Ws\fR|\fB\-\-dwarf=str\fR]
        [\fB\-WO\fR|\fB\-\-dwarf=str\-offsets\fR]
        [\fB\-Wu\fR|\fB\-\-dwarf=trace_abbrev\fR]
        [\fB\-WT\fR|\fB\-\-dwarf=trace_aranges\fR]
        [\fB\-WU\fR|\fB\-\-dwarf=trace_info\fR]
        [\fB\-WK\fR|\fB\-\-dwarf=follow\-links\fR]
        [\fB\-WN\fR|\fB\-\-dwarf=no\-follow\-links\fR]
        [\fB\-WD\fR|\fB\-\-dwarf=use\-debuginfod\fR]
        [\fB\-WE\fR|\fB\-\-dwarf=do\-not\-use\-debuginfod\fR]
        [\fB\-\-debug\-dir=\fR\f(BIdir\fR]
        [\fB\-\-map\-global\-vars\fR]
        [\fB\-L\fR|\fB\-\-process\-links\fR]
        [\fB\-\-ctf=\fR\fIsection\fR]
        [\fB\-\-sframe=\fR\fIsection\fR]
        [\fB\-G\fR|\fB\-\-stabs\fR]
        [\fB\-t\fR|\fB\-\-syms\fR]
        [\fB\-T\fR|\fB\-\-dynamic\-syms\fR]
        [\fB\-x\fR|\fB\-\-all\-headers\fR]
        [\fB\-w\fR|\fB\-\-wide\fR]
        [\fB\-\-start\-address=\fR\fIaddress\fR]
        [\fB\-\-stop\-address=\fR\fIaddress\fR]
        [\fB\-\-no\-addresses\fR]
        [\fB\-\-prefix\-addresses\fR]
        [\fB\-\-[no\-]show\-raw\-insn\fR]
        [\fB\-\-adjust\-vma=\fR\fIoffset\fR]
        [\fB\-\-show\-all\-symbols\fR]
        [\fB\-\-dwarf\-depth=\fR\fIn\fR]
        [\fB\-\-dwarf\-start=\fR\fIn\fR]
        [\fB\-\-ctf\-parent=\fR\fIsection\fR]
        [\fB\-\-no\-recurse\-limit\fR|\fB\-\-recurse\-limit\fR]
        [\fB\-\-special\-syms\fR]
        [\fB\-\-prefix=\fR\fIprefix\fR]
        [\fB\-\-prefix\-strip=\fR\fIlevel\fR]
        [\fB\-\-insn\-width=\fR\fIwidth\fR]
        [\fB\-\-visualize\-jumps[=color|=extended\-color|=off]\fR
        [\fB\-\-disassembler\-color=[off|terminal|on|extended]\fR
        [\fB\-U\fR \fImethod\fR] [\fB\-\-unicode=\fR\fImethod\fR]
        [\fB\-V\fR|\fB\-\-version\fR]
        [\fB\-H\fR|\fB\-\-help\fR]
        \fIobjfile\fR...
.SH "توضیحات (DESCRIPTION)"
.IX Header "DESCRIPTION"
دستور
.B objdump
اطلاعات مربوط به یک یا چند فایل شیء را نمایش می‌دهد.
گزینه‌ها مشخص می‌کنند چه اطلاعات خاصی نمایش داده شود. این اطلاعات بیشتر برای برنامه‌نویسانی مفید است که بر روی ابزارهای کامپایل کار می‌کنند، بر خلاف برنامه‌نویسانی که صرفاً می‌خواهند برنامه‌شان کامپایل شده و اجرا شود.
.PP
.I objfile...
فایل‌های شیء هستند که باید بررسی شوند. هنگامی که آرشیوها را مشخص می‌کنید،
.B objdump
اطلاعات مربوط به هر یک از فایل‌های شیء عضو آرشیو را نمایش می‌دهد.
.SH "گزینهها (OPTIONS)"
.IX Header "OPTIONS"
شکل‌های بلند و کوتاه گزینه‌ها که در اینجا به عنوان گزینه‌های جایگزین نشان داده شده‌اند، معادل یکدیگرند. حداقل باید یکی از گزینه‌های فهرست
.B \-a,\-d,\-D,\-e,\-f,\-g,\-G,\-h,\-H,\-p,\-P,\-r,\-R,\-s,\-S,\-t,\-T,\-V,\-x
مشخص شود.
.IP \fB\-a\fR 4
.IX Item "-a"
.PD 0
.IP \fB\-\-archive\-header\fR 4
.IX Item "--archive-header"
.PD
اگر هر یک از فایل‌های
.I objfile
آرشیو باشند، اطلاعات هدر آرشیو را (در قالبی شبیه به
.BR "ls \-l" )
نمایش می‌دهد. علاوه بر اطلاعاتی که با
.B ar tv
می‌توانید فهرست کنید،
.B objdump \-a
قالب فایل شیء هر یک از اعضای آرشیو را نمایش می‌دهد.
.IP \fB\-\-adjust\-vma=\fR\fIoffset\fR 4
.IX Item "--adjust-vma=offset"
هنگام تخلیه اطلاعات، ابتدا مقدار
.I offset
را به تمام آدرس‌های بخش‌ها می‌افزاید. این گزینه در صورتی مفید است که آدرس‌های بخش‌ها با جدول نمادها مطابقت نداشته باشند، که ممکن است هنگام قرار دادن بخش‌ها در آدرس‌های خاص هنگام استفاده از قالبی رخ دهد که نمی‌تواند آدرس بخش‌ها را نشان دهد، مانند
.BR a.out .
.IP "\fB\-b\fR \fIbfdname\fR" 4
.IX Item "-b bfdname"
.PD 0
.IP \fB\-\-target=\fR\fIbfdname\fR 4
.IX Item "--target=bfdname"
.PD
مشخص می‌کند که قالب کد شیء برای فایل‌های شیء،
.I bfdname
است. این گزینه ممکن است لازم نباشد؛ زیرا
.B objdump
می‌تواند بسیاری از قالب‌ها را به صورت خودکار شناسایی کند.
.Sp
برای نمونه،
.Sp
.Vb 1
\&        objdump \-b oasys \-m vax \-h fu.o
.Ve
.Sp
اطلاعات خلاصه هدرهای بخش
.RB ( \-h )
فایل
.I fu.o
را نمایش می‌دهد، که صریحاً
.RB ( \-m )
به عنوان یک فایل شیء VAX در قالب تولیدشده توسط کامپایلرهای Oasys شناسایی شده است. می‌توانید قالب‌های موجود را با گزینه
.B \-i
فهرست کنید.
.IP \fB\-C\fR 4
.IX Item "-C"
.PD 0
.IP \fB\-\-demangle[=\fR\fIstyle\fR\fB]\fR 4
.IX Item "--demangle[=style]"
.PD
رمزگشایی
.RI ( demangle )
نام‌های سطح پایین نمادها به نام‌های سطح کاربر. این گزینه علاوه بر حذف هرگونه زیرخط اولیه که توسط سیستم اضافه شده است، نام توابع ++C را خوانا می‌کند. کامپایلرهای مختلف سبک‌های درهم‌سازی متفاوتی دارند. آرگومان اختیاری سبک رمزگشایی می‌تواند برای انتخاب سبک مناسب برای کامپایلر شما استفاده شود.
.IP \fB\-\-recurse\-limit\fR 4
.IX Item "--recurse-limit"
.PD 0
.IP \fB\-\-no\-recurse\-limit\fR 4
.IX Item "--no-recurse-limit"
.IP \fB\-\-recursion\-limit\fR 4
.IX Item "--recursion-limit"
.IP \fB\-\-no\-recursion\-limit\fR 4
.IX Item "--no-recursion-limit"
.PD
محدودیتی را بر میزان بازگشت (recursion) انجام‌شده هنگام رمزگشایی رشته‌ها فعال یا غیرفعال می‌کند. از آنجا که قالب‌های درهم‌سازی نام امکان بازگشت نامحدود را فراهم می‌کنند، این احتمال وجود دارد که رشته‌هایی ایجاد شوند که رمزگشایی آنها فضای پشته (stack) موجود در ماشین میزبان را تمام کرده و خطای حافظه ایجاد کند. این محدودیت با محدود کردن بازگشت به ۲۰۴۸ سطح تودرتو سعی می‌کند از این رویداد جلوگیری کند.
.Sp
حالت پیش‌فرض فعال بودن این محدودیت است، اما ممکن است غیرفعال کردن آن برای رمزگشایی نام‌های واقعاً پیچیده ضروری باشد. با این حال توجه داشته باشید که اگر محدودیت بازگشت غیرفعال شود، سرریز پشته امکان‌پذیر خواهد بود و هرگونه گزارش باگ درباره چنین رخدادی رد می‌شود.
.IP \fB\-g\fR 4
.IX Item "-g"
.PD 0
.IP \fB\-\-debugging\fR 4
.IX Item "--debugging"
.PD
نمایش اطلاعات اشکال‌زدایی. این گزینه سعی می‌کند اطلاعات قالب اشکال‌زدایی STABS ذخیره‌شده در فایل را تجزیه کرده و آن را با نگارشی شبیه به C چاپ کند. اگر هیچ اطلاعات اشکال‌زدایی STABS یافت نشود، این گزینه به گزینه
.B \-W
رجوع می‌کند تا اطلاعات DWARF موجود در فایل را چاپ کند.
.IP \fB\-e\fR 4
.IX Item "-e"
.PD 0
.IP \fB\-\-debugging\-tags\fR 4
.IX Item "--debugging-tags"
.PD
مانند
.BR \-g ،
اما اطلاعات در قالبی سازگار با ابزار ctags تولید می‌شوند.
.IP \fB\-d\fR 4
.IX Item "-d"
.PD 0
.IP \fB\-\-disassemble\fR 4
.IX Item "--disassemble"
.IP \fB\-\-disassemble=\fR\fIsymbol\fR 4
.IX Item "--disassemble=symbol"
.PD
یادآورهای اسمبلی (mnemonics) را برای دستورالعمل‌های ماشین از فایل ورودی نمایش می‌دهد. این گزینه تنها بخش‌هایی را دی‌اسمبل می‌کند که انتظار می‌رود شامل دستورالعمل باشند. اگر آرگومان اختیاری
.I symbol
داده شود (احتمالاً چند بار)، یادآورهای اسمبلی را از نقطه شروع (تمام)
.I symbol
نمایش می‌دهد. اگر
.I symbol
نام یک تابع باشد، دی‌اسمبل در پایان تابع متوقف می‌شود، در غیر این صورت با رسیدن به نماد بعدی متوقف خواهد شد. اگر هیچ تطابقی برای
.I symbol
پیدا نشود، چیزی نمایش داده نمی‌شود.
.Sp
توجه داشته باشید اگر گزینه
.B \-\-dwarf=follow\-links
فعال باشد، هر جدول نمادی در فایل‌های اطلاعات اشکال‌زدایی پیوندشده خوانده شده و هنگام دی‌اسمبل کردن استفاده می‌شود.
.IP \fB\-D\fR 4
.IX Item "-D"
.PD 0
.IP \fB\-\-disassemble\-all\fR 4
.IX Item "--disassemble-all"
.PD
مانند
.BR \-d ،
اما محتویات تمام بخش‌های غیرخالی و غیر bss را دی‌اسمبل می‌کند، نه فقط بخش‌هایی که انتظار می‌رود حاوی دستورالعمل باشند.
.B \-j
ممکن است برای انتخاب بخش‌های خاص استفاده شود.
.Sp
این گزینه همچنین تأثیر ظریفی بر دی‌اسمبل دستورالعمل‌ها در بخش‌های کد دارد. هنگامی که گزینه
.B \-d
فعال است،
.B objdump
فرض می‌کند هر نمادی که در یک بخش کد وجود دارد در مرز بین دستورالعمل‌ها رخ می‌دهد و از دی‌اسمبل در سرتاسر چنین مرزی خودداری می‌کند. با این حال هنگامی که گزینه
.B \-D
فعال است، این فرض نادیده گرفته می‌شود. این بدان معناست که اگر برای نمونه داده‌ها در بخش‌های کد ذخیره شوند، ممکن است خروجی
.B \-d
و
.B \-D
متفاوت باشد.
.Sp
اگر هدف معماری ARM باشد، این سوییچ همچنین اثر وادار کردن دی‌اسمبلر به رمزگشایی بخش‌هایی از داده‌های موجود در بخش‌های کد را دارد به گونه‌ای که گویی دستورالعمل هستند.
.Sp
توجه داشته باشید اگر گزینه
.B \-\-dwarf=follow\-links
فعال باشد، هر جدول نمادی در فایل‌های اطلاعات اشکال‌زدایی پیوندشده خوانده شده و هنگام دی‌اسمبل کردن استفاده می‌شود.
.IP \fB\-\-no\-addresses\fR 4
.IX Item "--no-addresses"
هنگام دی‌اسمبل، آدرس‌ها را در هر خط یا برای نمادها و آفست‌های بازنشانی چاپ نمی‌کند. در ترکیب با
.BR \-\-no\-show\-raw\-insn ،
این گزینه ممکن است برای مقایسه خروجی کامپایلر مفید باشد.
.IP \fB\-\-prefix\-addresses\fR 4
.IX Item "--prefix-addresses"
هنگام دی‌اسمبل، آدرس کامل را در هر خط چاپ می‌کند. این قالب قدیمی‌تر دی‌اسمبل است.
.IP \fB\-EB\fR 4
.IX Item "-EB"
.PD 0
.IP \fB\-EL\fR 4
.IX Item "-EL"
.IP \fB\-\-endian={big|little}\fR 4
.IX Item "--endian={big|little}"
.PD
ترتیب بایت‌های فایل‌های شیء را مشخص می‌کند. این گزینه فقط بر دی‌اسمبل تأثیر می‌گذارد. این ویژگی هنگام دی‌اسمبل قالبی که اطلاعات ترتیب بایت را توصیف نمی‌کند، مانند S-records، می‌تواند مفید باشد.
.IP \fB\-f\fR 4
.IX Item "-f"
.PD 0
.IP \fB\-\-file\-headers\fR 4
.IX Item "--file-headers"
.PD
اطلاعات خلاصه هدر کلی هر یک از فایل‌های
.I objfile
را نمایش می‌دهد.
.IP \fB\-F\fR 4
.IX Item "-F"
.PD 0
.IP \fB\-\-file\-offsets\fR 4
.IX Item "--file-offsets"
.PD
هنگام دی‌اسمبل کردن بخش‌ها، هر زمان نمادی نمایش داده می‌شود، آفست فایلی ناحیه داده‌ای که قرار است تخلیه شود را نیز نمایش می‌دهد. اگر صفرها رد شوند، هنگامی که دی‌اسمبل از سر گرفته می‌شود، به کاربر اعلام می‌کند چه تعداد صفر رد شده و آفست فایلی مکانی که دی‌اسمبل از آنجا از سر گرفته می‌شود چقدر است. هنگام تخلیه بخش‌ها، آفست فایلی مکانی که تخلیه از آنجا شروع می‌شود را نمایش می‌دهد.
.IP \fB\-\-file\-start\-context\fR 4
.IX Item "--file-start-context"
مشخص می‌کند هنگامی که کد منبع/دی‌اسمبل درهم‌آمیخته (با فرض
.BR \-S )
از فایلی نمایش داده می‌شود که هنوز نمایش داده نشده است، بافت متن تا آغاز فایل گسترش یابد.
.IP \fB\-h\fR 4
.IX Item "-h"
.PD 0
.IP \fB\-\-section\-headers\fR 4
.IX Item "--section-headers"
.IP \fB\-\-headers\fR 4
.IX Item "--headers"
.PD
اطلاعات خلاصه هدرهای بخش فایل شیء را نمایش می‌دهد.
.Sp
قطعات فایل ممکن است به آدرس‌های غیراستاندارد بازنشانی شوند، برای نمونه با استفاده از گزینه‌های
.BR \-Ttext ،
.B \-Tdata
یا
.B \-Tbss
در
.BR ld .
با این حال، برخی قالب‌های فایل شیء، مانند a.out، آدرس شروع قطعات فایل را ذخیره نمی‌کنند. در این شرایط، گرچه
.B ld
بخش‌ها را به درستی بازنشانی می‌کند، استفاده از
.B objdump \-h
برای فهرست کردن هدرهای بخش فایل نمی‌تواند آدرس‌های صحیح را نشان دهد. در عوض، آدرس‌های معمول را که برای هدف ضمنی هستند نشان می‌دهد.
.Sp
توجه داشته باشید، در برخی موارد ممکن است برای یک بخش هر دو ویژگی READONLY و NOREAD تنظیم شده باشد. در چنین مواردی ویژگی NOREAD تقدم دارد، اما
.B objdump
هر دو را گزارش می‌دهد زیرا تنظیم دقیق بیت‌های فلگ ممکن است مهم باشد.
.IP \fB\-H\fR 4
.IX Item "-H"
.PD 0
.IP \fB\-\-help\fR 4
.IX Item "--help"
.PD
خلاصه‌ای از گزینه‌های
.B objdump
را چاپ کرده و خارج می‌شود.
.IP \fB\-i\fR 4
.IX Item "-i"
.PD 0
.IP \fB\-\-info\fR 4
.IX Item "--info"
.PD
فهرستی را نمایش می‌دهد که تمام معماری‌ها و قالب‌های شیء موجود برای تعیین با
.B \-b
یا
.B \-m
را نشان می‌دهد.
.IP "\fB\-j\fR \fIname\fR" 4
.IX Item "-j name"
.PD 0
.IP \fB\-\-section=\fR\fIname\fR 4
.IX Item "--section=name"
.PD
اطلاعات بخش
.I name
را نمایش می‌دهد. این گزینه ممکن است چندین بار مشخص شود.
.IP \fB\-\-map\-global\-vars\fR 4
.IX Item "--map-global-vars"
اطلاعات متغیرهای سراسری را نمایش می‌دهد. این گزینه تنها زمانی کار می‌کند که فایل شیء با گزینه اشکال‌زدایی کامپایل شده باشد. به طور دقیق‌تر، این گزینه بر مدخل‌های اطلاعات اشکال‌زدایی DWARF2 متکی است. برای ردیابی مکان و نوع تمام متغیرهای سراسری در فایل شیء داده‌شده مفید است.
.IP \fB\-L\fR 4
.IX Item "-L"
.PD 0
.IP \fB\-\-process\-links\fR 4
.IX Item "--process-links"
.PD
محتویات بخش‌های غیر اشکال‌زدایی یافت‌شده در فایل‌های debuginfo جداگانه را که به فایل اصلی پیوند داده شده‌اند نمایش می‌دهد. این گزینه به طور خودکار مستلزم گزینه
.B \-WK
است و تنها بخش‌هایی نمایش داده می‌شوند که توسط گزینه‌های دیگر خط فرمان درخواست شده باشند.
.IP \fB\-l\fR 4
.IX Item "-l"
.PD 0
.IP \fB\-\-line\-numbers\fR 4
.IX Item "--line-numbers"
.PD
نمایش را (با استفاده از اطلاعات اشکال‌زدایی) با نام فایل و شماره خطوط منبع متناظر با کد شیء یا بازنشانی‌های نشان داده شده برچسب‌گذاری می‌کند. تنها با
.BR \-d ،
.B \-D
یا
.B \-r
مفید است.
.IP "\fB\-m\fR \fImachine\fR" 4
.IX Item "-m machine"
.PD 0
.IP \fB\-\-architecture=\fR\fImachine\fR 4
.IX Item "--architecture=machine"
.PD
معماری مورد استفاده هنگام دی‌اسمبل کردن فایل‌های شیء را مشخص می‌کند. این گزینه هنگام دی‌اسمبل فایل‌های شیء که اطلاعات معماری را توصیف نمی‌کنند، مانند S-records، می‌تواند مفید باشد. می‌توانید معماری‌های موجود را با گزینه
.B \-i
فهرست کنید.
.Sp
برای اکثر معماری‌ها امکان ارائه یک نام معماری و یک نام ماشین وجود دارد که با دو نقطه از هم جدا شده‌اند. برای نمونه
.B foo:bar
به نوع ماشین
.B bar
در معماری
.B foo
اشاره دارد. این می‌تواند در صورتی مفید باشد که objdump برای پشتیبانی از چند معماری پیکربندی شده باشد.
.Sp
اگر هدف معماری ARM باشد، این سوییچ یک تأثیر اضافی دارد. این گزینه دی‌اسمبل را تنها به دستورالعمل‌های پشتیبانی‌شده توسط معماری مشخص‌شده با
.I machine
محدود می‌کند. اگر استفاده از این سوییچ به این دلیل لازم باشد که فایل ورودی حاوی اطلاعات معماری نیست، اما تمایل دارید تمام دستورالعمل‌ها دی‌اسمبل شوند، از
.B \-marm
استفاده کنید.
.IP "\fB\-M\fR \fIoptions\fR" 4
.IX Item "-M options"
.PD 0
.IP \fB\-\-disassembler\-options=\fR\fIoptions\fR 4
.IX Item "--disassembler-options=options"
.PD
اطلاعات خاص هدف را به دی‌اسمبلر ارسال می‌کند. تنها در برخی اهداف پشتیبانی می‌شود. اگر لازم است بیش از یک گزینه دی‌اسمبلر مشخص شود، چندین گزینه
.B \-M
می‌تواند استفاده شود یا می‌توان آنها را در یک فهرست جداشده با کاما در کنار هم قرار داد.
.Sp
برای ARC، گزینه
.B dsp
چاپ دستورالعمل‌های DSP را کنترل می‌کند،
.B spfp
چاپ دستورالعمل‌های FP با دقت تکی FPX را انتخاب می‌کند،
.B dpfp
چاپ دستورالعمل‌های FP با دقت مضاعف FPX را انتخاب می‌کند،
.B quarkse_em
چاپ دستورالعمل‌های خاص QuarkSE-EM را انتخاب می‌کند،
.B fpuda
چاپ دستورالعمل‌های کمکی دقت مضاعف را انتخاب می‌کند،
.B fpus
چاپ دستورالعمل‌های FP با دقت تکی FPU را انتخاب می‌کند، در حالی که
.B fpud
چاپ دستورالعمل‌های FP با دقت مضاعف FPU را انتخاب می‌کند. علاوه بر این، می‌توان با استفاده از
.B hex
انتخاب کرد که همه مقادیر فوری به صورت هگزادسیمال چاپ شوند. به طور پیش‌فرض، مقادیر فوری کوتاه با استفاده از نمایش دهدهی چاپ می‌شوند، در حالی که مقادیر فوری طولانی به صورت هگزادسیمال چاپ می‌شوند.
.Sp
گزینه
.B cpu=...
به کاربر اجازه می‌دهد هنگام دی‌اسمبل کردن دستورالعمل‌ها یک ISA خاص را اعمال کند، و مقدار
.B \-m
یا هر آنچه را که در فایل ELF وجود دارد بازنویسی (override) نماید. این ممکن است برای انتخاب ARC EM یا HS ISA مفید باشد، زیرا معماری برای آنها یکسان است و دی‌اسمبلر به داده‌های هدر اختصاصی ELF متکی است تا تصمیم بگیرد کد مربوط به EM است یا HS. این گزینه ممکن است چندین بار مشخص شود \- تنها آخرین مقدار استفاده خواهد شد. مقادیر معتبر همان مقادیر گزینه
.B \-mcpu=...
اسمبلر هستند.
.Sp
اگر هدف معماری ARM باشد، این سوییچ می‌تواند برای انتخاب اینکه کدام مجموعه نام ثبات در طول دی‌اسمبل استفاده شود به کار رود. تعیین
.B \-M reg\-names\-std
(پیش‌فرض) نام‌های ثبات را همان‌طور که در اسناد مجموعه دستورالعمل ARM استفاده شده انتخاب می‌کند، اما با این تفاوت که ثبات ۱۳ به نام
.BR \*(Aqsp\*(Aq ،
ثبات ۱۴ به نام
.B \*(Aqlr\*(Aq
و ثبات ۱۵ به نام
.B \*(Aqpc\*(Aq
نامیده می‌شوند. تعیین
.B \-M reg\-names\-apcs
مجموعه نام‌های مورد استفاده توسط استاندارد فراخوانی رویه ARM را انتخاب می‌کند، در حالی که تعیین
.B \-M reg\-names\-raw
صرفاً از
.B r
به همراه شماره ثبات استفاده خواهد کرد.
.Sp
همچنین دو نسخه دیگر از طرح نام‌گذاری ثبات APCS وجود دارد که توسط
.B \-M reg\-names\-atpcs
و
.B \-M reg\-names\-special\-atpcs
فعال می‌شوند و از قراردادهای نام‌گذاری استاندارد فراخوانی رویه ARM/Thumb استفاده می‌کنند (خواه با نام‌های معمولی ثبات یا نام‌های خاص ثبات).
.Sp
این گزینه همچنین می‌تواند برای معماری‌های ARM به منظور وادار کردن دی‌اسمبلر به تفسیر تمام دستورالعمل‌ها به عنوان دستورالعمل‌های Thumb با استفاده از سوییچ
.B \-\-disassembler\-options=force\-thumb
استفاده شود. این هنگام تلاش برای دی‌اسمبل کردن کد thumb تولیدشده توسط کامپایلرهای دیگر می‌تواند مفید باشد.
.Sp
برای اهداف AArch64 این سوییچ می‌تواند برای تنظیم اینکه آیا دستورالعمل‌ها به عنوان عمومی‌ترین دستورالعمل با استفاده از گزینه
.B \-M no\-aliases
دی‌اسمبل شوند، یا اینکه نکات دستورالعمل باید به صورت کامنت در دی‌اسمبل با استفاده از
.B \-M notes
تولید شوند، استفاده شود. علاوه بر این، گزینه
.B \-M annotate
می‌تواند برای سفارشی‌سازی نحوه رسیدگی به دستورالعمل‌های تعریف‌نشده هنگام دی‌اسمبل فایل‌های اجرایی و کتابخانه‌های اشتراکی استفاده شود. معمولاً دی‌اسمبلر فقط مقدار هگزادسیمال دستورالعمل تعریف‌نشده را نشان می‌دهد، اما اگر یادداشت‌گذاری فعال باشد، ابتدا سعی می‌کند نمادی را پیدا کند که مقدار آن با رمزگذاری دستورالعمل مطابقت دارد. اگر تطابقی وجود داشته باشد، نام نماد به جای آن نمایش داده خواهد شد. این ویژگی می‌تواند هنگام دی‌اسمبل کردن بخش‌های غیرکد که ممکن است حاوی آدرس‌های توابع و داده‌ها باشند، مفید باشد.
.Sp
برای x86، برخی از گزینه‌ها عملکردهای سوییچ
.B \-m
را تکرار می‌کنند، اما کنترل دقیق‌تری را فراهم می‌سازند.
.RS 4
.ie n .IP """x86\-64""" 4
.el .IP \f(CWx86\-64\fR 4
.IX Item "x86-64"
.PD 0
.ie n .IP """i386""" 4
.el .IP \f(CWi386\fR 4
.IX Item "i386"
.ie n .IP """i8086""" 4
.el .IP \f(CWi8086\fR 4
.IX Item "i8086"
.PD
دی‌اسمبل را برای معماری داده‌شده انتخاب می‌کند.
.ie n .IP """intel""" 4
.el .IP \f(CWintel\fR 4
.IX Item "intel"
.PD 0
.ie n .IP """att""" 4
.el .IP \f(CWatt\fR 4
.IX Item "att"
.PD
بین حالت نگارش اینتل (intel) و حالت نگارش AT&T انتخاب می‌کند.
.ie n .IP """amd64""" 4
.el .IP \f(CWamd64\fR 4
.IX Item "amd64"
.PD 0
.ie n .IP """intel64""" 4
.el .IP \f(CWintel64\fR 4
.IX Item "intel64"
.PD
بین AMD64 ISA و Intel64 ISA انتخاب می‌کند.
.ie n .IP """intel\-mnemonic""" 4
.el .IP \f(CWintel\-mnemonic\fR 4
.IX Item "intel-mnemonic"
.PD 0
.ie n .IP """att\-mnemonic""" 4
.el .IP \f(CWatt\-mnemonic\fR 4
.IX Item "att-mnemonic"
.PD
بین حالت یادآور اینتل و حالت یادآور AT&T انتخاب می‌کند.
توجه: \f(CW\*(C`intel\-mnemonic\*(C'\fR مستلزم \f(CW\*(C`intel\*(C'\fR و \f(CW\*(C`att\-mnemonic\*(C'\fR مستلزم \f(CW\*(C`att\*(C'\fR است.
.ie n .IP """addr64""" 4
.el .IP \f(CWaddr64\fR 4
.IX Item "addr64"
.PD 0
.ie n .IP """addr32""" 4
.el .IP \f(CWaddr32\fR 4
.IX Item "addr32"
.ie n .IP """addr16""" 4
.el .IP \f(CWaddr16\fR 4
.IX Item "addr16"
.ie n .IP """data32""" 4
.el .IP \f(CWdata32\fR 4
.IX Item "data32"
.ie n .IP """data16""" 4
.el .IP \f(CWdata16\fR 4
.IX Item "data16"
.PD
اندازه پیش‌فرض آدرس و اندازه عملوند را مشخص می‌کند. اگر \f(CW\*(C`x86\-64\*(C'\fR، \f(CW\*(C`i386\*(C'\fR یا \f(CW\*(C`i8086\*(C'\fR بعداً در رشته گزینه ظاهر شوند، این پنج گزینه نادیده گرفته خواهند شد.
.ie n .IP """suffix""" 4
.el .IP \f(CWsuffix\fR 4
.IX Item "suffix"
هنگام قرار داشتن در حالت AT&T و همچنین برای مجموعه محدودی از دستورالعمل‌ها در حالت Intel، به دی‌اسمبلر دستور می‌دهد که یک پسوند یادآور را حتی زمانی که پسوند می‌تواند از عملوندها یا (برای دستورالعمل‌های خاص) از پیش‌فرض‌های حالت اجرا استنباط شود، چاپ کند.
.ie n .IP """annotate\-immediates""" 4
.el .IP \f(CWannotate\-immediates\fR 4
.IX Item "annotate-immediates"
نماد مرتبط با مقادیر فوری را، در صورت وجود، نمایش می‌دهد. فقط بر روی فایل‌های باینری اجرایی و کتابخانه‌های اشتراکی کار می‌کند، نه فایل‌های شیء استاتیک.
.RE
.RS 4
.Sp
برای PowerPC، آرگومان
.B raw
از گزینه
.B \-M
دی‌اسمبل دستورالعمل‌های سخت‌افزاری را به جای نام‌های مستعار انتخاب می‌کند. برای نمونه، به جای \f(CW\*(C`clrlwi\*(C'\fR عبارت \f(CW\*(C`rlwinm\*(C'\fR، و به جای \f(CW\*(C`li\*(C'\fR عبارت \f(CW\*(C`addi\*(C'\fR را خواهید دید. تمام آرگومان‌های
.B \-m
برای
.B gas
که یک پردازنده (CPU) را انتخاب می‌کنند، پشتیبانی می‌شوند. این مقادیر عبارتند از:
\&\fB403\fR, \fB405\fR, \fB440\fR, \fB464\fR, \fB476\fR,
\&\fB601\fR, \fB603\fR, \fB604\fR, \fB620\fR, \fB7400\fR,
\&\fB7410\fR, \fB7450\fR, \fB7455\fR, \fB750cl\fR,
\&\fB821\fR, \fB850\fR, \fB860\fR, \fBa2\fR, \fBbooke\fR,
\&\fBbooke32\fR, \fBcell\fR, \fBcom\fR, \fBe200z2\fR, \fBe200z4\fR,
\&\fBe300\fR, \fBe500\fR, \fBe500mc\fR, \fBe500mc64\fR,
\&\fBe500x2\fR, \fBe5500\fR, \fBe6500\fR, \fBefs\fR,
\&\fBpower4\fR, \fBpower5\fR, \fBpower6\fR, \fBpower7\fR,
\&\fBpower8\fR, \fBpower9\fR, \fBpower10\fR, \fBpower11\fR,
\&\fBppc\fR, \fBppc32\fR, \fBppc64\fR, \fBppc64bridge\fR,
\&\fBppcps\fR, \fBpwr\fR, \fBpwr2\fR, \fBpwr4\fR, \fBpwr5\fR,
\&\fBpwr5x\fR, \fBpwr6\fR, \fBpwr7\fR, \fBpwr8\fR, \fBpwr9\fR,
\&\fBpwr10\fR, \fBpwr11\fR, \fBpwrx\fR, \fBtitan\fR, \fBvle\fR
و
\&\fBfuture\fR.
گزینه‌های
.B 32
و
.B 64
انتخاب پیش‌فرض یا قبلی پردازنده را تغییر داده و به ترتیب دستورالعمل‌های ۶۴ بیتی را غیرفعال و فعال می‌کنند. علاوه بر این،
.BR altivec ،
.BR any ،
.BR lsp ،
.BR htm ،
.BR vsx ،
.B spe
و
.B spe2
قابلیت‌هایی را به پردازنده انتخاب‌شده قبلی
.I یا بعدی
اضافه می‌کنند.
گزینه
.B any
هر آپ‌کد شناخته‌شده برای binutils را دی‌اسمبل می‌کند، اما در مواردی که یک آپ‌کد دارای دو معنای متفاوت یا آرگومان‌های متفاوت است، ممکن است خروجی مورد انتظار خود را مشاهده نکنید. اگر بدون تعیین پردازنده دی‌اسمبل کنید، یک پیش‌فرض بر اساس اطلاعات استخراج‌شده توسط BFD از هدرهای فایل‌های شیء انتخاب خواهد شد، اما نتیجه باز هم ممکن است مطابق انتظار شما نباشد.
.Sp
برای RISC-V، گزینه‌های زیر پشتیبانی می‌شوند:
.ie n .IP """max""" 4
.el .IP \f(CWmax\fR 4
.IX Item "max"
دی‌اسمبل بدون بررسی رشته معماری. این یک حالت مبتنی بر بهترین تلاش است، بنابراین برای پسوندهای تداخلی ISA، اولین تطابق (که احتمالاً در یک زمینه خاص نادرست است) برای رمزگشایی دستورالعمل استفاده خواهد شد. این مورد در صورتی مفید است که فایل ELF رشته ISA را نمایش ندهد، که مانع استنباط خودکار زیرمجموعه ISA می‌شود، و رشته پیش‌فرض جایگزین ISA (\f(CW\*(C`rv64gc\*(C'\fR) تمام دستورالعمل‌های باینری را پوشش نمی‌دهد.
.ie n .IP """numeric""" 4
.el .IP \f(CWnumeric\fR 4
.IX Item "numeric"
چاپ نام‌های عددی ثبات‌ها به جای نام‌های ABI (برای نمونه، چاپ \f(CW\*(C`x2\*(C'\fR به جای \f(CW\*(C`sp\*(C'\fR).
.ie n .IP """no\-aliases""" 4
.el .IP \f(CWno\-aliases\fR 4
.IX Item "no-aliases"
دی‌اسمبل صرفاً به دستورالعمل‌های استاندارد و متعارف (canonical). برای نمونه، دستورالعمل‌های فشرده‌شده به همان صورت نمایش داده می‌شوند (\f(CW\*(C`addi sp,sp,\-128\*(C'\fR به صورت \f(CW\*(C`c.addi16sp sp,\-128\*(C'\fR خواهد بود).
.ie n .IP """priv\-spec=\fISPEC\fR""" 4
.el .IP \f(CWpriv\-spec=\fR\f(CISPEC\fR\f(CW\fR 4
.IX Item "priv-spec=SPEC"
چاپ CSR مطابق با نسخه مشخصات سطح دسترسی انتخاب‌شده (مانند \f(CW1.10\fR، \f(CW1.11\fR، \f(CW1.12\fR، \f(CW1.13\fR).
.RE
.RS 4
.Sp
برای MIPS، این گزینه چاپ نام‌های یادآور دستورالعمل و نام‌های ثبات‌ها را در دستورالعمل‌های دی‌اسمبل‌شده کنترل می‌کند. انتخاب‌های چندگانه از موارد زیر را می‌توان به صورت یک رشته جداشده با کاما مشخص کرد، و گزینه‌های نامعتبر نادیده گرفته می‌شوند:
.ie n .IP """no\-aliases""" 4
.el .IP \f(CWno\-aliases\fR 4
.IX Item "no-aliases"
چاپ یادآور دستورالعمل «خام» به جای یادآور شبه‌دستورالعمل. به عنوان مثال، چاپ \*(Aqdaddu\*(Aq یا \*(Aqor\*(Aq به جای \*(Aqmove\*(Aq، یا \*(Aqsll\*(Aq به جای \*(Aqnop\*(Aq و غیره.
.ie n .IP """msa""" 4
.el .IP \f(CWmsa\fR 4
.IX Item "msa"
دی‌اسمبل کردن دستورالعمل‌های MSA.
.ie n .IP """virt""" 4
.el .IP \f(CWvirt\fR 4
.IX Item "virt"
دی‌اسمبل کردن دستورالعمل‌های مجازی‌سازی ASE.
.ie n .IP """xpa""" 4
.el .IP \f(CWxpa\fR 4
.IX Item "xpa"
دی‌اسمبل کردن دستورالعمل‌های ASE مربوط به آدرس فیزیکی گسترش‌یافته (XPA).
.ie n .IP """gpr\-names=\fIABI\fR""" 4
.el .IP \f(CWgpr\-names=\fR\f(CIABI\fR\f(CW\fR 4
.IX Item "gpr-names=ABI"
چاپ نام‌های GPR (ثبات همه‌منظوره) متناسب با ABI مشخص‌شده. به طور پیش‌فرض، نام‌های GPR بر اساس ABI باینری در حال دی‌اسمبل انتخاب می‌شوند.
.ie n .IP """fpr\-names=\fIABI\fR""" 4
.el .IP \f(CWfpr\-names=\fR\f(CIABI\fR\f(CW\fR 4
.IX Item "fpr-names=ABI"
چاپ نام‌های FPR (ثبات ممیز شناور) متناسب با ABI مشخص‌شده. به طور پیش‌فرض، شماره‌های FPR به جای نام‌ها چاپ می‌شوند.
.ie n .IP """cp0\-names=\fIARCH\fR""" 4
.el .IP \f(CWcp0\-names=\fR\f(CIARCH\fR\f(CW\fR 4
.IX Item "cp0-names=ARCH"
چاپ نام‌های ثبات CP0 (کمک‌پردازنده کنترل سیستم؛ کمک‌پردازنده ۰) متناسب با CPU یا معماری مشخص‌شده با
.IR ARCH .
به طور پیش‌فرض، نام‌های ثبات CP0 بر اساس معماری و پردازنده فایل باینری در حال دی‌اسمبل انتخاب می‌شوند.
.ie n .IP """hwr\-names=\fIARCH\fR""" 4
.el .IP \f(CWhwr\-names=\fR\f(CIARCH\fR\f(CW\fR 4
.IX Item "hwr-names=ARCH"
چاپ نام‌های HWR (ثبات سخت‌افزاری، مورد استفاده دستورالعمل \f(CW\*(C`rdhwr\*(C'\fR) متناسب با CPU یا معماری مشخص‌شده با
.IR ARCH .
به طور پیش‌فرض، نام‌های HWR بر اساس معماری و پردازنده باینری در حال دی‌اسمبل انتخاب می‌شوند.
.ie n .IP """reg\-names=\fIABI\fR""" 4
.el .IP \f(CWreg\-names=\fR\f(CIABI\fR\f(CW\fR 4
.IX Item "reg-names=ABI"
چاپ نام‌های GPR و FPR متناسب با ABI انتخاب‌شده.
.ie n .IP """reg\-names=\fIARCH\fR""" 4
.el .IP \f(CWreg\-names=\fR\f(CIARCH\fR\f(CW\fR 4
.IX Item "reg-names=ARCH"
چاپ نام‌های ثبات خاص پردازنده (ثبات CP0 و نام‌های HWR) متناسب با CPU یا معماری انتخاب‌شده.
.RE
.RS 4
.Sp
برای هر یک از گزینه‌های فهرست‌شده در بالا،
.I ABI
یا
.I ARCH
می‌تواند به صورت
.B numeric
مشخص شود تا برای انواع ثبات‌های انتخاب‌شده، به جای نام‌ها، شماره‌ها چاپ شوند. می‌توانید مقادیر موجود برای
.I ABI
و
.I ARCH
را با استفاده از گزینه
.B \-\-help
فهرست کنید.
.Sp
برای VAX، می‌توانید آدرس‌های ورودی تابع را با
.B \-M entry:0xf00ba
مشخص کنید. می‌توانید چندین بار از این گزینه برای دی‌اسمبل صحیح فایل‌های باینری VAX که فاقد جدول نمادها هستند (مانند تخلیه‌های حافظه ROM) استفاده کنید. در این موارد، ماسک ورودی تابع ممکن است در غیر این صورت به عنوان دستورالعمل‌های VAX رمزگشایی شود، که احتمالاً منجر به دی‌اسمبل نادرست بقیه تابع خواهد شد.
.RE
.IP \fB\-p\fR 4
.IX Item "-p"
.PD 0
.IP \fB\-\-private\-headers\fR 4
.IX Item "--private-headers"
.PD
اطلاعات اختصاصی مربوط به قالب فایل شیء را چاپ می‌کند. اطلاعات دقیق چاپ‌شده به قالب فایل شیء بستگی دارد. برای برخی از قالب‌های فایل شیء، هیچ اطلاعات اضافی چاپ نمی‌شود.
.IP "\fB\-P\fR \fIoptions\fR" 4
.IX Item "-P options"
.PD 0
.IP \fB\-\-private=\fR\fIoptions\fR 4
.IX Item "--private=options"
.PD
اطلاعات اختصاصی مربوط به قالب فایل شیء را چاپ می‌کند. آرگومان
\fIoptions\fR
فهرستی جداشده با کاما است که به قالب بستگی دارد (فهرست گزینه‌ها با راهنما نمایش داده می‌شود).
.Sp
برای XCOFF، گزینه‌های موجود عبارتند از:
.RS 4
.ie n .IP """header""" 4
.el .IP \f(CWheader\fR 4
.IX Item "header"
.PD 0
.ie n .IP """aout""" 4
.el .IP \f(CWaout\fR 4
.IX Item "aout"
.ie n .IP """sections""" 4
.el .IP \f(CWsections\fR 4
.IX Item "sections"
.ie n .IP """syms""" 4
.el .IP \f(CWsyms\fR 4
.IX Item "syms"
.ie n .IP """relocs""" 4
.el .IP \f(CWrelocs\fR 4
.IX Item "relocs"
.ie n .IP """lineno,""" 4
.el .IP \f(CWlineno,\fR 4
.IX Item "lineno,"
.ie n .IP """loader""" 4
.el .IP \f(CWloader\fR 4
.IX Item "loader"
.ie n .IP """except""" 4
.el .IP \f(CWexcept\fR 4
.IX Item "except"
.ie n .IP """typchk""" 4
.el .IP \f(CWtypchk\fR 4
.IX Item "typchk"
.ie n .IP """traceback""" 4
.el .IP \f(CWtraceback\fR 4
.IX Item "traceback"
.ie n .IP """toc""" 4
.el .IP \f(CWtoc\fR 4
.IX Item "toc"
.ie n .IP """ldinfo""" 4
.el .IP \f(CWldinfo\fR 4
.IX Item "ldinfo"
.PD
.RE
.RS 4
.Sp
برای PE، گزینه‌های موجود عبارتند از:
.ie n .IP """header""" 4
.el .IP \f(CWheader\fR 4
.IX Item "header"
.PD 0
.ie n .IP """sections""" 4
.el .IP \f(CWsections\fR 4
.IX Item "sections"
.PD
.RE
.RS 4
.Sp
همه قالب‌های شیء از این گزینه پشتیبانی نمی‌کنند؛ به‌ویژه قالب ELF از آن استفاده نمی‌کند.
.RE
.IP \fB\-r\fR 4
.IX Item "-r"
.PD 0
.IP \fB\-\-reloc\fR 4
.IX Item "--reloc"
.PD
ورودی‌های بازنشانی (relocation) فایل را چاپ می‌کند. اگر همراه با
.B \-d
یا
.B \-D
استفاده شود، بازنشانی‌ها به صورت درهم‌آمیخته با دیس‌اسمبل چاپ می‌شوند.
.IP \fB\-R\fR 4
.IX Item "-R"
.PD 0
.IP \fB\-\-dynamic\-reloc\fR 4
.IX Item "--dynamic-reloc"
.PD
ورودی‌های بازنشانی پویای فایل را چاپ می‌کند. این گزینه فقط برای اشیاء پویا معنادار است، مانند انواع خاصی از کتابخانه‌های اشتراکی. مانند
.BR \-r ،
اگر همراه با
.B \-d
یا
.B \-D
استفاده شود، بازنشانی‌ها به صورت درهم‌آمیخته با دیس‌اسمبل چاپ می‌شوند.
.Sp
توجه:
.B objdump
از نمایش بازنشانی‌های نوع RELR پشتیبانی نمی‌کند. این بازنشانی‌ها را می‌توان با برنامه
.B readelf
نمایش داد.
.IP \fB\-s\fR 4
.IX Item "-s"
.PD 0
.IP \fB\-\-full\-contents\fR 4
.IX Item "--full-contents"
.PD
محتوای کامل بخش‌ها را نمایش می‌دهد؛ اغلب در ترکیب با
.B \-j
برای درخواست بخش‌های مشخص استفاده می‌شود. به‌طور پیش‌فرض تمامی بخش‌های غیرخالی و غیر bss نمایش داده می‌شوند. به‌طور پیش‌فرض هر بخش فشرده‌شده به شکل فشرده نمایش خواهد یافت. برای دیدن محتوا در حالت غیرفشرده، گزینه
.B \-Z
را به خط فرمان اضافه کنید.
.IP \fB\-S\fR 4
.IX Item "-S"
.PD 0
.IP \fB\-\-source\fR 4
.IX Item "--source"
.PD
در صورت امکان، کد منبع را به صورت درهم‌آمیخته با دیس‌اسمبل نمایش می‌دهد. به‌طور ضمنی
.B \-d
را فعال می‌کند.
.IP \fB\-\-show\-all\-symbols\fR 4
.IX Item "--show-all-symbols"
هنگام دیس‌اسمبل کردن، تمام نمادهایی را که با یک نشانی مشخص مطابقت دارند نمایش می‌دهد، نه فقط نماد اول را.
.IP \fB\-\-source\-comment[=\fR\fItxt\fR\fB]\fR 4
.IX Item "--source-comment[=txt]"
مشابه گزینه
.BR \-S ،
اما تمام خطوط کد منبع با پیشوند
\fItxt\fR
نمایش داده می‌شوند. معمولاً
\fItxt\fR
یک رشته توضیح (کامنت) خواهد بود که می‌تواند برای تمایز کد اسمبلی از کد منبع استفاده شود. اگر
\fItxt\fR
مشخص نشود، رشته پیش‌فرض
\fI"# "\fR
(علامت هش و به دنبال آن یک فاصله) استفاده خواهد شد.
.IP \fB\-\-prefix=\fR\fIprefix\fR 4
.IX Item "--prefix=prefix"
یک
\fIprefix\fR
(پیشوند) را برای اضافه شدن به مسیرهای مطلق هنگام استفاده با
.B \-S
مشخص می‌کند.
.IP \fB\-\-prefix\-strip=\fR\fIlevel\fR 4
.IX Item "--prefix-strip=level"
مشخص می‌کند چه تعداد از نام‌های دایرکتوری ابتدایی از مسیرهای مطلق ثابت حذف شوند. این گزینه بدون
.B \-\-prefix=\fIprefix\fR
هیچ اثری ندارد.
.IP \fB\-\-show\-raw\-insn\fR 4
.IX Item "--show-raw-insn"
هنگام دیس‌اسمبل دستورالعمل‌ها، بایت‌های دستور را علاوه بر شکل نمادین، به صورت هگزادسیمال نیز چاپ می‌کند. این رفتار پیش‌فرض است، مگر زمانی که از
.B \-\-prefix\-addresses
استفاده شود.
.IP \fB\-\-no\-show\-raw\-insn\fR 4
.IX Item "--no-show-raw-insn"
هنگام دیس‌اسمبل دستورالعمل‌ها، بایت‌های دستور را چاپ نمی‌کند. این حالت پیش‌فرض هنگام استفاده از
.B \-\-prefix\-addresses
است.
.IP \fB\-\-insn\-width=\fR\fIwidth\fR 4
.IX Item "--insn-width=width"
هنگام دیس‌اسمبل دستورالعمل‌ها، تعداد
\fIwidth\fR
بایت را در یک خط نمایش می‌دهد.
.IP \fB\-\-visualize\-jumps[=color|=extended\-color|=off]\fR 4
.IX Item "--visualize-jumps[=color|=extended-color|=off]"
پرش‌هایی را که داخل یک تابع باقی می‌مانند، با کشیدن طرح‌های اسکی (ASCII art) بین نشانی‌های مبدا و مقصد مصورسازی می‌کند. آرگومان اختیاری
.B =color
با استفاده از رنگ‌های ساده ترمینال، رنگ را به خروجی اضافه می‌کند. متناوباً آرگومان
.B =extended\-color
رنگ را با استفاده از رنگ‌های ۸بیتی اضافه می‌کند، اما این رنگ‌ها ممکن است روی همه ترمینال‌ها کار نکنند.
.Sp
اگر لازم باشد گزینه
.B visualize\-jumps
پس از فعال‌سازی قبلی غیرفعال شود، از
.B visualize\-jumps=off
استفاده کنید.
.IP \fB\-\-disassembler\-color=off\fR 4
.IX Item "--disassembler-color=off"
.PD 0
.IP \fB\-\-disassembler\-color=terminal\fR 4
.IX Item "--disassembler-color=terminal"
.IP \fB\-\-disassembler\-color=on|color|colour\fR 4
.IX Item "--disassembler-color=on|color|colour"
.IP \fB\-\-disassembler\-color=extended|extended\-color|extended\-colour\fR 4
.IX Item "--disassembler-color=extended|extended-color|extended-colour"
.PD
استفاده از برجسته‌سازی رنگی نحو (Syntax Highlighting) را در خروجی دیس‌اسمبل فعال یا غیرفعال می‌کند. رفتار پیش‌فرض از طریق یک گزینه زمان پیکربندی تعیین می‌شود. توجه داشته باشید، همه معماری‌ها از برجسته‌سازی رنگی نحو پشتیبانی نمی‌کنند، و بسته به ترمینال استفاده‌شده، خروجی رنگی ممکن است در عمل خوانا نباشد.
.Sp
آرگومان
.B on
با استفاده از رنگ‌های ساده ترمینال، رنگ‌ها را اضافه می‌کند.
.Sp
آرگومان
.B terminal
همان کار را انجام می‌دهد، اما تنها در صورتی که دستگاه خروجی یک ترمینال باشد.
.Sp
آرگومان
.B extended\-color
مشابه آرگومان
.B on
است، اما از رنگ‌های ۸بیتی استفاده می‌کند. این رنگ‌ها ممکن است روی همه ترمینال‌ها کار نکنند.
.Sp
آرگومان
.B off
دیس‌اسمبل رنگی را غیرفعال می‌کند.
.IP \fB\-W[lLiaprmfFsoORtUuTgAckK]\fR 4
.IX Item "-W[lLiaprmfFsoORtUuTgAckK]"
.PD 0
.IP \fB\-\-dwarf[=rawline,=decodedline,=info,=abbrev,=pubnames,=aranges,=macro,=frames,=frames\-interp,=str,=str\-offsets,=loc,=Ranges,=pubtypes,=trace_info,=trace_abbrev,=trace_aranges,=gdb_index,=addr,=cu_index,=links,=follow\-links]\fR 4
.IX Item "--dwarf[=rawline,=decodedline,=info,=abbrev,=pubnames,=aranges,=macro,=frames,=frames-interp,=str,=str-offsets,=loc,=Ranges,=pubtypes,=trace_info,=trace_abbrev,=trace_aranges,=gdb_index,=addr,=cu_index,=links,=follow-links]"
.PD
محتوای بخش‌های اشکال‌زدایی DWARF را در فایل، در صورت وجود، نمایش می‌دهد. بخش‌های اشکال‌زدایی فشرده‌شده پیش از نمایش، به‌طور خودکار (و موقت) از حالت فشرده خارج می‌شوند. اگر یک یا چند حرف یا کلمه اختیاری به دنبال این سوییچ بیاید، تنها همان نوع از داده‌ها تخلیه (dump) خواهند شد. حروف و کلمات به اطلاعات زیر اشاره دارند:
.RS 4
.ie n .IP """a""" 4
.el .IP \f(CWa\fR 4
.IX Item "a"
.PD 0
.ie n .IP """=abbrev""" 4
.el .IP \f(CW=abbrev\fR 4
.IX Item "=abbrev"
.PD
محتوای بخش
.B .debug_abbrev
را نمایش می‌دهد.
.ie n .IP """A""" 4
.el .IP \f(CWA\fR 4
.IX Item "A"
.PD 0
.ie n .IP """=addr""" 4
.el .IP \f(CW=addr\fR 4
.IX Item "=addr"
.PD
محتوای بخش
.B .debug_addr
را نمایش می‌دهد.
.ie n .IP """c""" 4
.el .IP \f(CWc\fR 4
.IX Item "c"
.PD 0
.ie n .IP """=cu_index""" 4
.el .IP \f(CW=cu_index\fR 4
.IX Item "=cu_index"
.PD
محتوای بخش‌های
.B .debug_cu_index
و/یا
.B .debug_tu_index
را نمایش می‌دهد.
.ie n .IP """f""" 4
.el .IP \f(CWf\fR 4
.IX Item "f"
.PD 0
.ie n .IP """=frames""" 4
.el .IP \f(CW=frames\fR 4
.IX Item "=frames"
.PD
محتوای خام یک بخش
.B .debug_frame
را نمایش می‌دهد.
.ie n .IP """F""" 4
.el .IP \f(CWF\fR 4
.IX Item "F"
.PD 0
.ie n .IP """=frames\-interp""" 4
.el .IP \f(CW=frames\-interp\fR 4
.IX Item "=frames-interp"
.PD
محتوای تفسیرشده یک بخش
.B .debug_frame
را نمایش می‌دهد.
.ie n .IP """g""" 4
.el .IP \f(CWg\fR 4
.IX Item "g"
.PD 0
.ie n .IP """=gdb_index""" 4
.el .IP \f(CW=gdb_index\fR 4
.IX Item "=gdb_index"
.PD
محتوای بخش‌های
.B .gdb_index
و/یا
.B .debug_names
را نمایش می‌دهد.
.ie n .IP """i""" 4
.el .IP \f(CWi\fR 4
.IX Item "i"
.PD 0
.ie n .IP """=info""" 4
.el .IP \f(CW=info\fR 4
.IX Item "=info"
.PD
محتوای بخش
.B .debug_info
را نمایش می‌دهد. توجه: خروجی این گزینه همچنین می‌تواند با استفاده از گزینه‌های
.B \-\-dwarf\-depth
و
.B \-\-dwarf\-start
محدود شود.
.ie n .IP """k""" 4
.el .IP \f(CWk\fR 4
.IX Item "k"
.PD 0
.ie n .IP """=links""" 4
.el .IP \f(CW=links\fR 4
.IX Item "=links"
.PD
محتوای بخش‌های
.BR .gnu_debuglink ،
.B .gnu_debugaltlink
و
.B .debug_sup
را در صورت وجود هر یک از آن‌ها نمایش می‌دهد. همچنین هرگونه پیوند به فایل‌های شیء DWARF مجزا (dwo) را در صورتی که توسط مشخصه‌های DW_AT_GNU_dwo_name یا DW_AT_dwo_name در بخش
.B .debug_info
مشخص شده باشند، نمایش می‌دهد.
.ie n .IP """K""" 4
.el .IP \f(CWK\fR 4
.IX Item "K"
.PD 0
.ie n .IP """=follow\-links""" 4
.el .IP \f(CW=follow\-links\fR 4
.IX Item "=follow-links"
.PD
محتوای هر یک از بخش‌های اشکال‌زدایی انتخاب‌شده را که در فایل(های) مجزای پیوندشده اطلاعات اشکال‌زدایی یافت شوند نمایش می‌دهد. این امر ممکن است منجر به نمایش چند نسخه از یک بخش اشکال‌زدایی شود، اگر در بیش از یک فایل وجود داشته باشد.
.Sp
علاوه بر این، هنگام نمایش مشخصه‌های DWARF، اگر فرمی یافت شود که به فایل مجزای اطلاعات اشکال‌زدایی ارجاع می‌دهد، محتوای ارجاع‌شده نیز نمایش داده خواهد شد.
.Sp
توجه \- در برخی توزیع‌ها این گزینه به‌طور پیش‌فرض فعال است. می‌توان آن را از طریق گزینه اشکال‌زدایی
.B N
غیرفعال کرد. پیش‌فرض را می‌توان هنگام پیکربندی binutils از طریق گزینه‌های
.B \-\-enable\-follow\-debug\-links=yes
یا
.B \-\-enable\-follow\-debug\-links=no
انتخاب کرد. اگر از این‌ها استفاده نشود، پیش‌فرض، فعال بودن دنبال کردن پیوندهای اشکال‌زدایی است.
.Sp
توجه \- اگر پشتیبانی از پروتکل debuginfod در زمان ساخت binutils فعال شده باشد، این گزینه همچنین شامل تلاشی برای تماس با هر یک از سرورهای debuginfod ذکرشده در متغیر محیطی
\fIDEBUGINFOD_URLS\fR
خواهد بود. حل و فصل این مورد ممکن است مدتی زمان ببرد. این رفتار را می‌توان از طریق گزینه اشکال‌زدایی
.B =do\-not\-use\-debuginfod
غیرفعال کرد.
.ie n .IP """N""" 4
.el .IP \f(CWN\fR 4
.IX Item "N"
.PD 0
.ie n .IP """=no\-follow\-links""" 4
.el .IP \f(CW=no\-follow\-links\fR 4
.IX Item "=no-follow-links"
.PD
دنبال کردن پیوندها به فایل‌های مجزای اطلاعات اشکال‌زدایی را غیرفعال می‌کند.
.ie n .IP """D""" 4
.el .IP \f(CWD\fR 4
.IX Item "D"
.PD 0
.ie n .IP """=use\-debuginfod""" 4
.el .IP \f(CW=use\-debuginfod\fR 4
.IX Item "=use-debuginfod"
.PD
در صورت نیاز به دنبال کردن پیوندهای اشکال‌زدایی، تماس با سرورهای debuginfod را فعال می‌کند. این رفتار پیش‌فرض است.
.ie n .IP """E""" 4
.el .IP \f(CWE\fR 4
.IX Item "E"
.PD 0
.ie n .IP """=do\-not\-use\-debuginfod""" 4
.el .IP \f(CW=do\-not\-use\-debuginfod\fR 4
.IX Item "=do-not-use-debuginfod"
.PD
هنگام نیاز به دنبال کردن پیوندهای اشکال‌زدایی، تماس با سرورهای debuginfod را غیرفعال می‌کند.
.ie n .IP """l""" 4
.el .IP \f(CWl\fR 4
.IX Item "l"
.PD 0
.ie n .IP """=rawline""" 4
.el .IP \f(CW=rawline\fR 4
.IX Item "=rawline"
.PD
محتوای بخش
.B .debug_line
را در یک قالب خام نمایش می‌دهد.
.ie n .IP """L""" 4
.el .IP \f(CWL\fR 4
.IX Item "L"
.PD 0
.ie n .IP """=decodedline""" 4
.el .IP \f(CW=decodedline\fR 4
.IX Item "=decodedline"
.PD
محتوای تفسیرشده بخش
.B .debug_line
را نمایش می‌دهد.
.ie n .IP """m""" 4
.el .IP \f(CWm\fR 4
.IX Item "m"
.PD 0
.ie n .IP """=macro""" 4
.el .IP \f(CW=macro\fR 4
.IX Item "=macro"
.PD
محتوای بخش‌های
.B .debug_macro
و/یا
.B .debug_macinfo
را نمایش می‌دهد.
.ie n .IP """o""" 4
.el .IP \f(CWo\fR 4
.IX Item "o"
.PD 0
.ie n .IP """=loc""" 4
.el .IP \f(CW=loc\fR 4
.IX Item "=loc"
.PD
محتوای بخش‌های
.B .debug_loc
و/یا
.B .debug_loclists
را نمایش می‌دهد.
.ie n .IP """O""" 4
.el .IP \f(CWO\fR 4
.IX Item "O"
.PD 0
.ie n .IP """=str\-offsets""" 4
.el .IP \f(CW=str\-offsets\fR 4
.IX Item "=str-offsets"
.PD
محتوای بخش
.B .debug_str_offsets
را نمایش می‌دهد.
.ie n .IP """p""" 4
.el .IP \f(CWp\fR 4
.IX Item "p"
.PD 0
.ie n .IP """=pubnames""" 4
.el .IP \f(CW=pubnames\fR 4
.IX Item "=pubnames"
.PD
محتوای بخش‌های
.B .debug_pubnames
و/یا
.B .debug_gnu_pubnames
را نمایش می‌دهد.
.ie n .IP """r""" 4
.el .IP \f(CWr\fR 4
.IX Item "r"
.PD 0
.ie n .IP """=aranges""" 4
.el .IP \f(CW=aranges\fR 4
.IX Item "=aranges"
.PD
محتوای بخش
.B .debug_aranges
را نمایش می‌دهد.
.ie n .IP """R""" 4
.el .IP \f(CWR\fR 4
.IX Item "R"
.PD 0
.ie n .IP """=Ranges""" 4
.el .IP \f(CW=Ranges\fR 4
.IX Item "=Ranges"
.PD
محتوای بخش‌های
.B .debug_ranges
و/یا
.B .debug_rnglists
را نمایش می‌دهد.
.ie n .IP """s""" 4
.el .IP \f(CWs\fR 4
.IX Item "s"
.PD 0
.ie n .IP """=str""" 4
.el .IP \f(CW=str\fR 4
.IX Item "=str"
.PD
محتوای بخش‌های
.BR .debug_str ،
.B .debug_line_str
و/یا
.B .debug_str_offsets
را نمایش می‌دهد.
.ie n .IP """t""" 4
.el .IP \f(CWt\fR 4
.IX Item "t"
.PD 0
.ie n .IP """=pubtype""" 4
.el .IP \f(CW=pubtype\fR 4
.IX Item "=pubtype"
.PD
محتوای بخش‌های
.B .debug_pubtypes
و/یا
.B .debug_gnu_pubtypes
را نمایش می‌دهد.
.ie n .IP """T""" 4
.el .IP \f(CWT\fR 4
.IX Item "T"
.PD 0
.ie n .IP """=trace_aranges""" 4
.el .IP \f(CW=trace_aranges\fR 4
.IX Item "=trace_aranges"
.PD
محتوای بخش
.B .trace_aranges
را نمایش می‌دهد.
.ie n .IP """u""" 4
.el .IP \f(CWu\fR 4
.IX Item "u"
.PD 0
.ie n .IP """=trace_abbrev""" 4
.el .IP \f(CW=trace_abbrev\fR 4
.IX Item "=trace_abbrev"
.PD
محتوای بخش
.B .trace_abbrev
را نمایش می‌دهد.
.ie n .IP """U""" 4
.el .IP \f(CWU\fR 4
.IX Item "U"
.PD 0
.ie n .IP """=trace_info""" 4
.el .IP \f(CW=trace_info\fR 4
.IX Item "=trace_info"
.PD
محتوای بخش
.B .trace_info
را نمایش می‌دهد.
.RE
.RS 4
.Sp
توجه: نمایش محتوای بخش‌های
.BR .debug_static_funcs ،
.B .debug_static_vars
و
.B debug_weaknames
در حال حاضر پشتیبانی نمی‌شود.
.RE
.IP \fB\-\-dwarf\-depth=\fR\fIn\fR 4
.IX Item "--dwarf-depth=n"
تخلیه بخش
\f(CW\*(C`.debug_info\*(C'\fR
را به
\fIn\fR
فرزند محدود می‌کند. این گزینه تنها با
.B \-\-debug\-dump=info
مفید است. حالت پیش‌فرض چاپ تمام DIEها است؛ مقدار ویژه 0 برای
\fIn\fR
نیز همین اثر را خواهد داشت.
.Sp
با یک مقدار غیر صفر برای
\fIn\fR،
واحدهای DIE در سطح
\fIn\fR
یا عمیق‌تر چاپ نخواهند شد. محدوده برای
\fIn\fR
بر پایه صفر است.
.IP \fB\-\-dwarf\-start=\fR\fIn\fR 4
.IX Item "--dwarf-start=n"
تنها DIEهایی را چاپ می‌کند که با DIE شماره
\fIn\fR
شروع می‌شوند. این گزینه تنها با
.B \-\-debug\-dump=info
مفید است.
.Sp
در صورت مشخص شدن، این گزینه از چاپ هرگونه اطلاعات هدر و تمام DIEهای پیش از DIE شماره
\fIn\fR
جلوگیری می‌کند. تنها هم‌سطح‌ها و فرزندان DIE مشخص‌شده چاپ خواهند شد.
.Sp
این گزینه می‌تواند همراه با
.B \-\-dwarf\-depth
استفاده شود.
.IP \fB\-\-dwarf\-check\fR 4
.IX Item "--dwarf-check"
بررسی‌های اضافی برای سازگاری اطلاعات Dwarf را فعال می‌کند.
.IP \fB\-\-debug\-dir=\fR\f(BIdir\fR 4
.IX Item "--debug-dir=dir"
هنگام جستجوی فایل‌های مجزای اطلاعات اشکال‌زدایی، دایرکتوری
\fIdir\fR
را جستجو می‌کند.
.IP \fB\-\-ctf[=\fR\fIsection\fR\fB]\fR 4
.IX Item "--ctf[=section]"
محتوای بخش CTF مشخص‌شده را نمایش می‌دهد. بخش‌های CTF خود شامل زیربخش‌های متعددی هستند که همگی به ترتیب نمایش داده می‌شوند.
.Sp
به‌طور پیش‌فرض، نام بخشی با نام
\fI.ctf\fR
را نمایش می‌دهد، که نام تولیدشده توسط
.B ld
است.
.IP \fB\-\-ctf\-parent=\fR\fImember\fR 4
.IX Item "--ctf-parent=member"
اگر بخش CTF شامل انواع تعریف‌شده به صورت مبهم باشد، شامل آرشیوی از چندین فرهنگ لغت CTF خواهد بود که همگی از یک فرهنگ لغت حاوی انواع غیرمبهم ارث‌بری می‌کنند. این عضو به‌طور پیش‌فرض مانند بخشی که شامل آن است،
\fI.ctf\fR
نامیده می‌شود، اما تغییر این نام با استفاده از تابع
\f(CW\*(C`ctf_link_set_memb_name_changer\*(C'\fR
در زمان پیوند ممکن است. هنگام نگاه کردن به آرشیوهای CTF که توسط یک لینکر که از تغییردهنده نام برای تغییر نام عضو آرشیو والد استفاده می‌کند ایجاد شده‌اند، می‌توان از
.B \-\-ctf\-parent
برای مشخص کردن نام استفاده‌شده برای والد بهره برد.
.IP \fB\-\-ctf\-parent\-section=\fR\fIsection\fR 4
.IX Item "--ctf-parent-section=section"
این گزینه به شما امکان می‌دهد برای فرهنگ لغت والد CTF حاوی انواع غیرمبهم، بخشی کاملاً متفاوت از فرهنگ‌های لغت فرزندی که شامل باقی‌مانده مبهم هستند انتخاب کنید. لینکر اشیاء ELF را با چنین ساختاری تولید نمی‌کند، اما برخی از لینکرهای متفرقه ممکن است این کار را انجام دهند. همچنین این کار برای بررسی CTF که به صورت چندین فایل خام نوشته شده تا با objcopy ترکیب شوند مناسب است؛ چرا که objcopy می‌تواند آن‌ها را در بخش‌های متفاوتی از ELF قرار دهد اما نمی‌تواند در اعضای متفاوتی از یک فرهنگ لغت واحد CTF بگذارد.
.IP \fB\-\-sframe[=\fR\fIsection\fR\fB]\fR 4
.IX Item "--sframe[=section]"
محتوای بخش SFrame مشخص‌شده را نمایش می‌دهد.
.Sp
به‌طور پیش‌فرض، نام بخشی با نام
\fI.sframe\fR
را نمایش می‌دهد، که نام تولیدشده توسط
.B ld
است.
.IP \fB\-G\fR 4
.IX Item "-G"
.PD 0
.IP \fB\-\-stabs\fR 4
.IX Item "--stabs"
.PD
محتوای کامل هر یک از بخش‌های درخواست‌شده را نمایش می‌دهد. محتوای بخش‌های .stab، .stab.index و .stab.excl را از یک فایل ELF نمایش می‌دهد. این گزینه تنها روی سیستم‌هایی (مانند Solaris 2.0) مفید است که ورودی‌های جدول نماد اشکال‌زدایی
\f(CW\*(C`.stab\*(C'\fR
در یک بخش ELF حمل می‌شوند. در بیشتر قالب‌های فایلی دیگر، ورودی‌های جدول نماد اشکال‌زدایی با نمادهای پیوند در هم آمیخته شده‌اند و در خروجی
.B \-\-syms
قابل مشاهده هستند.
.IP \fB\-\-start\-address=\fR\fIaddress\fR 4
.IX Item "--start-address=address"
نمایش داده‌ها را از نشانی مشخص‌شده آغاز می‌کند. این گزینه بر خروجی گزینه‌های
.BR \-d ،
.B \-r
و
.B \-s
اثر می‌گذارد.
.IP \fB\-\-stop\-address=\fR\fIaddress\fR 4
.IX Item "--stop-address=address"
نمایش داده‌ها را در نشانی مشخص‌شده متوقف می‌کند. این گزینه بر خروجی گزینه‌های
.BR \-d ،
.B \-r
و
.B \-s
اثر می‌گذارد.
.IP \fB\-t\fR 4
.IX Item "-t"
.PD 0
.IP \fB\-\-syms\fR 4
.IX Item "--syms"
.PD
ورودی‌های جدول نماد (Symbol Table) فایل را چاپ می‌کند.
این گزینه مشابه اطلاعات ارائه‌شده توسط برنامه
\&\fBnm\fR
است، هرچند قالب نمایش تفاوت دارد. قالب خروجی بستگی به فرمت فایل مورد بررسی دارد، اما دو نوع اصلی وجود دارد. یکی از آن‌ها به این شکل است:
.Sp
.Vb 2
\&        [  4](sec  3)(fl 0x00)(ty   0)(scl   3) (nx 1) 0x00000000 .bss
\&        [  6](sec  1)(fl 0x00)(ty   0)(scl   2) (nx 0) 0x00000000 fred
.Ve
.Sp
که در آن عدد درون کروشه شماره ورودی در جدول نمادها است، عدد
\fIsec\fR
شماره بخش است، مقدار
\fIfl\fR
بیت‌های فلگ نماد است، عدد
\fIty\fR
نوع نماد است، عدد
\fIscl\fR
کلاس ذخیره‌سازی نماد و مقدار
\fInx\fR
تعداد ورودی‌های کمکی مرتبط با نماد است. دو فیلد آخر مقدار نماد و نام آن هستند.
.Sp
فرمت خروجی متداول دیگر که معمولاً در فایل‌های مبتنی بر ELF دیده می‌شود، به شکل زیر است:
.Sp
.Vb 2
\&        00000000 l    d  .bss   00000000 .bss
\&        00000000 g       .text  00000000 fred
.Ve
.Sp
در اینجا عدد اول مقدار نماد است (که گاهی اوقات به عنوان نشانی آن شناخته می‌شود). فیلد بعدی در واقع مجموعه‌ای از کاراکترها و فاصله‌ها است که بیت‌های فلگ تنظیم‌شده روی نماد را نشان می‌دهند. این کاراکترها در ادامه شرح داده شده‌اند. فیلد بعدی بخشی است که نماد با آن مرتبط است، یا
\fI*ABS*\fR
اگر بخش مطلق باشد (یعنی به هیچ بخشی متصل نباشد)، یا
\fI*UND*\fR
اگر در فایلی که استخراج می‌شود به بخش ارجاع داده شده اما در آنجا تعریف نشده باشد.
.Sp
پس از نام بخش فیلد دیگری قرار دارد که یک عدد است؛ این عدد برای نمادهای مشترک اندازه تراز (Alignment) و برای نمادهای دیگر اندازه (Size) نماد است. در نهایت نام نماد نمایش داده می‌شود.
.Sp
کاراکترهای فلگ به ۷ گروه زیر تقسیم می‌شوند:
.RS 4
.ie n .IP """l""" 4
.el .IP \f(CWl\fR 4
.IX Item "l"
.PD 0
.ie n .IP """g""" 4
.el .IP \f(CWg\fR 4
.IX Item "g"
.ie n .IP """u""" 4
.el .IP \f(CWu\fR 4
.IX Item "u"
.ie n .IP """!""" 4
.el .IP \f(CW!\fR 4
.IX Item "!"
.PD
نماد یک نماد محلی (l)، سراسری (g)، سراسری منحصربه‌فرد (u)، نه سراسری و نه محلی (یک فاصله) یا هم سراسری و هم محلی (!) است. یک نماد می‌تواند به دلایل مختلفی نه محلی و نه سراسری باشد (مثلاً به این دلیل که برای اشکال‌زدایی استفاده می‌شود)، اما اگر هم‌زمان هم محلی و هم سراسری باشد احتمالاً نشان‌دهنده یک اشکال (باگ) است. نمادهای سراسری منحصربه‌فرد یک افزونه گنو به مجموعه استانداردهای پیوند نماد ELF هستند. برای چنین نمادی لینکر پویا تضمین می‌کند که در کل فرآیند تنها یک نماد با این نام و نوع مورد استفاده قرار گیرد.
.ie n .IP """w""" 4
.el .IP \f(CWw\fR 4
.IX Item "w"
نماد ضعیف (w / Weak) یا قوی (یک فاصله) است.
.ie n .IP """C""" 4
.el .IP \f(CWC\fR 4
.IX Item "C"
نماد نشان‌دهنده یک سازنده (C / Constructor) یا یک نماد معمولی (یک فاصله) است.
.ie n .IP """W""" 4
.el .IP \f(CWW\fR 4
.IX Item "W"
نماد یک نماد اخطار (W / Warning) یا یک نماد معمولی (یک فاصله) است. نام یک نماد اخطار پیامی است که در صورت ارجاع به نمادِ پس از نماد اخطار نمایش داده می‌شود.
.ie n .IP """I""" 4
.el .IP \f(CWI\fR 4
.IX Item "I"
.PD 0
.ie n .IP """i""" 4
.el .IP \f(CWi\fR 4
.IX Item "i"
.PD
نماد یک ارجاع غیرمستقیم به نمادی دیگر (I)، تابعی که باید در حین پردازش بازنشانی ارزیابی شود (i) یا یک نماد معمولی (یک فاصله) است.
.ie n .IP """d""" 4
.el .IP \f(CWd\fR 4
.IX Item "d"
.PD 0
.ie n .IP """D""" 4
.el .IP \f(CWD\fR 4
.IX Item "D"
.PD
نماد یک نماد اشکال‌زدایی (d)، یک نماد پویا (D) یا یک نماد معمولی (یک فاصله) است.
.ie n .IP """F""" 4
.el .IP \f(CWF\fR 4
.IX Item "F"
.PD 0
.ie n .IP """f""" 4
.el .IP \f(CWf\fR 4
.IX Item "f"
.ie n .IP """O""" 4
.el .IP \f(CWO\fR 4
.IX Item "O"
.PD
نماد نام یک تابع (F)، یک فایل (f)، یک شیء (O) یا فقط یک نماد معمولی (یک فاصله) است.
.RE
.RS 4
.RE
.IP \fB\-T\fR 4
.IX Item "-T"
.PD 0
.IP \fB\-\-dynamic\-syms\fR 4
.IX Item "--dynamic-syms"
.PD
ورودی‌های جدول نماد پویای فایل را چاپ می‌کند. این گزینه فقط برای اشیاء پویا مانند انواع خاصی از کتابخانه‌های اشتراکی معنادار است. این اطلاعات مشابه خروجی برنامه
\&\fBnm\fR
هنگام استفاده از گزینه
\&\fB\-D\fR
(\fB\-\-dynamic\fR)
است.
.Sp
فرمت خروجی مشابه فرمت ارائه‌شده توسط گزینه
\&\fB\-\-syms\fR
است، با این تفاوت که یک فیلد اضافی پیش از نام نماد درج می‌شود که اطلاعات نسخه مرتبط با نماد را ارائه می‌دهد. اگر این نسخه نسخه پیش‌فرضی باشد که باید هنگام تفکیک ارجاعات بدون نسخه به نماد استفاده شود، به همان صورت نمایش داده می‌شود؛ در غیر این صورت درون پرانتز قرار می‌گیرد.
.IP \fB\-\-special\-syms\fR 4
.IX Item "--special-syms"
هنگام نمایش نمادها، نمادهایی را که از نظر مقصد به نوعی خاص تلقی می‌شوند و معمولاً مورد توجه کاربر نیستند نیز شامل می‌شود.
.IP "\fB\-U\fR \fI[d|i|l|e|x|h]\fR" 4
.IX Item "-U [d|i|l|e|x|h]"
.PD 0
.IP \fB\-\-unicode=\fR\fI[default|invalid|locale|escape|hex|highlight]\fR 4
.IX Item "--unicode=[default|invalid|locale|escape|hex|highlight]"
.PD
نمایش کاراکترهای چندبایتی کدگذاری‌شده در فرمت UTF\-8 را در رشته‌ها کنترل می‌کند. پیش‌فرض (\fB\-\-unicode=default\fR) این است که با آن‌ها هیچ رفتار خاصی انجام نشود. گزینه
\&\fB\-\-unicode=locale\fR
توالی را در لوکال (محلی‌سازی) فعلی نمایش می‌دهد که ممکن است از آن‌ها پشتیبانی کند یا نکند. گزینه‌های
\&\fB\-\-unicode=hex\fR
و
\&\fB\-\-unicode=invalid\fR
آن‌ها را به صورت دنباله‌های بایت هگزادسیمال محصور در قلاب‌ها یا آکولادها نمایش می‌دهند.
.Sp
گزینه
\&\fB\-\-unicode=escape\fR
آن‌ها را به عنوان دنباله‌های اسکیپ (\fI\euxxxx\fR) نمایش می‌دهد و گزینه
\&\fB\-\-unicode=highlight\fR
آن‌ها را به صورت دنباله‌های اسکیپ برجسته‌شده با رنگ قرمز (در صورت پشتیبانی دستگاه خروجی) نشان می‌دهد. رنگ‌آمیزی برای جلب توجه به حضور توالی‌های یونیکد در جاهایی است که ممکن است انتظار آن‌ها نرود.
.IP \fB\-V\fR 4
.IX Item "-V"
.PD 0
.IP \fB\-\-version\fR 4
.IX Item "--version"
.PD
شماره نسخه
\&\fBobjdump\fR
را چاپ کرده و خارج می‌شود.
.IP \fB\-x\fR 4
.IX Item "-x"
.PD 0
.IP \fB\-\-all\-headers\fR 4
.IX Item "--all-headers"
.PD
تمام اطلاعات هدرهای موجود، از جمله جدول نمادها و ورودی‌های بازنشانی را نمایش می‌دهد. استفاده از
\&\fB\-x\fR
معادل تعیین تمام گزینه‌های
\&\fB\-a \-f \-h \-p \-r \-t\fR
است.
.IP \fB\-w\fR 4
.IX Item "-w"
.PD 0
.IP \fB\-\-wide\fR 4
.IX Item "--wide"
.PD
برخی خطوط را برای دستگاه‌های خروجی با بیش از ۸۰ ستون قالب‌بندی می‌کند. همچنین نام نمادها را هنگام نمایش کوتاه نمی‌کند.
.IP \fB\-z\fR 4
.IX Item "-z"
.PD 0
.IP \fB\-\-disassemble\-zeroes\fR 4
.IX Item "--disassemble-zeroes"
.PD
به‌طور معمول خروجی دیس‌اسمبل از بلوک‌های صفر صرف‌نظر می‌کند. این گزینه به دیس‌اسمبلر دستور می‌دهد که آن بلوک‌ها را نیز مانند هر داده دیگری دیس‌اسمبل کند.
.IP \fB\-Z\fR 4
.IX Item "-Z"
.PD 0
.IP \fB\-\-decompress\fR 4
.IX Item "--decompress"
.PD
گزینه
\&\fB\-Z\fR
برای استفاده همراه با گزینه
\&\fB\-s\fR
در نظر گرفته شده است. این گزینه به
\&\fBobjdump\fR
دستور می‌دهد هر بخش فشرده‌شده را قبل از نمایش محتوای آن از حالت فشرده خارج کند.
.IP \fB@\fR\fIfile\fR 4
.IX Item "@file"
گزینه‌های خط فرمان را از
\fIfile\fR
می‌خواند. گزینه‌های خوانده‌شده به جای گزینه اصلی
@\fIfile\fR
قرار می‌گیرند. اگر
\fIfile\fR
وجود نداشته باشد یا خوانده نشود، گزینه به صورت تحت‌اللفظی تلقی شده و حذف نخواهد شد.
.Sp
گزینه‌ها در
\fIfile\fR
با نویسه‌های فاصله‌ساز (Whitespace) از یکدیگر جدا می‌شوند. یک نویسه فاصله می‌تواند با محصور کردن کل گزینه در نقل‌قول تکی یا دوگانه در یک گزینه گنجانده شود. هر نویسه‌ای (از جمله بک‌اسلش) می‌تواند با قرار دادن یک بک‌اسلش پیش از آن اضافه شود. خود
\fIfile\fR
می‌تواند شامل گزینه‌های
@\fIfile\fR
دیگری باشد؛ هر یک از این گزینه‌ها به‌طور بازگشتی پردازش خواهند شد.
.SH "همچنین ببینید (SEE ALSO)"
.IX Header "همچنین ببینید (SEE ALSO)"
\&\fBnm\fR\|(1)، \fBreadelf\fR\|(1) و مدخل‌های Info برای \fIbinutils\fR.
