.SH "نام (NAME)"
buf-registry-plugin-create \- ایجاد یک افزونه BSR


.SH "خلاصه دستور (SYNOPSIS)"
\fBbuf registry plugin create  [flags]\fP


.SH "توضیحات (DESCRIPTION)"
ایجاد یک افزونه BSR


.SH "گزینه‌ها (OPTIONS)"
\fB--default-label-name\fP="main"
	نام برچسب پیش‌فرض پودمان (ماژول)

.PP
\fB--format\fP="text"
	قالب خروجی مورد استفاده. باید یکی از [text,json] باشد

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای create

.PP
\fB--type\fP=""
	نوع افزونه. باید یکی از [check] باشد

.PP
\fB--visibility\fP="private"
	تنظیمات نمایانی پودمان. باید یکی از [public,private] باشد


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--debug\fP[=false]
	فعال‌سازی ثبت گزارش اشکال‌زدایی (دیباگ)

.PP
\fB--log-format\fP="color"
	قالب ثبت گزارش [text,color,json]

.PP
\fB--timeout\fP=0s
	مدت زمان تا پایان مهلت زمانی (تایم‌اوت)، مقدار ۰ یعنی بدون مهلت زمانی


