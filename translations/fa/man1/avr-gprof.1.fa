.IX Title "AVR-GPROF 1"
.TH AVR-GPROF 1 2026-08-11 binutils-2.47 GNU
.if n .ad l
.nh
.SH "نام (NAME)"
avr-gprof \- نمایش داده‌های پروفایل اجرای برنامه برای معماری AVR
.SH "خلاصه دستور (SYNOPSIS)"
.IX Header "خلاصه دستور (SYNOPSIS)"
avr-gprof [ \-[abcDhilLrsTvwxyz] ] [ \-[ABCeEfFJnNOpPqQRStZ][\fIname\fR] ]
          [ \-I \fIdirs\fR ] [ \-d[\fInum\fR] ] [ \-k \fIfrom/to\fR ]
          [ \-m \fImin-count\fR ] [ \-t \fItable-length\fR ]
          [ \-\-[no-]annotated-source[=\fIname\fR] ]
          [ \-\-[no-]exec-counts[=\fIname\fR] ]
          [ \-\-[no-]flat-profile[=\fIname\fR] ]
          [ \-\-[no-]graph[=\fIname\fR] ]
          [ \-\-[no-]time=\fIname\fR ]
