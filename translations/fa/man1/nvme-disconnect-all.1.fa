.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
nvme-disconnect-all \- قطع اتصال از تمام کنترلرهای متصل Fabrics\&.
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.nf
\fInvme disconnect\-all\fR [\-\-output\-format=<fmt> | \-o <fmt>] [\-\-verbose | \-v]
.fi
.SH "توضیحات (DESCRIPTION)"
.sp
اتصال تمام کنترلرهای موجود NVMe over Fabrics را قطع کرده و آن‌ها را حذف می‌کند\&.
.sp
برای اطلاعات و پیش‌زمینه بیشتر، مستندات دستور nvme\-disconnect(1) را ببینید\&.
.SH "گزینه‌ها (OPTIONS)"
.PP
\-o <fmt>, \-\-output\-format=<fmt>
.RS 4
تنظیم قالب گزارش به
\fInormal\fR،
\fIjson\fR
یا
\fIbinary\fR\&. در هر لحظه تنها یک قالب خروجی قابل استفاده است\&.
.RE
.PP
\-v, \-\-verbose
.RS 4
افزایش میزان جزئیات اطلاعات در خروجی\&.
.RE
.SH "مثال‌ها (EXAMPLES)"
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
قطع اتصال تمام کنترلرهای موجود nvme:
.sp
.if n \{\
.RS 4
.\}
.nf
# nvme disconnect\-all
.fi
.if n \{\
.RE
.\}
.RE
.SH "همچنین ببینید (SEE ALSO)"
.sp
nvme\-disconnect(1)
.SH "NVME"
.sp
بخشی از مجموعهٔ nvme\-user
