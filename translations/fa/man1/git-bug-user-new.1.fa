.TH "GIT-BUG" "1" "Apr 2019" "Generated from git-bug's source code" ""

.SH "نام (NAME)"
git-bug-user-new \- ایجاد یک هویت جدید


.SH "خلاصه دستور (SYNOPSIS)"
\fBgit-bug user new [flags]\fP


.SH "توضیحات (DESCRIPTION)"
ایجاد یک هویت جدید


.SH "گزینه‌ها (OPTIONS)"
\fB-a\fP, \fB--avatar\fP=""
	نشانی اینترنتی آواتار

.PP
\fB-e\fP, \fB--email\fP=""
	ایمیل کاربر

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای new

.PP
\fB-n\fP, \fB--name\fP=""
	نام برای شناسایی کاربر

.PP
\fB--non-interactive\fP[=false]
	عدم درخواست ورودی از کاربر


.SH "همچنین ببینید (SEE ALSO)"
\fBgit-bug-user(1)\fP
