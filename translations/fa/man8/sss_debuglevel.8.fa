.TH "SSS_DEBUGLEVEL" "8" "2026/06/09" "SSSD" "صفحات راهنمای SSSD"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
sss_debuglevel \- [منسوخ‌شده] تغییر سطح اشکال‌زدایی هنگام اجرای SSSD
.SH "خلاصه دستور (SYNOPSIS)"
.HP \w'\fBsss_debuglevel\fR\ 'u
\fBsss_debuglevel\fR [\fIگزینه‌ها\fR] \fINEW_DEBUG_LEVEL\fR
.SH "توضیحات (DESCRIPTION)"
.PP
دستور
\fBsss_debuglevel\fR
منسوخ شده و با دستور sssctl debug\-level جایگزین شده است\&. لطفاً برای اطلاعات بیشتر درباره نحوه استفاده از sssctl به صفحه راهنمای
\fBsssctl\fR
مراجعه کنید\&.
.SH "همچنین ببینید (SEE ALSO)"
.PP
\fBsssd\fR(8),
\fBsssd.conf\fR(5),
\fBsssd-ldap\fR(5),
\fBsssd-ldap-attributes\fR(5),
\fBsssd-krb5\fR(5),
\fBsssd-simple\fR(5),
\fBsssd-ipa\fR(5),
\fBsssd-ad\fR(5),
\fBsssd-idp\fR(5),
\fBsssd-sudo\fR(5),
\fBsssd-session-recording\fR(5),
\fBsss_cache\fR(8),
\fBsss_debuglevel\fR(8),
\fBsss_obfuscate\fR(8),
\fBsss_seed\fR(8),
\fBsssd_krb5_locator_plugin\fR(8),
\fBsss_ssh_authorizedkeys\fR(1), \fBsss_ssh_knownhosts\fR(1),
\fBsssd-ifp\fR(5),
\fBpam_sss\fR(8)\&.
\fBsss_rpcidmapd\fR(5)
.SH "نویسندگان (AUTHORS)"
.PP
\fBتوسعه‌دهندگان بالادستی SSSD \- https://github.com/SSSD/sssd\fR
