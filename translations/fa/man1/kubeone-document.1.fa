.TH "KubeOne" "1" "Feb 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
kubeone-document \- Generates documentation


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubeone document  [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Documentation can be generated as man pages, markdown, restructured text docs or yaml


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	help for document

.PP
\fB-o\fP, \fB--output-dir\fP="/tmp/"
	Directory to populate with documentation


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--credentials\fP=""
	File to source credentials and secrets from

.PP
\fB-d\fP, \fB--debug\fP[=false]
	debug output with stacktrace

.PP
\fB-l\fP, \fB--log-format\fP="text"
	format for logging

.PP
\fB-m\fP, \fB--manifest\fP="./kubeone.yaml"
	Path to the KubeOne config

.PP
\fB-t\fP, \fB--tfjson\fP=""
	Source for terraform output in JSON - to read from stdin. If path is a file, contents will be used. If path is a dictionary, \fBterraform output -json\fR is executed in this path

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


.SH "مثال (EXAMPLE)"
.EX
kubeone document man
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubeone(1)\fP


