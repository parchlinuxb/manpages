.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-image-build \- ساخت یک ایمیج از یک Dockerfile


.SH "خلاصه دستور (SYNOPSIS)"
\fBdocker image build [OPTIONS] PATH | URL | -\fP


.SH "شرح (DESCRIPTION)"
نام مستعار برای \fBdocker build\fR\&.


.SH "گزینه‌ها (OPTIONS)"
\fB--add-host\fP=
	افزودن نگاشت سفارشی میزبان به IP ("host:ip")

.PP
\fB--build-arg\fP=
	تنظیم متغیرهای زمان ساخت

.PP
\fB--cache-from\fP=[]
	ایمیج‌هایی که باید به عنوان منابع حافظه موقت (cache) در نظر گرفته شوند

.PP
\fB--cgroup-parent\fP=""
	تنظیم cgroup والد برای دستورالعمل‌های "RUN" در هنگام ساخت

.PP
\fB--compress\fP[=false]
	فشرده‌سازی بافت ساخت (build context) با استفاده از gzip

.PP
\fB--cpu-period\fP=0
	محدود کردن دوره تناوب CPU CFS (زمان‌بند کاملاً منصفانه)

.PP
\fB--cpu-quota\fP=0
	محدود کردن سهمیه CPU CFS (زمان‌بند کاملاً منصفانه)

.PP
\fB-c\fP, \fB--cpu-shares\fP=0
	سهم‌های پردازنده (وزن نسبی)

.PP
\fB--cpuset-cpus\fP=""
	پردازنده‌هایی که اجرا در آن‌ها مجاز است (0-3, 0,1)

.PP
\fB--cpuset-mems\fP=""
	حافظه‌هایی (MEMs) که اجرا در آن‌ها مجاز است (0-3, 0,1)

.PP
\fB-f\fP, \fB--file\fP=""
	نام Dockerfile (پیش‌فرض "PATH/Dockerfile" است)

.PP
\fB--force-rm\fP[=false]
	حذف همیشگی کانتینرهای میانی

.PP
\fB--iidfile\fP=""
	نوشتن شناسه (ID) ایمیج در فایل

.PP
\fB--isolation\fP=""
	فناوری جداسازی کانتینر

.PP
\fB--label\fP=
	تنظیم متاداده برای یک ایمیج

.PP
\fB-m\fP, \fB--memory\fP=0
	محدودیت حافظه

.PP
\fB--memory-swap\fP=0
	محدودیت swap برابر با حافظه به علاوه swap: مقدار 1- برای نامحدود کردن swap

.PP
\fB--network\fP="default"
	تنظیم حالت شبکه برای دستورالعمل‌های RUN در حین ساخت

.PP
\fB--no-cache\fP[=false]
	عدم استفاده از حافظه پنهان (cache) هنگام ساخت ایمیج

.PP
\fB--platform\fP=""
	تنظیم بستر (platform) در صورتی که سرور قابلیت چندپلتفرمی داشته باشد

.PP
\fB--pull\fP[=false]
	تلاش همیشگی برای دریافت نسخه جدیدتر ایمیج

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	بی‌صدا کردن خروجی ساخت و چاپ شناسه ایمیج در صورت موفقیت

.PP
\fB--rm\fP[=true]
	حذف کانتینرهای میانی پس از ساخت موفقیت‌آمیز

.PP
\fB--security-opt\fP=[]
	گزینه‌های امنیتی

.PP
\fB--shm-size\fP=0
	اندازه "/dev/shm"

.PP
\fB--squash\fP[=false]
	ادغام لایه‌های تازه ساخته‌شده در یک لایه جدید تکی

.PP
\fB-t\fP, \fB--tag\fP=
	نام و در صورت تمایل یک برچسب در قالب "name:tag"

.PP
\fB--target\fP=""
	تنظیم مرحله ساخت مقصد برای ساخت

.PP
\fB--ulimit\fP=[]
	گزینه‌های ulimit


.SH "ببینید (SEE ALSO)"
\fBdocker-image(1)\fP
