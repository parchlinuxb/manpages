\fBfsck.ext2\fP(8) \fIیا\fP \fBfsck.ext3\fP(8) \fIیا\fP \fBe2fsck\fP(8),
\fBfsck.cramfs\fP(8),
\fBfsck.jfs\fP(8),
\fBfsck.nfs\fP(8),
