\&\fBdeb\-triggers\fR\|(5),
\&\fBdeb\-shlibs\fR\|(5),
\&\fBdeb\-symbols\fR\|(5),
\&\fBdeb\-preinst\fR\|(5),
\&\fBdeb\-postinst\fR\|(5),
\&\fBdeb\-prerm\fR\|(5),
\&\fBdeb\-postrm\fR\|(5).
