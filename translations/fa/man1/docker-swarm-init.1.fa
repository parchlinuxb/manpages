.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-swarm-init \- راه‌اندازی اولیه یک swarm


.SH "خلاصه (SYNOPSIS)"
\fBdocker swarm init [OPTIONS]\fP


.SH "شرح (DESCRIPTION)"
راه‌اندازی اولیه یک swarm


.SH "گزینه‌ها (OPTIONS)"
\fB--advertise-addr\fP=""
	نشانی تبلیغ‌شده (فرمت: "[:port]")

.PP
\fB--autolock\fP[=false]
	فعال‌سازی قفل خودکار مدیر (نیاز به کلید بازگشایی برای شروع یک مدیر متوقف‌شده)

.PP
\fB--availability\fP="active"
	در دسترس بودن گره ("active"، "pause"، "drain")

.PP
\fB--cert-expiry\fP=2160h0m0s
	مدت اعتبار گواهی‌های گره (ns|us|ms|s|m|h)

.PP
\fB--data-path-addr\fP=""
	نشانی یا رابط مورد استفاده برای ترافیک مسیر داده (فرمت: "")

.PP
\fB--data-path-port\fP=0
	شماره درگاه مورد استفاده برای ترافیک مسیر داده (1024 - 49151). اگر مقداری تنظیم نشود یا برابر 0 باشد، از درگاه پیش‌فرض (4789) استفاده می‌شود.

.PP
\fB--default-addr-pool\fP=[]
	استخر نشانی پیش‌فرض در قالب CIDR

.PP
\fB--default-addr-pool-mask-length\fP=24
	طول ماسک زیرشبکه استخر نشانی پیش‌فرض

.PP
\fB--dispatcher-heartbeat\fP=5s
	دوره زمانی ضربان قلب dispatcher (ns|us|ms|s|m|h)

.PP
\fB--external-ca\fP=
	مشخصات یک یا چند نقطه پایانی امضای گواهی

.PP
\fB--force-new-cluster\fP[=false]
	اجبار به ایجاد یک کلاستر جدید از وضعیت فعلی

.PP
\fB--listen-addr\fP=0.0.0.0:2377
	نشانی شنود (فرمت: "[:port]")

.PP
\fB--max-snapshots\fP=0
	تعداد اسنپ‌شات‌های Raft اضافی برای نگهداری

.PP
\fB--snapshot-interval\fP=10000
	تعداد ورودی‌های لاگ بین هر اسنپ‌شات Raft

.PP
\fB--task-history-limit\fP=5
	محدودیت نگهداری تاریخچه تسک‌ها


.SH "ببینید (SEE ALSO)"
\fBdocker-swarm(1)\fP
