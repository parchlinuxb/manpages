.TH "CRYPTSETUP\-FVAULT2DUMP" "8" "2026-07-21" "cryptsetup 2.8.7" "دستورهای مدیریتی سیستم"
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.ss \n[.ss] 0
.nh
.ad l
.de URL
\fI\\$2\fP <\\$1>\\$3
..
.als MTO URL
.if \n[.g] \{\
.  mso www.tmac
.  am URL
.    ad l
.  .
.  am MTO
.    ad l
.  .
