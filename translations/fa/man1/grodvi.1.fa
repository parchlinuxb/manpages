.
.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_grodvi_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.ie t .ds tx T\h'-.1667m'\v'.224m'E\v'-.224m'\h'-.125m'X
.el .ds tx TeX
.
.\" This macro definition is poor style from a portability standpoint,
.\" but it's a good test and demonstration of the standard font
.\" repertoire for the devices where it has any effect at all, and so
.\" should be retained.
.de FT
.  if \\n[.$] .if !F \\$1 .ftr \\$1 R
.  if '\\*(.T'dvi' .ft \\$1
..
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY grodvi
.RB [ \-dl ]
.RB [ \-F\~\c
.IR dir ]
.RB [ \-p\~\c
.IR paper-format ]
.RB [ \-w\~\c
.IR n ]
.RI [ file\~ .\|.\|.]
.YS
.
.
.P
.SY grodvi
.B \-\-help
.YS
.
.
.P
.SY grodvi
.B \-v
.YS
.
.SY grodvi
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
راه‌انداز خروجی DVI در
GNU
.I roff
خروجی
.MR \%troff 1
را به قالب DVI در \*[tx] ترجمه می‌کند.
.
به‌طور معمول،
.I grodvi
توسط
.MR groff 1
فراخوانی می‌شود، هنگامی که گزینه
.RB \[lq] \-T\~dvi \[rq]
به آن داده شده باشد.
.
(در این نصب،
.B \%ps
دستگاه خروجی پیش‌فرض است.)
.
برای ارسال هر یک از گزینه‌های بالا به
.IR grodvi ،
از گزینه
.B \-P
در
.IR groff
استفاده کنید.
.
اگر هیچ آرگومان
.I file
(پرونده) داده نشود،
یا اگر
.I file
برابر با \[lq]\-\[rq] باشد،
.I grodvi
ورودی استاندارد را می‌خواند.
.
این برنامه در خروجی استاندارد می‌نویسد.
.
.
.P
فایل DVI تولیدشده توسط
.I grodvi
توسط هر راه‌انداز DVI که به‌درستی نوشته شده باشد قابل تفسیر است.
.
دستورات پایه‌ای رسم در
.I troff \" generic
با استفاده از دستورات ویژه نسخه\~2 در
.I tpic
پیاده‌سازی شده‌اند.
.
اگر راه‌انداز از این موارد پشتیبانی نکند، توالی‌های گریز
.B \[rs]D
هیچ خروجی‌ای تولید نخواهند کرد.
.
.
.P
فایل‌های پست‌اسکریپت کپسوله‌شده (EPS) را می‌توان به‌آسانی درج کرد؛
از ماکروی
.B PSPIC
استفاده کنید.
.
فایل
.I pspic.tmac
به‌طور خودکار توسط
.I dvi.tmac
بارگذاری می‌شود.
.
.MR groff_tmac 5
را ببینید.
.
.
.P
رنگ پیش‌فرض استفاده‌شده توسط توالی‌های گریز
.B \[rs]m
و
.B \[rs]M
سیاه است.
.
در حال حاضر، رنگ خط برای توالی‌های گریز رسم
.B \[rs]D
سیاه است؛
مقادیر رنگ پر کردن به خاکستری تبدیل می‌شوند.
.
.
.P
در
.IR groff ،
همانند
.IR troff \" AT&T
مربوط به AT&T،
توالی گریز
.B \[rs]N
می‌تواند برای دسترسی به هر گلیف در قلم جاری از طریق موقعیت آن در فایل TFM متناظر استفاده شود.
.
.
.P
بر اساس طراحی، فرمت DVI اهمیتی به ابعاد فیزیکی رسانه خروجی نمی‌دهد.
.
زیربخش \[lq]دستورات افزونه دستگاه\[rq] در زیر را ببینید.
.
.
.\" ====================================================================
.SS "سبک‌های قلم (Typefaces)"
.\" ====================================================================
.
.I grodvi
از چهار سبک استاندارد پشتیبانی می‌کند:
.B R
(رومی / roman)،
.B I
.RI ( مورب\~/\~italic )،
.B B
.RB ( توپر\~/\~bold )،
و
.B BI
(\f[BI]توپر مورب / bold-italic\f[]).
.
قلم‌ها به دو خانواده
.B T
و
.B H
گروه‌بندی شده‌اند که دارای اعضایی در هر سبک هستند.
.
عبارت \[lq]CM\[rq] مخفف \[lq]Computer Modern\[rq] است.
.
.
.RS
.TP
.B TR
.FT TR
CM Roman (cmr10)
.FT
.
.TQ
.B TI
.FT TI
CM Text Italic (cmti10)
.FT
.
.TQ
.B TB
.FT TB
CM Bold Extended Roman (cmbx10)
.FT
.
.TQ
.B TBI
.FT TBI
CM Bold Extended Text Italic (cmbxti10)
.FT
.
.TQ
.B HR
.FT HR
CM Sans Serif (cmss10)
.FT
.
.TQ
.B HI
.FT HI
CM Slanted Sans Serif (cmssi10)
.FT
.
.TQ
.B HB
.FT HB
CM Sans Serif Bold Extended (cmssbx10)
.FT
.
.TQ
.B HBI
.FT HBI
CM Slanted Sans Serif Bold Extended (cmssbxo10)
.FT
.RE
.
.
.LP
قلم‌های زیر عضو هیچ خانواده‌ای نیستند:
.
.
.RS
.TP
.B CW
.FT CW
CM Typewriter Text (cmtt10)
.FT
.
.TQ
.B CWI
.FT CWI
CM Italic Typewriter Text (cmitt10)
.FT
.RE
.
.
.P
قلم‌های ویژه شامل
.B MI
(cmmi10)،
.B S
(cmsy10)،
.B EX
(cmex10)،
.B SC
(cmtex10،
فقط برای
.BR CW )،
و شاید در کمال تعجب،
.BR TR ،
.BR TI
و
.BR CW
است،
.\" See font/devdvi/generate/Makefile for details.
چرا که \*[tx] برخی گلیف‌ها را در قلم‌های متنی قرار می‌دهد که
.I troff \" generic
معمولاً چنین کاری نمی‌کند.
.
برای قلم‌های مورب،
.B CWI
به‌جای
.B CW
استفاده می‌شود.
.
.
.P
در نهایت، قلم‌های نماد انجمن ریاضی آمریکا (AMS) به‌عنوان قلم‌های ویژه
.B SA
(msam10) و
.B SB
(msbm10)
در دسترس هستند.
.
این قلم‌ها به‌طور پیش‌فرض سوار (mount) نشده‌اند.
.
.
.P
شما می‌توانید فایل ماکروی
.I ec.tmac
را بارگذاری کنید تا به‌جای قلم‌های CM از قلم‌های EC و TC استفاده نمایید که به آن‌ها شباهت دارند.
.
آن‌ها همچنین گلیف‌های یورو
.B \[rs][Eu]
و در هزار
.B \[rs][%0]
را فراهم می‌کنند.
.
این کار را پیش از بارگذاری فایل‌های ماکروی بومی‌سازی انجام دهید،
زیرا
.I ec.tmac
کدهای خط‌فاصله‌گذاری خودکار را تنظیم نمی‌کند.
.
.
.\" ====================================================================
.SS "دستورات افزونه دستگاه (Device extension commands)"
.\" ====================================================================
.
.I grodvi
معادل دستور
.BI \%\[rs]special{\:\%papersize= width , length }
در \*[tx] را در صفحه نخست ارسال می‌کند؛
سپس
.I dvips
(یا یک راه‌انداز DVI دیگر) اندازه صفحه را بر همان اساس تنظیم می‌کند.
.
اگر پهنا یا طول صفحه مثبت نباشد، هیچ دستور ویژه
.B \%papersize
خروجی داده نمی‌شود.
.
.
.P
.I grodvi
از یک افزونه دستگاه پشتیبانی می‌کند که با استفاده از درخواست
.B \%device
در
.I groff
یا توالی گریز
.B \[rs]X
در
.I roff
قابل دسترسی است.
.
.
.TP
.BI \[rs]X\[aq]papersize= width , length \[aq]
ابعاد صفحه را بر حسب سانتی‌متر روی
.I width
(پهنا) در
.I length
(طول) تنظیم می‌کند.
.
اگر گزینه
.B \-l
مشخص شده باشد، این ابعاد جابه‌جا می‌شوند.
.
تغییرات در ابعاد کاغذ باید پیش از صفحه نخست یا در حین خروج صفحه قبل از شروع صفحه بعدی رخ دهد.
.
.
.IP
.I احتیاط:
ترتیب ابعاد با آنچه توسط
.I papersize.tmac
و گزینه
.RB \[lq] "\-d \%paper" \[rq]
در
.MR \%troff 1
استفاده می‌شود متفاوت است.
.
.
.P
پارامتر(های) داده‌شده به
.B \%device
و
.B \[rs]X
به همان دستورالعمل‌های فایل DVI ترجمه می‌شوند که توسط
.BI \%\[rs]special{ anything }
در \*[tx] تولید می‌شدند؛
.I anything
نمی‌تواند شامل خط جدید (newline) باشد.
.
.
.\" ====================================================================
.SS "فایل‌های توصیف قلم (Font description files)"
.\" ====================================================================
.
از
.MR tfmtodit 1
برای ایجاد فایل‌های توصیف قلم
.I groff
از روی فایل‌های TFM
(سنجه‌های قلم \*[tx])
استفاده کنید.
.
فایل توصیف قلم باید شامل دستورالعمل‌های اضافی زیر باشد که
.I tfmtodit
به‌طور خودکار آن‌ها را تولید می‌کند.
.
.
.TP
.BI internalname\~ name
نام فایل TFM
(بدون پسوند
.IR .tfm )
برابر با
.I name
است.
.
.
.TP
.BI checksum\~ n
مجموع مقابله‌ای (checksum) در فایل TFM برابر با
.I n
است.
.
.
.TP
.BI designsize\~ n
اندازه طراحی در فایل TFM برابر با
.I n
است.
.
.
.\" ====================================================================
.SS "دستورات رسم (Drawing commands)"
.\" ====================================================================
.
.I grodvi
از یک دستور رسم اضافی پشتیبانی می‌کند.
.
.
.TP
.BI \[rs]D\[aq]R\~ "dh dv" \[aq]
یک خط‌کش یا مستطیل توپر
(مستطیل سیاه توپر)
رسم می‌کند که یک گوشه آن در موقعیت رسم فعلی، و گوشه قطری مقابل آن در موقعیت رسم
.RI +( dh , dv )
قرار دارد که پس از آن به موقعیت رسم جدید تبدیل می‌شود.
.
این دستور یک خط‌کش (rule) در فایل DVI تولید می‌کند و بنابراین بر خلاف سایر دستورات
.BR \[rs]D ،
حتی با راه‌اندازی که از دستورات ویژه
.I tpic
پشتیبانی نمی‌کند نیز قابل چاپ است.
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
گزینه
.B \-\-help
پیام راهنمای استفاده را نمایش می‌دهد، در حالی که
.B \-v
و
.B \%\-\-version
اطلاعات نسخه را نشان می‌دهند؛
سپس همگی از برنامه خارج می‌شوند.
.
.
.TP 8n
.B \-d
از دستورات ویژه
.I tpic
برای پیاده‌سازی دستورات رسم استفاده نمی‌کند.
.
خطوط افقی و عمودی با استفاده از خط‌کش‌ها (rules) پیاده‌سازی می‌شوند.
.
سایر دستورات رسم نادیده گرفته می‌شوند.
.
.
.TP
.BI \-F\~ dir
شاخه
.RI dir /dev name
را به ابتدای مسیر جستجو برای فایل‌های توصیف قلم و دستگاه اضافه می‌کند؛
.I name
نام دستگاه است که معمولاً
.B dvi
می‌باشد.
.
.
.TP
.B \-l
به‌جای جهت عمودی (portrait) از جهت افقی (landscape) استفاده می‌کند.
.
.
.TP
.BI \-p\~ paper-format
ابعاد فیزیکی رسانه خروجی را تعیین می‌کند و دستورالعمل‌های
.BR \%papersize ،
.BR \%paperlength
و
.B \%paperwidth
را در فایل
.I DESC
نادیده می‌گیرد (بازنویسی می‌کند).
.
.I paper-format
می‌تواند هر آرگومانی باشد که توسط دستورالعمل
.B \%papersize
پذیرفته می‌شود؛
.MR groff_font 5
را ببینید.
.
.
.TP
.BI \-w\~ n
خط‌کش‌ها (خطوط) را با ضخامت
.IR n \~هزارم
یک em رسم می‌کند.
.
ضخامت پیش‌فرض
.B 40
(0.04\~em)
است.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
.I \%grodvi
در صورت اجرای موفق با
.RB وضعیت\~ 0
خارج می‌شود؛
اگر نتواند آرگومان‌های خط فرمان را تفسیر کند با
.RB وضعیت\~ 2
و در صورت مواجهه با خطا در حین اجرا با
.RB وضعیت\~ 1
خارج می‌شود.
.
.
.\" ====================================================================
.SH "محیط (ENVIRONMENT)"
.\" ====================================================================
.
.TP
.I GROFF_FONT_PATH
فهرستی از دایرکتوری‌ها را مشخص می‌کند که باید در آن‌ها به دنبال
.IR devdvi ،
شاخه فایل‌های توصیف قلم و دستگاه
.IR grodvi ،
جستجو شود.
.
.MR \%troff 1
و
.MR groff_font 5
را ببینید.
.
.
.\" ====================================================================
.SH "فایل‌ها (FILES)"
.\" ====================================================================
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/\:DESC
دستگاه خروجی
.B dvi
را توصیف می‌کند.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devdvi/ F
قلم شناخته‌شده با نام
.I F
را بر روی دستگاه
.B dvi
توصیف می‌کند.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%tmac/\:dvi\:.tmac
نگاشت‌های قلم، نویسه‌های ویژه و رنگ‌ها را برای استفاده با دستگاه خروجی
.B dvi
تعریف می‌کند.
.
این فایل هنگام انتخاب دستگاه خروجی
.B dvi
به‌طور خودکار توسط
.I \%troffrc
بارگذاری می‌شود.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%tmac/\:ec\:.tmac
دستگاه خروجی
.B dvi
را به گونه‌ای پیکربندی می‌کند که به‌جای خانواده قلم‌های CM
(Computer Modern)
از خانواده قلم‌های EC و TC استفاده کند.
.
.
.\" ====================================================================
.SH "اشکالات (BUGS)"
.\" ====================================================================
.
فایل‌های DVI تولیدشده توسط
.I grodvi
از تفکیک‌پذیری متفاوتی
(۵۷٬۸۱۶ واحد در هر اینچ)
نسبت به فایل‌های تولیدشده توسط \*[tx] استفاده می‌کنند.
.
راه‌اندازهایی که به‌اشتباه نوشته شده‌اند و به‌جای استفاده از وضوح مشخص‌شده در فایل DVI، وضوح استفاده‌شده توسط \*[tx] را فرض می‌کنند، با
.I grodvi
کار نخواهند کرد.
.
.
.LP
هنگام استفاده از گزینه
.B \-d
با جدول‌های کادربندی‌شده، خطوط افقی و عمودی گاهی اوقات می‌توانند به اندازه یک پیکسل بیرون بزنند.
.
این امر نتیجه روشی است که \*[tx] بر اساس آن الزام می‌کند که ارتفاع و پهنای خط‌کش‌ها گرد شوند.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.UR https://\:texfaq\:.org/\:FAQ\-\:ECfonts
\[lq]قلم‌های EC چه هستند؟\[rq]
.UE ;
\*[tx] FAQ: فهرست پرسش‌های متداول برای \*[tx]
.
.
.P
.MR tfmtodit 1 ,
.MR groff 1 ,
.MR \%troff 1 ,
.MR groff_out 5 ,
.MR groff_font 5 ,
.MR groff_char 7 ,
.MR groff_tmac 5
.
.
.\" Clean up.
.rm FT
.rm tx
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_grodvi_1_man_C]
.do rr *groff_grodvi_1_man_C
.
.
.\" Local Variables:
.\" fill-column: 72
.\" mode: nroff
.\" End:
.\" vim: set filetype=groff textwidth=72:
