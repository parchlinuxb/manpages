.SH CONFIGURATION EXAMPLES
.sp
This is the set of configuration examples included in \fBdoc/examples\fP in the
sources of Kea version 3.2.0\&.
.SS ddns
.SS ddns/all\-keys\-netconf.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// WARNING: This example configuration is not meant for production use.
// The Kea Kea\(aqs DHCP\-DDNS server can refuse this configuration because
// it may contain mutually exclusive configuration parameters.
//
// The primary purpose of the example file is to provide a comprehensive
// list of parameters supported by the Kea DHCP\-DDNS server along with the
// brief description of each parameter.
//
// This stable version is used for YANG as we do not want to update code
// and models each time a keyword is added to the syntax.
{
    // Kea DHCP\-DDNS server configuration begins here.
    \(dqDhcpDdns\(dq: {

    // Global Parameters

    // IP address D2 will listen for update requests at.
    // Default is 127.0.0.1
    \(dqip\-address\(dq: \(dq127.0.0.1\(dq,

    // Port D2 will listen for update requests on.
    // Default is 53001.
    \(dqport\(dq: 53001,

    // Maximum time to we will wait for a DNS server to respond to us.
    // Unit is the millisecond, default is 100ms.
    \(dqdns\-server\-timeout\(dq : 100,

    // Protocol to use for Name Change Requests from a Kea DHCP server.
    // Currently only \(aqUDP\(aq is supported.
    \(dqncr\-protocol\(dq: \(dqUDP\(dq,

    // Format to use for Name Change Requests from a Kea DHCP server.
    // Currently only \(aqJSON\(aq is supported.
    \(dqncr\-format\(dq: \(dqJSON\(dq,

    // Command control socket configuration parameters for Kea DHCP\-DDNS server.
    \(dqcontrol\-socket\(dq: {

        // Location of the UNIX domain socket file the DHCP\-DDNS server uses
        // to receive control commands from the local server administrator.
        \(dqsocket\-name\(dq: \(dqkea\-ddns\-ctrl\-socket\(dq,

        // Control socket type used by the Kea DHCP\-DDNS server.
        // The \(aqunix\(aq socket is currently the only supported type.
        \(dqsocket\-type\(dq: \(dqunix\(dq
    },

    // List of hook libraries and their specific configuration parameters
    // to be loaded by Kea DHCP\-DDNS server.
    \(dqhooks\-libraries\(dq: [
        {
            // Location of the hook library to be loaded.
            \(dqlibrary\(dq: \(dqddns\-server\-commands.so\(dq,

            // Hook library\-specific configuration parameters.
            \(dqparameters\(dq: { }
        }
    ],

    // Forward DDNS (Dynamic DNS).
    \(dqforward\-ddns\(dq: {

        // List of DDNS domains.
        \(dqddns\-domains\(dq: [
            {
                // Name of the zone (required).
                \(dqname\(dq: \(dqexample.com.\(dq,

                // Name of the TSIG key used to protect DNS updates for
                // names in the domain.
                \(dqkey\-name\(dq: \(dqd2.md5.key\(dq,

                // List of DNS servers where to send DNS updates.
                \(dqdns\-servers\(dq: [
                    {
                        // DNS server IP address (required).
                        \(dqip\-address\(dq: \(dq2001:db8:1::10\(dq,

                        // DNS server UDP port. Default is 53 (DNS service).
                        \(dqport\(dq: 7802,

                        // Name of the TSIG key used to protect DNS updates
                        // sent to the DNS server.
                        \(dqkey\-name\(dq: \(dqd2.sha1.key\(dq
                    }
                ]
            }
        ]
    },

    // Reverse DDNS (Dynamic DNS).
    \(dqreverse\-ddns\(dq: {

        // List of DDNS domains.
        \(dqddns\-domains\(dq: [
            {
                // Name of the zone (required).
                \(dqname\(dq: \(dq2.0.192.in\-addr.arpa.\(dq,

                // Name of the TSIG key used to protect DNS updates for
                // names in the domain.
                \(dqkey\-name\(dq: \(dqd2.sha1.key\(dq,

                // List of DNS servers where to send DNS updates.
                \(dqdns\-servers\(dq: [
                    {
                        // DNS server IP address (required).
                        \(dqip\-address\(dq: \(dq172.16.1.1\(dq,

                        // DNS server UDP port. Default is 53 (DNS service).
                        \(dqport\(dq: 5301,

                        // Name of the TSIG key used to protect DNS updates
                        \(dqkey\-name\(dq: \(dqd2.md5.key\(dq
                    }
                ]
            }
        ]
    },

    // List of TSIG keys used to protect DNS updates.
    \(dqtsig\-keys\(dq: [
        {
            // Name of the TSIG key (required).
            \(dqname\(dq: \(dqd2.md5.key\(dq,

            // Algorithm of the TSIG key (required).
            // The value must be a valid algorithm name e.g.
            // HMAC\-MD5, HMAC\-SHA1, HMAC\-SHA224, ...
            \(dqalgorithm\(dq: \(dqHMAC\-MD5\(dq,

            // Number of bits in the digest. Default is 0 which means
            // to use all bits provided by the algorithm. Too short values
            // (depending on the algorithm) are rejected.
            \(dqdigest\-bits\(dq: 0,

            // Secret of the TSIG key (required) in base\-64.
            \(dqsecret\(dq: \(dqLSWXnfkKZjdPJI5QxlpnfQ==\(dq
        }
    ],

    // List of loggers used by the servers using this configuration file.
    \(dqloggers\(dq: [
        {
            // Debug level, a value between 0..99. The greater the value
            // the more detailed the debug log.
            \(dqdebuglevel\(dq: 99,

            // Name of the logger.
            \(dqname\(dq: \(dqkea\-dhcp\-ddns\(dq,

            // Configures how the log should be output.
            \(dqoutput\-options\(dq: [
                {
                    // Determines whether the log should be flushed to a file.
                    \(dqflush\(dq: true,

                    // Specifies maximum filesize before the file is rotated.
                    \(dqmaxsize\(dq: 10240000,

                    // Specifies the maximum number of rotated files to be kept.
                    \(dqmaxver\(dq: 1,

                    // Specifies the logging destination.
                    \(dqoutput\(dq: \(dqstdout\(dq,

                    // Specifies log entry content
                    \(dqpattern\(dq: \(dq%D{%Y\-%m\-%d %H:%M:%S.%q} %\-5p [%c/%i] %m\en\(dq
                }
            ],

            // Specifies logging severity, i.e. \(dqERROR\(dq, \(dqWARN\(dq, \(dqINFO\(dq, \(dqDEBUG\(dq.
            \(dqseverity\(dq: \(dqINFO\(dq
        }
    ],

    // Look at sample1 example for the use of user\-contexts.
    \(dquser\-context\(dq: { }
}

}
.EE
.UNINDENT
.UNINDENT
.SS ddns/all\-keys.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// WARNING: This example configuration is not meant for production use.
// The Kea Kea\(aqs DHCP\-DDNS server can refuse this configuration because
// it may contain mutually exclusive configuration parameters.
//
// The primary purpose of the example file is to provide a comprehensive
// list of parameters supported by the Kea DHCP\-DDNS server along with the
// brief description of each parameter.
//
// This current version should be up to date, i.e. new keywords should be
// added in this file at the same time as in the parser specification.
{
    // Kea DHCP\-DDNS server configuration begins here.
    \(dqDhcpDdns\(dq: {

    // Global Parameters

    // IP address D2 will listen for update requests at.
    // Default is 127.0.0.1
    \(dqip\-address\(dq: \(dq127.0.0.1\(dq,

    // Port D2 will listen for update requests on.
    // Default is 53001.
    \(dqport\(dq: 53001,

    // Maximum time to we will wait for a DNS server to respond to us.
    // Unit is the millisecond, default is 100ms.
    \(dqdns\-server\-timeout\(dq : 100,

    // Protocol to use for Name Change Requests from a Kea DHCP server.
    // Currently only \(aqUDP\(aq is supported.
    \(dqncr\-protocol\(dq: \(dqUDP\(dq,

    // Format to use for Name Change Requests from a Kea DHCP server.
    // Currently only \(aqJSON\(aq is supported.
    \(dqncr\-format\(dq: \(dqJSON\(dq,

    // Command control socket configuration parameters for Kea DHCP\-DDNS server.
    \(dqcontrol\-sockets\(dq: [
        {
            // Control socket type used by the Kea DHCP\-DDNS server.
            // Must be unix, http or https.
            \(dqsocket\-type\(dq: \(dqunix\(dq,

            // Location of the UNIX domain socket file the DHCP\-DDNS
            // server uses to receive control commands from the
            // local server administrator.
            \(dqsocket\-name\(dq: \(dqkea\-ddns\-ctrl\-socket\(dq
        },
        {
            // Control socket type used by the Kea DHCP\-DDNS server.
            // Must be unix, http or https.
            \(dqsocket\-type\(dq: \(dqhttps\(dq,

            // Address of the HTTPS socket the Kea DHCP\-DDNS server should
            // listen for incoming queries.
            \(dqsocket\-address\(dq: \(dq127.0.0.1\(dq,

            // Port of the HTTPS socket the Kea DHCP\-DDNS server
            // should listen for incoming queries.
            \(dqsocket\-port\(dq: 8053,

            // TLS trust anchor (Certificate Authority). This is a
            // file name or a directory path. Make sense with other
            // TLS parameters only for the https control socket type.
            \(dqtrust\-anchor\(dq: \(dqmy\-ca\(dq,

            // TLS server certificate file name.
            \(dqcert\-file\(dq: \(dqmy\-cert\(dq,

            // TLS server private key file name.
            \(dqkey\-file\(dq: \(dqmy\-key\(dq,

            // TLS require client certificates flag. Default is
            // true and means require client certificates. False
            // means they are optional.
            \(dqcert\-required\(dq: true,

            // Optional authentication.
            \(dqauthentication\(dq: {
                // Required authentication type. The only supported
                // value is basic for the basic HTTP authentication.
                \(dqtype\(dq: \(dqbasic\(dq,

                // An optional parameter is the basic HTTP
                // authentication realm.  Its default is
                // \(dqkea\-dhcp\-ddns\-server\(dq
                \(dqrealm\(dq: \(dqkea\-dhcp\-ddns\-server\(dq,

                // This optional parameter can be used to specify a common
                // prefix for files handling client credentials.
                \(dqdirectory\(dq: \(dq/usr/local/share/kea/kea\-creds\(dq,

                // This list specifies the user ids and passwords to
                // use for basic HTTP authentication. If empty or not
                // present any client is authorized.
                \(dqclients\(dq: [
                    // This specifies an authorized client.
                    {
                        // The user id must not be empty or contain
                        // the \(aq:\(aq character. It is a mandatory parameter.
                        \(dquser\(dq: \(dqadmin\(dq,

                        // If password is not specified an empty
                        // password is used.
                        \(dqpassword\(dq: \(dq1234\(dq
                    },

                    // This specifies a hidden client.
                    {
                        // The user id is the content of the
                        // file /usr/local/share/kea/kea\-creds/hiddenu.
                        \(dquser\-file\(dq: \(dqhiddenu\(dq,

                        // The password is the content of the
                        // file /usr/local/share/kea/kea\-creds/hiddenp.
                        \(dqpassword\-file\(dq: \(dqhiddenp\(dq
                    },

                    // This specifies a hidden client using a secret
                    // in a file.
                    {
                        // The secret is the content of the file
                        // /usr/local/share/kea/kea\-creds/hiddens which must be in
                        // the <user\-id>:<password> format.
                        \(dqpassword\-file\(dq: \(dqhiddens\(dq
                    }
                ]
            }
        }
    ],

    // List of hook libraries and their specific configuration parameters
    // to be loaded by Kea DHCP\-DDNS server.
    \(dqhooks\-libraries\(dq: [
        {
            // Location of the hook library to be loaded.
            \(dqlibrary\(dq: \(dqddns\-server\-commands.so\(dq,

            // Hook library\-specific configuration parameters.
            \(dqparameters\(dq: { }
        }
    ],

    // Forward DDNS (Dynamic DNS).
    \(dqforward\-ddns\(dq: {

        // List of DDNS domains.
        \(dqddns\-domains\(dq: [
            {
                // Name of the zone (required).
                \(dqname\(dq: \(dqexample.com.\(dq,

                // Name of the TSIG key used to protect DNS updates for
                // names in the domain.
                \(dqkey\-name\(dq: \(dqd2.md5.key\(dq,

                // List of DNS servers where to send DNS updates.
                \(dqdns\-servers\(dq: [
                    {
                        // DNS server IP address (required).
                        \(dqip\-address\(dq: \(dq2001:db8:1::10\(dq,

                        // DNS server UDP port. Default is 53 (DNS service).
                        \(dqport\(dq: 7802,

                        // Name of the TSIG key used to protect DNS updates
                        // sent to the DNS server.
                        \(dqkey\-name\(dq: \(dqd2.sha1.key\(dq
                    }
                ]
            }
        ]
    },

    // Reverse DDNS (Dynamic DNS).
    \(dqreverse\-ddns\(dq: {

        // List of DDNS domains.
        \(dqddns\-domains\(dq: [
            {
                // Name of the zone (required).
                \(dqname\(dq: \(dq2.0.192.in\-addr.arpa.\(dq,

                // Name of the TSIG key used to protect DNS updates for
                // names in the domain.
                \(dqkey\-name\(dq: \(dqd2.sha1.key\(dq,

                // List of DNS servers where to send DNS updates.
                \(dqdns\-servers\(dq: [
                    {
                        // DNS server IP address (required).
                        \(dqip\-address\(dq: \(dq172.16.1.1\(dq,

                        // DNS server UDP port. Default is 53 (DNS service).
                        \(dqport\(dq: 5301,

                        // Name of the TSIG key used to protect DNS updates
                        \(dqkey\-name\(dq: \(dqd2.md5.key\(dq
                    }
                ]
            }
        ]
    },

    // List of TSIG keys used to protect DNS updates.
    \(dqtsig\-keys\(dq: [
        {
            // Name of the TSIG key (required).
            \(dqname\(dq: \(dqd2.md5.key\(dq,

            // Algorithm of the TSIG key (required).
            // The value must be a valid algorithm name e.g.
            // HMAC\-MD5, HMAC\-SHA1, HMAC\-SHA224, ...
            \(dqalgorithm\(dq: \(dqHMAC\-MD5\(dq,

            // Number of bits in the digest. Default is 0 which means
            // to use all bits provided by the algorithm. Too short values
            // (depending on the algorithm) are rejected.
            \(dqdigest\-bits\(dq: 0,

            // Secret of the TSIG key (required) in base\-64.
            \(dqsecret\(dq: \(dqLSWXnfkKZjdPJI5QxlpnfQ==\(dq
        },
        {
            \(dqname\(dq: \(dqd2.sha1.key\(dq,
            \(dqalgorithm\(dq: \(dqHMAC\-SHA1\(dq,

            // An alternative to secret: specify a file where the secret
            // can be found. i.e. the secret is the content of the file.
            \(dqsecret\-file\(dq: \(dq/usr/local/share/kea/d2\-sha1\-secret\(dq
        }
    ],

    // List of loggers used by the servers using this configuration file.
    \(dqloggers\(dq: [
        {
            // Debug level, a value between 0..99. The greater the value
            // the more detailed the debug log.
            \(dqdebuglevel\(dq: 99,

            // Name of the logger.
            \(dqname\(dq: \(dqkea\-dhcp\-ddns\(dq,

            // Configures how the log should be output.
            \(dqoutput\-options\(dq: [
                {
                    // Determines whether the log should be flushed to a file.
                    \(dqflush\(dq: true,

                    // Specifies maximum filesize before the file is rotated.
                    \(dqmaxsize\(dq: 10240000,

                    // Specifies the maximum number of rotated files to be kept.
                    \(dqmaxver\(dq: 1,

                    // Specifies the logging destination.
                    \(dqoutput\(dq: \(dqstdout\(dq,

                    // Specifies log entry content
                    \(dqpattern\(dq: \(dq%D{%Y\-%m\-%d %H:%M:%S.%q} %\-5p [%c/%i] %m\en\(dq
                }
            ],

            // Specifies logging severity, i.e. \(dqERROR\(dq, \(dqWARN\(dq, \(dqINFO\(dq, \(dqDEBUG\(dq.
            \(dqseverity\(dq: \(dqINFO\(dq
        }
    ],

    // Look at sample1 example for the use of user\-contexts.
    \(dquser\-context\(dq: { }
}

}
.EE
.UNINDENT
.UNINDENT
.SS ddns/comments.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This is an example configuration file for D2, Kea\(aqs DHCP\-DDNS processor.
// It uses embedded comments which will be included in configuration objects
// within user\-contexts rather than stripped away by at lexical analysis.

{
\(dqDhcpDdns\(dq:
{

    // Global scope
    \(dqcomment\(dq: \(dqA DHCP\-DDNS server\(dq,
    \(dqip\-address\(dq: \(dq127.0.0.1\(dq,
    \(dqport\(dq: 53001,
    \(dqdns\-server\-timeout\(dq : 1000,

    // In control sockets.
    \(dqcontrol\-sockets\(dq: [
        {
            \(dqsocket\-type\(dq: \(dqunix\(dq,
            \(dqsocket\-name\(dq: \(dqkea\-ddns\-ctrl\-socket\(dq,
            \(dquser\-context\(dq: { \(dqcomment\(dq: \(dqIndirect comment\(dq }
        },
        {
            \(dqcomment\(dq: \(dqHTTP control socket\(dq,
            \(dqsocket\-type\(dq: \(dqhttp\(dq,
            \(dqsocket\-address\(dq: \(dq::1\(dq,
            \(dqsocket\-port\(dq: 8053,
            // In authentication
            \(dqauthentication\(dq: {
                \(dqcomment\(dq: \(dqbasic HTTP authentication\(dq,
                \(dqtype\(dq: \(dqbasic\(dq,
                // In basic HTTP authentication clients
                \(dqclients\(dq: [ {
                    \(dqcomment\(dq: \(dqadmin is authorized\(dq,
                    \(dquser\(dq: \(dqadmin\(dq,
                    \(dqpassword\(dq: \(dq1234\(dq
                } ]
            }
        }
    ],

    \(dqforward\-ddns\(dq:
    {
        \(dqddns\-domains\(dq:
        [
            // In DDNS domain
            {
                \(dqcomment\(dq: \(dqDdnsDomain for zone \(aqfour.example.com.\(aq\(dq,
                \(dqname\(dq: \(dqfour.example.com.\(dq,
                \(dqkey\-name\(dq: \(dqd2.md5.key\(dq,
                // In DNS server
                \(dqdns\-servers\(dq:
                [
                    {
                        \(dqcomment\(dq: \(dqfour.example.com. server\(dq,
                        \(dqip\-address\(dq: \(dq172.16.1.1\(dq
                    }
                ]
            }
        ]
    },

    // In TSIG key
    \(dqtsig\-keys\(dq:
    [
        {
            \(dqcomment\(dq: \(dqfour.example.com. key\(dq,
            \(dqname\(dq: \(dqd2.md5.key\(dq,
            \(dqalgorithm\(dq: \(dqHMAC\-MD5\(dq,
            \(dqsecret\(dq: \(dqLSWXnfkKZjdPJI5QxlpnfQ==\(dq
        }
    ],

    // In loggers
    \(dqloggers\(dq: [
        {
            \(dqcomment\(dq: \(dqA logger\(dq,
            \(dqname\(dq: \(dqkea\-dhcp\-ddns\(dq,
            \(dqseverity\(dq: \(dqinfo\(dq
        }
    ]
}

}
.EE
.UNINDENT
.UNINDENT
.SS ddns/gss\-tsig.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This is an example configuration file for D2, Kea\(aqs DHCP\-DDNS processor.
// It uses the GSS\-TSIG hook library.
{
\(dqDhcpDdns\(dq: {
    // The following parameters are used to receive NCRs (NameChangeRequests)
    // from the local Kea DHCP server. Make sure your kea\-dhcp4 and kea\-dhcp6
    // matches this.
    \(dqip\-address\(dq: \(dq127.0.0.1\(dq,
    \(dqport\(dq: 53001,
    \(dqdns\-server\-timeout\(dq : 1000,

    // Forward zone: secure.example.org. It uses GSS\-TSIG. It is served
    // by two DNS servers, which listen for DDNS requests at 192.0.2.1
    // and 192.0.2.2.
    \(dqforward\-ddns\(dq:
    {
        \(dqddns\-domains\(dq:
        [
            // DdnsDomain for zone \(dqsecure.example.org.\(dq
            {
                \(dqname\(dq: \(dqsecure.example.org.\(dq,
                \(dqcomment\(dq: \(dqDdnsDomain example\(dq,
                \(dqdns\-servers\(dq:
                [
                    {
                      // This server has an entry in gss/servers and
                      // thus will use GSS\-TSIG.
                        \(dqip\-address\(dq: \(dq192.0.2.1\(dq
                    },
                    {
                      // This server also has an entry there, so will
                      // use GSS\-TSIG, too.
                        \(dqip\-address\(dq: \(dq192.0.2.2\(dq,
                        \(dqport\(dq: 5300
                    }
                ]
            }
        ]
    },

    // Reverse zone: we want to update the reverse zone \(dq2.0.192.in\-addr.arpa\(dq.
    \(dqreverse\-ddns\(dq:
    {
        \(dqddns\-domains\(dq:
        [
            {
                \(dqname\(dq: \(dq2.0.192.in\-addr.arpa.\(dq,
                \(dqdns\-servers\(dq:
                [
                    {
                        // There is GSS\-TSIG definition for this server (see
                        // DhcpDdns/gss\-tsig/servers), so it will use
                        // Krb/GSS\-TSIG.
                        \(dqip\-address\(dq: \(dq192.0.2.1\(dq
                    }
                ]
            }
        ]
    },

    // The GSS\-TSIG hook is loaded and its configuration is specified here.
    \(dqhooks\-libraries\(dq: [
    {
        \(dqlibrary\(dq: \(dqlibddns_gss_tsig.so\(dq,
        \(dqparameters\(dq: {
            // This section governs the GSS\-TSIG integration. Each server
            // mentioned in forward\-ddns and/or reverse\-ddns needs to have
            // an entry here to be able to use GSS\-TSIG defaults (optional,
            // if specified they apply to all the GSS\-TSIG servers, unless
            // overwritten on specific server level).

            \(dqserver\-principal\(dq: \(dqDNS/server.example.org@EXAMPLE.ORG\(dq,
            \(dqclient\-principal\(dq: \(dqDHCP/admin.example.org@EXAMPLE.ORG\(dq,

            // client\-keytab and credentials\-cache can both be used to
            // store client keys. As credentials cache is more flexible,
            // it is recommended to use it. Typically, using both at the
            // same time may cause problems.
            // \(dqclient\-keytab\(dq: \(dqFILE:/etc/dhcp.keytab\(dq, // toplevel only
            \(dqcredentials\-cache\(dq: \(dqFILE:/etc/ccache\(dq,     // toplevel only

            \(dqgss\-replay\-flag\(dq: true, // GSS anti replay service
            \(dqgss\-sequence\-flag\(dq: false, // no GSS sequence service
            \(dqtkey\-lifetime\(dq: 3600, // 1 hour
            \(dqrekey\-interval\(dq: 2700, // 45 minutes
            \(dqretry\-interval\(dq: 120, // 2 minutes
            \(dqtkey\-protocol\(dq: \(dqTCP\(dq,
            \(dqfallback\(dq: false,

            // The list of GSS\-TSIG capable servers
            \(dqservers\(dq: [
                {
                    // First server (identification is required)
                    \(dqid\(dq: \(dqserver1\(dq,
                    \(dqdomain\-names\(dq: [ ], // if not specified or empty, will
                                         // match all domains that want to
                                         // use this IP+port pair
                    \(dqip\-address\(dq: \(dq192.0.2.1\(dq,
                    \(dqport\(dq: 53,
                    \(dqserver\-principal\(dq: \(dqDNS/server1.example.org@EXAMPLE.ORG\(dq,
                    \(dqclient\-principal\(dq: \(dqDHCP/admin1.example.org@EXAMPLE.ORG\(dq,
                    \(dqgss\-replay\-flag\(dq: false, // no GSS anti replay service
                    \(dqgss\-sequence\-flag\(dq: false, // no GSS sequence service
                    \(dqtkey\-lifetime\(dq: 7200, // 2 hours
                    \(dqrekey\-interval\(dq: 5400, // 90 minutes
                    \(dqretry\-interval\(dq: 240, // 4 minutes
                    \(dqtkey\-protocol\(dq: \(dqTCP\(dq,
                    \(dqfallback\(dq: true // if no key is available fallback to the
                                     // standard behavior (vs skip this server)
                },
                {
                    // The second server (it has most of the parameters missing
                    // as those are using the defaults specified above)
                    \(dqid\(dq: \(dqserver2\(dq,
                    \(dqip\-address\(dq: \(dq192.0.2.2\(dq,
                    \(dqport\(dq: 5300
                }
            ]
        }
    }
    ]

    // Additional parameters, such as logging, control socket and
    // others omitted for clarity.
}

}
.EE
.UNINDENT
.UNINDENT
.SS ddns/sample1.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This is an example configuration file for D2, Kea\(aqs DHCP\-DDNS processor.
// It supports updating two Forward DNS zones \(dqfour.example.com\(dq and
// \(dqsix.example.com\(dq; and one Reverse DNS zone, \(dq2.0.192.in\-addr.arpa.\(dq

{
// \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\- DHCP\-DDNS \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-
\(dqDhcpDdns\(dq:
{

// \-\-\-\-\-\-\-\-\-\-\-\-\-\-  Global Parameters \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-
//   D2 will listen for update requests for Kea DHCP servers at 127.0.0.1
//   on port 53001.  Maximum time to we will wait for a DNS server to
//   respond to us is 1000 ms.

    \(dqip\-address\(dq: \(dq127.0.0.1\(dq,
    \(dqport\(dq: 53001,
    \(dqdns\-server\-timeout\(dq : 1000,

// One extra feature that requires some explanation is
// user\-context. This is a structure that you can define at global scope,
// in ddns domain, dns server, tsig key and others. It is parsed by
// Kea, but not used directly.  It is intended to keep anything you
// may want to put there \- comments, extra designations, floor or
// department names etc.
// A comment entry is translated into a user\-context with a \(dqcomment\(dq
// property so you can include comments inside the configuration itself.

    \(dquser\-context\(dq: { \(dqversion\(dq: 1 },

// \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\- Control Socket \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-

    \(dqcontrol\-socket\(dq:
    {
        \(dqsocket\-type\(dq: \(dqunix\(dq,
        \(dqsocket\-name\(dq: \(dqkea\-ddns\-ctrl\-socket\(dq
    },

// \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\- Hooks Libraries \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-

    \(dqhooks\-libraries\(dq:
    [
        // Hook libraries list may contain more than one library.
        {
            // The only necessary parameter is the library filename.
            \(dqlibrary\(dq: \(dqddns\-server\-commands.so\(dq,

            // Some libraries may support parameters. Make sure you
            // type this section carefully, as the server does not validate
            // it (because the format is library\-specific).
            \(dqparameters\(dq:
            {
                \(dqparam1\(dq: \(dqfoo\(dq
            }
        }
    ],

// \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\- Forward DDNS  \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-
//   1. Zone \- \(dqfour.example.com.
//      It uses TSIG, key name is \(dqd2.md5.key\(dq
//      It is served by one DNS server which listens for DDNS requests at
//      172.16.1.1 on the default port 53 (standard DNS port)
//   2. Zone \- \(dqsix.example.com.\(dq
//      It does not use TSIG.
//      It is server by one DNS server at \(dq2001:db8:1::10\(dq on port 7802

    \(dqforward\-ddns\(dq:
    {
        \(dqddns\-domains\(dq:
        [
//           DdnsDomain for zone \(dqfour.example.com.\(dq
            {
                \(dqcomment\(dq: \(dqDdnsDomain example\(dq,
                \(dqname\(dq: \(dqfour.example.com.\(dq,
                \(dqkey\-name\(dq: \(dqd2.md5.key\(dq,
                \(dqdns\-servers\(dq:
                [
                    {
                        \(dqip\-address\(dq: \(dq172.16.1.1\(dq
                    }
                ]
            },

//           DdnsDomain for zone \(dqsix.example.com.\(dq
            {
                \(dqname\(dq: \(dqsix.example.com.\(dq,
                \(dqdns\-servers\(dq:
                [
                    {
                        \(dqip\-address\(dq: \(dq2001:db8:1::10\(dq,
                        \(dqport\(dq: 7802
                    }
                ]
            }
        ]
    },

// \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\- Reverse DDNS  \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-
// We will update Reverse DNS for one zone \(dq2.0.192.in\-addr\-arpa\(dq. It
// uses TSIG with key \(dqd2.sha1.key\(dq and is served by two DNS servers:
// one listening at \(dq172.16.1.1\(dq on 53001 and the other at \(dq192.168.2.10\(dq.
    \(dqreverse\-ddns\(dq:
    {
        \(dqddns\-domains\(dq:
        [
            {
                \(dqname\(dq: \(dq2.0.192.in\-addr.arpa.\(dq,
                \(dqkey\-name\(dq: \(dqd2.sha1.key\(dq,
                \(dqdns\-servers\(dq:
                [
                    {
                        \(dqip\-address\(dq: \(dq172.16.1.1\(dq,
                        \(dqport\(dq: 53001
                    },
                    {
                        \(dqip\-address\(dq: \(dq192.168.2.10\(dq
                    }
                ]
            }
        ]
    },

// \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\- TSIG keys \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-
//   Each key has a name, an algorithm (HMAC\-MD5, HMAC\-SHA1, HMAC\-SHA224...)
//   and a base\-64 encoded shared secret.
    \(dqtsig\-keys\(dq:
    [
        {
            \(dqname\(dq: \(dqd2.md5.key\(dq,
            \(dqalgorithm\(dq: \(dqHMAC\-MD5\(dq,
            \(dqsecret\(dq: \(dqLSWXnfkKZjdPJI5QxlpnfQ==\(dq
        },
        {
            \(dqname\(dq: \(dqd2.sha1.key\(dq,
            \(dqalgorithm\(dq: \(dqHMAC\-SHA1\(dq,
            \(dqsecret\(dq: \(dqhRrp29wzUv3uzSNRLlY68w==\(dq
        },
        {
            \(dqname\(dq: \(dqd2.sha256.key\(dq,
            \(dqalgorithm\(dq: \(dqHMAC\-SHA256\(dq,
            \(dqsecret\-file\(dq: \(dq/usr/local/share/kea/d2\-sha256\-secret\(dq
        },
        {
            \(dqname\(dq: \(dqd2.sha512.key\(dq,
            \(dqalgorithm\(dq: \(dqHMAC\-SHA512\(dq,
            \(dqdigest\-bits\(dq: 256,
            \(dqsecret\(dq: \(dq/4wklkm04jeH4anx2MKGJLcya+ZLHldL5d6mK+4q6UXQP7KJ9mS2QG29hh0SJR4LA0ikxNJTUMvir42gLx6fGQ==\(dq
        }
    ],

// The following configures logging. It assumes that messages with at least
// informational level (info, warn, error and fatal) should be logged to stdout.
// It also specifies a custom log pattern.
    \(dqloggers\(dq: [
        {
            \(dqname\(dq: \(dqkea\-dhcp\-ddns\(dq,
            \(dqoutput\-options\(dq: [
                {
                    \(dqoutput\(dq: \(dqstdout\(dq,
                    // Several additional parameters are possible in addition
                    // to the typical output. Flush determines whether logger
                    // flushes output to a file. Maxsize determines maximum
                    // filesize before the file is rotated. maxver
                    // specifies the maximum number of rotated files being
                    // kept.
                    \(dqflush\(dq: true,
                    \(dqmaxsize\(dq: 204800,
                    \(dqmaxver\(dq: 4,
                    \(dqpattern\(dq: \(dq%d [%c/%i] %m\en\(dq
                }
            ],
            \(dqdebuglevel\(dq: 0,
            \(dqseverity\(dq: \(dqINFO\(dq
        }
    ]
}

}
.EE
.UNINDENT
.UNINDENT
.SS ddns/template.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This file may be used a template for constructing DHCP\-DDNS JSON
// configuration.
// It must start with a left\-curly\-bracket.
{

\(dqDhcpDdns\(dq :
{
// \-\-\-\-\-\-\-\-\-\-\-\-\-\-  Global Parameters \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-
//    All of the global parameters have default values as shown.  If these
//    are satisfactory you may omit them.
//    \(dqip\-address\(dq : \(dq127.0.0.1\(dq,
//    \(dqport\(dq : 53001,
//    \(dqdns\-server\-timeout\(dq : 100,
//    \(dqncr\-protocol\(dq : \(dqUDP\(dq
//    \(dqncr\-format\(dq : \(dqJSON\(dq

// \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\- Control Socket \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-

//    \(dqcontrol\-socket\(dq:
//    {
//        \(dqsocket\-type\(dq: \(dqunix\(dq,
//        \(dqsocket\-name\(dq: \(dqkea\-ddns\-ctrl\-socket\(dq
//    },

// \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\- Forward DDNS  \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-
    \(dqforward\-ddns\(dq :
    {
        \(dqddns\-domains\(dq :
        [
//            {
//                \(dqname\(dq : \(dq<zone name 1>\(dq,
//                \(dqkey\-name\(dq : \(dq<key name>\(dq,
//                \(dqdns\-servers\(dq :
//                [
//                    {
//                        \(dqip\-address\(dq : \(dq<ip address>\(dq
//                       ,\(dqport\(dq : 53
//                    }
//                    ,
//                    {
//                        next DNS server for this DdnsDomain
//                    }
//                    :
//                ]
//            }
//            ,
//            {
//                 next Forward DdnsDomain
//            }
//            :
        ]
    },

// \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\- Reverse DDNS  \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-
    \(dqreverse\-ddns\(dq :
    {
        \(dqddns\-domains\(dq :
        [
//            {
//                \(dqname\(dq : \(dq<reverse zone name 1>\(dq,
//                \(dqkey\-name\(dq : \(dq<key name>\(dq,
//                \(dqdns\-servers\(dq :
//                [
//                    {
//                        \(dqip\-address\(dq : \(dq<ip address>\(dq
//                        ,\(dqport\(dq : 53
//                    }
//                    ,
//                    {
//                        next DNS server for this DdnsDomain
//                    }
//                    :
//                ]
//            }
//            ,
//            {
//                 next Reverse DdnsDomain
//            }
//            :
        ]
    },
// \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\- TSIG keys \-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-
    \(dqtsig\-keys\(dq :
    [
//        {
//            \(dqname\(dq : \(dq<key name>\(dq,
//            \(dqalgorithm\(dq : \(dq<algorithm name>\(dq,
//            Valid values for algorithm are:    HMAC\-MD5, HMAC\-SHA1,
//                                               HMAC\-SHA224, HMAC\-SHA256,
//                                               HMAC\-SHA384, HMAC\-SHA512
//            \(dqdigest\-bits\(dq : 256,
//            Minimum truncated length in bits.
//            Default 0 (means truncation is forbidden).
//            \(dqsecret\(dq : \(dq1234\(dq (shared secret value)
//        }
//        ,
//        {
//                next TSIG Key
//        }
    ]

// Logging
//    ,\(dqloggers\(dq:
//    [
//        {
//            \(dqname\(dq: \(dqkea\-dhcp\-ddns\(dq,
//            \(dqseverity\(dq: \(dqinfo\(dq
//        }
//    ]
}

// It must end with an right\-curly\-bracket.
}
.EE
.UNINDENT
.UNINDENT
.SS kea4
.SS kea4/advanced.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This is an example configuration file for DHCPv4 server in Kea.
// It covers some of the more advanced features. This file may not be coherent
// as its main purpose is to demonstrate the features. They don\(aqt necessarily
// have to make sense used together.

// The new parser supports 3 comment styles:

// This is C++ style.

# This is a bash style.

/* This is a C style comment. */

/* C style comment
   can span
   multiple lines */

{ \(dqDhcp4\(dq:

{
    // Kea is told to listen on eth0 interface only.
    \(dqinterfaces\-config\(dq: {
        \(dqinterfaces\(dq: [ \(dqeth0\(dq ],

        // This specifies what type of socket Kea uses. Currently supported
        // are \(aqraw\(aq (which is the default) and \(aqudp\(aq. Raw has the benefit
        // of receiving all traffic every time and a downside of bypassing
        // all firewall rules and having marginally bigger performance impact.
        // \(aqudp\(aq is generally better if you have only relayed traffic. Kea
        // than opens up normal UDP socket and the kernel does all the
        // Ethernet/IP stack processing.
        \(dqdhcp\-socket\-type\(dq: \(dqudp\(dq,

        // Typically the DHCP server will send its response back on the same
        // interface the query came in. This is the default (\(dqsame\-as\-inbound\(dq).
        // However, sometimes it is useful to have the ability to send the
        // packet as plain UDP packet and let the kernel and the routing tables
        // determine the right interface (\(dquse\-routing\(dq). This option only works
        // for \(dqdhcp\-socket\-type\(dq set to \(dqudp\(dq and is ignored otherwise.
        \(dqoutbound\-interface\(dq: \(dquse\-routing\(dq,

        // This makes interfaces to be re\-detected at each (re\-)configuration.
        // By default it is true.
        \(dqre\-detect\(dq: true
    },

    \(dqsanity\-checks\(dq: {
        // This parameter determines what to do when a new lease appears in the
        // system (i.e. either is read from disk during memfile startup or is
        // added via lease commands). There are five modes supported:
        // none \- do nothing, accept them as is
        // warn \- if subnet\-id problems are detected, print a warning, but
        //        otherwise load the lease as is. This is the default value.
        // fix \- attempt to fix the lease by finding appropriate subnet\-id value.
        //       if there is no suitable subnet, the lease is loaded as is.
        // fix\-del \- attempt to fix the lease by finding appropriate subnet\-id
        //           value. If there is no suitable subnet, the lease is deleted.
        // del \- delete leases that have incorrect subnet\-id values.
        \(dqlease\-checks\(dq: \(dqfix\-del\(dq
    },

    // Option 43 last resort definition can make well\-formed messages
    // to be rejected because they use not compatible \(dqraw\(dq value,
    // and different vendors may define different sub\-options.
    // The option definition should be applied to avoid these problems,
    // for instance by defining at the global scope the option as binary.
    // In client\-classes the option may be redefined as carrying vendor
    // dependent sub\-options.
    \(dqoption\-def\(dq: [ {
        \(dqname\(dq: \(dqvendor\-encapsulated\-options\(dq,
        \(dqcode\(dq: 43,
        \(dqtype\(dq: \(dqbinary\(dq
    } ],

    // We need to specify the database used to store leases. As of
    // June 2022, three database backends are supported: MySQL,
    // PostgreSQL and the in\-memory database, Memfile.
    // We\(aqll use memfile because it doesn\(aqt require any prior set up.
    // For memfile, it\(aqs important to always specify lfc\-interval, so
    // the lease file would not grow without bounds and be sanitized
    // once per hour.
    \(dqlease\-database\(dq: {
        \(dqtype\(dq: \(dqmemfile\(dq,
        \(dqlfc\-interval\(dq: 3600
    },

    // This defines a control socket. If defined, Kea will open a UNIX socket
    // and will listen for incoming commands. See section 15 of the Kea User\(aqs
    // Guide for list of supported commands.
    \(dqcontrol\-socket\(dq: {
        \(dqsocket\-type\(dq: \(dqunix\(dq,
        \(dqsocket\-name\(dq: \(dqkea4\-ctrl\-socket\(dq
    },

    // Addresses will be assigned with a lifetime of 4000 seconds.
    // The client is told to start renewing after 1000 seconds. If the server
    // does not respond within 2000 seconds of the lease being granted, client
    // is supposed to start REBIND procedure (emergency renewal that allows
    // switching to a different server).
    \(dqvalid\-lifetime\(dq: 4000,
    \(dqrenew\-timer\(dq: 1000,
    \(dqrebind\-timer\(dq: 2000,

    // RFC6842 says that the server is supposed to echo back client\-id option.
    // However, some older clients do not support this and are getting confused
    // when they get their own client\-id. Kea can disable RFC6842 support.
    \(dqecho\-client\-id\(dq: false,

    // Some clients don\(aqt use stable client identifier, but rather
    // generate them during each boot. This may cause a client that
    // reboots frequently to get multiple leases, which may not be
    // desirable. As such, sometimes admins prefer to tell their DHCPv4
    // server to ignore client\-id value altogether and rely exclusively
    // on MAC address. This is a parameter that is defined globally, but
    // can be overridden on a subnet level.
    \(dqmatch\-client\-id\(dq: true,

    // By default, Kea ignores requests by clients for unknown IP addresses,
    // because other non\-cooperating DHCP servers could reside on the same
    // network (RFC 2131). This parameter is defined globally, but can be
    // overridden on a subnet level
    \(dqauthoritative\(dq: false,

    // The following list defines subnets. Each subnet consists of at
    // least subnet and pool entries. One extra feature that requires
    // some explanation is user\-context. This is a structure that you can
    // define in subnets, pools and others. It is parsed by Kea, but not
    // used directly.  It is intended to keep anything you may want to
    // put there \- comments, extra designations, floor or department
    // names etc. These structures will be made available to Kea hooks.
    // A comment entry is translated into a user\-context with a
    // \(dqcomment\(dq property so you can include comments inside the
    // configuration itself.
    \(dqsubnet4\(dq: [
        {
            \(dqpools\(dq: [ {
                \(dqpool\(dq:  \(dq192.0.2.1 \- 192.0.2.200\(dq,
                \(dquser\-context\(dq: { \(dqinfo\(dq: \(dqwhat a large pool\(dq }
            } ],
            \(dqid\(dq: 1,
            \(dqsubnet\(dq: \(dq192.0.2.0/24\(dq,
            \(dquser\-context\(dq: {
                \(dqcomment\(dq: \(dqOur first subnet!\(dq
            }
            // Equivalent using smart parser
            // \(dqcomment\(dq: \(dqOur first subnet!\(dq
        },
        {
            // This particular subnet has match\-client\-id value changed.
            // This causes Kea to ignore client\-id values in this subnet
            // and rely exclusively on MAC addresses.
            \(dqpools\(dq: [ { \(dqpool\(dq: \(dq192.0.3.100 \- 192.0.3.200\(dq } ],
            \(dqid\(dq: 2,
            \(dqsubnet\(dq: \(dq192.0.3.0/24\(dq,
            \(dqmatch\-client\-id\(dq: false
        },
        {
            \(dqpools\(dq: [ { \(dqpool\(dq: \(dq192.0.4.1 \- 192.0.4.254\(dq } ],
            \(dqid\(dq: 3,
            \(dqsubnet\(dq: \(dq192.0.4.0/24\(dq,

            // Sometimes the relay may use an IPv4 address that does
            // not match the subnet. This is discouraged, but there are
            // valid cases when it makes sense. One case is when there
            // is a shared subnet.
            \(dqrelay\(dq: {
                \(dqip\-addresses\(dq: [ \(dq192.168.1.1\(dq ]
            }
        },
        {
            // This particular subnet has the authoritative value changed.
            // This causes Kea to reply to requests for unknown IP addresses
            // with a DHCPNAK message.
            \(dqpools\(dq: [ { \(dqpool\(dq: \(dq192.0.5.100 \- 192.0.5.200\(dq } ],
            \(dqid\(dq: 4,
            \(dqsubnet\(dq: \(dq192.0.5.0/24\(dq,
            \(dqauthoritative\(dq: true
        }
    ],

    // The following configures logging. It assumes that messages with
    // at least informational level (info, warn, error and fatal) should
    // be logged to stdout.
    \(dqloggers\(dq: [
          {
            \(dqname\(dq: \(dqkea\-dhcp4\(dq,
              \(dqoutput\-options\(dq: [
                  {
                      \(dqoutput\(dq: \(dqstdout\(dq,
                      // Several additional parameters are possible in addition
                      // to the typical output. Flush determines whether logger
                      // flushes output to a file. Maxsize determines maximum
                      // filesize before the file is rotated. maxver
                      // specifies the maximum number of rotated files being
                      // kept.
                      \(dqflush\(dq: true,
                      \(dqmaxsize\(dq: 204800,
                      \(dqmaxver\(dq: 4,
                      // We use pattern to specify custom log message layout
                      \(dqpattern\(dq: \(dq%d{%y.%m.%d %H:%M:%S.%q} %\-5p [%c/%i] %m\en\(dq
                  }
              ],
              \(dqseverity\(dq: \(dqINFO\(dq
          }
      ]
  }

}
.EE
.UNINDENT
.UNINDENT
.SS kea4/all\-keys\-netconf.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// WARNING: This example configuration is not meant for production use.
// The Kea DHCPv4 server will refuse this configuration because it contains
// mutually exclusive configuration parameters.
//
// The primary purpose of the example file is to provide a comprehensive
// list of parameters supported by the Kea DHCPv4 server, along with a brief
// description of each parameter.
//
// This stable version is used for YANG, as we do not want to update code
// and models each time a keyword is added to the syntax.
{
    // Kea DHCPv4 server configuration begins here.
    \(dqDhcp4\(dq: {
        // Global flag selecting an IP address allocation strategy for all
        // subnets. Use \(dqrandom\(dq for a random allocation strategy.
        \(dqallocator\(dq: \(dqiterative\(dq,

        // Global authoritative flag to handle requests by clients for
        // unknown IP addresses (ignore if disabled, NAK if enabled).
        \(dqauthoritative\(dq: false,

        // Global bootfile name to be set in the \(aqfile\(aq field.
        \(dqboot\-file\-name\(dq: \(dq/dev/null\(dq,

        // Ordered list of client classes used by the DHCPv4 server.
        \(dqclient\-classes\(dq: [
            {
                // Class\-specific bootfile name to be set in the \(aqfile\(aq field.
                \(dqboot\-file\-name\(dq: \(dq/usr/local/share/kea/bootfile.efi\(dq,

                // Class name.
                \(dqname\(dq: \(dqphones_server1\(dq,

                // Class\-specific next server address to use in bootstrap, which
                // is set in \(aqsiaddr\(aq field.
                \(dqnext\-server\(dq: \(dq10.2.3.4\(dq,

                // Class\-specific DHCPv4 options list.
                \(dqoption\-data\(dq: [],

                // Class\-specific DHCPv4 option definitions, i.e. custom formats
                // specified for non\-standard options.
                \(dqoption\-def\(dq: [],

                // Class\-specific optional server hostname, which is set in
                // \(aqsname\(aq field.
                \(dqserver\-hostname\(dq: \(dq\(dq,

                // Class selection expression. The DHCP packet is assigned to this
                // class when the given expression evaluates to true.
                \(dqtest\(dq: \(dqmember(\(aqHA_server1\(aq)\(dq,

                // Class valid lifetime.
                \(dqvalid\-lifetime\(dq: 6000,

                // Class min valid lifetime.
                \(dqmin\-valid\-lifetime\(dq: 4000,

                // Class max valid lifetime.
                \(dqmax\-valid\-lifetime\(dq: 8000,

                // If greater than zero, it is the lifetime of leases temporarily allocated
                // on DISCOVER. When zero (the default), leases are not allocated on DISCOVER.
                \(dqoffer\-lifetime\(dq : 65
            },
            {
                // Default value of the class\-specific bootfile name. An empty name
                // means that the bootfile name is unspecified.
                \(dqboot\-file\-name\(dq: \(dq\(dq,

                // Second class name.
                \(dqname\(dq: \(dqphones_server2\(dq,

                // Default value of the class\-specific next server address. The
                // zero IPv4 address means that it is unspecified.
                \(dqnext\-server\(dq: \(dq0.0.0.0\(dq,

                // Class\-specific DHCPv4 options list.
                \(dqoption\-data\(dq: [],

                // Class\-specific DHCPv4 option definitions, i.e. custom formats
                // specified for non\-standard options.
                \(dqoption\-def\(dq: [],

                // Class\-specific optional server hostname, which is set in
                // \(aqsname\(aq field.
                \(dqserver\-hostname\(dq: \(dq\(dq,

                // Class selection expression. The DHCP packet is assigned to this
                // class when the given expression evaluates to true.
                \(dqtest\(dq: \(dqmember(\(aqHA_server2\(aq)\(dq
            },
            {
                // Third class name.
                \(dqname\(dq: \(dqlate\(dq,

                // Boolean flag indicating whether the class expression is only evaluated
                // when the selected configuration (i.e. pool, subnet, shared\-network)
                // includes this class name in its \(dqevaluate\-additional\-classes\(dq list. The
                // default value false means that the class test expression must
                // always be evaluated.
                \(dqonly\-in\-additional\-list\(dq: true,

                // Class selection expression.
                \(dqtest\(dq: \(dqmember(\(aqALL\(aq)\(dq
            },
            {
                // Fourth class name.
                \(dqname\(dq: \(dqmy\-template\-class\(dq,

                // Template class flag that holds the expression used to generate the names for all
                // the spawned subclasses. In this case, the classes are named after the client ID.
                \(dqtemplate\-test\(dq: \(dqsubstring(option[61].hex, 0, all)\(dq
            }
        ],

        // Parameters for triggering behaviors compatible with broken or
        // non\-compliant clients, relays, or other agents
        \(dqcompatibility\(dq: {
            // Ignore DHCP Server Identifier option if set to true.
            // Enabling this will cause Kea to accept any query, even
            // if the address in the option belongs to another server,
            // instead of dropping it. This config option defaults to
            // false, as enabling it breaks RFC compliance.
            \(dqignore\-dhcp\-server\-identifier\(dq: false,

            // Ignore Relay Agent Information Link Selection suboption if set
            // to true. Enabling this will cause Kea to use normal subnet
            // selection logic instead of attempting to use the subnet
            // specified in the suboption. This config option defaults to
            // false, as enabling it breaks RFC compliance.
            \(dqignore\-rai\-link\-selection\(dq: false,

            // Parse options more leniently where fields can be deduced
            // deterministically, even if against RFC or common practice.
            \(dqlenient\-option\-parsing\(dq: true,

            // Boolean flag indicating whether .0 and .255 addresses
            // must be considered as never free in subnets with a prefix length
            // of 24 or less. The default is false, as these addresses are not
            // special; only the first and the last addresses are.
            \(dqexclude\-first\-last\-24\(dq: false
        },

        // Command control socket configuration parameters for the Kea DHCPv4 server.
        \(dqcontrol\-sockets\(dq: [
            {
                // Control socket type used by the Kea DHCPv4 server.
                // Must be unix, http or https.
                \(dqsocket\-type\(dq: \(dqunix\(dq,

               // Location of the UNIX domain socket file the DHCPv4
               // server uses to receive control commands from the
               // local server administrator.
               \(dqsocket\-name\(dq: \(dqkea4\-ctrl\-socket\(dq
            },
            {
                // Control socket type used by the Kea DHCPv4 server.
                // Must be unix, http or https.
                \(dqsocket\-type\(dq: \(dqhttps\(dq,

                // Address of the HTTPS socket the Kea DHCPv4 server should
                // listen for incoming queries.
                \(dqsocket\-address\(dq: \(dq127.0.0.1\(dq,

                // Port of the HTTPS socket the Kea DHCPv4 server
                // should listen for incoming queries. If enabling HA
                // and multi\-threading, the 8000 port is used by the
                // HA hook library http listener. When using HA hook
                // library with multi\-threading to function, make sure
                // the port used by dedicated listener is different
                // (e.g. 8001) than the one specified here.  Note the
                // commands should still be sent to a control socket.
                // The dedicated listener is specifically for HA
                // updates only.
                \(dqsocket\-port\(dq: 8004,

                // TLS trust anchor (Certificate Authority). This is a
                // file name or a directory path. Make sense with other
                // TLS parameters only for the https control socket type.
                \(dqtrust\-anchor\(dq: \(dqmy\-ca\(dq,

                // TLS server certificate file name.
                \(dqcert\-file\(dq: \(dqmy\-cert\(dq,

                // TLS server private key file name.
                \(dqkey\-file\(dq: \(dqmy\-key\(dq,

                // TLS require client certificates flag. Default is
                // true and means require client certificates. False
                // means they are optional.
                \(dqcert\-required\(dq: true,

                // Extra HTTP headers to add in responses.
                \(dqhttp\-headers\(dq:
                [
                    {
                        // Optional user context.
                        \(dquser\-context\(dq: { \(dqcomment\(dq: \(dqHSTS header\(dq },

                        // Required HTTP header name.
                        \(dqname\(dq: \(dqStrict\-Transport\-Security\(dq,

                        // Required HTTP header value.
                        \(dqvalue\(dq: \(dqmax\-age=31536000\(dq
                    }
                ],

                // Optional authentication.
                \(dqauthentication\(dq: {

                    // Required authentication type. The only
                    // supported value is basic for the basic HTTP
                    // authentication.
                    \(dqtype\(dq: \(dqbasic\(dq,

                    // An optional parameter is the basic HTTP
                    // authentication realm.  Its default is
                    // \(dqkea\-dhcpv4\-server\(dq
                    \(dqrealm\(dq: \(dqkea\-dhcpv4\-server\(dq,

                    // This optional parameter can be used to specify a common
                    // prefix for files handling client credentials.
                    \(dqdirectory\(dq: \(dq/usr/local/share/kea/kea\-creds\(dq,

                    // This list specifies the user ids and passwords
                    // to use for basic HTTP authentication. If empty
                    // or not present any client is authorized.
                    \(dqclients\(dq: [
                        // This specifies an authorized client.
                        {
                            // The user id must not be empty or
                            // contain the \(aq:\(aq character. It is a
                            // mandatory parameter.
                            \(dquser\(dq: \(dqadmin\(dq,

                            // If password is not specified an empty
                            // password is used.
                            \(dqpassword\(dq: \(dq1234\(dq
                        },

                        // This specifies a hidden client.
                        {
                            // The user id is the content of the
                            // file /usr/local/share/kea/kea\-creds/hiddenu.
                            \(dquser\-file\(dq: \(dqhiddenu\(dq,

                            // The password is the content of the
                            // file /usr/local/share/kea/kea\-creds/hiddenp.
                            \(dqpassword\-file\(dq: \(dqhiddenp\(dq
                        },

                        // This specifies a hidden client using a
                        // secret in a file.
                        {
                            // The secret is the content of the file
                            // /usr/local/share/kea/kea\-creds/hiddens which must be in
                            // the <user\-id>:<password> format.
                            \(dqpassword\-file\(dq: \(dqhiddens\(dq
                        }
                    ]
                }
            }
        ],

        // Specifies a prefix to be prepended to the generated Client FQDN.
        // It may be specified at the global, shared\-network, and subnet levels.
        \(dqddns\-generated\-prefix\(dq: \(dqmyhost\(dq,

        // Boolean flag indicating whether the server should ignore DHCP client
        // wishes to update DNS on its own. With that flag set to true,
        // the server will send DNS updates for both forward and
        // reverse DNS data. The default value is false, which indicates
        // that the server will delegate a DNS update to the client when
        // requested. It may be specified at the global, shared\-network,
        // and subnet levels.
        \(dqddns\-override\-client\-update\(dq: false,

        // Boolean flag indicating whether the server should override the DHCP
        // client\(aqs wish to not update the DNS. With this parameter
        // set to true, the server will send a DNS update even when
        // the client requested no update. It may be specified at the
        // global, shared\-network, and subnet levels.
        \(dqddns\-override\-no\-update\(dq: false,

        // Suffix appended to the partial name sent to the DNS. The
        // default value is an empty string, which indicates that no
        // suffix is appended. It may be specified at the global,
        // shared\-network, and subnet levels.
        \(dqddns\-qualifying\-suffix\(dq: \(dq\(dq,

        // Enumeration specifying whether the server should honor
        // the hostname or Client FQDN sent by the client or replace
        // this name. The acceptable values are: \(dqnever\(dq (use the
        // name the client sent), \(dqalways\(dq (replace the name the
        // client sent), \(dqwhen\-present\(dq (replace the name the client
        // sent, but do not generate one when the client didn\(aqt send
        // the name), \(dqwhen\-not\-present\(dq (generate the name when
        // client didn\(aqt send one, otherwise leave the name the
        // client sent). The default value is \(dqnever\(dq. It may be
        // specified at the global, shared\-network, and subnet levels.
        \(dqddns\-replace\-client\-name\(dq: \(dqnever\(dq,

        // Boolean flag which enables or disables DDNS updating. It
        // defaults to true. It may be specified at the global, shared\-
        // network, and subnet levels. It works in conjunction with
        // dhcp\-ddns:enable\-updates, which must be true to enable connectivity
        // to kea\-dhcp\-ddns.
        \(dqddns\-send\-updates\(dq: true,

        // Boolean flag, which when true instructs the server to always
        // update DNS when leases are renewed, even if the DNS information
        // has not changed. The server\(aqs default behavior (i.e. flag is false)
        // is to only update DNS if the DNS information has changed. It
        // may be specified at the global, shared\-network, and subnet levels.
        \(dqddns\-update\-on\-renew\(dq: true,

        // Boolean flag which is passed to kea\-dhcp\-ddns with each DDNS
        // update request, to indicate whether DNS update conflict
        // resolution as described in RFC 4703 should be employed for the
        // given update request. The default value for this flag is true.
        // It may be specified at the global, shared\-network, and subnet levels.
        // This field has been replaced by ddns\-conflict\-resolution\-mode.
        // Parsing is maintained only for backwards compatibility.
        // \(dqddns\-use\-conflict\-resolution\(dq: true,

        // Enumeration, which is passed to kea\-dhcp\-ddns with each DDNS
        // update request to indicate the mode used for resolving conflicts
        // while performing DDNS updates. The acceptable values are:
        // check\-with\-dhcid (this includes adding a DHCID record and checking
        // that record via conflict detection as per RFC 4703,
        // no\-check\-with\-dhcid (this will ignore conflict detection but add
        // a DHCID record when creating/updating an entry),
        // check\-exists\-with\-dhcid (this will check if there is an existing
        // DHCID record but does not verify the value of the record matches
        // the update. This will also update the DHCID record for the entry),
        // no\-check\-without\-dhcid (this ignores conflict detection and will
        // not add a DHCID record when creating/updating a DDNS entry).
        // The default value is \(dqcheck\-with\-dhcid\(dq. It may be
        // specified at the global, shared\-network and subnet levels.
        \(dqddns\-conflict\-resolution\-mode\(dq: \(dqcheck\-with\-dhcid\(dq,

        // When greater than 0.0, it is the percent of the lease\(aqs lifetime
        // to use for the DNS TTL.
        \(dqddns\-ttl\-percent\(dq: 0.75,

        // When greater than 0 it will be used as the DNS TTL. Specified in seconds.
        // You cannot specify both ddns\-ttl and any of ddns\-ttl\-percent, ddns\-ttl\-min, or
        // ddns\-ttl\-max. They are mutually exclusive.
        // \(dqddns\-ttl\(dq: 500,

        // When greater than 0 it used as the lower boundary for calculated DNS TTL values.
        // Specified in seconds.
        \(dqddns\-ttl\-min\(dq: 24000,

        // When greater than 0 it used as the upper boundary for calculated DNS TTL values.
        // Specified in seconds.
        \(dqddns\-ttl\-max\(dq: 64000,

        // Time in seconds specifying how long a declined lease should be
        // excluded from DHCP assignments. The default value is 86400 (24 hours).
        \(dqdecline\-probation\-period\(dq: 86400,

