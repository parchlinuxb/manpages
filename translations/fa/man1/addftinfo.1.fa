.
.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_addftinfo_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY addftinfo
.RB [ \-asc\-height\~\c
.IR n ]
.RB [ \-body\-depth\~\c
.IR n ]
.RB [ \-body\-height\~\c
.IR n ]
.RB [ \-cap\-height\~\c
.IR n ]
.RB [ \-comma\-depth\~\c
.IR n ]
.RB [ \-desc\-depth\~\c
.IR n ]
.RB [ \-fig\-height\~\c
.IR n ]
.RB [ \-x\-height\~\c
.IR n ]
.I resolution
.I unit-width
.I font
.YS
.
.
.P
.SY addftinfo
.B \-\-help
.YS
.
.
.P
.SY addftinfo
.B \-v
.YS
.
.SY addftinfo
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
دستور
.I addftinfo
یک فایل توصیف قلم
.RI AT&T \~troff
به نام
.I font
را خوانده، اطلاعات ابعادی قلم بیشتری را که توسط
GNU
.MR \%troff 1
مورد نیاز است به آن می‌افزاید و نتیجه ترکیب‌شده را در جریان خروجی استاندارد می‌نویسد.
.
اطلاعات اضافه‌شده از پارامترهای موجود قلم و فرضیات مربوط به نام‌های سنتی نویسه‌ها در
.I troff
مشتق می‌شوند.
.
از جمله مشخصات ابعادی اضافه‌شده، ارتفاع و عمق نویسه‌ها است
(اینکه هر نویسه چه مقدار به صورت عمودی در بالا و پایین خط مبنا امتداد می‌یابد).
.
آرگومان‌های
.I resolution
و
.I unit-width
باید با پارامترهای متناظر در فایل
.I DESC
یکسان باشند.
.
آرگومان
.I font
نام فایل توصیف‌کننده قلم است؛
اگر نام
.I font
به
.RB \[lq] I \[rq]
ختم شود، فرض می‌شود که قلم مایل
(یا ایتالیک)
است.
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
گزینه
.B \-\-help
پیام راهنمای استفاده را نمایش می‌دهد، در حالی که
.B \-v
و
.B \%\-\-version
اطلاعات نگارش را نمایش می‌دهند؛ پس از آن همگی خارج می‌شوند.
.
.
.P
تمامی گزینه‌های دیگر، پارامترهایی را تغییر می‌دهند که برای مشتق‌سازی ارتفاع و عمق‌ها به کار می‌روند.
.
مشابه مقادیر موجود در فایل توصیف قلم، هر
.RI مقدار\~ n
بر حسب
.I "پوینت‌های مقیاس‌شده (scaled points)،"
یعنی
.RI inches/ resolution
برای قلمی با اندازه
.IR unit-width
است؛ به
.MR groff_font 5
مراجعه کنید.
.
.
.TP
.BI \-asc\-height \~n
ارتفاع نویسه‌های دارای دنباله بالارو (ascender)، مانند
\[lq]b\[rq]،
\[lq]d\[rq]
یا
\[lq]l\[rq]
.
.
.TP
.BI \-body\-depth \~n
عمق نویسه‌هایی مانند پرانتزها
.
.
.TP
.BI \-body\-height \~n
ارتفاع نویسه‌هایی مانند پرانتزها
.
.
.TP
.BI \-cap\-height \~n
ارتفاع حروف بزرگ مانند
\[lq]A\[rq]
.
.
.TP
.BI \-comma\-depth \~n
عمق نویسه ویرگول (کاما)
.
.
.TP
.BI \-desc\-depth \~n
عمق نویسه‌های دارای دنباله پایین‌رو (descender)، مانند
\[lq]p\[rq]،
\[lq]q\[rq]
یا
\[lq]y\[rq]
.
.
.TP
.B \-fig\-height
ارتفاع ارقام (اعداد)
.
.
.TP
.BI \-x\-height \~n
ارتفاع حروف کوچک بدون دنباله بالارو مانند
\[lq]x\[rq]
.
.
.P
دستور
.I addftinfo
هیچ تلاشی برای استفاده از پارامترهای مشخص‌شده جهت استنتاج پارامترهای نامشخص انجام نمی‌دهد.
.
اگر پارامتری مشخص نشده باشد،
از مقدار پیش‌فرض استفاده خواهد شد.
.
مقادیر پیش‌فرض به گونه‌ای انتخاب شده‌اند که مقادیر مناسبی برای قلم Times ایجاد کنند.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
دستور
.I \%addftinfo
در صورت اجرای موفقیت‌آمیز با وضعیت
.B 0
و در صورتی که برنامه نتواند آرگومان‌های خط فرمان خود را تفسیر کند با وضعیت
.B 2
خارج می‌شود.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.MR groff_font 5 ,
.MR groff 1 ,
.MR groff_char 7
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_addftinfo_1_man_C]
.do rr *groff_addftinfo_1_man_C
.
.
