class Person:
    # +1: [class\-variable\-slots\-conflict, class\-variable\-slots\-conflict, class\-variable\-slots\-conflict]
    __slots__ = (\(dqage\(dq, \(dqname\(dq, \(dqsay_hi\(dq)
    name = None

    def __init__(self, age, name):
        self.age = age
        self.name = name

    @property
    def age(self):
        return self.age

    def say_hi(self):
        print(f\(dqHi, I\(aqm {self.name}.\(dq)

