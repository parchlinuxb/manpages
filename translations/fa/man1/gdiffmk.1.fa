.
.
.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_gdiffmk_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY gdiffmk
.RB [ \-a\~\c
.IR add-mark ]
.RB [ \-c\~\c
.IR change-mark ]
.RB [ \-d\~\c
.IR delete-mark ]
.RB [ \-x\~\c
.IR diff-command ]
.RB [ \-D
.RB [ \-B ]
.RB [ \-M
.IR "mark1 mark2" ]]
.RB [ \-\- ]
.I file1
.I file2
.RI [ output-file ]
.YS
.
.
.P
.SY gdiffmk
.B \-\-help
.YS
.
.
.P
.SY gdiffmk
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
دستور
.I gdiffmk
دو سند
.MR roff 7
به نام‌های
.I file1
و
.I file2
را مقایسه کرده و سند دیگری را که از هر دوی آن‌ها مشتق شده است در جریان خروجی استاندارد
(یا
.IR output-file )
می‌نویسد، و در محل‌هایی از خروجی که اسناد ورودی با یکدیگر تفاوت دارند، درخواست‌های نویسه حاشیه
.RB ( mc )
را اضافه می‌کند.
.
.I gdiffmk
اسناد منبع را تفسیر نمی‌کند؛ این ابزار کامنت‌های
.I roff
و تغییرات بی‌اثر در قالب‌بندی را معنادار در نظر می‌گیرد.
.
به عنوان مثال، این برنامه درک نمی‌کند که
.BR \[rs]h\[aq]3m\[aq] ،
.BR \[rs]h\[aq](1\~*\~3m)\[aq]
و
.B \[rs]h\[aq]3m+0\[aq]
همگی دارای یک معنا هستند.
.
اگر آرگومان
.I file1
یا
.I file2
برابر
.RB \[lq] \- \[rq]
باشد،
.I gdiffmk
جریان ورودی استاندارد را برای آن ورودی می‌خواند.
.
اگر عملوند
.I output
مشخص شده باشد،
.I gdiffmk
خروجی را در فایلی با همان نام می‌نویسد.
.
اگر برابر
.RB \[lq] \- \[rq]
بوده یا تعیین نشده باشد،
.I gdiffmk
خروجی را در جریان خروجی استاندارد می‌نویسد.
.
عملوند
.RB \[lq] \- \[rq]
نمی‌تواند هم‌زمان هم عملوند ورودی و هم خروجی باشد.
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
گزینه
.B \-\-help
پیام راهنمای نحوه استفاده و گزینه
.B \%\-\-version
اطلاعات نسخه را نمایش می‌دهد؛ هر دو پس از نمایش خارج می‌شوند.
.
.
.TP
.BI \-a\~ add-mark
مطالبی را که در
.I file1
وجود ندارند اما در
.I file2
حاضر هستند، با
.I add-mark
نشانه‌گذاری می‌کند
(پیش‌فرض:
.RB \[lq] + \[rq]).
.
.
.TP
.B \-B
درخواست‌های
.B br
را که به طور معمول توسط گزینه
.B \-D
درج می‌شوند، متوقف (لغو) می‌کند.
.
با احتیاط استفاده شود؛ چنین درخواست‌هایی تنها راه تضمین نشانه‌گذاری حذفیات و تغییرات کوچک هستند.
.
.
.TP
.BI \-c\~ change-mark
مطالبی را که میان
.I file1
و
.I file2
متفاوت هستند، با
.I change-mark
نشانه‌گذاری می‌کند
(پیش‌فرض:
.RB \[lq] | \[rq]).
.
.
.TP
.BI \-d\~ delete-mark
مطالبی را که در
.I file1
وجود دارند اما در
.I file2
حاضر نیستند، با
.I delete-mark
نشانه‌گذاری می‌کند
(پیش‌فرض:
.RB \[lq] * \[rq]).
.
.TP
.B \-D
مطالب تغییریافته و حذف‌شده را با جداکننده‌های احاطه‌کننده علامت‌گذاری می‌کند.
.
.
.TP
.BI \-M\~ "mark1 mark2"
هنگام استفاده از گزینه
.BR \-D ،
از
.I mark1
(پیش‌فرض:
.RB \[lq] [[ \[rq])
و
.I mark2
(پیش‌فرض:
.RB \[lq] ]] \[rq])
به عنوان جداکننده استفاده می‌کند.
.
.
.TP
.BI \-x\~ diff-command
از برنامه
.I diff-command
برای انجام مقایسه میان
.I file1
و
.I file2
استفاده می‌کند.
.
.I diff-command
(پیش‌فرض:
.BR diff )
باید گزینه الحاقی
.B \-D
در GNU
.MR diff 1
را بپذیرد و پشتیبانی کند.
.
.
.TP
.B \-\-
تمامی آرگومان‌های بعدی را به عنوان نام فایل در نظر می‌گیرد، حتی اگر با
.RB \[lq] \- \[rq]
شروع شوند.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
دستور
.I gdiffmk
در صورت یکسان بودن فایل‌های ورودی با وضعیت
.B 0
خارج می‌شود؛
در صورت تفاوت آن‌ها با وضعیت
.BR 1 ؛
در صورت بروز خطای نحوه استفاده با وضعیت
.BR 2 ؛
اگر دستورات
.MR diff 1
یا
.MR sh 1
سیستم از ویژگی‌های مورد نیاز
.I gdiffmk
پشتیبانی نکنند با وضعیت
.BR 3 ؛
و اگر آرگومان
.I output
تکراری و منطبق بر
.I file1
یا
.I file2
باشد با وضعیت
.B 4
خارج خواهد شد.
.
.\" ====================================================================
.SH "هشدارها (CAVEATS)"
.\" ====================================================================
.
خروجی لزوماً با تمامی بسته‌های ماکرو یا پیش‌پردازنده‌ها سازگار نیست.
.
یک راهکار مطمئن این است که
.I gdiffmk
را به جای سورس ورودی، بر روی خروجی پیش‌پردازنده نهایی اجرا کنید.
.
.PP
.I gdiffmk
به گزینه
.B \-D
در GNU
.I diff
.\" The hair space `\^` is a kludge--see Savannah #67544.
برای ایجاد قالب خروجی ادغام‌شده \[lq]#ifdef\^\[rq] وابسته است.
.
مشخص شده است که
.I diff
موجود در Busybox از این گزینه پشتیبانی نمی‌کند.
.
همچنین گزینه
.BI \-x\~ diff-command
را ببینید.
.
.
.\" ====================================================================
.SH "نویسندگان (AUTHORS)"
.\" ====================================================================
.
.I gdiffmk
توسط
.MT MBianchi@\:Foveal\:.com
Mike Bianchi
.ME ،
که اکنون بازنشسته شده است، نوشته شده است.
.
این برنامه توسط توسعه‌دهندگان
.I groff
نگهداری می‌شود.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.MR groff 1 ,
.MR \%nroff 1 ,
.MR \%troff 1 ,
.MR roff 7 ,
.MR diff 1
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_gdiffmk_1_man_C]
.do rr *groff_gdiffmk_1_man_C
.
.
