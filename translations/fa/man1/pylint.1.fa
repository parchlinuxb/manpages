    \(dqstrawberry\(dq: 2.5,
    \(dqmandarin\(dq: 2.3,
    \(dqplum\(dq: 0.5,
    \(dqwatermelon\(dq: 6.4,
}
DISCOUNTED_FRUITS = [\(dqapple\(dq, \(dqwatermelon\(dq]


def fifty_percent_off(whole):
    return (float(whole)) * 50 / 100


def get_price(fruit):
    full_price = FRUIT_PRICES.get(fruit)
    if fruit in DISCOUNTED_FRUITS:
        return fifty_percent_off(full_price)
    else:
        return full_price


def display_fruit_and_price(fruits):
    for fruit in fruits:
        print(f\(dq{fruit} ${get_price(fruit) :.2f}\(dq)


def get_total(fruits):
    return sum(get_price(f) for f in fruits)


fruits_to_buy = [\(dqapple\(dq, \(dqorange\(dq, \(dqwatermelon\(dq]
display_fruit_and_price(fruits_to_buy)
print(f\(dqTotal price is ${get_total(fruits_to_buy):.2f}\(dq)

