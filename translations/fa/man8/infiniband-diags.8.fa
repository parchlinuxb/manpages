[22]    \(dqH\-0008f10403961354\(dq[1](8f10403961355)         # \(dqMT23108 InfiniHost Mellanox Technologies\(dq lid 4 4xSDR
[10]    \(dqS\-0008f10400410015\(dq[1]         # \(dqSW\-6IB4 Voltaire\(dq lid 3 4xSDR
[8]     \(dqH\-0008f10403960558\(dq[2](8f1040396055a)         # \(dqMT23108 InfiniHost Mellanox Technologies\(dq lid 14 4xSDR
[6]     \(dqS\-0008f10400410015\(dq[3]         # \(dqSW\-6IB4 Voltaire\(dq lid 3 4xSDR
[12]    \(dqH\-0008f10403960558\(dq[1](8f10403960559)         # \(dqMT23108 InfiniHost Mellanox Technologies\(dq lid 10 4xSDR

vendid=0x8f1
devid=0x5a05
switchguid=0x8f10400410015(8f10400410015)
Switch  8 \(dqS\-0008f10400410015\(dq          # \(dqSW\-6IB4 Voltaire\(dq base port 0 lid 3 lmc 0
[6]     \(dqH\-0008f10403960984\(dq[1](8f10403960985)         # \(dqMT23108 InfiniHost Mellanox Technologies\(dq lid 16 4xSDR
[4]     \(dqH\-005442b100004900\(dq[1](5442b100004901)        # \(dqMT23108 InfiniHost Mellanox Technologies\(dq lid 12 4xSDR
[1]     \(dqS\-005442ba00003080\(dq[10]                # \(dqISR9024 Voltaire\(dq lid 6 1xSDR
[3]     \(dqS\-005442ba00003080\(dq[6]         # \(dqISR9024 Voltaire\(dq lid 6 4xSDR

vendid=0x2c9
devid=0x5a44
caguid=0x8f10403960984
Ca      2 \(dqH\-0008f10403960984\(dq          # \(dqMT23108 InfiniHost Mellanox Technologies\(dq
[1](8f10403960985)     \(dqS\-0008f10400410015\(dq[6]         # lid 16 lmc 1 \(dqSW\-6IB4 Voltaire\(dq lid 3 4xSDR

vendid=0x2c9
devid=0x5a44
caguid=0x5442b100004900
Ca      2 \(dqH\-005442b100004900\(dq          # \(dqMT23108 InfiniHost Mellanox Technologies\(dq
[1](5442b100004901)     \(dqS\-0008f10400410015\(dq[4]         # lid 12 lmc 1 \(dqSW\-6IB4 Voltaire\(dq lid 3 4xSDR

vendid=0x2c9
devid=0x5a44
caguid=0x8f10403961354
