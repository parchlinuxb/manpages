.TH GVGEN 1 "5 June 2012"
.SH "نام (NAME)"
gvgen \- تولید انواع گراف‌های انتزاعی و منظم
.SH "خلاصه دستور (SYNOPSIS)"
.B gvgen
[
.B \-dv?
]
[
.BI \-i n
]
[
.BI \-c n
]
[
.BI \-C x,y
]
[
.BI \-g [\fBf\fP]x,y
]
[
.BI \-G [\fBf\fP]x,y
]
[
.BI \-h n
]
[
.BI \-k n
]
[
.BI \-b x,y
]
[
.BI \-B x,y
]
[
.BI \-m n
]
[
.BI \-M x,y
]
[
.BI \-p n
]
[
.BI \-r x,y
]
[
.BI \-R x
]
[
.BI \-s n
]
[
