  interfaces_config ::= \(dqinterfaces\-config\(dq \(dq:\(dq \(dq{\(dq interfaces_config_params \(dq}\(dq

  interfaces_config_params ::= interfaces_config_param
                          | interfaces_config_params \(dq,\(dq interfaces_config_param
