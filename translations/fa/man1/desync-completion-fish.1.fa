.nh
.TH "desync" "1" "Sep 2026" "desync" ""

.SH "نام (NAME)"
desync-completion-fish \- Generate the autocompletion script for fish


.SH "خلاصه دستور (SYNOPSIS)"
\fBdesync completion fish [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Generate the autocompletion script for the fish shell.

.PP
To load completions in your current shell session:

.EX
desync completion fish | source
.EE

.PP
To load completions for every new session, execute once:

.EX
desync completion fish > ~/.config/fish/completions/desync.fish
.EE

.PP
You will need to start a new shell for this setup to take effect.


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	help for fish

.PP
\fB--no-descriptions\fP[=false]
	disable completion descriptions


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config file (default $HOME/.config/desync/config.json)

.PP
\fB--digest\fP="sha512-256"
	digest algorithm, sha512-256 or sha256

.PP
\fB--verbose\fP[=false]
	verbose mode


.SH "همچنین ببینید (SEE ALSO)"
\fBdesync-completion(1)\fP


