T}
.TE
.sp
.sp
توجه داشته باشید که اشیاء ماهواره فاقد فیلد «class» هستند، زیرا هرگز خارج از یک شیء SKY ارسال نمی‌شوند.
.sp
هنگامی که کتابخانه کلاینت C یک پاسخ SKY را تجزیه می‌کند، بیت SATELLITE_SET را در عضو set سطح بالا فعال می‌سازد.
.sp
نمونه:
.sp
.if n .RS 4
.nf
.fam C
{"class":"SKY","device":"/dev/pts/1",
    "time":"2005\-07\-08T11:28:07.114Z",
    "xdop":1.55,"hdop":1.24,"pdop":1.99,
    "satellites":[
        {"PRN":23,"el":6,"az":84,"ss":0,"used":false},
        {"PRN":28,"el":7,"az":160,"ss":0,"used":false},
        {"PRN":8,"el":66,"az":189,"ss":44,"used":true},
        {"PRN":29,"el":13,"az":273,"ss":0,"used":false},
        {"PRN":10,"el":51,"az":304,"ss":29,"used":true},
        {"PRN":4,"el":15,"az":199,"ss":36,"used":true},
        {"PRN":2,"el":34,"az":241,"ss":43,"used":true},
        {"PRN":27,"el":71,"az":76,"ss":43,"used":true}]}
.fam
.fi
.if n .RE
.SS "GST"
.sp
شیء GST یک گزارش نویز شبه‌فاصله است.
.sp
.it 1 an-trap
.nr an-no-space-flag 1
.nr an-break-flag 1
.br
.B جدول ۴. شیء GST
.TS
allbox tab(:);
ltB ltB ltB ltB.
