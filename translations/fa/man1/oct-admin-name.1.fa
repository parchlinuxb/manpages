.ie \n(.g .ds Aq \(aq
.el .ds Aq '
.TH oct-admin-name 1  "oct-admin-name " 
.SH "نام (NAME)"
oct\-admin\-name \- Set cardholder name
.SH "خلاصه دستور (SYNOPSIS)"
\fBoct admin name\fR [\fB\-h\fR|\fB\-\-help\fR] <\fINAME\fR> 
.SH "توضیحات (DESCRIPTION)"
Set cardholder name
.SH "گزینه‌ها (OPTIONS)"
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
<\fINAME\fR>
cardholder name to set on the card
