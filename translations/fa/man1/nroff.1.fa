.
.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_nroff_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY \%nroff
.RB [ \-abcCEhikpRStUVzZ ]
.RB [ \-d\~\c
.IR ctext ]
.RB [ \-d\~\c
.IB string =\c
.IR text ]
.RB [ \-D\~\c
.IR fallback-input-encoding ]
.RB [ \-I\~\c
.IR inclusion-directory ]
.RB [ \-K\~\c
.IR input-encoding ]
.RB [ \-m\~\c
.IR macro-package ]
.RB [ \-M\~\c
.IR macro-directory ]
.RB [ \-n\~\c
.IR page-number ]
.RB [ \-o\~\c
.IR page-list ]
.RB [ \-P\~\c
.IR postprocessor-argument ]
.RB [ \-r\~\c
.IR cnumeric-expression ]
.RB [ \-r\~\c
.IB register =\c
.IR numeric-expression ]
.RB [ \-T\~\c
.IR output-device ]
.RB [ \-w\~\c
.IR warning-category ]
.RB [ \-W\~\c
.IR warning-category ]
.RI [ file\~ .\|.\|.]
.YS
.
.
.P
.SY \%nroff
.B \-\-help
.YS
.
.
.P
.SY \%nroff
.B \-v
.RI [ other-nroff-option \~.\|.\|.]
.YS
.
.SY \%nroff
.B \%\-\-version
.RI [ other-nroff-option \~.\|.\|.]
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
دستور
.I \%nroff
اسناد نوشته‌شده به زبان
.MR groff 7
را برای دستگاه‌های شبیه به ماشین‌تحریر مانند شبیه‌سازهای ترمینال قالب‌بندی می‌کند.
.
نسخه گنو
.I nroff \" GNU
دستور
.I nroff \" AT&T
در AT&T را با استفاده از
.MR groff 1
شبیه‌سازی می‌کند.
.
دستور
.I \%nroff
خروجی را از طریق
.MR grotty 1
(درایور خروجی ترمینال در
.IR groff )
تولید می‌کند که باید از طرح کدگذاری نویسه مورد استفاده دستگاه مطلع باشد.
.
در نتیجه، آرگومان‌های مجاز برای گزینه
.B \-T
عبارتند از
.BR ascii ،
.BR latin1
و
.BR utf8 ؛
هر مقدار دیگری نادیده گرفته می‌شود.
.
اگر نه متغیر محیطی
.I \%GROFF_TYPESETTER
و نه گزینه خط فرمان
.B \-T
(که متغیر محیطی را لغو می‌کند)
دستگاهی (معتبر) را مشخص نکنند،
.I \%nroff
برای انتخاب یک دستگاه خروجی مناسب، محلی‌سازی (locale) را بررسی می‌کند.
.
این برنامه ابتدا
.MR locale 1
را امتحان می‌کند،
سپس چندین متغیر محیطی مرتبط با محلی‌سازی را بررسی می‌نماید؛
بخش «محیط» در ادامه را ببینید.
.
اگر همه موارد فوق شکست بخورند،
.I \%nroff
مقدار
.RB \[lq] "\-T ascii" \[rq]
را فرض می‌کند.
.
.
.P
گزینه‌های
.BR \-a ،
.BR \-b ،
.BR \-c ،
.BR \-C ،
.BR \-d ،
.BR \-E ،
.BR \-i ،
.BR \-I ،
.BR \-m ،
.BR \-M ،
.BR \-n ،
.BR \-o ،
.BR \-r ،
.BR \-U ،
.BR \-w ،
.BR \-W
و
.B \-z
تأثیراتی دارند که در
.MR \%troff 1
شرح داده شده است.
.
گزینه‌های
.B \-c
و
.B \-h
به ترتیب به معنای
.RB \[lq] "\-P \-c" \[rq]
و
.RB \[lq] "\-P \-h" \[rq]
هستند؛
.B \-c
همچنین برای خود
.I \%troff
نیز معنادار است.
.
علاوه بر این، نسخه گنو
.I nroff \" GNU
گزینه‌های
.BR \-e ،
.BR \-q
و
.BR \-s
در
.I nroff \" AT&T
مربوط به AT&T را نادیده می‌گیرد.
.
صفحه راهنمای
.MR groff 1
گزینه‌های
.BR \-D ،
.BR \-k ،
.BR \-K ،
.BR \-p ،
.BR \-P ،
.BR \-R ،
.BR \-t ،
.BR \-S
و
.BR \-Z
را مستند کرده است.
.
گزینه
.B \-V
باعث می‌شود
.I \%nroff
دستور ساخته‌شده
.I groff
را در جریان خروجی استاندارد نمایش دهد،
اما آن را اجرا نکند.
.
گزینه‌های
.B \-v
و
.B \%\-\-version
اطلاعات نسخه
.I \%nroff
و برنامه‌هایی را که اجرا می‌کند نشان می‌دهند،
در حالی که
.B \-\-help
پیام راهنمای نحوه استفاده را نمایش می‌دهد؛
همگی پس از آن خارج می‌شوند.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
در صورت بروز مشکل در تجزیه آرگومان‌ها،
.I \%nroff
با
.RB "وضعیت\~" 2
خارج می‌شود؛
اگر هر یک از گزینه‌های
.BR \-V ،
.BR \-v ،
.BR \%\-\-version
یا
.B \-\-help
مشخص شده باشند با
.RB "وضعیت\~" 0
خارج می‌شود،
و در غیر این صورت با وضعیت خروج
.I groff
خاتمه می‌یابد.
.
.
.\" ====================================================================
.SH "محیط (ENVIRONMENT)"
.\" ====================================================================
.
به طور معمول،
جداکننده مسیرها در متغیرهای محیطی که به
.I PATH
ختم می‌شوند، دونقطه (:) است؛
این مورد ممکن است بسته به سیستم‌عامل متفاوت باشد.
.
به عنوان مثال،
ویندوز در عوض از نقطه ویرگول (;) استفاده می‌کند.
.
.
.TP
.I GROFF_BIN_PATH
دستورات
.I groff \" system
ابتدا در این دایرکتوری‌ها جستجو می‌شوند و پس از آن در دایرکتوری‌های مشخص‌شده در
.IR PATH .
.
اگر تنظیم نشده باشد، دایرکتوری محل نصب فایل‌های اجرایی گنو
.IR roff ،
یعنی
.IR /usr/\:\%bin ،
پیش از
.I PATH
جستجو می‌شود.
.
.
.TP
.I GROFF_TYPESETTER
دستگاه خروجی پیش‌فرض را برای
.I groff
مشخص می‌کند.
.
.
.TP
.I LC_ALL
.TQ
.I LC_CTYPE
.TQ
.I LANG
.TQ
.I LESSCHARSET
در صورتی که هیچ گزینه
.B \-T
داده نشده باشد و
.I \%GROFF_TYPESETTER
تنظیم نشده باشد، یا مقادیر مشخص‌شده نامعتبر باشند، به همین ترتیب برای یافتن الگوهای منطبق با کدگذاری‌های نویسه استانداردی که توسط
.I groff
پشتیبانی می‌شوند، بررسی می‌شوند.
.
.
.\" ====================================================================
.SH "فایل‌ها (FILES)"
.\" ====================================================================
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%tmac/\:\%tty\-char\:.tmac
تعاریف جایگزین (fallback) را برای نویسه‌های خاص
.I roff
مشخص می‌کند.
.
این تعاریف از نظر بصری نسبت به تعاریف
.I tty.tmac
تقریب ضعیف‌تری از خروجی حروف‌چینی‌شده ارائه می‌دهند، اما در عوض انتقال اطلاعات معنایی را ترجیح می‌دهند.
.
دستور
.I nroff
آن را به صورت خودکار بارگذاری می‌کند.
.
.
.\" ====================================================================
.SH "نکات (NOTES)"
.\" ====================================================================
.
برنامه‌های صفحه‌بند (pager) مانند
.MR more 1
و
.MR less 1
ممکن است برای مدیریت صحیح برخی توالی‌های خروجی به گزینه‌های خط فرمان نیاز داشته باشند؛
صفحه راهنمای
.MR grotty 1
را ببینید.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.MR groff 1 ,
.MR \%troff 1 ,
.MR grotty 1 ,
.MR locale 1 ,
.MR roff 7
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_nroff_1_man_C]
.do rr *groff_nroff_1_man_C
.
.
