\fBgpscat\fP(1), \fBgpspipe\fP(1),  xgps*(1). \fBxgpsspeed\fP(1)
.sp
\fBlibgps\fP(3), \fBlibgpsmm\fP(3)
.sp
\fBgpsd\fP(8)
.SH "منابع (RESOURCES)"
.sp
\fBوب‌سایت پروژه:\fP \c
