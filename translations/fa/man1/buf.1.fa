.TH "Buf" "1" "2026-07-17" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
buf \- رابط خط فرمان Buf


.SH "خلاصه دستور (SYNOPSIS)"
\fBbuf [flags]\fP


.SH "توضیحات (DESCRIPTION)"
ابزاری برای کار با Protocol Buffers و مدیریت منابع در رجیستری طرح‌واره Buf (BSR)


.SH "گزینه‌ها (OPTIONS)"
\fB--debug\fP[=false]
	فعال‌سازی ثبت وقایع اشکال‌زدایی

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای buf

.PP
\fB--help-tree\fP[=false]
	چاپ کل درخت زیردستورها

.PP
\fB--log-format\fP="color"
	قالب ثبت وقایع [text,color,json]

.PP
\fB--timeout\fP=0s
	مدت زمان تا پایان مهلت زمانی، تنظیم روی 0 به معنای بدون مهلت زمانی است

.PP
\fB--version\fP[=false]
	چاپ نسخه


