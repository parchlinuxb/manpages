.\" Pipe this output to groff -m man -K utf8 -T utf8 | less -R
.\"
.mso an.tmac
.TH "DUNE-OCAML-MERLIN" 1 "" "Dune 3.24.2" "Dune Manual"
.\" Disable hyphenation and ragged-right
.nh
.ad l
.SH "نام (NAME)"
dune-ocaml-merlin \- راه‌اندازی یک کارساز پیکربندی merlin
.SH "خلاصه دستور (SYNOPSIS)"
.P
\fBdune ocaml\N'45'merlin\fR [\fIOPTION\fR]…
.SH "توضیحات (DESCRIPTION)"
.P
دستور \fBdune ocaml\N'45'merlin\fR کارسازی را راه‌اندازی می‌کند که می‌توان برای دریافت اطلاعات \N'46'merlin از آن پرس‌وجو کرد\N'46' این دستور برای استفاده توسط خود Merlin در نظر گرفته شده است و خروجی کاربرپسند ارائه نمی‌دهد\N'46'
.SH "گزینه‌ها (OPTIONS)"
.TP 4
\fB\N'45'\N'45'action\N'45'stderr\N'45'on\N'45'success\fR=\fIVAL\fR
همانند \fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success\fR، اما برای خطای استاندارد به جای خروجی استاندارد\N'46' یک مقدار پیش‌فرض مناسب برای مخازن بزرگ یکپارچه (monorepo)، گزینه \fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success=swallow \N'45'\N'45'action\N'45'stderr\N'45'on\N'45'success=must\N'45'be\N'45'empty\fR است\N'46' این گزینه تضمین می‌کند که یک ساخت موفق دارای خروجی «تمیز» و خالی باشد\N'46'
.TP 4
\fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success\fR=\fIVAL\fR
تعیین نحوه برخورد با خروجی استاندارد اقدامات هنگام موفقیت آن‌ها\N'46' مقادیر ممکن عبارتند از: \fBprint\fR برای چاپ مستقیم آن در خروجی Dune، گزینه \fBswallow\fR برای نادیده گرفتن کامل آن، و \fBmust\N'45'be\N'45'empty\fR برای الزام به اینکه اقدام هیچ چیزی چاپ نکرده باشد\N'46' با مقدار \fBmust\N'45'be\N'45'empty\fR، اگر اقدامی چیزی در خروجی استاندارد خود بنویسد، Dune آن را به منزله شکست تلقی خواهد کرد\N'46' مقدار پیش‌فرض \fBprint\fR است\N'46'
.TP 4
\fB\N'45'\N'45'build\N'45'info\fR
نمایش اطلاعات ساخت\N'46'
.TP 4
\fB\N'45'\N'45'context\fR=\fICONTEXT\fR (absent=\fBdefault\fR)
انتخاب زمینه ساخت Dune که برای بازگرداندن اطلاعات استفاده می‌شود\N'46'
.TP 4
\fB\N'45'\N'45'display\N'45'separate\N'45'messages\fR
جداسازی پیام‌های خطا با یک خط خالی\N'46'
.TP 4
\fB\N'45'\N'45'error\N'45'reporting\fR=\fIVAL\fR (absent=\fBdeterministic\fR)
کنترل زمان گزارش خطاهای ساخت\N'46' مقدار \fBearly\fR خطاها را به محض کشف گزارش می‌دهد\N'46' مقدار \fBdeterministic\fR خطاها را در پایان ساخت با ترتیبی معین گزارش می‌کند\N'46' مقدار \fBtwice\fR هر خطا را دو بار گزارش می‌دهد: یک بار به محض کشف و بار دیگر در پایان ساخت با ترتیبی معین\N'46'
.TP 4
\fB\N'45'f\fR, \fB\N'45'\N'45'force\fR
اجرای مجدد اجباری اقدامات مرتبط با نام‌های مستعار، حتی اگر وابستگی‌های آن‌ها تغییر نکرده باشد\N'46'
.TP 4
\fB\N'45'\N'45'file\N'45'watcher\fR=\fIVAL\fR (absent=\fBautomatic\fR)
سازوکار شناسایی تغییرات در فایل‌های منبع\N'46' مقدار \fBautomatic\fR باعث می‌شود dune یک برنامه خارجی را برای شناسایی تغییرات اجرا کند\N'46' مقدار \fBmanual\fR برای اطلاع‌رسانی دستی تغییرات فایل‌ها به dune است\N'46'
.TP 4
\fB\N'45'\N'45'passive\N'45'watch\N'45'mode\fR
مشابه [\N'45'\N'45'watch]، اما ساخت تنها زمانی آغاز می‌شود که از خارج توسط یک RPC دستور داده شود\N'46'
.TP 4
\fB\N'45'\N'45'sandbox\fR=\fIVAL\fR (absent \fBDUNE_SANDBOX\fR env)
تنظیم حالت جعبه شنی (sandbox)\N'46' برخی اقدامات به حالت خاصی از جعبه شنی نیاز دارند، بنابراین این تنظیم را نادیده می‌گیرند\N'46' مقادیر مجاز عبارتند از: none، symlink، copy، hardlink\N'46'
.TP 4
\fB\N'45'\N'45'stop\N'45'on\N'45'first\N'45'error\fR
توقف فرایند ساخت به محض مواجهه با نخستین خطا\N'46'
.TP 4
\fB\N'45'w\fR, \fB\N'45'\N'45'watch\fR
به جای خاتمه دادن به فرایند ساخت پس از اتمام، به طور مداوم منتظر تغییرات فایل بمان\N'46'
.TP 4
\fB\N'45'\N'45'wait\N'45'for\N'45'filesystem\N'45'clock\fR
برنامه Dune برای بهبود عملکرد افزایشی، خلاصه‌ای از محتوای فایل‌ها تهیه می‌کند\N'46' این خلاصه‌ها خود ذخیره می‌شوند\N'46' در برخی موارد، Dune برای اطمینان‌پذیری نیاز دارد برخی از ورودی‌های حافظه پنهان خلاصه را حذف کند\N'46' این گزینه باعث می‌شود Dune منتظر پیشرفت ساعت سیستم فایل بماند تا نیازی به حذف چیزی نداشته باشد\N'46' شما احتمالاً نیازی به این گزینه نخواهید داشت؛ این سوییچ بیشتر برای توسعه‌دهندگان Dune جهت تکرارپذیرتر کردن آزمون‌های حافظه پنهان خلاصه مفید است\N'46'
.SH "گزینه‌های مشترک (COMMON OPTIONS)"
.P
این گزینه‌ها میان همه دستورها مشترک هستند\N'46'
.TP 4
\fB\N'45'\N'45'always\N'45'show\N'45'command\N'45'line\fR
همیشه خط فرمان کامل برنامه‌های اجراشده توسط dune را نمایش بده\N'46'
.TP 4
\fB\N'45'\N'45'auto\N'45'promote\fR
ارتقای خودکار فایل‌ها\N'46' این مشابه اجرای \fBdune promote\fR پس از پایان ساخت است\N'46'
.TP 4
\fB\N'45'\N'45'build\N'45'dir\fR=\fIFILE\fR (absent \fBDUNE_BUILD_DIR\fR env)
دایرکتوری ساخت مشخص‌شده\N'46' در صورت مشخص نشدن، مقدار پیش‌فرض _build است
.TP 4
\fB\N'45'\N'45'cache\fR=\fIVAL\fR (absent \fBDUNE_CACHE\fR env)
فعال یا غیرفعال کردن حافظه پنهان Dune (یکی از مقادیر \fBdisabled\fR، \fBenabled\N'45'except\N'45'user\N'45'rules\fR یا \fBenabled\fR)\N'46' پیش‌فرض `enabled\N'45'except\N'45'user\N'45'rules\N'39' است\N'46'
.TP 4
\fB\N'45'\N'45'cache\N'45'check\N'45'probability\fR=\fIVAL\fR (absent \fBDUNE_CACHE_CHECK_PROBABILITY\fR env)
بررسی تکرارپذیری ساخت با اجرای مجدد قواعد انتخاب‌شده به صورت تصادفی و مقایسه نتایج آن‌ها با موارد ذخیره‌شده در حافظه پنهان Dune\N'46' نکته: با افزایش احتمال این بررسی‌ها، سرعت ساخت را کاهش می‌دهید\N'46' احتمال پیش‌فرض صفر است، یعنی هیچ قاعده‌ای بررسی نمی‌شود\N'46'
.TP 4
\fB\N'45'\N'45'cache\N'45'storage\N'45'mode\fR=\fIVAL\fR (absent \fBDUNE_CACHE_STORAGE_MODE\fR env)
حالت ذخیره‌سازی حافظه پنهان Dune (یکی از مقادیر \fBauto\fR، \fBhardlink\fR یا \fBcopy\fR)\N'46' پیش‌فرض `hardlink\N'39' است\N'46'
.TP 4
\fB\N'45'\N'45'config\N'45'file\fR=\fIFILE\fR
بارگذاری این فایل پیکربندی به جای فایل پیش‌فرض\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'backtraces\fR
همیشه ردیابی به عقب (backtrace) استثناها را چاپ کن\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'dependency\N'45'path\fR
در صورت بروز خطا، مسیر وابستگی را از هدف‌های مشخص‌شده در خط فرمان تا قاعده‌ای که ناموفق بوده است چاپ کن\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'package\N'45'logs\fR (absent \fBDUNE_DEBUG_PACKAGE_LOGS\fR env)
همیشه لاگ‌های استاندارد را هنگام ساخت بسته‌ها چاپ کن
.TP 4
\fB\N'45'\N'45'default\N'45'target\fR=\fITARGET\fR (absent=\fB@@default\fR)
تنظیم هدف پیش‌فرضی که در صورت مشخص نشدن هیچ هدفی برای \fBdune build\fR استفاده می‌شود\N'46'
.TP 4
\fB\N'45'\N'45'diff\N'45'command\fR=\fIVAL\fR (absent \fBDUNE_DIFF_COMMAND\fR env)
دستور پوسته برای مقایسه فایل‌ها\N'46' برای غیرفعال کردن چاپ تفاوت‌ها از \N'45' استفاده کنید\N'46'
.TP 4
\fB\N'45'\N'45'disable\N'45'promotion\fR (absent \fBDUNE_DISABLE_PROMOTION\fR env)
غیرفعال کردن تمام قواعد ارتقا (promotion)
.TP 4
\fB\N'45'\N'45'display\fR=\fIMODE\fR
کنترل حالت نمایش Dune\N'46' برای جزئیات بیشتر به \fBdune\N'45'config(5)\fR مراجعه کنید\N'46' مقادیر معتبر برای این گزینه عبارتند از: progress، verbose، short، quiet یا tui\N'46'
.TP 4
\fB\N'45'\N'45'dump\N'45'gc\N'45'stats\fR=\fIFILE\fR
تخلیه آمار زباله‌روب (garbage collector) در یک فایل پس از تکمیل ساخت\N'46'
.TP 4
\fB\N'45'\N'45'help\fR[=\fIFMT\fR] (default=\fBauto\fR)
نمایش این راهنما در قالب \fIFMT\fR\N'46' مقدار \fIFMT\fR باید یکی از \fBauto\fR، \fBpager\fR، \fBgroff\fR یا \fBplain\fR باشد\N'46' با مقدار \fBauto\fR، هرگاه متغیر محیطی \fBTERM\fR برابر \fBdumb\fR باشد یا تعریف نشده باشد، قالب به صورت \fBpager\fR یا \fBplain\fR خواهد بود\N'46'
.TP 4
\fB\N'45'\N'45'ignore\N'45'promoted\N'45'rules\fR
نادیده گرفتن قواعد با (mode promote)، به جز مواردی که دارای (only \N'46'\N'46'\N'46') هستند\N'46' متغیر %{ignoring_promoted_rules} در فایل‌های dune نشان می‌دهد که این گزینه ارسال شده است یا خیر\N'46'
.TP 4
\fB\N'45'\N'45'instrument\N'45'with\fR=\fIBACKENDS\fR (absent \fBDUNE_INSTRUMENT_WITH\fR env)
فعال‌سازی ابزارسازی (instrumentation) توسط \fBBACKENDS\fR\N'46' مقدار \fBBACKENDS\fR فهرستی از نام‌های کتابخانه است که با کاما از هم جدا شده‌اند، و هر کدام باید یک بک‌اند ابزارسازی را اعلان کنند\N'46'
.TP 4
\fB\N'45'j\fR \fIJOBS\fR (absent \fBDUNE_JOBS\fR env)
اجرای حداکثر \fIJOBS\fR دستور به صورت هم‌زمان\N'46' مقدار \fIJOBS\fR باید یک عدد صحیح مثبت یا \fBauto\fR برای تشخیص خودکار تعداد هسته‌ها (پیش‌فرض) باشد\N'46'
.TP 4
\fB\N'45'\N'45'no\N'45'buffer\fR
خروجی دستورات اجراشده توسط dune در بافر ذخیره نشود\N'46' به طور پیش‌فرض dune خروجی زیردستورها را بافر می‌کند تا از تداخل آن‌ها هنگام اجرای موازی چندین دستور جلوگیری شود\N'46' با این حال، این امر می‌تواند هنگام اشکال‌زدایی آزمون‌های طولانی مشکل‌ساز شود\N'46' با گزینه \fB\N'45'\N'45'no\N'45'buffer\fR، دستورها دسترسی مستقیم به ترمینال دارند\N'46' توجه داشته باشید که در نتیجه، خروجی آن‌ها در فایل لاگ ثبت نخواهد شد\N'46' برای جلوگیری از تداخل، باید از این گزینه همراه با \fB\N'45'j 1\fR استفاده کنید\N'46' علاوه بر این، باید از \fB\N'45'\N'45'verbose\fR نیز استفاده کنید تا مطمئن شوید که دستورها پیش از اجرا چاپ می‌شوند\N'46'
.TP 4
\fB\N'45'\N'45'no\N'45'config\fR
عدم بارگذاری فایل پیکربندی
.TP 4
\fB\N'45'\N'45'no\N'45'print\N'45'directory\fR
پیام‌های «ورود به دایرکتوری» نمایش داده نشوند\N'46'
.TP 4
\fB\N'45'\N'45'only\N'45'packages\fR=\fIPACKAGES\fR
نادیده گرفتن بندهایی (stanza) که به بسته‌ای ارجاع می‌دهند که در \fBPACKAGES\fR نیست\N'46' مقدار \fBPACKAGES\fR فهرستی از نام‌های بسته است که با کاما از هم جدا شده‌اند\N'46' توجه داشته باشید که این کار تأثیری مشابه با حذف بندهای مربوطه از فایل‌های dune دارد\N'46' این سوییچ بیشتر برای انتشار نسخه‌ها در نظر گرفته شده است\N'46' در طول توسعه، احتمالاً آنچه می‌خواهید ساخت یک هدف خاص \fB<package>\N'46'install\fR است\N'46'
.TP 4
\fB\N'45'p\fR \fIPACKAGES\fR, \fB\N'45'\N'45'for\N'45'release\N'45'of\N'45'packages\fR=\fIPACKAGES\fR (required)
کوتاه‌نوشتی برای \fB\N'45'\N'45'release \N'45'\N'45'pkg=disabled \N'45'\N'45'only\N'45'packages PACKAGE\fR\N'46' برای اینکه فقط موارد ضروری هنگام وجود چندین بسته در پروژه ساخته شود و همچنین ساخت‌های تکرارپذیر به دست آید، باید از این گزینه در فایل‌های \fI<package>\N'46'opam\fR خود استفاده کنید\N'46'
.TP 4
\fB\N'45'\N'45'pkg\fR=\fIVAL\fR
فعال یا غیرفعال کردن مدیریت بسته\N'46' رفتار پیش‌فرض بستگی به این دارد که آیا یک دایرکتوری قفل وجود دارد یا خیر\N'46'
.TP 4
\fB\N'45'\N'45'profile\fR=\fIVAL\fR (absent \fBDUNE_PROFILE\fR env)
انتخاب نمایه (پروفایل) ساخت، برای مثال \fBdev\fR یا \fBrelease\fR\N'46' مقدار پیش‌فرض \fBdev\fR است\N'46'
.TP 4
\fB\N'45'\N'45'promote\N'45'install\N'45'files\fR[=\fIVAL\fR] (default=\fBtrue\fR)
ارتقای هر فایل تولیدشده <package>\N'46'install به درخت منبع\N'46'
.TP 4
\fB\N'45'\N'45'release\fR
قرار دادن \fBdune\fR در یک حالت انتشار (\fIrelease\fR) تکرارپذیر\N'46' کوتاه‌نوشتی برای \fB\N'45'\N'45'root \N'46' \N'45'\N'45'ignore\N'45'promoted\N'45'rules \N'45'\N'45'no\N'45'config \N'45'\N'45'profile release \N'45'\N'45'always\N'45'show\N'45'command\N'45'line \N'45'\N'45'promote\N'45'install\N'45'files \N'45'\N'45'require\N'45'dune\N'45'project\N'45'file \N'45'\N'45'default\N'45'target @install\fR\N'46' شما باید از این گزینه برای ساخت‌های انتشار استفاده کنید\N'46' به عنوان مثال، باید از این گزینه در فایل‌های \fI<package>\N'46'opam\fR خود استفاده نمایید\N'46' مگر اینکه از قبل از \fB\N'45'p\fR استفاده کرده باشید، زیرا \fB\N'45'p\fR این گزینه را در بر دارد\N'46'
.TP 4
\fB\N'45'\N'45'require\N'45'dune\N'45'project\N'45'file\fR[=\fIVAL\fR] (default=\fBtrue\fR)
در صورت نبود فایل dune\N'45'project ناموفق شو\N'46'
.TP 4
\fB\N'45'\N'45'root\fR=\fIDIR\fR (absent \fBDUNE_ROOT\fR env)
استفاده از این دایرکتوری به عنوان ریشه فضای کاری به جای حدس زدن آن\N'46' توجه داشته باشید که این گزینه تفسیر هدف‌های داده‌شده در خط فرمان را تغییر نمی‌دهد\N'46' این سوییچ فقط برای اسکریپت‌ها در نظر گرفته شده است\N'46'
.TP 4
\fB\N'45'\N'45'store\N'45'orig\N'45'source\N'45'dir\fR (absent \fBDUNE_STORE_ORIG_SOURCE_DIR\fR env)
ذخیره مکان اصلی منبع در فراداده‌های dune\N'45'package\N'46'
.TP 4
\fB\N'45'\N'45'target\N'45'exec\fR=\fITOOLCHAIN=CMD\fR (absent \fBDUNE_TARGET_EXEC\fR env)
دستور پوششی برای اجرای باینری‌های هدف هنگام کامپایل متقاطع\N'46' قالب: TOOLCHAIN=CMD (به عنوان مثال، \N'39'windows=wine\N'39')\N'46'
.TP 4
\fB\N'45'\N'45'terminal\N'45'persistence\fR=\fIMODE\fR
تغییر نحوه نمایش لاگ نتایج ساخت در کنسول بین بازسازی‌ها در حالت \fB\N'45'\N'45'watch\fR\N'46' حالت‌های پشتیبانی‌شده: \fBpreserve\fR، \fBclear\N'45'on\N'45'rebuild\fR، \fBclear\N'45'on\N'45'rebuild\N'45'and\N'45'flush\N'45'history\fR\N'46'
.TP 4
\fB\N'45'\N'45'trace\N'45'file\fR=\fIFILE\fR
خروجی داده‌های ردیابی در قالب catapult (سازگار با chrome://tracing)\N'46'
.TP 4
\fB\N'45'\N'45'verbose\fR
همانند \fB\N'45'\N'45'display verbose\fR
.TP 4
\fB\N'45'\N'45'version\fR
نمایش اطلاعات نسخه\N'46'
.TP 4
\fB\N'45'\N'45'watch\N'45'exclusions\fR=\fIREGEX\fR
افزودن یک عبارت باقاعده POSIX که دایرکتوری‌های منطبق را از \fB`dune build \N'45'\N'45'watch`\fR مستثنی می‌کند\N'46' گزینه \fB\N'45'\N'45'watch\N'45'exclusions\fR می‌تواند برای افزودن چندین مورد استثنا تکرار شود\N'46' همچنین می‌توان از نقطه\N'45'ویرگول به عنوان جداکننده استفاده کرد\N'46' اگر هیچ استثنایی ارائه نشود، مجموعه‌ای استاندارد از استثناها استفاده می‌شود؛ اما اگر \fIیک یا چند\fR گزینه \fB\N'45'\N'45'watch\N'45'exclusions\fR استفاده شود، \fBهیچ‌یک\fR از استثناهای استاندارد استفاده نمی‌شوند\N'46' استثناهای استاندارد عبارتند از: ^_opam /_opam ^_esy /_esy ^\N'92'\N'46'#\N'46'* /\N'92'\N'46'#\N'46'* ~$ ^#[^#]*#$ /#[^#]*#$ ^4913$ /4913$ /\N'46'git /\N'46'hg :/windows
.TP 4
\fB\N'45'\N'45'workspace\fR=\fIFILE\fR (absent \fBDUNE_WORKSPACE\fR env)
استفاده از این فایل مشخص فضای کاری به جای جستجوی آن\N'46'
.TP 4
\fB\N'45'x\fR \fIVAL\fR (absent \fBDUNE_CROSS_TARGET\fR env)
کامپایل متقاطع با استفاده از این زنجیره ابزار\N'46'
.SH "راهنمای بیشتر (MORE HELP)"
.P
برای دریافت راهنما در مورد یک دستور خاص، از `\fBdune\fR \fICOMMAND\fR \N'45'\N'45'help\N'39' استفاده کنید\N'46'
.SH "وضعیت خروج (EXIT STATUS)"
.P
دستور \fBdune ocaml\N'45'merlin\fR با یکی از وضعیت‌های زیر خارج می‌شود:
.TP 4
0
در صورت موفقیت\N'46'
.TP 4
1
در صورت بروز خطا\N'46'
.TP 4
130
در صورتی که با یک سیگنال متوقف شده باشد\N'46'
.SH "محیط (ENVIRONMENT)"
.P
این متغیرهای محیطی بر اجرای \fBocaml\N'45'merlin\fR تأثیر می‌گذارند:
.TP 4
\fBDUNE_BUILD_DIR\fR
دایرکتوری ساخت مشخص‌شده\N'46' در صورت مشخص نشدن، مقدار پیش‌فرض _build است
.TP 4
\fBDUNE_CACHE\fR
فعال یا غیرفعال کردن حافظه پنهان Dune (یکی از مقادیر \fBdisabled\fR، \fBenabled\N'45'except\N'45'user\N'45'rules\fR یا \fBenabled\fR)\N'46' مقدار پیش‌فرض `enabled\N'45'except\N'45'user\N'45'rules\N'39' است\N'46'
.TP 4
\fBDUNE_CACHE_CHECK_PROBABILITY\fR
بررسی تکرارپذیری ساخت با اجرای مجدد قواعد انتخاب‌شده به صورت تصادفی و مقایسه نتایج آن‌ها با موارد ذخیره‌شده در حافظه پنهان Dune\N'46' نکته: با افزایش احتمال این بررسی‌ها، سرعت ساخت را کاهش می‌دهید\N'46' احتمال پیش‌فرض صفر است، یعنی هیچ قاعده‌ای بررسی نمی‌شود\N'46'
.TP 4
\fBDUNE_CACHE_STORAGE_MODE\fR
حالت ذخیره‌سازی حافظه پنهان Dune (یکی از مقادیر \fBauto\fR، \fBhardlink\fR یا \fBcopy\fR)\N'46' مقدار پیش‌فرض `hardlink\N'39' است\N'46'
.TP 4
\fBDUNE_CROSS_TARGET\fR
کامپایل متقاطع با استفاده از این زنجیره ابزار\N'46'
.TP 4
\fBDUNE_DEBUG_PACKAGE_LOGS\fR
همیشه لاگ‌های استاندارد را هنگام ساخت بسته‌ها چاپ کن
.TP 4
\fBDUNE_DIFF_COMMAND\fR
دستور پوسته برای مقایسه فایل‌ها\N'46' برای غیرفعال کردن چاپ تفاوت‌ها، از \N'45' استفاده کنید\N'46'
.TP 4
\fBDUNE_DISABLE_PROMOTION\fR
غیرفعال کردن تمام قواعد ارتقا (promotion)
.TP 4
\fBDUNE_INSTRUMENT_WITH\fR
فعال‌سازی ابزارسازی با \fBBACKENDS\fR\N'46' مقدار \fBBACKENDS\fR فهرستی از نام‌های کتابخانه جداشده با کاما است، که هر یک باید یک بک‌اند ابزارسازی را اعلان کنند\N'46'
.TP 4
\fBDUNE_JOBS\fR
اجرای حداکثر \fIJOBS\fR دستور به طور هم‌زمان\N'46' مقدار \fIJOBS\fR باید یک عدد صحیح مثبت یا \fBauto\fR برای تشخیص خودکار تعداد هسته‌ها (پیش‌فرض) باشد\N'46'
.TP 4
\fBDUNE_PROFILE\fR
نمایه ساخت\N'46' در صورت مشخص نشدن \fBdev\fR یا در صورت تنظیم بودن \N'45'p مقدار \fBrelease\fR خواهد بود\N'46'
.TP 4
\fBDUNE_ROOT\fR
استفاده از این دایرکتوری به عنوان ریشه فضای کاری به جای حدس زدن آن\N'46' توجه داشته باشید که این گزینه تفسیر هدف‌های داده‌شده در خط فرمان را تغییر نمی‌دهد\N'46' این متغیر تنها برای اسکریپت‌ها در نظر گرفته شده است\N'46'
.TP 4
\fBDUNE_SANDBOX\fR
حالت جعبه شنی مورد استفاده به صورت پیش‌فرض\N'46' (مشاهده کنید \N'45'\N'45'sandbox)
.TP 4
\fBDUNE_STORE_ORIG_SOURCE_DIR\fR
ذخیره مکان اصلی منبع در فراداده‌های dune\N'45'package\N'46'
.TP 4
\fBDUNE_TARGET_EXEC\fR
دستور پوششی برای اجرای باینری‌های هدف هنگام کامپایل متقاطع\N'46' قالب: TOOLCHAIN=CMD (مانند \N'39'windows=wine\N'39')\N'46'
.TP 4
\fBDUNE_WORKSPACE\fR
استفاده از این فایل مشخص فضای کاری به جای جستجوی آن\N'46'
.SH "اشکالات (BUGS)"
.P
گزارش‌های اشکال را در https://github\N'46'com/ocaml/dune/issues بررسی کنید
.SH "اشکالات (BUGS)"
.P
گزارش‌های اشکال را در https://github\N'46'com/ocaml/dune/issues بررسی کنید
