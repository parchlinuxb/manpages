    \(dqarguments\(dq: {
        \(dqinterface\(dq: <string>,
        \(dqaddress\(dq: <string>,
        \(dqrelay\(dq: <string>,
        \(dqlocal\(dq: <string>,
        \(dqremote\(dq: <string>,
        \(dqlink\(dq: <string>,
        \(dqsubnet\(dq: <string>,
        \(dqclasses\(dq: [ <strings> ]
    }
}
