.B note_object(name: str \%<https://\:docs\:.python\:.org/\:3/\:library/\:stdtypes\:.html#\:str>, objtype: str \%<https://\:docs\:.python\:.org/\:3/\:library/\:stdtypes\:.html#\:str>, node_id: str \%<https://\:docs\:.python\:.org/\:3/\:library/\:stdtypes\:.html#\:str>, aliased: bool \%<https://\:docs\:.python\:.org/\:3/\:library/\:functions\:.html#\:bool> = False, location: Any = None) -> None \%<https://\:docs\:.python\:.org/\:3/\:library/\:constants\:.html#\:None>
