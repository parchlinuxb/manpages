.nh
.TH "apptainer" "1" "Jul 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
apptainer-sif-add \- افزودن شیء داده به تصویر SIF


.SH "خلاصه دستور (SYNOPSIS)"
\fBapptainer sif add [flags]\fP


.SH "توضیحات (DESCRIPTION)"
افزودن یک شیء داده (data object) به تصویر SIF.


.SH "گزینه‌ها (OPTIONS)"
\fB--alignment\fP=0
	تنظیم تراز هم‌ترازی (alignment) [پیش‌فرض: 4096 همراه با --datatype 4-Partition، در غیر این صورت 0]

.PP
\fB--datatype\fP=0
	نوع داده برای افزودن
[الزامی، بدون پیش‌فرض]:
  1-Deffile,        2-EnvVar,        3-Labels,
  4-Partition,      5-Signature,     6-GenericJSON,
  7-Generic,        8-CryptoMessage, 9-SBOM,
  10-OCI.RootIndex, 11-OCI.Blob

.PP
\fB--filename\fP=""
	تنظیم نام پرونده یا شناسه منطقی [پیش‌فرض: نام پرونده ورودی]

.PP
\fB--groupid\fP=0
	تنظیم شناسه گروه [پیش‌فرض: 0]

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنمای add

.PP
\fB--link\fP=0
	تنظیم اشاره‌گر پیوند [پیش‌فرض: 0]

.PP
\fB--partarch\fP=0
	معماری اصلی مورد استفاده (همراه با --datatype 4-Partition)
[الزامی، بدون پیش‌فرض]:
  1-386,       2-amd64,     3-arm,
  4-arm64,     5-ppc64,     6-ppc64le,
  7-mips,      8-mipsle,    9-mips64,
  10-mips64le, 11-s390x,    12-riscv64,
  13-loong64

.PP
\fB--partfs\fP=0
	سامانه پرونده مورد استفاده (همراه با --datatype 4-Partition)
[الزامی، بدون پیش‌فرض]:
  1-Squash,    2-Ext3,      3-ImmuObj,
  4-Raw

.PP
\fB--parttype\fP=0
	نوع پارتیشن (همراه با --datatype 4-Partition)
[الزامی، بدون پیش‌فرض]:
  1-System,    2-PrimSys,   3-Data,
  4-Overlay

.PP
\fB--sbomformat\fP=""
	قالب SBOM (همراه با --datatype 9-sbom):
  cyclonedx-json, cyclonedx-xml,  github-json,
  spdx-json,      spdx-rdf,       spdx-tag-value,
  spdx-yaml,      syft-json

.PP
\fB--signentity\fP=""
	موجودیت امضاکننده (همراه با --datatype 5-Signature)
[الزامی، بدون پیش‌فرض]:
  مثال: 433FE984155206BD962725E20E8713472A879943

.PP
\fB--signhash\fP=0
	درهم‌سازی (هش) امضای مورد استفاده (همراه با --datatype 5-Signature)
[الزامی، بدون پیش‌فرض]:
  1-SHA256,      2-SHA384,      3-SHA512,
  4-BLAKE2s_256, 5-BLAKE2b_256


.SH "مثال‌ها (EXAMPLE)"
.EX
sif add image.sif recipe.def --datatype 1
sif add image.sif rootfs.squashfs --datatype 4 --parttype 1 --partfs 1 --partarch 2
sif add image.sif signature.bin --datatype 5 --signentity 433FE984155206BD962725E20E8713472A879943 --signhash 1
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBapptainer-sif(1)\fP


.SH "تاریخچه (HISTORY)"
30-Jul-2026 تولید خودکار توسط spf13/cobra
