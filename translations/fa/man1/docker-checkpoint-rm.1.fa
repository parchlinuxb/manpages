.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-checkpoint-rm \- حذف یک نقطه بازرسی (checkpoint)


.SH "خلاصه (SYNOPSIS)"
\fBdocker checkpoint rm [OPTIONS] CONTAINER CHECKPOINT\fP


.SH "شرح (DESCRIPTION)"
حذف یک نقطه بازرسی (checkpoint)


.SH "گزینه‌ها (OPTIONS)"
\fB--checkpoint-dir\fP=""
	استفاده از یک شاخه سفارشی برای ذخیره‌سازی نقطه بازرسی


.SH "ببینید (SEE ALSO)"
\fBdocker-checkpoint(1)\fP
