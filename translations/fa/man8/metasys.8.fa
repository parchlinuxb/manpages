.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
metasys \- درایور تجهیزات یوپی‌اس شرکت Meta System
.SH "خلاصه دستور (SYNOPSIS)"
.sp
\fBmetasys\fR \-h
.sp
\fBmetasys\fR \-a \fIUPS_NAME\fR [\fIOPTIONS\fR]
.if n \{\
.sp
.\}
.RS 4
.it 1 an-trap
.nr an-no-space-flag 1
.nr an-break-flag 1
.br
.ps +1
\fBنکته\fR
.ps -1
.br
.sp
این صفحه راهنما صرفاً ویژگی‌های وابسته به سخت‌افزار درایور metasys را مستند می‌کند\&. برای کسب اطلاعات پیرامون درایور هسته، به \fBnutupsdrv\fR(8) مراجعه فرمایید\&.
.sp .5v
.RE
.SH "سخت‌افزارهای پشتیبانی‌شده (SUPPORTED HARDWARE)"
.sp
درایور \fBmetasys\fR بر اساس سند "Meta System UPS Protocol Rev\&.1\&.12" که با حسن نیت توسط Meta System ارائه شده، نوشته شده است\&.
.sp
این درایور باید از تمامی قابلیت‌های مشترک مدل‌های یوپی‌اس زیر پشتیبانی کند:
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
HF Line (/2) ۱ تا ۸ بردی
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
HF Millennium (810, 820)
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
HF TOP Line (910, 920, 930, 940, 950, 970, 980)
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
ECO Network (750, 1000, 1050, 1500, 1800, 2000, 2100, 2500, 3000)
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
ECO (305, 308, 311, 511, 516, 519, 522, SX, SXI)
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
ally HF (800, 1000, 1250, 1600, 2000, 2500)
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
Megaline (1250, 2500, 3750, 5000, 6250, 7500, 8750, 10000)
.RE
.SH "کابل‌کشی (CABLING)"
.sp
کابل مورد نیاز یک کابل سریال استاندارد پین‌به‌پین است که حداقل پایه‌های ۲، ۳ و ۵ آن (روی کانکتور DB9) متصل باشند\&.
.SH "آرگومان‌های اضافی (EXTRA ARGUMENTS)"
.sp
این درایور از هیچ آرگومان اضافی از فایل \fBups.conf\fR(5) پشتیبانی نمی‌کند\&.
.SH "اشکالات (BUGS)"
.sp
این درایور تنها روی Meta System HF Millennium 820 و ally HF 1000 آزمایش شده است\&.
.sp
هرگونه اطلاعات درباره استفاده از این درایور با سایر یوپی‌اس‌های فهرست‌شده مورد استقبال خواهد بود\&.
.SH "نویسنده (AUTHOR)"
.sp
Fabio Di Niro <blaxwan@users\&.sourceforge\&.net>
.SH "همچنین ببینید (SEE ALSO)"
.SS "درایور اصلی (The core driver):"
.sp
\fBnutupsdrv\fR(8)
.SS "منابع اینترنتی (Internet resources):"
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
صفحه اصلی ابزارهای یوپی‌اس شبکه (NUT):
https://www\&.networkupstools\&.org/historic/v2\&.8\&.5
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
پروتکل یوپی‌اس Meta System:
https://networkupstools\&.org/ups\-protocols\&.html#_legrand
.RE
