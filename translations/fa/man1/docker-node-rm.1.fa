.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-node-rm \- حذف یک یا چند گره (node) از swarm


.SH "خلاصه (SYNOPSIS)"
\fBdocker node rm [OPTIONS] NODE [NODE...]\fP


.SH "شرح (DESCRIPTION)"
حذف یک یا چند گره از swarm


.SH "گزینه‌ها (OPTIONS)"
\fB-f\fP, \fB--force\fP[=false]
	حذف اجباری یک گره از swarm


.SH "ببینید (SEE ALSO)"
\fBdocker-node(1)\fP
