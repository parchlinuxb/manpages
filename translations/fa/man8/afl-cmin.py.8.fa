.TH afl-cmin.py 8 2026-06-05 AFL++
.SH "نام (NAME)"
afl-cmin.py \- اسکریپت پایتون برای کمینه‌سازی پیکره آزمون در AFL++

.SH "خلاصه دستور (SYNOPSIS)"
.B afl-cmin.py
[\fB\-h\fR] \fB\-i\fR \fIdir\fR \fB\-o\fR \fIdir\fR [\fIگزینه‌ها\fR] \fI/path/to/target_app\fR [\fIargs\fR ...]

.SH "گزینه‌ها (OPTIONS)"
.nf

استفاده: afl-cmin.py [-h] -i dir -o dir [-f file] [-m megs] [-t msec] [-O] [-Q]
                    [-U] [-X] [--crash-dir dir] [-A] [-C] [-e] [-T WORKERS]
                    [--as_queue] [--no-dedup] [--debug]
                    /path/to/target_app [args ...]

آرگومان‌های موضعی:
  /path/to/target_app
  args

گزینه‌ها:
  -h, --help           نمایش این پیام راهنما و خروج

پارامترهای الزامی:
  -i dir               دایرکتوری ورودی حاوی پیکره اولیه (starting corpus)
  -o dir               دایرکتوری خروجی برای پرونده‌های کمینه‌شده

تنظیمات کنترل اجرا:
  -f file              مکانی که توسط برنامه تحت فاز خوانده می‌شود (stdin)
  -m megs              محدودیت حافظه برای فرآیند فرزند (پیش‌فرض: none)
  -t msec              مهلت زمانی برای هر اجرا (پیش‌فرض: 5000)
  -O                   استفاده از ابزار دقیق فقط‌باینری (حالت FRIDA)
  -Q                   استفاده از ابزار دقیق فقط‌باینری (حالت QEMU)
  -U                   استفاده از ابزار دقیق مبتنی بر Unicorn (حالت Unicorn)
  -X                   استفاده از حالت Nyx

تنظیمات کمینه‌سازی:
  --crash-dir dir      انتقال موارد فروپاشی به یک پوشه جداگانه، همواره یکتاسازی‌شده
  -A                   مجاز دانستن فروپاشی‌ها و اتمام مهلت زمانی (توصیه نمی‌شود)
  -C                   نگه‌داشتن ورودی‌های منجر به فروپاشی و رد سایر موارد
  -e                   حل صرفاً برای پوشش لبه‌ها، نادیده گرفتن تعداد دفعات برخورد (hit counts)

متفرقه:
  -T WORKERS           تعداد کارگران (workers) همزمان (پیش‌فرض: 1)
  --as_queue           نام‌گذاری فایل خروجی مانند "id:000000,hash:value"
  --no-dedup           صرف‌نظر کردن از مرحله یکتاسازی برای پرونده‌های پیکره
  --debug              فعال‌سازی حالت اشکال‌زدایی (debug)
.fi

.SH "نویسندگان (AUTHORS)"
