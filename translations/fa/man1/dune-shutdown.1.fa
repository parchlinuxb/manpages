.\" Pipe this output to groff -m man -K utf8 -T utf8 | less -R
.\"
.mso an.tmac
.TH "DUNE-SHUTDOWN" 1 "" "Dune 3.24.2" "Dune Manual"
.\" Disable hyphenation and ragged-right
.nh
.ad l
.SH "نام (NAME)"
.P
dune\N'45'shutdown \N'45' لغو و خاموش کردن هرگونه فرآیند ساخت در فضای کاری جاری\N'46'
.SH "خلاصه دستور (SYNOPSIS)"
.P
\fBdune shutdown\fR [\fIگزینه\fR]…
.SH "گزینه‌ها (OPTIONS)"
.TP 4
\fB\N'45'\N'45'action\N'45'stderr\N'45'on\N'45'success\fR=\fIVAL\fR
مشابه \fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success\fR اما برای خطای استاندارد به جای خروجی استاندارد\N'46' یک مقدار پیش‌فرض مناسب برای مخزن‌های بزرگ یکپارچه (monorepo) مقدار \fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success=swallow \N'45'\N'45'action\N'45'stderr\N'45'on\N'45'success=must\N'45'be\N'45'empty\fR است\N'46' این گزینه تضمین می‌کند که یک ساخت موفق، خروجی خالی و «پاک» داشته باشد\N'46'
.TP 4
\fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success\fR=\fIVAL\fR
نحوه برخورد با خروجی استاندارد عملیات‌ها را هنگام موفقیت آن‌ها مشخص می‌کند\N'46' مقادیر ممکن عبارتند از: \fBprint\fR برای چاپ ساده آن در خروجی Dune، \fBswallow\fR برای نادیده گرفتن کامل آن و \fBmust\N'45'be\N'45'empty\fR برای اجبار به اینکه عملیات چیزی چاپ نکرده باشد\N'46' با مقدار \fBmust\N'45'be\N'45'empty\fR، اگر عملیات چیزی در خروجی استاندارد چاپ کرده باشد، Dune آن را ناموفق در نظر می‌گیرد\N'46' مقدار پیش‌فرض \fBprint\fR است\N'46'
.TP 4
\fB\N'45'\N'45'build\N'45'info\fR
نمایش اطلاعات ساخت\N'46'
.TP 4
\fB\N'45'\N'45'display\N'45'separate\N'45'messages\fR
جداسازی پیام‌های خطا با یک خط خالی\N'46'
.TP 4
\fB\N'45'\N'45'error\N'45'reporting\fR=\fIVAL\fR (absent=\fBdeterministic\fR)
زمان گزارش خطاهای ساخت را کنترل می‌کند\N'46' مقدار \fBearly\fR خطاها را به محض شناسایی گزارش می‌دهد\N'46' مقدار \fBdeterministic\fR خطاها را در پایان فرآیند ساخت و با ترتیبی مشخص و قطعی گزارش می‌دهد\N'46' مقدار \fBtwice\fR هر خطا را دو بار گزارش می‌کند: یک بار به محض شناسایی و بار دیگر در پایان فرآیند ساخت با ترتیبی قطعی\N'46'
.TP 4
\fB\N'45'f\fR, \fB\N'45'\N'45'force\fR
اجبار عملیات‌های وابسته به نام‌های مستعار (alias) به اجرای مجدد، حتی اگر وابستگی‌های آن‌ها تغییری نکرده باشد\N'46'
.TP 4
\fB\N'45'\N'45'file\N'45'watcher\fR=\fIVAL\fR (absent=\fBautomatic\fR)
سازوکار تشخیص تغییرات در سورس‌کد\N'46' مقدار Automatic برای اجرای یک برنامه خارجی توسط dune جهت تشخیص تغییرات\N'46' مقدار Manual برای اطلاع‌رسانی دستی تغییرات فایل‌ها به dune\N'46'
.TP 4
\fB\N'45'\N'45'passive\N'45'watch\N'45'mode\fR
مشابه [\N'45'\N'45'watch]، اما فرآیند ساخت فقط زمانی آغاز می‌شود که از طریق یک فراخوانی RPC خارجی دستور داده شود\N'46'
.TP 4
\fB\N'45'\N'45'sandbox\fR=\fIVAL\fR (absent \fBDUNE_SANDBOX\fR env)
تنظیم حالت محیط ایزوله (sandboxing)\N'46' برخی عملیات‌ها نیازمند حالت ایزوله‌سازی خاصی هستند و این تنظیم را نادیده می‌گیرند\N'46' مقادیر مجاز عبارتند از: none، symlink، copy، hardlink\N'46'
.TP 4
\fB\N'45'\N'45'stop\N'45'on\N'45'first\N'45'error\fR
توقف فرآیند ساخت به محض مواجهه با اولین خطا\N'46'
.TP 4
\fB\N'45'w\fR, \fB\N'45'\N'45'watch\fR
به جای پایان دادن به فرآیند ساخت پس از تکمیل، به طور مداوم منتظر تغییرات فایل‌ها می‌ماند\N'46'
.TP 4
\fB\N'45'\N'45'wait\N'45'for\N'45'filesystem\N'45'clock\fR
ابزار Dune برای بهبود ساخت افزایشی، محتوای فایل‌ها را خلاصه (digest) می‌کند\N'46' این خلاصه‌ها خود کش می‌شوند\N'46' در برخی موارد، Dune برای قابل اطمینان بودن عملکرد نیاز دارد برخی ورودی‌های کش خلاصه را دور بریزد\N'46' این گزینه باعث می‌شود Dune منتظر پیش رفتن ساعت سیستم فایل بماند تا نیازی به دور ریختن چیزی نداشته باشد\N'46' معمولاً نیازی به این گزینه ندارید؛ کاربرد اصلی آن برای توسعه‌دهندگان Dune جهت افزایش بازتولیدپذیری تست‌های کش خلاصه در Dune است\N'46'
.SH "گزینه‌های عمومی (COMMON OPTIONS)"
.TP 4
\fB\N'45'\N'45'always\N'45'show\N'45'command\N'45'line\fR
همیشه خط فرمان کامل برنامه‌های اجرا شده توسط dune را نمایش می‌دهد\N'46'
.TP 4
\fB\N'45'\N'45'auto\N'45'promote\fR
ارتقای خودکار فایل‌ها\N'46' این عمل مشابه اجرای \fBdune promote\fR پس از ساخت است\N'46'
.TP 4
\fB\N'45'\N'45'build\N'45'dir\fR=\fIFILE\fR (absent \fBDUNE_BUILD_DIR\fR env)
پوشه ساخت مشخص‌شده\N'46' در صورت تعیین نشدن، مقدار پیش‌فرض _build است
.TP 4
\fB\N'45'\N'45'cache\fR=\fIVAL\fR (absent \fBDUNE_CACHE\fR env)
فعال یا غیرفعال کردن کش Dune (یکی از مقادیر \fBdisabled\fR، \fBenabled\N'45'except\N'45'user\N'45'rules\fR یا \fBenabled\fR)\N'46' مقدار پیش‌فرض `enabled\N'45'except\N'45'user\N'45'rules\N'39' است\N'46'
.TP 4
\fB\N'45'\N'45'cache\N'45'check\N'45'probability\fR=\fIVAL\fR (absent \fBDUNE_CACHE_CHECK_PROBABILITY\fR env)
بررسی بازتولیدپذیری ساخت از طریق اجرای مجدد قواعد تصادفی انتخاب‌شده و مقایسه نتایج آن‌ها با موارد ذخیره‌شده در کش Dune\N'46' توجه: با افزایش احتمال این بررسی‌ها، سرعت ساخت کاهش می‌یابد\N'46' مقدار پیش‌فرض صفر است، یعنی هیچ قاعده‌ای بررسی نمی‌شود\N'46'
.TP 4
\fB\N'45'\N'45'cache\N'45'storage\N'45'mode\fR=\fIVAL\fR (absent \fBDUNE_CACHE_STORAGE_MODE\fR env)
حالت ذخیره‌سازی کش Dune (یکی از مقادیر \fBauto\fR، \fBhardlink\fR یا \fBcopy\fR)\N'46' مقدار پیش‌فرض `hardlink\N'39' است\N'46'
.TP 4
\fB\N'45'\N'45'config\N'45'file\fR=\fIFILE\fR
بارگذاری این فایل پیکربندی به جای فایل پیش‌فرض\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'backtraces\fR
همیشه ردگیری پشته استثناها (backtraces) را چاپ می‌کند\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'dependency\N'45'path\fR
در صورت بروز خطا، مسیر وابستگی را از هدف‌های مشخص‌شده در خط فرمان تا قاعده‌ای که شکست خورده چاپ می‌کند\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'package\N'45'logs\fR (absent \fBDUNE_DEBUG_PACKAGE_LOGS\fR env)
همیشه گزارش‌های استاندارد را هنگام ساخت بسته‌ها چاپ می‌کند
.TP 4
\fB\N'45'\N'45'default\N'45'target\fR=\fITARGET\fR (absent=\fB@@default\fR)
تنظیم هدف پیش‌فرضی که در صورت مشخص نشدن هیچ هدفی به \fBdune build\fR ارسال می‌شود\N'46'
.TP 4
\fB\N'45'\N'45'diff\N'45'command\fR=\fIVAL\fR (absent \fBDUNE_DIFF_COMMAND\fR env)
دستور شل برای مقایسه فایل‌ها\N'46' از \N'45' برای غیرفعال کردن چاپ تفاوت‌ها استفاده کنید\N'46'
.TP 4
\fB\N'45'\N'45'disable\N'45'promotion\fR (absent \fBDUNE_DISABLE_PROMOTION\fR env)
غیرفعال کردن تمام قواعد ارتقا
.TP 4
\fB\N'45'\N'45'display\fR=\fIMODE\fR
کنترل حالت نمایش Dune\N'46' برای جزئیات بیشتر به \fBdune\N'45'config(5)\fR مراجعه کنید\N'46' مقادیر مجاز برای این گزینه عبارتند از: progress، verbose، short، quiet یا tui\N'46'
.TP 4
\fB\N'45'\N'45'dump\N'45'gc\N'45'stats\fR=\fIFILE\fR
ذخیره آمار جمع‌آوری زباله (Garbage Collector) در یک فایل پس از تکمیل ساخت\N'46'
.TP 4
\fB\N'45'\N'45'help\fR[=\fIFMT\fR] (default=\fBauto\fR)
نمایش این راهنما در قالب \fIFMT\fR\N'46' مقدار \fIFMT\fR باید یکی از مقادیر \fBauto\fR، \fBpager\fR، \fBgroff\fR یا \fBplain\fR باشد\N'46' با مقدار \fBauto\fR، هر زمان که متغیر محیطی \fBTERM\fR برابر با \fBdumb\fR یا تعریف‌نشده باشد، قالب به صورت \fBpager\fR یا \fBplain\fR خواهد بود\N'46'
.TP 4
\fB\N'45'\N'45'ignore\N'45'promoted\N'45'rules\fR
نادیده گرفتن قواعد با (mode promote)، به جز مواردی که دارای (only \N'46'\N'46'\N'46') هستند\N'46' متغیر %{ignoring_promoted_rules} در فایل‌های dune مشخص‌کننده ارسال شدن یا نشدن این گزینه است\N'46'
.TP 4
\fB\N'45'\N'45'instrument\N'45'with\fR=\fIBACKENDS\fR (absent \fBDUNE_INSTRUMENT_WITH\fR env)
فعال‌سازی ابزاردقیق‌سازی (instrumentation) توسط \fBBACKENDS\fR\N'46' پارامتر \fBBACKENDS\fR فهرستی از نام‌های کتابخانه‌ها است که با کاما از هم جدا شده‌اند و هر کدام باید یک backend ابزاردقیق‌سازی تعریف کرده باشند\N'46'
.TP 4
\fB\N'45'j\fR \fIJOBS\fR (absent \fBDUNE_JOBS\fR env)
اجرای حداکثر \fIJOBS\fR دستور به طور همزمان\N'46' پارامتر \fIJOBS\fR باید یک عدد صحیح مثبت یا \fBauto\fR برای تشخیص خودکار تعداد هسته‌ها (پیش‌فرض) باشد\N'46'
.TP 4
\fB\N'45'\N'45'no\N'45'buffer\fR
بافر نکردن خروجی دستورات اجرا شده توسط dune\N'46' به طور پیش‌فرض dune خروجی زیردستورات را بافر می‌کند تا از تداخل خروجی هنگام اجرای موازی چندین دستور جلوگیری شود\N'46' با این حال، این مسئله ممکن است هنگام اشکال‌زدایی تست‌های طولانی مشکل‌ساز شود\N'46' با گزینه \fB\N'45'\N'45'no\N'45'buffer\fR، دستورات دسترسی مستقیم به ترمینال دارند\N'46' توجه داشته باشید که در نتیجه این کار، خروجی آن‌ها در فایل گزارش ثبت نخواهد شد\N'46' بهتر است از این گزینه همراه با \fB\N'45'j 1\fR استفاده کنید تا از تداخل جلوگیری شود\N'46' علاوه بر این باید از \fB\N'45'\N'45'verbose\fR نیز استفاده کنید تا مطمئن شوید دستورات پیش از اجرا چاپ می‌شوند\N'46'
.TP 4
\fB\N'45'\N'45'no\N'45'config\fR
بارگذاری نکردن فایل پیکربندی
.TP 4
\fB\N'45'\N'45'no\N'45'print\N'45'directory\fR
عدم نمایش پیام‌های "Entering directory"\N'46'
.TP 4
\fB\N'45'\N'45'only\N'45'packages\fR=\fIPACKAGES\fR
نادیده گرفتن بندهایی (stanzas) که به بسته‌ای خارج از \fBPACKAGES\fR اشاره دارند\N'46' پارامتر \fBPACKAGES\fR فهرستی از نام‌های بسته‌ها است که با کاما از هم جدا شده‌اند\N'46' توجه داشته باشید که این کار تاثیری مشابه حذف بندهای مربوطه از فایل‌های dune دارد\N'46' این گزینه عمدتاً برای انتشار (release) کاربرد دارد\N'46' در حین توسعه، معمولاً آنچه نیاز دارید ساخت یک هدف خاص \fB<package>\N'46'install\fR است\N'46'
.TP 4
\fB\N'45'p\fR \fIPACKAGES\fR, \fB\N'45'\N'45'for\N'45'release\N'45'of\N'45'packages\fR=\fIPACKAGES\fR (required)
حالت خلاصه برای \fB\N'45'\N'45'release \N'45'\N'45'pkg=disabled \N'45'\N'45'only\N'45'packages PACKAGE\fR\N'46' برای ساخت تنها موارد ضروری هنگام وجود چند بسته در پروژه و همچنین دستیابی به ساخت‌های بازتولیدپذیر، باید از این گزینه در فایل‌های \fI<package>\N'46'opam\fR خود استفاده کنید\N'46'
.TP 4
\fB\N'45'\N'45'pkg\fR=\fIVAL\fR
فعال یا غیرفعال کردن مدیریت بسته\N'46' رفتار پیش‌فرض بستگی به وجود پوشه lock دارد\N'46'
.TP 4
\fB\N'45'\N'45'profile\fR=\fIVAL\fR (absent \fBDUNE_PROFILE\fR env)
انتخاب پروفایل ساخت، برای مثال \fBdev\fR یا \fBrelease\fR\N'46' مقدار پیش‌فرض \fBdev\fR است\N'46'
.TP 4
\fB\N'45'\N'45'promote\N'45'install\N'45'files\fR[=\fIVAL\fR] (default=\fBtrue\fR)
ارتقای تمام فایل‌های تولیدشده <package>\N'46'install به درخت سورس‌کد\N'46'
.TP 4
\fB\N'45'\N'45'release\fR
قرار دادن \fBdune\fR در حالت بازتولیدپذیر \fIrelease\fR\N'46' فرم خلاصه برای \fB\N'45'\N'45'root \N'46' \N'45'\N'45'ignore\N'45'promoted\N'45'rules \N'45'\N'45'no\N'45'config \N'45'\N'45'profile release \N'45'\N'45'always\N'45'show\N'45'command\N'45'line \N'45'\N'45'promote\N'45'install\N'45'files \N'45'\N'45'require\N'45'dune\N'45'project\N'45'file \N'45'\N'45'default\N'45'target @install\fR\N'46' این گزینه باید برای ساخت‌های نسخه نهایی (release) استفاده شود\N'46' برای مثال، باید از این گزینه در فایل‌های \fI<package>\N'46'opam\fR خود استفاده کنید\N'46' مگر اینکه قبلاً از \fB\N'45'p\fR استفاده کرده باشید، زیرا \fB\N'45'p\fR این گزینه را شامل می‌شود\N'46'
.TP 4
\fB\N'45'\N'45'require\N'45'dune\N'45'project\N'45'file\fR[=\fIVAL\fR] (default=\fBtrue\fR)
توقف با خطا در صورت مفقود بودن فایل dune\N'45'project\N'46'
.TP 4
\fB\N'45'\N'45'root\fR=\fIDIR\fR (absent \fBDUNE_ROOT\fR env)
استفاده از این دایرکتوری به عنوان ریشه فضای کاری به جای حدس زدن آن\N'46' توجه داشته باشید که این گزینه تفسیر اهداف مشخص‌شده در خط فرمان را تغییر نمی‌دهد\N'46' این گزینه فقط برای اسکریپت‌ها در نظر گرفته شده است\N'46'
.TP 4
\fB\N'45'\N'45'store\N'45'orig\N'45'source\N'45'dir\fR (absent \fBDUNE_STORE_ORIG_SOURCE_DIR\fR env)
ذخیره مکان اصلی منبع در متادیتای dune\N'45'package\N'46'
.TP 4
\fB\N'45'\N'45'target\N'45'exec\fR=\fITOOLCHAIN=CMD\fR (absent \fBDUNE_TARGET_EXEC\fR env)
دستور بسته‌بندی برای اجرای باینری‌های مقصد هنگام کامپایل متقاطع (cross\N'45'compiling)\N'46' فرمت: TOOLCHAIN=CMD (مانند \N'39'windows=wine\N'39')\N'46'
.TP 4
\fB\N'45'\N'45'terminal\N'45'persistence\fR=\fIMODE\fR
تغییر نحوه نمایش گزارش نتایج ساخت در کنسول بین بازسازی‌ها در حالت \fB\N'45'\N'45'watch\fR\N'46' حالت‌های پشتیبانی‌شده: \fBpreserve\fR، \fBclear\N'45'on\N'45'rebuild\fR، \fBclear\N'45'on\N'45'rebuild\N'45'and\N'45'flush\N'45'history\fR\N'46'
.TP 4
\fB\N'45'\N'45'trace\N'45'file\fR=\fIFILE\fR
خروجی داده‌های ردگیری در قالب catapult (سازگار با chrome://tracing)\N'46'
.TP 4
\fB\N'45'\N'45'verbose\fR
مشابه \fB\N'45'\N'45'display verbose\fR
.TP 4
\fB\N'45'\N'45'version\fR
نمایش اطلاعات نسخه\N'46'
.TP 4
\fB\N'45'\N'45'watch\N'45'exclusions\fR=\fIREGEX\fR
افزودن یک عبارت باقاعده POSIX که دایرکتوری‌های منطبق را از \fB`dune build \N'45'\N'45'watch`\fR مستثنی می‌کند\N'46' گزینه \fB\N'45'\N'45'watch\N'45'exclusions\fR را می‌توان برای افزودن چندین استثنا تکرار کرد\N'46' همچنین می‌توان از نقطه ویرگول (semicolon) به عنوان جداکننده استفاده کرد\N'46' اگر هیچ استثنایی ارائه نشود، مجموعه‌ای استاندارد از موارد استثنا استفاده می‌شود؛ با این حال، در صورت استفاده از \fIیک یا چند\fR گزینه \fB\N'45'\N'45'watch\N'45'exclusions\fR، \fBهیچ‌یک\fR از استثناهای استاندارد استفاده نخواهند شد\N'46' استثناهای استاندارد عبارتند از: ^_opam /_opam ^_esy /_esy ^\N'92'\N'46'#\N'46'* /\N'92'\N'46'#\N'46'* ~$ ^#[^#]*#$ /#[^#]*#$ ^4913$ /4913$ /\N'46'git /\N'46'hg :/windows
.TP 4
\fB\N'45'\N'45'workspace\fR=\fIFILE\fR (absent \fBDUNE_WORKSPACE\fR env)
استفاده از این فایل مشخص فضای کاری به جای جستجو برای آن\N'46'
.TP 4
\fB\N'45'x\fR \fIVAL\fR (absent \fBDUNE_CROSS_TARGET\fR env)
کامپایل متقاطع با استفاده از این زنجیره ابزار (toolchain)\N'46'
.SH "وضعیت خروج (EXIT STATUS)"
.P
دستور \fBdune shutdown\fR با این مقادیر خارج می‌شود:
.TP 4
0
در صورت موفقیت\N'46'
.TP 4
1
در صورت بروز خطا\N'46'
.TP 4
130
در صورتی که توسط یک سیگنال متوقف شود\N'46'
.SH "محیط (ENVIRONMENT)"
.P
این متغیرهای محیطی بر اجرای \fBshutdown\fR تأثیر می‌گذارند:
.TP 4
\fBDUNE_BUILD_DIR\fR
پوشه ساخت مشخص‌شده\N'46' در صورت مشخص نشدن، مقدار پیش‌فرض _build است
.TP 4
\fBDUNE_CACHE\fR
فعال یا غیرفعال کردن کش Dune (یکی از مقادیر \fBdisabled\fR، \fBenabled\N'45'except\N'45'user\N'45'rules\fR یا \fBenabled\fR)\N'46' مقدار پیش‌فرض `enabled\N'45'except\N'45'user\N'45'rules\N'39' است\N'46'
.TP 4
\fBDUNE_CACHE_CHECK_PROBABILITY\fR
بررسی بازتولیدپذیری ساخت از طریق اجرای مجدد قواعد تصادفی انتخاب‌شده و مقایسه نتایج آن‌ها با موارد ذخیره‌شده در کش Dune\N'46' توجه: با افزایش احتمال این بررسی‌ها، سرعت ساخت کاهش می‌یابد\N'46' مقدار پیش‌فرض صفر است، یعنی هیچ قاعده‌ای بررسی نمی‌شود\N'46'
.TP 4
\fBDUNE_CACHE_STORAGE_MODE\fR
حالت ذخیره‌سازی کش Dune (یکی از مقادیر \fBauto\fR، \fBhardlink\fR یا \fBcopy\fR)\N'46' مقدار پیش‌فرض `hardlink\N'39' است\N'46'
.TP 4
\fBDUNE_CROSS_TARGET\fR
کامپایل متقاطع با استفاده از این زنجیره ابزار\N'46'
.TP 4
\fBDUNE_DEBUG_PACKAGE_LOGS\fR
همیشه گزارش‌های استاندارد را هنگام ساخت بسته‌ها چاپ می‌کند
.TP 4
\fBDUNE_DIFF_COMMAND\fR
دستور شل برای مقایسه فایل‌ها\N'46' از \N'45' برای غیرفعال کردن چاپ تفاوت‌ها استفاده کنید\N'46'
.TP 4
\fBDUNE_DISABLE_PROMOTION\fR
غیرفعال کردن تمام قواعد ارتقا
.TP 4
\fBDUNE_INSTRUMENT_WITH\fR
فعال‌سازی ابزاردقیق‌سازی توسط \fBBACKENDS\fR\N'46' پارامتر \fBBACKENDS\fR فهرستی از نام‌های کتابخانه‌ها است که با کاما از هم جدا شده‌اند و هر کدام باید یک backend ابزاردقیق‌سازی تعریف کرده باشند\N'46'
.TP 4
\fBDUNE_JOBS\fR
اجرای حداکثر \fIJOBS\fR دستور به طور همزمان\N'46' پارامتر \fIJOBS\fR باید یک عدد صحیح مثبت یا \fBauto\fR برای تشخیص خودکار تعداد هسته‌ها (پیش‌فرض) باشد\N'46'
.TP 4
\fBDUNE_PROFILE\fR
پروفایل ساخت\N'46' در صورت مشخص نشدن \fBdev\fR یا در صورت تنظیم بودن \N'45'p مقدار \fBrelease\fR\N'46'
.TP 4
\fBDUNE_ROOT\fR
استفاده از این دایرکتوری به عنوان ریشه فضای کاری به جای حدس زدن آن\N'46' توجه داشته باشید که این گزینه تفسیر اهداف مشخص‌شده در خط فرمان را تغییر نمی‌دهد\N'46' این گزینه فقط برای اسکریپت‌ها در نظر گرفته شده است\N'46'
.TP 4
\fBDUNE_SANDBOX\fR
حالت محیط ایزوله مورد استفاده به صورت پیش‌فرض\N'46' (به \N'45'\N'45'sandbox مراجعه کنید)
.TP 4
\fBDUNE_STORE_ORIG_SOURCE_DIR\fR
ذخیره مکان اصلی منبع در متادیتای dune\N'45'package\N'46'
.TP 4
\fBDUNE_TARGET_EXEC\fR
دستور بسته‌بندی برای اجرای باینری‌های مقصد هنگام کامپایل متقاطع\N'46' فرمت: TOOLCHAIN=CMD (مانند \N'39'windows=wine\N'39')\N'46'
.TP 4
\fBDUNE_WORKSPACE\fR
استفاده از این فایل مشخص فضای کاری به جای جستجو برای آن\N'46'
.SH "همچنین ببینید (SEE ALSO)"
.P
dune(1)
