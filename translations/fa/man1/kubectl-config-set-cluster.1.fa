.nh
.TH KUBERNETES 1 "Jan 2015" "Eric Paris" "راهنمای کاربر kubernetes"

.SH "نام (NAME)"
kubectl-config-set-cluster \- تنظیم یک مدخل کلاستر در kubeconfig


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubectl config set-cluster\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
تنظیم یک مدخل کلاستر در kubeconfig.

.PP
مشخص کردن نامی که از قبل وجود دارد، فیلدهای جدید را بر روی مقادیر موجود برای آن فیلدها ادغام می‌کند.


.SH "گزینه‌ها (OPTIONS)"
\fB--certificate-authority\fP=""
	مسیر فایل مرجع صدور گواهینامه برای مدخل کلاستر در kubeconfig

.PP
\fB--embed-certs\fP=false
	جاسازی گواهینامه‌ها برای مدخل کلاستر در kubeconfig

.PP
\fB--insecure-skip-tls-verify\fP=false
	نادیده گرفتن اعتبارسنجی TLS برای مدخل کلاستر در kubeconfig

.PP
\fB--proxy-url\fP=""
	آدرس پروکسی (proxy-url) برای مدخل کلاستر در kubeconfig

.PP
\fB--server\fP=""
	سرور برای مدخل کلاستر در kubeconfig

.PP
\fB--tls-server-name\fP=""
	نام سرور TLS برای مدخل کلاستر در kubeconfig


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--as\fP=""
	نام کاربری برای جعل هویت (impersonate) در این عملیات. کاربر می‌تواند یک کاربر معمولی یا یک حساب خدمت (service account) در یک فضای نام باشد.

.PP
\fB--as-group\fP=[]
	گروه برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای تعیین چندین گروه تکرار شود.

.PP
\fB--as-uid\fP=""
	شناسه UID برای جعل هویت در این عملیات.

.PP
\fB--as-user-extra\fP=[]
	اطلاعات اضافی کاربر برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای مشخص کردن چندین مقدار برای یک کلید یکسان تکرار شود.

.PP
\fB--cache-dir\fP="/home/username/.kube/cache"
	دایرکتوری پیش‌فرض کش

.PP
\fB--client-certificate\fP=""
	مسیر فایل گواهینامه کلاینت برای TLS

.PP
\fB--client-key\fP=""
	مسیر فایل کلید کلاینت برای TLS

.PP
\fB--cluster\fP=""
	نام کلاستر kubeconfig برای استفاده

.PP
\fB--context\fP=""
	نام کانتکست kubeconfig برای استفاده

.PP
\fB--disable-compression\fP=false
	در صورت true بودن، انصراف از فشرده‌سازی پاسخ‌ها برای تمام درخواست‌ها به سرور

.PP
\fB--kubeconfig\fP=""
	استفاده از یک فایل خاص kubeconfig

.PP
\fB--kuberc\fP=""
	مسیر فایل kuberc برای استفاده در ترجیحات (preferences). این قابلیت می‌تواند با export کردن feature gate به صورت KUBECTL_KUBERC=false یا خاموش کردن ویژگی با KUBERC=off غیرفعال شود.

.PP
\fB--match-server-version\fP=false
	الزام به تطابق نسخه سرور با نسخه کلاینت

.PP
\fB-n\fP, \fB--namespace\fP=""
	در صورت وجود، دامنهٔ فضای نام (namespace) برای این درخواست CLI

.PP
\fB--password\fP=""
	رمز عبور برای احراز هویت پایه (basic authentication) در سرور API

.PP
\fB--profile\fP="none"
	نام پروفایل برای ثبت. یکی از موارد (none|cpu|heap|goroutine|threadcreate|block|mutex|trace)

.PP
\fB--profile-output\fP="profile.pprof"
	نام فایلی که پروفایل در آن نوشته می‌شود

.PP
\fB--request-timeout\fP="0"
	مدت زمان انتظار پیش از انصراف از یک درخواست به سرور. مقادیر غیر صفر باید شامل واحد زمانی متناظر باشند (مانند 1s، 2m، 3h). مقدار صفر یعنی درخواست‌ها هرگز دچار وقفه زمانی (timeout) نشوند.

.PP
\fB--token\fP=""
	توکن حامل (Bearer token) برای احراز هویت در سرور API

.PP
\fB--user\fP=""
	نام کاربر kubeconfig برای استفاده

.PP
\fB--username\fP=""
	نام کاربری برای احراز هویت پایه در سرور API

.PP
\fB--version\fP=false
	گزینه \fB\-\-version\fP یا \fB\-\-version=raw\fP اطلاعات نسخه را چاپ کرده و خارج می‌شود؛ \fB\-\-version=vX.Y.Z...\fP نسخه گزارش‌شده را تنظیم می‌کند

.PP
\fB--warnings-as-errors\fP=false
	در نظر گرفتن هشدارهای دریافتی از سرور به عنوان خطا و خروج با کد وضعیت غیر صفر


.SH "مثال (EXAMPLE)"
.EX
  # تنظیم تنها فیلد server در مدخل کلاستر e2e بدون دستکاری سایر مقادیر
  kubectl config set-cluster e2e --server=https://1.2.3.4
  
  # جاسازی داده‌های مرجع صدور گواهینامه برای مدخل کلاستر e2e
  kubectl config set-cluster e2e --embed-certs --certificate-authority=~/.kube/e2e/kubernetes.ca.crt
  
  # غیرفعال کردن بررسی گواهینامه برای مدخل کلاستر e2e
  kubectl config set-cluster e2e --insecure-skip-tls-verify=true
  
  # تنظیم نام سفارشی سرور TLS جهت اعتبارسنجی برای مدخل کلاستر e2e
  kubectl config set-cluster e2e --tls-server-name=my-cluster-name
  
  # تنظیم آدرس پروکسی برای مدخل کلاستر e2e
  kubectl config set-cluster e2e --proxy-url=https://1.2.3.4
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubectl-config(1)\fP


.SH "تاریخچه (HISTORY)"
ژانویه ۲۰۱۵، در ابتدا توسط Eric Paris (eparis at redhat dot com) بر پایه محتوای منبع kubernetes گردآوری شد، اما امید است که از آن زمان به بعد به طور خودکار تولید شده باشند!
