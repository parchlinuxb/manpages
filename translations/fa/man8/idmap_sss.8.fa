.TH "IDMAP_SSS" "8" "06/09/2026" "SSSD" "صفحات راهنمای SSSD"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
idmap_sss \- بک‌اِند idmap_sss مربوط به SSSD برای Winbind
.SH "توضیحات (DESCRIPTION)"
.PP
ماژول idmap_sss روشی برای فراخوانی SSSD جهت نگاشت شناسه‌های UID/GID و SID فراهم می‌کند\&. در این حالت به پایگاه‌داده‌ای نیاز نیست، زیرا نگاشت توسط SSSD انجام می‌شود\&.
.SH "گزینه‌های نگاشت شناسه (IDMAP OPTIONS)"
.PP
range = low \- high
.RS 4
محدوده در دسترس UID و GID منطبق را مشخص می‌کند که این بک‌اِند روی آن مرجعیت دارد\&.
.RE
.SH "مثال‌ها (EXAMPLES)"
.PP
این مثال نحوه پیکربندی idmap_sss را به عنوان ماژول نگاشت پیش‌فرض نشان می‌دهد\&.
.sp
.if n \{\
.RS 4
.\}
.nf
[global]
security = ads
workgroup = <AD\-DOMAIN\-SHORTNAME>

idmap config <AD\-DOMAIN\-SHORTNAME> : backend        = sss
idmap config <AD\-DOMAIN\-SHORTNAME> : range          = 200000\-2147483647

idmap config * : backend        = tdb
idmap config * : range          = 100000\-199999

.fi
.if n \{\
.RE
.\}
.PP
لطفاً <AD\-DOMAIN\-SHORTNAME> را با نام دامنه NetBIOS مربوط به دامنه AD جایگزین کنید\&. در صورتی که باید از چندین دامنه AD استفاده شود، هر دامنه نیازمند یک خط
idmap config
با
backend = sss
و یک خط با
range
مناسب است\&.
.PP
از آنجا که Winbind به یک بک‌اِند پیش‌فرض با قابلیت نوشتن نیاز دارد و idmap_sss فقط‌خواندنی است، این مثال شامل
backend = tdb
به عنوان پیش‌فرض است\&.
