.UNINDENT
.UNINDENT
.SS xml_decode
.sp
Decode a lua value from an xml document.
.INDENT 0.0
.INDENT 3.5
.sp
.EX
x = xml_decode(\(aq<body><foo fizz=\(dqbuzz\(dq>bar</foo></body>\(aq)
if last_err() then return end

body = x[\(aqchildren\(aq][1]
foo = body[\(aqchildren\(aq][1]

print(foo[\(aqattrs\(aq][\(aqfizz\(aq])
print(foo[\(aqtext\(aq])
.EE
.UNINDENT
.UNINDENT
.SS xml_named
.sp
Get a named child element from a parent element.
.INDENT 0.0
.INDENT 3.5
.sp
.EX
x = xml_decode(\(aq<body><foo fizz=\(dqbuzz\(dq>bar</foo></body>\(aq)
if last_err() then return end

body = x[\(aqchildren\(aq][1]
foo = xml_named(body, \(aqfoo\(aq)
if foo ~= nil then
    print(foo)
end
.EE
.UNINDENT
.UNINDENT
