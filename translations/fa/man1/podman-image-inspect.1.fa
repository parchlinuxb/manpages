        "NamesHistory": [
            "registry.fedoraproject.org/fedora:latest"
        ]
    }
]
.EE

.PP
Inspect image ID for the specified image:

.EX
$ podman image inspect --format '{{ .Id }}' fedora
37e5619f4a8ca9dbc4d6c0ae7890625674a10dbcfb76201399e2aaddb40da17d
.EE

