.nh
.TH KUBERNETES(1) kubernetes User Manuals
Eric Paris
Jan 2015

.SH "نام (NAME)"
kubeadm init phase kubelet-finalize all \- Run all kubelet-finalize phases


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubeadm init phase kubelet-finalize all\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
Run all kubelet-finalize phases


.SH "گزینه‌ها (OPTIONS)"
\fB--cert-dir\fP="/etc/kubernetes/pki"
	The path where to save and store the certificates.

.PP
\fB--config\fP=""
	Path to a kubeadm configuration file.

.PP
\fB--dry-run\fP=false
	Don't apply any changes; just output what would be done.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--rootfs\fP=""
	The path to the 'real' host root filesystem. This will cause kubeadm to chroot into the provided path.

.PP
\fB--version\fP=false
	--version, --version=raw prints version information and quits; --version=vX.Y.Z... sets the reported version


.SH "مثال (EXAMPLE)"
.EX
  # Updates settings relevant to the kubelet after TLS bootstrap
  kubeadm init phase kubelet-finalize all --config
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubeadm-init-phase-kubelet-finalize(1)\fP,


.SH "تاریخچه (HISTORY)"
