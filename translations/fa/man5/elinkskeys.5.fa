.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
elinkskeys \- کلیدهای میانبر برای ELinks
.SH "خلاصه دستور (SYNOPSIS)"
.sp
اطلاعاتی در مورد نحوه پیکربندی کلیدهای میانبر و مروری بر کلیدهای میانبر پیش‌فرض\&.
.SH "توضیحات (DESCRIPTION)"
.sp
کلیدهای میانبر برای elinks باید در فایل ~/\&.config/elinks/elinks\&.conf قرار داده شوند\&. توجه داشته باشید که هرگونه اطلاعات مربوط به قالب/ساختار آن‌ها ممکن است به‌روز نباشد\&. اگر متوجه چنین مواردی شدید، لطفاً یک وصله (patch) برای ما ارسال کنید\&.
.sp
عبارت‌های انتساب کلید به این صورت هستند:
.sp
.if n \{\
.RS 4
.\}
.nf
bind <keymap> <keystroke> = <action>
.fi
.if n \{\
.RE
.\}
.sp
که در آن:
.PP
<keymap>
.RS 4
یکی از موارد
\fImain\fR،
\fIedit\fR، یا
\fImenu\fR است\&. نگاشت کلید main برای مرور عمومی به کار می‌رود\&. نگاشت کلید edit برای ویرایش فیلدهای متنی استفاده می‌شود\&. نگاشت کلید menu برای پیمایش منوها به کار می‌رود\&.
.RE
.PP
<keystroke>
.RS 4
کلیدی حساس به حروف کوچک و بزرگ است که می‌توانید پیشوند
\fICtrl\-\fR،
\fIAlt\-\fR، یا هر دو را به آن اضافه کنید\&.
پس از
\fICtrl\-\fR
باید یک کلید با حروف بزرگ بیاید\&. برای مشاهده فهرست کلیدهای معتبر، بخش‌های زیر را ببینید\&.
.RE
.PP
<action>
.RS 4
کاری است که کلید باید انجام دهد\&. کنش‌های موجود به نگاشت کلید بستگی دارند و در زیر به صورت جداگانه فهرست شده‌اند\&.
.RE
.sp
تمام کلمات/رشته‌ها را می‌توان درون گیومه "به این شکل" قرار داد\&. کاراکترهای بک‌اسلش نویسه‌های گریز هستند، حتی اگر بین گیومه‌ها نباشند\&. خطوطی که با نویسه هش (#) آغاز می‌شوند، توضیح (کامنت) هستند\&.
.sp
کلیدها را می‌توان صرفاً با انتساب آن‌ها به کنش ویژه \fInone\fR لغو انتساب کرد\&. این قابلیت زمانی که مرتباً یک کلید را به اشتباه می‌فشارید می‌تواند مفید باشد\&.
.SH "نمونه‌های انتساب کلید (EXAMPLE BINDINGS)"
.sp
چند نمونه از انتساب کلیدها:
.sp
.if n \{\
.RS 4
.\}
.nf
bind "main" "v" = "view\-image"
bind "main" "l" = "jump\-to\-link"
bind "main" "L" = "link\-menu"
bind "main" "F10" = "file\-menu"
bind "main" "F9" = "menu"
bind "main" "Escape" = "menu"
bind "edit" "Ctrl\-R" = "auto\-complete\-unambiguous"
bind "edit" "Ctrl\-W" = "auto\-complete"
bind "edit" "Ctrl\-K" = "kill\-to\-eol"
bind "menu" "Ctrl\-B" = "page\-up"
bind "menu" "PageUp" = "page\-up"
bind "menu" "Ctrl\-F" = "page\-down"
bind "menu" "PageDown" = "page\-down"
# ELinks با پشتیبانی از Lua
bind "main" "," = "lua\-console"
.fi
.if n \{\
.RE
.\}
.SH "کلیدها (KEYS)"
.sp
کلیدهای معتبر عبارتند از: نویسه‌های الفبایی\-عددی، علائم نگارشی، \fIEnter\fR، \fIBackspace\fR، \fITab\fR، \fIEscape\fR، \fILeft\fR، \fIRight\fR، \fIUp\fR، \fIDown\fR، \fIInsert\fR، \fIDelete\fR، \fIHome\fR، \fIEnd\fR، \fIPageUp\fR، \fIPageDown\fR، و \fIF1\fR تا \fIF12\fR\&.
.sp
برخی از کلیدها باید داخل گیومه یا با کاراکتر گریز نوشته شوند\&. به عنوان مثال، فاصله را می‌توان به صورت " " (گیومه فاصله گیومه)، و خود گیومه را به صورت \e" (بک‌اسلش گیومه) نوشت\&. بک‌اسلش را می‌توان به صورت \e\e (دو بک‌اسلش) نوشت\&.
.SH "کنش‌های نگاشت کلید (KEYMAP ACTIONS)"
