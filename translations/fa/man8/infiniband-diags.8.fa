[2](8f1040396055a)     \(dqS\-005442ba00003080\(dq[8]         # lid 14 lmc 1 \(dqISR9024 Voltaire\(dq lid 6 4xSDR
[1](8f10403960559)     \(dqS\-005442ba00003080\(dq[12]                # lid 10 lmc 1 \(dqISR9024 Voltaire\(dq lid 6 1xSDR
.EE
.UNINDENT
.UNINDENT
.sp
هنگامی که گروه‌بندی استفاده می‌شود، گره‌های IB در شاسی‌هایی سازماندهی می‌شوند که
شماره‌گذاری شده‌اند. گره‌هایی که نتوان قرار داشتن آن‌ها در یک شاسی را تشخیص داد
به عنوان \(dqNon\-Chassis Nodes\(dq نمایش داده می‌شوند. درگاه‌های خارجی نیز در خطوط
اتصال نشان داده می‌شوند.
.SH "فهرست ابزارها (Utilities list)"
.SS "اتصال پایه فابریک (Basic fabric connectivity)"
.INDENT 0.0
.INDENT 3.5
ببینید: ibnetdiscover, iblinkinfo
.UNINDENT
.UNINDENT
.SS "اطلاعات گره (Node information)"
.INDENT 0.0
.INDENT 3.5
ببینید: ibnodes, ibswitches, ibhosts, ibrouters
.UNINDENT
.UNINDENT
.SS "اطلاعات درگاه (Port information)"
.INDENT 0.0
.INDENT 3.5
ببینید: ibportstate, ibaddr
.UNINDENT
.UNINDENT
.SS "اطلاعات جدول هدایت سوئیچ (Switch Forwarding Table info)"
.INDENT 0.0
.INDENT 3.5
ببینید: ibtracert, ibroute, dump_lfts, dump_mfts, check_lft_balance, ibfindnodesusing
.UNINDENT
.UNINDENT
.SS "شمارنده‌های کارایی (Performance counters)"
