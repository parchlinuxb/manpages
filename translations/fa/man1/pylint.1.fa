.SS bare\-name\-capture\-pattern / E1901
.sp
\fBMessage emitted:\fP
.sp
\fBThe name capture \(gacase %s\(ga makes the remaining patterns unreachable. Use a dotted name (for example an enum) to fix this.\fP
.sp
\fBDescription:\fP
.sp
\fIEmitted when a name capture pattern is used in a match statement and there are case statements below it.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
red = 0
green = 1
blue = 2


def func(color):
    match color:
        case red:  # [bare\-name\-capture\-pattern]
            print(\(dqI see red!\(dq)
        case green:  # [bare\-name\-capture\-pattern]
            print(\(dqGrass is green\(dq)
        case blue:
            print(\(dqI\(aqm feeling the blues :(\(dq)

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
from enum import Enum


class Color(Enum):
    RED = 0
    GREEN = 1
    BLUE = 2


def func(color: Color) \-> None:
    match color:
        case Color.RED:
            print(\(dqI see red!\(dq)
        case Color.GREEN:
            print(\(dqGrass is green\(dq)
        case Color.BLUE:
            print(\(dqI\(aqm feeling the blues :(\(dq)

.EE
.UNINDENT
.UNINDENT
.sp
