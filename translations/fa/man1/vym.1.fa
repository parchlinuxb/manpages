.\" Uwe Drechsel <vym@insilmaril.de>
.\"
.\" Process this file with
.\" groff -man -Tascii foo.1
.\"
.\"
.TH VYM 1 "July 2012" "vym" "Mind mapping tool"
.\"
.\"
.SH "نام (NAME)"
VYM \- View Your Mind
.\"
.\"
.SH "خلاصه دستور (SYNOPSIS)"
.B vym [
.I options
.B ] [
.I file1 file2 ...
.B ]
.br
.\"
.\"
.SH "توضیحات (DESCRIPTION)"
.B VYM  (View Your Mind) 
is a tool to generate and manipulate maps which
show your thoughts. Such maps can help you to improve your creativity
and effectivity. You can use them for time management, to organize
tasks, to get an overview over complex contexts, to sort your ideas
etc. Some people even think it is fun to work with such maps...
.\"
.SH "گزینه‌ها (OPTIONS)"
.\"
.TP
.B -b, --batch       
Batch mode: hide graphical windows
.TP
.B -c, --commands        
Show all available commands
.TP
.B -d, --debug       
Show debugging output
.TP
.B -h, --help        
Show this help text
.TP
.B -L, --load       
Load script
.TP
.B -l, --local       
Run with ressources in current directory. (Only needed for development)
.TP
.B --locale        
Override system locale setting to select languag
.TP 
.B -n, --name <STRING>
Set name of this vym instance to 
.B STRING.
This is used to identify this instance on DBus.
.TP
.B -q, --quit        
Quit immediatly after start for benchmarking
.TP
.B -r, --run <FILE>
Run script 
.B FILE.
.TP
.B -R, --restore
Restore last session
.TP
.B -s, --shortcuts   
Show Keyboard shortcuts on start
.TP
.B -sl, --shortcutsLaTeX
Show Keyboard shortcuts in LaTeX format on start
.TP
.B -t --test
Test mode, e.g. no autosave and changing of its setting
.TP
.B -v, --version     
Show vym version
.\"
.SH "فایل‌ها (FILES)"
.TP
/usr/bin/vym
Main Executable
.TP
$HOME/.config/InSilmaril/vym.conf
Configuration file
.TP
/tmp/vym-XXXXXX
Runtime data for each vym instance, including undo-/redo history and clipboard
.SH "وضعیت خروج (EXIT STATUS)"
.TP
.if !'po4a'hide' .B 0
Successful program execution.
.\"
.\"
.SH "نویسنده (AUTHOR)"
.nf
Uwe Drechsel <vym@insilmaril.de> 
.fi
.\"
.\"
.SH "همچنین ببینید (SEE ALSO)"
Main documentation in /usr/share/doc/packages/vym/vym.pdf
.\"
.\" EOF
