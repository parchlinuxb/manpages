.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fIuint\fR
\fB\fBinner_width\fR\fR
= 0: width of the border around the clients content
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
