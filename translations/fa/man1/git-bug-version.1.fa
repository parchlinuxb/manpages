.TH "GIT-BUG" "1" "Apr 2019" "Generated from git-bug's source code" ""

.SH "نام (NAME)"
git-bug-version \- نمایش اطلاعات نسخه git-bug


.SH "خلاصه دستور (SYNOPSIS)"
\fBgit-bug version [flags]\fP


.SH "توضیحات (DESCRIPTION)"
نمایش اطلاعات نسخه git-bug


.SH "گزینه‌ها (OPTIONS)"
\fB-n\fP, \fB--number\fP[=false]
	فقط نمایش شماره نسخه

.PP
\fB-c\fP, \fB--commit\fP[=false]
	فقط نمایش هش کامیت

.PP
\fB-a\fP, \fB--all\fP[=false]
	نمایش تمام اطلاعات نسخه

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای version


.SH "همچنین ببینید (SEE ALSO)"
\fBgit-bug(1)\fP
