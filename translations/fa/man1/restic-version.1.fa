.nh
.TH "restic backup" "1" "Jan 2017" "generated by \fBrestic generate\fR" ""

.SH "نام (NAME)"
restic-version \- چاپ اطلاعات نسخه


.SH "خلاصه دستور (SYNOPSIS)"
\fBrestic version [flags]\fP


.SH "توضیحات (DESCRIPTION)"
دستور «version» اطلاعات تفصیلی درباره محیط ساخت
و نسخه این نرم‌افزار را چاپ می‌کند.


.SH "وضعیت خروج (EXIT STATUS)"
در صورت موفقیت‌آمیز بودن دستور، وضعیت خروج 0 است.
در صورت بروز هرگونه خطا، وضعیت خروج 1 است.


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	راهنمای version


.SH "گزینه‌های به ارث‌رسیده از دستورهای والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--cacert\fP=[]
	\fBفایل\fR برای بارگذاری گواهی‌های ریشه از آن (پیش‌فرض: استفاده از گواهی‌های سیستم یا $RESTIC_CACERT)

.PP
\fB--cache-dir\fP=""
	تنظیم \fBدایرکتوری\fR کَش\&. (پیش‌فرض: استفاده از دایرکتوری کَش پیش‌فرض سیستم)

.PP
\fB--cleanup-cache\fP[=false]
	حذف خودکار دایرکتوری‌های کَش قدیمی

.PP
\fB--compression\fP=auto
	حالت فشرده‌سازی (تنها برای فرمت مخزن نسخه ۲ در دسترس است)، یکی از (auto|off|fastest|better|max) (پیش‌فرض: $RESTIC_COMPRESSION)

.PP
\fB--http-user-agent\fP=""
	تنظیم یک http user agent برای درخواست‌های http خروجی

.PP
\fB--insecure-no-password\fP[=false]
	استفاده از گذرواژه خالی برای مخزن، باید به هر دستور restic ارسال شود (ناامن)

.PP
\fB--insecure-tls\fP[=false]
	صرف‌نظر از اعتبارسنجی گواهی TLS هنگام اتصال به مخزن (ناامن)

.PP
\fB--json\fP[=false]
	تنظیم حالت خروجی به JSON برای دستورهایی که از آن پشتیبانی می‌کنند

.PP
\fB--key-hint\fP=""
	شناسه \fBکلید\fR مربوط به کلیدی که ابتدا برای رمزگشایی امتحان می‌شود (پیش‌فرض: $RESTIC_KEY_HINT)

.PP
\fB--limit-download\fP=0
	محدود کردن دانلودها به یک حداکثر \fBنرخ\fR بر حسب KiB/s\&. (پیش‌فرض: نامحدود)

.PP
\fB--limit-upload\fP=0
	محدود کردن آپلودها به یک حداکثر \fBنرخ\fR بر حسب KiB/s\&. (پیش‌فرض: نامحدود)

.PP
\fB--no-cache\fP[=false]
	عدم استفاده از کَش محلی

.PP
\fB--no-extra-verify\fP[=false]
	صرف‌نظر از اعتبارسنجی اضافی داده‌ها پیش از آپلود (به مستندات مراجعه کنید)

.PP
\fB--no-lock\fP[=false]
	قفل نکردن مخزن، این گزینه اجازه انجام برخی عملیات را روی مخزن‌های فقط‌خواندنی می‌دهد

.PP
\fB-o\fP, \fB--option\fP=[]
	تنظیم گزینه پیشرفته (\fBkey=value\fR، می‌تواند چندین بار مشخص شود)

.PP
\fB--pack-size\fP=0
	تنظیم \fBاندازه\fR بسته هدف بر حسب MiB، فایل‌های بسته ایجادشده ممکن است بزرگ‌تر باشند (پیش‌فرض: $RESTIC_PACK_SIZE)

.PP
\fB--password-command\fP=""
	\fBدستور\fR شل برای دریافت گذرواژه مخزن از آن (پیش‌فرض: $RESTIC_PASSWORD_COMMAND)

.PP
\fB-p\fP, \fB--password-file\fP=""
	\fBفایل\fR برای خواندن گذرواژه مخزن از آن (پیش‌فرض: $RESTIC_PASSWORD_FILE)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	عدم خروجی گزارش پیشرفت جامع

.PP
\fB-r\fP, \fB--repo\fP=""
	\fBمخزن\fR برای پشتیبان‌گیری در آن یا بازیابی از آن (پیش‌فرض: $RESTIC_REPOSITORY)

.PP
\fB--repository-file\fP=""
	\fBفایل\fR برای خواندن مکان مخزن از آن (پیش‌فرض: $RESTIC_REPOSITORY_FILE)

.PP
\fB--retry-lock\fP=0s
	تلاش مجدد برای قفل کردن مخزن در صورتی که از قبل قفل شده باشد، مقداری مانند 5m یا 2h می‌پذیرد (پیش‌فرض: بدون تلاش مجدد)

.PP
\fB--stuck-request-timeout\fP=5m0s
	\fBمدت‌زمان\fR پس از آن برای تلاش مجدد در درخواست‌های متوقف‌شده

.PP
\fB--tls-client-cert\fP=""
	مسیر یک \fBفایل\fR حاوی گواهی کلاینت TLS و کلید خصوصی با کدگذاری PEM (پیش‌فرض: $RESTIC_TLS_CLIENT_CERT)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	حالت پرگو (چندین بار مشخص کنید یا یک سطح را با --verbose=n تعیین کنید، حداکثر سطح/تعداد 2 است)


.SH "همچنین ببینید (SEE ALSO)"
\fBrestic(1)\fP