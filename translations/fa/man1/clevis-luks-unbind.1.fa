.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
clevis-luks-unbind \- لغو پیوند یک پین متصل‌شده به یک دیسک LUKS
.SH "خلاصه دستور (SYNOPSIS)"
.sp
\fBclevis luks unbind\fR \-d DEV \-s SLT
.SH "نمای کلی (OVERVIEW)"
.sp
دستور \fBclevis luks unbind\fR اتصال یک پین (pin) متصل‌شده به یک پارتیشن یا دیسک LUKS را لغو می‌کند\&. برای نمونه:
.sp
.if n \{\
.RS 4
.\}
.nf
$ clevis luks unbind \-d /dev/sda \-s 1
.fi
.if n \{\
.RE
.\}
.SH "گزینه‌ها (OPTIONS)"
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-d\fR
\fIDEV\fR
: دستگاه LUKS متصل‌شده
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-s\fR
\fISLT\fR
: شماره اسلات پین برای لغو اتصال\&. هنگام استفاده از LUKSv1، این همان اسلات LUKSmeta است
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-f\fR
: عدم درخواست تأییدیه و پاک‌سازی اسلات در حالت دسته‌ای (batch\-mode)
.RE
.SH "همچنین ببینید (SEE ALSO)"
.sp
\fBclevis\-luks\-bind\fR(1)
