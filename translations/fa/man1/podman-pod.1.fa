'\" t
.nh
.TH podman-pod 1
.SH "نام (NAME)"
podman-pod \- ابزار مدیریت گروه‌هایی از کانتینرها به نام پاد

.SH "خلاصه دستور (SYNOPSIS)"
\fBpodman pod\fP \fIزیردستور\fP

.SH "توضیحات (DESCRIPTION)"
دستور \fBpodman pod\fP مجموعه‌ای از زیردستورها برای مدیریت پادها (گروه‌هایی از کانتینرها) است.

.SH "زیردستورها (SUBCOMMANDS)"
.TS
allbox;
l l l 
l l l .
\fBدستور\fP	\fBصفحه راهنما\fP	\fBتوضیحات\fP
clone	podman-pod-clone(1)	T{
ایجاد یک رونوشت از یک پاد موجود.
T}
create	podman-pod-create(1)	ایجاد یک پاد جدید.
exists	podman-pod-exists(1)	T{
بررسی وجود یک پاد در فضای ذخیره‌سازی محلی.
T}
inspect	podman-pod-inspect(1)	T{
نمایش اطلاعات توصیف‌کننده یک پاد.
T}
kill	podman-pod-kill(1)	T{
خاتمه فرایند اصلی هر کانتینر در یک یا چند پاد.
T}
logs	podman-pod-logs(1)	T{
نمایش لاگ‌های یک پاد با یک یا چند کانتینر.
T}
pause	podman-pod-pause(1)	متوقف کردن موقت یک یا چند پاد.
prune	podman-pod-prune(1)	T{
حذف تمام پادهای متوقف‌شده و کانتینرهای آن‌ها.
T}
ps	podman-pod-ps(1)	T{
چاپ اطلاعات درباره پادها.
T}
restart	podman-pod-restart(1)	راه‌اندازی مجدد یک یا چند پاد.
rm	podman-pod-rm(1)	T{
حذف یک یا چند پاد و کانتینر متوقف‌شده.
T}
start	podman-pod-start(1)	شروع یک یا چند پاد.
stats	podman-pod-stats(1)	T{
نمایش جریان زنده از آمار مصرف منابع کانتینرها در یک یا چند پاد.
T}
stop	podman-pod-stop(1)	متوقف کردن یک یا چند پاد.
top	podman-pod-top(1)	T{
نمایش فرایندهای در حال اجرای کانتینرها در یک پاد.
T}
unpause	podman-pod-unpause(1)	خروج یک یا چند پاد از حالت توقف موقت.
.TE

.SH "همچنین ببینید (SEE ALSO)"
\fBpodman(1)\fP

.SH "تاریخچه (HISTORY)"
