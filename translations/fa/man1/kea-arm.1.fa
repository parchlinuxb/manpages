T}	T{
Format
T}
_
T{
tsp\-primary\-server
T}	T{
1
T}	T{
IPv4 address
T}
_
T{
tsp\-secondary\-server
T}	T{
2
T}	T{
IPv4 address
T}
_
T{
tsp\-as\-parameters
T}	T{
4
T}	T{
record of 3 uint32\(aqs
T}
_
T{
tsp\-ap\-parameters
T}	T{
5
T}	T{
record of 3 uint32\(aqs
T}
_
T{
