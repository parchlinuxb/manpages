.nh
.TH KUBERNETES 1 "Jan 2015" "Eric Paris" "راهنمای کاربر kubernetes"

.SH "نام (NAME)"
kubeadm-init \- اجرای این دستور جهت راه‌اندازی صفحه کنترل (control plane) کوبرنتیز


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubeadm init\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
این دستور را جهت راه‌اندازی صفحه کنترل (control plane) کوبرنتیز اجرا کنید.

.PP
دستور "init" فازهای زیر را اجرا می‌کند:

.EX
preflight                     اجرای بررسی‌های پیش‌پرواز (pre-flight)
certs                         تولید گواهی‌ها
  /ca                           تولید CA خودامضاشده کوبرنتیز برای ارائه هویت به سایر مؤلفه‌های کوبرنتیز
  /apiserver                    تولید گواهی برای سرویس‌دهی API کوبرنتیز
  /apiserver-kubelet-client     تولید گواهی برای اتصال سرور API به kubelet
  /front-proxy-ca               تولید CA خودامضاشده جهت ارائه هویت برای front proxy
  /front-proxy-client           تولید گواهی برای کلاینت front proxy
  /etcd-ca                      تولید CA خودامضاشده جهت ارائه هویت برای etcd
  /etcd-server                  تولید گواهی برای سرویس‌دهی etcd
  /etcd-peer                    تولید گواهی برای ارتباط گره‌های etcd با یکدیگر
  /etcd-healthcheck-client      تولید گواهی برای پروب‌های liveness جهت بررسی سلامت etcd
  /apiserver-etcd-client        تولید گواهی مورد استفاده apiserver برای دسترسی به etcd
  /sa                           تولید کلید خصوصی جهت امضای توکن‌های service account به همراه کلید عمومی آن
kubeconfig                    تولید تمام فایل‌های kubeconfig لازم برای برپایی صفحه کنترل و فایل kubeconfig مدیر
  /admin                        تولید فایل kubeconfig برای استفاده مدیر و خود kubeadm
  /super-admin                  تولید فایل kubeconfig برای super-admin
  /kubelet                      تولید فایل kubeconfig برای استفاده kubelet *صرفاً* جهت راه‌اندازی اولیه کلاستر
  /controller-manager           تولید فایل kubeconfig برای استفاده controller manager
  /scheduler                    تولید فایل kubeconfig برای استفاده scheduler
etcd                          تولید فایل مانیفست پاد استاتیک برای etcd محلی
  /local                        تولید فایل مانیفست پاد استاتیک برای یک نمونه etcd محلی تک‌گره‌ای
control-plane                 تولید تمام فایل‌های مانیفست پاد استاتیک لازم برای برپایی صفحه کنترل
  /apiserver                    تولید مانیفست پاد استاتیک kube-apiserver
  /controller-manager           تولید مانیفست پاد استاتیک kube-controller-manager
  /scheduler                    تولید مانیفست پاد استاتیک kube-scheduler
kubelet-start                 نوشتن تنظیمات kubelet و راه‌اندازی (مجدد) kubelet
wait-control-plane            انتظار برای شروع به کار صفحه کنترل
upload-config                 بارگذاری پیکربندی kubeadm و kubelet در یک ConfigMap
  /kubeadm                      بارگذاری ClusterConfiguration مربوط به kubeadm در یک ConfigMap
  /kubelet                      بارگذاری پیکربندی مؤلفه kubelet در یک ConfigMap
upload-certs                  بارگذاری گواهی‌ها در kubeadm-certs
mark-control-plane            علامت‌گذاری یک گره به عنوان control-plane
bootstrap-token               تولید توکن‌های راه‌اندازی اولیه (bootstrap) مورد استفاده برای پیوستن یک گره به کلاستر
kubelet-finalize              به‌روزرسانی تنظیمات مرتبط با kubelet پس از bootstrap مربوط به TLS
  /enable-client-cert-rotation  فعال‌سازی چرخش گواهی کلاینت kubelet
addon                         نصب افزونه‌های لازم جهت قبولی در آزمون‌های انطباق (conformance)
  /coredns                      نصب افزونه CoreDNS در یک کلاستر کوبرنتیز
  /kube-proxy                   نصب افزونه kube-proxy در یک کلاستر کوبرنتیز
show-join-command             نمایش دستور join برای گره‌های control-plane و worker
.EE


.SH "گزینه‌ها (OPTIONS)"
\fB--apiserver-advertise-address\fP=""
	آدرس IP که API Server اعلام می‌کند روی آن در حال گوش دادن است. اگر تنظیم نشود، از رابط شبکه پیش‌فرض استفاده خواهد شد.

.PP
\fB--apiserver-bind-port\fP=6443
	پورتی که API Server به آن متصل (bind) می‌شود.

.PP
\fB--apiserver-cert-extra-sans\fP=[]
	نام‌های موضوعی جایگزین (SANها یا Subject Alternative Names) اختیاری اضافی برای استفاده در گواهی سرویس‌دهی API Server. این موارد می‌توانند هم آدرس‌های IP و هم نام‌های DNS باشند.

.PP
\fB--cert-dir\fP="/etc/kubernetes/pki"
	مسیری که گواهی‌ها در آن ذخیره و نگهداری می‌شوند.

.PP
\fB--certificate-key\fP=""
	کلید مورد استفاده برای رمزنگاری گواهی‌های صفحه کنترل در Secret با نام kubeadm-certs. این کلید گواهی یک رشته با کدگذاری هگزادسیمال (hex encoded) است که یک کلید AES با اندازه ۳۲ بایت می‌باشد.

.PP
\fB--config\fP=""
	مسیر فایل پیکربندی kubeadm.

.PP
\fB--control-plane-endpoint\fP=""
	مشخص کردن یک آدرس IP یا نام DNS پایدار برای صفحه کنترل.

.PP
\fB--cri-socket\fP=""
	مسیر سوکت CRI برای اتصال. در صورت خالی بودن، kubeadm تلاش می‌کند این مقدار را به صورت خودکار شناسایی کند؛ از این گزینه تنها در صورتی استفاده کنید که بیش از یک CRI نصب شده باشد یا از سوکت غیراستاندارد CRI استفاده می‌کنید.

.PP
\fB--dry-run\fP=false
	هیچ تغییری را اعمال نکن؛ صرفاً آنچه را که انجام خواهد شد نمایش بده.

.PP
\fB--feature-gates\fP=""
	مجموعه‌ای از جفت‌های کلید=مقدار (key=value) که درگاه‌های قابلیت (feature gates) را برای قابلیت‌های مختلف شرح می‌دهد. گزینه‌ها عبارتند از:
NodeLocalCRISocket=true|false (پیش‌فرض=true)
PublicKeysECDSA=true|false (منسوخ‌شده - پیش‌فرض=false)
RootlessControlPlane=true|false (آلفا - پیش‌فرض=false)

.PP
\fB--ignore-preflight-errors\fP=[]
	فهرستی از بررسی‌هایی که خطاهای آن‌ها به عنوان هشدار نمایش داده خواهد شد. مثال: 'IsPrivilegedUser,Swap'. مقدار 'all' خطاهای ناشی از تمام بررسی‌ها را نادیده می‌گیرد.

.PP
\fB--image-repository\fP="registry.k8s.io"
	انتخاب یک رجیستری کانتینر برای دریافت (pull) ایمیج‌های صفحه کنترل از آن.

.PP
\fB--kubernetes-version\fP="stable-1"
	انتخاب نسخه خاصی از کوبرنتیز برای صفحه کنترل.

.PP
\fB--node-name\fP=""
	مشخص کردن نام گره (node).

.PP
\fB--patches\fP=""
	مسیر دایرکتوری حاوی فایل‌هایی با الگوی نام‌گذاری "target[suffix][+patchtype].extension". برای نمونه، "kube-apiserver0+merge.yaml" یا صرفاً "etcd.json". مقدار "target" می‌تواند یکی از موارد "kube-apiserver"، "kube-controller-manager"، "kube-scheduler"، "etcd"، "kubeletconfiguration" یا "corednsdeployment" باشد. مقدار "patchtype" می‌تواند یکی از قالب‌های "strategic"، "merge" یا "json" باشد که مطابق با قالب‌های وصله (patch) پشتیبانی‌شده توسط kubectl هستند. مقدار پیش‌فرض "patchtype" برابر با "strategic" است. مقدار "extension" باید "json" یا "yaml" باشد. مقدار "suffix" یک رشته اختیاری است که می‌توان از آن برای تعیین ترتیب الفبایی-عددی اعمال وصله‌ها استفاده کرد.

.PP
\fB--pod-network-cidr\fP=""
	مشخص کردن محدوده آدرس‌های IP برای شبکه پاد (pod network). در صورت تنظیم، صفحه کنترل به طور خودکار CIDRها را برای هر گره تخصیص می‌دهد.

.PP
\fB--service-cidr\fP="10.96.0.0/12"
	استفاده از محدوده جایگزین آدرس IP برای VIPهای سرویس.

.PP
\fB--service-dns-domain\fP="cluster.local"
	استفاده از دامنه جایگزین برای سرویس‌ها، مانند "myorg.internal".

.PP
\fB--skip-certificate-key-print\fP=false
	عدم چاپ کلید مورد استفاده برای رمزنگاری گواهی‌های صفحه کنترل.

.PP
\fB--skip-phases\fP=[]
	فهرستی از فازهایی که باید نادیده گرفته و رد شوند.

.PP
\fB--skip-token-print\fP=false
	رد کردن چاپ توکن راه‌اندازی اولیه (bootstrap token) پیش‌فرض تولیدشده توسط 'kubeadm init'.

.PP
\fB--token\fP=""
	توکن مورد استفاده برای برقراری اعتماد دوطرفه میان گره‌ها و گره‌های صفحه کنترل. قالب آن به صورت [a-z0-9]{6}\&.[a-z0-9]{16} است - مانند abcdef.0123456789abcdef

.PP
\fB--token-ttl\fP=24h0m0s
	مدت زمان پیش از حذف خودکار توکن (مانند 1s، 2m، 3h). در صورت تنظیم روی '0'، توکن هرگز منقضی نخواهد شد.

.PP
\fB--upload-certs\fP=false
	بارگذاری گواهی‌های صفحه کنترل در Secret با نام kubeadm-certs.


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--rootfs\fP=""
	مسیر به سیستم‌فایل ریشه «واقعی» میزبان. این گزینه باعث می‌شود kubeadm در مسیر ارائه‌شده chroot کند.

.PP
\fB--version\fP=false
	\fB--version\fP و \fB--version=raw\fP اطلاعات نسخه را چاپ کرده و خارج می‌شوند؛ \fB--version=vX.Y.Z...\fP نسخه گزارش‌شده را تنظیم می‌کند.


.SH "همچنین ببینید (SEE ALSO)"
\fBkubeadm(1)\fP, \fBkubeadm-init-phase(1)\fP


.SH "تاریخچه (HISTORY)"
ژانویه ۲۰۱۵، در ابتدا توسط Eric Paris (eparis at redhat dot com) بر پایه محتوای منبع kubernetes گردآوری شد، اما امید است که از آن زمان به بعد به طور خودکار تولید شده باشند!
