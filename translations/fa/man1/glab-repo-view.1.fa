.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-repo-view \- View a project or repository.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab repo view [repository] [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Display the description and README of a project, or open it in the browser.


.SH "گزینه‌ها (OPTIONS)"
\fB-b\fP, \fB--branch\fP=""
	View a specific branch of the repository.

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression.

.PP
\fB-F\fP, \fB--output\fP="text"
	Format output as: text, json.

.PP
\fB-w\fP, \fB--web\fP[=false]
	Open a project in the browser.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-h\fP, \fB--help\fP[=false]
	Show help for this command.


.SH "مثال (EXAMPLE)"
.EX
# View project information for the current directory.
# Must be a Git repository.
glab repo view

# View project information of specified name.
# glab repo view my-project
glab repo view user/repo
glab repo view group/namespace/repo

# Specify repository by full [Git] URL.
glab repo view git@gitlab.com:user/repo.git
glab repo view https://gitlab.company.org/user/repo
glab repo view https://gitlab.company.org/user/repo.git
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-repo(1)\fP
