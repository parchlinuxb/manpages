    return \(dqorange\(dq


def is_an_orange(fruit: str = \(dqapple\(dq):
    # apple == <function function_returning_a_fruit at 0x7f343ff0a1f0>
    return fruit == function_returning_a_fruit  # [comparison\-with\-callable]

