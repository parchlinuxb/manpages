.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_neqn_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY \%neqn
.RI [ \%eqn-argument \~.\|.\|.]
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
.I \%neqn
دستور
.MR \%eqn 1
را با دستگاه خروجی
.B ascii
فراخوانی می‌کند.
.
.
.PP
ابزار
.I eqn
در GNU از دستگاه‌های با وضوح پایین و شبیه به ماشین‌تحریر پشتیبانی نمی‌کند،
اگرچه ممکن است برای ورودی‌های بسیار ساده به شکلی مناسب کار کند.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.MR \%eqn 1
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_neqn_1_man_C]
.do rr *groff_neqn_1_man_C
.
.
