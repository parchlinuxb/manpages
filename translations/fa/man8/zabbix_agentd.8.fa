.\" Start URL macro. Copied from an-ext.tmac for portability
.de UR
.  ds m1 \\$1\"
.  nh
.  if \\n(mH \{\
.    \" Start diversion in a new environment.
.    do ev URL-div
.    do di URL-div
.  \}
..
.\" End URL macro. Copied from an-ext.tmac for portability
.de UE
.  ie \\n(mH \{\
.    br
.    di
.    ev
.
.    \" Has there been one or more input lines for the link text?
.    ie \\n(dn \{\
.      do HTML-NS "<a href=""\\*(m1"">"
.      \" Yes, strip off final newline of diversion and emit it.
.      do chop URL-div
.      do URL-div
\c
.      do HTML-NS </a>
.    \}
.    el \
.      do HTML-NS "<a href=""\\*(m1"">\\*(m1</a>"
\&\\$*\"
.  \}
.  el \
\\*(la\\*(m1\\*(ra\\$*\"
.
.  hy \\n(HY
..
.TH ZABBIX_AGENTD 8 "2022\-01\-06" Zabbix
.SH "نام (NAME)"
zabbix_agentd \- دیمن کارگزار زبیکس
.SH "خلاصه دستور (SYNOPSIS)"
.B zabbix_agentd
.RB [ \-c
.IR config\-file ]
.br
.B zabbix_agentd
.RB [ \-c
.IR config\-file ]
.B \-p
.br
.B zabbix_agentd
.RB [ \-c
.IR config\-file ]
.B \-t
.I item\-key
.br
.B zabbix_agentd
.RB [ \-c
.IR config\-file ]
.B \-R
.I runtime\-option
.br
.B zabbix_agentd
.RB [ \-c
.IR config\-file ]
.B \-T
.br
.B zabbix_agentd \-h
.br
.B zabbix_agentd \-V
.SH "توضیحات (DESCRIPTION)"
.B zabbix_agentd
دیمنی برای پایش پارامترهای مختلف سرور است.
.SH "گزینه‌ها (OPTIONS)"
.IP "\fB\-c\fR, \fB\-\-config\fR \fIconfig\-file\fR"
استفاده از \fIconfig\-file\fR جایگزین به جای پرونده پیش‌فرض.
.IP "\fB\-f\fR, \fB\-\-foreground\fR"
اجرای کارگزار زبیکس در پیش‌زمینه.
.IP "\fB\-R\fR, \fB\-\-runtime\-control\fR \fIruntime\-option\fR"
انجام عملکردهای مدیریتی مطابق با \fIruntime\-option\fR.
.SS
.RS 4
گزینه‌های کنترل زمان اجرا
.RS 4
.TP 4
\fBuserparameter_reload\fR
بارگذاری مجدد پارامترهای کاربر از فایل پیکربندی
.RE
.RS 4
.TP 4
\fBlog_level_increase\fR[=\fItarget\fR]
افزایش سطح گزارش‌گیری، در صورت مشخص نشدن هدف بر تمام فرایندها تأثیر می‌گذارد
.RE
.RS 4
.TP 4
\fBlog_level_decrease\fR[=\fItarget\fR]
کاهش سطح گزارش‌گیری، در صورت مشخص نشدن هدف بر تمام فرایندها تأثیر می‌گذارد
.RE
.RE
.SS
.RS 4
اهداف کنترل سطح گزارش‌گیری
.RS 4
.TP 4
.I process\-type
تمام فرایندهای نوع مشخص‌شده (active\ checks، collector، listener)
.RE
.RS 4
.TP 4
.I process\-type,N
نوع و شماره فرایند (مانند listener,3)
.RE
.RS 4
.TP 4
.I pid
شناسه فرایند، تا ۶۵۵۳۵. برای مقادیر بزرگ‌تر هدف را به‌صورت "process\-type,N" مشخص کنید
.RE
.RE
.IP "\fB\-p\fR, \fB\-\-print\fR"
چاپ آیتم‌های شناخته‌شده و خروج.
برای هر آیتم، یا مقادیر پیش‌فرض عمومی استفاده می‌شود یا پیش‌فرض‌های خاص برای آزمایش ارائه می‌گردد.
این مقادیر پیش‌فرض در براکت‌ها به‌عنوان پارامترهای کلید آیتم فهرست شده‌اند.
مقادیر بازگردانده‌شده در براکت قرار دارند و نوع مقدار بازگشتی به‌عنوان پیشوند به آن اضافه شده است که با یک نویسه خط عمودی (|) جدا می‌شوند.
برای پارامترهای کاربر نوع همیشه \fBt\fR است، زیرا کارگزار نمی‌تواند تمام مقادیر بازگشتی ممکن را تعیین کند.
آیتم‌هایی که به‌صورت در حال کار نمایش داده می‌شوند، تضمینی نیست که هنگام پرس‌وجو از سمت سرور زبیکس یا zabbix_get از یک دیمن کارگزارِ در حال اجرا نیز کار کنند، زیرا ممکن است مجوزها یا متغیرهای محیطی متفاوت باشند.
انواع مقادیر بازگردانده‌شده عبارتند از:
.RS 4
.TP 4
d
عدد با بخش اعشاری.
.RE
.RS 4
.TP 4
m
پشتیبانی نمی‌شود.
این حالت می‌تواند ناشی از پرس‌وجوی آیتمی باشد که تنها در حالت فعال (active mode) کار می‌کند، مانند آیتم پایش لاگ یا آیتمی که به چندین مقدار جمع‌آوری‌شده نیاز دارد.
مشکلات دسترسی یا پارامترهای کاربری نادرست نیز می‌توانند باعث وضعیت پشتیبانی‌نشده شوند.
.RE
.RS 4
.TP 4
s
متن.
حداکثر طول نامحدود است.
.RE
.RS 4
.TP 4
t
متن.
مشابه \fBs\fR.
.RE
.RS 4
.TP 4
u
عدد صحیح بدون علامت.
.RE
.IP "\fB\-t\fR, \fB\-\-test\fR \fIitem\-key\fR"
آزمایش یک آیتم تکی و خروج.
برای توضیحات خروجی به \fB\-\-print\fR مراجعه کنید.
.IP "\fB\-T\fR, \fB\-\-test-config\fR"
اعتبارسنجی فایل پیکربندی و خروج.
.IP "\fB\-h\fR, \fB\-\-help\fR"
نمایش این راهنما و خروج.
.IP "\fB\-V\fR, \fB\-\-version\fR"
نمایش اطلاعات نسخه و خروج.
.SH "فایل‌ها (FILES)"
.TP
.I /usr/local/etc/zabbix_agentd.conf
مسیر پیش‌فرض فایل پیکربندی کارگزار زبیکس (در صورتی که در زمان کامپایل تغییر داده نشده باشد).
.SH "همچنین ببینید (SEE ALSO)"
.UR https://www.zabbix.com/manuals
مستندات
.UE
.PP
.BR zabbix_get (1),
.BR zabbix_proxy (8),
.BR zabbix_sender (1),
.BR zabbix_server (8),
.BR zabbix_js (1),
.BR zabbix_agent2 (8),
.BR zabbix_web_service (8)
