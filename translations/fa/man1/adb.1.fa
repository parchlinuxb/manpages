.\" Automatically generated by Pandoc 3.1.3
.\"
.TH "adb" "1" "1.0.41" "android-tools" "راهنمای کاربری ADB"
.hy
.SH "نام (NAME)"
adb \- کلاینت خط فرمان برای کارساز پل اشکال‌زدایی اندروید (ADB)
.SH "نسخه (VERSION)"
.PP
1.0.41
.SH "خلاصه دستور (SYNOPSIS)"
.PP
\f[B]adb\f[R] [\f[I]گزینه‌های_عمومی\fR] \f[I]دستور\f[R]
[\f[I]گزینه‌های_دستور\fR]
.SH "توضیحات (DESCRIPTION)"
.PP
از طریق رابط سوکت هوشمند (smart socket) به کارساز ADB متصل می‌شود.
امکان ارسال درخواست‌ها، دریافت پاسخ‌ها و مدیریت چرخه حیات کارساز adb را فراهم می‌کند.
.PP
وظایف از طریق دستورات انجام می‌شوند.
برخی دستورات مستقیماً توسط کارساز انجام می‌شوند در حالی که برخی دیگر به adbd (دیمن ADB) در حال اجرا روی دستگاه هدایت (forward) می‌شوند.
.SH "گزینه‌های عمومی (GLOBAL OPTIONS)"
.PP
\f[B]-a\f[R] \ \ \ \ گوش دادن روی تمام رابط‌های شبکه، نه فقط localhost.
.PP
\f[B]-d\f[R] \ \ \ \ استفاده از دستگاه USB (در صورت اتصال چند دستگاه، خطا برمی‌گرداند).
.PP
\f[B]-e\f[R] \ \ \ \ استفاده از دستگاه TCP/IP (در صورت وجود چند دستگاه TCP/IP، خطا برمی‌گرداند).
.PP
\f[B]-s\f[R] \f[B]SERIAL\f[R] \ \ \ \ استفاده از دستگاه با شماره سریال (\f[B]SERIAL\f[R]) مشخص‌شده (بازنویسی $ANDROID_SERIAL).
.PP
\f[B]-t\f[R] \f[B]ID\f[R] \ \ \ \ استفاده از دستگاه با شناسه انتقال (\f[B]ID\f[R]) مشخص‌شده.
.PP
\f[B]-H\f[R] \ \ \ \ نام هاست کارساز adb [پیش‌فرض=localhost].
.PP
\f[B]-P\f[R] \f[B]PORT\f[R] \ \ \ \ درگاه (\f[B]PORT\f[R]) سوکت هوشمند کارساز adb [پیش‌فرض=5037].
.PP
\f[B]-L\f[R] \f[B]SOCKET\f[R] \ \ \ \ گوش دادن روی سوکت مشخص‌شده برای کارساز adb [پیش‌فرض=tcp:localhost:5037].
.PP
\f[B]--one-device\f[R] \f[B]SERIAL\f[R]|\f[B]USB\f[R] \ \ \ \ کارساز فقط به یک دستگاه USB متصل می‌شود که با شماره \f[B]SERIAL\f[R] یا آدرس دستگاه \f[B]USB\f[R] مشخص شده باشد (فقط با `start-server` یا `server nodaemon`).
.PP
\f[B]--exit-on-write-error\f[R] \ \ \ \ خروج در صورت بسته شدن خروجی استاندارد (stdout).
.SH "دستورات عمومی (GENERAL COMMANDS)"
.PP
devices [\f[B]-l\f[R]] \ \ \ \ فهرست کردن دستگاه‌های متصل.
.PP
\f[B]-l\f[R] \ \ \ \ استفاده از خروجی با جزئیات کامل (long output).
.PP
track-devices [-l][--proto-text][--proto-binary] \ \ \ \ مشابه دستور `devices`، اما پس از اجرا خارج نمی‌شود و با تغییر فهرست دستگاه‌ها به‌روزرسانی‌ها را ارسال می‌کند.
.PP
\f[B]-l\f[R] \ \ \ \ استفاده از خروجی با جزئیات به روش قدیمی (legacy).
.PP
\f[B]-proto-text\f[R] \ \ \ \ استفاده از خروجی متنی پروتوباف (protobuf).
.PP
\f[B]-proto-binary\f[R] \ \ \ \ استفاده از خروجی باینری پروتوباف (binary protobuf).
.PP
help \ \ \ \ نمایش این پیام راهنما.
.PP
version \ \ \ \ نمایش شماره نسخه.
.SH "شبکه‌بندی (NETWORKING)"
.PP
connect \f[B]HOST\f[R][:\f[B]PORT\f[R]] \ \ \ \ اتصال به یک دستگاه از طریق TCP/IP [پیش‌فرض \f[B]PORT\f[R]=5555].
.PP
disconnect [\f[B]HOST\f[R][:\f[B]PORT\f[R]]] \ \ \ \ قطع اتصال از دستگاه TCP/IP مشخص‌شده [پیش‌فرض \f[B]PORT\f[R]=5555] یا همه دستگاه‌ها.
.PP
pair \f[B]HOST\f[R][:\f[B]PORT\f[R]] [\f[B]PAIRING_CODE\f[R]] \ \ \ \ جفت‌سازی با دستگاه برای برقراری ارتباط امن از طریق TCP/IP.
.PP
forward \f[B]--list\f[R] | [\f[B]--no-rebind\f[R]] \f[B]LOCAL_REMOTE\f[R] | \f[B]--remove\f[R] \f[B]LOCAL\f[R] | \f[B]--remove-all\f[R]
.PP
\f[B]--list\f[R] \ \ \ \ فهرست کردن تمام اتصالات سوکت هدایت‌شده (forward socket).
.PP
[\f[B]--no-rebind\f[R]] \f[B]LOCAL_REMOTE\f[R] \ \ \ \ هدایت اتصال سوکت با استفاده از یکی از موارد زیر:
.PP
\ \ \ \ \f[B]tcp\f[R]:\f[B]PORT\f[R] (مقدار محلی می‌تواند برابر با «tcp:0» باشد تا هر درگاه آزادی انتخاب شود).
.PP
\ \ \ \ \f[B]localreserved\f[R]:\f[B]UNIX_DOMAIN_SOCKET_NAME\f[R].
.PP
\ \ \ \ \f[B]localfilesystem\f[R]:\f[B]UNIX_DOMAIN_SOCKET_NAME\f[R].
.PP
\ \ \ \ \f[B]jdwp\f[R]:\f[B]PROCESS PID\f[R] (فقط راه دور).
.PP
\ \ \ \ \f[B]vsock\f[R]:\f[B]CID\f[R]:\f[B]PORT\f[R] (فقط راه دور).
.PP
\ \ \ \ \f[B]acceptfd\f[R]:\f[B]FD\f[R] (فقط شنود).
.PP
\ \ \ \ \f[B]dev\f[R]:\f[B]DEVICE_NAME\f[R].
.PP
\ \ \ \ \f[B]dev-raw\f[R]:\f[B]DEVICE_NAME\f[R] (باز کردن دستگاه در حالت خام / raw mode).
.PP
\f[B]--remove\f[R] \f[B]LOCAL\f[R] \ \ \ \ حذف یک اتصال سوکت هدایت‌شده خاص.
.PP
\f[B]--remove-all\f[R] \ \ \ \ حذف تمام اتصالات سوکت هدایت‌شده.
.PP
reverse \f[B]--list\f[R] | [\f[B]--no-rebind\f[R]] \f[B]REMOTE\f[R] \f[B]LOCAL\f[R] | \f[B]--remove\f[R] \f[B]REMOTE\f[R] | \f[B]--remove-all\f[R]
.PP
\f[B]--list\f[R] \ \ \ \ فهرست کردن تمام اتصالات سوکت معکوس (reverse socket) از دستگاه.
.PP
[\f[B]--no-rebind\f[R]] \f[B]REMOTE\f[R] \f[B]LOCAL\f[R] \ \ \ \ اتصال سوکت معکوس با استفاده از یکی از موارد زیر:
.PP
\ \ \ \ tcp:\f[B]PORT\f[R] (مقدار \f[B]REMOTE\f[R] می‌تواند «tcp:0» باشد تا هر درگاه آزادی انتخاب شود).
.PP
\ \ \ \ localabstract:\f[B]UNIX_DOMAIN_SOCKET_NAME\f[R].
.PP
\ \ \ \ localreserved:\f[B]UNIX_DOMAIN_SOCKET_NAME\f[R].
.PP
\ \ \ \ localfilesystem:\f[B]UNIX_DOMAIN_SOCKET_NAME\f[R].
.PP
\f[B]--remove\f[R] \f[B]REMOTE\f[R] \ \ \ \ حذف یک اتصال سوکت معکوس خاص.
.PP
\f[B]--remove-all\f[R] \ \ \ \ حذف تمام اتصالات سوکت معکوس از دستگاه.
.PP
mdns \f[B]check\f[R] | \f[B]services\f[R] \ \ \ \ اجرای زیردستورهای mDNS.
.PP
\f[B]check\f[R] \ \ \ \ بررسی در دسترس بودن قابلیت کشف mDNS.
.PP
\f[B]services\f[R] \ \ \ \ فهرست کردن تمام سرویس‌های کشف‌شده.
.PP
\f[B]track-services\f[R] \ \ \ \ استریم سرویس‌های کشف‌شده. از فلگ‌های «--proto-text» و «--proto-binary» پشتیبانی می‌کند.
.PP
\f[B]list-known-hosts\f[R] \ \ \ \ نمایش دستگاه‌های جفت‌شده با ADB از طریق Wi-Fi. از فلگ‌های «--proto-text» و «--proto-binary» پشتیبانی می‌کند.
.SH "انتقال فایل (FILE TRANSFER)"
.PP
push [\f[B]--sync\f[R]] [\f[B]-z\f[R] \f[B]ALGORITHM\f[R]] [\f[B]-Z\f[R]] \f[B]LOCAL\f[R]\&... \f[B]REMOTE\f[R] \ \ \ \ کپی کردن فایل‌ها/دایرکتوری‌های محلی به دستگاه.
.PP
\f[B]--sync\f[R] \ \ \ \ انتقال فایل‌هایی که روی میزبان جدیدتر از دستگاه هستند.
.PP
\f[B]-n\f[R] \ \ \ \ اجرای آزمایشی (dry run)؛ ارسال فایل‌ها به دستگاه بدون ذخیره در سیستم‌فایل.
.PP
\f[B]-z\f[R] \ \ \ \ فعال‌سازی فشرده‌سازی با الگوریتم مشخص‌شده (any/none/brotli/lz4/zstd).
.PP
\f[B]-Z\f[R] \ \ \ \ غیرفعال‌سازی فشرده‌سازی.
.PP
pull [\f[B]-a\f[R]] [\f[B]-z\f[R] \f[B]ALGORITHM\f[R]] [\f[B]-Z\f[R]] \f[B]REMOTE\f[R]\&... \f[B]LOCAL\f[R] \ \ \ \ کپی کردن فایل‌ها/دایرکتوری‌ها از دستگاه.
.PP
\f[B]-a\f[R] \ \ \ \ حفظ زمان‌بندی (timestamp) و حالت فایل (mode).
.PP
\f[B]-z\f[R] \ \ \ \ فعال‌سازی فشرده‌سازی با الگوریتم مشخص‌شده (\f[B]any\f[R]/\f[B]none\f[R]/\f[B]brotli\f[R]/\f[B]lz4\f[R]/\f[B]zstd\f[R]).
.PP
\f[B]-Z\f[R] \ \ \ \ غیرفعال‌سازی فشرده‌سازی.
.PP
sync [\f[B]-l\f[R]] [\f[B]-z\f[R] \f[B]ALGORITHM\f[R]] [\f[B]-Z\f[R]] [\f[B]all\f[R]|\f[B]data\f[R]|\f[B]odm\f[R]|\f[B]oem\f[R]|\f[B]product\f[R]|\f[B]system\f[R]|\f[B]system_ext\f[R]|\f[B]vendor\f[R]] \ \ \ \ همگام‌سازی ساخت محلی از $ANDROID_PRODUCT_OUT با دستگاه [پیش‌فرض all].
.PP
\f[B]-n\f[R] \ \ \ \ اجرای آزمایشی؛ ارسال فایل‌ها به دستگاه بدون ذخیره در سیستم‌فایل.
.PP
\f[B]-l\f[R] \ \ \ \ فهرست کردن فایل‌هایی که کپی خواهند شد، بدون انجام عملیات کپی.
.PP
\f[B]-z\f[R] \ \ \ \ فعال‌سازی فشرده‌سازی با الگوریتم مشخص‌شده (\f[B]any\f[R]/\f[B]none\f[R]/\f[B]brotli\f[R]/\f[B]lz4\f[R]/\f[B]zstd\f[R]).
.PP
\f[B]-Z\f[R] \ \ \ \ غیرفعال‌سازی فشرده‌سازی.
.SH "پوسته (SHELL)"
.PP
shell [\f[B]-e\f[R] \f[B]ESCAPE\f[R]] [\f[B]-n\f[R]] [\f[B]-Tt\f[R]] [\f[B]-x\f[R]] [\f[B]COMMAND\f[R]\&...] \ \ \ \ اجرای دستور پوسته از راه دور (در صورت عدم مشخص شدن دستور، پوسته تعاملی اجرا می‌شود).
.PP
\f[B]-e\f[R] \ \ \ \ انتخاب نویسه گریز (escape character) یا «\f[B]none\f[R]»؛ پیش‌فرض `\f[B]~\f[R]'.
.PP
\f[B]-n\f[R] \ \ \ \ عدم خواندن از stdin.
.PP
\f[B]-T\f[R] \ \ \ \ غیرفعال‌سازی تخصیص pty.
.PP
\f[B]-t\f[R] \ \ \ \ تخصیص pty در صورت استفاده از tty (استفاده از \f[B]-tt\f[R] تخصیص pty را اجباری می‌کند).
.PP
\f[B]-x\f[R] \ \ \ \ غیرفعال‌سازی کدهای خروج از راه دور و جداسازی stdout/stderr.
.PP
emu \f[B]COMMAND\f[R] \ \ \ \ اجرای دستور در کنسول شبیه‌ساز (\f[B]COMMAND\f[R]).
.SH "نصب برنامه (APP INSTALLATION)"
.PP
(همچنین دستور \f[B]adb shell cmd package help\f[R] را ببینید):
.PP
install [\f[B]-lrtsdg\f[R]] [\f[B]--instant\f[R]] \f[B]PACKAGE\f[R] \ \ \ \ ارسال یک بسته منفرد به دستگاه و نصب آن.
.PP
install-multiple [\f[B]-lrtsdpg\f[R]] [\f[B]--instant\f[R]] \f[B]PACKAGE\f[R]\&... \ \ \ \ ارسال چندین APK به دستگاه برای یک بسته واحد و نصب آن‌ها.
.PP
install-multi-package [\f[B]-lrtsdpg\f[R]] [\f[B]--instant\f[R]] \f[B]PACKAGE\f[R]\&... \ \ \ \ ارسال یک یا چند بسته به دستگاه و نصب یکپارچه و اتمیک (atomic) آن‌ها.
.PP
\f[B]-r\f[R] \ \ \ \ جایگزینی برنامه موجود.
.PP
\f[B]-t\f[R] \ \ \ \ مجاز شمردن بسته‌های آزمایشی (test packages).
.PP
\f[B]-d\f[R] \ \ \ \ اجازه بازگشت به نسخه پایین‌تر / دان‌گرید (تنها برای بسته‌های قابل اشکال‌زدایی).
.PP
\f[B]-p\f[R] \ \ \ \ نصب جزئی برنامه (تنها برای install-multiple).
.PP
\f[B]-g\f[R] \ \ \ \ اعطای تمام مجوزهای زمان اجرا (runtime permissions).
.PP
\f[B]--abi\f[R] \f[B]ABI\f[R] \ \ \ \ بازنویسی ABI پیش‌فرض پلتفرم.
.PP
\f[B]--instant\f[R] \ \ \ \ نصب برنامه به عنوان برنامه گذرا و لحظه‌ای (instant app).
.PP
\f[B]--no-streaming\f[R] \ \ \ \ ارسال فایل APK به دستگاه و فراخوانی Package Manager به صورت مراحل جداگانه.
.PP
\f[B]--streaming\f[R] \ \ \ \ استریم مستقیم و اجباری APK به درون Package Manager.
.PP
\f[B]--fastdeploy\f[R] \ \ \ \ استفاده از استقرار سریع (fast deploy).
.PP
\f[B]-no-fastdeploy\f[R] \ \ \ \ جلوگیری از استفاده از استقرار سریع.
.PP
\f[B]-force-agent\f[R] \ \ \ \ اجبار به به‌روزرسانی عامل استقرار هنگام استفاده از استقرار سریع.
.PP
\f[B]-date-check-agent\f[R] \ \ \ \ به‌روزرسانی عامل استقرار در صورتی که نسخه محلی جدیدتر باشد (هنگام استفاده از استقرار سریع).
.PP
\f[B]--version-check-agent\f[R] \ \ \ \ به‌روزرسانی عامل استقرار در صورتی که نسخه محلی کد نسخه متفاوتی داشته باشد (هنگام استفاده از استقرار سریع).
.PP
\f[B]--local-agent\f[R] \ \ \ \ مکان‌یابی فایل‌های عامل از ساخت سورس محلی (به جای مسیر SDK).
.PP
برای گزینه‌های بیشتر همچنین \f[B]adb shell pm help\f[R] را ببینید.
.PP
uninstall [\f[B]-k\f[R]] \f[B]APPLICATION_ID\f[R] \ \ \ \ حذف این \f[B]APPLICATION_ID\f[R] از روی دستگاه.
.PP
\f[B]-k\f[R] \ \ \ \ حفظ دایرکتوری‌های داده (data) و حافظه نهان (cache).
.SH "اشکال‌زدایی (DEBUGGING)"
.PP
bugreport [\f[B]PATH\f[R]] \ \ \ \ نوشتن گزارش اشکال (bugreport) در مسیر مشخص‌شده \f[B]PATH\f[R] [پیش‌فرض=bugreport.zip]؛ در صورتی که \f[B]PATH\f[R] یک دایرکتوری باشد، گزارش در آن دایرکتوری ذخیره می‌شود. دستگاه‌هایی که از گزارش باگ با فرمت zip پشتیبانی نمی‌کنند، خروجی را در stdout چاپ می‌کنند.
.PP
jdwp \ \ \ \ فهرست کردن شناسه فرآیندهایی (pid) که میزبان انتقال JDWP هستند.
.PP
logcat \ \ \ \ نمایش لاگ دستگاه (برای اطلاعات بیشتر \f[B]logcat --help\f[R] را ببینید).
.PP
server-status \ \ \ \ نمایش پیکربندی کارساز (بک‌اند USB، بک‌اند mDNS، مسیر فایل لاگ، مسیر فایل اجرایی). برای جزئیات به adb_host.proto (AdbServerStatus) مراجعه کنید.
.SH "امنیت (SECURITY)"
.PP
disable-verity \ \ \ \ غیرفعال‌سازی بررسی dm-verity در ساخت‌های userdebug.
.PP
enable-verity \ \ \ \ فعال‌سازی مجدد بررسی dm-verity در ساخت‌های userdebug.
.PP
keygen \f[B]FILE\f[R] \ \ \ \ تولید جفت‌کلید عمومی/خصوصی adb؛ کلید خصوصی در \f[B]FILE\f[R] ذخیره می‌شود.
.SH "اسکریپت‌نویسی (SCRIPTING)"
.PP
wait-for [-\f[B]TRANSPORT\f[R]] -\f[B]STATE\f[R]\&... \ \ \ \ انتظار برای قرار گرفتن دستگاه در یک وضعیت مشخص.
.PP
\ \ \ \ \f[B]STATE\f[R]: device، recovery، rescue، sideload، bootloader یا disconnect.
.PP
\ \ \ \ \f[B]TRANSPORT\f[R]: \f[B]usb\f[R]، \f[B]local\f[R] یا \f[B]any\f[R] [پیش‌فرض=\f[B]any\f[R]].
.PP
get-state \ \ \ \ چاپ وضعیت فعلی (offline | bootloader | device).
.PP
get-serialno \ \ \ \ چاپ شماره سریال (\f[B]SERIAL_NUMBER\f[R]).
.PP
get-devpath \ \ \ \ چاپ مسیر دستگاه (\f[B]DEVICE_PATH\f[R]).
.PP
remount [\f[B]-R\f[R]] \ \ \ \ سوار کردن مجدد (remount) پارتیشن‌ها به صورت خواندن/نوشتن.
.PP
\f[B]-R\f[R] \ \ \ \ راه‌اندازی مجدد (reboot) خودکار دستگاه.
.PP
reboot [\f[B]bootloader\f[R]|\f[B]recovery\f[R]|\f[B]sideload\f[R]|\f[B]sideload-auto-reboot\f[R]] \ \ \ \ راه‌اندازی مجدد دستگاه؛ پیش‌فرض بوت سیستم‌عامل است، اما از \f[B]bootloader\f[R] و \f[B]recovery\f[R] نیز پشتیبانی می‌شود.
.PP
\f[B]sideload\f[R] \ \ \ \ راه‌اندازی مجدد به محیط بازیابی (recovery) و شروع خودکار حالت sideload.
.PP
\f[B]sideload-auto-reboot\f[R] \ \ \ \ مشابه \f[B]sideload\f[R]، اما پس از سایدلود، دستگاه را مجدداً راه‌اندازی می‌کند.
.PP
sideload \f[B]OTAPACKAGE\f[R] \ \ \ \ سایدلود کردن بسته کامل OTA مشخص‌شده (\f[B]OTAPACKAGE\f[R]).
.PP
root \ \ \ \ راه‌اندازی مجدد adbd با مجوزهای ریشه (root).
.PP
unroot \ \ \ \ راه‌اندازی مجدد adbd بدون مجوزهای ریشه.
.PP
usb \ \ \ \ راه‌اندازی مجدد adbd با گوش دادن روی رابط USB.
.PP
tcpip \f[B]PORT\f[R] \ \ \ \ راه‌اندازی مجدد adbd با گوش دادن روی TCP در درگاه \f[B]PORT\f[R].
.SH "اشکال‌زدایی داخلی (INTERNAL DEBUGGING)"
.PP
start-server \ \ \ \ اطمینان از در حال اجرا بودن کارساز.
.PP
kill-server \ \ \ \ بستن و متوقف کردن کارساز در صورت در حال اجرا بودن.
.PP
reconnect \ \ \ \ بستن اتصال از سمت میزبان (host) برای اجبار به برقراری مجدد ارتباط.
.PP
reconnect device \ \ \ \ بستن اتصال از سمت دستگاه برای اجبار به برقراری مجدد ارتباط.
.PP
reconnect offline \ \ \ \ بازنشانی دستگاه‌های آفلاین/غیرمجاز برای اجبار به برقراری مجدد ارتباط.
.SH "یواس‌بی (USB)"
.PP
تنها هنگام اجرا با بک‌اند libusb معتبر است.
.PP
attach \f[B]SERIAL\f[R] \ \ \ \ اتصال مجدد یک دستگاه USB جداشده که با شماره \f[B]SERIAL\f[R] آن مشخص می‌شود.
.PP
detach \f[B]SERIAL\f[R] \ \ \ \ جدا کردن یک دستگاه USB مشخص‌شده با شماره \f[B]SERIAL\f[R] برای امکان استفاده توسط فرآیندهای دیگر.
.SH "قابلیت‌ها (FEATURES)"
.PP
host-features \ \ \ \ فهرست کردن قابلیت‌های پشتیبانی‌شده توسط کارساز adb.
.PP
features \ \ \ \ فهرست کردن قابلیت‌های پشتیبانی‌شده توسط هر دو مورد کارساز adb و دستگاه.
.SH "متغیرهای محیطی (ENVIRONMENT VARIABLES)"
.PP
$ADB_TRACE \ \ \ \ فهرستی از اطلاعات اشکال‌زدایی جداشده با کاما (یا فاصله) جهت ثبت در لاگ:
all,adb,sockets,packets,rwx,usb,sync,sysdeps,transport,jdwp,services,auth,fdevent,shell,incremental,mdns,mdns-stack.
.PP
$ADB_VENDOR_KEYS \ \ \ \ فهرستی از کلیدها جداشده با دونقطه (فایل‌ها یا دایرکتوری‌ها).
.PP
$ANDROID_SERIAL \ \ \ \ شماره سریال دستگاه برای اتصال (گزینه \f[B]-s\f[R] را ببینید).
.PP
$ANDROID_LOG_TAGS \ \ \ \ برچسب‌های مورد استفاده توسط logcat (راهنمای \f[B]logcat --help\f[R] را ببینید).
.PP
$ADB_LOCAL_TRANSPORT_MAX_PORT \ \ \ \ حداکثر درگاه پویش شبیه‌ساز (پیش‌فرض 5585، برای ۱۶ شبیه‌ساز).
.PP
$ADB_MDNS_AUTO_CONNECT \ \ \ \ فهرستی از سرویس‌های mdns جداشده با کاما برای اتصال خودکار (پیش‌فرض adb-tls-connect).
.PP
$ADB_MDNS_OPENSCREEN \ \ \ \ بک‌اند پیش‌فرض mDNS-SD نرم‌افزار Bonjour (یا mdnsResponder) است. در سیستم‌هایی که Bonjour نصب نیست، adb می‌تواند بک‌اند توکار اختصاصی خود بنام openscreen را اجرا کند. در صورت تنظیم روی «1»، این متغیر محیطی بک‌اند mDNS را به openscreen اجبار می‌کند.
.PP
$ADB_LIBUSB \ \ \ \ ابزار ADB پیاده‌سازی بک‌اند USB اختصاصی خود را دارد اما می‌تواند از libusb نیز استفاده کند. برای شناسایی اینکه کدام بک‌اند در حال استفاده است از \f[B]adb devices -l\f[R] (پیشوند \f[B]usb:\f[R] برای libusb حذف می‌شود) یا \f[B]adb host-features\f[R] (جستجوی \f[B]libusb\f[R] در فهرست خروجی) استفاده کنید. برای لغو حالت پیش‌فرض در سیستم‌عامل خود، \f[B]ADB_LIBUSB\f[R] را روی «1» (برای فعال‌سازی libusb) یا «0» (برای فعال‌سازی پیاده‌سازی بک‌اند ADB) تنظیم کنید.
.SH "باگ‌ها (BUGS)"
.PP
سامانه پیگیری باگ‌ها را ببینید:
.UR https://issuetracker.google.com/issues/new?component=192795&template=1310483
اینجا
