.TH ecryptfs-generate-tpm-key 1 2008-07-21 ecryptfs-utils "eCryptfs"
.SH "نام (NAME)"
ecryptfs-generate-tpm-key \- تولید کلید eCryptfs برای سخت‌افزار TPM

.SH "خلاصه دستور (SYNOPSIS)"
\fBecryptfs-generate-tpm-key \-p PCR \fP [\-p PCR]...

.SH "توضیحات (DESCRIPTION)"
دستور
\fBecryptfs-generate-tpm-key\fP
ابزاری برای تولید یک کلید مهروموم‌سازی (ذخیره‌سازی) متصل به مجموعه‌ای مشخص از مقادیر PCR در ثبات‌های PCR ماژول TPM فعلی است.

.SH "مثال‌ها (EXAMPLES)"
ecryptfs-generate-tpm-key \-p 0 \-p 2 \-p 3

.SH "همچنین ببینید (SEE ALSO)"
.PD 0
.TP
\fBecryptfs\fP(7)

.TP
\fI/usr/share/doc/ecryptfs-utils/ecryptfs-faq.html\fP

.TP
\fIhttp://ecryptfs.org\fP
.PD

