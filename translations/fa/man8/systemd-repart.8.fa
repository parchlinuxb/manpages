.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
systemd-repart \- ابزار خودکار بازپارتیشن‌بندی و رشد پارتیشن‌های دیسک GPT
.SH "خلاصه دستور (SYNOPSIS)"
.HP \w'\fBsystemd\-repart\fR\ 'u
\fBsystemd\-repart\fR [OPTIONS...] [BLOCKDEVICE]
.PP
systemd\-repart\&.service
.SH "توضیحات (DESCRIPTION)"
.PP
\fBsystemd\-repart\fR
بر اساس فایل‌های پیکربندی شرح داده شده در
\fBrepart.d\fR(5)،
جدول‌های پارتیشن را ایجاد می‌کند و پارتیشن‌ها را اضافه می‌نماید یا گسترش می‌دهد\&. این ابزار بر روی دستگاه بلوکی یا فایل ایمیج مشخص‌شده در خط فرمان عمل می‌کند\&.
.PP
\fBsystemd\-repart\fR
هنگام
\fIساخت\fR
ایمیج‌های سیستم‌عامل و همچنین هنگام
\fIاستقرار\fR
ایمیج‌ها برای تطبیق خودکار آن‌ها در حین بوت با سیستمی که روی آن اجرا می‌شوند، به کار می‌رود\&. از این طریق ایمیج می‌تواند از نظر اندازه کمینه باشد و در حین بوت به‌طور خودکار افزایش یافته و فضای دیسک در دسترس را در اختیار بگیرد\&.
.PP
اگر بدون هیچ آرگومانی فراخوانی شود،
\fBsystemd\-repart\fR
روی دستگاه بلوکی پشتیبان پارتیشن فایل‌سیستم ریشه سیستم‌عامل در حال اجرا عمل می‌کند و بدین ترتیب پارتیشن‌های خود سیستم‌عامل بوت‌شده را اضافه کرده و گسترش می‌دهد\&. هنگامی که در initrd فراخوانی شود، در عوض روی دستگاه بلوکی پشتیبان
/sysroot/
عمل می‌کند، یعنی روی دستگاه بلوکی که سیستم به زودی به آن منتقل خواهد شد\&. اگر
\fI\-\-image=\fR
استفاده شود، روی دستگاه یا فایل ایمیج مشخص‌شده عمل خواهد کرد\&. سرویس
systemd\-repart\&.service
معمولاً در حین بوت در initrd اجرا می‌شود تا جدول پارتیشن سیستم‌عامل را پیش از سوار شدن (mount) پارتیشن‌های آن گسترش دهد\&.
.PP
اگر دستگاه بلوکی به صورت
"\-"
(یا به عنوان یک رشته خالی) مشخص شود،
\fBsystemd\-repart\fR
روی هیچ دستگاه بلوکی یا فایل ایمیجی عمل نخواهد کرد و در عوض با در نظر گرفتن تمام محدودیت‌های اندازه پیکربندی‌شده، حداقل اندازه دیسک/ایمیج را برای پیکربندی پارتیشن مشخص‌شده تعیین کرده و خروجی می‌دهد\&.
.PP
عملیات‌های
\fBsystemd\-repart\fR
عمدتاً افزایشی هستند: این ابزار پارتیشن‌های موجود را گسترش می‌دهد یا پارتیشن‌های جدید اضافه می‌کند، اما پارتیشن‌های موجود را کوچک، حذف یا جابه‌جا نمی‌کند\&. این سرویس برای اجرا در هر بار بوت در نظر گرفته شده است، اما هنگامی که تشخیص دهد جدول پارتیشن از قبل با فایل‌های پیکربندی نصب‌شده
repart\&.d/*\&.conf
مطابقت دارد، هیچ عملیاتی انجام نمی‌دهد\&.
.PP
موارد کاربرد زیر از جمله مواردی هستند که پوشش داده شده‌اند:
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
پارتیشن ریشه ممکن است رشد داده شود تا کل فضای دیسک موجود را پوشش دهد\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
یک پارتیشن
/home/، swap
یا
/srv/
می‌تواند اضافه شود\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
یک پارتیشن ریشه دوم (یا سوم و \&...) ممکن است اضافه شود تا ساختارهای به سبک A/B را پوشش دهد که در آن‌ها نسخه دوم فایل‌سیستم ریشه به طور متناوب برای پیاده‌سازی طرح‌های به‌روزرسانی استفاده می‌شود\&. ایمیج مستقر شده تنها حامل یک پارتیشن ("A") خواهد بود، اما در اولین بوت، پارتیشن دوم ("B") برای این منظور به‌طور خودکار ایجاد می‌شود\&.
.RE
.PP
الگوریتم اجرا شده توسط
\fBsystemd\-repart\fR
تقریباً به شرح زیر است:
.sp
.RS 4
.ie n \{\
\h'-04' 1.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  1." 4.2
.\}
فایل‌های پیکربندی
repart\&.d/*\&.conf
بارگیری و تجزیه شده و بر اساس نام فایل (بدون پیشوند پوشه) مرتب می‌شوند\&. برای هر فایل پیکربندی، فایل‌های قطره‌ای (drop\-in) از پوشه‌هایی با همان نام فایل پیکربندی به همراه پسوند "\&.d" بارگیری می‌شوند\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04' 2.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  2." 4.2
.\}
جدول پارتیشن روی دستگاه بلوکی، در صورت وجود، بارگیری و تجزیه می‌شود\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04' 3.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  3." 4.2
.\}
پارتیشن‌های موجود در جدول پارتیشن بر اساس UUID نوع پارتیشن GPT با فایل‌های
repart\&.d/*\&.conf
مطابقت داده می‌شوند\&. به نخستین پارتیشن موجود از یک نوع خاص، نخستین فایل پیکربندی که همان نوع را اعلان کرده اختصاص داده می‌شود\&. سپس به دومین پارتیشن موجود از یک نوع خاص، دومین فایل پیکربندی اعلان‌کننده همان نوع اختصاص می‌یابد و به همین ترتیب\&. پس از تکمیل این انتساب تکرارشونده، هر پارتیشن موجودی که هیچ فایل پیکربندی منطبقی نداشته باشد "بیگانه" (foreign) در نظر گرفته شده و به همان صورت رها می‌شود\&. و هر فایل پیکربندی که هیچ پارتیشنی با آن مطابقت داده نشده باشد، به عنوان درخواستی برای ایجاد یک پارتیشن در نظر گرفته می‌شود\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04' 4.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  4." 4.2
.\}
اکنون پارتیشن‌هایی که باید ایجاد شوند با در نظر گرفتن محدودیت‌های اندازه و وزن‌های اعلان‌شده در فایل‌های پیکربندی، روی دیسک تخصیص می‌یابند\&. فضای خالی در محدوده تعیین‌شده توسط درخواست‌های اندازه و لایه‌گذاری (padding) استفاده می‌شود\&. علاوه بر این، پارتیشن‌های موجودی که باید رشد کنند، گسترش می‌یابند\&. پارتیشن‌های جدید همیشه به انتهای جدول پارتیشن الحاق می‌شوند و نخستین شیار (slot) جدول پارتیشن را که نمایه (index) آن از نمایه‌های تمام پارتیشن‌های موجود بزرگ‌تر است به خود اختصاص می‌دهند\&. پارتیشن‌ها هرگز بازآرایی نمی‌شوند و بنابراین شماره‌های پارتیشن پایدار می‌مانند\&. هنگامی که پارتیشن‌ها ایجاد می‌شوند، در کوچک‌ترین بخش از فضای خالی که برای برآوردن محدودیت‌های اندازه و لایه‌گذاری به اندازه کافی بزرگ باشد، قرار می‌گیرند\&. این بدان معناست که ترتیب پارتیشن‌ها روی دیسک ممکن است با جدول پارتیشن متفاوت باشد\&. توجه داشته باشید که این تخصیص تنها در حافظه رخ می‌دهد و جدول پارتیشن روی دیسک هنوز به‌روزرسانی نشده است\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04' 5.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  5." 4.2
.\}
به تمام پارتیشن‌های موجودی که فایل‌های پیکربندی برای آن‌ها وجود دارد و در حال حاضر برچسب پارتیشن GPT ندارند، یک برچسب اختصاص داده می‌شود؛ یا به‌طور صریح در پیکربندی تنظیم شده است یا \(en در صورت عدم وجود \(en به‌طور خودکار از نوع پارتیشن مشتق می‌شود\&. همین کار برای تمام پارتیشن‌هایی که تازه ایجاد شده‌اند نیز انجام می‌پذیرد\&. این انتساب‌ها نیز تنها در حافظه انجام می‌شوند و دیسک هنوز به‌روزرسانی نشده است\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04' 6.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  6." 4.2
.\}
به طور مشابه، به تمام پارتیشن‌های موجودی که فایل‌های پیکربندی برای آن‌ها وجود دارد و در حال حاضر UUID شناسایی کاملاً صفر دارند، یک UUID جدید اختصاص داده می‌شود\&. این UUID به روش رمزنگاری از یک مقدار بذر (seed) مشترک به همراه UUID نوع پارتیشن (و یک شمارنده در صورتی که چندین پارتیشن از یک نوع تعریف شده باشند) هش می‌شود، به بخش زیر مراجعه کنید\&. همین کار برای تمام پارتیشن‌هایی که از نو ایجاد می‌شوند نیز انجام می‌پذیرد\&. این انتساب‌ها نیز فقط در حافظه انجام می‌شوند و دیسک هنوز به‌روزرسانی نشده است\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04' 7.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  7." 4.2
.\}
به طور مشابه، اگر UUID حجم (volume UUID) دیسک کاملاً صفر باشد، مقداردهی اولیه می‌شود که آن نیز از همان مقدار بذر مشترک به روش رمزنگاری هش می‌گردد\&. این کار نیز صرفاً در حافظه انجام می‌شود\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04' 8.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  8." 4.2
.\}
فضای دیسک اختصاص‌یافته به پارتیشن‌های جدید (یعنی آنچه قبلاً فضای خالی بود) اکنون پاک می‌شود\&. به‌طور مشخص، تمام امضاهای فایل‌سیستم حذف می‌شوند و در صورتی که دستگاه از آن پشتیبانی کند، دستور کنترل ورودی/خروجی
\fBBLKDISCARD\fR
صادر می‌شود تا به سخت‌افزار اطلاع دهد که فضا اکنون خالی است\&. علاوه بر این، هرگونه "لایه‌گذاری" بین پارتیشن‌ها و در انتهای دستگاه نیز به طور مشابه پاک می‌شود\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04' 9.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  9." 4.2
.\}
در نهایت، جدول پارتیشن جدید روی دیسک نوشته می‌شود\&. از کرنل خواسته می‌شود تا جدول پارتیشن را بازخوانی کند\&.
.RE
.PP
به عنوان یک استثنا در عملکرد افزایشی معمول، هنگامی که
\fBsystemd\-repart\fR
در حالت ویژه "بازنشانی به تنظیمات کارخانه" (factory reset) فراخوانی شود، ممکن است برای پاک کردن پارتیشن‌های موجود جهت بازنشانی یک نصب به پیش‌فرض‌های سازنده استفاده شود\&. این حالت عملکرد زمانی استفاده می‌شود که سوئیچ
\fB\-\-factory\-reset=yes\fR
در خط فرمان ابزار ارسال شود، یا گزینه
\fBsystemd\&.factory_reset=yes\fR
در خط فرمان کرنل مشخص گردد، یا متغیر EFI با نام
\fIFactoryResetRequest\fR
(با UUID سازنده
\fB8cf2644b\-4b0b\-428f\-9387\-6d876050dc67\fR)
روی "yes" تنظیم شده باشد\&. این حالت الگوریتم فوق را اندکی تغییر می‌دهد: بین گام ۳ و ۴ بالا، هر پارتیشنی که به طور صریح از طریق مقدار بولی
\fIFactoryReset=\fR
علامت‌گذاری شده باشد حذف می‌شود و الگوریتم مجدداً راه‌اندازی می‌گردد، و بدین ترتیب فوراً این پارتیشن‌ها از نو به صورت خالی ایجاد می‌شوند\&.
.PP
توجه داشته باشید که
\fBsystemd\-repart\fR
به‌طور پیش‌فرض تنها جدول‌های پارتیشن را تغییر می‌دهد و هیچ فایل‌سیستمی را در این پارتیشن‌ها ایجاد نکرده یا اندازه آن را تغییر نمی‌دهد، مگر اینکه گزینه پیکربندی
\fIFormat=\fR
مشخص شده باشد\&. همچنین توجه داشته باشید که سازوکارهای جداگانه‌ای نیز برای این منظور در دسترس هستند، برای نمونه
\fBsystemd-growfs\fR(8)
و
\fBsystemd\-makefs\fR\&.
.PP
شناسه‌های UUID مشخص‌کننده پارتیشن‌های جدید ایجاد شده (یا اختصاص‌یافته به پارتیشن‌های موجود که هنوز UUID ندارند)، و همچنین کل دیسک به عنوان یک کل، به روش رمزنگاری از یک مقدار بذر (seed) مشترک هش می‌شوند\&. این مقدار بذر معمولاً
\fBmachine-id\fR(5)
سیستم است، به طوری که شناسه ماشین به شکل تکرارپذیر UUIDهای اختصاص‌یافته به تمام پارتیشن‌ها را تعیین می‌کند\&. اگر شناسه ماشین قابل خواندن نباشد (یا کاربر
\fB\-\-seed=random\fR
را ارسال کند، به زیر مراجعه کنید) بذر در عوض به طور تصادفی تولید می‌شود تا UUIDهای پارتیشن نیز در عمل تصادفی باشند\&. مقدار بذر همچنین ممکن است به‌طور صریح و در قالب یک UUID از طریق گزینه
\fB\-\-seed=\fR
تنظیم شود\&. با هش کردن این UUIDها از یک بذر مشترک، ایمیج‌های آماده‌شده با این ابزار تکرارپذیر شده و نتیجه الگوریتم فوق قطعی (deterministic) خواهد بود\&.
.PP
آرگومان مکانی باید دستگاه بلوکی یا یک فایل معمولی را برای انجام عملیات مشخص کند\&. اگر
\fB\-\-empty=create\fR
مشخص شود، مسیر مشخص‌شده به عنوان یک فایل معمولی ایجاد می‌شود که برای تولید ایمیج‌های دیسک از ابتدا مفید است\&.
.SH "گزینه‌ها (OPTIONS)"
.PP
گزینه‌های زیر پشتیبانی می‌شوند:
.PP
\fB\-\-dry\-run=\fR
.RS 4
یک مقدار بولی می‌گیرد\&. اگر این سوئیچ مشخص نشود،
\fB\-\-dry\-run=yes\fR
پیش‌فرض ضمنی است\&. کنترل می‌کند که آیا
systemd\-repart
عملیات‌های بازپارتیشن‌بندی درخواستی را اجرا کند یا تنها باید آنچه را انجام خواهد داد نمایش دهد\&. مگر اینکه
\fB\-\-dry\-run=no\fR
مشخص شود،
systemd\-repart
در واقع به جدول پارتیشن دستگاه دست نخواهد زد\&.
.sp
در نسخه 245 اضافه شد\&.
.RE
.PP
\fB\-\-empty=\fR
.RS 4
یکی از مقادیر
"refuse"،
"allow"،
"require"،
"force"
یا
"create"
را می‌پذیرد\&. نحوه کار روی دستگاه‌های بلوکی کاملاً خالی را کنترل می‌کند، یعنی دستگاه‌هایی که هنوز هیچ جدول پارتیشن/برچسب دیسکی ندارند\&. اگر این سوئیچ مشخص نشود، پیش‌فرض ضمنی
"refuse"
است\&.
.sp
اگر
"refuse"
باشد،
\fBsystemd\-repart\fR
نیازمند آن است که دستگاه بلوکی که قرار است روی آن کار کند از قبل حاوی یک جدول پارتیشن باشد و در صورت یافت نشدن هیچ جدولی، از انجام عملیات خودداری می‌کند\&. اگر
"allow"
باشد، دستور یک جدول پارتیشن موجود را گسترش می‌دهد یا در صورت عدم وجود، یک جدول جدید ایجاد می‌کند\&. اگر
"require"
باشد، دستور در صورتی که تاکنون هیچ جدولی وجود نداشته باشد یک جدول پارتیشن جدید ایجاد می‌کند و اگر از قبل جدولی وجود داشته باشد از انجام عملیات خودداری می‌نماید\&. اگر
"force"
باشد، بدون قید و شرط یک جدول پارتیشن تازه ایجاد می‌کند که در عمل دیسک را به طور کامل پاک می‌سازد\&. در صورت انتخاب
"force"،
هیچ‌یک از پارتیشن‌های موجود در نظر گرفته نشده و از عملیات جان سالم به در نخواهند برد\&. از این رو: با احتیاط استفاده کنید، این یک راه عالی برای از دست دادن تمام داده‌های شماست\&. اگر
"create"
باشد، یک فایل لوپ‌بک (loopback) جدید در مسیری که از طریق پارامتر گره دستگاه ارسال شده ایجاد می‌شود، با اندازه‌ای که با
\fB\-\-size=\fR
نشان داده شده است، به زیر مراجعه کنید\&.
.sp
در نسخه 245 اضافه شد\&.
.RE
.PP
\fB\-\-discard=\fR
.RS 4
یک مقدار بولی می‌گیرد\&. اگر این سوئیچ مشخص نشود،
\fB\-\-discard=yes\fR
پیش‌فرض ضمنی است\&. تعیین می‌کند که آیا دستور کنترل ورودی/خروجی
\fBBLKDISCARD\fR
روی فضای اشغال‌شده توسط هر پارتیشن اضافه‌شده یا روی فضای بین آن‌ها صادر شود یا خیر\&. معمولاً ارسال این درخواست ایده خوبی است زیرا به سخت‌افزار زیرین اطلاع می‌دهد که بلوک‌های پوشش‌داده‌شده باید خالی تلقی شوند و کارایی را بهبود می‌بخشد\&. اگر به جای یک گره دستگاه بلوکی روی یک فایل معمولی عمل شود، یک فایل کم‌پشت (sparse file) تولید می‌شود\&.
.sp
در نسخه 245 اضافه شد\&.
.RE
.PP
\fB\-\-size=\fR
.RS 4
اندازه‌ای را بر حسب بایت می‌گیرد و از پسوندهای معمول K، M، G، T یا مقدار ویژه
"auto"
استفاده می‌کند\&. در صورت استفاده، مسیر گره دستگاه مشخص‌شده باید به یک فایل معمولی ارجاع دهد، که در این صورت پیش از اعمال هرگونه تغییر در جدول پارتیشن، اگر فایل کوچک‌تر باشد به اندازه مشخص‌شده رشد داده می‌شود\&. اگر به صورت
"auto"
مشخص شود، حداقل اندازه برای ایمیج دیسک به‌طور خودکار تعیین می‌شود (یعنی حداقل اندازه‌های تمام پارتیشن‌ها با در نظر گرفتن فضا برای فراداده‌های اضافی جمع می‌شوند)\&. اگر گره مشخص‌شده یک دستگاه بلوکی باشد، این سوئیچ پشتیبانی نمی‌شود\&. اگر فایل از قبل به اندازه مشخص‌شده یا بزرگ‌تر از آن باشد، این سوئیچ هیچ اثری ندارد\&. اندازه مشخص‌شده به‌طور ضمنی به مضارب ۴۰۹۶ گرد می‌شود\&. هنگامی که با
\fB\-\-empty=create\fR
استفاده شود، اندازه اولیه فایل لوپ‌بکی که باید ایجاد شود را مشخص می‌کند\&.
.sp
گزینه
\fB\-\-size=auto\fR
اندازه پارتیشن‌های از قبل موجود را در نظر می‌گیرد\&. با این حال، جداول پارتیشنی را که به طور فشرده بسته‌بندی نشده‌اند پوشش نمی‌دهد: اگر فضای خالی بین پارتیشن‌های از قبل موجود (یا قبل از نخستین پارتیشن) وجود داشته باشد که نتوان آن را کاملاً با پارتیشن‌های در حال رشد یا ایجاد پر کرد، ممکن است پارتیشن‌های پیکربندی‌شده همچنان در دستگاه پشتیبان جا نشوند\&.
.sp
همچنین توجه داشته باشید که تعیین خودکار اندازه، فایل‌ها یا پوشه‌های مشخص‌شده با
\fBCopyFiles=\fR
را در نظر نمی‌گیرد: اگر فایل‌ها یا پوشه‌های مشخص‌شده به فضای دیسک بیشتری نسبت به محدودیت حداقل اندازه پیکربندی‌شده برای هر پارتیشن نیاز داشته باشند، ممکن است عملیات با شکست مواجه شود\&.
.sp
در نسخه 246 اضافه شد\&.
.RE
.PP
\fB\-\-factory\-reset=\fR
.RS 4
یک مقدار بولی می‌گیرد\&. اگر این سوئیچ مشخص نشود،
\fB\-\-factory\-reset=no\fR
پیش‌فرض ضمنی است\&. کنترل می‌کند که آیا در حالت "بازنشانی به تنظیمات کارخانه" عمل شود یا خیر، به بالا مراجعه کنید\&. اگر روی true تنظیم شود، تمام پارتیشن‌های موجود که با
\fIFactoryReset=\fR
روی yes تنظیم شده‌اند در مراحل اولیه اجرای الگوریتم بازپارتیشن‌بندی حذف خواهند شد\&. با احتیاط استفاده کنید، این یک راه عالی برای از دست دادن تمام داده‌های شماست\&. توجه داشته باشید که فایل‌های پارتیشن باید به‌طور صریح
\fIFactoryReset=\fR
را فعال کنند، زیرا این گزینه به‌طور پیش‌فرض غیرفعال است\&. اگر هیچ پارتیشنی برای بازنشانی کارخانه‌ای علامت‌گذاری نشده باشد، این سوئیچ هیچ اثری ندارد\&. توجه داشته باشید که دو روش دیگر نیز برای درخواست عملیات بازنشانی کارخانه‌ای وجود دارد: از طریق خط فرمان کرنل و از طریق یک متغیر EFI، به بالا مراجعه کنید\&.
.sp
در نسخه 245 اضافه شد\&.
.RE
.PP
\fB\-\-can\-factory\-reset\fR
.RS 4
اگر این سوئیچ مشخص شود، دیسک بازپارتیشن‌بندی نمی‌شود\&. در عوض تعیین می‌شود که آیا هیچ‌یک از پارتیشن‌های موجود با
\fIFactoryReset=\fR
علامت‌گذاری شده‌اند یا خیر\&. اگر وجود داشته باشند، ابزار با وضعیت خروج صفر و در غیر این صورت با وضعیت غیرصفر خارج می‌شود\&. این سوئیچ می‌تواند برای تعیین سریع اینکه آیا سیستم در حال اجرا از سازوکار بازنشانی کارخانه‌ای مبتنی بر
\fBsystemd\-repart\fR
پشتیبانی می‌کند یا خیر استفاده شود\&.
.sp
در نسخه 245 اضافه شد\&.
.RE
.PP
\fB\-\-root=\fR
.RS 4
مسیری به یک پوشه می‌گیرد تا به عنوان فایل‌سیستم ریشه هنگام جستجو برای فایل‌های
repart\&.d/*\&.conf،
برای فایل شناسه ماشین جهت استفاده به عنوان بذر و برای فایل‌ها و پوشه‌های مبدأ
\fICopyFiles=\fR
و
\fICopyBlocks=\fR
استفاده شود\&. به‌طور پیش‌فرض هنگام فراخوانی در سیستم معمولی، مقدار پیش‌فرض آن فایل‌سیستم ریشه میزبان
/\
است\&. اگر از initrd فراخوانی شود، مقدار پیش‌فرض آن
/sysroot/
است، به طوری که ابزار روی پیکربندی و شناسه ماشین ذخیره‌شده در فایل‌سیستم ریشه‌ای که سیستم بعداً به آن منتقل می‌شود عمل کند\&.
.sp
برای گزینه‌ای محدودتر که تنها بر
\fICopyFiles=\fR
اثر می‌گذارد، به
\fB\-\-copy\-source=\fR
مراجعه کنید\&.
.sp
در نسخه 245 اضافه شد\&.
.RE
.PP
\fB\-\-image=\fR
.RS 4
مسیری به یک فایل ایمیج دیسک یا دستگاه می‌گیرد تا سوار شده و به روشی مشابه با
\fB\-\-root=\fR
استفاده شود، به بالا مراجعه کنید\&.
.sp
در نسخه 249 اضافه شد\&.
.RE
.PP
\fB\-\-image\-policy=\fR\fB\fIpolicy\fR\fR
.RS 4
یک رشته خط‌مشی ایمیج را مطابق با
\fBsystemd.image-policy\fR(7)
به عنوان آرگومان می‌گیرد\&. این خط‌مشی هنگام کار روی ایمیج دیسک مشخص‌شده از طریق
\fB\-\-image=\fR
اعمال می‌شود، به بالا مراجعه کنید\&. اگر مشخص نشود، به طور پیش‌فرض روی خط‌مشی
"*"،
یعنی استفاده از تمام فایل‌سیستم‌های شناسایی‌شده در ایمیج، قرار می‌گیرد\&.
.RE
.PP
\fB\-\-seed=\fR
.RS 4
یک UUID یا مقدار ویژه
\fBrandom\fR
را به عنوان آرگومان می‌گیرد\&. اگر یک UUID مشخص شود، UUIDهای اختصاص‌یافته به پارتیشن‌ها و خود جدول پارتیشن از طریق هش رمزنگاری از آن مشتق می‌شوند\&. اگر مشخص نشود، تلاش می‌شود تا شناسه ماشین از میزبان (یا به طور دقیق‌تر، پوشه ریشه پیکربندی‌شده از طریق
\fB\-\-root=\fR)
خوانده شده و به عنوان بذر استفاده شود، و در غیر این صورت به یک بذر تصادفی بازمی‌گردد\&. از
\fB\-\-seed=random\fR
برای اجبار به استفاده از یک بذر تصادفی استفاده کنید\&. مشخص کردن صریح بذر ممکن است برای تولید جدول‌های پارتیشن کاملاً تکرارپذیر استفاده شود\&.
.sp
در نسخه 245 اضافه شد\&.
.RE
.PP
\fB\-\-pretty=\fR
.RS 4
یک آرگومان بولی می‌گیرد\&. اگر این سوئیچ مشخص نشود، هنگام فراخوانی از یک ترمینال تعاملی به طور پیش‌فرض فعال و در غیر این صورت غیرفعال است\&. کنترل می‌کند که آیا یک جدول کاربرپسند و نمایه گرافیکی که تغییرات اعمال‌شده را نشان می‌دهد نمایش داده شود یا خیر\&.
.sp
در نسخه 245 اضافه شد\&.
.RE
.PP
\fB\-\-definitions=\fR
.RS 4
یک مسیر در فایل‌سیستم را می‌گیرد\&. در صورت مشخص شدن، فایل‌های
*\&.conf
به جای جستجو در
/usr/lib/repart\&.d/*\&.conf،
/etc/repart\&.d/*\&.conf،
/run/repart\&.d/*\&.conf،
از پوشه مشخص‌شده خوانده می‌شوند\&.
.sp
این پارامتر می‌تواند چندین بار مشخص شود\&.
.sp
در نسخه 245 اضافه شد\&.
.RE
.PP
\fB\-\-key\-file=\fR
.RS 4
یک مسیر در فایل‌سیستم را می‌گیرد\&. کلید رمزگذاری مورد استفاده هنگام راه‌اندازی حجم‌های LUKS2 پیکربندی‌شده با تنظیم
\fIEncrypt=key\-file\fR
در فایل‌های پارتیشن را پیکربندی می‌کند\&. باید به یک فایل معمولی حاوی کلید یا یک سوکت جریانی
\fBAF_UNIX\fR
در فایل‌سیستم ارجاع دهد\&. در حالت دوم، اتصالی به آن برقرار شده و کلید از آن خوانده می‌شود\&. اگر این سوئیچ مشخص نشود و هیچ
\fIKeyFile=\fR
در فایل پارتیشن مشخص نشده باشد، کلید خالی (یعنی کلید با طول صفر) استفاده می‌شود\&. این رفتار برای راه‌اندازی پارتیشن‌های رمزگذاری‌شده در مراحل اولیه اولین بوت که گذرواژه ارائه‌شده توسط کاربر را تنها در مرحله راه‌اندازی بعدی دریافت می‌کنند مفید است\&.
.sp
در نسخه 247 اضافه شد\&.
.RE
.PP
\fB\-\-private\-key=\fR
.RS 4
یک مسیر در فایل‌سیستم یا یک شناسه خاص موتور (engine) یا ارائه‌دهنده (provider) را می‌گیرد\&. کلید امضا را برای استفاده هنگام ایجاد پارتیشن‌های امضای verity با تنظیم
\fIVerity=signature\fR
در فایل‌های پارتیشن پیکربندی می‌کند\&.
.sp
در نسخه 252 اضافه شد\&.
.RE
.PP
\fB\-\-private\-key\-source=\fR
.RS 4
یکی از مقادیر
"file"،
"engine"
یا
"provider"
را می‌پذیرد\&. در دو مورد اخیر، پس از آن نام یک ارائه‌دهنده یا موتور به دنبال دونقطه می‌آید که به منطق "engine" یا "provider" در OpenSSL ارسال خواهد شد\&. نحوه بارگیری کلید خصوصی مورد استفاده هنگام ایجاد پارتیشن‌های امضای verity با تنظیم
\fIVerity=signature\fR
در فایل‌های پارتیشن را پیکربندی می‌کند\&.
.sp
در نسخه 256 اضافه شد\&.
.RE
.PP
\fB\-\-certificate=\fR
.RS 4
یک مسیر در فایل‌سیستم یا یک شناسه خاص ارائه‌دهنده را می‌گیرد\&. گواهی X\&.509 با کدگذاری PEM را برای استفاده هنگام ایجاد پارتیشن‌های امضای verity با تنظیم
\fIVerity=signature\fR
در فایل‌های پارتیشن پیکربندی می‌کند\&.
.sp
در نسخه 252 اضافه شد\&.
.RE
.PP
\fB\-\-certificate\-source=\fR
.RS 4
یکی از مقادیر
"file"
یا
"provider"
را می‌پذیرد\&. در مورد اخیر، پس از آن نام یک ارائه‌دهنده به دنبال دونقطه می‌آید که به منطق "provider" در OpenSSL ارسال خواهد شد\&. نحوه بارگیری گواهی X\&.509 مورد استفاده هنگام ایجاد پارتیشن‌های امضای verity با تنظیم
\fIVerity=signature\fR
در فایل‌های پارتیشن را پیکربندی می‌کند\&.
.sp
در نسخه 257 اضافه شد\&.
.RE
.PP
\fB\-\-join\-signature=\fR
.RS 4
یک تاپل جداشده با دونقطه را مشخص می‌کند که عنصر اول آن هش سطح بالای Verity به صورت هگزادسیمال برای یک پارتیشن
\fIVerity=hash\fR
است، و عنصر دوم آن امضای PKCS7 برای roothash به صورت مسیری به یک فایل امضای کدگذاری‌شده با DER، یا به صورت یک رشته ASCII base64 از یک امضای کدگذاری‌شده با DER دارای پیشوند
"base64:"
است\&. برای استفاده روی یک ایمیج از قبل موجود که با پارامتری مانند
\fB\-\-defer\-partitions=root\-verity\-sig\fR
ایجاد شده است، به منظور امکان‌پذیر ساختن پیاده‌سازی امضای برون‌خط (آفلاین) برای پارتیشن امضای verity\&.
.sp
این یک جایگزین برای امضای برخط (آنلاین) با استفاده از پارامترهایی مانند
\fB\-\-private\-key=\fR
است، برای سیستم‌های ساختی که کلید خصوصی برای امضای نهایی (تولید) در همان زمینه‌ای که محتوا ایجاد می‌شود در دسترس نیست\&.
.sp
در نسخه 258 اضافه شد\&.
.RE
.PP
\fB\-\-tpm2\-device=\fR، \fB\-\-tpm2\-pcrs=\fR
.RS 4
دستگاه TPM2 و فهرست PCRهای مورد استفاده برای حجم‌های LUKS2 پیکربندی‌شده با گزینه
\fIEncrypt=tpm2\fR
را پیکربندی می‌کند\&. این گزینه‌ها همان پارامترهای گزینه‌های هم‌نام در
\fBsystemd-cryptenroll\fR(1)
را می‌پذیرند و تأثیر یکسانی بر پارتیشن‌هایی دارند که ثبت‌نام TPM2 برای آن‌ها درخواست شده است\&.
.sp
در نسخه 248 اضافه شد\&.
.RE
.PP
\fB\-\-tpm2\-device\-key=\fR\fB\fIPATH\fR\fR، \fB\-\-tpm2\-seal\-key\-handle=\fR\fB\fIHANDLE\fR\fR
.RS 4
یک کلید SRK مربوط به TPM2 را برای مقید کردن رمزگذاری به آن پیکربندی می‌کند\&. برای جزئیات در مورد این گزینه به
\fBsystemd-cryptenroll\fR(1)
مراجعه کنید\&.
.sp
در نسخه 255 اضافه شد\&.
.RE
.PP
\fB\-\-tpm2\-public\-key=\fR\fB\fIPATH\fR\fR، \fB\-\-tpm2\-public\-key\-pcrs=\fR\fB\fIPCR\fR\fI[+PCR\&.\&.\&.]\fR\fR
.RS 4
یک خط‌مشی PCR امضاشده TPM2 را برای مقید کردن رمزگذاری به آن پیکربندی می‌کند\&. برای جزئیات در مورد این دو گزینه به
\fBsystemd-cryptenroll\fR(1)
مراجعه کنید\&.
.sp
در نسخه 252 اضافه شد\&.
.RE
.PP
\fB\-\-tpm2\-pcrlock=\fR\fB\fIPATH\fR\fR
.RS 4
یک خط‌مشی pcrlock مربوط به TPM2 را برای مقید کردن رمزگذاری به آن پیکربندی می‌کند\&. برای جزئیات در مورد این گزینه به
\fBsystemd-cryptenroll\fR(1)
مراجعه کنید\&.
.sp
در نسخه 255 اضافه شد\&.
.RE
.PP
\fB\-\-split=\fR\fB\fIBOOL\fR\fR
.RS 4
تولید مصنوعات تفکیک‌شده (split artifacts) را از پارتیشن‌های پیکربندی‌شده با
\fISplitName=\fR
فعال می‌کند\&. در صورت فعال بودن، به ازای هر پارتیشن با
\fISplitName=\fR
تنظیم‌شده، یک فایل خروجی مجزا که تنها حاوی محتویات آن پارتیشن است تولید می‌شود\&. نام فایل خروجی شامل نام فایل لوپ‌بک به همراه پسوند نام پیکربندی‌شده با
\fISplitName=\fR
است\&. اگر نام فایل لوپ‌بک با
"\&.raw"
ختم شود، پسوند به جای آن قبل از پسوند
"\&.raw"
درج می‌شود\&.
.sp
توجه داشته باشید که
\fB\-\-split\fR
مستقل از
\fB\-\-dry\-run\fR
است\&. حتی اگر
\fB\-\-dry\-run\fR
فعال باشد، در صورت فعال بودن
\fB\-\-split\fR
مصنوعات تفکیک‌شده همچنان از یک ایمیج موجود تولید خواهند شد\&.
.sp
در نسخه 252 اضافه شد\&.
.RE
.PP
\fB\-\-include\-partitions=\fR\fB\fIPARTITIONS\fR\fR، \fB\-\-exclude\-partitions=\fR\fB\fIPARTITIONS\fR\fR
.RS 4
این گزینه‌ها مشخص می‌کنند که
\fBsystemd\-repart\fR
باید روی کدام انواع پارتیشن عمل کند\&. اگر
\fB\-\-include\-partitions=\fR
استفاده شود، تمام پارتیشن‌هایی که مشخص نشده‌اند مستثنی می‌شوند\&. اگر
\fB\-\-exclude\-partitions=\fR
استفاده شود، تمام پارتیشن‌هایی که مشخص شده‌اند مستثنی می‌شوند\&. هر دو گزینه یک فهرست جداشده با کاما از UUIDها یا شناسه‌های نوع پارتیشن GPT را می‌پذیرند (به
\fIType=\fR
در
\fBrepart.d\fR(5)
مراجعه کنید)\&.
.sp
در نسخه 253 اضافه شد\&.
.RE
.PP
\fB\-\-defer\-partitions=\fR\fB\fIPARTITIONS\fR\fR
.RS 4
این گزینه مشخص می‌کند که
\fBsystemd\-repart\fR
برای کدام انواع پارتیشن باید به تعویق بیفتد\&. تمام پارتیشن‌هایی که با استفاده از این گزینه به تعویق می‌افتند، همچنان هنگام محاسبه اندازه و آفست‌های سایر پارتیشن‌ها در نظر گرفته می‌شوند، اما در عمل روی ایمیج دیسک نوشته نمی‌شوند\&. اثر خالص این گزینه این است که اگر
\fBsystemd\-repart\fR
را مجدداً بدون این گزینه اجرا کنید، پارتیشن‌های مفقود به‌گونه‌ای اضافه می‌شوند که گویی در اولین اجرای
\fBsystemd\-repart\fR
به تعویق نیفتاده بودند\&.
.sp
در نسخه 253 اضافه شد\&.
.RE
.PP
\fB\-\-defer\-partitions\-empty=yes\fR
.RS 4
این گزینه بسیار شبیه به
\fB\-\-defer\-partitions=\fR
است اما به طور خودکار تمام پارتیشن‌هایی را برای تعویق انتخاب می‌کند که
\fBFormat=empty\fR
در آن‌ها تنظیم شده و برچسب سفارشی پیکربندی نکرده‌اند، یا
\fBLabel=_empty\fR
را تنظیم کرده‌اند\&. این گزینه می‌تواند در ترکیب با
\fB\-\-defer\-partitions=\fR
یا
\fB\-\-defer\-partitions\-factory\-reset=yes\fR
استفاده شود که در این صورت تمام پارتیشن‌های منطبق به تعویق می‌افتند\&.
.sp
در نسخه 259 اضافه شد\&.
.RE
.PP
\fB\-\-defer\-partitions\-factory\-reset=yes\fR
.RS 4
این گزینه بسیار شبیه به
\fB\-\-defer\-partitions=\fR
است اما به طور خودکار تمام پارتیشن‌هایی را برای تعویق انتخاب می‌کند که
\fBFactoryReset=yes\fR
در آن‌ها تنظیم شده است\&. این گزینه می‌تواند در ترکیب با
\fB\-\-defer\-partitions=\fR
یا
\fB\-\-defer\-partitions\-empty=yes\fR
استفاده شود که در این صورت تمام پارتیشن‌های منطبق به تعویق می‌افتند\&.
.sp
در نسخه 259 اضافه شد\&.
.RE
.PP
\fB\-\-sector\-size=\fR\fB\fIBYTES\fR\fR
.RS 4
این گزینه امکان پیکربندی اندازه سکتور ایمیج تولیدشده توسط
\fBsystemd\-repart\fR
را فراهم می‌کند\&. مقداری را می‌گیرد که توانی از
"2"
بین
"512"
و
"4096"
باشد\&. این گزینه هنگام ساخت ایمیج برای دیسک‌هایی که از اندازه سکتور متفاوتی نسبت به دیسکی که ایمیج روی آن تولید می‌شود استفاده می‌کنند، مفید است\&.
.sp
در نسخه 253 اضافه شد\&.
.RE
.PP
\fB\-\-grain\-size=\fR\fB\fIBYTES\fR\fR
.RS 4
این گزینه دانه‌بندی هم‌ترازی (alignment granularity) پارتیشن را هنگام قرار دادن پارتیشن‌ها کنترل می‌کند\&. مقداری با توان ۲ می‌گیرد که حداقل برابر با اندازه سکتور باشد\&. تمام آفست‌های شروع پارتیشن به مضربی از این مقدار به بالا گرد می‌شوند\&. مقدار پیش‌فرض
\fBMAX(4096, sector_size)\fR
است که با هم‌ترازی متعارف ۴ کیبی‌بایت مطابقت دارد\&. تنظیم این گزینه روی
"1M"
هم‌ترازی مناسب برای دستگاه‌های ذخیره‌سازی مدرن را حتی پس از پارتیشن‌های کوچک با اندازه ثابت مانند پارتیشن امضای verity تضمین می‌کند\&.
.sp
در نسخه 261 اضافه شد\&.
.RE
.PP
\fB\-\-architecture=\fR\fB\fIARCH\fR\fR
.RS 4
این گزینه امکان نادیده‌گرفتن و جایگزینی معماری مورد استفاده برای انواع پارتیشن مخصوص معماری را فراهم می‌کند\&. برای نمونه، اگر روی
"arm64"
تنظیم شود، نوع پارتیشن
"root\-x86\-64"
ارجاع‌شده در فایل‌های drop\-in پوشه
repart\&.d/
به طور پویا وصله می‌شود تا در عوض به
"root\-arm64"
ارجاع دهد\&. یکی از مقادیر
"alpha"،
"arc"،
"arm"،
"arm64"،
"ia64"،
"loongarch64"،
"mips\-le"،
"mips64\-le"،
"parisc"،
"ppc"،
"ppc64"،
"ppc64\-le"،
"riscv32"،
"riscv64"،
"s390"،
"s390x"،
"tilegx"،
"x86"
یا
"x86\-64"
را می‌پذیرد\&.
.sp
در نسخه 254 اضافه شد\&.
.RE
.PP
\fB\-\-offline=\fR\fB\fIBOOL\fR\fR
.RS 4
به
\fBsystemd\-repart\fR
دستور می‌دهد تا ایمیج را به صورت آفلاین (برون‌خط) بسازد\&. یک مقدار بولی یا
"auto"
می‌گیرد\&. پیش‌فرض روی
"auto"
است\&. اگر فعال باشد، ایمیج بدون استفاده از دستگاه‌های loop ساخته می‌شود\&. این قابلیت برای ساخت بدون امتیاز ویژه ایمیج‌ها یا زمانی که دستگاه‌های loop در دسترس نیستند مفید است\&. اگر غیرفعال باشد، ایمیج همیشه با استفاده از دستگاه‌های loop ساخته می‌شود\&. اگر
"auto"
باشد،
\fBsystemd\-repart\fR
در صورت امکان ایمیج را به صورت آنلاین می‌سازد و در صورتی که دستگاه‌های loop در دسترس نباشند یا به دلیل نبود مجوزهای لازم نتوان به آن‌ها دسترسی پیدا کرد، به ساخت آفلاین ایمیج برمی‌گردد\&.
.sp
در نسخه 254 اضافه شد\&.
.RE
.PP
\fB\-\-copy\-from=\fR\fB\fIPATH\fR\fR
.RS 4
به
\fBsystemd\-repart\fR
دستور می‌دهد تا تعاریف پارتیشن را از جدول پارتیشن در ایمیج یا دستگاه ارائه‌شده استخراج و ترکیب (synthesize) کند\&. این گزینه می‌تواند چندین بار مشخص شود تا تعاریف از هر یک از ایمیج‌ها یا دستگاه‌های داده‌شده استخراج شوند\&. تعاریف تولیدشده، پارتیشن‌ها را در جدول پارتیشن مقصد کپی می‌کنند\&. پارتیشن‌های کپی‌شده اندازه یکسان یا اندکی بزرگ‌تر (پارتیشن‌ها ممکن است برای هم‌ترازی با دانه‌بندی جدید یا اندازه سکتور بزرگ‌تر شوند)، فراداده و محتویات یکسانی خواهند داشت اما ممکن است شماره پارتیشن متفاوتی داشته باشند و در آفست متفاوتی در جدول پارتیشن مقصد قرار گیرند\&. این تعاریف را می‌توان با تعاریف پارتیشن خوانده‌شده از فایل‌های تعریف پارتیشن معمولی ترکیب کرد\&. تعاریف استخراج‌شده بر تعاریف خوانده‌شده از فایل‌های تعریف پارتیشن اولویت دارند\&.
.sp
در نسخه 255 اضافه شد\&.
.RE
.PP
\fB\-\-copy\-source=\fR\fB\fIPATH\fR\fR، \fB\-s\fR \fIPATH\fR
.RS 4
یک پوشه مبدأ را مشخص می‌کند که تمام مسیرهای مبدأ
\fICopyFiles=\fR
باید نسبت به آن در نظر گرفته شوند\&. این مشابه
\fB\-\-root=\fR
است، اما منحصراً برای تنظیم
\fICopyFiles=\fR
اعمال می‌شود\&. اگر
\fB\-\-root=\fR
و
\fB\-\-copy\-source=\fR
به صورت ترکیبی استفاده شوند، اولی طبق معمول اعمال می‌شود، به جز برای
\fICopyFiles=\fR
که دومی اولویت دارد\&.
.sp
در نسخه 255 اضافه شد\&.
.RE
.PP
\fB\-\-make\-ddi=\fR\fB\fITYPE\fR\fR
.RS 4
یکی از مقادیر
"sysext"،
"confext"
یا
"portable"
را می‌پذیرد\&. یک ایمیج دیسک قابل کشف (DDI) برای یک افزونه سیستم (sysext، برای جزئیات به
\fBsystemd-sysext\fR(8)
مراجعه کنید)، افزونه پیکربندی (confext) یا
\m[blue]\fBسرویس‌های پرتابل (Portable Services)\fR\m[]\&\s-2\u[1]\d\s+2
تولید می‌کند\&. ایمیج تولیدشده شامل یک فایل‌سیستم امضاشده Verity از نوع
"erofs"
به عنوان پارتیشن ریشه خواهد بود\&. در این حالت عملیاتی، تعاریف پارتیشن در
/usr/lib/repart\&.d/*\&.conf
و پوشه‌های مرتبط خوانده نمی‌شوند و
\fB\-\-definitions=\fR
پشتیبانی نمی‌شود، زیرا تعاریف مناسب برای کلاس DDI انتخاب‌شده به‌طور خودکار انتخاب خواهند شد\&.
.sp
باید در ترکیب با
\fB\-\-copy\-source=\fR
استفاده شود تا سلسله‌مراتب فایلی که DDI با آن پر می‌شود مشخص گردد\&. در صورتی که
"confext"
انتخاب شده باشد، پوشه مشخص‌شده باید حاوی یک زیرپوشه
etc/
باشد\&. اگر
"sysext"
انتخاب شده باشد، باید حاوی پوشه
usr/
یا
opt/
یا هر دو باشد\&. اگر
"portable"
استفاده شود، می‌توان یک سلسله‌مراتب فایل کامل سیستم‌عامل ارائه داد\&.
.sp
این گزینه مستلزم
\fB\-\-empty=create\fR،
\fB\-\-size=auto\fR
و
\fB\-\-seed=random\fR
است (دو مورد آخر را می‌توان نادیده گرفت و بازنویسی کرد)\&.
.sp
کلید خصوصی و گواهی برای امضای DDI باید از طریق سوئیچ‌های
\fB\-\-private\-key=\fR
و
\fB\-\-certificate=\fR
مشخص شوند\&.
.sp
در نسخه 255 اضافه شد\&.
.RE
.PP
\fB\-S\fR، \fB\-C\fR، \fB\-P\fR
.RS 4
میان‌برهایی به ترتیب برای
\fB\-\-make\-ddi=sysext\fR،
\fB\-\-make\-ddi=confext\fR،
\fB\-\-make\-ddi=portable\fR
هستند\&.
.sp
در نسخه 255 اضافه شد\&.
.RE
.PP
\fB\-\-append\-fstab=\fR
.RS 4
یکی از مقادیر
"no"،
"auto"
یا
"replace"
را می‌پذیرد\&. نحوه رفتار فایل
\fBfstab\fR(5)
تولیدشده توسط
\fB\-\-generate\-fstab=\fR
را در صورتی که فایلی از قبل موجود باشد، کنترل می‌کند\&.
.sp
اگر
"no"
باشد،
\fBsystemd\-repart\fR
در صورت وجود فایل اعتراض کرده و عملیات را لغو می‌کند\&. این رفتار پیش‌فرض است\&. اگر
"replace"
باشد، فایل به صورت بی‌صدا با فایل تازه تولیدشده جایگزین می‌شود\&.
.sp
اگر
"auto"
باشد،
\fBsystemd\-repart\fR
در فایل از قبل موجود بخشی را که متعلق به محتوای تولیدشده خودکار است جستجو کرده و آن را با محتوای تولیدشده جدیدتر جایگزین می‌کند، و در صورت وجود بخش ارائه‌شده توسط کاربر، آن را حفظ می‌نماید\&. بخش تولیدشده با جستجوی محتوای خودکار احاطه‌شده توسط
"# Start section ↓ of automatically generated fstab by systemd\-repart"
و
"# End section ↑ of automatically generated fstab by systemd\-repart"
شناسایی می‌شود\&. محتوایی که قبل و بعد از آن یادداشت‌ها قرار دارد به عنوان محتوای ارائه‌شده توسط کاربر در نظر گرفته شده و در فایل جدید حفظ می‌شود\&.
.sp
در نسخه 258 اضافه شد\&.
.RE
.PP
\fB\-\-generate\-fstab=\fR\fB\fIPATH\fR\fR
.RS 4
مسیری را مشخص می‌کند که ورودی‌های
\fBfstab\fR(5)
برای نقاط اتصالی که با
\fBMountPoint=\fR
پیکربندی شده‌اند، در پوشه ریشه مشخص‌شده با
\fB\-\-copy\-source=\fR
یا
\fB\-\-root=\fR
یا در پوشه ریشه میزبان در صورت عدم مشخص شدن هیچ‌کدام، در آن نوشته شوند\&. به‌طور پیش‌فرض غیرفعال است\&.
.sp
در نسخه 256 اضافه شد\&.
.RE
.PP
\fB\-\-generate\-crypttab=\fR\fB\fIPATH\fR\fR
.RS 4
مسیری را مشخص می‌کند که ورودی‌های crypttab برای حجم‌های رمزگذاری‌شده پیکربندی‌شده با
\fBEncryptedVolume=\fR
در پوشه ریشه مشخص‌شده با
\fB\-\-copy\-source=\fR
یا
\fB\-\-root=\fR
یا در پوشه ریشه میزبان در صورت عدم مشخص شدن هیچ‌کدام، در آن نوشته شوند\&. به‌طور پیش‌فرض غیرفعال است\&.
.sp
در نسخه 256 اضافه شد\&.
.RE
.PP
\fB\-\-list\-devices\fR
.RS 4
فهرستی از دستگاه‌های بلوکی کاندیدا را که این دستور ممکن است روی آن‌ها عمل کند نمایش می‌دهد\&. به‌طور مشخص، دستگاه‌های بلوکی فعلی موجود را که از جداول پارتیشن پشتیبانی می‌کنند برمی‌شمارد و مسیرهای گره دستگاه آن‌ها را به همراه هر یک از پیوندهای نمادینشان نشان می‌دهد\&.
.sp
در نسخه 257 اضافه شد\&.
.RE
.PP
\fB\-\-el\-torito=\fR\fB\fIBOOL\fR\fR
.RS 4
یک هدر کمینه ISO9660 با کاتالوگ بوت El Torito می‌نویسد\&. این کار ESP را روی میان‌افزار EFI بوت می‌کند\&.
.sp
فایل‌سیستم ISO9660 ایجادشده توسط آن خالی خواهد بود\&. انتظار می‌رود initramfs یک دستگاه loop دارای قابلیت پارتیشن‌بندی روی دستگاه ایجاد کند تا اندازه بلوک را تغییر داده و پارتیشن‌های GPT را فعال نماید\&.
.sp
دیسک حداقل به یک پارتیشن با
\fIType=esp\fR
نیاز دارد\&. اولین پارتیشن همان پارتیشنی خواهد بود که در کاتالوگ بوت به آن ارجاع داده شده است\&.
.sp
در نسخه 261 اضافه شد\&.
.RE
.PP
\fB\-\-el\-torito\-system=\fR\fB\fISTRING\fR\fR
.RS 4
هنگام ایجاد هدر ISO9660، این مقدار به عنوان شناسه سیستم استفاده خواهد شد\&. این امر برای تطبیق رسانه با پایگاه‌داده osinfo مفید است\&.
.sp
این مقدار به ۳۲ نویسه محدود است\&.
.sp
در نسخه 261 اضافه شد\&.
.RE
.PP
\fB\-\-el\-torito\-volume=\fR\fB\fISTRING\fR\fR
.RS 4
هنگام ایجاد هدر ISO9660، این مقدار به عنوان شناسه حجم استفاده خواهد شد\&. این امر برای تطبیق رسانه با پایگاه‌داده osinfo مفید است\&.
.sp
این مقدار به ۳۲ نویسه محدود است\&.
.sp
در نسخه 261 اضافه شد\&.
.RE
.PP
\fB\-\-el\-torito\-publisher=\fR\fB\fISTRING\fR\fR
.RS 4
هنگام ایجاد هدر ISO9660، این مقدار به عنوان شناسه ناشر استفاده خواهد شد\&. این امر برای تطبیق رسانه با پایگاه‌داده osinfo مفید است\&.
.sp
این مقدار به ۱۲۸ نویسه محدود است\&.
.sp
در نسخه 261 اضافه شد\&.
.RE
.PP
\fB\-h\fR، \fB\-\-help\fR
.RS 4
یک متن راهنمای کوتاه چاپ کرده و خارج می‌شود\&.
.RE
.PP
\fB\-\-version\fR
.RS 4
یک رشته نسخه کوتاه چاپ کرده و خارج می‌شود\&.
.RE
.PP
\fB\-\-no\-pager\fR
.RS 4
خروجی را به یک صفحه‌بند (pager) هدایت نمی‌کند\&.
.RE
.PP
\fB\-\-no\-legend\fR
.RS 4
راهنما (legend)، یعنی سرستون‌ها و پانویس حاوی نکات راهنما را چاپ نمی‌کند\&.
.RE
.PP
\fB\-\-json=\fR\fB\fIMODE\fR\fR
.RS 4
خروجی قالب‌بندی‌شده به صورت JSON را نشان می‌دهد\&. یکی از مقادیر
"short"
(برای کوتاه‌ترین خروجی ممکن بدون هیچ‌گونه فضای خالی اضافی یا شکست خط)،
"pretty"
(برای نسخه‌ای خوانا از همان، همراه با تورفتگی و شکست خط) یا
"off"
(برای غیرفعال کردن خروجی JSON، که حالت پیش‌فرض است) را می‌پذیرد\&.
.RE
.SH "وضعیت خروج (EXIT STATUS)"
.PP
در صورت موفقیت، ۰ بازگردانده می‌شود و در غیر این صورت یک کد شکست غیرصفر بازگردانده می‌شود\&.
.SH "مثال‌ها (EXAMPLES)"
.PP
\fBمثال\ \&۱.\ \&تولید یک ایمیج افزونه پیکربندی\fR
.PP
دستور زیر یک DDI افزونه پیکربندی (confext) برای به‌روزرسانی
/etc/motd
ایجاد می‌کند:
.sp
.if n \{\
.RS 4
.\}
.nf
mkdir \-p tree/etc/extension\-release\&.d
echo "Hello World" >tree/etc/motd
cat >tree/etc/extension\-release\&.d/extension\-release\&.my\-motd <<EOF
ID=fedora
VERSION_ID=38
IMAGE_ID=my\-motd
IMAGE_VERSION=7
EOF
systemd\-repart \-C \e
  \-\-private\-key=verity\-private\-key\&.pem \e
  \-\-certificate=verity\-certificate\&.pem \e
  \-s tree/ \e
  /var/lib/confexts/my\-motd\&.confext\&.raw
systemd\-confext refresh
.fi
.if n \{\
.RE
.\}
.PP
ایمیج DDI تولیدشده از این طریق ممکن است با
\fBsystemd-confext\fR(8)
به سیستم اعمال شود\&.
.PP
\fBمثال\ \&۲.\ \&تولید یک ایمیج افزونه سیستم و امضای آن از طریق PKCS11\fR
.PP
دستور زیر یک DDI افزونه سیستم (sysext) برای به‌روزرسانی
/usr/foo
ایجاد کرده و آن را با یک توکن سخت‌افزاری از طریق PKCS11 امضا می‌کند:
.sp
.if n \{\
.RS 4
.\}
.nf
mkdir \-p tree/usr/lib/extension\-release\&.d
echo "Hello World" >tree/usr/foo
cat >tree/usr/lib/extension\-release\&.d/extension\-release\&.my\-foo <<EOF
ID=fedora
VERSION_ID=38
IMAGE_ID=my\-foo
IMAGE_VERSION=7
EOF
systemd\-repart \-\-make\-ddi=sysext \e
  \-\-private\-key\-source=engine:pkcs11 \e
  \-\-private\-key="pkcs11:model=PKCS%2315%20emulated;manufacturer=piv_II;serial=0123456789abcdef;token=Some%20Cert" \e
  \-\-certificate=verity\-certificate\&.pem \e
  \-s tree/ \e
  /var/lib/extensions/my\-foo\&.sysext\&.raw
systemd\-sysext refresh
.fi
.if n \{\
.RE
.\}
.PP
ایمیج DDI تولیدشده از این طریق ممکن است با
\fBsystemd-sysext\fR(8)
به سیستم اعمال شود\&.
.PP
\fBمثال\ \&۳.\ \&تولید یک امضای dm\-verity به صورت برون‌خط (آفلاین) و الحاق آن به یک ایمیج از پیش ساخته‌شده\fR
.PP
دستور زیر یک ایمیج حاوی فراداده dm\-verity ایجاد می‌کند، آن را به طور جداگانه امضا می‌کند تا یک سیستم امضای آفلاین را شبیه‌سازی کند، و سپس امضا را به ایمیج ملحق می‌نماید:
.sp
.if n \{\
.RS 4
.\}
.nf
mkdir \-p repart\&.d/ /tmp/tree/usr/lib/

cat >/tmp/tree/usr/lib/os\-release <<EOF
ID=debian
VERSION_ID=13
EOF

cat >repart\&.d/10\-root\&.conf <<EOF
[Partition]
Type=root
Format=erofs
SizeMinBytes=100M
SizeMaxBytes=100M
Verity=data
VerityMatchKey=root
EOF

cat >repart\&.d/11\-root\-verity\&.conf <<EOF
[Partition]
Type=root\-verity
Label=%o_%w_verity
Verity=hash
VerityMatchKey=root
SizeMinBytes=400M
SizeMaxBytes=400M
EOF

cat >repart\&.d/12\-root\-verity\-sig\&.conf <<EOF
[Partition]
Type=root\-verity\-sig
Label=%o_%w_verity_sig
Verity=signature
VerityMatchKey=root
EOF

systemd\-repart \-\-definitions repart\&.d \e
  \-\-defer\-partitions=root\-verity\-sig \e
  \-\-copy\-source=/tmp/tree/ \e
  \-\-empty=create \-\-size=600M \e
  \-\-json=short \e
  /tmp/img\&.raw | jq \-\-raw\-output0 "\&.[\-1]\&.roothash" > /tmp/img\&.roothash

openssl smime \-sign \-in /tmp/img\&.roothash \e
  \-inkey verity\-private\-key\&.pem \e
  \-signer verity\-certificate\&.pem \e
  \-noattr \-binary \-outform der \e
  \-out /tmp/img\&.roothash\&.p7s

systemd\-repart \-\-definitions repart\&.d \e
  \-\-dry\-run=no \-\-root=/tmp/tree/ \e
  \-\-join\-signature="$(cat /tmp/img\&.roothash):/tmp/img\&.roothash\&.p7s" \e
  \-\-certificate=verity\-certificate\&.pem \e
  /tmp/img\&.raw
.fi
.if n \{\
.RE
.\}
.SH "همچنین ببینید (SEE ALSO)"
.PP
\fBsystemd\fR(1), \fBrepart.d\fR(5), \fBmachine-id\fR(5), \fBsystemd-cryptenroll\fR(1), \fBportablectl\fR(1), \fBsystemd-sysext\fR(8)
.SH "یادداشت‌ها (NOTES)"
.IP " 1." 4
سرویس‌های پرتابل (Portable Services)
.RS 4
\%https://systemd.io/PORTABLE_SERVICES
.RE
