.TH "GIT-BUG" "1" "Apr 2019" "Generated from git-bug's source code" ""

.SH "نام (NAME)"
git-bug-bug-comment-new \- افزودن یک دیدگاه جدید به یک باگ


.SH "خلاصه دستور (SYNOPSIS)"
\fBgit-bug bug comment new [BUG_ID] [flags]\fP


.SH "توضیحات (DESCRIPTION)"
افزودن یک دیدگاه جدید به یک باگ


.SH "گزینه‌ها (OPTIONS)"
\fB-F\fP, \fB--file\fP=""
	دریافت پیام از فایل مشخص‌شده. برای خواندن پیام از ورودی استاندارد از \- استفاده کنید

.PP
\fB-m\fP, \fB--message\fP=""
	ارائه پیام جدید از طریق خط فرمان

.PP
\fB--non-interactive\fP[=false]
	عدم درخواست ورودی از کاربر

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای new


.SH "همچنین ببینید (SEE ALSO)"
\fBgit-bug-bug-comment(1)\fP
