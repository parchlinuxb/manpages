.PP
\fB--flex-volume-plugin-dir\fP="/usr/libexec/kubernetes/kubelet-plugins/volume/exec/"
	مسیر کامل دایرکتوری که پلاگین flex volume باید در آن به دنبال پلاگین‌های حجم شخص ثالث اضافی بگردد.
.PP
\fB-h\fP, \fB--help\fP=false
	راهنما برای kube-controller-manager.
.PP
\fB--horizontal-pod-autoscaler-cpu-initialization-period\fP=5m0s
	مدت زمان پس از شروع پاد که در طول آن ممکن است از نمونه‌گیری‌های پردازنده (CPU) صرف‌نظر شود.
.PP
\fB--horizontal-pod-autoscaler-downscale-stabilization\fP=5m0s
	مدت زمانی که مقیاس‌پذیر خودکار به گذشته نگاه کرده و مقیاس را به کمتر از هیچ‌یک از توصیه‌هایی که در آن بازه ارائه داده کاهش نمی‌دهد.
.PP
\fB--horizontal-pod-autoscaler-initial-readiness-delay\fP=30s
	مدت زمان پس از شروع پاد که طی آن تغییرات وضعیت آمادگی به عنوان آمادگی اولیه تلقی می‌شوند.
.PP
\fB--horizontal-pod-autoscaler-sync-period\fP=15s
	دوره زمانی برای همگام‌سازی تعداد پادها در مقیاس‌پذیر خودکار افقی پاد.
.PP
\fB--horizontal-pod-autoscaler-tolerance\fP=0.1
	حداقل تغییر (از ۱.۰) در نسبت معیارهای مطلوب به واقعی برای اینکه مقیاس‌پذیر خودکار افقی پاد اقدام به مقیاس‌دهی را مدنظر قرار دهد.
.PP
\fB--http2-max-streams-per-connection\fP=0
	محدودیتی که سرور به کلاینت‌ها برای حداکثر تعداد جریان‌ها در یک اتصال HTTP/2 ارائه می‌دهد. مقدار صفر به معنای استفاده از مقدار پیش‌فرض زبان Go است.
.PP
\fB--kube-api-burst\fP=30
	حداکثر جهش ترافیک (Burst) هنگام برقراری ارتباط با apiserver کوبرنتیز.
.PP
\fB--kube-api-content-type\fP="application/vnd.kubernetes.protobuf"
	نوع محتوای درخواست‌های ارسالی به apiserver.
.PP
\fB--kube-api-qps\fP=20
	میزان پرس‌وجو در ثانیه (QPS) برای استفاده هنگام برقراری ارتباط با apiserver کوبرنتیز.
.PP
\fB--kubeconfig\fP=""
	مسیر فایل kubeconfig حاوی اطلاعات مجوزدهی و مکان سرور مستر (مکان سرور مستر را می‌توان با فلگ master بازنویسی کرد).
.PP
\fB--large-cluster-size-threshold\fP=50
	تعداد نودهایی که از آن به بعد node-lifecycle-controller کلاستر را برای اهداف منطق تخلیه (eviction) به عنوان کلاستر بزرگ در نظر می‌گیرد. مقدار --secondary-node-eviction-rate برای کلاسترهایی با این اندازه یا کوچک‌تر به‌طور ضمنی به 0 بازنویسی می‌شود. توجه: اگر نودها در چندین زون (zone) مستقر باشند، این مقدار به عنوان آستانه اندازه نود زون برای هر زون در نظر گرفته می‌شود تا نرخ تخلیه نود به‌طور مستقل تعیین گردد.
.PP
\fB--leader-elect\fP=true
	شروع یک کلاینت انتخاب رهبر و به دست آوردن رهبری پیش از اجرای حلقه اصلی. این گزینه را هنگام اجرای مؤلفه‌های تکرارشده برای دسترسی‌پذیری بالا (HA) فعال کنید.
.PP
\fB--leader-elect-lease-duration\fP=15s
	مدت زمانی که کاندیداهای غیررهبر پس از مشاهده تمدید رهبری منتظر می‌مانند تا برای تصاحب رهبری یک جایگاه رهبری که هدایت شده اما تمدید نشده تلاش کنند. این در عمل حداکثر مدت زمانی است که یک رهبر می‌تواند متوقف شود قبل از اینکه توسط کاندیدای دیگری جایگزین گردد. این تنها در صورت فعال بودن انتخاب رهبر کاربرد دارد.
.PP
\fB--leader-elect-renew-deadline\fP=10s
	فاصله زمانی میان تلاش‌های سرور مستر در حال انجام وظیفه برای تمدید جایگاه رهبری پیش از دست کشیدن از رهبری. این مقدار باید کمتر از مدت اجاره باشد. این تنها در صورت فعال بودن انتخاب رهبر کاربرد دارد.
.PP
\fB--leader-elect-resource-lock\fP="leases"
	نوع شیء منبع مورد استفاده برای قفل‌گذاری در حین انتخاب رهبر. گزینه‌های پشتیبانی‌شده 'leases' هستند.
.PP
\fB--leader-elect-resource-name\fP="kube-controller-manager"
	نام شیء منبع مورد استفاده برای قفل‌گذاری در حین انتخاب رهبر.
.PP
\fB--leader-elect-resource-namespace\fP="kube-system"
	فضای نام شیء منبع مورد استفاده برای قفل‌گذاری در حین انتخاب رهبر.
.PP
\fB--leader-elect-retry-period\fP=2s
	مدت زمانی که کلاینت‌ها باید بین تلاش‌ها برای دستیابی و تمدید رهبری منتظر بمانند. این تنها در صورتی قابل اعمال است که انتخاب رهبر فعال باشد.
.PP
\fB--leader-migration-config\fP=""
	مسیر فایل پیکربندی برای مهاجرت رهبر کنترلر، یا خالی برای استفاده از مقداری که پیکربندی پیش‌فرض مدیر کنترلر را بازتاب می‌دهد. فایل پیکربندی باید از نوع LeaderMigrationConfiguration، گروه controllermanager.config.k8s.io و نسخه v1alpha1 باشد.
.PP
\fB--legacy-service-account-token-clean-up-period\fP=8760h0m0s
	مدت زمان سپری‌شده از آخرین استفاده از یک توکن قدیمی حساب کاربری سرویس پیش از آنکه بتوان آن را حذف کرد.
.PP
\fB--log-flush-frequency\fP=5s
	حداکثر تعداد ثانیه‌ها بین تخلیه‌های فایل لاگ به دیسک.
.PP
\fB--log-text-info-buffer-size\fP=0
	[آلفا] در قالب متنی با جریان‌های خروجی تفکیک‌شده، پیام‌های info را می‌توان برای مدتی بافر کرد تا عملکرد افزایش یابد. مقدار پیش‌فرض صفر بایت بافر کردن را غیرفعال می‌سازد. اندازه را می‌توان به عنوان تعداد بایت‌ها (512)، مضارب 1000 (1K)، مضارب 1024 (2Ki) یا توان‌هایی از آن‌ها (3M, 4G, 5Mi, 6Gi) تعیین کرد. برای استفاده از این قابلیت، گیت ویژگی LoggingAlphaOptions را فعال کنید.
.PP
\fB--log-text-split-stream\fP=false
	[آلفا] در قالب متنی، پیام‌های خطا در stderr و پیام‌های اطلاعاتی در stdout نوشته می‌شوند. حالت پیش‌فرض نوشتن یک جریان منفرد در stdout است. برای استفاده از این قابلیت، گیت ویژگی LoggingAlphaOptions را فعال کنید.
.PP
\fB--logging-format\fP="text"
	قالب لاگ را تعیین می‌کند. قالب‌های مجاز: "text".
.PP
\fB--master\fP=""
	آدرس سرور API کوبرنتیز (هر مقداری را در kubeconfig بازنویسی می‌کند).
.PP
\fB--max-endpoints-per-slice\fP=100
	حداکثر تعداد اندپوینت‌هایی که به یک EndpointSlice اضافه می‌شوند. اندپوینت‌های بیشتر در هر برش منجر به برش‌های اندپوینت کمتر اما منابع بزرگ‌تر خواهد شد. پیش‌فرض 100 است.
.PP
\fB--min-compatibility-version\fP=[]
	حداقل نسخه مؤلفه‌های صفحه کنترل (control plane) که سرور باید با آن‌ها سازگار باشد.
باید کمتر یا مساوی با emulated-version باشد. قالب نسخه تنها می‌تواند major.minor باشد؛ برای مثال: '--min-compatibility-version=wardle=1.2,kube=1.31'.
گزینه‌ها عبارتند از: kube=1.33..1.36 (پیش‌فرض: 1.35)
اگر مؤلفه مشخص نشده باشد، پیش‌فرض آن "kube" خواهد بود.
.PP
\fB--min-resync-period\fP=12h0m0s
	دوره بازهمگام‌سازی (resync) در بازتابنده‌ها (reflectors) به‌صورت تصادفی بین MinResyncPeriod و 2*MinResyncPeriod خواهد بود.
.PP
\fB--mirroring-concurrent-service-endpoint-syncs\fP=5
	تعداد عملیات همگام‌سازی اندپوینت سرویس که به‌طور همزمان توسط endpointslice-mirroring-controller انجام می‌شود. عدد بزرگ‌تر = به‌روزرسانی سریع‌تر برش اندپوینت، اما بار بیشتر بر پردازنده و شبکه. پیش‌فرض 5 است.
.PP
\fB--mirroring-endpointslice-updates-batch-period\fP=0s
	طول دوره دسته‌بندی به‌روزرسانی‌های EndpointSlice برای endpointslice-mirroring-controller. پردازش تغییرات EndpointSlice به این مدت به تعویق می‌افتد تا با به‌روزرسانی‌های احتمالی آینده تجمیع شده و تعداد کلی به‌روزرسانی‌های EndpointSlice کاهش یابد. عدد بزرگ‌تر = تأخیر برنامه‌ریزی بیشتر اندپوینت، اما ایجاد تعداد کمتری از بازبینی‌های اندپوینت.
.PP
\fB--mirroring-max-endpoints-per-subset\fP=1000
	حداکثر تعداد اندپوینت‌هایی که توسط endpointslice-mirroring-controller به یک EndpointSlice اضافه می‌شوند. اندپوینت‌های بیشتر در هر برش منجر به برش‌های اندپوینت کمتر اما منابع بزرگ‌تر خواهد شد. پیش‌فرض 100 است.
.PP
\fB--namespace-sync-period\fP=5m0s
	دوره زمانی برای همگام‌سازی به‌روزرسانی‌های چرخه حیات فضای نام (namespace).
.PP
\fB--node-cidr-mask-size\fP=0
	اندازه ماسک برای CIDR نود در کلاستر. پیش‌فرض برای IPv4 برابر 24 و برای IPv6 برابر 64 است.
.PP
\fB--node-cidr-mask-size-ipv4\fP=0
	اندازه ماسک برای CIDR نود IPv4 در کلاستر دوپشته‌ای (dual-stack). پیش‌فرض 24 است.
.PP
\fB--node-cidr-mask-size-ipv6\fP=0
	اندازه ماسک برای CIDR نود IPv6 در کلاستر دوپشته‌ای (dual-stack). پیش‌فرض 64 است.
.PP
\fB--node-eviction-rate\fP=0.1
	تعداد نودها در ثانیه که در صورت بروز خرابی نود و هنگام سالم بودن یک زون، پادهای آن‌ها حذف می‌شوند (برای تعریف زون سالم/ناسالم به --unhealthy-zone-threshold مراجعه کنید). در کلاسترهای غیرچندزونی، زون به کل کلاستر اطلاق می‌شود.
.PP
\fB--node-monitor-grace-period\fP=50s
	مدت زمانی که به یک نود در حال اجرا مهلت داده می‌شود تا بدون پاسخ باقی بماند پیش از آنکه به عنوان ناسالم علامت‌گذاری شود. باید N برابر بیشتر از nodeStatusUpdateFrequency مربوط به kubelet باشد، که در آن N نشان‌دهنده تعداد دفعات مجاز تلاش kubelet برای ارسال وضعیت نود است. این مقدار همچنین باید بیشتر از مجموع HTTP2_PING_TIMEOUT_SECONDS و HTTP2_READ_IDLE_TIMEOUT_SECONDS باشد.
.PP
\fB--node-monitor-period\fP=5s
	دوره زمانی برای همگام‌سازی NodeStatus در cloud-node-lifecycle-controller.
.PP
\fB--node-startup-grace-period\fP=1m0s
	مدت زمانی که به یک نود در حال راه‌اندازی مهلت داده می‌شود تا بدون پاسخ بماند پیش از آنکه به عنوان ناسالم علامت‌گذاری شود.
.PP
\fB--node-sync-period\fP=0s
	این فلگ منسوخ شده است و در نسخه‌های آینده حذف خواهد شد. برای بررسی سلامت نود به node-monitor-period یا برای تنظیمات پیکربندی مسیر ارائه‌دهنده ابری به route-reconciliation-period مراجعه نمایید.
.PP
\fB--permit-address-sharing\fP=false
	اگر true باشد، در زمان اتصال به درگاه از SO_REUSEADDR استفاده خواهد شد. این کار اجازه اتصال موازی به IPهای عام مانند 0.0.0.0 و IPهای خاص را می‌دهد و از انتظار کشیدن برای آزادسازی سوکت‌ها در وضعیت TIME_WAIT توسط هسته جلوگیری می‌کند [پیش‌فرض=false].
.PP
\fB--permit-port-sharing\fP=false
	اگر true باشد، در زمان اتصال به درگاه از SO_REUSEPORT استفاده خواهد شد که به بیش از یک نمونه اجازه می‌دهد روی همان آدرس و درگاه متصل شوند [پیش‌فرض=false].
.PP
\fB--profiling\fP=true
	فعال‌سازی پروفایلینگ از طریق رابط وب host:port/debug/pprof/.
.PP
\fB--pv-recycler-increment-timeout-nfs\fP=30
	میزان زمان اضافه‌شده به ازای هر گیبی‌بایت (Gi) به ActiveDeadlineSeconds برای پاد پاک‌کننده NFS.
.PP
\fB--pv-recycler-minimum-timeout-hostpath\fP=60
	حداقل مقدار ActiveDeadlineSeconds برای استفاده در یک پاد بازیافت‌کننده HostPath. این گزینه تنها برای توسعه و آزمایش است و در یک کلاستر چندنودی کار نخواهد کرد.
.PP
\fB--pv-recycler-minimum-timeout-nfs\fP=300
	حداقل مقدار ActiveDeadlineSeconds برای یک پاد بازیافت‌کننده NFS.
.PP
\fB--pv-recycler-pod-template-filepath-hostpath\fP=""
	مسیر فایل تعریف پاد که به عنوان الگو برای بازیافت حجم‌های پایدار HostPath استفاده می‌شود. این گزینه تنها برای توسعه و آزمایش است و در یک کلاستر چندنودی کار نخواهد کرد.
.PP
\fB--pv-recycler-pod-template-filepath-nfs\fP=""
	مسیر فایل تعریف پاد که به عنوان الگو برای بازیافت حجم‌های پایدار NFS استفاده می‌شود.
.PP
\fB--pv-recycler-timeout-increment-hostpath\fP=30
	میزان زمان اضافه‌شده به ازای هر گیبی‌بایت (Gi) به ActiveDeadlineSeconds برای پاد پاک‌کننده HostPath. این گزینه تنها برای آزمایش و توسعه است و در یک کلاستر چندنودی کار نخواهد کرد.
.PP
\fB--pvclaimbinder-sync-period\fP=15s
	دوره زمانی برای همگام‌سازی حجم‌های پایدار (PV) و مطالبات حجم پایدار (PVC).
.PP
\fB--requestheader-allowed-names\fP=[]
	فهرستی از نام‌های مشترک (Common Names) گواهی کلاینت که مجاز به ارائه نام‌های کاربری در هدرهای مشخص‌شده توسط --requestheader-username-headers هستند. در صورت خالی بودن، هر گواهی کلاینتی که توسط مراجع در --requestheader-client-ca-file تایید شود مجاز خواهد بود.
.PP
\fB--requestheader-client-ca-file\fP=""
	بسته گواهی ریشه برای اعتبارسنجی گواهی‌های کلاینت در درخواست‌های ورودی پیش از اعتماد به نام‌های کاربری در هدرهای مشخص‌شده توسط --requestheader-username-headers. هشدار: به‌طور کلی به اینکه اعتبارسنجی مجوز از قبل برای درخواست‌های ورودی انجام شده باشد اتکا نکنید.
.PP
\fB--requestheader-extra-headers-prefix\fP=[x-remote-extra-]
	فهرستی از پیشوندهای هدر درخواست برای بازرسی. مقدار پیشنهادی X-Remote-Extra- است.
.PP
\fB--requestheader-group-headers\fP=[x-remote-group]
	فهرستی از هدرهای درخواست برای بازرسی گروه‌ها. مقدار پیشنهادی X-Remote-Group است.
.PP
\fB--requestheader-uid-headers\fP=[]
	فهرستی از هدرهای درخواست برای بازرسی شناسه‌ها (UIDها). مقدار پیشنهادی X-Remote-Uid است. نیازمند فعال بودن ویژگی RemoteRequestHeaderUID است.
.PP
\fB--requestheader-username-headers\fP=[x-remote-user]
	فهرستی از هدرهای درخواست برای بازرسی نام‌های کاربری. معمولاً X-Remote-User استفاده می‌شود.
.PP
\fB--resource-quota-sync-period\fP=5m0s
	دوره زمانی برای همگام‌سازی وضعیت استفاده از سهمیه در سیستم.
.PP
\fB--root-ca-file\fP=""
	در صورت تنظیم، این مرجع گواهی ریشه در سکرتِ توکن حساب کاربری سرویس گنجانده خواهد شد. این مقدار باید یک بسته CA معتبر با کدگذاری PEM باشد.
.PP
\fB--route-reconciliation-period\fP=10s
	دوره زمانی برای تطبیق مسیرهای ایجاد شده برای نودها توسط ارائه‌دهنده ابری.
.PP
\fB--secondary-node-eviction-rate\fP=0.01
	تعداد نودها در هر ثانیه که پادهای آن‌ها در صورت خرابی نود و هنگام ناسالم بودن زون حذف می‌شوند (برای تعریف زون سالم/ناسالم به --unhealthy-zone-threshold مراجعه کنید). در کلاسترهای غیرچندزونی، زون به کل کلاستر اشاره دارد. این مقدار اگر اندازه کلاستر کوچک‌تر از --large-cluster-size-threshold باشد، به‌طور ضمنی به 0 بازنویسی خواهد شد.
.PP
\fB--secure-port\fP=10257
	درگاهی که پروتکل HTTPS همراه با احراز هویت و مجوزدهی روی آن ارائه می‌شود. در صورت تنظیم روی 0، HTTPS ارائه نخواهد شد.
.PP
\fB--service-account-private-key-file\fP=""
	در صورت تنظیم، توکن‌های سنتی مبتنی بر سکرت را فعال می‌کند. نام فایل حاوی کلید خصوصی RSA یا ECDSA با کدگذاری PEM که برای امضای توکن‌های حساب کاربری سرویس استفاده می‌شود.
.PP
\fB--service-cluster-ip-range\fP=""
	محدوده CIDR برای سرویس‌ها در کلاستر. تنها زمانی استفاده می‌شود که --allocate-node-cidrs=true باشد؛ اگر false باشد، این گزینه نادیده گرفته می‌شود.
.PP
\fB--show-hidden-metrics-for-version\fP=""
	نسخه قبلی که مایلید معیارهای پنهان آن نمایش داده شوند. تنها نسخه فرعی (minor) قبلی معنادار است، سایر مقادیر مجاز نخواهند بود. قالب به‌صورت \&. است، مانند: '1.16'. هدف از این قالب این است که اطمینان حاصل شود فرصت دارید متوجه شوید آیا نسخه بعدی معیارهای بیشتری را پنهان می‌کند یا خیر، تا در زمان حذف دائمی آن‌ها در نسخه پس از آن غافلگیر نشوید.
.PP
\fB--terminated-pod-gc-threshold\fP=12500
	تعداد پادهای خاتمه‌یافته که می‌توانند وجود داشته باشند پیش از آنکه فرآیند پاک‌کننده پادهای خاتمه‌یافته شروع به حذف پادها کند. اگر کوچکتر یا مساوی 0 باشد، این فرآیند غیرفعال می‌شود.
.PP
\fB--tls-cert-file\fP=""
	فایل حاوی گواهی پیش‌فرض x509 برای HTTPS (گواهی CA، در صورت وجود، بعد از گواهی سرور الحاق می‌شود). در صورتی که ارائه HTTPS فعال باشد و گزینه‌های --tls-cert-file و --tls-private-key-file ارائه نشده باشند، یک گواهی و کلید خودامضا برای آدرس عمومی ایجاد شده و در دایرکتوری مشخص‌شده توسط --cert-dir ذخیره خواهد شد.
.PP
\fB--tls-cipher-suites\fP=[]
	فهرستی جداشده با کاما از مجموعه‌های رمزنگاری (cipher suites) برای سرور. در صورت حذف، از مجموعه‌های رمزنگاری پیش‌فرض Go استفاده خواهد شد.
مقادیر ترجیحی: TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384, TLS_CHACHA20_POLY1305_SHA256, TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA, TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384, TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305, TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256, TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA, TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA, TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384, TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305, TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256.
مقادیر ناامن: TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256, TLS_ECDHE_ECDSA_WITH_RC4_128_SHA, TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA, TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256, TLS_ECDHE_RSA_WITH_RC4_128_SHA, TLS_RSA_WITH_3DES_EDE_CBC_SHA, TLS_RSA_WITH_AES_128_CBC_SHA, TLS_RSA_WITH_AES_128_CBC_SHA256, TLS_RSA_WITH_AES_128_GCM_SHA256, TLS_RSA_WITH_AES_256_CBC_SHA, TLS_RSA_WITH_AES_256_GCM_SHA384, TLS_RSA_WITH_RC4_128_SHA.
.PP
\fB--tls-curve-preferences\fP=[]
	فهرستی جداشده با کاما از مقادیر عددی CurveID بسته crypto/tls زبان Go، به عنوان سازوکارهای مجاز تبادل کلید برای سرور. مقادیر پشتیبانی‌شده به نسخه Go مورد استفاده بستگی دارند. برای مقادیر پشتیبانی‌شده در هر نسخه Go پیوند https://pkg.go.dev/crypto/tls#CurveID را مشاهده کنید. ترتیب فهرست نادیده گرفته می‌شود و سازوکارهای تبادل کلید توسط Go بر اساس اولویت داخلی از این لیست انتخاب می‌شوند. در صورت عدم درج، از منحنی‌های پیش‌فرض Go استفاده خواهد شد.
.PP
\fB--tls-min-version\fP=""
	حداقل نسخه TLS پشتیبانی‌شده. مقادیر ممکن: VersionTLS10, VersionTLS11, VersionTLS12, VersionTLS13.
.PP
\fB--tls-private-key-file\fP=""
	فایل حاوی کلید خصوصی پیش‌فرض x509 متناظر با --tls-cert-file.
.PP
\fB--tls-sni-cert-key\fP=[]
	یک جفت از مسیرهای فایل گواهی x509 و کلید خصوصی، که به صورت اختیاری می‌تواند با فهرستی از الگوهای دامنه که نام‌های دامنه کاملاً واجد شرایط (FQDN) هستند (احتمالاً با پیشوندهای عام/wildcard) خاتمه یابد. الگوهای دامنه اجازه درج آدرس‌های IP را نیز می‌دهند، اما IPها فقط در صورتی باید استفاده شوند که apiserver قابلیت مشاهده آدرس IP درخواست‌شده توسط کلاینت را داشته باشد. در صورت عدم ارائه الگوی دامنه، نام‌ها از گواهی استخراج می‌شوند. تطابق‌های غیراختصاصی اولویت کمتری نسبت به تطابق‌های صریح الگو دارند. برای چندین جفت کلید/گواهی، از گزینه --tls-sni-cert-key چند بار استفاده کنید. مثال‌ها: "example.crt,example.key" یا "foo.crt,foo.key:*.foo.com,foo.com".
.PP
\fB--unhealthy-zone-threshold\fP=0.55
	کسری از نودها در یک زون که باید در وضعیت Ready نباشند (حداقل ۳ عدد) تا آن زون به عنوان ناسالم در نظر گرفته شود.
.PP
\fB--use-service-account-credentials\fP=false
	اگر true باشد، از اطلاعات احراز هویت حساب کاربری سرویس به صورت مجزا برای هر کنترلر استفاده خواهد شد.
.PP
\fB-v\fP, \fB--v\fP=0
	عددی برای تعیین میزان تفصیل (verbosity) لاگ‌ها.
.PP
\fB--version\fP=false
	گزینه‌های --version یا --version=raw اطلاعات نسخه را چاپ کرده و خارج می‌شوند؛ --version=vX.Y.Z... نسخه گزارش‌شده را تنظیم می‌کند.
.PP
\fB--vmodule\fP=
	فهرستی جداشده با کاما از تنظیمات pattern=N برای ثبت لاگ فیلترشده بر اساس فایل (تنها برای قالب لاگ متنی کار می‌کند).

.SH "تاریخچه (HISTORY)"
ژانویه ۲۰۱۵، در ابتدا توسط اریک پاریس (eparis at redhat dot com) بر اساس مستندات منبع کوبرنتیز گردآوری شد، اما امید است از آن زمان به بعد به‌طور خودکار تولید شده باشند!
