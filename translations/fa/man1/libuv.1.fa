.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B typedef void (*uv_fs_cb)(uv_fs_t \%<#\:c\:.uv_fs_t> *req)
کالبکی که هنگام تکمیل ناهمگام یک درخواست فراخوانی می‌شود.
.UNINDENT
.SS "اعضای عمومی (Public members)"
.INDENT 0.0
.TP
.B uv_loop_t \%<#\:c\:.uv_loop_t> *uv_fs_t \%<#\:c\:.uv_fs_t>\&.loop
حلقه‌ای که این درخواست را آغاز کرده و تکمیل درخواست در آن گزارش خواهد شد.
فقط‌خواندنی.
.UNINDENT
.INDENT 0.0
.TP
.B uv_fs_type \%<#\:c\:.uv_fs_type> uv_fs_t \%<#\:c\:.uv_fs_t>\&.fs_type
نوع درخواست FS.
.UNINDENT
.INDENT 0.0
.TP
.B const char *uv_fs_t \%<#\:c\:.uv_fs_t>\&.path
مسیری که درخواست را تحت تأثیر قرار می‌دهد.
.UNINDENT
.INDENT 0.0
.TP
.B ssize_t uv_fs_t \%<#\:c\:.uv_fs_t>\&.result
نتیجه درخواست. مقدار کوچکتر از ۰ به معنای خطا و در غیر این صورت نشان‌دهنده موفقیت است. در درخواست‌هایی
مانند \fBuv_fs_read()\fP یا \fBuv_fs_write()\fP مقدار داده خوانده‌شده یا
نوشته‌شده را نشان می‌دهد.
.UNINDENT
.INDENT 0.0
.TP
.B uv_stat_t \%<#\:c\:.uv_stat_t> uv_fs_t \%<#\:c\:.uv_fs_t>\&.statbuf
نتیجه \fBuv_fs_stat()\fP و سایر درخواست‌های stat را ذخیره می‌کند.
.UNINDENT
.INDENT 0.0
.TP
.B void *uv_fs_t \%<#\:c\:.uv_fs_t>\&.ptr
نتیجه \fBuv_fs_readlink()\fP و
\fBuv_fs_realpath()\fP را ذخیره می‌کند و به‌عنوان نام مستعار (alias) برای \fIstatbuf\fP عمل می‌کند.
.UNINDENT
.sp
\fBهمچنین ببینید:\fP
.INDENT 0.0
.INDENT 3.5
اعضای \fBuv_req_t\fP \%<#\:c\:.uv_req_t> نیز اعمال می‌شوند.
.UNINDENT
.UNINDENT
.SS "رابط برنامه‌نویسی (API)"
.INDENT 0.0
.TP
.B void uv_fs_req_cleanup(uv_fs_t \%<#\:c\:.uv_fs_t> *req)
پاک‌سازی درخواست. باید پس از پایان درخواست برای آزادسازی هرگونه
حافظه‌ای که ممکن است libuv تخصیص داده باشد فراخوانی شود.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_close(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> file, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل close(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:close\:.2\:.html>\&.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_open(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, int flags, int mode, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل open(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:open\:.2\:.html>\&.
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
در ویندوز libuv از \fICreateFileW\fP استفاده می‌کند و بنابراین فایل همیشه
در حالت دودویی (binary) باز می‌شود. به همین دلیل فلگ‌های O_BINARY و O_TEXT
پشتیبانی نمی‌شوند.
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_read(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> file, const uv_buf_t \%<#\:c\:.uv_buf_t> bufs[], unsigned int nbufs, int64_t offset, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل preadv(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:preadv\:.2\:.html>\&. اگر شناسه \fIoffset\fP برابر با \fI\-1\fP باشد،
مکان آفست فعلی فایل استفاده و به‌روزرسانی می‌شود.
.sp
\fBهشدار:\fP
.INDENT 7.0
.INDENT 3.5
در ویندوز، تحت محیط‌های غیر MSVC (مثلاً هنگامی که از GCC یا Clang برای
ساخت libuv استفاده می‌شود)، فایل‌های بازشده با \fBUV_FS_O_FILEMAP\fP در صورت شکست
عملیات خواندن با نگاشت حافظه ممکن است موجب کرش مهلک شوند.
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_unlink(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل unlink(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:unlink\:.2\:.html>\&.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_write(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> file, const uv_buf_t \%<#\:c\:.uv_buf_t> bufs[], unsigned int nbufs, int64_t offset, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل pwritev(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:pwritev\:.2\:.html>\&. اگر شناسه \fIoffset\fP برابر با \fI\-1\fP باشد،
مکان آفست فعلی فایل استفاده و به‌روزرسانی می‌شود.
.sp
\fBهشدار:\fP
.INDENT 7.0
.INDENT 3.5
در ویندوز، تحت محیط‌های غیر MSVC (مثلاً هنگامی که از GCC یا Clang برای
ساخت libuv استفاده می‌شود)، فایل‌های بازشده با \fBUV_FS_O_FILEMAP\fP در صورت شکست
عملیات نوشتن با نگاشت حافظه ممکن است موجب کرش مهلک شوند.
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_mkdir(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, int mode, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل mkdir(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:mkdir\:.2\:.html>\&.
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
در حال حاضر \fImode\fP در ویندوز پیاده‌سازی نشده است.
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_mkdtemp(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *tpl, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل mkdtemp(3) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man3/\:mkdtemp\:.3\:.html>\&. نتیجه را می‌توان به‌صورت یک رشته خاتمه‌یافته با null در \fIreq\->path\fP یافت.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_mkstemp(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *tpl, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل mkstemp(3) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man3/\:mkstemp\:.3\:.html>\&. مسیر فایل ایجادشده را می‌توان به‌صورت یک رشته خاتمه‌یافته با null در \fIreq\->path\fP یافت.
توصیف‌کننده فایل (file descriptor) را می‌توان به‌صورت یک عدد صحیح در \fIreq\->result\fP یافت.
.sp
افزوده‌شده در نسخه 1.34.0.

.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_rmdir(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل rmdir(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:rmdir\:.2\:.html>\&.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_opendir(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
مسیر \fIpath\fP را به‌عنوان یک جریان دایرکتوری باز می‌کند. در صورت موفقیت، یک \fIuv_dir_t\fP تخصیص
یافته و از طریق \fIreq\->ptr\fP برگردانده می‌شود. این حافظه توسط
\fIuv_fs_req_cleanup()\fP آزاد نمی‌شود، هرچند \fIreq\->ptr\fP روی \fINULL\fP تنظیم می‌گردد. حافظه
تخصیص‌یافته باید با فراخوانی \fIuv_fs_closedir()\fP آزاد شود. در صورت شکست، هیچ حافظه‌ای
تخصیص نمی‌یابد.
.sp
می‌توان با ارسال \fIuv_dir_t\fP حاصل به \fIuv_fs_readdir()\fP روی محتویات دایرکتوری
پیمایش کرد.
.sp
افزوده‌شده در نسخه 1.28.0.

.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_closedir(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_dir_t \%<#\:c\:.uv_dir_t> *dir, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
جریان دایرکتوری مشخص‌شده با \fIdir\fP را می‌بندد و حافظه
تخصیص‌یافته توسط \fIuv_fs_opendir()\fP را آزاد می‌کند.
.sp
افزوده‌شده در نسخه 1.28.0.

.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_readdir(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_dir_t \%<#\:c\:.uv_dir_t> *dir, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
روی جریان دایرکتوری \fIdir\fP که از یک فراخوانی موفق
\fIuv_fs_opendir()\fP بازگردانده شده، پیمایش می‌کند. پیش از فراخوانی \fIuv_fs_readdir()\fP، فراخواننده
باید \fIdir\->dirents\fP و \fIdir\->nentries\fP را تنظیم کند که نشان‌دهنده آرایه‌ای از
عناصر \fBuv_dirent_t\fP مورد استفاده برای نگهداری مدخل‌های خوانده‌شده دایرکتوری و
اندازه آن است.
.sp
در صورت موفقیت، نتیجه یک عدد صحیح >= 0 است که تعداد مدخل‌های خوانده‌شده از جریان
را نشان می‌دهد.
.sp
افزوده‌شده در نسخه 1.28.0.

.sp
\fBهشدار:\fP
.INDENT 7.0
.INDENT 3.5
تابع \fIuv_fs_readdir()\fP از نظر ریسه ایمن نیست (thread safe نمی‌باشد).
.UNINDENT
.UNINDENT
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
این تابع مدخل‌های \(dq.\(dq و \(dq..\(dq را برنمی‌گرداند.
.UNINDENT
.UNINDENT
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
در صورت موفقیت، این تابع حافظه‌ای تخصیص می‌دهد که باید با استفاده از
\fIuv_fs_req_cleanup()\fP آزاد شود. \fIuv_fs_req_cleanup()\fP باید قبل از
بستن دایرکتوری با \fIuv_fs_closedir()\fP فراخوانی شود.
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_scandir(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, int flags, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_scandir_next(uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_dirent_t \%<#\:c\:.uv_dirent_t> *ent)
معادل scandir(3) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man3/\:scandir\:.3\:.html>، با یک API کمی متفاوت. پس از فراخوانی
کالبک برای درخواست، کاربر می‌تواند از \fBuv_fs_scandir_next()\fP برای پر کردن
\fIent\fP با داده‌های مدخل بعدی دایرکتوری استفاده کند. هنگامی که مدخل دیگری وجود
نداشته باشد، \fBUV_EOF\fP بازگردانده خواهد شد.
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
برخلاف \fIscandir(3)\fP، این تابع مدخل‌های \(dq.\(dq و \(dq..\(dq را برنمی‌گرداند.
.UNINDENT
.UNINDENT
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
در لینوکس، دریافت نوع یک مدخل تنها توسط برخی از سیستم‌های فایل پشتیبانی می‌شود (btrfs، ext2،
ext3 و ext4 در زمان نگارش این متن)؛ صفحه راهنمای getdents(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:getdents\:.2\:.html> را بررسی کنید.
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_stat(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_fstat(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> file, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_lstat(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
به‌ترتیب معادل stat(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:stat\:.2\:.html>، fstat(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:fstat\:.2\:.html> و lstat(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:lstat\:.2\:.html>\&.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_statfs(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل statfs(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:statfs\:.2\:.html>\&. در صورت موفقیت، یک \fIuv_statfs_t\fP تخصیص
یافته و از طریق \fIreq\->ptr\fP برگردانده می‌شود. این حافظه توسط \fIuv_fs_req_cleanup()\fP آزاد می‌شود.
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
هر فیلدی در \fIuv_statfs_t\fP حاصل که توسط سیستم‌عامل زیربنایی پشتیبانی نشود،
روی صفر تنظیم می‌گردد.
.UNINDENT
.UNINDENT
.sp
افزوده‌شده در نسخه 1.31.0.

.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_rename(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, const char *new_path, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل rename(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:rename\:.2\:.html>\&.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_fsync(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> file, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل fsync(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:fsync\:.2\:.html>\&.
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
برای AIX، تابع \fIuv_fs_fsync\fP روی توصیف‌کننده‌های فایلی که به فایل‌های
عادی اشاره نمی‌کنند، \fIUV_EBADF\fP را برمی‌گرداند.
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_fdatasync(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> file, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل fdatasync(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:fdatasync\:.2\:.html>\&.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_ftruncate(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> file, int64_t offset, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل ftruncate(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:ftruncate\:.2\:.html>\&.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_copyfile(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, const char *new_path, int flags, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
فایلی را از \fIpath\fP به \fInew_path\fP کپی می‌کند. \fIflags\fP پشتیبانی‌شده در زیر شرح داده شده‌اند.
.INDENT 7.0
.IP \(bu 2
\fIUV_FS_COPYFILE_EXCL\fP: در صورت وجود، اگر مسیر مقصد از قبل وجود داشته باشد،
\fIuv_fs_copyfile()\fP با خطای \fIUV_EEXIST\fP شکست می‌خورد. رفتار پیش‌فرض
بازنویسی روی مقصد در صورت وجود آن است.
.IP \(bu 2
\fIUV_FS_COPYFILE_FICLONE\fP: در صورت وجود، \fIuv_fs_copyfile()\fP تلاش می‌کند
یک پیوند مجدد کپی هنگام نوشتن (copy\-on\-write reflink) ایجاد کند. اگر پلتفرم
زیربنایی از copy\-on\-write پشتیبانی نکند یا هنگام تلاش برای استفاده از آن
خطایی رخ دهد، یک مکانیزم کپی جایگزین بر پایه
\fBuv_fs_sendfile()\fP استفاده می‌شود.
.IP \(bu 2
\fIUV_FS_COPYFILE_FICLONE_FORCE\fP: در صورت وجود، \fIuv_fs_copyfile()\fP تلاش
می‌کند یک پیوند مجدد کپی هنگام نوشتن (copy\-on\-write reflink) ایجاد کند. اگر
پلتفرم زیربنایی از copy\-on\-write پشتیبانی نکند یا هنگام تلاش برای استفاده از
آن خطایی رخ دهد، یک خطا بازگردانده می‌شود.
.UNINDENT
.sp
\fBهشدار:\fP
.INDENT 7.0
.INDENT 3.5
اگر مسیر مقصد ایجاد شود اما هنگام کپی کردن داده‌ها خطایی رخ دهد،
مسیر مقصد حذف می‌گردد. بازه زمانی کوتاهی میان بستن و حذف فایل
وجود دارد که در آن فرآیند دیگری می‌تواند به فایل دسترسی پیدا کند.
.UNINDENT
.UNINDENT
.sp
افزوده‌شده در نسخه 1.14.0.

.sp
تغییریافته در نسخه 1.20.0: \fIUV_FS_COPYFILE_FICLONE\fP و
\fIUV_FS_COPYFILE_FICLONE_FORCE\fP پشتیبانی می‌شوند.

.sp
تغییریافته در نسخه 1.33.0: اگر هنگام استفاده از
\fIUV_FS_COPYFILE_FICLONE_FORCE\fP خطایی رخ دهد، همان خطا بازگردانده می‌شود. پیش از این،
تمام خطاها به \fIUV_ENOTSUP\fP نگاشت می‌شدند.

.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_sendfile(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> out_fd, uv_file \%<#\:c\:.uv_file> in_fd, int64_t in_offset, size_t length, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل محدود sendfile(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:sendfile\:.2\:.html>\&.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_access(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, int mode, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل access(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:access\:.2\:.html> در یونیکس. ویندوز از \fBGetFileAttributesW()\fP استفاده می‌کند.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_chmod(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, int mode, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_fchmod(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> file, int mode, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
به‌ترتیب معادل chmod(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:chmod\:.2\:.html> و fchmod(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:fchmod\:.2\:.html>\&.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_utime(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, double atime, double mtime, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_futime(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> file, double atime, double mtime, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_lutime(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, double atime, double mtime, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
به‌ترتیب معادل utime(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:utime\:.2\:.html>، futimes(3) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man3/\:futimes\:.3\:.html> و lutimes(3) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man3/\:lutimes\:.3\:.html>\&.
.sp
ارسال \fIUV_FS_UTIME_NOW\fP به‌عنوان atime یا mtime، برچسب زمانی را روی
زمان فعلی تنظیم می‌کند.
.sp
ارسال \fIUV_FS_UTIME_OMIT\fP به‌عنوان atime یا mtime، برچسب زمانی را
دست‌نخورده باقی می‌گذارد.
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
سیستم‌عامل z/OS: تابع \fIuv_fs_lutime()\fP برای z/OS پیاده‌سازی نشده است. همچنان می‌توان آن را فراخوانی کرد اما
\fBUV_ENOSYS\fP را برمی‌گرداند.
.UNINDENT
.UNINDENT
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
سیستم‌عامل AIX: توابع \fIuv_fs_futime()\fP و \fIuv_fs_lutime()\fP تنها برای AIX 7.1 و جدیدتر کار می‌کنند.
در نسخه‌های قدیمی‌تر همچنان می‌توان آنها را فراخوانی کرد اما \fBUV_ENOSYS\fP را برمی‌گردانند.
.UNINDENT
.UNINDENT
.sp
تغییریافته در نسخه 1.10.0: دقت زیر یک ثانیه (sub\-second precision) در ویندوز پشتیبانی می‌شود.

.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_link(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, const char *new_path, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل link(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:link\:.2\:.html>\&.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_symlink(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, const char *new_path, int flags, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل symlink(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:symlink\:.2\:.html>\&.
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
در ویندوز می‌توان پارامتر \fIflags\fP را برای کنترل نحوه ایجاد پیوند نمادین (symlink)
مشخص کرد:
.INDENT 0.0
.INDENT 3.5
.INDENT 0.0
.IP \(bu 2
\fBUV_FS_SYMLINK_DIR\fP: نشان می‌دهد که \fIpath\fP به یک دایرکتوری اشاره می‌کند.
.IP \(bu 2
\fBUV_FS_SYMLINK_JUNCTION\fP: درخواست می‌کند که پیوند نمادین با استفاده
از نقاط اتصال (junction points) ایجاد شود.
.UNINDENT
.UNINDENT
.UNINDENT
.UNINDENT
.UNINDENT
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_readlink(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل readlink(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:readlink\:.2\:.html>\&.
رشته حاصل در \fIreq\->ptr\fP ذخیره می‌شود.
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_realpath(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
معادل realpath(3) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man3/\:realpath\:.3\:.html> در یونیکس. ویندوز از GetFinalPathNameByHandleW \%<https://\:docs\:.microsoft\:.com/\:en-us/\:windows/\:win32/\:api/\:fileapi/\:nf-fileapi-getfinalpathnamebyhandlew> استفاده می‌کند.
رشته حاصل در \fIreq\->ptr\fP ذخیره می‌شود.
.sp
\fBهشدار:\fP
.INDENT 7.0
.INDENT 3.5
این تابع دارای هشدارهای خاص پلتفرم است که هنگام استفاده در Node کشف شدند.
.INDENT 0.0
.IP \(bu 2
سیستم‌های macOS و سایر BSDها: اگر هنگام حل مسیر داده‌شده بیش از ۳۲ پیوند نمادین پیدا شود، این تابع با خطای UV_ELOOP شکست می‌خورد. این محدودیت به‌صورت سراسری و ثابت است و نمی‌توان آن را دور زد.
.IP \(bu 2
ویندوز: در حالی که این تابع در حالت‌های معمول کار می‌کند، تعدادی حالت مرزی (corner case) وجود دارد که در آنها کار نمی‌کند:
.INDENT 2.0
.IP \(bu 2
مسیرهای درون حجم‌های رم‌دیسک (ramdisk) ایجادشده توسط ابزارهایی که مدیر حجم (Volume Manager) را دور می‌زنند (مانند ImDisk) قابل حل نیستند.
.IP \(bu 2
بزرگ و کوچک بودن ناهمخوان حروف در هنگام استفاده از حروف درایو (drive letters).
.IP \(bu 2
مسیر حل‌شده درایوهای subst شده را دور می‌زند.
.UNINDENT
.UNINDENT
.sp
اگرچه همچنان می‌توان از این تابع استفاده کرد، اما در صورتی که نیاز به پشتیبانی از سناریوهایی مانند موارد بالا باشد، استفاده از آن توصیه نمی‌شود.
.sp
داستان پیش‌زمینه و جزئیات بیشتر در مورد این مشکلات را می‌توان در اینجا \%<https://\:github\:.com/\:nodejs/\:node/\:issues/\:7726> بررسی کرد.
.UNINDENT
.UNINDENT
.sp
افزوده‌شده در نسخه 1.8.0.

.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_chown(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, uv_uid_t uid, uv_gid_t gid, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_fchown(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, uv_file \%<#\:c\:.uv_file> file, uv_uid_t uid, uv_gid_t gid, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
.UNINDENT
.INDENT 0.0
.TP
.B int uv_fs_lchown(uv_loop_t \%<#\:c\:.uv_loop_t> *loop, uv_fs_t \%<#\:c\:.uv_fs_t> *req, const char *path, uv_uid_t uid, uv_gid_t gid, uv_fs_cb \%<#\:c\:.uv_fs_cb> cb)
به‌ترتیب معادل chown(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:chown\:.2\:.html>، fchown(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:fchown\:.2\:.html> و lchown(2) \%<https://\:man7\:.org/\:linux/\:man-pages/\:man2/\:lchown\:.2\:.html>\&.
.sp
\fBنکته:\fP
.INDENT 7.0
.INDENT 3.5
این توابع در ویندوز پیاده‌سازی نشده‌اند.
.UNINDENT
.UNINDENT
.sp
تغییریافته در نسخه 1.21.0: تابع uv_fs_lchown پیاده‌سازی شد.

.UNINDENT
.INDENT 0.0
.TP
.B uv_fs_type \%<#\:c\:.uv_fs_type> uv_fs_get_type(const uv_fs_t \%<#\:c\:.uv_fs_t> *req)
مقدار \fIreq\->fs_type\fP را برمی‌گرداند.
