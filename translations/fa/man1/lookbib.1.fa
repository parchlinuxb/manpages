.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_lookbib_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY \%lookbib
.RB [ \-i\~\c
.IR string ]
.RB [ \-t\~\c
.IR n ]
.I file
\&.\|.\|.\&
.YS
.
.
.P
.SY \%lookbib
.B \-\-help
.YS
.
.
.P
.SY \%lookbib
.B \-v
.YS
.
.SY \%lookbib
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
دستور
.I \%lookbib
یک اعلان را در جریان خطای استاندارد می‌نویسد
(مگر اینکه جریان ورودی استاندارد
یک پایانه نباشد)،
یک سطر حاوی مجموعه‌ای از کلیدواژه‌ها را از ورودی استاندارد می‌خواند،
هر پایگاه داده کتاب‌شناختی
.I file
را برای یافتن ارجاعاتی شامل آن کلیدواژه‌ها جستجو می‌کند،
هر ارجاع یافته‌شده را در جریان خروجی استاندارد می‌نویسد،
و این فرآیند را تا پایان ورودی تکرار می‌کند.
.
به ازای هر پایگاه داده
.I file
که باید جستجو شود،
اگر یک نمایه
.RI file \%.i
ایجادشده توسط
.MR \%indxbib 1
وجود داشته باشد،
به جای آن، نمایه جستجو خواهد شد؛
هر نمایه می‌تواند چندین پایگاه داده را پوشش دهد.
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
.B \-\-help
یک پیام راهنمای استفاده نمایش می‌دهد،
در حالی که
.B \-v
و
.B \%\-\-version
اطلاعات نسخه را نشان می‌دهند؛
سپس همگی خارج می‌شوند.
.
.
.TP
.BI \-i\~ string
هنگام جستجو در فایل‌هایی که هیچ نمایه‌ای برای آن‌ها وجود ندارد،
محتوای فیلدهایی را که نام آن‌ها در
.IR string
آمده است نادیده می‌گیرد.
.
.
.TP
.BI \-t\~ n
تنها مشخص کردن
.I n
نویسه نخست از کلیدها را الزامی می‌کند.
.
مقدار پیش‌فرض
\~6 است.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
دستور
.I \%lookbib
در صورت اجرای موفقیت‌آمیز با وضعیت
.BR 0 ،
اگر نتواند آرگومان‌های خط فرمان را تفسیر کند با وضعیت
.BR 2 ،
و در صورت مواجهه با خطا در حین اجرا با وضعیت
.B 1
خارج می‌شود.
.
.
.\" ====================================================================
.SH "فایل‌ها (FILES)"
.\" ====================================================================
.
.TP
.RI file \%.i
فایل‌های نمایه.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
\[lq]Some Applications of Inverted Indexes on the Unix System\[rq],
by M.\& E.\& Lesk,
1978,
AT&T Bell Laboratories Computing Science Technical Report No.\& 69.
.
.
.LP
.MR \%refer 1 ،
.MR lkbib 1 ،
.MR \%indxbib 1
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_lookbib_1_man_C]
.do rr *groff_lookbib_1_man_C
.
