.TH "storescu" 1 "Thu Jul 9 2026 18:43:40" "Version 3.7.0" "OFFIS DCMTK" \" -*- nroff -*-
.nh
.SH "نام (NAME)"
storescu \- سرویس‌گیرنده ذخیره‌سازی دایکام (C-STORE SCU)
.PP

.SH "خلاصه دستور (SYNOPSIS)"
.PP
.PP
.nf
storescu [options] peer port dcmfile-in\&.\&.\&.
.fi
.PP
.SH "توضیحات (DESCRIPTION)"
.PP
برنامه \fBstorescu\fP یک کاربر رده سرویس (SCU) برای رده سرویس ذخیره‌سازی (Storage Service Class) پیاده‌سازی می‌کند\&. برای هر فایل DICOM در خط فرمان، این برنامه یک پیام C-STORE به ارائه‌دهنده رده سرویس ذخیره‌سازی (SCP) ارسال می‌کند و منتظر پاسخ می‌ماند\&. از این برنامه می‌توان برای انتقال تصاویر DICOM و سایر اشیاء ترکیبی DICOM استفاده کرد\&.
.SH "پارامترها (PARAMETERS)"
.PP
.PP
.nf
peer        hostname of DICOM peer

port        tcp/ip port number of peer

dcmfile-in  DICOM file or directory to be transmitted
.fi
.PP
.PP
.TP
.I peer
نام میزبان (hostname) سامانه DICOM مقصد
.TP
.I port
شماره پورت TCP/IP سامانه مقصد
.TP
.I dcmfile-in
فایل یا دایرکتوری DICOM برای ارسال
.PP
.SH "گزینه‌ها (OPTIONS)"
.PP
.SS "گزینه‌های عمومی (general options)"
.PP
.nf
  -h    --help
          چاپ این متن راهنما و خروج

        --version
          چاپ اطلاعات نسخه و خروج

        --arguments
          چاپ آرگومان‌های بسط‌یافته خط فرمان

  -q    --quiet
          حالت بی‌صدا، عدم چاپ هشدارها و خطاها

  -v    --verbose
          حالت پرگو، چاپ جزئیات پردازش

  -d    --debug
          حالت اشکال‌زدایی، چاپ اطلاعات اشکال‌زدایی

  -ll   --log-level  [l]evel: string constant
          (fatal, error, warn, info, debug, trace)
          استفاده از سطح l برای ثبت وقایع

  -lc   --log-config  [f]ilename: string
          استفاده از فایل پیکربندی f برای ثبت وقایع

  +v    --verbose-pc
          نمایش زمینه‌های ارائه (presentation contexts) در حالت پرگو
.fi
.PP
.SS "گزینه‌های ورودی (input options)"
.PP
.nf
قالب فایل ورودی:

  +f    --read-file
          خواندن قالب فایل یا مجموعه داده (پیش‌فرض)

  +fo   --read-file-only
          فقط خواندن قالب فایل

  -f    --read-dataset
          خواندن مجموعه داده بدون اطلاعات متای فایل

فایل‌های ورودی:

  +sd   --scan-directories
          پویش دایرکتوری‌ها برای فایل‌های ورودی (dcmfile-in)

  +sp   --scan-pattern  [p]attern: string (فقط با --scan-directories)
          الگو برای تطبیق نام فایل (حروف عام / wildcards)

          # احتمالاً در همه سیستم‌ها در دسترس نیست

  -r    --no-recurse
          عدم پیمایش بازگشتی در دایرکتوری‌ها (پیش‌فرض)

  +r    --recurse
          پیمایش بازگشتی در دایرکتوری‌های مشخص‌شده

  -rn   --no-rename
          عدم تغییر نام فایل‌های پردازش‌شده (پیش‌فرض)

  +rn   --rename
          افزودن \&.done/\&.bad به انتهای نام فایل‌های پردازش‌شده
.fi
.PP
.SS "گزینه‌های شبکه (network options)"
.PP
.nf
نسخه پروتکل IP:

  -i4   --ipv4
          فقط استفاده از IPv4 (پیش‌فرض)

  -i6   --ipv6
          فقط استفاده از IPv6

  -i0   --ip-auto
          استفاده از جستجوی DNS برای تعیین پروتکل IP

عناوین موجودیت کاربردی (AE Titles):

  -aet  --aetitle  [a]etitle: string
          تنظیم عنوان AE فراخواننده من (پیش‌فرض: STORESCU)

  -aec  --call  [a]etitle: string
          تنظیم عنوان AE فراخوانده‌شده مقصد (پیش‌فرض: ANY-SCP)

پروفایل مذاکره ارتباط از فایل پیکربندی:

  -xf   --config-file  [f]ilename, [p]rofile: string
          استفاده از پروفایل p از فایل پیکربندی f

سینتکس‌های انتقال پیشنهادی (همراه با --config-file استفاده نشود):

  -x=   --propose-uncompr
          پیشنهاد تمام TSهای فشرده‌نشده، ابتدا VR صریح
          با ترتیب بایت محلی (پیش‌فرض)

  -xe   --propose-little
          پیشنهاد تمام TSهای فشرده‌نشده، ابتدا VR صریح با ترتیب little endian

  -xb   --propose-big
          پیشنهاد تمام TSهای فشرده‌نشده، ابتدا VR صریح با ترتیب big endian

  -xi   --propose-implicit
          فقط پیشنهاد TS با VR ضمنی و little endian

  -xs   --propose-lossless
          پیشنهاد TS پیش‌فرض بدون اتلاف JPEG
          و تمام سینتکس‌های انتقال فشرده‌نشده

  -xy   --propose-jpeg8
          پیشنهاد TS پیش‌فرض با اتلاف JPEG برای داده‌های ۸ بیتی
          و تمام سینتکس‌های انتقال فشرده‌نشده

  -xx   --propose-jpeg12
          پیشنهاد TS پیش‌فرض با اتلاف JPEG برای داده‌های ۱۲ بیتی
          و تمام سینتکس‌های انتقال فشرده‌نشده

  -xv   --propose-j2k-lossless
          پیشنهاد TS بدون اتلاف JPEG 2000
          و تمام سینتکس‌های انتقال فشرده‌نشده

  -xw   --propose-j2k-lossy
          پیشنهاد TS با اتلاف JPEG 2000
          و تمام سینتکس‌های انتقال فشرده‌نشده

  -xt   --propose-jls-lossless
          پیشنهاد TS بدون اتلاف JPEG-LS
          و تمام سینتکس‌های انتقال فشرده‌نشده

  -xu   --propose-jls-lossy
          پیشنهاد TS با اتلاف JPEG-LS
          و تمام سینتکس‌های انتقال فشرده‌نشده

  -xm   --propose-mpeg2
          فقط پیشنهاد TS مربوط به MPEG2 Main Profile @ Main Level

  -xh   --propose-mpeg2-high
          فقط پیشنهاد TS مربوط به MPEG2 Main Profile @ High Level

  -xn   --propose-mpeg4
          فقط پیشنهاد TS مربوط به MPEG4 AVC/H\&.264 High Profile / Level 4\&.1

  -xl   --propose-mpeg4-bd
          فقط پیشنهاد TS مربوط به MPEG4 AVC/H\&.264 BD-compatible HP / Level 4\&.1

  -x2   --propose-mpeg4-2-2d
          فقط پیشنهاد TS مربوط به MPEG4 AVC/H\&.264 HP / Level 4\&.2 برای ویدیوهای دو بعدی (2D)

  -x3   --propose-mpeg4-2-3d
          فقط پیشنهاد TS مربوط به MPEG4 AVC/H\&.264 HP / Level 4\&.2 برای ویدیوهای سه بعدی (3D)

  -xo   --propose-mpeg4-2-st
          فقط پیشنهاد TS مربوط به MPEG4 AVC/H\&.264 Stereo HP / Level 4\&.2

  -x4   --propose-hevc
          فقط پیشنهاد TS مربوط به HEVC/H\&.265 Main Profile / Level 5\&.1

  -x5   --propose-hevc10
          فقط پیشنهاد TS مربوط به HEVC/H\&.265 Main Profile / Level 5\&.1

  -xr   --propose-rle
          پیشنهاد TS بدون اتلاف RLE
          و تمام سینتکس‌های انتقال فشرده‌نشده

  -xd   --propose-deflated
          پیشنهاد TS با VR صریح و little endian فشرده‌شده با الگوریتم deflated
          و تمام سینتکس‌های انتقال فشرده‌نشده

  -R    --required
          فقط پیشنهاد زمینه‌های ارائه الزامی
          (پیش‌فرض: پیشنهاد تمام موارد پشتیبانی‌شده)

          # این گزینه همچنین با رده‌های SOP ذخیره‌سازی که توسط DCMTK
          # پشتیبانی می‌شوند اما در فهرست رده‌های SOP پیش‌فرض نیستند کار می‌کند\&.

  +C    --combine
          ترکیب سینتکس‌های انتقال پیشنهادی
          (پیش‌فرض: زمینه ارائه جداگانه برای هر TS)

نمایش مقادیر بعد از ۱۹۹۳ (VR):

  +u    --enable-new-vr
          فعال‌سازی پشتیبانی از VRهای جدید (UN/UT) (پیش‌فرض)

  -u    --disable-new-vr
          غیرفعال‌سازی پشتیبانی از VRهای جدید، تبدیل به OB

سطح فشرده‌سازی deflate (فقط همراه با --propose-deflated یا --config-file):

  +cl   --compression-level  [l]evel: integer (پیش‌فرض: 6)
          0=فشرده‌نشده، 1=سریع‌ترین، 9=بهترین فشرده‌سازی

مذاکره هویت کاربر:

  -usr  --user  [u]ser name: string
          احراز هویت با استفاده از نام کاربری u

  -pwd  --password  [p]assword: string (فقط با --user)
          احراز هویت با استفاده از گذرواژه p

  -epw  --empty-password
          ارسال گذرواژه خالی (فقط با --user)

  -kt   --kerberos  [f]ilename: string
          خواندن بلیت کربروس (Kerberos) از فایل f

        --saml  [f]ilename: string
          خواندن درخواست SAML از فایل f

        --jwt  [f]ilename: string
          خواندن داده‌های JWT از فایل f

  -rsp  --pos-response
          انتظار پاسخ مثبت

سایر گزینه‌های شبکه:

  -to   --timeout  [s]econds: integer (پیش‌فرض: نامحدود)
          مهلت زمانی برای درخواست‌های اتصال

  -ts   --socket-timeout  [s]econds: integer (پیش‌فرض: 60)
          مهلت زمانی برای سوکت شبکه (0 برای نامحدود)

  -ta   --acse-timeout  [s]econds: integer (پیش‌فرض: 30)
          مهلت زمانی برای پیام‌های ACSE

  -td   --dimse-timeout  [s]econds: integer (پیش‌فرض: نامحدود)
          مهلت زمانی برای پیام‌های DIMSE

  -pdu  --max-pdu  [n]umber of bytes: integer (4096\&.\&.131072)
          تنظیم حداکثر pdu دریافتی به n بایت (پیش‌فرض: 16384)

        --max-send-pdu  [n]umber of bytes: integer (4096\&.\&.131072)
          محدود کردن حداکثر pdu ارسالی به n بایت

        --repeat  [n]umber: integer
          تکرار به تعداد n بار

        --abort
          قطع اجباری ارتباط (abort) به جای رهاسازی عادی آن

  -nh   --no-halt
          عدم توقف در صورت مواجهه با ذخیره‌سازی ناموفق
          (پیش‌فرض: متوقف شود)

  -up   --uid-padding
          اصلاح بی‌سرصدای UIDهای پرشده با فاصله

  +II   --invent-instance
          تولید یک SOP instance UID جدید برای هر تصویر ارسالی

  +IR   --invent-series  [n]umber: integer (شامل --invent-instance می‌شود)
          تولید یک شناسه سری (series UID) جدید پس از ارسال n تصویر
          (پیش‌فرض: 100)

  +IS   --invent-study  [n]umber: integer (شامل --invent-instance می‌شود)
          تولید یک شناسه مطالعه (study UID) جدید پس از ارسال n سری
          (پیش‌فرض: 50)

  +IP   --invent-patient  [n]umber: integer (شامل --invent-instance می‌شود)
          تولید یک شناسه و نام بیمار جدید پس از ارسال n مطالعه
          (پیش‌فرض: 25)
.fi
.PP
.SS "گزینه‌های امنیت لایه انتقال (TLS)"
.PP
.nf
پشته پروتکل انتقال:

  -tls  --disable-tls
          استفاده از اتصال عادی TCP/IP (پیش‌فرض)

  +tls  --enable-tls  [p]rivate key file, [c]ertificate file: string
          استفاده از اتصال امن و احرازهویت‌شده TLS

  +tla  --anonymous-tls
          استفاده از اتصال امن TLS بدون گواهی

گذرواژه کلید خصوصی (فقط با --enable-tls):

  +ps   --std-passwd
          درخواست از کاربر برای وارد کردن گذرواژه در ورودی استاندارد (پیش‌فرض)

  +pw   --use-passwd  [p]assword: string
          استفاده از گذرواژه مشخص‌شده

  -pw   --null-passwd
          استفاده از رشته خالی به عنوان گذرواژه

قالب فایل کلید و گواهی:

  -pem  --pem-keys
          خواندن کلیدها و گواهی‌ها در قالب فایل PEM (پیش‌فرض)

  -der  --der-keys
          خواندن کلیدها و گواهی‌ها در قالب فایل DER

مرجع صدور گواهی (CA):

  +cf   --add-cert-file  [f]ilename: string
          افزودن فایل گواهی به فهرست گواهی‌ها

  +cd   --add-cert-dir  [d]irectory: string
          افزودن گواهی‌های موجود در پوشه d به فهرست گواهی‌ها

  +crl  --add-crl-file  [f]ilename: string
          افزودن فایل فهرست ابطال گواهی (CRL)
          (شامل --enable-crl-vfy می‌شود)

  +crv  --enable-crl-vfy
          فعال‌سازی اعتبارسنجی CRL برای گواهی نهایی (leaf)

  +cra  --enable-crl-all
          فعال‌سازی اعتبارسنجی CRL برای کل زنجیره گواهی

پروفایل امنیتی:

  +ph   --list-profiles
          فهرست کردن پروفایل‌های TLS پشتیبانی‌شده و خروج

  +pg   --profile-8996
          پروفایل BCP 195 RFC 8996 TLS (پیش‌فرض)

  +pm   --profile-8996-mod
          پروفایل اصلاح‌شده BCP 195 RFC 8996 TLS

          # فقط در صورتی در دسترس است که کتابخانه زیربنایی TLS از
          # تمام ویژگی‌های TLS مورد نیاز این پروفایل پشتیبانی کند

  +py   --profile-bcp195-nd
          پروفایل بدون تنزل BCP 195 TLS (منسوخ‌شده)

  +px   --profile-bcp195
          پروفایل BCP 195 TLS (منسوخ‌شده)

  +pz   --profile-bcp195-ex
          پروفایل توسعه‌یافته BCP 195 TLS (منسوخ‌شده)

  +pb   --profile-basic
          پروفایل اتصال امن انتقال پایه‌ای TLS (منسوخ‌شده)

          # فقط در صورتی در دسترس است که کتابخانه زیربنایی TLS از 3DES پشتیبانی کند

  +pa   --profile-aes
          پروفایل اتصال امن انتقال AES TLS (منسوخ‌شده)

  +pn   --profile-null
          ارتباط بدون رمزنگاری با احراز هویت
          (منسوخ‌شده، قبلاً در IHE ATNA استفاده می‌شد)

مجموعه الگوریتم‌های رمزنگاری (ciphersuite):

  +cc   --list-ciphers
          فهرست کردن مجموعه‌های رمزنگاری TLS پشتیبانی‌شده و خروج

  +cs   --cipher  [c]iphersuite name: string
          افزودن مجموعه رمزنگاری c به فهرست مجموعه‌های مذاکره‌شده

مشخص‌کننده نام سرور (SNI):

        --no-sni
          عدم استفاده از SNI (پیش‌فرض)

        --request-sni  [s]erver name: string
          درخواست نام سرور s

تولیدکننده اعداد شبه‌تصادفی:

  +rs   --seed  [f]ilename: string
          مقداردهی اولیه تولیدکننده تصادفی با محتوای f

  +ws   --write-seed
          بازنویسی بذر مقداردهی اولیه تغییریافته (فقط با --seed)

  +wf   --write-seed-file  [f]ilename: string (فقط با --seed)
          نوشتن بذر مقداردهی اولیه تغییریافته در فایل f

احراز هویت طرف مقابل (peer):

  -rc   --require-peer-cert
          بررسی گواهی طرف مقابل، در صورت عدم وجود با شکست مواجه شود (پیش‌فرض)

  -ic   --ignore-peer-cert
          عدم بررسی گواهی طرف مقابل
.fi
.PP
.SH "نکات (NOTES)"
.PP
.SS "پویش دایرکتوری‌ها (Scanning Directories)"
افزودن دایرکتوری‌ها به عنوان پارامتر در خط فرمان فقط زمانی معنادار است که گزینه
.I \-\-scan\-directories
نیز داده شده باشد\&. اگر فایل‌های موجود در دایرکتوری‌های ارائه‌شده باید طبق یک الگوی نام خاص (مثلاً با استفاده از تطبیق حروف عام یا wildcard) انتخاب شوند، گزینه
.I \-\-scan\-pattern
باید به کار رود\&. لطفاً توجه داشته باشید که این الگوی فایل فقط برای فایل‌های درون دایرکتوری‌های پویش‌شده اعمال می‌شود و چنانچه الگوهای دیگری در خط فرمان خارج از گزینه
.I \-\-scan\-pattern
مشخص شوند (مثلاً برای انتخاب فایل‌های بیشتر)، این الگوها بر روی دایرکتوری‌های مشخص‌شده اعمال نخواهند شد\&.
.SS "انطباق با دایکام (DICOM Conformance)"
برنامه \fBstorescu\fP از رده‌های SOP ذخیره‌سازی زیر در نقش SCU پشتیبانی می‌کند:

.PP
.PP
.nf
ComputedRadiographyImageStorage                      1\&.2\&.840\&.10008\&.5\&.1\&.4\&.1\&.1\&.1
DigitalXRayImageStorageForPresentation               1\&.2\&.840\&.10008\&.5\&.1\&.4\&.1\&.1\&.1\&.1
DigitalXRayImageStorageForProcessing                 1\&.2\&.840\&.10008\&.5\&.1\&.4\&.1\&.1\&.1\&.1\&.1
DigitalMammographyXRayImageStorageForPresentation    1\&.2\&.840\&.10008\&.5\&.1\&.4\&.1\&.1\&.1\&.2
DigitalMammographyXRayImageStorageForProcessing      1\&.2\&.840\&.10008\&.5\&.1\&.4\&.1\&.1\&.1\&.2\&.1
DigitalIntraOralXRayImageStorageForPresentation      1\&.2\&.840\&.10008\&.5\&.1\&.4\&.1\&.1\&.1\&.3
DigitalIntraOralXRayImageStorageForProcessing        1\&.2\&.840\&.10008\&.5\&.1\&.4\&.1\&.1\&.1\&.3\&.1
CTImageStorage                                       1\&.2\&.840\&.10008\&.5\&.1\&.4\&.1\&.1\&.2
