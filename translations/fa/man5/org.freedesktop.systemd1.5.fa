  };
  interface org\&.freedesktop\&.DBus\&.Peer { \&.\&.\&. };
  interface org\&.freedesktop\&.DBus\&.Introspectable { \&.\&.\&. };
  interface org\&.freedesktop\&.DBus\&.Properties { \&.\&.\&. };
  interface org\&.freedesktop\&.systemd1\&.Unit { \&.\&.\&. };
};
.fi
.if n \{\
.RE
.\}
.SS "متدها (Methods)"
.PP
\fBBindMount()\fR
و
\fBMountImage()\fR
همان عملیات متدهای مربوطه روی شیء
Manager
را پیاده‌سازی می‌کنند (بالا را ببینید)\&. با این حال، این متدها روی شیء سرویس عمل می‌کنند و بنابراین پارامتر نام واحد را دریافت نمی‌کنند\&. فراخوانی مستقیم متدها روی شیء Manager این مزیت را دارد که نیازی به فراخوانی
\fBGetUnit()\fR
برای دریافت شیء واحد برای یک نام واحد خاص ندارد\&. بنابراین فراخوانی متدها روی شیء Manager یک بهینه‌سازی در رفت‌و‌برگشت ارتباطی است\&.
.PP
\fBDumpFileDescriptorStore()\fR
آرایه‌ای با اطلاعات مربوط به توصیف‌کننده‌های فایل موجود در مخزن توصیف‌کنندهٔ فایل سرویس برمی‌گرداند\&. هر ورودی شامل یک نام توصیف‌کنندهٔ فایل (یعنی فیلد
\fIFDNAME=\fR)،
نوع inode و حالت دسترسی توصیف‌کنندهٔ فایل به‌عنوان یک عدد صحیح (یعنی یک مقدار
\fBmode_t\fR،
پرچم‌هایی مانند
\fBS_IFREG\fR،
\fBS_IRUSR\fR،
\&...)،
شماره‌های اصلی و فرعی شمارهٔ دستگاهِ سیستم فایلِ پشتیبانِ inode توصیف‌کنندهٔ فایل، شمارهٔ inode، شماره‌های اصلی و فرعی شمارهٔ دستگاه در صورتی که این ورودی به یک گرهٔ دستگاه کاراکتری یا بلوکی اشاره داشته باشد، یک مسیر سیستم فایل اشاره‌کننده به inode، و پرچم‌های توصیف‌کنندهٔ فایل (یعنی
\fBO_RDWR\fR،
\fBO_RDONLY\fR،
\&...)
می‌باشد\&.
.SS "ویژگی‌ها (Properties)"
.PP
بیشتر ویژگی‌های رابط Service مستقیماً به تنظیمات مربوطه در فایل‌های واحد سرویس نگاشت می‌شوند\&. برای رعایت اختصار، در اینجا تنها فهرستی از تمام استثناها آورده شده است:
.PP
\fITimeoutStartUSec\fR،
\fITimeoutStopUSec\fR
و
\fITimeoutAbortUSec\fR
حاوی مهلت‌های زمانی شروع، توقف و لغو بر حسب میکروثانیه هستند\&. به تفاوت جزئی در نام‌گذاری در مقایسه با تنظیمات منطبق در فایل واحد توجه داشته باشید (به
\fBsystemd.service\fR(5)
مراجعه کنید): این ویژگی‌های گذرگاه اکیداً از میکروثانیه استفاده می‌کنند (و در نتیجه دارای پسوند
\fI\&...USec\fR
هستند)، در حالی که تنظیمات فایل واحد به طور پیش‌فرض از واحد زمانی ثانیه استفاده می‌کنند (و در نتیجه دارای پسوند
\fI\&...Sec\fR
هستند)، مگر اینکه واحد دیگری صریحاً مشخص شده باشد\&. این نشان‌دهندهٔ این واقعیت است که مدیر سرویس در درون خود منحصراً با واحدهای میکروثانیه کار می‌کند، و ویژگی‌های گذرگاه یک مفهوم نسبتاً سطح پایین (دودویی) هستند که این موضوع را ارائه می‌دهند\&. از سوی دیگر، تنظیمات فایل واحد مفاهیم نسبتاً سطح بالا (مبتنی بر رشته) هستند و بنابراین از مشخصات زمانی کاربرپسندتری پشتیبانی می‌کنند که به طور پیش‌فرض بر حسب ثانیه است اما در صورت مشخص شدن واحدهای دیگر را نیز مجاز می‌داند\&.
.PP
\fIWatchdogTimestamp\fR
و
\fIWatchdogTimestampMonotonic\fR
حاوی مهرهای زمانی بر حسب میکروثانیهٔ
\fBCLOCK_REALTIME\fR/\fBCLOCK_MONOTONIC\fR
از آخرین پینگ واچ‌داگ دریافت‌شده از سرویس، یا 0 در صورتی که هیچ پینگی دریافت نشده باشد، هستند\&.
.PP
\fIExecStartPre\fR،
\fIExecStart\fR،
\fIExecStartPost\fR،
\fIExecReload\fR،
\fIExecStop\fR
و
\fIExecStop\fR
آرایه‌هایی از ساختارها هستند که هر ساختار شامل موارد زیر است: مسیر باینری برای اجرا؛ یک آرایه شامل تمام آرگومان‌ها برای ارسال به دستور اجراشده، با شروع از آرگومان 0؛ یک مقدار بولی مبنی بر اینکه آیا خروج ناصحیح پردازه باید شکست تلقی شود یا خیر؛ دو جفت مهرزمانی بر حسب میکروثانیهٔ
\fBCLOCK_REALTIME\fR/\fBCLOCK_MONOTONIC\fR
از زمانی که پردازه آخرین بار شروع به اجرا کرده و به پایان رسیده است، یا 0 در صورتی که هرگز اجرا نشده یا هرگز به پایان نرسیده باشد؛ شناسهٔ PID پردازه، یا 0 در صورتی که هنوز اجرا نشده باشد؛ کد خروج و وضعیت آخرین اجرا\&. بنابراین این فیلد کم و بیش به تنظیمات مربوطه در فایل واحد سرویس نگاشت می‌شود اما با داده‌های زمان اجرا تکمیل می‌گردد\&.
.PP
\fILimitCPU\fR
(و ویژگی‌های مرتبط) کم و بیش مستقیماً به تنظیمات مربوطه در فایل‌های واحد سرویس نگاشت می‌شوند، با این تفاوت که اگر تنظیم نشده باشند مقدار آن‌ها 18446744073709551615 (یعنی \-1) است\&.
.PP
\fICapabilities\fR
حاوی قابلیت‌های پیکربندی‌شده است، همان‌طور که با
\fBcap_to_text\fR(3)
قالب‌بندی شده است\&.
.PP
\fISecureBits\fR،
\fICapabilityBoundingSet\fR،
\fIMountFlags\fR
نیز با تنظیمات پیکربندی‌شده در فایل‌های واحد مطابقت دارند، اما به جای اینکه به صورت رشته قالب‌بندی شوند، به صورت پرچم‌های باینری واقعی کدگذاری می‌شوند\&.
.PP
\fIExecMainStartTimestamp\fR،
\fIExecMainStartTimestampMonotonic\fR،
\fIExecMainExitTimestamp\fR،
\fIExecMainExitTimestampMonotonic\fR،
\fIExecMainHandoffTimestamp\fR،
\fIExecMainHandoffTimestampMonotonic\fR،
\fIExecMainPID\fR،
\fIExecMainCode\fR،
\fIExecMainStatus\fR
حاوی اطلاعاتی دربارهٔ پردازهٔ اصلی سرویس تا جایی که شناخته شده است می‌باشند\&. مهرهای زمانی
\fIExecMainStartTimestamp\fR
زمان ایجاد پردازهٔ اصلی سرویس را ثبت می‌کنند\&. مهرهای زمانی
\fIExecMainExitTimestamp\fR
زمانی را ثبت می‌کنند که خروج پردازهٔ اصلی توسط مدیر سرویس تشخیص داده شده است\&. مهرهای زمانی
\fIExecMainHandoffTimestamp\fR
زمانی را ثبت می‌کنند که باینری سرویس در آستانهٔ اجرا توسط
\fBsystemd\-executor\fR
است (این مهرزمانی صرف‌نظر از اینکه فراخوانی سیستمی
\fBexecve()\fR
بلافاصله بعد از آن موفق شود یا با شکست مواجه گردد، ثبت می‌شود)\&. این اغلب همان اطلاعات زمان اجرایی است که برای
\fIExecStart=\fR
نیز نگهداری می‌شود\&. با این حال، برای سرویس‌های با
\fIType=forking\fR
و همچنین سرویس‌هایی که از پیام‌های
\fBsd_notify()\fR
با
\fIMAINPID=\fR
استفاده می‌کنند انحراف دارد، زیرا پردازهٔ اصلی سرویس در آن حالت مستقیماً توسط مدیر سرویس منشعب نمی‌شود\&. این فیلدها یا حاوی اطلاعات آخرین اجرای پردازه هستند یا پردازهٔ در حال اجرای فعلی\&.
.PP
\fIMainPID\fR
و
\fIControlPID\fR
حاوی PID اصلی و کنترلی سرویس هستند\&. مقدار PID اصلی، PID اصلی فعلی سرویس است و هنگامی که سرویس در حال حاضر PID اصلی ندارد، 0 است\&. مقدار PID کنترلی، PID پردازهٔ شروع/توقف/بارگذاری مجدد در حال اجرای فعلی است و در صورتی که چنین پردازه‌ای در حال حاضر اجرا نشود، 0 است\&. این بدان معناست که
\fIExecMainPID\fR
و
\fIMainPID\fR
از این نظر تفاوت دارند که دومی بلافاصله نشان می‌دهد آیا یک پردازهٔ اصلی در حال حاضر در حال اجرا است یا خیر، در حالی که اولی احتمالاً حاوی اطلاعات جمع‌آوری‌شده از آخرین اجرا است حتی اگر پردازه دیگر وجود نداشته باشد\&.
.PP
\fIStatusText\fR،
\fIStatusErrno\fR،
\fIStatusBusError\fR
و
\fIStatusVarlinkError\fR
به ترتیب حاوی متن وضعیت، شمارهٔ خطا و نام خطای D\-Bus/Varlink هستند که از طریق
\fBsd_notify\fR(3)
به مدیر سرویس منتقل شده است\&. آن‌ها ممکن است توسط سرویس‌ها برای مطلع کردن مدیر سرویس از وضعیت داخلی خود استفاده شوند\&.
.PP
\fIResult\fR
نتیجهٔ اجرای آخرین اجرای سرویس را کدگذاری می‌کند\&. این ویژگی برای تعیین دلیل شکست یک سرویس در صورتی که در وضعیت
"failed"
باشد (به
\fIActiveState\fR
در بالا مراجعه کنید) مفید است\&. مقادیر زیر در حال حاضر شناخته شده‌اند:
"success"
در صورتی تنظیم می‌شود که واحد با شکست مواجه نشده باشد\&.
"resources"
نشان می‌دهد که منابع کافی برای انشعاب و اجرای پردازه‌های سرویس در دسترس نبوده است\&.
"timeout"
نشان می‌دهد که هنگام اجرای یک عملیات سرویس، مهلت زمانی به پایان رسیده است\&.
"exit\-code"
نشان می‌دهد که یک پردازهٔ سرویس با یک کد خروج غیرپاک خارج شده است\&.
"signal"
نشان می‌دهد که یک پردازهٔ سرویس با یک سیگنال مدیریت‌نشده خارج شده است\&.
"core\-dump"
نشان می‌دهد که یک پردازهٔ سرویس به طور غیرپاک خارج شده و تخلیهٔ حافظه ایجاد کرده است\&.
"watchdog"
نشان می‌دهد که یک سرویس پیام‌های پینگ واچ‌داگ را به اندازهٔ کافی ارسال نکرده است\&.
"start\-limit\-hit"
نشان می‌دهد که یک سرویس در یک بازهٔ زمانی مشخص بیش از حد مجاز شروع شده است (همان‌طور که در
\fIStartLimitInterval\fR،
\fIStartLimitBurst\fR
پیکربندی شده است)\&.
"oom\-kill"
نشان می‌دهد که یک سرویس به دلیل وضعیت کمبود حافظه (OOM) خاتمه یافته است\&.
.PP
\fIControlGroup\fR
مسیر گروه کنترلی (cgroup) را که پردازه‌های این واحد سرویس در آن قرار می‌گیرند نشان می‌دهد\&.
.PP
ویژگی‌های زیر به صورت ۱:۱ به تنظیمات مربوطه در فایل واحد نگاشت می‌شوند:
\fIRootDirectory\fR
\fIRootImage\fR
\fIRootImageOptions\fR
\fIRootVerity\fR
\fIRootHash\fR
\fIRootHashSignature\fR
\fIMountImages\fR
\fIExtensionImages\fR
\fIExtensionDirectories\fR
برای مفهوم آن‌ها به systemd\&.exec(5) مراجعه کنید\&.
.PP
\fIMemoryAvailable\fR
مقادیر
"MemoryMax"
یا
"MemoryHigh"
واحد و والدین آن یا RAM فیزیکی در دسترس را در مقایسه با مصرف حافظه در سطح داده‌شده در نظر می‌گیرد و حداقل را انتخاب می‌کند\&. توجه داشته باشید که سایر واحدهای زیر فشرده‌ترین برش والد ممکن است حافظه را سریع‌تر مصرف کنند و مقدار کمتری نسبت به مقدار گزارش‌شده برای تخصیص خود واحد باقی بماند\&. این ویژگی در ترکیب با
\fIMemoryAccounting=yes\fR
روی واحدهای درگیر عملکرد بهتری دارد\&.
.PP
\fIDelegateSubgroup\fR
حاوی زیرگروه cgroup است که پردازه‌های واحد فراخوانی‌شده باید در آن قرار گیرند، همان‌طور که توسط گزینه‌ای با همین نام در فایل‌های واحد پیکربندی شده است\&. در صورتی که کاربرد نداشته باشد یا زیرگروهی پیکربندی نشده باشد، روی رشتهٔ خالی تنظیم می‌شود\&.
.PP
\fIRuntimeDirectorySymlink\fR،
\fIStateDirectorySymlink\fR،
\fICacheDirectorySymlink\fR
و
\fILogsDirectorySymlink\fR
به ترتیب پارامتر مقصد تنظیمات فایل‌های واحد
\fIRuntimeDirectory\fR،
\fIStateDirectory\fR،
\fICacheDirectory\fR
و
\fILogsDirectory\fR
را پیاده‌سازی می‌کنند، که یک پیوند نمادین با نام داده‌شده به دایرکتوری مربوطه ایجاد می‌کند\&. پیام‌ها یک پارامتر
\fIflags\fR
دریافت می‌کنند که دایرکتوری را فقط‌خواندنی می‌کند:
.sp
.if n \{\
.RS 4
.\}
.nf
#define SD_EXEC_DIRECTORY_READ_ONLY            (UINT64_C(1) << 0)
.fi
.if n \{\
.RE
.\}
.PP
\fIExtraFileDescriptorNames\fR
حاوی نام‌های توصیف‌کنندهٔ فایلی است که از طریق ویژگی
\fIExtraFileDescriptors\fR
در متد
\fBStartTransientUnit()\fR
به سرویس ارسال شده است\&. برای جزئیات بیشتر در مورد نحوهٔ بازیابی این توصیف‌کننده‌های فایل به
\fBsd_listen_fds\fR(3)
مراجعه کنید\&. برخلاف ویژگی ورودی
\fIExtraFileDescriptors\fR،
ویژگی
\fIExtraFileDescriptorNames\fR
تنها شامل نام‌ها است و نه توصیف‌کننده‌های فایل\&.
.PP
\fIManagedOOMMemoryPressureDurationUSec\fR
پارامتر مقصد تنظیم فایل واحد
\fIManagedOOMMemoryPressureDurationSec=\fR
فهرست‌شده در
\fBsystemd.resource-control\fR(5)
را پیاده‌سازی می‌کند\&. توجه داشته باشید که واحد زمان بر حسب
"μs"
بیان شده است\&.
.PP
\fIProtectControlGroupsEx\fR
پارامتر مقصد تنظیم فایل واحد
\fIProtectControlGroups=\fR
فهرست‌شده در
\fBsystemd.exec\fR(5)
را پیاده‌سازی می‌کند\&. برخلاف ویژگی بولی
\fIProtectControlGroups\fR،
ویژگی
\fIProtectControlGroupsEx\fR
از نوع رشته‌ای است\&.
.PP
\fIPrivatePIDs\fR
پارامتر مقصد تنظیم فایل واحد
\fIPrivatePIDs=\fR
فهرست‌شده در
\fBsystemd.exec\fR(5)
را پیاده‌سازی می‌کند\&. توجه داشته باشید که
\fIPrivatePIDs\fR
از نوع رشته‌ای است تا امکان افزودن مقادیر بیشتر در آینده فراهم شود\&.
.SH "اشیاء SOCKET UNIT (SOCKET UNIT OBJECTS)"
.sp
.if n \{\
.RS 4
.\}
.nf
node /org/freedesktop/systemd1/unit/avahi_2ddaemon_2esocket {
