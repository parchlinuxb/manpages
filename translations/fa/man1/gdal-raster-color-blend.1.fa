[تصویر: سایه‌روشن پستی‌بلندی رنگ‌آمیزی‌شده]
[تصویر]
.SS "مثال ۸: ترکیب یک رندرینگ سایه‌روشن پستی‌بلندی و ارتفاع‌سنجی از یک DEM در یک رستر سایه‌روشن رنگی با استفاده از عملگر آمیختگی lighten."
.INDENT 0.0
.INDENT 3.5
.sp
.EX
$ gdal raster blend \-\-overlay=hillshade.tif \-\-operator=lighten \e
                    hypsometric.tif hypsometric_combined_with_hillshade.tif
