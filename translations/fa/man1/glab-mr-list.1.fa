.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-mr-list \- فهرست کردن درخواست‌های ادغام.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab mr list [flags]\fP


.SH "توضیحات (DESCRIPTION)"
به‌طور پیش‌فرض درخواست‌های ادغام باز فهرست می‌شوند. از \fB--all\fR برای گنجاندن درخواست‌های بسته
و ادغام‌شده استفاده کنید. از \fB--group\fR برای فهرست کردن برای یک گروه به جای
پروژهٔ جاری استفاده کنید.


.SH "گزینه‌ها (OPTIONS)"
\fB-A\fP, \fB--all\fP[=false]
	دریافت همهٔ درخواست‌های ادغام.

.PP
\fB-a\fP, \fB--assignee\fP=[]
	تنها دریافت درخواست‌های ادغام محول‌شده به کاربران. می‌توان چند کاربر را با کاما جدا کرد یا با تکرار فلگ مشخص نمود.

.PP
\fB--author\fP=""
	فیلتر کردن درخواست‌های ادغام بر اساس نویسنده \&.

.PP
\fB-c\fP, \fB--closed\fP[=false]
	تنها دریافت درخواست‌های ادغام بسته‌شده.

.PP
\fB--created-after\fP=
	فیلتر کردن درخواست‌های ادغام ایجادشده پس از یک تاریخ مشخص (قالب ISO 8601).

.PP
\fB--created-before\fP=
	فیلتر کردن درخواست‌های ادغام ایجادشده پیش از یک تاریخ مشخص (قالب ISO 8601).

.PP
\fB--deployed-after\fP=
	فیلتر کردن درخواست‌های ادغام مستقرشده پس از یک تاریخ مشخص (قالب ISO 8601).

.PP
\fB--deployed-before\fP=
	فیلتر کردن درخواست‌های ادغام مستقرشده پیش از یک تاریخ مشخص (قالب ISO 8601).

.PP
\fB-d\fP, \fB--draft\fP[=false]
	فیلتر کردن بر اساس درخواست‌های ادغام پیش‌نویس (draft).

.PP
\fB--environment\fP=""
	فیلتر کردن درخواست‌های ادغام مستقرشده در محیط داده‌شده \&.

.PP
\fB-g\fP, \fB--group\fP=""
	انتخاب یک گروه/زیرگروه. در صورت تنظیم آرگومان repo، این گزینه نادیده گرفته می‌شود.

.PP
\fB--jq\fP=""
	فیلتر کردن خروجی JSON با عبارت jq.

.PP
\fB-l\fP, \fB--label\fP=[]
	فیلتر کردن درخواست ادغام بر اساس برچسب \&. می‌توان چند برچسب را با کاما جدا کرد یا با تکرار فلگ مشخص نمود.

.PP
\fB-M\fP, \fB--merged\fP[=false]
	تنها دریافت درخواست‌های ادغام ادغام‌شده.

.PP
\fB-m\fP, \fB--milestone\fP=""
	فیلتر کردن درخواست ادغام بر اساس مایل‌استون \&.

.PP
\fB--not-draft\fP[=false]
	فیلتر کردن بر اساس درخواست‌های ادغام غیر پیش‌نویس.

.PP
\fB--not-label\fP=[]
	فیلتر کردن درخواست‌های ادغام بر اساس نداشتن برچسب \&. می‌توان چند برچسب را با کاما جدا کرد یا با تکرار فلگ مشخص نمود.

.PP
\fB-o\fP, \fB--order\fP=""
	مرتب‌سازی درخواست‌های ادغام بر اساس \&. گزینه‌های مرتب‌سازی: created_at، updated_at، merged_at، title، priority، label_priority، milestone_due، و popularity.

.PP
\fB-F\fP, \fB--output\fP="text"
	قالب‌بندی خروجی به‌صورت: text، json.

.PP
\fB-p\fP, \fB--page\fP=1
	شماره صفحه.

.PP
\fB-P\fP, \fB--per-page\fP=30
	تعداد موارد برای فهرست کردن در هر صفحه.

.PP
\fB-R\fP, \fB--repo\fP=""
	انتخاب مخزنی دیگر. می‌توانید از OWNER/REPO یا GROUP/NAMESPACE/REPO استفاده کنید. نشانی وب (URL) کامل یا نشانی Git نیز پذیرفته می‌شود.

.PP
\fB-r\fP, \fB--reviewer\fP=[]
	تنها دریافت درخواست‌های ادغام با کاربران به‌عنوان بازبین (reviewer). می‌توان چند کاربر را با کاما جدا کرد یا با تکرار فلگ مشخص نمود.

.PP
\fB--search\fP=""
	فیلتر کردن بر اساس عبارت جستجو در عنوان و توضیحات.

.PP
\fB-S\fP, \fB--sort\fP=""
	جهت مرتب‌سازی برای فیلد --order: asc یا desc.

.PP
\fB-s\fP, \fB--source-branch\fP=""
	فیلتر کردن بر اساس شاخهٔ مبدأ \&.

.PP
\fB-t\fP, \fB--target-branch\fP=""
	فیلتر کردن بر اساس شاخهٔ مقصد \&.


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB-h\fP, \fB--help\fP[=false]
	نمایش راهنما برای این دستور.


.SH "مثال‌ها (EXAMPLES)"
.EX
glab mr list --all
glab mr ls -a
glab mr list --assignee=@me
glab mr list --reviewer=@me
glab mr list --source-branch=new-feature
glab mr list --target-branch=main
glab mr list --search "this adds feature X"
glab mr list --label needs-review
glab mr list --not-label waiting-maintainer-feedback,subsystem-x
glab mr list -M --per-page 10
glab mr list --draft
glab mr list --not-draft
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-mr(1)\fP
