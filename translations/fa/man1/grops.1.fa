.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_grops_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" This macro definition is poor style from a portability standpoint,
.\" but it's a good test and demonstration of the standard font
.\" repertoire for the devices where it has any effect at all, and so
.\" should be retained.
.de FT
.  if \\n[.$] .if !F \\$1 .ftr \\$1 R
.  if '\\*(.T'ps' .ft \\$1
.  if '\\*(.T'pdf' .ft \\$1
..
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY grops
.RB [ \-glm ]
.RB [ \-b\~\c
.IR  brokenness-flags ]
.RB [ \-c\~\c
.IR num-copies ]
.RB [ \-F\~\c
.IR font-directory ]
.RB [ \-I\~\c
.IR inclusion-directory ]
.RB [ \-p\~\c
.IR paper-format ]
.RB [ \-P\~\c
.IR prologue-file ]
.RB [ \-w\~\c
.IR rule-thickness ]
.RI [ file\~ .\|.\|.]
.YS
.
.
.P
.SY grops
.B \-\-help
.YS
.
.
.P
.SY grops
.B \-v
.YS
.
.SY grops
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
درایور خروجی PostScript برای
.I roff
گنو، خروجی
.MR \%troff 1
را به PostScript ترجمه می‌کند.
.
به‌طور معمول،
.I grops
توسط
.MR groff 1
هنگامی که گزینه
.RB \[lq] \-T\~ps \[rq]
به آن داده شود فراخوانی می‌گردد.
.
(در این نصب،
.B \%ps
دستگاه خروجی پیش‌فرض است.)
.
از گزینه
.B \-P
در
.I groff
برای ارسال هر یک از گزینه‌های نشان‌داده‌شده در بالا به
.I grops
استفاده کنید.
.
اگر هیچ آرگومان
.I file
داده نشود،
یا اگر
.I file
برابر \[lq]\-\[rq] باشد،
.I grops
جریان ورودی استاندارد را می‌خواند.
.
این برنامه خروجی را در جریان خروجی استاندارد می‌نویسد.
.
.
.P
هنگامی که با چندین آرگومان
.I file
فراخوانی شود،
.I grops
یک ساختار سند معتبر
(منطبق بر قراردادهای ساختاردهی سند یا DSC)
تولید نمی‌کند.
.
برای چاپ چنین خروجی به‌هم‌پیوسته‌ای،
لازم است پردازش DSC در برنامه چاپ یا پیش‌نمایشگر غیرفعال شود.
.
.
.P
برای راهنمای نصب قلم‌ها برای
.IR grops ،
بخش \[lq]نصب قلم (Font installation)\[rq] را در ادامه ببینید.
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
گزینه
.B \-\-help
پیام راهنمای استفاده را نمایش می‌دهد،
در حالی که
.B \-v
و
.B \%\-\-version
اطلاعات نسخه را نشان می‌دهند؛
همگی پس از آن خارج می‌شوند.
.
.
.TP 8n \" "-F dir" + 2n
.BI \-b\~ n
مشکلات مربوط به صف‌بندها (spoolers)،
پیش‌نمایشگرها
و چاپگرهای قدیمی‌تر را برطرف می‌کند.
.
به‌طور معمول،
.I grops
خروجی را در PostScript سطح زبان\~2 (%LanguageLevel\~2) تولید می‌کند که با نسخه 3.0 از قراردادهای ساختاردهی سند (Document Structuring Conventions) مطابقت دارد.
.
برخی از نرم‌افزارها و دستگاه‌ها نمی‌توانند چنین جریان داده‌ای را پردازش کنند.
.
مقدار
.I n
تعیین می‌کند که
.I grops
چه کارهایی انجام دهد تا خروجی آن برای چنین مصرف‌کنندگانی قابل قبول باشد.
.
اگر
.I n
برابر
.B 0
باشد،
.I grops
هیچ راهکار دورزدنی را به کار نمی‌گیرد،
که حالت پیش‌فرض است؛
این مقدار را می‌توان با تغییر دستورالعمل
.B broken
در پرونده
.I DESC
مربوط به
.I grops
تغییر داد.
.
.
.IP
مقدار 1 را اضافه کنید تا از تولید توضیحات
.B %%Begin\%Document\%Setup
و
.B %%End\%Document\%Setup
جلوگیری شود؛
این کار برای نسخه‌های اولیه TranScript لازم است که با هر چیزی بین توضیح
.B %%End\%Prolog
و اولین توضیح
.B %%Page
دچار سردرگمی می‌شوند.
.
.
.IP
مقدار 2 را اضافه کنید تا خطوط موجود در پرونده‌های گنجانده‌شده که با
.B %!\&
آغاز می‌شوند حذف گردند؛
این خطوط پیش‌نمایشگر
.I pageview
سان را دچار سردرگمی می‌کنند.
.
.
.IP
مقدار 4 را اضافه کنید تا خطوط موجود در پرونده‌های گنجانده‌شده که با
.BR %%Page ،
.B %%Trailer
و
.B %%End\%Prolog
آغاز می‌شوند حذف گردند؛
این کار برای صف‌بندهایی لازم است که توضیحات
.B %%Begin\%Document
و
.B %%End\%Document
را درک نمی‌کنند.
.
.
.IP
مقدار 8 را اضافه کنید تا به‌جای
.B %!PS\-Adobe\-3.0
عبارت
.B %!PS\-Adobe\-2.0
به عنوان خط اول خروجی PostScript نوشته شود؛
این کار هنگام استفاده از Newsprint سان با چاپگری که نیاز به معکوس‌سازی ترتیب صفحات دارد لازم است.
.
.
.IP
مقدار 16 را اضافه کنید تا اطلاعات اندازه رسانه حذف شود
(یعنی نه توضیح
.B %%Document\%Media
تولید شود و نه دستور PostScript به نام
.BR setpagedevice ).
.
این رفتار
.I groff
نسخه 1.18.1 و قبل از آن بود؛
این کار برای چاپگرهای قدیمی‌تری که PostScript سطح زبان\~2 (%LanguageLevel\~2) را درک نمی‌کنند لازم است،
و همچنین در صورتی که قرار باشد خروجی برای تولید یک پرونده EPS بیشتر پردازش شود ضروری است؛
زیربخش \[lq]پست‌اسکریپت کپسوله‌شده (Encapsulated PostScript)\[rq] را در ادامه ببینید.
.
.
.TP
.BI \-c\~ n
تعداد
.I n
نسخه از هر صفحه خروجی می‌دهد.
.
.
.TP
.BI \-F\~ dir
پوشه
.RI dir /dev name
را به ابتدای مسیر جستجو برای پرونده‌های توصیف قلم و دستگاه و پیش‌گفتارهای PostScript اضافه می‌کند؛
.I name
نام دستگاه است،
که معمولاً
.B ps
می‌باشد.
.
.
.TP
.B \-g
کد PostScript برای حدس زدن طول صفحه تولید می‌کند.
.
این حدس تنها در صورتی درست است که ناحیه قابل چاپ به صورت عمودی در مرکز صفحه قرار گرفته باشد.
.
این گزینه به شما امکان می‌دهد اسنادی تولید کنید که بتوان آنها را بر روی هر دو قطع کاغذ U.S.\& letter و A4 بدون تغییر چاپ کرد.
.
.
.TP
.BI \-I\~ dir
دایرکتوری
.I dir
را برای پرونده‌های نام‌برده‌شده در دنباله‌های گریز
.B \[rs]X\[aq]ps: file\[aq]
و
.B \[rs]X\[aq]ps: import\[aq]
جستجو می‌کند.
.
گزینه
.B \-I
را می‌توان بیش از یک بار مشخص کرد؛
هر
.I dir
به همان ترتیب مشخص‌شده جستجو می‌شود.
.
برای جستجوی پوشه کاری جاری پیش از سایر پوشه‌ها،
.RB \[lq] "\-I .\&" \[rq]
را در جایگاه مورد نظر اضافه کنید؛
در غیر این صورت در انتهای مسیر جستجو می‌شود.
.
.
.TP
.B \-l
به‌جای حالت عمودی (portrait)، از جهت افقی (landscape) استفاده می‌کند.
.
.
.TP
.B \-m
تغذیه دستی (manual feed) کاغذ را برای سند فعال می‌کند.
.
.
.TP
.BI \-p\~ fmt
ابعاد فیزیکی رسانه خروجی را تنظیم می‌کند،
که دستورالعمل‌های
.BR \%papersize ،
.BR \%paperlength
و
.B \%paperwidth
را در پرونده
.I DESC
نادیده گرفته و جایگزین می‌کند.
.
آرگومان
.I fmt
می‌تواند هر آرگومان پذیرفته‌شده توسط دستورالعمل
.B \%papersize
باشد؛
.MR groff_font 5
را ببینید.
.
.
.TP
.BI \-P\~ prologue
از پرونده
.IR prologue ،
که در مسیر جستجوی قلم
.I groff
یافت می‌شود،
به عنوان پیش‌گفتار PostScript استفاده می‌کند،
که پیش‌فرض
(بخش \[lq]فایل‌ها (FILES)\[rq] در ادامه را ببینید)
و متغیر محیطی
.I GROPS_PROLOGUE
را نادیده گرفته و جایگزین می‌کند.
.
.
.TP
.BI \-w\~ n
خط‌ها (خط‌کش‌ها) را با ضخامت
.IR n \~هزارم
یک em رسم می‌کند.
.
ضخامت پیش‌فرض
.B 40
(0.04\~em) است.
.
.
.\" ====================================================================
.SH "کاربرد (USAGE)"
.\" ====================================================================
.
ورودی به
.I grops
باید در قالبی باشد که توسط
.MR \%troff 1
خروجی داده می‌شود،
همان‌طور که در
.MR groff_out 5
توصیف شده است.
.
علاوه بر این،
پرونده‌های توصیف دستگاه و قلم برای دستگاه مورداستفاده باید الزامات مشخصی را برآورده کنند.
.
تفکیک‌پذیری دستگاه باید یک مضرب صحیح از\~72 برابر
.B sizescale
باشد.
.
پرونده توصیف دستگاه باید شامل یک قالب کاغذ معتبر باشد؛
.MR groff_font 5
را ببینید.
.
هر پرونده توصیف قلم باید حاوی دستورالعملی به شکل زیر باشد
.
.RS
.EX
.RI internalname\~ psname
.EE
.RE
.
که بیان می‌کند نام PostScript قلم برابر
.I psname
است.
.
.
.P
یک پرونده توصیف قلم ممکن است حاوی یک دستورالعمل دیگر نیز باشد:
.
.RS
.EX
.RI encoding\~ enc-file
.EE
.RE
.
که مشخص می‌کند قلم PostScript باید با استفاده از کدگذاری توصیف‌شده در
.I enc-file
مجدداً کدگذاری شود؛
این پرونده باید متشکل از دنباله‌ای از خطوط به فرم زیر باشد
.
.
.RS
.EX
.I pschar code
.EE
.RE
.
که در آن
.I pschar
نام کاراکتر در PostScript،
و
.I code
موقعیت آن در کدگذاری است که به عنوان یک عدد صحیح ده‌دهی بیان می‌شود؛
مقادیر معتبر در محدوده 0 تا\~255 هستند.
.
خطوطی که با
.B #
شروع می‌شوند و خطوط خالی نادیده گرفته می‌شوند.
.
کد هر کاراکتر ارائه‌شده در پرونده توصیف قلم باید با کد آن کاراکتر در پرونده کدگذاری،
یا با کد در کدگذاری پیش‌فرض قلم در صورتی که قلم PostScript قرار نیست مجدداً کدگذاری شود، مطابقت داشته باشد.
.
از این کد می‌توان همراه با دنباله گریز
.B \[rs]N
در
.I \%troff
برای انتخاب کاراکتر استفاده کرد،
حتی اگر کاراکتر فاقد نام گلیف
.I groff
باشد.
.
هر کاراکتر در پرونده توصیف قلم باید در قلم PostScript وجود داشته باشد،
و پهناهای مشخص‌شده در پرونده توصیف قلم باید با پهناهای استفاده‌شده در قلم PostScript مطابقت داشته باشد.
.
برنامه
.I grops
فرض می‌کند که کاراکتری با نام
.I groff
برابر
.B space
خالی است
(هیچ علامتی بر روی صفحه ایجاد نمی‌کند)؛
این برنامه می‌تواند از چنین کاراکتری برای تولید خروجی کارآمدتر و فشرده‌تر PostScript بهره ببرد.
.
.
.P
برنامه
.I grops
قادر است تمامی گلیف‌های موجود در یک قلم PostScript را نمایش دهد؛
به 256 گلیف محدود نمی‌شود.
.
پرونده
.I enc-file
(یا کدگذاری پیش‌فرض در صورتی که پرونده کدگذاری مشخص نشده باشد)
فقط ترتیب گلیف‌ها را برای 256 کاراکتر اول تعیین می‌کند؛
به تمامی گلیف‌های دیگر با بردارهای کدگذاری اضافی که
.I grops
در لحظه تولید می‌کند دسترسی پیدا می‌شود.
.
.
.P
برنامه
.I grops
می‌تواند قلم‌هایی را که برای رندر سند لازم هستند درون آن جاسازی کند؛
به این عمل \[lq]بارگیری\[rq] (downloading) گفته می‌شود.
.
چنین قلم‌هایی باید در قالب PFA باشند.
.
از
.MR pfbtops 1
برای تبدیل یک قلم نوع\~1 در قالب PFB استفاده کنید.
.
قلم‌های قابل بارگیری باید در یک پرونده
.I download
فهرست شوند که شامل خطوطی به فرم زیر است
.
.RS
.EX
.I psname file
.EE
.RE
.
که در آن
.I psname
نام قلم در PostScript،
و
.I file
نام پرونده حاوی آن است.
.
خطوط خالی و خطوطی که با
.B #
آغاز می‌شوند نادیده گرفته می‌شوند؛
فیلدها با نویسه تب (tab) از یکدیگر جدا می‌شوند.
.
پرونده
.I file
با استفاده از همان سازوکاری که برای پرونده‌های توصیف قلم
.I groff
به کار می‌رود جستجو می‌شود.
.
خود پرونده
.I download
نیز به همین صورت جستجو می‌شود؛
در حال حاضر،
اولین پرونده منطبق یافت‌شده در مسیر جستجوی توصیف قلم و دستگاه استفاده می‌شود.
.
.
.P
اگر پرونده حاوی یک قلم قابل بارگیری یا سند واردشده با قراردادهای ساختاردهی سند Adobe مطابقت داشته باشد،
آن‌گاه
.I grops
هرگونه توضیح موجود در پرونده‌ها را به اندازه کافی تفسیر می‌کند تا مطمئن شود خروجی خود برنامه نیز استاندارد است.
.
همچنین هرگونه منابع قلم مورد نیاز را که در پرونده
.I download
فهرست شده‌اند،
و نیز منابع پرونده مورد نیاز را فراهم می‌کند.
.
علاوه بر این، می‌تواند وابستگی‌های متقابل منابع را مدیریت کند.
.
به عنوان مثال،
فرض کنید یک قلم قابل بارگیری به نام Garamond دارید،
و همچنین یک قلم قابل بارگیری به نام Garamond-Outline که به Garamond وابسته است
(معمولاً به گونه‌ای تعریف می‌شود که فرهنگ لغت قلم Garamond را کپی کرده و PaintType را تغییر دهد)،
در این صورت لازم است Garamond پیش از Garamond-Outline در سند PostScript ظاهر شود.
.
برنامه
.I grops
این فرآیند را به صورت خودکار انجام می‌دهد، مشروط بر اینکه پرونده قلم قابل بارگیری برای Garamond-Outline وابستگی خود به Garamond را از طریق قراردادهای ساختاردهی سند مشخص کرده باشد،
به عنوان مثال با شروع شدن با خطوط زیر.
.
.RS
.EX
%!PS\-Adobe\-3.0 Resource\-Font
%%DocumentNeededResources: font Garamond
%%EndComments
%%IncludeResource: font Garamond
.EE
.RE
.
در این مورد،
هر دو قلم Garamond و Garamond-Outline باید در پرونده
.I download
فهرست شوند.
.
یک قلم قابل بارگیری نباید نام خود را در توضیح
.B %%Document\%Supplied\%Resources
بگنجاند.
.
.
.P
برنامه
.I grops
توضیحات
.B %%Document\%Fonts
را تفسیر نمی‌کند.
.
به‌جای آن، توضیحات
.BR %%Document\%Needed\%Resources ،
.BR %%Document\%Supplied\%Resources ،
.BR %%Include\%Resource ،
.BR %%Begin\%Resource
و
.B %%End\%Resource
(یا احتمالاً توضیحات قدیمی
.BR %%Document\%Needed\%Fonts ،
.BR %%Document\%Supplied\%Fonts ،
.BR %%Include\%Font ،
.BR %%Begin\%Font
و
.B %%End\%Font )
باید استفاده شوند.
.
.
.P
رنگ‌های پیش‌فرض قلم‌مو (stroke) و پر کردن (fill) سیاه هستند.
.
برای رنگ‌های تعریف‌شده در فضای رنگی \[lq]rgb\[rq]،
از
.B setrgbcolor
استفاده می‌شود؛
برای \[lq]cmy\[rq] و \[lq]cmyk\[rq]،
از
.BR setcmykcolor ؛
و برای \[lq]gray\[rq]،
از
.BR setgray .
.
دستور
.B setcmykcolor
یک دستور PostScript در سطح زبان\~2 (%LanguageLevel\~2) است و بنابراین در برخی از چاپگرهای قدیمی در دسترس نیست.
.
.
.\" ====================================================================
.SS "تایپ‌فیس‌ها (Typefaces)"
.\" ====================================================================
.
سبک‌های نام‌گذاری‌شده با
.BR R ،
.BR I ،
.B B
و
.B BI
در موقعیت‌های قلم 1 تا\~4 سوار شده‌اند.
.
قلم‌های متنی در خانواده‌های
.BR A ،
.BR BM ،
.BR C ،
.BR H ،
.BR HN ،
.BR N ،
.BR P
و
.B T
گروه‌بندی شده‌اند،
که هر یک دارای اعضایی در هر کدام از این سبک‌ها هستند.
.
.
.RS
.TP 8n \" BMBI + 2n + hand-tuned for PDF
.B AR
.FT AR
AvantGarde-Book
.FT
.
.TQ
.B AI
.FT AI
AvantGarde-BookOblique
.FT
.
.TQ
.B AB
.FT AB
AvantGarde-Demi
.FT
.
.TQ
.B ABI
.FT ABI
AvantGarde-DemiOblique
.FT
.
.TQ
.B BMR
.FT BMR
Bookman-Light
.FT
.
.TQ
.B BMI
.FT BMI
Bookman-LightItalic
.FT
.
.TQ
.B BMB
.FT BMB
Bookman-Demi
.FT
.
.TQ
.B BMBI
.FT BMBI
Bookman-DemiItalic
.FT
.
.TQ
.B CR
.FT CR
Courier
.FT
.
.TQ
