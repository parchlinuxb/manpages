.TH EDQUOTA 8
.SH "نام (NAME)"
edquota \- ویرایش سهمیه‌بندی دیسک کاربران
.SH "خلاصه دستور (SYNOPSIS)"
.B edquota
[
.B \-p
.I protoname
] [
.BR \-u \ |
.BR \-g \ |
.B \-P
] [
.B \-rm
] [
.B \-F
.I format-name
] [
.B \-f
.I filesystem
]
.IR username \ |
.IR groupname \ |
.IR projectname .\|.\|.
.LP
.B edquota
[
.BR \-u \ |
.BR \-g \ |
.B \-P
] [
.B \-F
.I format-name
] [
.B \-f
.I filesystem
]
.B \-t
.LP
.B edquota
[
.BR \-u \ |
.BR \-g \ |
.B \-P
] [
.B \-F
.I format-name
] [
