.TH MKNTFS 8 "ژانویه ۲۰۰۶" "ntfs-3g 2026.7.7" "دستورهای مدیریتی و نگهداری"
.SH "نام (NAME)"
mkntfs \- ایجاد سیستم‌فایل NTFS
.SH "خلاصه دستور (SYNOPSIS)"
.B mkntfs
[\fIoptions\fR] \fIdevice \fR[\fInumber\-of\-sectors\fR]
