.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-mr-create \- ایجاد یک درخواست ادغام جدید.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab mr create [flags]\fP


.SH "توضیحات (DESCRIPTION)"
به‌طور پیش‌فرض شاخهٔ جاری به‌عنوان شاخه مبدأ در نظر گرفته می‌شود. از \fB--fill\fR
برای پر کردن خودکار عنوان و توضیحات از تاریخچهٔ کامیت‌ها استفاده کنید. از
\fB--draft\fR برای ایجاد یک درخواست ادغامِ پیش‌نویس استفاده کنید.

.PP
گزینهٔ \fB--recover\fR آزمایشی است: ممکن است ناپایدار باشد یا در هر
زمانی حذف شود، و برای استفاده در محیط عملیاتی آماده نیست. برای اطلاعات
بیشتر، پیوند زیر را ببینید:
https://docs.gitlab.com/policy/development_stages_support


.SH "گزینه‌ها (OPTIONS)"
\fB--allow-collaboration\fP[=false]
	اجازه دادن به سایر اعضا برای ثبت کامیت. برای بازنویسی پیش‌فرض‌های پروژه، مقدار آن را برابر true/false قرار دهید، یا برای استفاده از تنظیمات پروژه آن را خالی بگذارید.

.PP
\fB-a\fP, \fB--assignee\fP=[]
	محول کردن درخواست ادغام به افراد از طریق \fBusernames\fR (نام‌های کاربری) آن‌ها. می‌توان چند نام کاربری را با کاما جدا کرد یا با تکرار فلگ مشخص نمود.

.PP
\fB--auto-merge\fP[=false]
	تنظیم درخواست ادغام برای ادغام خودکار پس از قبولی در تمام بررسی‌های ادغام.

.PP
\fB--copy-issue-labels\fP[=false]
	کپی کردن برچسب‌ها از تیکت به درخواست ادغام. همراه با \fB--related-issue\fR استفاده می‌شود.

.PP
\fB--create-source-branch\fP[=false]
	ایجاد شاخه مبدأ در صورت عدم وجود آن.

.PP
\fB-d\fP, \fB--description\fP=""
	ارائه توضیحات برای درخواست ادغام. برای باز کردن ویرایشگر، مقدار آن را برابر "-" قرار دهید.

.PP
\fB--description-file\fP=""
	خواندن توضیحات درخواست ادغام از یک فایل. از "-" برای خواندن از ورودی استاندارد استفاده کنید.

.PP
\fB--draft\fP[=false]
	علامت‌گذاری درخواست ادغام به‌عنوان پیش‌نویس (draft).

.PP
\fB-f\fP, \fB--fill\fP[=false]
	عدم درخواست برای عنوان یا توضیحات و استفاده صرف از اطلاعات کامیت. مقدار \fBpush\fR را برابر \fBtrue\fR قرار می‌دهد و شاخه را پوش می‌کند.

.PP
\fB--fill-commit-body\fP[=false]
	هنگام وجود چندین کامیت، متن توضیحات را با متن هر کامیت پر کنید. فقط همراه با \fB--fill\fR قابل استفاده است.

.PP
\fB-H\fP, \fB--head\fP=""
	انتخاب یک مخزن مبدأ دیگر با استفاده از قالب \fBOWNER/REPO\fR یا \fBGROUP/NAMESPACE/REPO\fR، شناسه پروژه، یا نشانی وب (URL) کامل.

.PP
\fB-l\fP, \fB--label\fP=[]
	افزودن برچسب بر اساس نام. می‌توان چند برچسب را با کاما جدا کرد یا با تکرار فلگ مشخص نمود.

.PP
\fB-m\fP, \fB--milestone\fP=""
	شناسه سراسری یا عنوان یک مایل‌استون برای اختصاص دادن.

.PP
\fB--no-editor\fP[=false]
	عدم باز کردن ویرایشگر برای وارد کردن توضیحات. اگر true باشد، از اعلان متنی استفاده می‌کند. مقدار پیش‌فرض false است.

.PP
\fB--push\fP[=false]
	پوش کردن تغییرات کامیت‌شده پس از ایجاد درخواست ادغام. مطمئن شوید که تغییرات کامیت‌شده دارید.

.PP
\fB--recover\fP[=false]
	ذخیره گزینه‌ها در یک فایل در صورت ناموفق بودن ایجاد درخواست ادغام. اگر فایل وجود داشته باشد، گزینه‌ها از فایل بازیابی بارگذاری می‌شوند (آزمایشی).

.PP
\fB-i\fP, \fB--related-issue\fP=""
	ایجاد یک درخواست ادغام برای یک تیکت. اگر \fB--title\fR ارائه نشود، از عنوان تیکت استفاده می‌شود.

.PP
\fB--remove-source-branch\fP[=false]
	حذف شاخه مبدأ پس از ادغام. برای بازنویسی پیش‌فرض‌های پروژه آن را برابر true/false قرار دهید، یا برای استفاده از تنظیمات پروژه آن را خالی بگذارید.

.PP
\fB--reviewer\fP=[]
	درخواست بازبینی از کاربران با \fBusernames\fR (نام‌های کاربری) آن‌ها. می‌توان چند نام کاربری را با کاما جدا کرد یا با تکرار فلگ مشخص نمود.

.PP
\fB--signoff\fP[=false]
	افزودن تأییدیه DCO به انتهای توضیحات درخواست ادغام.

.PP
\fB-s\fP, \fB--source-branch\fP=""
	ایجاد درخواست ادغام از این شاخه. مقدار پیش‌فرض شاخه جاری است.

.PP
\fB--squash-before-merge\fP[=false]
	فشرده‌سازی کامیت‌ها در قالب یک کامیت واحد هنگام ادغام (squash). برای بازنویسی پیش‌فرض پروژه روی true/false تنظیم کنید، یا برای استفاده از تنظیمات پروژه خالی بگذارید.

.PP
\fB-b\fP, \fB--target-branch\fP=""
	شاخه هدف یا پایه‌ای که می‌خواهید کد شما با آن ادغام شود.

.PP
\fB--template\fP=""
	نام یک قالب در '.gitlab/merge_request_templates/' برای پر کردن اولیه توضیحات. پسوند '.md' اختیاری است. قالب‌ها فقط از مخزن محلی بارگذاری می‌شوند.

.PP
\fB-t\fP, \fB--title\fP=""
	ارائه عنوان برای درخواست ادغام.

.PP
\fB-w\fP, \fB--web\fP[=false]
	ادامه مراحل ایجاد درخواست ادغام در یک مرورگر وب.

.PP
\fB--wip\fP[=false]
	علامت‌گذاری درخواست ادغام به‌عنوان در حال پیشرفت (WIP). جایگزینی برای \fB--draft\fR.

.PP
\fB-y\fP, \fB--yes\fP[=false]
	صرف‌نظر کردن از اعلان تأیید ارسال. از \fB--fill\fR برای صرف‌نظر کردن از همه اعلان‌های اختیاری استفاده کنید.


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB-h\fP, \fB--help\fP[=false]
	نمایش راهنما برای این دستور.

.PP
\fB-R\fP, \fB--repo\fP=""
	انتخاب مخزنی دیگر. می‌توانید از OWNER/REPO یا GROUP/NAMESPACE/REPO استفاده کنید. نشانی وب (URL) کامل یا نشانی Git نیز پذیرفته می‌شود.


.SH "مثال‌ها (EXAMPLES)"
.EX
# ایجاد یک درخواست ادغام به صورت تعاملی از شاخه جاری
glab mr new

# اختصاص به یک کاربر و تعیین عنوان بدون درخواست برای توضیحات
glab mr create -a username -t "fix annoying bug"

# پر کردن عنوان و توضیحات از کامیت‌ها، علامت‌گذاری به عنوان پیش‌نویس و افزودن یک برچسب
glab mr create -f --draft --label RFC

# پر کردن از کامیت‌ها و پیش‌نمایش صفحه مقایسه در مرورگر
glab mr create --fill --web

# پر کردن از کامیت‌ها و بسط دادن متن هر کامیت در توضیحات
glab mr create --fill --fill-commit-body --yes

# استفاده از یک قالب درخواست ادغام برای توضیحات
glab mr create -t "Fix login bug" --template bug_fix
glab mr create -t "Security patch" --template security_fix.md --yes

# ایجاد بر روی پروژه‌ای دیگر بدون کلون محلی. همه ورودی‌ها باید به صورت گزینه ارسال شوند؛ بدون --push، --fill یا --template.
glab mr create --repo group/project --source-branch feature-branch --target-branch main --title "Add feature" --description "Details..." --yes

# ایجاد یک درخواست ادغام از فورک خود به پروژه بالادستی (upstream)، بدون کلون محلی.
glab mr create --repo upstream/project --head your-namespace/project --source-branch feature-branch --target-branch main --title "Add feature" --description "Details..." --yes

# خواندن توضیحات از یک فایل
glab mr create -t "Fix login bug" --description-file description.md

# خواندن توضیحات از ورودی استاندارد
cat description.md | glab mr create -t "Fix login bug" --description-file -
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-mr(1)\fP
