.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_gxditview_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY gxditview
.RI [ X-toolkit-option \~.\|.\|.\&]
.RB [ \-backingStore\~\c
.IR backing-store-type ]
.RB [ \-filename\~\c
.IR file ]
.\" While recognized, the relevant logic is "#if 0"ed out in draw.c.
.\" .RB [ \-noPolyText ]
.RB [ \-page\~\c
.IR page-number ]
.RB [ \-printCommand\~\c
.IR command ]
.RB [ \-resolution\~\c
.IR resolution ]
.I file
.YS
.
.
.P
.SY gxditview
.B \-help
.YS
.
.SY gxditview
.B \-\-help
.YS
.
.
.P
.SY gxditview
.B \-v
.YS
.
.SY gxditview
.B \-version
.YS
.
.SY gxditview
.B \-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
برنامه
.I gxditview
خروجی
.I troff
گنو را در یک نمایشگر سامانه پنجره‌ای X11 نمایش می‌دهد.
این برنامه از قلم‌های استاندارد X11 استفاده می‌کند که توسط سرور X رندر می‌شوند.
.
.
.P
خروجی
.MR \%troff 1
به یک زبان توصیف صفحه است که در
.MR groff_out 5
مستند شده است.
به طور معمول، کاربران این خروجی را مشاهده نمی‌کنند زیرا پوشش
.MR groff 1
به‌طور خودکار یک راه‌انداز خروجی را برای تفسیر آن اجرا می‌کند؛
در مقابل، گزینه
.B \-Z
در
.I groff
آن را در جریان خروجی استاندارد باقی می‌گذارد.
این خروجی را می‌توان با فراخوانی صریح
.RB \[lq] gxditview
.IR file \[rq]
مشاهده کرد.
اگر عملوند
.I file
برابر
.RB \[lq] \- \[rq]
باشد،
.I gxditview
جریان ورودی استاندارد را خواهد خواند؛
.I file
نمی‌تواند حذف شود.
زبان توصیف صفحه
.I troff
گنو مستقل از دستگاه است اما ناآگاه از دستگاه نیست.
برنامه
.I gxditview
می‌تواند آن را برای تمام دستگاه‌های حروف‌چینی نمایش دهد،
اما کیفیت آن وابسته به دستگاه است.
برنامه
.I gxditview
خروجی مربوط به دستگاه‌های متنی ترمینال
.RI ( nroff )
را نمایش نخواهد داد.
.
.
.PP
بهترین نتایج با دستگاه‌های
.BR X *
برای گزینه
.B \-T
در
.I \%troff
به دست می‌آید که چهار مورد هستند:
.BR \-TX75 ،
.BR \-TX75\-12 ،
.BR \-TX100
و
.BR \-TX100\-12 .
آن‌ها از نظر تفکیک‌پذیری X
(۷۵ یا ۱۰۰ نقطه در اینچ)
و اندازه پایه پوینت
(۱۰ یا ۱۲ پوینت)
متفاوت هستند.
آن‌ها به‌طور ویژه برای
.I gxditview
ساخته شده‌اند.
هنگام استفاده از یکی از این موارد،
.I \%troff
خروجی مناسب آن دستگاه را تولید کرده و
.I gxditview
را به‌طور خودکار برای مشاهده فراخوانی می‌کند.
.
.
.P
گزینه
.B \-X
تنها با
.BR \-Tps ،
.BR \-TX75 ،
.BR \-TX75\-12 ،
.BR \-TX100
و
.BR \-TX100\-12
نتایج خوبی تولید می‌کند.
تفکیک‌پذیری پیش‌فرض برای پیش‌نمایش خروجی
.B \-Tps
برابر با 75\|dpi است؛
این مقدار را می‌توان با گزینه
.B \-resolution
تغییر داد.
.
.
.PP
هنگامی که
.I gxditview
در حال اجرا است، کلیک دکمه چپ ماوس منویی با چندین گزینه باز می‌کند.
.
.
.TP 15n \" "Previous Page" + 2n
.B Next Page
نمایش صفحه بعد.
.
.
.TP
.B Previous Page
نمایش صفحه قبل.
.
.
.TP
.B Select Page
دریافت شماره صفحه از یک کادر محاوره‌ای و نمایش آن.
.
.
.TP
.B Print
دریافت یک دستور از یک کادر محاوره‌ای و استفاده از آن برای چاپ خروجی
.IR \%troff .
دستور پیش‌فرضی که در ابتدا نمایش داده می‌شود، توسط منبع برنامه‌ای
.B printCommand
و گزینه
.B \-printCommand
کنترل می‌شود.
.
.
.TP
.B Open
دریافت نام یک فایل از یک کادر محاوره‌ای و نمایش آن.
فایل نام‌برده باید شامل خروجی
.I \%troff
باشد.
اگر نام فایل با یک خط عمودی یا نماد پایپ
.RB \[lq] | \[rq]
شروع شود، به عنوان دستوری برای خواندن تفسیر خواهد شد.
.
.
.TP
.B Quit
خروج از
.BR gxditview .
.
.
.PP
گزینه‌های منو متناظر با کنش‌هایی با نام‌های مشابه اما نه کاملاً یکسان هستند
که می‌توان از طریق کلیدهای میان‌بر صفحه‌کلید نیز به آن‌ها دسترسی پیدا کرد.
کلیدهای
.IR n ،
.IR Space ،
.IR Return
و
.I Next
.RI ( PgDn )
به کنش
.B NextPage
اختصاص یافته‌اند.
کلیدهای
.IR p ،
.IR b ،
.IR BackSpace ،
.IR Delete
و
.I Prior
.RI ( PgUp )
به کنش
.B PreviousPage
اختصاص یافته‌اند.
کلید
.I p
همراه با هر کلید تغییردهنده‌ای
(Shift،
Control،
Alt
یا
Meta)
به کنش
.B Print
اختصاص دارد.
کلید
.I g
به کنش
.B SelectPage
اختصاص یافته است.
کلید
.I o
به کنش
.B OpenFile
اختصاص یافته است.
کلید
.I q
به کنش
.B Quit
اختصاص دارد.
کلید
.I r
به کنش
.B Rerasterize
اختصاص یافته است که فایل جاری را دوباره می‌خواند و صفحه جاری را مجدداً نمایش می‌دهد؛
اگر فایل جاری یک دستور باشد، دستور مجدداً اجرا خواهد شد.
پیمایش عمودی با کلیدهای
.I k
و
.I j
امکان‌پذیر است؛
پیمایش افقی نیز به کلیدهای
.I h
و
.I l
اختصاص داده شده است.
کلیدهای جهت‌نما
.RI ( بالا ،
.IR پایین ،
.IR چپ
و
.IR راست )
نیز به کنش‌های پیمایش متناظر اختصاص یافته‌اند.
.
.
.PP
دستورهای
.B \%paperlength
و
.B \%paperwidth
در فایل
.I DESC
که یک دستگاه خروجی
.I groff
را توصیف می‌کند، طول و عرض صفحه مجازی نمایش‌داده‌شده توسط
.I gxditview
را بر حسب واحدهای پایه مشخص می‌کنند؛ به
.MR groff_font 5
مراجعه کنید.
.
.
.\" ====================================================================
.SS "پیش‌فرض‌های X (X defaults)"
.\" ====================================================================
.
این برنامه از ویجت
.I Dvi
در سامانه
X\~Toolkit
استفاده می‌کند.
این برنامه علاوه بر تمام نام‌ها و کلاس‌های منابع اصلی، موارد زیر را نیز درک می‌کند:
.
.
.TP
.BR width\~ (class\~ Width )
عرض پنجره را مشخص می‌کند.
.
.
.TP
.BR height\~ (class\~ Height )
ارتفاع پنجره را مشخص می‌کند.
.
.
.TP
.BR foreground\~ (class\~ Foreground )
رنگ پیش‌زمینه پیش‌فرض را مشخص می‌کند.
.
.
.TP
.BR font\~ (class\~ Font )
قلم مورد استفاده برای پیام‌های خطا را مشخص می‌کند.
.
.
.TP
.BR fontMap\~ (class\~ FontMap )
نگاشت نام قلم‌های
.I groff
به نام قلم‌های X را مشخص می‌کند.
این مقدار باید رشته‌ای شامل توالی‌ای از خطوط باشد.
هر خط شامل دو فیلد جداشده با فاصله سفید است:
نام قلم
.I groff
در ابتدا، و دومین فیلد XLFD
(X Logical Font Description)
است.
مقدار پیش‌فرض در زیربخش «نگاشت پیش‌فرض قلم‌ها» در زیر نشان داده شده است.
.
.
.\" ====================================================================
.SS "نگاشت پیش‌فرض قلم‌ها (Default font map)"
.\" ====================================================================
.
رشته‌های XLFD طولانی و نامتعارف هستند،
به همین دلیل برخی از خطوط در زیر شکسته شده و با تورفتگی نمایش داده شده‌اند.
.\" Break them after the POINT_SIZE field (in "decipoints", so "100").
.
.
.PP
.EX
TR  \-adobe\-times\-medium\-r\-normal\-\-*\-100\
\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
TI  \-adobe\-times\-medium\-i\-normal\-\-*\-100\
\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
TB  \-adobe\-times\-bold\-r\-normal\-\-*\-100\
\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
TBI \-adobe\-times\-bold\-i\-normal\
\-\-*\-100\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
CR  \-adobe\-courier\-medium\-r\-normal\-\-*\-100\" break
        \-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
CI  \-adobe\-courier\-medium\-o\-normal\" break
        \-\-*\-100\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
CB  \-adobe\-courier\-bold\-r\-normal\
\-\-*\-100\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
CBI \-adobe\-courier\-bold\-o\-normal\
\-\-*\-100\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
HR  \-adobe\-helvetica\-medium\-r\-normal\" break
        \-\-*\-100\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
HI  \-adobe\-helvetica\-medium\-o\-normal\" break
        \-\-*\-100\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
HB  \-adobe\-helvetica\-bold\-r\-normal\" break
        \-\-*\-100\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
HBI \-adobe\-helvetica\-bold\-o\-normal\" break
        \-\-*\-100\-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
NR  \-adobe\-new century schoolbook\-medium\-r\-normal\-\-*\-100\" break
        \-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
NI  \-adobe\-new century schoolbook\-medium\-i\-normal\-\-*\-100\" break
        \-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
NB  \-adobe\-new century schoolbook\-bold\-r\-normal\-\-*\-100\" break
        \-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
NBI \-adobe\-new century schoolbook\-bold\-i\-normal\-\-*\-100\" break
        \-*\-*\-*\-*\-iso8859\-1\[rs]n\[rs]
S   \-adobe\-symbol\-medium\-r\-normal\-\-*\-100\" break
        \-*\-*\-*\-*\-adobe\-fontspecific\[rs]n\[rs]
SS  \-adobe\-symbol\-medium\-r\-normal\-\-*\-100\" break
        \-*\-*\-*\-*\-adobe\-fontspecific\[rs]n\[rs]
.EE
.
.
.br
.ne 3v
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
گزینه‌های
.B \-help
و
.B \-\-help
پیام راهنمای استفاده را نمایش می‌دهند، در حالی که
.BR \-v ،
.B \-version
و
.B \%\-\-version
اطلاعات نگارش را نمایش می‌دهند؛ پس از آن همگی خارج می‌شوند.
.
.
.P
برنامه
.I gxditview
تمامی گزینه‌های استاندارد خط فرمان X\~Toolkit را به همراه گزینه‌های اضافی فهرست‌شده در زیر می‌پذیرد.
.
.
.TP
.B \-page
این گزینه شماره صفحه‌ای از سند را که باید نمایش داده شود مشخص می‌کند.
.
.
.TP
.BI \-backingStore\~ backing-store-type
از آنجا که نمایش مجدد خروجی رندرشده
.I \%troff
می‌تواند زمان قابل توجهی ببرد، این گزینه باعث می‌شود سرور محتویات پنجره را ذخیره کند تا هنگام پیمایش آن در درگاه نمایش (viewport)، پنجره از روی محتویات ذخیره‌شده در حافظه پشتیبان (backing store) بازترسیم شود.
.I backing-store-type
می‌تواند یکی از مقادیر
.BR Always ،
.B WhenMapped
یا
.B NotUseful
باشد.
.
.
.TP
.BI \-printCommand\~ command
دستور پیش‌فرضی که در کادر محاوره‌ای گزینه منوی
.B Print
نمایش داده می‌شود،
.I command
خواهد بود.
.
.
.TP
.BI \-resolution\~ res
فایل خروجی
.I \%troff
با تفکیک‌پذیری
.I res
نقطه در اینچ نمایش داده خواهد شد، مگر اینکه فایل
.I DESC
شامل دستورالعمل
.B X11
باشد که در این صورت از تفکیک‌پذیری دستگاه استفاده خواهد شد.
این مورد متناظر با منبع
.B resolution
در ویجت
.I Dvi
است.
مقدار پیش‌فرض
.B 75
است.
.
.
.TP
.BI \-filename\~ string
نام فایل پیش‌فرضی که در کادر محاوره‌ای گزینه منوی
.B Open
نمایش داده می‌شود،
.I string
خواهد بود.
این می‌تواند نام یک فایل یا دستوری باشد که با
.RB \[lq] | \[rq]
آغاز می‌شود.
.
.
.PP
آرگومان‌های استاندارد خط فرمان X\~Toolkit زیر معمولاً به همراه
.I gxditview
استفاده می‌شوند.
.
.
.TP
.BI \-bg\~ color
این گزینه رنگ مورد استفاده برای پس‌زمینه پنجره را مشخص می‌کند.
مقدار پیش‌فرض
.RB \[lq] white \[rq]
است.
.
.
.TP
.BI \-bd\~ color
این گزینه رنگ مورد استفاده برای حاشیه پنجره را مشخص می‌کند.
مقدار پیش‌فرض
.RB \[lq] black \[rq]
است.
.
.
.TP
.BI \-bw\~ number
این گزینه عرض حاشیه اطراف پنجره را بر حسب پیکسل مشخص می‌کند.
.
.
.TP
.BI \-fg\~ color
این گزینه رنگ مورد استفاده برای نمایش متن را مشخص می‌کند.
مقدار پیش‌فرض
.RB \[lq] black \[rq]
است.
.
.
.TP
.BI \-fn\~ font
این گزینه قلم مورد استفاده برای نمایش متن ویجت را مشخص می‌کند.
مقدار پیش‌فرض
.RB \[lq] fixed \[rq]
است.
.
.
.TP
.B \-rv
این گزینه مشخص می‌کند که تصویر معکوس (reverse video) با جابه‌جایی رنگ‌های پیش‌زمینه و پس‌زمینه شبیه‌سازی شود.
.
.
.TP
.BI \-geometry\~ geometry
این گزینه اندازه و موقعیت ترجیحی پنجره را مشخص می‌کند.
.
.
.TP
.BI \-display\~ host : display
این گزینه سرور X مورد نظر را برای اتصال مشخص می‌کند.
.
.
.TP
.BI \-xrm\~ resourcestring
این گزینه یک رشته منبع (resource string) را برای استفاده مشخص می‌کند.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
برنامه
.I gxditview
در صورت اجرای موفقیت‌آمیز با وضعیت
.B 0
و در صورتی که نتواند آرگومان‌های خط فرمان خود را تفسیر کند با وضعیت
.B 2
خارج می‌شود.
.
.
.\" ====================================================================
.SH "محیط (ENVIRONMENT)"
.\" ====================================================================
.
.TP
.I GROFF_FONT_PATH
فهرستی از دایرکتوری‌ها برای جستجوی دایرکتوری پرونده‌های توصیف قلم و دستگاه خروجی انتخاب‌شده.
به
.MR \%troff 1
و
.MR groff_font 5
مراجعه کنید.
.
.
.br
.if n .ne 5v
.if t .ne 6v
.\" ====================================================================
.SH "فایل‌ها (FILES)"
.\" ====================================================================
.
.TP
.I /usr/\:\%lib/\:\%X11/\:\%app\-defaults/\:\%GXditview
.TQ
.I /usr/\:\%lib/\:\%X11/\:\%app\-defaults/\:\%GXditview\-color
پیش‌فرض‌های برنامه X را برای
.I gxditview
تعریف می‌کنند.
کاربران می‌توانند این مقادیر را در فایل
.IR .Xdefaults ،
که معمولاً در دایرکتوری خانگی کاربر قرار دارد، بازنویسی کنند.
به
.MR appres 1
و
.MR xrdb 1
مراجعه کنید.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devX100/\:DESC
دستگاه خروجی
.B X100
را توصیف می‌کند.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devX100/ F
قلم شناخته‌شده به عنوان
.I F
را در دستگاه
.B X100
توصیف می‌کند.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devX100\-12/\:DESC
دستگاه خروجی
.B X100\-12
را توصیف می‌کند.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devX100\-12/ F
قلم شناخته‌شده به عنوان
.I F
را در دستگاه
.B X100\-12
توصیف می‌کند.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devX75/\:DESC
دستگاه خروجی
.B X75
را توصیف می‌کند.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devX75/ F
قلم شناخته‌شده به عنوان
.I F
را در دستگاه
.B X75
توصیف می‌کند.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devX75\-12/\:DESC
دستگاه خروجی
.B X75\-12
را توصیف می‌کند.
.
.
.TP
.IR /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%font/\:\%devX75\-12/ F
قلم شناخته‌شده به عنوان
.I F
را در دستگاه
.B X75\-12
توصیف می‌کند.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%tmac/\:X.tmac
ماکروهایی را برای استفاده به همراه دستگاه‌های خروجی
.BR X100 ،
.BR X100\-12 ،
.B X75
و
.B X75\-12
تعریف می‌کند.
این فایل هنگام انتخاب هر یک از این دستگاه‌های خروجی، به‌طور خودکار توسط
.I troffrc
بارگذاری می‌شود.
.
.
.TP
.I /usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%tmac/\:Xps\:.tmac
تنظیمات
.I \%troff
را برای استفاده از
.I \%gxditview
به عنوان یک پیش‌نمایشگر برای خروجی مستقل از دستگاه با هدف دستگاه خروجی
.B ps
آماده می‌سازد.
این فایل هنگامی که گزینه‌های
.B \-X
و
.B \-Tps
به
.I \%troff
داده شوند، به‌طور خودکار توسط
.I troffrc
بارگذاری می‌شود.
.
.
.\" ====================================================================
.SH "مثال‌ها (EXAMPLES)"
.\" ====================================================================
.
دستور زیر این صفحه راهنما را با اندازه پوینت پایه ۱۲ نمایش می‌دهد.
.
.
.RS
.P
.EX
groff \-TX100\-12 \-man gxditview.1
.EE
.RE
.
.
.P
کیفیت نتیجه عمدتاً به اندازه پوینت انتخاب‌شده و تفکیک‌پذیری نمایشگر بستگی دارد؛
با این حال برای پیش‌نمایش سریع، دستوری مانند
.
.RS
.EX
.RI "groff \-X \-P\-resolution \-P100\~" document
.EE
.RE
.
نتایج قابل قبولی ارائه می‌دهد.
.
.
.\" ====================================================================
.SH "نویسندگان (AUTHORS)"
.\" ====================================================================
.
برنامه
.I gxditview
و نسخه پیشین آن
.I xditview
توسط
Keith Packard (MIT X Consortium)،
Richard L.\& Hyde (Purdue)،
David Slattengren (Berkeley)،
Malcolm Slaney (Schlumberger Palo Alto Research)،
Mark Moraes (University of Toronto)
و
James Clark
نوشته شده‌اند.
.
.
.PP
این برنامه برگرفته از
.I xditview
است؛ بخش‌هایی از
.I xditview
از
.I xtroff
نشأت گرفته‌اند که آن نیز از
.I suntroff
برگرفته شده بود.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.UR https://\:www\:.x\:.org/\:releases/\:X11R7.6/\:doc/\:xorg\-docs/\:specs/\:XLFD/xlfd\:.html
\[lq]X Logical Font Description Conventions\[rq]
.UE ،
نوشته Jim Flowers و Stephen Gildea.
.
.
.PP
.MR X 7 ,
.MR xrdb 1 ,
.MR xditview 1 ,
.MR groff 1 ,
.MR groff_out 5
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_gxditview_1_man_C]
.do rr *groff_gxditview_1_man_C
.
.
