.nh
.TH "desync" "1" "Sep 2026" "desync" ""

.SH "نام (NAME)"
desync-prune \- Remove unreferenced chunks from a store


.SH "خلاصه دستور (SYNOPSIS)"
\fBdesync prune <index> [<index>...] [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Read chunk IDs from index files and delete all chunks from a store
that are not referenced in any of the provided index files. This is a
destructive operation; a confirmation prompt is shown before any chunks are
deleted unless --yes is used. Use '-' to read a single index from STDIN.


.SH "گزینه‌ها (OPTIONS)"
\fB--ca-cert\fP=""
	trust authorities in this file, instead of OS trust store

.PP
\fB-r\fP, \fB--cache-repair\fP[=true]
	replace invalid chunks in the cache from source

.PP
\fB--client-cert\fP=""
	path to client certificate for TLS authentication

.PP
\fB--client-key\fP=""
	path to client key for TLS authentication

.PP
\fB-n\fP, \fB--concurrency\fP=10
	number of concurrent goroutines

.PP
\fB-e\fP, \fB--error-retry\fP=3
	number of times to retry in case of network error

.PP
\fB-b\fP, \fB--error-retry-base-interval\fP=500ms
	initial retry delay, increases linearly with each subsequent attempt

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for prune

.PP
\fB-s\fP, \fB--store\fP=""
	store to prune

.PP
\fB-t\fP, \fB--trust-insecure\fP[=false]
	trust invalid certificates

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation before deleting chunks


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config file (default $HOME/.config/desync/config.json)

.PP
\fB--digest\fP="sha512-256"
	digest algorithm, sha512-256 or sha256

.PP
\fB--verbose\fP[=false]
	verbose mode


.SH "مثال (EXAMPLE)"
.EX
  desync prune -s /path/to/local --yes file.caibx
  desync prune -s /path/to/local current.caibx previous.caibx
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBdesync(1)\fP


