.TH "dcmquant" 1 "پنج‌شنبه 9 ژوئیه 2026 18:43:40" "Version 3.7.0" "OFFIS DCMTK" \" -*- nroff -*-
.nh
.SH "نام (NAME)"
dcmquant \- تبدیل تصاویر رنگی DICOM به رنگ‌های پالت
.PP

.SH "خلاصه دستور (SYNOPSIS)"
.PP
.PP
.nf
dcmquant [گزینه‌ها] dcmfile-in dcmfile-out
.fi
.PP
.SH "توضیحات (DESCRIPTION)"
.PP
ابزار \fBdcmquant\fP یک تصویر رنگی DICOM را می‌خواند، جدول تطبیق رنگ پالت (palette color look-up table) با اندازه دلخواه برای این تصویر محاسبه می‌کند (بر اساس الگوریتم median cut منتشر شده توسط Paul Heckbert) و تصویر رنگی را به یک تصویر پالت رنگی DICOM تبدیل می‌نماید.
.SH "پارامترها (PARAMETERS)"
.PP
.PP
.nf
dcmfile-in   نام فایل ورودی DICOM برای تبدیل ("-" برای ورودی استاندارد stdin)

dcmfile-out  نام فایل خروجی DICOM برای ذخیره ("-" برای خروجی استاندارد stdout)
.fi
.PP
.SH "گزینه‌ها (OPTIONS)"
.PP
.SS "گزینه‌های عمومی (general options)"
.PP
.nf
  -h   --help
         چاپ این متن راهنما و خروج

       --version
         چاپ اطلاعات نسخه و خروج

       --arguments
         چاپ آرگومان‌های بسط‌یافته خط فرمان

  -q   --quiet
         حالت بی‌صدا، عدم چاپ هشدارها و خطاها

  -v   --verbose
         حالت پرحرف، چاپ جزئیات پردازش

  -d   --debug
         حالت اشکال‌زدایی، چاپ اطلاعات دیباگ

  -ll  --log-level  [l]evel: string constant
         (fatal, error, warn, info, debug, trace)
         استفاده از سطح l برای لاگر

  -lc  --log-config  [f]ilename: string
         استفاده از فایل پیکربندی f برای لاگر
.fi
.PP
.SS "گزینه‌های ورودی (input options)"
.PP
.nf
قالب فایل ورودی:

  +f   --read-file
         خواندن قالب فایل یا مجموعه داده (پیش‌فرض)

  +fo  --read-file-only
         فقط خواندن قالب فایل

  -f   --read-dataset
         خواندن مجموعه داده بدون فراداده فایل

سینتکس انتقال ورودی:

  -t=  --read-xfer-auto
         تشخیص خودکار سینتکس انتقال (پیش‌فرض)

  -td  --read-xfer-detect
         نادیده گرفتن سینتکس انتقال تعیین‌شده در هدر متا

  -te  --read-xfer-little
         خواندن با VR صریح و ترتیب بایت little endian

  -tb  --read-xfer-big
         خواندن با VR صریح و ترتیب بایت big endian

  -ti  --read-xfer-implicit
         خواندن با VR ضمنی و ترتیب بایت little endian
.fi
.PP
.SS "گزینه‌های پردازش تصویر و کدگذاری (image processing and encoding options)"
.PP
.nf
انتخاب فریم:

  +F   --frame  [n]umber: integer
         انتخاب فریم مشخص‌شده

  +Fa  --all-frames
         انتخاب تمام فریم‌ها (پیش‌فرض)

سازگاری:

  +Mp  --accept-palettes
         پذیرش تگ‌های نادرست ویژگی پالت
         (0028,111x) و (0028,121x)

انتخاب بُعد الگوریتم median cut:

  +Dr  --mc-dimension-rgb
         حداکثر بُعد از محدوده RGB (پیش‌فرض)

  +Dl  --mc-dimension-lum
         حداکثر بُعد از روشنایی (luminance)

انتخاب رنگ نماینده در median cut:

  +Cb  --mc-color-avgbox
         میانگین رنگ‌ها در جعبه (پیش‌فرض)

  +Cp  --mc-color-avgpixel
         میانگین پیکسل‌ها در جعبه

  +Cc  --mc-color-center
         انتخاب مرکز جعبه

نمایش مقدار پالت رنگ (VR):

  +pw  --write-ow
         نوشتن جدول پالت LUT به صورت OW (پیش‌فرض)

  +pu  --write-us
         نوشتن جدول پالت LUT به صورت US (منسوخ‌شده)

ایجاد پالت رنگ:

  +pe  --lut-entries-word
         نوشتن جدول پالت LUT با ورودی‌های ۱۶ بیتی

  +pf  --floyd-steinberg
         استفاده از انتشار خطای Floyd-Steinberg

  +pc  --colors  number of colors: 2..65536 (پیش‌فرض 256)
         تعداد رنگ‌ها برای کوانتیزه‌سازی

شناسه رده SOP (SOP Class UID):

  +cd  --class-default
         حفظ شناسه رده SOP (پیش‌فرض)

  +cs  --class-sc
         تبدیل به تصویر دریافت ثانویه (Secondary Capture)
         (مستلزم استفاده از --uid-always)

شناسه نمونه SOP (SOP Instance UID):

  +ua  --uid-always
         همیشه شناسه UID جدید تخصیص بده (پیش‌فرض)

  +un  --uid-never
         هرگز شناسه UID جدید تخصیص نده
.fi
.PP
.SS "گزینه‌های خروجی (output options)"
.PP
.nf
قالب فایل خروجی:

  +F   --write-file
         نوشتن در قالب فایل (پیش‌فرض)

  -F   --write-dataset
         نوشتن مجموعه داده بدون فراداده فایل

سینتکس انتقال خروجی:

  +t=  --write-xfer-same
         نوشتن با همان سینتکس انتقال ورودی (پیش‌فرض)

  +te  --write-xfer-little
         نوشتن با VR صریح و ترتیب بایت little endian

  +tb  --write-xfer-big
         نوشتن با VR صریح و ترتیب بایت big endian

  +ti  --write-xfer-implicit
         نوشتن با VR ضمنی و ترتیب بایت little endian

نمایش مقادیر پس از ۱۹۹۳ (post-1993 VRs):

  +u   --enable-new-vr
         فعال‌سازی پشتیبانی از VRهای جدید (UN/UT) (پیش‌فرض)

  -u   --disable-new-vr
         غیرفعال کردن پشتیبانی از VRهای جدید، تبدیل به OB

کدگذاری طول گروه:

  +g=  --group-length-recalc
         محاسبه مجدد طول گروه‌ها در صورت وجود (پیش‌فرض)

  +g   --group-length-create
         همیشه همراه با عناصر طول گروه نوشته شود

  -g   --group-length-remove
         همیشه بدون عناصر طول گروه نوشته شود

کدگذاری طول در توالی‌ها و آیتم‌ها:

  +e   --length-explicit
         نوشتن با طول‌های صریح (پیش‌فرض)

  -e   --length-undefined
         نوشتن با طول‌های نامشخص

فاصله‌گذاری انتهای مجموعه داده (نه با --write-dataset):

  -p=  --padding-retain
         عدم تغییر فاصله‌گذاری
         (پیش‌فرض مگر این‌که --write-dataset استفاده شود)

  -p   --padding-off
         بدون فاصله‌گذاری (ضمنی در صورت --write-dataset)

  +p   --padding-create  [f]ile-pad [i]tem-pad: integer
         تراز کردن فایل با مضربی از f بایت و آیتم‌ها با
         مضربی از i بایت
.fi
.PP
.SH "گزارش‌گیری (LOGGING)"
.PP
سطح خروجی گزارش‌گیری ابزارهای مختلف خط فرمان و کتابخانه‌های زیربنایی توسط کاربر قابل تعیین است. به‌طور پیش‌فرض، تنها خطاها و هشدارها در جریان خطای استاندارد (stderr) نوشته می‌شوند. با استفاده از گزینه \fI\-\-verbose\fP پیام‌های اطلاع‌رسانی مانند جزئیات پردازش نیز گزارش می‌شوند. گزینه \fI\-\-debug\fP می‌تواند برای دریافت جزئیات بیشتر در مورد فعالیت‌های داخلی، برای مثال جهت اشکال‌زدایی، استفاده شود. سطوح دیگر لاگ را می‌توان با گزینه \fI\-\-log\-level\fP انتخاب کرد. در حالت \fI\-\-quiet\fP فقط خطاهای مرگبار (fatal) گزارش می‌شوند. در چنین شرایط خطای بسیار شدیدی، برنامه معمولاً متوقف خواهد شد. برای جزئیات بیشتر درباره سطوح مختلف لاگ به مستندات ماژول "oflog" مراجعه کنید.

.PP
در صورتی که خروجی لاگ باید در فایل نوشته شود (اختیاراً با چرخش فایل لاگ)، در syslog (یونیکس) یا event log (ویندوز) از گزینه \fI\-\-log\-config\fP می‌توان استفاده کرد. این فایل پیکربندی همچنین امکان هدایت تنها پیام‌های خاصی را به یک جریان خروجی معین و فیلتر کردن پیام‌ها بر اساس ماژول یا برنامه‌ای که در آن تولید شده‌اند فراهم می‌کند. یک نمونه فایل پیکربندی در \fI<etcdir>/logger.cfg\fP ارائه شده است.
.SH "خط فرمان (COMMAND LINE)"
.PP
تمام ابزارهای خط فرمان از نمادگذاری زیر برای پارامترها استفاده می‌کنند: کروشه‌ها مقادیر اختیاری (۰-۱) را در بر می‌گیرند، سه نقطه نشان‌دهنده مجاز بودن چندین مقدار (۱-n) است، و ترکیبی از هر دو به معنی ۰ تا n مقدار است.

.PP
گزینه‌های خط فرمان به ترتیب با علامت '+' یا '-' از پارامترها متمایز می‌شوند. معمولاً ترتیب و موقعیت گزینه‌های خط فرمان اختیاری است (یعنی می‌توانند در هر جایی ظاهر شوند). با این حال، اگر گزینه‌ها مانعه‌الجمع باشند، گزینه‌ای که در انتهای سمت راست آمده لحاظ می‌شود. این رفتار مطابق با قواعد ارزیابی استاندارد در پوسته‌های رایج یونیکس است.

.PP
علاوه بر این، یک یا چند فایل حاوی دستور را می‌توان با پیشوند علامت '@' قبل از نام فایل مشخص کرد (برای مثال \fI@command.txt\fP). چنین آرگومانی پیش از هرگونه ارزیابی بیشتر، با محتوای فایل متنی مربوطه جایگزین می‌شود (فاصله‌های خالی متعدد به عنوان یک جداکننده محسوب می‌شوند مگر اینکه بین دو گیومه قرار گیرند). لطفاً توجه داشته باشید که یک فایل دستور نمی‌تواند شامل فایل دستور دیگری باشد. این رویکرد ساده اما مؤثر امکان خلاصه‌سازی ترکیب‌های رایج گزینه‌ها/پارامترها را فراهم کرده و از طولانی و گیج‌کننده شدن خط فرمان جلوگیری می‌کند (یک مثال در فایل \fI<datadir>/dumppat.txt\fP آورده شده است).
.SH "محیط (ENVIRONMENT)"
.PP
ابزار \fBdcmquant\fP تلاش خواهد کرد تا فرهنگ‌نامه‌های داده DICOM مشخص‌شده در متغیر محیطی \fIDCMDICTPATH\fP را بارگذاری کند. به‌طور پیش‌فرض، یعنی اگر متغیر محیطی \fIDCMDICTPATH\fP تنظیم نشده باشد، فایل \fI<datadir>/dicom.dic\fP بارگذاری خواهد شد مگر اینکه فرهنگ‌نامه درون برنامه تعبیه شده باشد (پیش‌فرض برای ویندوز).

.PP
رفتار پیش‌فرض ارجح است و متغیر محیطی \fIDCMDICTPATH\fP تنها زمانی باید استفاده شود که به فرهنگ‌نامه‌های داده جایگزین نیاز باشد. متغیر محیطی \fIDCMDICTPATH\fP قالبی مشابه متغیر \fIPATH\fP در پوسته یونیکس دارد که در آن دو نقطه (":") ورودی‌ها را جدا می‌کند. در سیستم‌های ویندوز، نقطه ویرگول (";") به عنوان جداکننده به کار می‌رود. کد فرهنگ‌نامه داده سعی خواهد کرد هر فایل مشخص‌شده در متغیر محیطی \fIDCMDICTPATH\fP را بارگذاری کند. اگر هیچ فرهنگ‌نامه داده‌ای بارگذاری نشود، یک خطا خواهد بود.
