.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
outlook.pst \- ساختار و قالب فایل‌های pst مایکروسافت اوت‌لوک
.SH "خلاصه (SYNOPSIS)"
.HP \w'\fBoutlook\&.pst\fR\ 'u
\fBoutlook\&.pst\fR
.SH "نمای کلی (OVERVIEW)"
.PP
آیتم‌های سطح پایین یا ابتدایی (primitive) در یک فایل
.B \&.pst
با یک مقدار
.B I_ID
شناسایی می‌شوند\&. آیتم‌های سطح بالاتر یا ترکیبی (composite) در یک فایل
.B \&.pst
با یک مقدار
.B D_ID
مشخص می‌گردند\&. دو درخت بی (B\-tree) مجزا وجود دارند که توسط این مقادیر
.B I_ID
و
.B D_ID
ایندکس‌گذاری شده‌اند\&. از نسخه Outlook 2003 به بعد، قالب فایل از اشاره‌گرهای ۳۲ بیتی به اشاره‌گرهای ۶۴ بیتی تغییر یافت\&. در این راهنما هر دو قالب شرح داده شده‌اند\&.
.SH "هدر فایل ۳۲ بیتی (32 BIT FILE HEADER)"
.PP
هدر فایل ۳۲ بیتی در آفست ۰ در فایل
.B \&.pst
قرار دارد\&.
.sp
.if n \{\
.RS 4
.\}
.nf
0000  21 42 44 4e 49 f8 64 d9  53 4d 0e 00 13 00 01 01
