.TH run-on-bat 1 2026-07-06 "TLP 1.10.2" "Power Management"
.
.SH "نام (NAME)"
run-on-bat \- run command when on battery power
.
.SH "خلاصه دستور (SYNOPSIS)"
.B run-on-bat \fR\fIcommand\fR \fR[\fIarg(s)]\fR
.
.SH "همچنین ببینید (SEE ALSO)"
