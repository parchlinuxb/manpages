.TH "mtx-ctan" "1" "01-01-2026" "version 1.00" "Dealing with CTAN"
.SH "نام (NAME)"
 mtx-ctan \- Dealing with CTAN
.SH "خلاصه دستور (SYNOPSIS)"
.B mtxrun --script ctan [
.I OPTIONS ...
.B ] [
.I FILENAMES
.B ]
.SH "توضیحات (DESCRIPTION)"
.B Dealing with CTAN
.SH "گزینه‌ها (OPTIONS)"
.TP
.B --packages
list available packages [--field=key|name|caption]
.TP
.B --topics
list available topics [--field=key|name|details]
.TP
.B --details
show details about package
.TP
.B --pattern=string
use this pattern, otherwise first argument
