.EE

.PP
بررسی ایمیج مشخص‌شده با تعیین‌کننده قالب \fBImageName\fR:

.EX
# podman inspect a04 --format "{{.ImageName}}"
fedora
.EE

.PP
بررسی ایمیج مشخص‌شده برای تعیین‌کننده قالب \fBGraphDriver\fR:

.EX
# podman inspect a04 --format "{{.GraphDriver.Name}}"
overlay
.EE

.PP
بررسی ایمیج مشخص‌شده برای تعیین‌کننده قالب \fBSize\fR آن:

.EX
# podman image inspect --format "size: {{.Size}}" alpine
size:   4405240
.EE

.PP
بررسی آخرین کانتینر ایجادشده برای تعیین‌کننده قالب \fBEffectiveCaps\fR. (این گزینه در کلاینت ریموت پودمن، از جمله ماشین‌های مک و ویندوز (به استثنای WSL2) در دسترس نیست):

.EX
podman container inspect --latest --format {{.EffectiveCaps}}
[CAP_CHOWN CAP_DAC_OVERRIDE CAP_FSETID CAP_FOWNER CAP_SETGID CAP_SETUID CAP_SETFCAP CAP_SETPCAP CAP_NET_BIND_SERVICE CAP_KILL]
.EE

.PP
بررسی کانتینر مشخص‌شده برای تعیین‌کننده قالب \fBOOMKilled\fR:

.EX
podman container inspect myContainer --format {{.State.OOMKilled}}
false
.EE

.PP
بررسی پاد مشخص‌شده برای تعیین‌کننده قالب \fBName\fR:

.EX
# podman inspect myPod --type pod --format "{{.Name}}"
myPod
.EE

.PP
بررسی ولوم مشخص‌شده برای تعیین‌کننده قالب \fBName\fR:

.EX
# podman inspect myVolume --type volume --format "{{.Name}}"
myVolume
.EE

.PP
بررسی شبکه مشخص‌شده برای تعیین‌کننده قالب \fBName\fR:

.EX
# podman inspect nyNetwork --type network --format "{{.name}}"
myNetwork
.EE

.PP
بررسی مصنوع (Artifact) مشخص‌شده:

.EX
# podman inspect quay.io/myimage/myartifact:latest --type artifact
{
    "Manifest": {
        "schemaVersion": 2,
        "mediaType": "application/vnd.oci.image.manifest.v1+json",
        ...
    },
    "Name": "quay.io/myimage/myartifact:latest",
    "Digest": "sha256:..."
}
.EE

.SH "همچنین ببینید (SEE ALSO)"
\fBpodman(1)\fP, \fBpodman-artifact-inspect(1)\fP, \fBpodman-container-inspect(1)\fP, \fBpodman-image-inspect(1)\fP, \fBpodman-network-inspect(1)\fP, \fBpodman-pod-inspect(1)\fP, \fBpodman-volume-inspect(1)\fP

