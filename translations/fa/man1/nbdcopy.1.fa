\&\fBnbddump\fR\|(1),
\&\fBnbdfuse\fR\|(1),
\&\fBnbdinfo\fR\|(1),
\&\fBnbdsh\fR\|(1),
\&\fBnbdublk\fR\|(1),
\&\fBnbdzero\fR\|(1),
\&\fBnbdkit\fR\|(1),
\&\fBqemu\-img\fR\|(1),
https://gitlab.com/nirs/blkhash,
\&\fBblksum\fR\|(1).
