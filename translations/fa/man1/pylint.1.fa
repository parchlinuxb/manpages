.sp
\fBMessage emitted:\fP
.sp
\fB%s %s %r method\fP
.sp
\fBDescription:\fP
.sp
\fIUsed when a method parameter has a different name than in the implemented interface or in an overridden method.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
class Fruit:
    def brew(self, ingredient_name: str):
        print(f\(dqBrewing a {type(self)} with {ingredient_name}\(dq)


class Apple(Fruit): ...


class Orange(Fruit):
    def brew(self, flavor: str):  # [arguments\-renamed]
        print(f\(dqBrewing an orange with {flavor}\(dq)


for fruit, ingredient_name in [[Orange(), \(dqthyme\(dq], [Apple(), \(dqcinnamon\(dq]]:
    fruit.brew(ingredient_name=ingredient_name)

.EE
