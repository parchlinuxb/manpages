.nh
.TH "desync" "1" "Sep 2026" "desync" ""

.SH "نام (NAME)"
desync-cat \- Stream a blob to stdout or a file-like object


.SH "خلاصه دستور (SYNOPSIS)"
\fBdesync cat <index> [<output>] [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Stream a blob to stdout or a file-like object, optionally seeking and limiting
the read length.

.PP
Unlike extract, this supports output to FIFOs, named pipes, and other
non-seekable destinations.

.PP
This is inherently slower than extract as while multiple chunks can be
retrieved concurrently, writing to stdout cannot be parallelized.

.PP
Use '-' to read the index from STDIN.


.SH "گزینه‌ها (OPTIONS)"
\fB--ca-cert\fP=""
	trust authorities in this file, instead of OS trust store

.PP
\fB-c\fP, \fB--cache\fP=""
	store to be used as cache

.PP
\fB-r\fP, \fB--cache-repair\fP[=true]
	replace invalid chunks in the cache from source

.PP
\fB--client-cert\fP=""
	path to client certificate for TLS authentication

.PP
\fB--client-key\fP=""
	path to client key for TLS authentication

.PP
\fB-n\fP, \fB--concurrency\fP=10
	number of concurrent goroutines

.PP
\fB-e\fP, \fB--error-retry\fP=3
	number of times to retry in case of network error

.PP
\fB-b\fP, \fB--error-retry-base-interval\fP=500ms
	initial retry delay, increases linearly with each subsequent attempt

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for cat

.PP
\fB-l\fP, \fB--length\fP=0
	number of bytes to read (0 reads to the end)

.PP
\fB-o\fP, \fB--offset\fP=0
	offset in bytes to seek to before reading

.PP
\fB-s\fP, \fB--store\fP=[]
	source store(s)

.PP
\fB-t\fP, \fB--trust-insecure\fP[=false]
	trust invalid certificates


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config file (default $HOME/.config/desync/config.json)

.PP
\fB--digest\fP="sha512-256"
	digest algorithm, sha512-256 or sha256

.PP
\fB--verbose\fP[=false]
	verbose mode


.SH "مثال (EXAMPLE)"
.EX
  desync cat -s http://192.168.1.1/ file.caibx | grep something
  desync cat -s /path/to/store -o 1048576 -l 4096 file.caibx slice.bin
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBdesync(1)\fP


