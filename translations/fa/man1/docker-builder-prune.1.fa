.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-builder-prune \- حذف حافظه موقت (cache) ساخت


.SH "خلاصه (SYNOPSIS)"
\fBdocker builder prune\fP


.SH "شرح (DESCRIPTION)"
حذف حافظه موقت (cache) ساخت


.SH "گزینه‌ها (OPTIONS)"
\fB-a\fP, \fB--all\fP[=false]
	حذف تمام حافظه‌های موقت ساخت استفاده‌نشده، نه فقط موارد معلق (dangling)

.PP
\fB--filter\fP=
	ارائه مقادیر فیلتر (به عنوان مثال "until=24h")

.PP
\fB-f\fP, \fB--force\fP[=false]
	عدم درخواست تاییدیه برای انجام عملیات

.PP
\fB--keep-storage\fP=0
	میزان فضای دیسک برای نگهداری حافظه موقت


.SH "ببینید (SEE ALSO)"
\fBdocker-builder(1)\fP
