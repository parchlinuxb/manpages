.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-repo-members-remove \- حذف یک عضو از پروژه.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab repo members remove [flags]\fP


.SH "توضیحات (DESCRIPTION)"
حذف یک عضو از پروژه.


.SH "گزینه‌ها (OPTIONS)"
\fB-R\fP, \fB--repo\fP=""
	انتخاب یک مخزن دیگر. می‌توانید از OWNER/REPO یا GROUP/NAMESPACE/REPO استفاده کنید. نشانی کامل URL یا آدرس Git نیز پذیرفته می‌شود.

.PP
\fB-u\fP, \fB--user-id\fP=0
	شناسهٔ کاربر به‌جای نام کاربری.

.PP
\fB--username\fP=""
	نام کاربری به‌جای شناسهٔ کاربر.


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB-h\fP, \fB--help\fP[=false]
	نمایش راهنما برای این دستور.


.SH "مثال‌ها (EXAMPLES)"
.EX
# حذف یک کاربر با نام کاربری
glab repo members remove --username=john.doe

# حذف یک کاربر با شناسه
glab repo members remove --user-id=123
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-repo-members(1)\fP
