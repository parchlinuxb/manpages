.TH USBIP "8" "February 2009" "usbip" "System Administration Utilities"
.SH "نام (NAME)"
usbip \- مدیریت دستگاه‌های USB/IP
.SH "خلاصه دستور (SYNOPSIS)"
.B usbip
[\fIگزینه‌ها\fR] <\fIدستور\fR> <\fIآرگومان‌ها\fR>

.SH "توضیحات (DESCRIPTION)"
در یک سرور USB/IP، دستگاه‌ها را می‌توان با استفاده از این برنامه فهرست‌بندی، مقید (bind) و نامقید (unbind) کرد\&. در یک کلاینت USB/IP، دستگاه‌های صادرشده توسط سرورهای USB/IP را می‌توان فهرست‌بندی، متصل (attach) و جدا (detach) نمود\&.

.SH "گزینه‌ها (OPTIONS)"
.HP
\fB\-\-debug\fR
.IP
چاپ اطلاعات اشکال‌زدایی\&.
.PP

.HP
\fB\-\-log\fR
.IP
ثبت گزارش در syslog\&.
.PP

.HP
\fB\-\-tcp-port PORT\fR
.IP
اتصال به PORT در میزبان دوردست (برای attach و list \-\-remote استفاده می‌شود)\&.
.PP

.SH "دستورات (COMMANDS)"
.HP
\fBversion\fR
.IP
نمایش نسخه و خروج\&.
.PP

.HP
\fBhelp\fR [\fIcommand\fR]
.IP
چاپ پیام راهنمای برنامه یا راهنمای یک دستور خاص، و سپس خروج\&.
.PP

.HP
\fBattach\fR \-\-remote=<\fIhost\fR> \-\-busid=<\fIbus_id\fR>
.IP
اتصال یک دستگاه USB دوردست\&.
.PP

.HP
\fBattach\fR \-\-remote=<\fIhost\fR> \-\-device=<\fIdev_id\fR>
.IP
اتصال یک گجت USB دوردست\&.
تنها زمانی استفاده می‌شود که usbipd دوردست در حالت دستگاه (device mode) باشد\&.
.PP

.HP
\fBdetach\fR \-\-port=<\fIport\fR>
.IP
جدا کردن یک دستگاه/گجت USB واردشده (imported)\&.
.PP

.HP
\fBbind\fR \-\-busid=<\fIbusid\fR>
.IP
قابل صادر کردن ساختن یک دستگاه\&.
.PP

.HP
\fBunbind\fR \-\-busid=<\fIbusid\fR>
.IP
توقف صادرات یک دستگاه تا بتواند توسط یک درایور محلی استفاده شود\&.
.PP

.HP
\fBlist\fR \-\-remote=<\fIhost\fR>
.IP
فهرست کردن دستگاه‌های USB صادرشده توسط یک میزبان دوردست\&.
.PP

.HP
\fBlist\fR \-\-device
.IP
فهرست کردن گجت‌های USB مربوط به usbip-vudc محلی\&.
تنها زمانی استفاده می‌شود که usbipd محلی در حالت دستگاه (device mode) باشد\&.
توجه داشته باشید که این دستور نمی‌تواند گجت‌های USB مربوط به usbip-vudc سرور دوردست در حالت دستگاه را فهرست کند\&.
.PP

.HP
\fBlist\fR \-\-local
.IP
فهرست کردن دستگاه‌های USB محلی\&.
.PP

.HP
\fBport\fR
.IP
فهرست کردن دستگاه‌ها/گجت‌های واردشده\&.
.PP


.SH "مثال‌ها (EXAMPLES)"

    client:# usbip list --remote=server
        - فهرست کردن دستگاه‌های صادرشده توسط سرور دوردست.

    client:# modprobe vhci-hcd

    client:# usbip attach --remote=server --busid=1-2
        - اتصال دستگاه USB دوردست.

    client:# usbip port
        - فهرست کردن دستگاه‌ها/گجت‌های واردشده.

    client:# usbip detach --port=0
        - جدا کردن دستگاه USB.

مثال زیر نحوه استفاده از حالت دستگاه (device mode) را نشان می‌دهد:

    server:# usbip list --device
        - فهرست کردن گجت‌های صادرشده توسط سرور محلی usbipd.

    client:# modprobe vhci-hcd

    client:# usbip attach --remote=server --device=usbip-vudc.0
        - اتصال گجت USB دوردست.

    client:# usbip port
        - فهرست کردن دستگاه‌ها/گجت‌های واردشده.

    client:# usbip detach --port=0
        - جدا کردن گجت USB.

.SH "همچنین ببینید (SEE ALSO)"
\fBusbipd\fP\fB(8)\fB\fP
