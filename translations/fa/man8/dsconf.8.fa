کاربرد: dsconf [\-v] [\-j] instance plugin pwstorage\-scheme pbkdf2\-sha1 delete\-accept\-max\-iterations
       [\-h]

.SH "دستور (COMMAND)" \fI\,'dsconf plugin pwstorage\-scheme pbkdf2\-sha256'\/\fR
