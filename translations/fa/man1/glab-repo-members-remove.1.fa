.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-repo-members-remove \- Remove a member from the project.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab repo members remove [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Remove a member from the project.


.SH "گزینه‌ها (OPTIONS)"
\fB-R\fP, \fB--repo\fP=""
	Select another repository. You can use either OWNER/REPO or GROUP/NAMESPACE/REPO. The full URL or Git URL is also accepted.

.PP
\fB-u\fP, \fB--user-id\fP=0
	User ID instead of username.

.PP
\fB--username\fP=""
	Username instead of user-id.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-h\fP, \fB--help\fP[=false]
	Show help for this command.


.SH "مثال (EXAMPLE)"
.EX
# Remove a user by username
glab repo members remove --username=john.doe

# Remove a user by ID
glab repo members remove --user-id=123
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-repo-members(1)\fP
