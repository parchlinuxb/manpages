.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_lkbib_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY lkbib
.RB [ \-n ]
.RB [ \-i\~\c
.IR fields ]
.RB [ \-p\~\c
.IR file ]
\&.\|.\|.\&
.RB [ \-t\~\c
.IR n ]
.I key
\&.\|.\|.
.YS
.
.
.P
.SY lkbib
.B \-\-help
.YS
.
.
.P
.SY lkbib
.B \-v
.YS
.
.SY lkbib
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
دستور
.I \%lkbib
پایگاه‌های داده کتابشناختی را برای ارجاعاتی که با تمام کلیدواژه‌های
.I key
مطابقت دارند جستجو می‌کند و هرگونه ارجاع یافته‌شده را در جریان خروجی استاندارد
می‌نویسد.
.
این برنامه پایگاه‌های داده مشخص‌شده توسط گزینه‌های
.B \-p
و سپس
(مگر اینکه گزینه
.B \-n
مشخص شده باشد)
یک پایگاه داده پیش‌فرض را می‌خواند.
.
پایگاه داده پیش‌فرض در صورت تنظیم بودن، از متغیر محیطی
.I \%REFER
گرفته می‌شود؛
در غیر این صورت، مسیر آن
.IR /usr/\:\%dict/\:\%papers/\:\%Ind
خواهد بود.
.
به ازای هر پایگاه داده
.I file
که باید جستجو شود،
اگر یک نمایه
.RI file \%.i
ایجادشده توسط
.MR \%indxbib 1
وجود داشته باشد،
به جای آن، نمایه جستجو خواهد شد؛
هر نمایه می‌تواند چندین پایگاه داده را پوشش دهد.
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
گزینه
.B \-\-help
یک پیام راهنمای استفاده را نمایش می‌دهد،
در حالی که
.B \-v
و
.B \%\-\-version
اطلاعات نسخه را نشان می‌دهند؛
همگی پس از آن خارج می‌شوند.
.
.
.TP
.BI \-i\~ string
هنگام جستجو در فایل‌هایی که هیچ نمایه‌ای برای آن‌ها وجود ندارد،
محتوای فیلدهایی را که نام آن‌ها در
.IR string
آمده است نادیده می‌گیرد.
.
.
.TP
.B \-n
از جستجوی پایگاه داده پیش‌فرض جلوگیری می‌کند.
.
.
.TP
.BI \-p\~ file
فایل
.I file
را جستجو می‌کند.
.
می‌توان از چندین گزینه
.B \-p
استفاده کرد.
.
.
.TP
.BI \-t\~ n
تنها مشخص کردن
.I n
نویسه نخست از کلیدها را الزامی می‌کند.
.
مقدار پیش‌فرض
\~6 است.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
دستور
.I \%lkbib
در صورت اجرای موفقیت‌آمیز با وضعیت
.BR 0 ،
اگر نتواند آرگومان‌های خط فرمان خود را تفسیر کند با وضعیت
.BR 2 ،
و در صورت مواجهه با خطا در حین اجرا با وضعیت
.B 1
خارج می‌شود.
.
.
.\" ====================================================================
.SH "محیط (ENVIRONMENT)"
.\" ====================================================================
.
.TP
.I REFER
یک نام فایل به این متغیر اختصاص دهید تا پایگاه داده پیش‌فرض بازنویسی (جایگزین) شود.
.
.
.\" ====================================================================
.SH "فایل‌ها (FILES)"
.\" ====================================================================
.
.TP
.I \%/usr/\:\%dict/\:\%papers/\:\%Ind
پایگاه داده پیش‌فرض که در صورت تنظیم نبودن متغیر محیطی
.I \%REFER
استفاده می‌شود.
.
.
.TP
.RI file \%.i
فایل‌های نمایه.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
\[lq]Some Applications of Inverted Indexes on the Unix System\[rq],
by M.\& E.\& Lesk,
1978,
AT&T Bell Laboratories Computing Science Technical Report No.\& 69.
.
.
.LP
.MR \%refer 1 ,
.MR \%lookbib 1 ,
.MR \%indxbib 1
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_lkbib_1_man_C]
.do rr *groff_lkbib_1_man_C
.
.
