.TH "mtx-server" "1" "01-01-2026" "version 0.10" "Simple Webserver For Helpers"
.SH "نام (NAME)"
 mtx-server \- Simple Webserver For Helpers
.SH "خلاصه دستور (SYNOPSIS)"
.B mtxrun --script server [
.I OPTIONS ...
.B ] [
.I FILENAMES
.B ]
.SH "توضیحات (DESCRIPTION)"
.B Simple Webserver For Helpers
.SH "گزینه‌ها (OPTIONS)"
.TP
.B --start
start server
.TP
.B --port
port to listen to
.TP
.B --root
server root
.TP
.B --scripts
scripts sub path
.TP
.B --index
index file
.TP
.B --auto
start on own path
.SH "نویسنده (AUTHOR)"
