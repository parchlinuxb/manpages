	"native\-path": "battery_sony_controller_battery_d0o27o88o32ofcoee",
	"icon\-size": 20,
	"hide\-if\-empty": true,
	"tooltip": true,
	"tooltip\-spacing": 20
}
.fi
.RE
.nf
.RS 4
"upower": {
	"show\-icon": false,
	"hide\-if\-empty": true,
	"tooltip": true,
	"tooltip\-spacing": 20
}

.fi
.RE
.PP
.SH "استایل (STYLE)"
.PP
.PD 0
