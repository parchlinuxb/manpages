.TH "mtx-check" "1" "01-01-2026" "version 0.10" "Basic ConTeXt Syntax Checking"
.SH "نام (NAME)"
 mtx-check \- Basic ConTeXt Syntax Checking
.SH "خلاصه دستور (SYNOPSIS)"
.B mtxrun --script check [
.I OPTIONS ...
.B ] [
.I FILENAMES
.B ]
.SH "توضیحات (DESCRIPTION)"
.B Basic ConTeXt Syntax Checking
.SH "گزینه‌ها (OPTIONS)"
.TP
.B --check
check tex file for errors
.SH "نویسنده (AUTHOR)"
