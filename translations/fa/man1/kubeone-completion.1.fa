.nh
.TH "KubeOne" "1" "Feb 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
kubeone-completion \- Generates completion scripts for bash, zsh, and fish


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubeone completion  [flags]\fP


.SH "توضیحات (DESCRIPTION)"
To load completion run into your current shell run

.PP
Bash:
  . <(kubeone completion bash)

.PP
Zsh:
  . <(kubeone completion zsh)

.PP
Fish:
  kubeone completion fish | source


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	help for completion


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--credentials\fP=""
	File to source credentials and secrets from

.PP
\fB-d\fP, \fB--debug\fP[=false]
	debug output with stacktrace

.PP
\fB-l\fP, \fB--log-format\fP="text"
	format for logging

.PP
\fB-m\fP, \fB--manifest\fP="./kubeone.yaml"
	Path to the KubeOne config

.PP
\fB-t\fP, \fB--tfjson\fP=""
	Source for terraform output in JSON - to read from stdin. If path is a file, contents will be used. If path is a dictionary, \fBterraform output -json\fR is executed in this path

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


.SH "مثال (EXAMPLE)"
.EX
kubeone completion bash
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubeone(1)\fP


