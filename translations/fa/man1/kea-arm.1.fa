.SS netconf/kea\-dhcp6\-operations/boot.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
{
    \(dqDhcp6\(dq: {
        \(dqcontrol\-socket\(dq: {
            \(dqsocket\-type\(dq: \(dqunix\(dq,
            \(dqsocket\-name\(dq: \(dqkea6\-ctrl\-socket\(dq
        }
    }
}
.EE
.UNINDENT
.UNINDENT
.SS netconf/kea\-dhcp6\-operations/netconf.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
{
    \(dqNetconf\(dq:
    {
        \(dqmanaged\-servers\(dq:
        {
            \(dqdhcp6\(dq:
            {
                \(dqcontrol\-socket\(dq:
                {
                    \(dqsocket\-type\(dq: \(dqunix\(dq,
                    \(dqsocket\-name\(dq: \(dqkea6\-ctrl\-socket\(dq
                }
            }
        },

        \(dqloggers\(dq:
        [
            {
                \(dqname\(dq: \(dqkea\-netconf\(dq,
                \(dqoutput\-options\(dq:
                [
                    {
                        \(dqoutput\(dq: \(dqstderr\(dq
                    }
                ],
                \(dqseverity\(dq: \(dqDEBUG\(dq,
                \(dqdebuglevel\(dq: 99
            }
        ]
    }
}
.EE
.UNINDENT
.UNINDENT
.SS netconf/simple\-dhcp4.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This is a simple example of a configuration for Netconf that handles
// DHCPv4 configuration. This example provides YANG interface for
// DHCPv4 server only.
{
    \(dqNetconf\(dq:
    {
        // Three flags control netconf (default values are true):
        // \- \(dqboot\-update\(dq about the YANG configuration load when
        //   netconf boots.
        // \- \(dqsubscribe\-changes\(dq about the subscription to notifications
        //   when the running YANG module is changed.
        // \- \(dqvalidate\-changes\(dq allows to validate changes or not.
        \(dqboot\-update\(dq: true,
        \(dqsubscribe\-changes\(dq: true,
        \(dqvalidate\-changes\(dq: true,

        // This map specifies how each server is managed:
        // the YANG model to use and the control channel.
        \(dqmanaged\-servers\(dq:
        {
            // This is how Netconf can communicate with the DHCPv4 server.
            \(dqdhcp4\(dq:
            {
                // Eventually, the kea\-netconf will be able to handle multiple
                // models. However, for the time being the only choice for
                // DHCPv4 server is kea\-dhcp4\-server model.
                \(dqmodel\(dq: \(dqkea\-dhcp4\-server\(dq,

                // The three control flags can be defined in this scope too
                // and takes precedence over global and default values.
                // boot\-update determines whether the initial configuration
                // should be retrieved from netconf during kea\-netconf startup.
                // You almost always want to set this to yes.
                \(dqboot\-update\(dq: true,

                // This flag control whether the kea\-netconf daemon should
                // subscribe to any changes. If set to true, kea\-netconf will
                // monitor sysrepo and will pick up any changes that may be
                // introduced, either using netconf clients or sysrepocfg.
                \(dqsubscribe\-changes\(dq: true,

                // This parameters specifies whether kea\-netconf will attempt
                // to verify if the upcoming NETCONF configuration is sane. The
                // verification is done by calling config\-test. Depending on
                // Kea response, the new configuration is accepted or rejected.
                \(dqvalidate\-changes\(dq: false,

                // Currently three control channel types are supported:
                // \- \(dqstdout\(dq which output the configuration on the standard
                //   output (this is mainly for testing purposes, but you can
                //   use simple script (such as curl or socat) to pass that
                //   information to the server.
                // \- \(dqunix\(dq which uses the local control channel supported by
                //   \(dqdhcp4\(dq and \(dqdhcp6\(dq servers (\(dqd2\(dq support is coming in Kea 1.5)
                // \- \(dqhttp\(dq (not yet supported?).
                \(dqcontrol\-socket\(dq:
                {
                    \(dqsocket\-type\(dq: \(dqunix\(dq,
                    \(dqsocket\-name\(dq: \(dqkea4\-ctrl\-socket\(dq
                },

                // Comment is optional. You can put some notes here.
                \(dqcomment\(dq: \(dqKea DHCPv4 server serving network on floor 13\(dq
            }

        },

        // Netconf is able to load hook libraries that augment its operation.
        // The primary functionality is the ability to add new commands.

        // Uncomment this section to load a hook library.

        // \(dqhooks\-libraries\(dq: [
        //    // Hook libraries list may contain more than one library.
        //    {
        //        // The only necessary parameter is the library filename.
        //        \(dqlibrary\(dq: \(dqnetconf\-commands.so\(dq,

        //        // Some libraries may support parameters. Make sure you
        //        // type this section carefully, as the server does not validate
        //        // it (because the format is library\-specific).
        //        \(dqparameters\(dq: {
        //            \(dqparam1\(dq: \(dqfoo\(dq
        //        }
        //    }
        // ]

        // Similar to other Kea components, Netconf also uses logging.
        \(dqloggers\(dq: [
            {
                \(dqname\(dq: \(dqkea\-netconf\(dq,
                \(dqoutput\-options\(dq: [
                    {
                        // \(dqoutput\(dq: \(dq/var/log/kea/kea\-netconf.log\(dq,
                        \(dqoutput\(dq: \(dqstdout\(dq,
                        // Several additional parameters are possible in addition
                        // to the typical output. Flush determines whether logger
                        // flushes output to a file. Maxsize determines maximum
                        // filesize before the file is rotated. maxver
                        // specifies the maximum number of rotated files being
                        // kept.
                        \(dqflush\(dq: true,
                        \(dqmaxsize\(dq: 204800,
                        \(dqmaxver\(dq: 4,
                         // We use pattern to specify custom log message layout
                        \(dqpattern\(dq: \(dq%d{%y.%m.%d %H:%M:%S.%q} %\-5p [%c/%i] %m\en\(dq
                    }
                ],
                // You can change the severity to DEBUG, INFO, WARN, ERROR or
                // CRIT. For DEBUG level, you can also additionally specify
                // debuglevel (0\-99, higher = more verbose). All configurations
                // are logged on DEBUG/55.
                \(dqseverity\(dq: \(dqINFO\(dq,
                \(dqdebuglevel\(dq: 0
            }
        ]
    }
}
.EE
.UNINDENT
.UNINDENT
.SS netconf/simple\-dhcp6.json
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This is a simple example of a configuration for Netconf that handles
// DHCPv6 configuration. This example provides YANG interface for
// DHCPv6 server only.
{
    \(dqNetconf\(dq:
    {
        // Three flags control netconf (default values are true):
        // \- \(dqboot\-update\(dq about the YANG configuration load when
        //   netconf boots.
        // \- \(dqsubscribe\-changes\(dq about the subscription to notifications
        //   when the running YANG module is changed.
        // \- \(dqvalidate\-changes\(dq allows to validate changes or not.
        \(dqboot\-update\(dq: true,
        \(dqsubscribe\-changes\(dq: true,
        \(dqvalidate\-changes\(dq: true,

        // This map specifies how each server is managed:
        // the YANG model to use and the control channel.
        \(dqmanaged\-servers\(dq:
        {
            // This is how Netconf can communicate with the DHCPv6 server.
            \(dqdhcp6\(dq:
            {
                // Eventually, the kea\-netconf will be able to handle multiple
                // models. However, for the time being the choices for
                // DHCPv6 server are kea\-dhcp6\-server and
                // ietf\-dhcpv6\-server models but only the first is usable.
                \(dqmodel\(dq: \(dqkea\-dhcp6\-server\(dq,

                // The three control flags can be defined in this scope too
                // and takes precedence over global and default values.
                // boot\-update determines whether the initial configuration
                // should be retrieved from netconf during kea\-netconf startup.
                // You almost always want to set this to yes.
                \(dqboot\-update\(dq: true,

                // This flag control whether the kea\-netconf daemon should
                // subscribe to any changes. If set to true, kea\-netconf will
                // monitor sysrepo and will pick up any changes that may be
                // introduced, either using netconf clients or sysrepocfg.
                \(dqsubscribe\-changes\(dq: true,

                // This parameters specifies whether kea\-netconf will attempt
                // to verify if the upcoming NETCONF configuration is sane. The
                // verification is done by calling config\-test. Depending on
                // Kea response, the new configuration is accepted or rejected.
                \(dqvalidate\-changes\(dq: false,

                // Currently three control channel types are supported:
                // \- \(dqstdout\(dq which output the configuration on the standard
                //   output (this is mainly for testing purposes, but you can
                //   use simple script (such as curl or socat) to pass that
                //   information to the server.
                // \- \(dqunix\(dq which uses the local control channel supported by
                //   \(dqdhcp4\(dq and \(dqdhcp6\(dq servers (\(dqd2\(dq support is coming in Kea 1.5)
                // \- \(dqhttp\(dq (not yet supported?).
                \(dqcontrol\-socket\(dq:
                {
                    \(dqsocket\-type\(dq: \(dqunix\(dq,
                    \(dqsocket\-name\(dq: \(dqkea6\-ctrl\-socket\(dq
                },

                // Comment is optional. You can put some notes here.
                \(dqcomment\(dq: \(dqKea DHCPv6 server serving network on floor 13\(dq
            }

        },

        // Netconf is able to load hook libraries that augment its operation.
        // The primary functionality is the ability to add new commands.

        // Uncomment this section to load a hook library.

        // \(dqhooks\-libraries\(dq: [
        //    // Hook libraries list may contain more than one library.
        //    {
        //        // The only necessary parameter is the library filename.
        //        \(dqlibrary\(dq: \(dqnetconf\-commands.so\(dq,

        //        // Some libraries may support parameters. Make sure you
        //        // type this section carefully, as the server does not validate
        //        // it (because the format is library\-specific).
        //        \(dqparameters\(dq: {
        //            \(dqparam1\(dq: \(dqfoo\(dq
        //        }
        //    }
        // ]

        // Similar to other Kea components, Netconf also uses logging.
        \(dqloggers\(dq: [
            {
                \(dqname\(dq: \(dqkea\-netconf\(dq,
                \(dqoutput\-options\(dq: [
                    {
                        // \(dqoutput\(dq: \(dq/var/log/kea/kea\-netconf.log\(dq,
                        \(dqoutput\(dq: \(dqstdout\(dq,
                        // Several additional parameters are possible in addition
                        // to the typical output. Flush determines whether logger
                        // flushes output to a file. Maxsize determines maximum
                        // filesize before the file is rotated. maxver
                        // specifies the maximum number of rotated files being
                        // kept.
                        \(dqflush\(dq: true,
                        \(dqmaxsize\(dq: 204800,
                        \(dqmaxver\(dq: 4,
                        // We use pattern to specify custom log message layout
                        \(dqpattern\(dq: \(dq%d{%y.%m.%d %H:%M:%S.%q} %\-5p [%c/%i] %m\en\(dq

                    }
                ],
                // You can change the severity to DEBUG, INFO, WARN, ERROR or
                // CRIT. For DEBUG level, you can also additionally specify
                // debuglevel (0\-99, higher = more verbose). All configurations
                // are logged on DEBUG/55.
                \(dqseverity\(dq: \(dqINFO\(dq,
                \(dqdebuglevel\(dq: 0
            }
        ]
    }
}
.EE
.UNINDENT
.UNINDENT
.SH CONFIGURATION TEMPLATES
.sp
The following sections include configuration templates for
certain deployment types. The example configuration files are also available in the Kea sources,
in the \fBdoc/examples\fP directory.
.SS Template: Home Network of a Power User
.sp
Below are some templates to assist in configuring the home network of a power user; they may also be
appropriate for a small office. These templates make the following assumptions:
.INDENT 0.0
.IP \(bu 2
The administrator wants to use a single /24 class of IPv4 addresses.
.IP \(bu 2
High Availability (HA) is desired, so there are two DHCP servers.
.IP \(bu 2
There are a handful of devices, and some of them (e.g. a printer or NAS) require
static addresses or extra options.
.IP \(bu 2
The administrator does not want to be bothered with database management.
.IP \(bu 2
The setup is optimized for minimal to zero maintenance.
.IP \(bu 2
Performance is not an issue; hundreds of queries per second are not expected.
.IP \(bu 2
IPv6 is not used.
.IP \(bu 2
DNS updates will not be performed by Kea.
.UNINDENT
.sp
The logical setup consists of two hosts, each running a Kea DHCPv4 server.
Each server acts as one partner of the HA pair.
.INDENT 0.0
.INDENT 3.5
.sp
.EX
+\-host\-1\-+       +\-host\-2\-+
|        |       |        |
| DHCPv4 ========= DHCPv4 |    ===== \- HTTP connection
|        |       |        |
+\-\-\-\-\-\-\-\-+       +\-\-\-\-\-\-\-\-+
.EE
.UNINDENT
.UNINDENT
.sp
The servers on host\-1 and host\-2 both listen on port 8000.
.SS Deployment Considerations
.sp
This setup is not expected to be very performant. Most modest hardware will do; Kea has been successfully
deployed on Raspberry Pi platforms, for example. If it is running on a VM, 2GB of RAM with one CPU core should
be sufficient. Ubuntu LTS is a choice that is easy to set up and is
low maintenance; however, any Linux or FreeBSD operating system is fine. Less popular systems, such as OpenBSD or
NetBSD, should also work in principle, but they are not regularly tested.
.sp
In this example, there are two hosts running Kea:
.INDENT 0.0
.IP \(bu 2
192.168.1.2 \- primary HA server (active, handles all the traffic)
.IP \(bu 2
192.168.1.3 \- secondary HA server (passive, ready to take over if the primary fails)
.UNINDENT
.sp
The network is 192.168.1.0/24. It is assumed that 192.168.1.1 is the default router.
.sp
The whole subnet is split into dynamic and static pools:
.INDENT 0.0
.IP \(bu 2
192.168.1.100 \- 192.168.1.199 \- this is the dynamic pool. When new devices appear in the network,
they are assigned dynamic addresses from this pool.
.IP \(bu 2
The reservations are done outside of this dynamic range (depending on the addressing preference,
either 192.168.1.1\-192.168.1.99 or 192.168.1.200\-192.168.1.254).
.UNINDENT
.sp
To deploy this setup, perform the following steps:
.INDENT 0.0
.IP 1. 3
Install the DHCPv4 server on host\-1, and copy the configuration file to their typical locations.
It is usually in \fB/etc/kea\fP on Linux and \fB/usr/local/etc/kea\fP on FreeBSD, and the file is typically called
\fBkea\-dhcp4.conf\fP\&. Please consult the startup scripts for any specific system.
.IP 2. 3
Alter the following to match the local setup:
.INDENT 3.0
.IP \(bu 2
The interface name that Kea should listen on (\fBinterfaces\fP in \fBinterfaces\-config\fP).
.IP \(bu 2
The interface name that is used to access the subnet (\fBinterface\fP in \fBsubnet4\fP).
.IP \(bu 2
The addressing, if using something other than 192.168.1.0/24. Make sure the control address and port
configuration (\fBsocket\-address\fP and \fBsocket\-port\fP) matches the HA
configuration (\fBurl\fP in \fBhook\-libraries/parameters/high\-availability/peers\fP).
.IP \(bu 2
The router option, to match the actual network.
.IP \(bu 2
The DNS option, to match the actual network.
.UNINDENT
.IP 3. 3
If using a firewall, make sure host\-1 can reach host\-2. An easy way to ensure that is to
try to retrieve host\-2\(aqs config from host\-1:
.sp
\fBcurl \-X POST \-H \(dqContent\-Type: application/json\(dq \-d \(aq{ \(dqcommand\(dq: \(dqconfig\-get\(dq, \(dqservice\(dq: [ \(dqdhcp4\(dq ] }\(aq  http://192.168.1.3:8000/\fP
.sp
The DHCPv4 running configuration should be returned, in JSON format.
.IP 4. 3
Verify that communication between the hosts works in the opposite direction as well
(host\-2 can connect to host\-1), by repeating step 3 from host\-2 using host\-1\(aqs IP address and port.
.IP 5. 3
Install the DHCPv4 server on host\-2, as in steps 1 and 2. The config file for the
standby server is very similar to the one on the primary server, other than the definition of
the \fBthis\-server\-name\fP field (and possibly the interface names).
.UNINDENT
.SS Possible Extensions
.sp
This sample configuration is basic but functional. Once it is set up and running, administrators
may wish to consider the following changes:
.INDENT 0.0
.IP \(bu 2
If there is a local DNS server, DNS updates can be configured via Kea. This requires running a DHCP\-DDNS update server
(\fBkea\-dhcp\-ddns\fP). See Overview \%<#\:dhcp-ddns-overview> for details.
.IP \(bu 2
To run Stateful DHCP for IPv6, a \fBkea\-dhcp6\fP server is necessary. Its configuration
is very similar to \fBkea\-dhcp4\fP, but there are some notable differences: the default gateway is not
configured via the DHCPv6 protocol, but via router advertisements sent by the local router. Also, the
DHCPv6 concept of prefix delegation does not exist in DHCPv4. See The DHCPv6 Server \%<#\:dhcp6>
for details.
.IP \(bu 2
To expand the local network, adding a MySQL or PostgreSQL database is a popular solution.
Users can choose to store leases, host reservations, and even most of the configuration
in a database. See Kea Database Administration \%<#\:admin> and the \fBlease\-database\fP, \fBhosts\-database\fP, and
\fBconfig\-control\fP parameters in The DHCPv4 Server \%<#\:dhcp4>\&.
.IP \(bu 2
To provide more insight into how the DHCP server operates, Kea\(aqs RESTful API can query
for many runtime statistics or even change the configuration during runtime. Users may also
consider deploying Stork, which is a rapidly developing dashboard for Kea. See Monitoring Kea With Stork \%<#\:stork>
for more information.
.IP \(bu 2
All Kea users should read Kea Security \%<#\:security>: to learn about various trade\-offs between
convenience and security in Kea.
.UNINDENT
.sp
Some tweaking of these templates may be required to match specific system needs: at a
minimum, the lines highlighted in yellow must be adjusted to match the actual deployment.
.sp
Server1\(aqs DHCPv4 configuration file:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This is an example configuration of the Kea DHCPv4 server 1:
//
// \- uses High Availability hook library and Lease Commands hook library
//   to enable High Availability function for the DHCP server. This config
//   file is for the primary (the active) server.
// \- uses memfile, which stores lease data in a local CSV file
// \- it assumes a single /24 addressing over a link that is directly reachable
//   (no DHCP relays)
// \- there is a handful of IP reservations
//
// It is expected to run with a standby (the passive) server, which has a very similar
// configuration. The only difference is that \(dqthis\-server\-name\(dq must be set to \(dqserver2\(dq on the
// other server. Also, the interface configuration depends on the network settings of the
// particular machine.

{

\(dqDhcp4\(dq: {

    // Add names of your network interfaces to listen on.
    \(dqinterfaces\-config\(dq: {
        // The DHCPv4 server listens on this interface. When changing this to
        // the actual name of your interface, make sure to also update the
        // interface parameter in the subnet definition below.
        \(dqinterfaces\(dq: [ \(dqenp0s8\(dq ]
    },

    // Control socket is required for communication with the
    // DHCP server. High Availability requires HTTP/HTTPS control sockets
    // to be configured because lease updates are sent over the RESTful
    // API between the HA peers.
    \(dqcontrol\-socket\(dq: {
        \(dqsocket\-type\(dq: \(dqhttp\(dq,

        // We need to specify where the agent should listen to incoming HTTP
        // queries.
        \(dqsocket\-address\(dq: \(dq192.168.1.2\(dq,

        // This specifies the port the server will listen on.
        \(dqsocket\-port\(dq: 8000
    },

    // Use Memfile lease database backend to store leases in a CSV file.
    // Depending on how Kea was compiled, it may also support SQL databases
    // (MySQL and/or PostgreSQL). Those database backends require more
    // parameters, like name, host and possibly user and password.
    // There are dedicated examples for each backend. See Section 7.2.2 \(dqLease
    // Storage\(dq for details.
    \(dqlease\-database\(dq: {
        // Memfile is the simplest and easiest backend to use. It\(aqs an in\-memory
        // database with data being written to a CSV file. It is very similar to
        // what ISC DHCP does.
        \(dqtype\(dq: \(dqmemfile\(dq
    },

    // Let\(aqs configure some global parameters. The home network is not very dynamic
    // and there\(aqs no shortage of addresses, so no need to recycle aggressively.
    \(dqvalid\-lifetime\(dq: 43200, // leases will be valid for 12h
    \(dqrenew\-timer\(dq: 21600, // clients should renew every 6h
    \(dqrebind\-timer\(dq: 32400, // clients should start looking for other servers after 9h

    // Kea will clean up its database of expired leases once per hour. However, it
    // will keep the leases in expired state for 2 days. This greatly increases the
    // chances for returning devices to get the same address again. To guarantee that,
    // use host reservation.
    // If both \(dqflush\-reclaimed\-timer\-wait\-time\(dq and \(dqhold\-reclaimed\-time\(dq are
    // not 0, when the client sends a release message the lease is expired
    // instead of being deleted from lease storage.
    \(dqexpired\-leases\-processing\(dq: {
        \(dqreclaim\-timer\-wait\-time\(dq: 3600,
        \(dqhold\-reclaimed\-time\(dq: 172800,
        \(dqmax\-reclaim\-leases\(dq: 0,
        \(dqmax\-reclaim\-time\(dq: 0
    },

    // Multi\-threading parameters.
    \(dqmulti\-threading\(dq: {
        // By default, Kea processes packets on multiple threads if the hardware
        // permits. This example uses single\-threaded configuration.
        \(dqenable\-multi\-threading\(dq: false,

        // When multi\-threading is enabled, Kea will process packets on a
        // number of multiple threads configurable through this option. The
        // value must be a positive integer (0 means auto\-detect).
        \(dqthread\-pool\-size\(dq: 0,

        // When multi\-threading is enabled, Kea will read packets from the
        // interface and append a working item to the thread pool. This
        // option configures the maximum number of items that can be queued.
        // The value must be a positive integer (0 means unlimited).
        \(dqpacket\-queue\-size\(dq: 0
    },

    // HA requires two hook libraries to be loaded: libdhcp_lease_cmds.so and
    // libdhcp_ha.so. The former handles incoming lease updates from the HA peers.
    // The latter implements high availability feature for Kea. Note the library name
    // should be the same, but the path is OS specific.
    \(dqhooks\-libraries\(dq: [
        // The lease_cmds library must be loaded because HA makes use of it to
        // deliver lease updates to the server as well as synchronize the
        // lease database after failure.
        {
            \(dqlibrary\(dq: \(dqlibdhcp_lease_cmds.so\(dq
        },

        {
            // The HA hook library should be loaded.
            \(dqlibrary\(dq: \(dqlibdhcp_ha.so\(dq,
            \(dqparameters\(dq: {
                // Each server should have the same HA configuration, except for the
                // \(dqthis\-server\-name\(dq parameter.
                \(dqhigh\-availability\(dq: [ {
                    // This parameter points to this server instance. The respective
                    // HA peers must have this parameter set to their own names.
                    \(dqthis\-server\-name\(dq: \(dqserver1\(dq,
                    // The HA mode is set to hot\-standby. In this mode, the active server handles
                    // all the traffic. The standby takes over if the primary becomes unavailable.
                    \(dqmode\(dq: \(dqhot\-standby\(dq,
                    // Heartbeat is to be sent every 10 seconds if no other control
                    // commands are transmitted.
                    \(dqheartbeat\-delay\(dq: 10000,
                    // Maximum time for partner\(aqs response to a heartbeat, after which
                    // failure detection is started. This is specified in milliseconds.
                    // If we don\(aqt hear from the partner in 60 seconds, it\(aqs time to
                    // start worrying.
                    \(dqmax\-response\-delay\(dq: 60000,
                    // The following parameters control how the server detects the
                    // partner\(aqs failure. The ACK delay sets the threshold for the
                    // \(aqsecs\(aq field of the received discovers. This is specified in
                    // milliseconds.
                    \(dqmax\-ack\-delay\(dq: 5000,
                    // This specifies the number of clients which send messages to
                    // the partner but appear to not receive any response.
                    \(dqmax\-unacked\-clients\(dq: 5,
                    // This specifies the maximum timeout (in milliseconds) for the server
                    // to complete sync. If you have a large deployment (high tens or
                    // hundreds of thousands of clients), you may need to increase it
                    // further. The default value is 60000ms (60 seconds).
                    \(dqsync\-timeout\(dq: 60000,
                    // Multi\-threading parameters.
                    \(dqmulti\-threading\(dq: {
                        // By default, Kea processes packets on multiple threads if the hardware
                        // permits. This example uses single\-threaded configuration.
                       \(dqenable\-multi\-threading\(dq: false,
                       \(dqhttp\-dedicated\-listener\(dq: false,
                       \(dqhttp\-listener\-threads\(dq: 0,
                       \(dqhttp\-client\-threads\(dq: 0
                    },
                    \(dqpeers\(dq: [
                        // This is the configuration of this server instance.
                        {
                            \(dqname\(dq: \(dqserver1\(dq,
                            // This specifies the URL of this server instance.
                            // The \(dqcontrol\-socket\(dq is needed for the High Availability
                            // with single\-threading, and the \(dqsocket\-address\(dq and
                            // \(dqsocket\-port\(dq must be set to the corresponding values.
                            \(dqurl\(dq: \(dqhttp://192.168.1.2:8000/\(dq,
                            // This server is primary. The other one must be
                            // secondary.
                            \(dqrole\(dq: \(dqprimary\(dq
                        },
                        // This is the configuration of the secondary server.
                        {
                            \(dqname\(dq: \(dqserver2\(dq,
                            // Specifies the URL on which the partner\(aqs control
                            // channel can be reached.
                            // The \(dqcontrol\-socket\(dq is needed for the High Availability
                            // with single\-threading, and the \(dqsocket\-address\(dq and
                            // \(dqsocket\-port\(dq must be set to the corresponding values.
                            \(dqurl\(dq: \(dqhttp://192.168.1.3:8000/\(dq,
                            // The other server is secondary. This one must be
                            // primary.
                            \(dqrole\(dq: \(dqstandby\(dq
                        }
                    ]
                } ]
            }
        }
    ],

    // This example contains a single subnet declaration.
    \(dqsubnet4\(dq: [
        {
            // Subnet prefix.
            \(dqsubnet\(dq: \(dq192.168.1.0/24\(dq,

            // There are no relays in this network, so we need to tell Kea that this subnet
            // is reachable directly via the specified interface.
            \(dqinterface\(dq: \(dqenp0s8\(dq,

            // Specify a dynamic address pool.
            \(dqpools\(dq: [
                {
                    \(dqpool\(dq: \(dq192.168.1.100\-192.168.1.199\(dq
                }
            ],

            // These are options that are subnet specific. In most cases, you need to define at
            // least routers option, as without this option your clients will not be able to reach
            // their default gateway and will not have Internet connectivity. If you have many
            // subnets and they share the same options (e.g. DNS servers typically is the same
            // everywhere), you may define options at the global scope, so you don\(aqt repeat them
            // for every network.
            \(dqoption\-data\(dq: [
                {
                    // For each IPv4 subnet you typically need to specify at least one router.
                    \(dqname\(dq: \(dqrouters\(dq,
                    \(dqdata\(dq: \(dq192.168.1.1\(dq
                },
                {
                    // Using cloudflare or Quad9 is a reasonable option. Change this
                    // to your own DNS servers is you have them. Another popular
                    // choice is 8.8.8.8, owned by Google. Using third party DNS
                    // service raises some privacy concerns.
                    \(dqname\(dq: \(dqdomain\-name\-servers\(dq,
                    \(dqdata\(dq: \(dq1.1.1.1,9.9.9.9\(dq
                }
            ],

            // Some devices should get a static address. Since the .100 \- .199 range is dynamic,
            // let\(aqs use the lower address space for this. There are many ways how reservation
            // can be defined, but using MAC address (hw\-address) is by far the most popular one.
            // You can use client\-id, duid and even custom defined flex\-id that may use whatever
            // parts of the packet you want to use as identifiers. Also, there are many more things
            // you can specify in addition to just an IP address: extra options, next\-server, hostname,
            // assign device to client classes etc. See the Kea ARM, Section 8.3 for details.
            // The reservations are subnet specific.
            \(dqreservations\(dq: [
                {
                    \(dqhw\-address\(dq: \(dq1a:1b:1c:1d:1e:1f\(dq,
                    \(dqip\-address\(dq: \(dq192.168.1.10\(dq
                },
                {
                    \(dqclient\-id\(dq: \(dq01:11:22:33:44:55:66\(dq,
                    \(dqip\-address\(dq: \(dq192.168.1.11\(dq
                }
            ]
        }
    ],

    // Logging configuration starts here.
    \(dqloggers\(dq: [
    {
        // This section affects kea\-dhcp4, which is the base logger for DHCPv4 component. It tells
        // DHCPv4 server to write all log messages (on severity INFO or higher) to a file. The file
        // will be rotated once it grows to 2MB and up to 4 files will be kept. The debuglevel
        // (range 0 to 99) is used only when logging on DEBUG level.
        \(dqname\(dq: \(dqkea\-dhcp4\(dq,
        \(dqoutput\-options\(dq: [
            {
                \(dqoutput\(dq: \(dq/var/log/kea/kea\-dhcp4.log\(dq,
                \(dqmaxsize\(dq: 2048000,
                \(dqmaxver\(dq: 4
            }
        ],
        \(dqseverity\(dq: \(dqINFO\(dq,
        \(dqdebuglevel\(dq: 0
    }
  ]
}
}

.EE
.UNINDENT
.UNINDENT
.sp
Server2\(aqs DHCPv4 configuration file:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This is an example configuration of the Kea DHCPv4 server 2:
//
// \- uses High Availability hook library and Lease Commands hook library
//   to enable High Availability function for the DHCP server. This config
//   file is for the primary (the active) server.
// \- uses memfile, which stores lease data in a local CSV file
// \- it assumes a single /24 addressing over a link that is directly reachable
//   (no DHCP relays)
// \- there is a handful of IP reservations
//
// It is expected to run with a primary (the active) server, which has a very similar
// configuration. The only difference is that \(dqthis\-server\-name\(dq must be set to \(dqserver2\(dq on the
// other server. Also, the interface configuration depends on the network settings of the
// particular machine.

{

\(dqDhcp4\(dq: {

    // Add names of your network interfaces to listen on.
    \(dqinterfaces\-config\(dq: {
        // The DHCPv4 server listens on this interface. When changing this to
        // the actual name of your interface, make sure to also update the
        // interface parameter in the subnet definition below.
        \(dqinterfaces\(dq: [ \(dqenp0s8\(dq ]
    },

    // Control socket is required for communication with the
    // DHCP server. High Availability requires HTTP/HTTPS control sockets
    // to be configured because lease updates are sent over the RESTful
    // API between the HA peers.
    \(dqcontrol\-socket\(dq: {
        \(dqsocket\-type\(dq: \(dqhttp\(dq,

        // We need to specify where the agent should listen to incoming HTTP
        // queries.
        \(dqsocket\-address\(dq: \(dq192.168.1.3\(dq,

        // This specifies the port the server will listen on.
        \(dqsocket\-port\(dq: 8000
    },

    // Use Memfile lease database backend to store leases in a CSV file.
    // Depending on how Kea was compiled, it may also support SQL databases
    // (MySQL and/or PostgreSQL). Those database backends require more
    // parameters, like name, host and possibly user and password.
    // There are dedicated examples for each backend. See Section 7.2.2 \(dqLease
    // Storage\(dq for details.
    \(dqlease\-database\(dq: {
        // Memfile is the simplest and easiest backend to use. It\(aqs an in\-memory
        // database with data being written to a CSV file. It is very similar to
        // what ISC DHCP does.
        \(dqtype\(dq: \(dqmemfile\(dq
    },

    // Let\(aqs configure some global parameters. The home network is not very dynamic
    // and there\(aqs no shortage of addresses, so no need to recycle aggressively.
    \(dqvalid\-lifetime\(dq: 43200, // leases will be valid for 12h
    \(dqrenew\-timer\(dq: 21600, // clients should renew every 6h
    \(dqrebind\-timer\(dq: 32400, // clients should start looking for other servers after 9h

    // Kea will clean up its database of expired leases once per hour. However, it
    // will keep the leases in expired state for 2 days. This greatly increases the
    // chances for returning devices to get the same address again. To guarantee that,
    // use host reservation.
    // If both \(dqflush\-reclaimed\-timer\-wait\-time\(dq and \(dqhold\-reclaimed\-time\(dq are
    // not 0, when the client sends a release message the lease is expired
    // instead of being deleted from lease storage.
    \(dqexpired\-leases\-processing\(dq: {
        \(dqreclaim\-timer\-wait\-time\(dq: 3600,
        \(dqhold\-reclaimed\-time\(dq: 172800,
        \(dqmax\-reclaim\-leases\(dq: 0,
        \(dqmax\-reclaim\-time\(dq: 0
    },

    // Multi\-threading parameters.
    \(dqmulti\-threading\(dq: {
        // By default, Kea processes packets on multiple threads if the hardware
        // permits. This example uses single\-threaded configuration.
        \(dqenable\-multi\-threading\(dq: false,

        // When multi\-threading is enabled, Kea will process packets on a
        // number of multiple threads configurable through this option. The
        // value must be a positive integer (0 means auto\-detect).
        \(dqthread\-pool\-size\(dq: 0,

        // When multi\-threading is enabled, Kea will read packets from the
        // interface and append a working item to the thread pool. This
        // option configures the maximum number of items that can be queued.
        // The value must be a positive integer (0 means unlimited).
        \(dqpacket\-queue\-size\(dq: 0
    },

    // HA requires two hook libraries to be loaded: libdhcp_lease_cmds.so and
    // libdhcp_ha.so. The former handles incoming lease updates from the HA peers.
    // The latter implements high availability feature for Kea. Note the library name
    // should be the same, but the path is OS specific.
    \(dqhooks\-libraries\(dq: [
        // The lease_cmds library must be loaded because HA makes use of it to
        // deliver lease updates to the server as well as synchronize the
        // lease database after failure.
        {
            \(dqlibrary\(dq: \(dqlibdhcp_lease_cmds.so\(dq
        },

        {
            // The HA hook library should be loaded.
            \(dqlibrary\(dq: \(dqlibdhcp_ha.so\(dq,
            \(dqparameters\(dq: {
                // Each server should have the same HA configuration, except for the
                // \(dqthis\-server\-name\(dq parameter.
                \(dqhigh\-availability\(dq: [ {
                    // This parameter points to this server instance. The respective
                    // HA peers must have this parameter set to their own names.
                    \(dqthis\-server\-name\(dq: \(dqserver2\(dq,
                    // The HA mode is set to hot\-standby. In this mode, the active server handles
                    // all the traffic. The standby takes over if the primary becomes unavailable.
                    \(dqmode\(dq: \(dqhot\-standby\(dq,
                    // Heartbeat is to be sent every 10 seconds if no other control
                    // commands are transmitted.
                    \(dqheartbeat\-delay\(dq: 10000,
                    // Maximum time for partner\(aqs response to a heartbeat, after which
                    // failure detection is started. This is specified in milliseconds.
                    // If we don\(aqt hear from the partner in 60 seconds, it\(aqs time to
                    // start worrying.
                    \(dqmax\-response\-delay\(dq: 60000,
                    // The following parameters control how the server detects the
                    // partner\(aqs failure. The ACK delay sets the threshold for the
                    // \(aqsecs\(aq field of the received discovers. This is specified in
                    // milliseconds.
                    \(dqmax\-ack\-delay\(dq: 5000,
                    // This specifies the number of clients which send messages to
                    // the partner but appear to not receive any response.
                    \(dqmax\-unacked\-clients\(dq: 5,
                    // This specifies the maximum timeout (in milliseconds) for the server
                    // to complete sync. If you have a large deployment (high tens or
                    // hundreds of thousands of clients), you may need to increase it
                    // further. The default value is 60000ms (60 seconds).
                    \(dqsync\-timeout\(dq: 60000,
                    // Multi\-threading parameters.
                    \(dqmulti\-threading\(dq: {
                        // By default, Kea processes packets on multiple threads if the hardware
                        // permits. This example uses single\-threaded configuration.
                       \(dqenable\-multi\-threading\(dq: false,
                       \(dqhttp\-dedicated\-listener\(dq: false,
                       \(dqhttp\-listener\-threads\(dq: 0,
                       \(dqhttp\-client\-threads\(dq: 0
                    },
                    \(dqpeers\(dq: [
                        // This is the configuration of the primary server.
                        {
                            \(dqname\(dq: \(dqserver1\(dq,
                            // Specifies the URL on which the partner\(aqs control
                            // channel can be reached.
                            // The \(dqcontrol\-socket\(dq is needed for the High Availability
                            // with single\-threading, and the \(dqsocket\-address\(dq and
                            // \(dqsocket\-port\(dq must be set to the corresponding values.
                            \(dqurl\(dq: \(dqhttp://192.168.1.2:8000/\(dq,
                            // The other server is primary. This one must be
                            // secondary.
                            \(dqrole\(dq: \(dqprimary\(dq
                        },
                        // This is the configuration of this server instance.
                        {
                            \(dqname\(dq: \(dqserver2\(dq,
                            // This specifies the URL of this server instance.
                            // The \(dqcontrol\-socket\(dq is needed for the High Availability
                            // with single\-threading, and the \(dqsocket\-address\(dq and
                            // \(dqsocket\-port\(dq must be set to the corresponding values.
                            \(dqurl\(dq: \(dqhttp://192.168.1.3:8000/\(dq,
                            // This server is secondary. The other one must be
                            // primary.
                            \(dqrole\(dq: \(dqstandby\(dq
                        }
                    ]
                } ]
            }
        }
    ],

    // This example contains a single subnet declaration.
    \(dqsubnet4\(dq: [
        {
            // Subnet prefix.
            \(dqsubnet\(dq: \(dq192.168.1.0/24\(dq,

            // There are no relays in this network, so we need to tell Kea that this subnet
            // is reachable directly via the specified interface.
            \(dqinterface\(dq: \(dqenp0s8\(dq,

            // Specify a dynamic address pool.
            \(dqpools\(dq: [
                {
                    \(dqpool\(dq: \(dq192.168.1.100\-192.168.1.199\(dq
                }
            ],

            // These are options that are subnet specific. In most cases, you need to define at
            // least routers option, as without this option your clients will not be able to reach
            // their default gateway and will not have Internet connectivity. If you have many
            // subnets and they share the same options (e.g. DNS servers typically is the same
            // everywhere), you may define options at the global scope, so you don\(aqt repeat them
            // for every network.
            \(dqoption\-data\(dq: [
                {
                    // For each IPv4 subnet you typically need to specify at least one router.
                    \(dqname\(dq: \(dqrouters\(dq,
                    \(dqdata\(dq: \(dq192.168.1.1\(dq
                },
                {
                    // Using cloudflare or Quad9 is a reasonable option. Change this
                    // to your own DNS servers is you have them. Another popular
                    // choice is 8.8.8.8, owned by Google. Using third party DNS
                    // service raises some privacy concerns.
                    \(dqname\(dq: \(dqdomain\-name\-servers\(dq,
                    \(dqdata\(dq: \(dq1.1.1.1,9.9.9.9\(dq
                }
            ],

            // Some devices should get a static address. Since the .100 \- .199 range is dynamic,
            // let\(aqs use the lower address space for this. There are many ways how reservation
            // can be defined, but using MAC address (hw\-address) is by far the most popular one.
            // You can use client\-id, duid and even custom defined flex\-id that may use whatever
            // parts of the packet you want to use as identifiers. Also, there are many more things
            // you can specify in addition to just an IP address: extra options, next\-server, hostname,
            // assign device to client classes etc. See the Kea ARM, Section 8.3 for details.
            // The reservations are subnet specific.
            \(dqreservations\(dq: [
                {
                    \(dqhw\-address\(dq: \(dq1a:1b:1c:1d:1e:1f\(dq,
                    \(dqip\-address\(dq: \(dq192.168.1.10\(dq
                },
                {
                    \(dqclient\-id\(dq: \(dq01:11:22:33:44:55:66\(dq,
                    \(dqip\-address\(dq: \(dq192.168.1.11\(dq
                }
            ]
        }
    ],

    // Logging configuration starts here.
    \(dqloggers\(dq: [
    {
        // This section affects kea\-dhcp4, which is the base logger for DHCPv4 component. It tells
        // DHCPv4 server to write all log messages (on severity INFO or higher) to a file. The file
        // will be rotated once it grows to 2MB and up to 4 files will be kept. The debuglevel
        // (range 0 to 99) is used only when logging on DEBUG level.
        \(dqname\(dq: \(dqkea\-dhcp4\(dq,
        \(dqoutput\-options\(dq: [
            {
                \(dqoutput\(dq: \(dq/var/log/kea/kea\-dhcp4.log\(dq,
                \(dqmaxsize\(dq: 2048000,
                \(dqmaxver\(dq: 4
            }
        ],
        \(dqseverity\(dq: \(dqINFO\(dq,
        \(dqdebuglevel\(dq: 0
    }
  ]
}
}

.EE
.UNINDENT
.UNINDENT
.SS Template: Secure High Availability Kea DHCP with Multi\-Threading
.sp
Below are some templates to assist in configuring a secure Kea DHCP server with
multi\-threading. These templates make the following assumptions:
.INDENT 0.0
.IP \(bu 2
The administrator wants to set up High Availability (HA) with multi\-threading.
.IP \(bu 2
The machines running Kea with multi\-threading have at least four CPU cores.
.IP \(bu 2
The connection to the peer is secured using TLS.
.UNINDENT
.sp
The logical setup consists of two hosts, each running a Kea DHCPv4 server.
In the multi\-threading setup, control sockets are not required, as the server is using its
own dedicated HTTP listener to communicate with the peer. However, HTTPS control
sockets can still be used to handle user commands.
.INDENT 0.0
.INDENT 3.5
.sp
.EX
+\-host\-1\-+       +\-host\-2\-+
|        |       |        |
| DHCPv4 ========= DHCPv4 |    ===== \- HTTPS connection
|        |       |        |
+\-\-\-\-\-\-\-\-+       +\-\-\-\-\-\-\-\-+
.EE
.UNINDENT
.UNINDENT
.sp
The servers on host\-1 and host\-2 both listen on port 8001, and the server\(aqs dedicated HTTP
listener uses port 8000. The DHCP servers communicate with each other via the dedicated HTTP
listener, which forwards only the lease\-update commands to the peer server.
.SS Deployment Considerations
.sp
The setup is not expected to scale automatically. This example uses four threads for
processing DHCP traffic, four threads for listening and handling HA peer HTTP requests,
and four threads for sending lease updates to the HA peer. The thread queue used to
store incoming DHCP requests is set to 64, but proper testing and benchmarks are required
to determine the appropriate values for best performance on the deployment setup.
.sp
In this example, there are two hosts running Kea:
.INDENT 0.0
.IP \(bu 2
192.168.1.2 \- primary HA server (active, handles all the traffic)
.IP \(bu 2
192.168.1.3 \- secondary HA server (passive, ready to take over if the primary fails)
.UNINDENT
.sp
The network is 192.168.1.0/24. It is assumed that 192.168.1.1 is the default router.
.sp
The whole subnet is split into dynamic pools:
.INDENT 0.0
.IP \(bu 2
192.168.1.100 \- 192.168.1.199 \- this is the dynamic pool. When new devices appear in the network,
they are assigned dynamic addresses from this pool.
.UNINDENT
.sp
To deploy this setup, follow the steps provided in the power user home setup with the following distinctions:
.INDENT 0.0
.IP 1. 3
Alter the following to match the local setup:
.INDENT 3.0
.IP \(bu 2
The paths to \fBtrust\-anchor\fP, \fBcert\-file\fP, and \fBkey\-file\fP must be set to the
respective values corresponding to the deployment machine.
.IP \(bu 2
The addressing must be updated, if using something other than 192.168.1.0/24.
Make sure the control socket address and port
configuration (\fBsocket\-address\fP and \fBsocket\-port\fP) is different from the HA
configuration (\fBurl\fP in \fBhook\-libraries/parameters/high\-availability/peers\fP).
The HTTP control socket is used to handle only management commands,
as the HA module sends lease updates using the dedicated HTTP listener to the peer.
.UNINDENT
.IP 2. 3
Verify the communication between the HA peers by checking the Kea logs.
.IP 3. 3
Verify that communication between the hosts works in the opposite direction as well
(host\-2 can connect to host\-1), by repeating step 3 from host\-2 using host\-1\(aqs IP address and port.
.IP 4. 3
Install DHCPv4 on host\-2, as in steps 1 and 2. The config file for the
standby server is very similar to the one on the primary server, other than the definition of
the \fBthis\-server\-name\fP field (and possibly the interface names).
.UNINDENT
.SS Possible Extensions
.sp
This sample configuration is basic but functional. Once it is set up and running, administrators
may wish to consider the following changes:
.INDENT 0.0
.IP \(bu 2
If using a database, it is also possible to configure TLS for the database backend (for
lease, host, configuration backend, or forensic logging). See Database Connectivity \%<#\:database-connectivity>
for more information.
.UNINDENT
.sp
Some tweaking of these templates may be required to match specific system needs: at a
minimum, the lines highlighted in yellow must be adjusted to match the actual deployment.
.sp
Server1\(aqs DHCPv4 configuration file:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This is an example configuration of the Kea DHCPv4 server 1:
//
// \- uses High Availability hook library and Lease Commands hook library
//   to enable High Availability function for the DHCP server. This config
//   file is for the primary (the active) server.
// \- uses memfile, which stores lease data in a local CSV file
// \- it assumes a single /24 addressing over a link that is directly reachable
//   (no DHCP relays)
// \- there is a handful of IP reservations
//
// It is expected to run with a standby (the passive) server, which has a very similar
// configuration. The only difference is that \(dqthis\-server\-name\(dq must be set to \(dqserver2\(dq on the
// other server. Also, the interface configuration and location of TLS specific files
// depend on the network settings and configuration of the particular machine.

{

\(dqDhcp4\(dq: {

    // Add names of your network interfaces to listen on.
    \(dqinterfaces\-config\(dq: {
        // The DHCPv4 server listens on this interface. When changing this to
        // the actual name of your interface, make sure to also update the
        // interface parameter in the subnet definition below.
        \(dqinterfaces\(dq: [ \(dqenp0s8\(dq ]
    },

    // Control socket is required for communication with the
    // DHCP server. High Availability requires HTTP/HTTPS control sockets
    // to be configured because lease updates are sent over the RESTful
    // API between the HA peers.
    \(dqcontrol\-socket\(dq: {
        \(dqsocket\-type\(dq: \(dqhttps\(dq,

        // We need to specify where the server should listen to incoming HTTP
        // queries.
        \(dqsocket\-address\(dq: \(dq192.168.1.2\(dq,

        // This specifies the port server will listen on.
        // If enabling HA and multi\-threading, the 8000 port is used by the HA
        // hook library http listener. When using HA hook library with
        // multi\-threading to function, make sure the port used by dedicated
        // listener is different (e.g. 8001) than the one used by server. Note
        // the commands should still be sent to the control socket.
        // The dedicated listener is specifically for HA updates only.
        \(dqsocket\-port\(dq: 8001,

        // TLS trust anchor (Certificate Authority). This is a file name or
        // (for OpenSSL only) a directory path.
        \(dqtrust\-anchor\(dq: \(dq/usr/lib/kea/CA.pem\(dq,

        // TLS server certificate file name.
        \(dqcert\-file\(dq: \(dq/usr/lib/kea/ca1_cert.pem\(dq,

        // TLS server private key file name.
        \(dqkey\-file\(dq: \(dq/usr/lib/kea/ca1_key.pem\(dq,

        // TLS require client certificates flag.
        \(dqcert\-required\(dq: true
    },

    // Multi\-threading parameters.
    \(dqmulti\-threading\(dq: {
        // By default, Kea processes packets on multiple threads if the hardware permits.
        \(dqenable\-multi\-threading\(dq: true,

        // When multi\-threading is enabled, Kea will process packets on a
        // number of multiple threads configurable through this option. The
        // value must be a positive integer (0 means auto\-detect).
        \(dqthread\-pool\-size\(dq: 4,

        // When multi\-threading is enabled, Kea will read packets from the
        // interface and append a working item to the thread pool. This
        // option configures the maximum number of items that can be queued.
        // The value must be a positive integer (0 means unlimited).
        \(dqpacket\-queue\-size\(dq: 64
    },

    // Use Memfile lease database backend to store leases in a CSV file.
    // Depending on how Kea was compiled, it may also support SQL databases
    // (MySQL and/or PostgreSQL). Those database backends require more
    // parameters, like name, host and possibly user and password.
    // There are dedicated examples for each backend. See Section 7.2.2 \(dqLease
    // Storage\(dq for details.
    \(dqlease\-database\(dq: {
        // Memfile is the simplest and easiest backend to use. It\(aqs an in\-memory
        // database with data being written to a CSV file. It is very similar to
        // what ISC DHCP does.
        \(dqtype\(dq: \(dqmemfile\(dq
    },

    // Let\(aqs configure some global parameters. The home network is not very dynamic
    // and there\(aqs no shortage of addresses, so no need to recycle aggressively.
    \(dqvalid\-lifetime\(dq: 43200, // leases will be valid for 12h
    \(dqrenew\-timer\(dq: 21600, // clients should renew every 6h
    \(dqrebind\-timer\(dq: 32400, // clients should start looking for other servers after 9h

    // Kea will clean up its database of expired leases once per hour. However, it
    // will keep the leases in expired state for 2 days. This greatly increases the
    // chances for returning devices to get the same address again. To guarantee that,
    // use host reservation.
    // If both \(dqflush\-reclaimed\-timer\-wait\-time\(dq and \(dqhold\-reclaimed\-time\(dq are
    // not 0, when the client sends a release message the lease is expired
    // instead of being deleted from lease storage.
    \(dqexpired\-leases\-processing\(dq: {
        \(dqreclaim\-timer\-wait\-time\(dq: 3600,
        \(dqhold\-reclaimed\-time\(dq: 172800,
        \(dqmax\-reclaim\-leases\(dq: 0,
        \(dqmax\-reclaim\-time\(dq: 0
    },

    // HA requires two hook libraries to be loaded: libdhcp_lease_cmds.so and
    // libdhcp_ha.so. The former handles incoming lease updates from the HA peers.
    // The latter implements high availability feature for Kea. Note the library name
    // should be the same, but the path is OS specific.
    \(dqhooks\-libraries\(dq: [
        // The lease_cmds library must be loaded because HA makes use of it to
        // deliver lease updates to the server as well as synchronize the
        // lease database after failure.
        {
            \(dqlibrary\(dq: \(dqlibdhcp_lease_cmds.so\(dq
        },

        {
            // The HA hook library should be loaded.
            \(dqlibrary\(dq: \(dqlibdhcp_ha.so\(dq,
            \(dqparameters\(dq: {
                // Each server should have the same HA configuration, except for the
                // \(dqthis\-server\-name\(dq parameter.
                \(dqhigh\-availability\(dq: [ {
                    // This parameter points to this server instance. The respective
                    // HA peers must have this parameter set to their own names.
                    \(dqthis\-server\-name\(dq: \(dqserver1\(dq,
                    // The HA mode is set to hot\-standby. In this mode, the active server handles
                    // all the traffic. The standby takes over if the primary becomes unavailable.
                    \(dqmode\(dq: \(dqhot\-standby\(dq,
                    // Heartbeat is to be sent every 10 seconds if no other control
                    // commands are transmitted.
                    \(dqheartbeat\-delay\(dq: 10000,
                    // Maximum time for partner\(aqs response to a heartbeat, after which
                    // failure detection is started. This is specified in milliseconds.
                    // If we don\(aqt hear from the partner in 60 seconds, it\(aqs time to
                    // start worrying.
                    \(dqmax\-response\-delay\(dq: 60000,
                    // The following parameters control how the server detects the
                    // partner\(aqs failure. The ACK delay sets the threshold for the
                    // \(aqsecs\(aq field of the received discovers. This is specified in
                    // milliseconds.
                    \(dqmax\-ack\-delay\(dq: 5000,
                    // This specifies the number of clients which send messages to
                    // the partner but appear to not receive any response.
                    \(dqmax\-unacked\-clients\(dq: 5,
                    // This specifies the maximum timeout (in milliseconds) for the server
                    // to complete sync. If you have a large deployment (high tens or
                    // hundreds of thousands of clients), you may need to increase it
                    // further. The default value is 60000ms (60 seconds).
                    \(dqsync\-timeout\(dq: 60000,
                    // Multi\-threading parameters.
                    // To not experience performance degradation when the Kea server is
                    // processing packets on multiple threads, the High Availability module
                    // must have multi\-threading enabled.
                    \(dqmulti\-threading\(dq: {
                        // Enable High Availability to benefit from multi\-threading. Default: true.
                        \(dqenable\-multi\-threading\(dq: true,
                        // When running in MT mode, the dedicated listener is used to handle
                        // lease updates.
                        \(dqhttp\-dedicated\-listener\(dq: true,
                        // The number of threads used to handle incoming requests.
                        // A value of 0 instructs the server to use the same number of
                        // threads that the Kea core is using for DHCP multi\-threading.
                        \(dqhttp\-listener\-threads\(dq: 0,
                        // The number of threads used to handle outgoing requests.
                        // A value of 0 instructs the server to use the same number of
                        // threads that the Kea core is using for DHCP multi\-threading.
                        \(dqhttp\-client\-threads\(dq: 0
                    },
                    \(dqpeers\(dq: [
                        // This is the configuration of this server instance.
                        {
                            \(dqname\(dq: \(dqserver1\(dq,
                            // This specifies the URL of this server dedicated HTTP listener.
                            // The \(dqcontrol\-socket\(dq is not needed for the High Availability
                            // with multi\-threading, but if it is used, it must use
                            // different values for \(dqsocket\-address\(dq and \(dqsocket\-port\(dq.
                            \(dqurl\(dq: \(dqhttp://192.168.1.2:8005/\(dq,
                            // Trust anchor aka certificate authority file or directory.
                            \(dqtrust\-anchor\(dq: \(dq/usr/lib/kea/CA.pem\(dq,
                            // Client certificate file name.
                            \(dqcert\-file\(dq: \(dq/usr/lib/kea/server1_cert.pem\(dq,
                            // Private key file name.
                            \(dqkey\-file\(dq: \(dq/usr/lib/kea/server1_key.pem\(dq,
                            // Client certificates are required and verified.
                            \(dqrequire\-client\-certs\(dq: true,
                            // This server is primary. The other one must be
                            // secondary.
                            \(dqrole\(dq: \(dqprimary\(dq
                        },
                        // This is the configuration of the secondary server.
                        {
                            \(dqname\(dq: \(dqserver2\(dq,
                            // This specifies the URL of the other server\(aqs dedicated HTTP listener.
                            // The \(dqcontrol\-socket\(dq is not needed for the High Availability
                            // with multi\-threading, but if it is used, it must use
                            // different values for \(dqsocket\-address\(dq and \(dqsocket\-port\(dq.
                            \(dqurl\(dq: \(dqhttp://192.168.1.3:8005/\(dq,
                            // Trust anchor aka certificate authority file or directory.
                            \(dqtrust\-anchor\(dq: \(dq/usr/lib/kea/CA.pem\(dq,
                            // Client certificate file name.
                            \(dqcert\-file\(dq: \(dq/usr/lib/kea/server2_cert.pem\(dq,
                            // Private key file name.
                            \(dqkey\-file\(dq: \(dq/usr/lib/kea/server2_key.pem\(dq,
                            // Client certificates are required and verified.
                            \(dqrequire\-client\-certs\(dq: true,
                            // The other server is secondary. This one must be
                            // primary.
                            \(dqrole\(dq: \(dqstandby\(dq
                        }
                    ]
                } ]
            }
        }
    ],

    // This example contains a single subnet declaration.
    \(dqsubnet4\(dq: [
        {
            // Subnet prefix.
            \(dqsubnet\(dq: \(dq192.168.1.0/24\(dq,

            // There are no relays in this network, so we need to tell Kea that this subnet
            // is reachable directly via the specified interface.
            \(dqinterface\(dq: \(dqenp0s8\(dq,

            // Specify a dynamic address pool.
            \(dqpools\(dq: [
                {
                    \(dqpool\(dq: \(dq192.168.1.100\-192.168.1.199\(dq
                }
            ]
        }
    ],

    // Logging configuration starts here.
    \(dqloggers\(dq: [
    {
        // This section affects kea\-dhcp4, which is the base logger for DHCPv4 component. It tells
        // DHCPv4 server to write all log messages (on severity INFO or higher) to a file. The file
        // will be rotated once it grows to 2MB and up to 4 files will be kept. The debuglevel
        // (range 0 to 99) is used only when logging on DEBUG level.
        \(dqname\(dq: \(dqkea\-dhcp4\(dq,
        \(dqoutput\-options\(dq: [
            {
                \(dqoutput\(dq: \(dq/var/log/kea/kea\-dhcp4.log\(dq,
                \(dqmaxsize\(dq: 2048000,
                \(dqmaxver\(dq: 4
            }
        ],
        \(dqseverity\(dq: \(dqINFO\(dq,
        \(dqdebuglevel\(dq: 0
    }
  ]
}
}

.EE
.UNINDENT
.UNINDENT
.sp
Server2\(aqs DHCPv4 configuration file:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
// This is an example configuration of the Kea DHCPv4 server 2:
//
// \- uses High Availability hook library and Lease Commands hook library
//   to enable High Availability function for the DHCP server. This config
//   file is for the secondary (the standby) server.
// \- uses memfile, which stores lease data in a local CSV file
// \- it assumes a single /24 addressing over a link that is directly reachable
//   (no DHCP relays)
// \- there is a handful of IP reservations
//
// It is expected to run with a primary (the active) server, which has a very similar
// configuration. The only difference is that \(dqthis\-server\-name\(dq must be set to \(dqserver2\(dq on the
// other server. Also, the interface configuration and location of TLS specific files
// depend on the network settings and configuration of the particular machine.

{

\(dqDhcp4\(dq: {

    // Add names of your network interfaces to listen on.
    \(dqinterfaces\-config\(dq: {
        // The DHCPv4 server listens on this interface. When changing this to
        // the actual name of your interface, make sure to also update the
        // interface parameter in the subnet definition below.
        \(dqinterfaces\(dq: [ \(dqenp0s8\(dq ]
    },

    // Control socket is required for communication with the
    // DHCP server. High Availability requires HTTP/HTTPS control sockets
    // to be configured because lease updates are sent over the RESTful
    // API between the HA peers.
    \(dqcontrol\-socket\(dq: {
        \(dqsocket\-type\(dq: \(dqhttps\(dq,

        // We need to specify where the server should listen to incoming HTTP
        // queries.
        \(dqsocket\-address\(dq: \(dq192.168.1.3\(dq,

        // This specifies the port server will listen on.
        // If enabling HA and multi\-threading, the 8000 port is used by the HA
        // hook library http listener. When using HA hook library with
        // multi\-threading to function, make sure the port used by dedicated
        // listener is different (e.g. 8001) than the one used by server. Note
        // the commands should still be sent to the control socket.
        // The dedicated listener is specifically for HA updates only.
        \(dqsocket\-port\(dq: 8001,

        // TLS trust anchor (Certificate Authority). This is a file name or
        // (for OpenSSL only) a directory path.
        \(dqtrust\-anchor\(dq: \(dq/usr/lib/kea/CA.pem\(dq,

        // TLS server certificate file name.
        \(dqcert\-file\(dq: \(dq/usr/lib/kea/ca2_cert.pem\(dq,

        // TLS server private key file name.
        \(dqkey\-file\(dq: \(dq/usr/lib/kea/ca2_key.pem\(dq,

        // TLS require client certificates flag.
        \(dqcert\-required\(dq: true
    },

    // Multi\-threading parameters.
    \(dqmulti\-threading\(dq: {
        // By default, Kea processes packets on multiple threads if the hardware permits.
        \(dqenable\-multi\-threading\(dq: true,

        // When multi\-threading is enabled, Kea will process packets on a
        // number of multiple threads configurable through this option. The
        // value must be a positive integer (0 means auto\-detect).
        \(dqthread\-pool\-size\(dq: 4,

        // When multi\-threading is enabled, Kea will read packets from the
        // interface and append a working item to the thread pool. This
        // option configures the maximum number of items that can be queued.
        // The value must be a positive integer (0 means unlimited).
        \(dqpacket\-queue\-size\(dq: 64
    },

    // Use Memfile lease database backend to store leases in a CSV file.
    // Depending on how Kea was compiled, it may also support SQL databases
    // (MySQL and/or PostgreSQL). Those database backends require more
    // parameters, like name, host and possibly user and password.
    // There are dedicated examples for each backend. See Section 7.2.2 \(dqLease
    // Storage\(dq for details.
    \(dqlease\-database\(dq: {
        // Memfile is the simplest and easiest backend to use. It\(aqs an in\-memory
        // database with data being written to a CSV file. It is very similar to
        // what ISC DHCP does.
        \(dqtype\(dq: \(dqmemfile\(dq
    },

    // Let\(aqs configure some global parameters. The home network is not very dynamic
    // and there\(aqs no shortage of addresses, so no need to recycle aggressively.
    \(dqvalid\-lifetime\(dq: 43200, // leases will be valid for 12h
    \(dqrenew\-timer\(dq: 21600, // clients should renew every 6h
    \(dqrebind\-timer\(dq: 32400, // clients should start looking for other servers after 9h

    // Kea will clean up its database of expired leases once per hour. However, it
    // will keep the leases in expired state for 2 days. This greatly increases the
    // chances for returning devices to get the same address again. To guarantee that,
    // use host reservation.
    // If both \(dqflush\-reclaimed\-timer\-wait\-time\(dq and \(dqhold\-reclaimed\-time\(dq are
    // not 0, when the client sends a release message the lease is expired
    // instead of being deleted from lease storage.
    \(dqexpired\-leases\-processing\(dq: {
        \(dqreclaim\-timer\-wait\-time\(dq: 3600,
        \(dqhold\-reclaimed\-time\(dq: 172800,
        \(dqmax\-reclaim\-leases\(dq: 0,
        \(dqmax\-reclaim\-time\(dq: 0
    },

    // HA requires two hook libraries to be loaded: libdhcp_lease_cmds.so and
    // libdhcp_ha.so. The former handles incoming lease updates from the HA peers.
    // The latter implements high availability feature for Kea. Note the library name
    // should be the same, but the path is OS specific.
    \(dqhooks\-libraries\(dq: [
        // The lease_cmds library must be loaded because HA makes use of it to
        // deliver lease updates to the server as well as synchronize the
        // lease database after failure.
        {
            \(dqlibrary\(dq: \(dqlibdhcp_lease_cmds.so\(dq
        },

        {
            // The HA hook library should be loaded.
            \(dqlibrary\(dq: \(dqlibdhcp_ha.so\(dq,
            \(dqparameters\(dq: {
                // Each server should have the same HA configuration, except for the
                // \(dqthis\-server\-name\(dq parameter.
                \(dqhigh\-availability\(dq: [ {
                    // This parameter points to this server instance. The respective
                    // HA peers must have this parameter set to their own names.
                    \(dqthis\-server\-name\(dq: \(dqserver2\(dq,
                    // The HA mode is set to hot\-standby. In this mode, the active server handles
                    // all the traffic. The standby takes over if the primary becomes unavailable.
                    \(dqmode\(dq: \(dqhot\-standby\(dq,
                    // Heartbeat is to be sent every 10 seconds if no other control
                    // commands are transmitted.
                    \(dqheartbeat\-delay\(dq: 10000,
                    // Maximum time for partner\(aqs response to a heartbeat, after which
                    // failure detection is started. This is specified in milliseconds.
                    // If we don\(aqt hear from the partner in 60 seconds, it\(aqs time to
                    // start worrying.
                    \(dqmax\-response\-delay\(dq: 60000,
                    // The following parameters control how the server detects the
                    // partner\(aqs failure. The ACK delay sets the threshold for the
                    // \(aqsecs\(aq field of the received discovers. This is specified in
                    // milliseconds.
                    \(dqmax\-ack\-delay\(dq: 5000,
                    // This specifies the number of clients which send messages to
                    // the partner but appear to not receive any response.
                    \(dqmax\-unacked\-clients\(dq: 5,
                    // This specifies the maximum timeout (in milliseconds) for the server
                    // to complete sync. If you have a large deployment (high tens or
                    // hundreds of thousands of clients), you may need to increase it
                    // further. The default value is 60000ms (60 seconds).
                    \(dqsync\-timeout\(dq: 60000,
                    // Multi\-threading parameters.
                    // To not experience performance degradation when the Kea server is
                    // processing packets on multiple threads, the High Availability module
                    // must have multi\-threading enabled.
                    \(dqmulti\-threading\(dq: {
                        // Enable High Availability to benefit from multi\-threading. Default: true.
                        \(dqenable\-multi\-threading\(dq: true,
                        // When running in MT mode, the dedicated listener is used to handle
                        // lease updates.
                        \(dqhttp\-dedicated\-listener\(dq: true,
                        // The number of threads used to handle incoming requests.
                        // A value of 0 instructs the server to use the same number of
                        // threads that the Kea core is using for DHCP multi\-threading.
                        \(dqhttp\-listener\-threads\(dq: 0,
                        // The number of threads used to handle outgoing requests.
                        // A value of 0 instructs the server to use the same number of
                        // threads that the Kea core is using for DHCP multi\-threading.
                        \(dqhttp\-client\-threads\(dq: 0
                    },
                    \(dqpeers\(dq: [
                        // This is the configuration of the primary server.
                        {
                            \(dqname\(dq: \(dqserver1\(dq,
                            // This specifies the URL of the other server\(aqs dedicated HTTP listener.
                            // The \(dqcontrol\-socket\(dq is not needed for the High Availability
                            // with multi\-threading, but if it is used, it must use
                            // different values for \(dqsocket\-address\(dq and \(dqsocket\-port\(dq.
                            \(dqurl\(dq: \(dqhttp://192.168.1.2:8005/\(dq,
                            // Trust anchor aka certificate authority file or directory.
                            \(dqtrust\-anchor\(dq: \(dq/usr/lib/kea/CA.pem\(dq,
                            // Client certificate file name.
                            \(dqcert\-file\(dq: \(dq/usr/lib/kea/server1_cert.pem\(dq,
                            // Private key file name.
                            \(dqkey\-file\(dq: \(dq/usr/lib/kea/server1_key.pem\(dq,
                            // Client certificates are required and verified.
                            \(dqrequire\-client\-certs\(dq: true,
                            // The other server is primary. This one must be
                            // secondary.
                            \(dqrole\(dq: \(dqprimary\(dq
                        },
                        // This is the configuration of this server instance.
                        {
                            \(dqname\(dq: \(dqserver2\(dq,
                            // This specifies the URL of this server dedicated HTTP listener.
                            // The \(dqcontrol\-socket\(dq is not needed for the High Availability
                            // with multi\-threading, but if it is used, it must use
                            // different values for \(dqsocket\-address\(dq and \(dqsocket\-port\(dq.
                            \(dqurl\(dq: \(dqhttp://192.168.1.3:8005/\(dq,
                            // Trust anchor aka certificate authority file or directory.
                            \(dqtrust\-anchor\(dq: \(dq/usr/lib/kea/CA.pem\(dq,
                            // Client certificate file name.
                            \(dqcert\-file\(dq: \(dq/usr/lib/kea/server2_cert.pem\(dq,
                            // Private key file name.
                            \(dqkey\-file\(dq: \(dq/usr/lib/kea/server2_key.pem\(dq,
                            // Client certificates are required and verified.
                            \(dqrequire\-client\-certs\(dq: true,
                            // This server is secondary. The other one must be
                            // primary.
                            \(dqrole\(dq: \(dqstandby\(dq
                        }
                    ]
                } ]
            }
        }
    ],

    // This example contains a single subnet declaration.
    \(dqsubnet4\(dq: [
        {
            // Subnet prefix.
            \(dqsubnet\(dq: \(dq192.168.1.0/24\(dq,

            // There are no relays in this network, so we need to tell Kea that this subnet
            // is reachable directly via the specified interface.
            \(dqinterface\(dq: \(dqenp0s8\(dq,

            // Specify a dynamic address pool.
            \(dqpools\(dq: [
                {
                    \(dqpool\(dq: \(dq192.168.1.100\-192.168.1.199\(dq
                }
            ]
        }
    ],

    // Logging configuration starts here.
    \(dqloggers\(dq: [
    {
        // This section affects kea\-dhcp4, which is the base logger for DHCPv4 component. It tells
        // DHCPv4 server to write all log messages (on severity INFO or higher) to a file. The file
        // will be rotated once it grows to 2MB and up to 4 files will be kept. The debuglevel
        // (range 0 to 99) is used only when logging on DEBUG level.
        \(dqname\(dq: \(dqkea\-dhcp4\(dq,
        \(dqoutput\-options\(dq: [
            {
                \(dqoutput\(dq: \(dq/var/log/kea/kea\-dhcp4.log\(dq,
                \(dqmaxsize\(dq: 2048000,
                \(dqmaxver\(dq: 4
            }
        ],
        \(dqseverity\(dq: \(dqINFO\(dq,
        \(dqdebuglevel\(dq: 0
    }
  ]
}
}

.EE
.UNINDENT
.UNINDENT
.SH KEA FLOW DIAGRAMS
.sp
These flow diagrams describe Kea\(aqs DHCPv4 server implementation, and they may be useful for system administrators. To design a configuration that results in clients getting the intended addresses and options, it is important to understand the sequence of request\-processing steps. For example, Kea iterates looking for a suitable address, and conditionally accepts the first available address, so the order in which addresses are evaluated matters.
.sp
It is also useful to understand Kea\(aqs processing logic because there are configuration choices which can make the process far more efficient. Kea is very flexible, so it can be applied to very different use cases and in different environments. In an environment where throughput and efficiency are a priority, the administrator can choose to limit some of the processing steps. For example, it is possible to limit the number of different client identifiers Kea evaluates in looking for a host reservation, or even to skip the step of checking for host reservations.
.sp
These diagrams are focused on those aspects of Kea processing that will be most useful to operators. The diagrams illustrate DHCPv4 request processing, but most of the logic applies equally to DHCPv6. Following the title of each diagram is a Kea version number. Kea behavior has evolved over time, and the diagrams document the behavior as of the Kea version indicated. These diagrams are provided in the Kea source tree in UML (source), PNG, and SVG formats.
.SS Main Loop
.sp
The main loop is common to both DHCPv4 and DHCPv6 servers.
.INDENT 0.0
.INDENT 2.5
[image]
The DHCP server main loop.UNINDENT
.UNINDENT
.SS DHCPv4 Packet Processing
.sp
DHCPv4 packet processing evaluates the type DHCP message: Discover, Request, Release, Decline, or Inform. This diagram shows the general, high\-level flow for processing an inbound client DHCP packet from receipt to the server\(aqs response.
.INDENT 0.0
.INDENT 2.5
[image]
DHCPv4 packet processing.UNINDENT
.UNINDENT
.SS DHCPREQUEST Processing
.sp
The following diagrams focus on DHCPREQUEST processing. This chart gives an overview of the process, from subnet selection to checking for host reservations to evaluating client classes. Finally, before acknowledging the lease, the options are evaluated and added to the message.
.INDENT 0.0
.INDENT 2.5
[image]
DHCPREQUEST processing.UNINDENT
.UNINDENT
.SS DHCPv4 Subnet Selection
.sp
Subnet selection is the process of choosing a subnet that is topologically appropriate for the client. When the selected subnet is a member of a shared network, the whole shared network is selected. During subnet selection the client class may be checked more than once while iterating through subnets, to determine whether it is permitted in the selected subnet.
.INDENT 0.0
.INDENT 2.5
[image]
DHCPv4 subnet selection.UNINDENT
.UNINDENT
.SS DHCPv4 Special Case of Double\-Booting
.sp
After subnet selection and before lease allocation, the DHCPv4 server handles the special case of clients restarting with an image provided by PXE boot or bootp. The Lease Request box is expanded below.
.INDENT 0.0
.INDENT 2.5
[image]
DHCPv4 lease assignment.UNINDENT
.UNINDENT
.SS DHCPv4 Lease Allocation
.sp
The first diagram below illustrates the details of processing the client request, showing the renewal of an existing lease, the assignment of a reserved lease, and the allocation of an unreserved lease.
.INDENT 0.0
.INDENT 2.5
[image]
DHCPREQUEST lease allocation.UNINDENT
.UNINDENT
.sp
The second diagram shows the algorithm used to validate a requested lease or select a new address to offer. The right\-hand side of the diagram shows how a new address is selected, when a new lease is required and the client has neither a requested address nor a reservation. When a new lease is required and Kea iterates over pools and subnets, it starts with the subnet selected above in the subnet selection process.
.INDENT 0.0
.INDENT 2.5
[image]
The requestLease4 algorithm.UNINDENT
.UNINDENT
.sp
\fBNote:\fP
.INDENT 0.0
.INDENT 3.5
Declined addresses are included in the statistic for assigned addresses,
so the assigned + free = total equation is true.
.UNINDENT
.UNINDENT
.SS Lease States
.sp
This diagram illustrates the different lease states, including the \fBfree\fP one, where no lease object exists.
.INDENT 0.0
.INDENT 2.5
[image]
Lease states.UNINDENT
.UNINDENT
.SS Checking for Host Reservations
.sp
The allocation engine checks for host reservations after selecting a subnet. The following diagram shows the details of that operation. Subnet selection is based on network topology. Host reservations are primarily for assigning options, and options are evaluated after subnet selection. However, if client classes are added in the host reservation, those are also evaluated against the selected subnet in a further check. Kea includes several options to skip checking for host reservations, which can make this process much more efficient if reservations are not being used.
.sp
\fBNote:\fP
.INDENT 0.0
.INDENT 3.5
To find a free lease, the allocation engine begins by evaluating the most recently used subnet.
The current subnet depends on the history of prior queries.
.UNINDENT
.UNINDENT
.INDENT 0.0
.INDENT 2.5
[image]
Host reservation evaluation.UNINDENT
.UNINDENT
.SS Building the Options List
.INDENT 0.0
.TP
.B Before sending a response, options are added:
.INDENT 7.0
.IP \(bu 2
evaluate required client classes
.IP \(bu 2
build the configured option list
.IP \(bu 2
append requested options
.IP \(bu 2
append requested vendor options
.IP \(bu 2
append basic options
.UNINDENT
.UNINDENT
.INDENT 0.0
.INDENT 2.5
[image]
The buildCfgOptionList (build configured option list) algorithm.UNINDENT
.UNINDENT
.INDENT 0.0
.INDENT 2.5
[image]
The appendRequestedOptions (append requested options) algorithm.UNINDENT
.UNINDENT
.INDENT 0.0
.INDENT 2.5
[image]
The appendRequestedVendorOptions (append vendor requested options) algorithm.UNINDENT
.UNINDENT
.SS How Kea Recognizes the Same Client In Different DHCP Messages
.INDENT 0.0
.INDENT 2.5
[image]
.UNINDENT
.UNINDENT
.SS RADIUS workflows for lease allocation
.INDENT 0.0
.INDENT 2.5
[image]
.UNINDENT
.UNINDENT
.SH KEA CONFIGURATION FILE SYNTAX (BNF)
.sp
Kea consists of several daemons, each with its own configuration syntax. The following sections
provide a complete syntax of all possible parameters, written in Backus\-Naur Form (BNF).
See this Wikipedia article on BNF \%<https://\:en\:.wikipedia\:.org/\:wiki/\:Backus%E2%80%93Naur_form> for
more information.
.SS BNF Grammar for DHCPv4
.sp
This grammar is generated from \fBdhcp4_parser.yy\fP\&. See The DHCPv4 Server \%<#\:dhcp4> for more details.
.INDENT 0.0
.INDENT 3.5
.sp
.EX
  Grammar

  $accept ::= start EOF

  start ::= TOPLEVEL_JSON sub_json

  start ::= TOPLEVEL_DHCP4 syntax_map

  start ::= SUB_DHCP4 sub_dhcp4

  start ::= SUB_INTERFACES4 sub_interfaces4

  start ::= SUB_SUBNET4 sub_subnet4

  start ::= SUB_POOL4 sub_pool4

  start ::= SUB_RESERVATION sub_reservation

  start ::= SUB_OPTION_DEFS sub_option_def_list

  start ::= SUB_OPTION_DEF sub_option_def

  start ::= SUB_OPTION_DATA sub_option_data

  start ::= SUB_HOOKS_LIBRARY sub_hooks_library

  start ::= SUB_DHCP_DDNS sub_dhcp_ddns

  start ::= SUB_CONFIG_CONTROL sub_config_control

  value ::= INTEGER
       | FLOAT
       | BOOLEAN
       | STRING
       | NULL
       | map2
       | list_generic

  sub_json ::= value

  map2 ::= \(dq{\(dq map_content \(dq}\(dq

  map_value ::= map2

  map_content ::=
             | not_empty_map

  not_empty_map ::= STRING \(dq:\(dq value
               | not_empty_map \(dq,\(dq STRING \(dq:\(dq value
               | not_empty_map \(dq,\(dq

  list_generic ::= \(dq[\(dq list_content \(dq]\(dq

  list_content ::=
              | not_empty_list

  not_empty_list ::= value
                | not_empty_list \(dq,\(dq value
                | not_empty_list \(dq,\(dq

  list_strings ::= \(dq[\(dq list_strings_content \(dq]\(dq

  list_strings_content ::=
                      | not_empty_list_strings

  not_empty_list_strings ::= STRING
                        | not_empty_list_strings \(dq,\(dq STRING
                        | not_empty_list_strings \(dq,\(dq

  unknown_map_entry ::= STRING \(dq:\(dq

  syntax_map ::= \(dq{\(dq global_object \(dq}\(dq

  global_object ::= \(dqDhcp4\(dq \(dq:\(dq \(dq{\(dq global_params \(dq}\(dq
               | global_object_comma

  global_object_comma ::= global_object \(dq,\(dq

  sub_dhcp4 ::= \(dq{\(dq global_params \(dq}\(dq

  global_params ::= global_param
               | global_params \(dq,\(dq global_param
               | global_params \(dq,\(dq

  global_param ::= valid_lifetime
              | min_valid_lifetime
              | max_valid_lifetime
              | renew_timer
              | rebind_timer
              | decline_probation_period
              | subnet4_list
              | shared_networks
              | interfaces_config
              | lease_database
              | hosts_database
              | hosts_databases
              | host_reservation_identifiers
              | client_classes
              | option_def_list
              | option_data_list
              | hooks_libraries
              | expired_leases_processing
              | dhcp4o6_port
              | control_socket
              | control_sockets
              | dhcp_queue_control
              | dhcp_ddns
              | echo_client_id
              | match_client_id
              | authoritative
              | next_server
              | server_hostname
              | boot_file_name
              | user_context
              | comment
              | sanity_checks
              | reservations
              | config_control
              | server_tag
              | reservations_global
              | reservations_in_subnet
              | reservations_out_of_pool
              | calculate_tee_times
              | t1_percent
              | t2_percent
              | cache_threshold
              | cache_max_age
              | adaptive_lease_time_threshold
              | loggers
              | hostname_char_set
              | hostname_char_replacement
              | ddns_send_updates
              | ddns_override_no_update
              | ddns_override_client_update
              | ddns_replace_client_name
              | ddns_generated_prefix
              | ddns_qualifying_suffix
              | ddns_update_on_renew
              | ddns_use_conflict_resolution
              | ddns_conflict_resolution_mode
              | ddns_ttl_percent
              | ddns_ttl
              | ddns_ttl_min
              | ddns_ttl_max
              | store_extended_info
              | statistic_default_sample_count
              | statistic_default_sample_age
              | dhcp_multi_threading
              | early_global_reservations_lookup
              | ip_reservations_unique
              | reservations_lookup_first
              | compatibility
              | parked_packet_limit
              | allocator
              | offer_lifetime
              | stash_agent_options
              | unknown_map_entry

  valid_lifetime ::= \(dqvalid\-lifetime\(dq \(dq:\(dq INTEGER

  min_valid_lifetime ::= \(dqmin\-valid\-lifetime\(dq \(dq:\(dq INTEGER

  max_valid_lifetime ::= \(dqmax\-valid\-lifetime\(dq \(dq:\(dq INTEGER

