T}@T{
x86\-64
T}@T{
aarch64
T}
_
T{
\f[B]debian\f[R]
T}@T{
https://snapshot.debian.org
T}@T{
T}
T{
\f[B]arch\f[R]
T}@T{
https://archive.archlinux.org
T}@T{
http://mirror.archlinuxarm.org
T}
T{
\f[B]opensuse\f[R]
T}@T{
http://download.opensuse.org
T}@T{
