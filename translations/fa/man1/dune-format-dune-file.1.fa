.\" Pipe this output to groff -m man -K utf8 -T utf8 | less -R
.\"
.mso an.tmac
.TH "DUNE-FORMAT-DUNE-FILE" 1 "" "Dune 3.24.2" "Dune Manual"
.\" Disable hyphenation and ragged-right
.nh
.ad l
.SH "نام (NAME)"
.P
dune\N'45'format\N'45'dune\N'45'file \N'45' قالب‌بندی فایل‌های dune
.SH "خلاصه دستور (SYNOPSIS)"
.P
\fBdune format\N'45'dune\N'45'file\fR [\fIگزینه\fR]… [\fIفایل\fR]
.SH "توضیحات (DESCRIPTION)"
.P
دستور \fBdune format\N'45'dune\N'45'file\fR یک فایل dune را می‌خواند و نسخه قالب‌بندی‌شده آن را در خروجی نمایش می‌دهد\N'46' این یک دستور سطح پایین است که برای نمونه جهت پیاده‌سازی پشتیبانی در ویرایشگرهای متن کاربرد دارد\N'46' برای قالب‌بندی مجدد کل یک پروژه dune، بخش «Automatic formatting» را در راهنما ببینید\N'46'
.SH "آرگومان‌ها (ARGUMENTS)"
.TP 4
\fIفایل\fR
مسیر فایل dune برای تجزیه و تحلیل\N'46'
.SH "گزینه‌ها (OPTIONS)"
.TP 4
\fB\N'45'\N'45'action\N'45'stderr\N'45'on\N'45'success\fR=\fIVAL\fR
مانند \fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success\fR اما به جای خروجی استاندارد، برای خطای استاندارد اعمال می‌شود\N'46' یک مقدار پیش‌فرض مناسب برای مخازن بزرگ (mono-repositories) گزینه \fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success=swallow \N'45'\N'45'action\N'45'stderr\N'45'on\N'45'success=must\N'45'be\N'45'empty\fR است\N'46' این کار تضمین می‌کند که یک ساخت موفق، خروجی خالی و «تمیز» داشته باشد\N'46'
.TP 4
\fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success\fR=\fIVAL\fR
نحوه مدیریت خروجی استاندارد کنش‌ها در صورت موفقیت آن‌ها را مشخص می‌کند\N'46' مقادیر ممکن عبارتند از: \fBprint\fR برای چاپ مستقیم آن در خروجی Dune، \fBswallow\fR برای نادیده گرفتن کامل آن و \fBmust\N'45'be\N'45'empty\fR برای الزام به اینکه کنش هیچ چیزی چاپ نکرده باشد\N'46' با تنظیم \fBmust\N'45'be\N'45'empty\fR، اگر کنش چیزی در خروجی استاندارد خود چاپ کند، Dune آن را ناموفق تلقی خواهد کرد\N'46' مقدار پیش‌فرض \fBprint\fR است\N'46'
.TP 4
\fB\N'45'\N'45'build\N'45'info\fR
نمایش اطلاعات ساخت\N'46'
.TP 4
\fB\N'45'\N'45'display\N'45'separate\N'45'messages\fR
جداسازی پیام‌های خطا با یک خط خالی\N'46'
.TP 4
\fB\N'45'\N'45'dune\N'45'version\fR=\fIVERSION\fR
نسخه زبان Dune که باید استفاده شود\N'46'
.TP 4
\fB\N'45'\N'45'error\N'45'reporting\fR=\fIVAL\fR (absent=\fBdeterministic\fR)
زمان گزارش خطاهای ساخت را کنترل می‌کند\N'46' مقدار \fBearly\fR خطاها را به محض کشف شدن گزارش می‌کند\N'46' مقدار \fBdeterministic\fR خطاها را در پایان فرآیند ساخت و با ترتیبی مشخص و معین گزارش می‌کند\N'46' مقدار \fBtwice\fR هر خطا را دو بار گزارش می‌دهد: یک بار به محض کشف خطا و سپس مجدداً در پایان ساخت با ترتیبی معین\N'46'
.TP 4
\fB\N'45'f\fR, \fB\N'45'\N'45'force\fR
اجرای مجدد اجباری کنش‌های مرتبط با نام‌های مستعار (alias) حتی در صورتی که وابستگی‌های آن‌ها تغییر نکرده باشد\N'46'
.TP 4
\fB\N'45'\N'45'file\N'45'watcher\fR=\fIVAL\fR (absent=\fBautomatic\fR)
سازوکار تشخیص تغییرات در کد مبدا\N'46' مقدار Automatic باعث می‌شود dune برای تشخیص تغییرات یک برنامه خارجی را اجرا کند\N'46' مقدار Manual به dune اطلاع می‌دهد که تغییر فایل‌ها به صورت دستی اعلام می‌شود\N'46'
.TP 4
\fB\N'45'\N'45'passive\N'45'watch\N'45'mode\fR
مشابه [\N'45'\N'45'watch]، اما فرآیند ساخت فقط زمانی آغاز می‌شود که از بیرون از طریق یک RPC دستور داده شود\N'46'
.TP 4
\fB\N'45'\N'45'sandbox\fR=\fIVAL\fR (absent \fBDUNE_SANDBOX\fR env)
تنظیم حالت سندباکس (محیط ایزوله)\N'46' برخی کنش‌ها نیازمند حالت سندباکس خاصی هستند، بنابراین این تنظیم را نادیده می‌گیرند\N'46' مقادیر مجاز عبارتند از: none، symlink، copy، hardlink\N'46'
.TP 4
\fB\N'45'\N'45'stop\N'45'on\N'45'first\N'45'error\fR
توقف فرآیند ساخت به محض مواجهه با نخستین خطا\N'46'
.TP 4
\fB\N'45'w\fR, \fB\N'45'\N'45'watch\fR
به جای پایان دادن به فرآیند ساخت پس از اتمام، به طور مداوم در انتظار تغییرات فایل‌ها می‌ماند\N'46'
.TP 4
\fB\N'45'\N'45'wait\N'45'for\N'45'filesystem\N'45'clock\fR
ابزار Dune محتوای فایل‌ها را برای بهبود فرآیند افزایشی خلاصه (digest) می‌کند\N'46' این خلاصه‌ها خودشان کش می‌شوند\N'46' در برخی موارد، Dune برای قابل اطمینان بودن عملیات، نیاز به حذف برخی از ورودی‌های کش خلاصه دارد\N'46' این گزینه باعث می‌شود Dune منتظر پیش رفتن ساعت سیستم‌فایل بماند تا نیازی به حذف هیچ موردی نداشته باشد\N'46' احتمالاً نیازی به این گزینه نخواهید داشت؛ این گزینه بیشتر برای توسعه‌دهندگان Dune جهت بازتولیدپذیری بیشتر آزمایش‌های کش خلاصه مفید است\N'46'
.SH "گزینه‌های عمومی (COMMON OPTIONS)"
.TP 4
\fB\N'45'\N'45'always\N'45'show\N'45'command\N'45'line\fR
همیشه خط فرمان کامل برنامه‌های اجراشده توسط dune را نمایش می‌دهد\N'46'
.TP 4
\fB\N'45'\N'45'auto\N'45'promote\fR
ترفیع خودکار فایل‌ها\N'46' این گزینه مشابه اجرای \fBdune promote\fR پس از ساخت است\N'46'
.TP 4
\fB\N'45'\N'45'build\N'45'dir\fR=\fIFILE\fR (absent \fBDUNE_BUILD_DIR\fR env)
دایرکتوری مشخص‌شده برای ساخت\N'46' در صورت عدم تعیین، مقدار پیش‌فرض _build است
.TP 4
\fB\N'45'\N'45'cache\fR=\fIVAL\fR (absent \fBDUNE_CACHE\fR env)
فعال یا غیرفعال کردن کش Dune (یکی از مقادیر \fBdisabled\fR، \fBenabled\N'45'except\N'45'user\N'45'rules\fR یا \fBenabled\fR)\N'46' پیش‌فرض `enabled\N'45'except\N'45'user\N'45'rules\N'39' است\N'46'
.TP 4
\fB\N'45'\N'45'cache\N'45'check\N'45'probability\fR=\fIVAL\fR (absent \fBDUNE_CACHE_CHECK_PROBABILITY\fR env)
بررسی بازتولیدپذیری ساخت با اجرای مجدد قواعدی که به صورت تصادفی انتخاب شده‌اند و مقایسه نتایج آن‌ها با نتایج ذخیره‌شده در کش Dune\N'46' توجه: با افزایش احتمال چنین بررسی‌هایی، سرعت ساخت کاهش می‌یابد\N'46' احتمال پیش‌فرض صفر است، یعنی هیچ قاعده‌ای بررسی نمی‌شود\N'46'
.TP 4
\fB\N'45'\N'45'cache\N'45'storage\N'45'mode\fR=\fIVAL\fR (absent \fBDUNE_CACHE_STORAGE_MODE\fR env)
حالت ذخیره‌سازی کش Dune (یکی از مقادیر \fBauto\fR، \fBhardlink\fR یا \fBcopy\fR)\N'46' پیش‌فرض `hardlink\N'39' است\N'46'
.TP 4
\fB\N'45'\N'45'config\N'45'file\fR=\fIFILE\fR
بارگذاری این فایل پیکربندی به جای فایل پیش‌فرض\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'backtraces\fR
همیشه ردیابی پشته (backtrace) استثناها را چاپ می‌کند\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'dependency\N'45'path\fR
در صورت بروز خطا، مسیر وابستگی را از اهداف مشخص‌شده در خط فرمان تا قاعده‌ای که شکست خورده چاپ می‌کند\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'package\N'45'logs\fR (absent \fBDUNE_DEBUG_PACKAGE_LOGS\fR env)
همیشه لاگ‌های استاندارد را هنگام ساخت بسته‌ها چاپ می‌کند
.TP 4
\fB\N'45'\N'45'default\N'45'target\fR=\fITARGET\fR (absent=\fB@@default\fR)
تعیین هدف پیش‌فرضی که در صورت مشخص نشدن هیچ هدفی برای \fBdune build\fR استفاده می‌شود\N'46'
.TP 4
\fB\N'45'\N'45'diff\N'45'command\fR=\fIVAL\fR (absent \fBDUNE_DIFF_COMMAND\fR env)
دستور شل مورد استفاده برای مقایسه (diff) فایل‌ها\N'46' از \N'45' برای غیرفعال کردن چاپ تفاوت‌ها استفاده کنید\N'46'
.TP 4
\fB\N'45'\N'45'disable\N'45'promotion\fR (absent \fBDUNE_DISABLE_PROMOTION\fR env)
غیرفعال کردن تمام قواعد ترفیع
.TP 4
\fB\N'45'\N'45'display\fR=\fIMODE\fR
کنترل حالت نمایش خروجی Dune\N'46' برای جزئیات بیشتر \fBdune\N'45'config(5)\fR را ببینید\N'46' مقادیر معتبر برای این گزینه عبارتند از: progress، verbose، short، quiet یا tui\N'46'
.TP 4
\fB\N'45'\N'45'dump\N'45'gc\N'45'stats\fR=\fIFILE\fR
تخلیه آمار زباله‌روب در یک فایل پس از تکمیل ساخت\N'46'
.TP 4
\fB\N'45'\N'45'help\fR[=\fIFMT\fR] (default=\fBauto\fR)
نمایش این راهنما در قالب \fIFMT\fR\N'46' مقدار \fIFMT\fR باید یکی از موارد \fBauto\fR، \fBpager\fR، \fBgroff\fR یا \fBplain\fR باشد\N'46' با مقدار \fBauto\fR، هر زمان متغیر محیطی \fBTERM\fR برابر با \fBdumb\fR یا تعریف‌نشده باشد، قالب به صورت \fBpager\fR یا \fBplain\fR خواهد بود\N'46'
.TP 4
\fB\N'45'\N'45'ignore\N'45'promoted\N'45'rules\fR
نادیده گرفتن قواعد با حالت (mode promote)، به جز مواردی با (only \N'46'\N'46'\N'46')\N'46' متغیر %{ignoring_promoted_rules} در فایل‌های dune نشان می‌دهد که این گزینه ارسال شده است یا خیر\N'46'
.TP 4
\fB\N'45'\N'45'instrument\N'45'with\fR=\fIBACKENDS\fR (absent \fBDUNE_INSTRUMENT_WITH\fR env)
فعال‌سازی ابزار دقیق توسط \fBBACKENDS\fR\N'46' مقدار \fBBACKENDS\fR فهرستی از نام‌های کتابخانه‌هاست که با کاما جدا شده‌اند و هر یک از آن‌ها باید یک backend ابزار دقیق را تعریف کرده باشد\N'46'
.TP 4
\fB\N'45'j\fR \fIJOBS\fR (absent \fBDUNE_JOBS\fR env)
اجرای همزمان حداکثر \fIJOBS\fR دستور\N'46' مقدار \fIJOBS\fR باید یک عدد صحیح مثبت باشد یا \fBauto\fR برای تشخیص خودکار تعداد هسته‌ها (حالت پیش‌فرض)\N'46'
.TP 4
\fB\N'45'\N'45'no\N'45'buffer\fR
عدم بافر کردن خروجی دستورات اجراشده توسط dune\N'46' به طور پیش‌فرض dune خروجی زیردستورات را بافر می‌کند تا از درهم‌آمیختگی خروجی هنگام اجرای موازی چند دستور جلوگیری شود\N'46' با این حال، این موضوع می‌تواند هنگام اشکال‌زدایی آزمون‌های طولانی‌مدت مشکل‌ساز باشد\N'46' با گزینه \fB\N'45'\N'45'no\N'45'buffer\fR، دستورات دسترسی مستقیم به ترمینال دارند\N'46' توجه داشته باشید که در نتیجه این کار، خروجی آن‌ها در فایل لاگ ثبت نخواهد شد\N'46' شما باید از این گزینه در ترکیب با \fB\N'45'j 1\fR استفاده کنید تا از تداخل خروجی‌ها جلوگیری شود\N'46' علاوه بر این باید از \fB\N'45'\N'45'verbose\fR نیز استفاده کنید تا مطمئن شوید دستورات پیش از اجرا چاپ می‌شوند\N'46'
.TP 4
\fB\N'45'\N'45'no\N'45'config\fR
عدم بارگذاری فایل پیکربندی
.TP 4
\fB\N'45'\N'45'no\N'45'print\N'45'directory\fR
عدم نمایش پیام‌های «Entering directory»\N'46'
.TP 4
\fB\N'45'\N'45'only\N'45'packages\fR=\fIPACKAGES\fR
نادیده گرفتن بندهای مربوط به بسته‌ای که در \fBPACKAGES\fR نیست\N'46' مقدار \fBPACKAGES\fR فهرستی از نام بسته‌هاست که با کاما جدا شده‌اند\N'46' توجه داشته باشید که این کار تأثیری مشابه حذف بندهای مربوطه از فایل‌های dune دارد\N'46' این گزینه عمدتاً برای انتشار نسخه‌ها در نظر گرفته شده است\N'46' در طول توسعه، احتمالاً آنچه می‌خواهید ساخت یک هدف خاص \fB<package>\N'46'install\fR است\N'46'
.TP 4
\fB\N'45'p\fR \fIPACKAGES\fR, \fB\N'45'\N'45'for\N'45'release\N'45'of\N'45'packages\fR=\fIPACKAGES\fR (required)
کوته‌نوشتی برای \fB\N'45'\N'45'release \N'45'\N'45'pkg=disabled \N'45'\N'45'only\N'45'packages PACKAGE\fR\N'46' شما باید از این گزینه در فایل‌های \fI<package>\N'46'opam\fR خود استفاده کنید تا در صورت وجود چندین بسته در پروژه، تنها موارد ضروری ساخته شوند و ساخت‌های بازتولیدپذیر حاصل گردد\N'46'
.TP 4
\fB\N'45'\N'45'pkg\fR=\fIVAL\fR
فعال یا غیرفعال کردن مدیریت بسته\N'46' رفتار پیش‌فرض بستگی به وجود یا عدم وجود دایرکتوری lock دارد\N'46'
.TP 4
\fB\N'45'\N'45'profile\fR=\fIVAL\fR (absent \fBDUNE_PROFILE\fR env)
انتخاب پروفایل ساخت، برای نمونه \fBdev\fR یا \fBrelease\fR\N'46' پیش‌فرض \fBdev\fR است\N'46'
.TP 4
\fB\N'45'\N'45'promote\N'45'install\N'45'files\fR[=\fIVAL\fR] (default=\fBtrue\fR)
ترفیع دادن تمام فایل‌های تولیدشده <package>\N'46'install به درخت مبدا\N'46'
.TP 4
\fB\N'45'\N'45'release\fR
قرار دادن \fBdune\fR در حالت بازتولیدپذیر \fIrelease\fR (انتشار)\N'46' کوته‌نوشتی برای \fB\N'45'\N'45'root \N'46' \N'45'\N'45'ignore\N'45'promoted\N'45'rules \N'45'\N'45'no\N'45'config \N'45'\N'45'profile release \N'45'\N'45'always\N'45'show\N'45'command\N'45'line \N'45'\N'45'promote\N'45'install\N'45'files \N'45'\N'45'require\N'45'dune\N'45'project\N'45'file \N'45'\N'45'default\N'45'target @install\fR\N'46' شما باید از این گزینه برای ساخت‌های انتشار (release) استفاده کنید\N'46' برای نمونه، باید از این گزینه در فایل‌های \fI<package>\N'46'opam\fR خود استفاده نمایید\N'46' مگر اینکه از قبل از \fB\N'45'p\fR استفاده کرده باشید، زیرا \fB\N'45'p\fR خود شامل این گزینه است\N'46'
.TP 4
\fB\N'45'\N'45'require\N'45'dune\N'45'project\N'45'file\fR[=\fIVAL\fR] (default=\fBtrue\fR)
در صورت عدم وجود فایل dune\N'45'project با شکست متوقف شود\N'46'
.TP 4
\fB\N'45'\N'45'root\fR=\fIDIR\fR (absent \fBDUNE_ROOT\fR env)
استفاده از این دایرکتوری به عنوان ریشه فضای کاری به جای حدس زدن آن\N'46' توجه داشته باشید که این گزینه تفسیر اهداف ارائه‌شده در خط فرمان را تغییر نمی‌دهد\N'46' این گزینه فقط برای اسکریپت‌ها در نظر گرفته شده است\N'46'
.TP 4
\fB\N'45'\N'45'store\N'45'orig\N'45'source\N'45'dir\fR (absent \fBDUNE_STORE_ORIG_SOURCE_DIR\fR env)
ذخیره مکان اصلی منبع در فراداده dune\N'45'package\N'46'
.TP 4
\fB\N'45'\N'45'target\N'45'exec\fR=\fITOOLCHAIN=CMD\fR (absent \fBDUNE_TARGET_EXEC\fR env)
دستور پوششی برای اجرای باینری‌های هدف هنگام کامپایل متقابل\N'46' قالب: TOOLCHAIN=CMD (مانند \N'39'windows=wine\N'39')\N'46'
.TP 4
\fB\N'45'\N'45'terminal\N'45'persistence\fR=\fIMODE\fR
تغییر نحوه نمایش لاگ نتایج ساخت در کنسول بین ساخت‌های مجدد در حالت \fB\N'45'\N'45'watch\fR\N'46' حالت‌های پشتیبانی‌شده: \fBpreserve\fR، \fBclear\N'45'on\N'45'rebuild\fR، \fBclear\N'45'on\N'45'rebuild\N'45'and\N'45'flush\N'45'history\fR\N'46'
.TP 4
\fB\N'45'\N'45'trace\N'45'file\fR=\fIFILE\fR
خروجی داده‌های ردیابی در قالب catapult (سازگار با chrome://tracing)\N'46'
.TP 4
\fB\N'45'\N'45'verbose\fR
مشابه \fB\N'45'\N'45'display verbose\fR
.TP 4
\fB\N'45'\N'45'version\fR
نمایش اطلاعات نسخه\N'46'
.TP 4
\fB\N'45'\N'45'watch\N'45'exclusions\fR=\fIREGEX\fR
افزودن یک عبارت باقاعده POSIX که دایرکتوری‌های منطبق را از \fB`dune build \N'45'\N'45'watch`\fR مستثنی می‌کند\N'46' گزینه \fB\N'45'\N'45'watch\N'45'exclusions\fR می‌تواند برای افزودن چندین مورد استثنا تکرار شود\N'46' همچنین می‌توان از نقطه ویرگول به عنوان جداکننده استفاده کرد\N'46' اگر هیچ استثنایی ارائه نشود، مجموعه‌ای استاندارد از استثناها استفاده می‌شود؛ با این حال، اگر \fIیک یا چند\fR گزینه \fB\N'45'\N'45'watch\N'45'exclusions\fR استفاده شود، \fBهیچ‌یک\fR از استثناهای استاندارد اعمال نخواهند شد\N'46' استثناهای استاندارد عبارتند از: ^_opam /_opam ^_esy /_esy ^\N'92'\N'46'#\N'46'* /\N'92'\N'46'#\N'46'* ~$ ^#[^#]*#$ /#[^#]*#$ ^4913$ /4913$ /\N'46'git /\N'46'hg :/windows
.TP 4
\fB\N'45'\N'45'workspace\fR=\fIFILE\fR (absent \fBDUNE_WORKSPACE\fR env)
استفاده از این فایل فضای کاری مشخص به جای جستجوی آن\N'46'
.TP 4
\fB\N'45'x\fR \fIVAL\fR (absent \fBDUNE_CROSS_TARGET\fR env)
کامپایل متقابل با استفاده از این زنجیره ابزار\N'46'
.SH "وضعیت خروج (EXIT STATUS)"
.P
دستور \fBdune format\N'45'dune\N'45'file\fR با مقادیر زیر خارج می‌شود:
.TP 4
0
در صورت موفقیت\N'46'
.TP 4
1
در صورت بروز خطا\N'46'
.TP 4
130
اگر توسط یک سیگنال متوقف شود\N'46'
.SH "محیط (ENVIRONMENT)"
.P
این متغیرهای محیطی بر اجرای \fBformat\N'45'dune\N'45'file\fR تأثیر می‌گذارند:
.TP 4
\fBDUNE_BUILD_DIR\fR
دایرکتوری مشخص‌شده برای ساخت\N'46' در صورت عدم تعیین، مقدار پیش‌فرض _build است
.TP 4
\fBDUNE_CACHE\fR
فعال یا غیرفعال کردن کش Dune (یکی از مقادیر \fBdisabled\fR، \fBenabled\N'45'except\N'45'user\N'45'rules\fR یا \fBenabled\fR)\N'46' پیش‌فرض `enabled\N'45'except\N'45'user\N'45'rules\N'39' است\N'46'
.TP 4
\fBDUNE_CACHE_CHECK_PROBABILITY\fR
بررسی بازتولیدپذیری ساخت با اجرای مجدد قواعدی که به صورت تصادفی انتخاب شده‌اند و مقایسه نتایج آن‌ها با نتایج ذخیره‌شده در کش Dune\N'46' توجه: با افزایش احتمال چنین بررسی‌هایی، سرعت ساخت کاهش می‌یابد\N'46' احتمال پیش‌فرض صفر است، یعنی هیچ قاعده‌ای بررسی نمی‌شود\N'46'
.TP 4
\fBDUNE_CACHE_STORAGE_MODE\fR
حالت ذخیره‌سازی کش Dune (یکی از مقادیر \fBauto\fR، \fBhardlink\fR یا \fBcopy\fR)\N'46' پیش‌فرض `hardlink\N'39' است\N'46'
.TP 4
\fBDUNE_CROSS_TARGET\fR
کامپایل متقابل با استفاده از این زنجیره ابزار\N'46'
.TP 4
\fBDUNE_DEBUG_PACKAGE_LOGS\fR
همیشه لاگ‌های استاندارد را هنگام ساخت بسته‌ها چاپ می‌کند
.TP 4
\fBDUNE_DIFF_COMMAND\fR
دستور شل مورد استفاده برای مقایسه (diff) فایل‌ها\N'46' از \N'45' برای غیرفعال کردن چاپ تفاوت‌ها استفاده کنید\N'46'
.TP 4
\fBDUNE_DISABLE_PROMOTION\fR
غیرفعال کردن تمام قواعد ترفیع
.TP 4
\fBDUNE_INSTRUMENT_WITH\fR
فعال‌سازی ابزار دقیق توسط \fBBACKENDS\fR\N'46' مقدار \fBBACKENDS\fR فهرستی از نام‌های کتابخانه‌هاست که با کاما جدا شده‌اند و هر یک از آن‌ها باید یک backend ابزار دقیق را تعریف کرده باشد\N'46'
.TP 4
\fBDUNE_JOBS\fR
اجرای همزمان حداکثر \fIJOBS\fR دستور\N'46' مقدار \fIJOBS\fR باید یک عدد صحیح مثبت باشد یا \fBauto\fR برای تشخیص خودکار تعداد هسته‌ها (حالت پیش‌فرض)\N'46'
.TP 4
\fBDUNE_PROFILE\fR
پروفایل ساخت\N'46' در صورت عدم تعیین، \fBdev\fR یا در صورت تنظیم \N'45'p، مقدار \fBrelease\fR است\N'46'
.TP 4
\fBDUNE_ROOT\fR
استفاده از این دایرکتوری به عنوان ریشه فضای کاری به جای حدس زدن آن\N'46' توجه داشته باشید که این گزینه تفسیر اهداف ارائه‌شده در خط فرمان را تغییر نمی‌دهد\N'46' این گزینه فقط برای اسکریپت‌ها در نظر گرفته شده است\N'46'
.TP 4
\fBDUNE_SANDBOX\fR
حالت سندباکس مورد استفاده به صورت پیش‌فرض\N'46' (گزینه \N'45'\N'45'sandbox را ببینید)
.TP 4
\fBDUNE_STORE_ORIG_SOURCE_DIR\fR
ذخیره مکان اصلی منبع در فراداده dune\N'45'package\N'46'
.TP 4
\fBDUNE_TARGET_EXEC\fR
دستور پوششی برای اجرای باینری‌های هدف هنگام کامپایل متقابل\N'46' قالب: TOOLCHAIN=CMD (مانند \N'39'windows=wine\N'39')\N'46'
.TP 4
\fBDUNE_WORKSPACE\fR
استفاده از این فایل فضای کاری مشخص به جای جستجوی آن\N'46'
.SH "همچنین ببینید (SEE ALSO)"
.P
dune(1)