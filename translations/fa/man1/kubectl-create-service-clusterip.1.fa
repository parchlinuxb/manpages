.nh
.TH KUBERNETES 1 "Jan 2015" "Eric Paris" "راهنمای کاربر kubernetes"

.SH "نام (NAME)"
kubectl-create-service-clusterip \- ایجاد یک سرویس ClusterIP


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubectl create service clusterip\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
ایجاد یک سرویس ClusterIP با نام مشخص‌شده.


.SH "گزینه‌ها (OPTIONS)"
\fB--allow-missing-template-keys\fP=true
	در صورت true بودن، از هرگونه خطای درون الگوها در زمان مفقود بودن یک فیلد یا کلید map در الگو چشم‌پوشی می‌شود. فقط برای فرمت‌های خروجی golang و jsonpath اعمال می‌گردد.

.PP
\fB--clusterip\fP=""
	اختصاص دادن ClusterIP دلخواه یا تنظیم آن بر روی 'None' برای یک سرویس 'headless' (بدون توازن بار).

.PP
\fB--dry-run\fP="none"
	باید یکی از مقادیر "none"، "server" یا "client" باشد. اگر راهبرد client باشد، فقط شیئی را که ارسال خواهد شد چاپ می‌کند بدون اینکه آن را بفرستد. اگر راهبرد server باشد، درخواست سمت سرور را بدون پایدارسازی و ذخیره منبع ارسال می‌کند.

.PP
\fB--field-manager\fP="kubectl-create"
	نام مدیری که برای ردیابی مالکیت فیلدها استفاده می‌شود.

.PP
\fB-o\fP, \fB--output\fP=""
	فرمت خروجی. یکی از موارد: (json, yaml, kyaml, name, go-template, go-template-file, template, templatefile, jsonpath, jsonpath-as-json, jsonpath-file).

.PP
\fB--save-config\fP=false
	در صورت true بودن، پیکربندی شیء کنونی در حاشیه‌نویسی (annotation) آن ذخیره خواهد شد. در غیر این صورت، حاشیه‌نویسی بدون تغییر باقی می‌ماند. این فلگ زمانی مفید است که بخواهید در آینده kubectl apply را روی این شیء اجرا کنید.

.PP
\fB--show-managed-fields\fP=false
	در صورت true بودن، هنگام چاپ اشیاء در قالب‌های JSON یا YAML فیلدهای managedFields حفظ می‌شوند.

.PP
\fB--tcp\fP=[]
	جفت‌های پورت را می‌توان به صورت ':\&' مشخص کرد.

.PP
\fB--template\fP=""
	رشته الگو یا مسیر فایل الگو برای استفاده در زمان‌های \-o=go-template و \-o=go-template-file. فرمت الگو از نوع الگوهای golang است [http://golang.org/pkg/text/template/#pkg-overview].

.PP
\fB--validate\fP="strict"
	باید یکی از موارد strict (یا true)، warn، یا ignore (یا false) باشد. مقدار "true" یا "strict" از یک طرح‌واره (schema) برای اعتبارسنجی ورودی استفاده کرده و در صورت نامعتبر بودن، درخواست را با خطا مواجه می‌کند. اگر ServerSideFieldValidation روی api-server فعال باشد، اعتبارسنجی سمت سرور را انجام می‌دهد، اما در غیر این صورت به اعتبارسنجی با قابلیت اطمینان کمتر در سمت کلاینت بازمی‌گردد. مقدار "warn" در صورتی که اعتبارسنجی فیلد سمت سرور روی API server فعال باشد، در مورد فیلدهای ناشناخته یا تکراری بدون مسدود کردن درخواست هشدار می‌دهد، و در غیر این صورت مانند "ignore" رفتار می‌کند. مقدار "false" یا "ignore" هیچ اعتبارسنجی طرح‌واره‌ای انجام نمی‌دهد و هر فیلد ناشناخته یا تکراری را بدون اعلام رد می‌کند.


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--as\fP=""
	نام کاربری برای جعل هویت (impersonate) در این عملیات. کاربر می‌تواند یک کاربر معمولی یا یک حساب خدمت (service account) در یک فضای نام (namespace) باشد.

.PP
\fB--as-group\fP=[]
	گروه برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای تعیین چندین گروه تکرار شود.

.PP
\fB--as-uid\fP=""
	شناسه UID برای جعل هویت در این عملیات.

.PP
\fB--as-user-extra\fP=[]
	اطلاعات اضافی کاربر برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای تعیین چندین مقدار برای یک کلید یکسان تکرار شود.

.PP
\fB--cache-dir\fP="/home/username/.kube/cache"
	دایرکتوری پیش‌فرض کش

.PP
\fB--certificate-authority\fP=""
	مسیر فایل گواهی برای مرجع صدور گواهی (certificate authority)

.PP
\fB--client-certificate\fP=""
	مسیر فایل گواهی کلاینت برای TLS

.PP
\fB--client-key\fP=""
	مسیر فایل کلید کلاینت برای TLS

.PP
\fB--cluster\fP=""
	نام کلاستر kubeconfig برای استفاده

.PP
\fB--context\fP=""
	نام کانتکست kubeconfig برای استفاده

.PP
\fB--disable-compression\fP=false
	در صورت true بودن، از فشرده‌سازی پاسخ‌ها برای تمام درخواست‌ها به سرور صرف‌نظر می‌شود

.PP
\fB--insecure-skip-tls-verify\fP=false
	در صورت true بودن، اعتبار گواهی سرور بررسی نخواهد شد. این کار اتصالات HTTPS شما را ناامن می‌کند

.PP
\fB--kubeconfig\fP=""
	مسیر فایل kubeconfig برای استفاده در درخواست‌های CLI.

.PP
\fB--kuberc\fP=""
	مسیر فایل kuberc برای استفاده در ترجیحات (preferences). این قابلیت می‌تواند با export کردن feature gate به صورت KUBECTL_KUBERC=false یا خاموش کردن ویژگی با KUBERC=off غیرفعال شود.

.PP
\fB--match-server-version\fP=false
	الزام به تطابق نسخه سرور با نسخه کلاینت

.PP
\fB-n\fP, \fB--namespace\fP=""
	در صورت وجود، حوزه namespace برای این درخواست CLI

.PP
\fB--password\fP=""
	رمز عبور برای احراز هویت پایه (basic authentication) در سرور API

.PP
\fB--profile\fP="none"
	نام پروفایل برای ثبت. یکی از (none|cpu|heap|goroutine|threadcreate|block|mutex|trace)

.PP
\fB--profile-output\fP="profile.pprof"
	نام فایلی که پروفایل در آن ذخیره می‌شود

.PP
\fB--request-timeout\fP="0"
	مدت زمان انتظار پیش از انصراف از یک درخواست به سرور. مقادیر غیر صفر باید شامل واحد زمانی متناظر باشند (مانند 1s، 2m، 3h). مقدار صفر یعنی درخواست‌ها هرگز منقضی نشوند (بدون timeout).

.PP
\fB-s\fP, \fB--server\fP=""
	آدرس و پورت سرور Kubernetes API

.PP
\fB--tls-server-name\fP=""
	نام سرور برای اعتبارسنجی گواهی سرور. در صورت عدم ارائه، از hostname استفاده‌شده برای برقراری ارتباط با سرور استفاده می‌شود

.PP
\fB--token\fP=""
	توکن Bearer برای احراز هویت در سرور API

.PP
\fB--user\fP=""
	نام کاربر kubeconfig برای استفاده

.PP
\fB--username\fP=""
	نام کاربری برای احراز هویت پایه در سرور API

.PP
\fB--version\fP=false
	گزینه \-\-version یا \-\-version=raw اطلاعات نسخه را چاپ کرده و خارج می‌شود؛ \-\-version=vX.Y.Z... نسخه گزارش‌شده را تنظیم می‌کند

.PP
\fB--warnings-as-errors\fP=false
	در نظر گرفتن هشدارهای دریافتی از سرور به عنوان خطا و خروج با کد وضعیت غیر صفر


.SH "مثال‌ها (EXAMPLES)"
.EX
  # ایجاد یک سرویس ClusterIP جدید به نام my-cs
  kubectl create service clusterip my-cs --tcp=5678:8080
  
  # ایجاد یک سرویس ClusterIP جدید به نام my-cs (در حالت headless)
  kubectl create service clusterip my-cs --clusterip="None"
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubectl-create-service(1)\fP


.SH "تاریخچه (HISTORY)"
ژانویه ۲۰۱۵، در ابتدا توسط Eric Paris (eparis at redhat dot com) بر پایه محتوای منبع kubernetes گردآوری شد، اما امید است که از آن زمان به بعد به طور خودکار تولید شده باشند!
