.SS abstract\-method / W0223
.sp
\fBMessage emitted:\fP
.sp
\fBMethod %r is abstract in class %r but is not overridden in child class %r\fP
.sp
\fBDescription:\fP
.sp
\fIUsed when an abstract method (i.e. raise NotImplementedError) is not overridden in concrete class.\fP
.sp
\fBProblematic code:\fP
.sp
\fBabstract_method.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
import abc


class WildAnimal:
    @abc.abstractmethod
    def make_sound(self):
        pass


class Panther(WildAnimal):  # [abstract\-method]
    pass

.EE
.UNINDENT
.UNINDENT
.sp
\fBfunction_raising_not_implemented_error.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
class Pet:
    def make_sound(self):
        raise NotImplementedError


class Cat(Pet):  # [abstract\-method]
    pass

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.sp
\fBabstract_method.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
import abc


class WildAnimal:
    @abc.abstractmethod
    def make_sound(self):
        pass


class Panther(WildAnimal):
    def make_sound(self):
        print(\(dqMEEEOW\(dq)

.EE
.UNINDENT
.UNINDENT
