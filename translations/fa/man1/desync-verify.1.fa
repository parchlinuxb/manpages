.nh
.TH "desync" "1" "Sep 2026" "desync" ""

.SH "نام (NAME)"
desync-verify \- Read chunks in a store and verify their integrity


.SH "خلاصه دستور (SYNOPSIS)"
\fBdesync verify [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Reads all chunks in a local store and verifies their integrity. If -r is used,
invalid chunks are deleted from the store.


.SH "گزینه‌ها (OPTIONS)"
\fB-n\fP, \fB--concurrency\fP=10
	number of concurrent goroutines

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for verify

.PP
\fB-r\fP, \fB--repair\fP[=false]
	remove invalid chunks from the store

.PP
\fB-s\fP, \fB--store\fP=""
	local store to verify


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config file (default $HOME/.config/desync/config.json)

.PP
\fB--digest\fP="sha512-256"
	digest algorithm, sha512-256 or sha256

.PP
\fB--verbose\fP[=false]
	verbose mode


.SH "مثال (EXAMPLE)"
.EX
  desync verify -s /path/to/store
  desync verify -s /path/to/store -r
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBdesync(1)\fP


.SH "تاریخچه (HISTORY)"
