.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-exec \- اجرای یک دستور در یک کانتینر در حال اجرا


.SH "خلاصه (SYNOPSIS)"
\fBdocker exec [OPTIONS] CONTAINER COMMAND [ARG...]\fP


.SH "شرح (DESCRIPTION)"
نام مستعار برای \fBdocker container exec\fR\&.


.SH "گزینه‌ها (OPTIONS)"
\fB-d\fP, \fB--detach\fP[=false]
	حالت تفکیک‌شده (Detached): اجرای دستور در پس‌زمینه

.PP
\fB--detach-keys\fP=""
	بازنویسی توالی کلیدها برای جدا شدن از کانتینر

.PP
\fB-e\fP, \fB--env\fP=
	تنظیم متغیرهای محیطی

.PP
\fB--env-file\fP=
	خواندن یک فایل حاوی متغیرهای محیطی

.PP
\fB-i\fP, \fB--interactive\fP[=false]
	باز نگه داشتن STDIN حتی در صورت متصل نبودن

.PP
\fB--privileged\fP[=false]
	اعطای دسترسی‌های گسترش‌یافته به دستور

.PP
\fB-t\fP, \fB--tty\fP[=false]
	تخصیص یک شبه TTY (pseudo-TTY)

.PP
\fB-u\fP, \fB--user\fP=""
	نام کاربری یا UID (قالب: "[:]")

.PP
\fB-w\fP, \fB--workdir\fP=""
	دایرکتوری کاری درون کانتینر


.SH "ببینید (SEE ALSO)"
\fBdocker(1)\fP
