.INDENT 0.0
.INDENT 3.5
.sp
.EX
{
    \(dqresult\(dq: 0,
    \(dqtext\(dq: \(dq1 DHCPv6 server(s) deleted.\(dq,
    \(dqarguments\(dq: {
        \(dqcount\(dq: 1
    }
}
.EE
.UNINDENT
.UNINDENT
.sp
