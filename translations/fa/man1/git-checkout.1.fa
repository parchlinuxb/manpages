.\"     Title: git-checkout
.\"    Author: [FIXME: author] [see http://www.docbook.org/tdg5/en/html/author]
.\" Generator: DocBook XSL Stylesheets vsnapshot <http://docbook.sf.net>
.\"      Date: 2026-06-29
.\"    Manual: دستورات عمومی کاربر
.\"    Source: Git 2.55.0
.\"  Language: Persian
.\"
.TH "GIT\-CHECKOUT" "1" "2026\-06\-29" "Git 2\&.55\&.0" "دستورات عمومی کاربر"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
git-checkout \- جابه‌جایی میان شاخه‌ها یا بازیابی فایل‌های درخت کاری
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.nf
\fBgit\fR \fBcheckout\fR [\fB\-q\fR] [\fB\-f\fR] [\fB\-m\fR] [\fI<branch>\fR]
\fBgit\fR \fBcheckout\fR [\fB\-q\fR] [\fB\-f\fR] [\fB\-m\fR] \fB\-\-detach\fR [\fI<branch>\fR]
\fBgit\fR \fBcheckout\fR [\fB\-q\fR] [\fB\-f\fR] [\fB\-m\fR] [\fB\-\-detach\fR] \fI<commit>\fR
\fBgit\fR \fBcheckout\fR [\fB\-q\fR] [\fB\-f\fR] [\fB\-m\fR] [[\fB\-b\fR|\fB\-B\fR|\fB\-\-orphan\fR] \fI<new\-branch>\fR] [\fI<start\-point>\fR]
\fBgit\fR \fBcheckout\fR \fI<tree\-ish>\fR [\fB\-\-\fR] \fI<pathspec>\fR\&...
\fBgit\fR \fBcheckout\fR \fI<tree\-ish>\fR \fB\-\-pathspec\-from\-file=\fR\fI<file>\fR [\fB\-\-pathspec\-file\-nul\fR]
\fBgit\fR \fBcheckout\fR [\fB\-f\fR|\fB\-\-ours\fR|\fB\-\-theirs\fR|\fB\-m\fR|\fB\-\-conflict=\fR\fI<style>\fR] [\fB\-\-\fR] \fI<pathspec>\fR\&...
\fBgit\fR \fBcheckout\fR [\fB\-f\fR|\fB\-\-ours\fR|\fB\-\-theirs\fR|\fB\-m\fR|\fB\-\-conflict=\fR\fI<style>\fR] \fB\-\-pathspec\-from\-file=\fR\fI<file>\fR [\fB\-\-pathspec\-file\-nul\fR]
\fBgit\fR \fBcheckout\fR (\fB\-p\fR|\fB\-\-patch\fR) [\fI<tree\-ish>\fR] [\fB\-\-\fR] [\fI<pathspec>\fR\&...]
.fi
.sp
.SH "توضیحات (DESCRIPTION)"
.sp
دستور
\fBgit\fR \fBcheckout\fR
دارای دو حالت اصلی است:
.sp
.RS 4
.ie n \{\
\h'-04' 1.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  1." 4.2
.\}
\fBجابه‌جایی شاخه‌ها (Switch branches)\fR، با
\fBgit\fR
\fBcheckout\fR
\fI<branch>\fR
.RE
.sp
.RS 4
.ie n \{\
\h'-04' 2.\h'+01'\c
.\}
.el \{\
.sp -1
.IP "  2." 4.2
.\}
\fBبازیابی نسخه متفاوتی از یک فایل (Restore a different version of a file)\fR، برای نمونه با
\fBgit\fR
\fBcheckout\fR
\fI<commit>\fR
\fI<filename>\fR
یا
\fBgit\fR
\fBcheckout\fR
\fI<filename>\fR
.RE
.sp
برای چگونگی تصمیم‌گیری گیت در انتخاب هریک از این دو حالت، بخش «ابهام‌زدایی از آرگومان‌ها (ARGUMENT DISAMBIGUATION)» در ادامه را ببینید\&.
.PP
\fBgit\fR \fBcheckout\fR [\fI<branch>\fR]
.RS 4
جابه‌جایی به
\fI<branch>\fR\&.
این کار شاخه فعلی را روی
\fI<branch>\fR
تنظیم کرده و فایل‌ها را در دایرکتوری کاری شما به‌روزرسانی می‌کند\&. در صورتی که تغییرات کامیت‌نشده‌ای در فایل‌هایی وجود داشته باشد که محتوای آن‌ها میان
\fI<branch>\fR
و کامیت فعلی شما متفاوت است، عملیات دریافت (checkout) با شکست مواجه می‌شود\&. در غیر این صورت، تغییرات کامیت‌نشده حفظ خواهند شد\&.
.sp
اگر
\fI<branch>\fR
یافت نشود، اما دقیقاً در یک ریموت شاخه ردیابی با نام منطبق وجود داشته باشد (آن را
\fI<remote>\fR
می‌نامیم) و گزینه
\fB\-\-no\-guess\fR
مشخص نشده باشد، معادل دستور زیر در نظر گرفته می‌شود:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout \-b <branch> \-\-track <remote>/<branch>
.fi
.if n \{\
.RE
.\}
.sp
اجرای
\fBgit\fR
\fBcheckout\fR
بدون تعیین یک شاخه، هیچ اثری ندارد مگر آنکه اطلاعات ردیابی شاخه فعلی را چاپ کند\&.
.RE
.PP
\fBgit\fR \fBcheckout\fR \fB\-b\fR \fI<new\-branch>\fR [\fI<start\-point>\fR]
.RS 4
شاخه جدیدی به نام
\fI<new\-branch>\fR
می‌سازد، آن را از
\fI<start\-point>\fR
(به‌طور پیش‌فرض کامیت فعلی) آغاز می‌کند، و شاخه جدید را دریافت (checkout) می‌نماید؛ می‌توانید از گزینه‌های
\fB\-\-track\fR
یا
\fB\-\-no\-track\fR
برای تنظیم اطلاعات ردیابی بالادست (upstream) شاخه استفاده کنید\&.
.sp
اگر در دریافت
\fI<new\-branch>\fR
خطایی رخ دهد، برای نمونه اگر دریافت کامیت
\fI<start\-point>\fR
باعث رونویسی تغییرات کامیت‌نشده شما شود، این عملیات با شکست مواجه خواهد شد\&.
.RE
.PP
\fBgit\fR \fBcheckout\fR \fB\-B\fR \fI<branch>\fR [\fI<start\-point>\fR]
.RS 4
مشابه گزینه
\fB\-b\fR
است، با این تفاوت که اگر شاخه از قبل وجود داشته باشد، به جای شکست خوردن،
\fI<branch>\fR
را به نقطه شروع بازنشانی (reset) می‌کند\&.
.RE
.PP
\fBgit\fR \fBcheckout\fR \fB\-\-detach\fR [\fI<branch>\fR], \fBgit\fR \fBcheckout\fR [\fB\-\-detach\fR] \fI<commit>\fR
.RS 4
مشابه دستور
\fBgit\fR
\fBcheckout\fR
\fI<branch>\fR
است، با این تفاوت که به جای اشاره دادن
\fBHEAD\fR
به شاخه،
\fBHEAD\fR
را به شناسه کامیت اشاره می‌دهد\&. برای اطلاعات بیشتر بخش «سر جداشده (DETACHED HEAD)» در ادامه را ببینید\&.
.sp
حذف کردن
\fI<branch>\fR
باعث جدا شدن
\fBHEAD\fR
در نوک (tip) شاخه فعلی می‌شود\&.
.RE
.PP
\fBgit\fR \fBcheckout\fR \fI<tree\-ish>\fR [\fB\-\-\fR] \fI<pathspec>\fR\&.\&.\&., \fBgit\fR \fBcheckout\fR \fI<tree\-ish>\fR \fB\-\-pathspec\-from\-file=\fR\fI<file>\fR [\fB\-\-pathspec\-file\-nul\fR]
.RS 4
فایل‌ها و/یا دایرکتوری‌های مشخص‌شده را با نسخه برگرفته از کامیت یا درخت داده‌شده جایگزین کرده و آن‌ها را به ایندکس (که به عنوان "staging area" یا ناحیه مرحله‌بندی نیز شناخته می‌شود) اضافه می‌کند\&.
.sp
برای نمونه، دستور
\fBgit\fR
\fBcheckout\fR
\fBmain\fR
\fBfile\&.txt\fR
فایل
\fBfile\&.txt\fR
را با نسخه موجود در شاخه
\fBmain\fR
جایگزین خواهد کرد\&.
.RE
.PP
\fBgit\fR \fBcheckout\fR [\fB\-f\fR|\fB\-\-ours\fR|\fB\-\-theirs\fR|\fB\-m\fR|\fB\-\-conflict=\fR\fI<style>\fR] [\fB\-\-\fR] \fI<pathspec>\fR\&.\&.\&., \fBgit\fR \fBcheckout\fR [\fB\-f\fR|\fB\-\-ours\fR|\fB\-\-theirs\fR|\fB\-m\fR|\fB\-\-conflict=\fR\fI<style>\fR] \fB\-\-pathspec\-from\-file=\fR\fI<file>\fR [\fB\-\-pathspec\-file\-nul\fR]
.RS 4
فایل‌ها و/یا دایرکتوری‌های تعیین‌شده را با نسخه موجود در ایندکس جایگزین می‌کند\&.
.sp
برای نمونه، اگر کامیتی را چک‌اوت کنید، فایل
\fBfile\&.txt\fR
را ویرایش نمایید، و سپس متوجه شوید که آن تغییرات اشتباه بوده‌اند، دستور
\fBgit\fR
\fBcheckout\fR
\fBfile\&.txt\fR
تمامی تغییرات مرحله‌بندی‌نشده (unstaged) در
\fBfile\&.txt\fR
را دور می‌اندازد\&.
.sp
اگر فایل دارای تعارض در ادغام (merge conflict) باشد و شما هنوز دستور
\fBgit\fR
\fBadd\fR
\fBfile\&.txt\fR
(یا معادل آن) را برای علامت‌گذاری به عنوان رفع تعارض اجرا نکرده باشید، این دستور با شکست مواجه می‌شود\&. می‌توانید از گزینه
\fB\-f\fR
استفاده کنید تا به جای شکست، ورودی‌های ادغام‌نشده نادیده گرفته شوند؛ از
\fB\-\-ours\fR
یا
\fB\-\-theirs\fR
برای جایگزینی آن‌ها با نسخه یک سمت خاص از ادغام استفاده نمایید؛ یا از گزینه
\fB\-m\fR
برای جایگزینی آن‌ها با نتیجه اولیه ادغام دارای تعارض بهره ببرید\&.
.RE
.PP
\fBgit\fR \fBcheckout\fR (\fB\-p\fR|\fB\-\-patch\fR) [\fI<tree\-ish>\fR] [\fB\-\-\fR] [\fI<pathspec>\fR\&.\&.\&.]
.RS 4
مشابه دو حالت پیشین است، اما به شما امکان می‌دهد از رابط تعاملی برای مشاهده خروجی "diff" و انتخاب تکه‌هایی (hunks) که مایلید در نتیجه استفاده شوند، بهره ببرید\&. برای توضیحات گزینه
\fB\-\-patch\fR
به ادامه متن مراجعه کنید\&.
.RE
.SH "گزینه‌ها (OPTIONS)"
.PP
\fB\-q\fR, \fB\-\-quiet\fR
.RS 4
حالت ساکت؛ جلوگیری از نمایش پیام‌های بازخورد\&.
.RE
.PP
\fB\-\-progress\fR, \fB\-\-no\-progress\fR
.RS 4
وضعیت پیشرفت زمانی که به یک ترمینال متصل باشد به‌طور پیش‌فرض روی جریان خطای استاندارد گزارش می‌شود، مگر اینکه گزینه
\fB\-\-quiet\fR
مشخص شده باشد\&. این فلگ گزارش پیشرفت را حتی در صورت عدم اتصال به ترمینال و بدون توجه به
\fB\-\-quiet\fR
فعال می‌کند\&.
.RE
.PP
\fB\-f\fR, \fB\-\-force\fR
.RS 4
هنگام جابه‌جایی شاخه‌ها، حتی اگر ایندکس یا درخت کاری با
\fBHEAD\fR
متفاوت باشد و حتی اگر فایل‌های ردیابی‌نشده‌ای بر سر راه باشند، عملیات را ادامه می‌دهد\&. از این گزینه برای دور انداختن تغییرات محلی و هرگونه فایل یا دایرکتوری ردیابی‌نشده که مانع کار هستند استفاده می‌شود\&.
.sp
هنگام دریافت مسیرها از ایندکس، در صورت وجود ورودی‌های ادغام‌نشده با شکست مواجه نمی‌شود؛ در عوض، ورودی‌های ادغام‌نشده نادیده گرفته می‌شوند\&.
.RE
.PP
\fB\-\-ours\fR, \fB\-\-theirs\fR
.RS 4
هنگام دریافت مسیرها از ایندکس، مرحله ۲ (\fBours\fR) یا ۳ (\fBtheirs\fR) را برای مسیرهای ادغام‌نشده دریافت می‌کند\&.
.sp
توجه داشته باشید که هنگام اجرای
\fBgit\fR
\fBrebase\fR
و
\fBgit\fR
\fBpull\fR
\fB\-\-rebase\fR،
ممکن است
\fBours\fR
و
\fBtheirs\fR
جابه‌جا به نظر برسند؛
\fB\-\-ours\fR
نسخه موجود در شاخه‌ای را ارائه می‌دهد که تغییرات بر روی آن بازپایه‌ریزی (rebase) می‌شوند، در حالی که
\fB\-\-theirs\fR
نسخه موجود در شاخه‌ای را ارائه می‌دهد که کارهای در حال بازپایه‌ریزی شما را در بر دارد\&.
.sp
دلیل این امر این است که
\fBrebase\fR
در گردش کاری به کار می‌رود که تاریخچه موجود در ریموت را به عنوان تاریخچه مرجع و مشترک تلقی می‌کند، و کارهای انجام‌شده روی شاخه‌ای را که بازپایه‌ریزی می‌کنید به عنوان کارهای شخص ثالث در نظر می‌گیرد که باید یکپارچه شوند، و شما در طول بازپایه‌ریزی موقتاً نقش نگه‌دارنده تاریخچه مرجع را به عهده می‌گیرید\&. به عنوان نگه‌دارنده تاریخچه مرجع، شما باید تاریخچه ریموت را به عنوان
\fBours\fR
(یعنی "تاریخچه مرجع مشترک ما")، و کارهایی را که روی شاخه جانبی خود انجام داده‌اید به عنوان
\fBtheirs\fR
(یعنی "کار یکی از مشارکت‌کنندگان روی آن") در نظر بگیرید\&.
.RE
.PP
\fB\-b\fR \fI<new\-branch>\fR
.RS 4
شاخه جدیدی به نام
\fI<new\-branch>\fR
می‌سازد، آن را از
\fI<start\-point>\fR
آغاز می‌کند، و شاخه حاصل را دریافت (checkout) می‌نماید؛ برای جزئیات به
\fBgit-branch\fR(1)
مراجعه کنید\&.
.RE
.PP
\fB\-B\fR \fI<new\-branch>\fR
.RS 4
مشابه گزینه
\fB\-b\fR
است، با این تفاوت که اگر شاخه از قبل وجود داشته باشد، به جای شکست خوردن،
\fI<branch>\fR
را به نقطه شروع بازنشانی (reset) می‌کند\&.
.RE
.PP
\fB\-t\fR, \fB\-\-track\fR[\fB=\fR(\fBdirect\fR|\fBinherit\fR)]
.RS 4
هنگام ایجاد یک شاخه جدید، پیکربندی "بالادست" (upstream) را تنظیم می‌کند\&. برای جزئیات به گزینه
\fB\-\-track\fR
در
\fBgit-branch\fR(1)
مراجعه نمایید\&. جهت سهولت کار، استفاده از \-\-track بدون \-b به معنای ایجاد شاخه است\&.
.sp
اگر گزینه
\fB\-b\fR
داده نشود، نام شاخه جدید از شاخه ردیابی ریموت برگرفته می‌شود؛ این کار با نگاه به بخش محلی refspec پیکربندی‌شده برای ریموت مربوطه و سپس حذف بخش ابتدایی تا علامت "*" صورت می‌گیرد\&. این امر به ما می‌گوید که هنگام انشعاب از
\fBorigin/hack\fR
(یا
\fBremotes/origin/hack\fR،
یا حتی
\fBrefs/remotes/origin/hack\fR)،
از نام
\fBhack\fR
به عنوان شاخه محلی استفاده کنیم\&. اگر نام داده‌شده فاقد اسلش باشد، یا حدس زدن بالا به نامی خالی منجر شود، فرآیند حدس زدن متوقف می‌شود\&. در چنین حالتی می‌توانید با
\fB\-b\fR
صریحاً یک نام مشخص کنید\&.
.RE
.PP
\fB\-\-no\-track\fR
.RS 4
پیکربندی "بالادست" (upstream) را تنظیم نمی‌کند، حتی اگر متغیر پیکربندی
\fBbranch\&.autoSetupMerge\fR
برابر true باشد\&.
.RE
.PP
\fB\-\-guess\fR, \fB\-\-no\-guess\fR
.RS 4
اگر
\fI<branch>\fR
یافت نشود، اما دقیقاً در یک ریموت شاخه ردیابی با نام منطبق وجود داشته باشد (آن را
\fI<remote>\fR
می‌نامیم)، معادل دستور زیر در نظر گرفته می‌شود:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout \-b <branch> \-\-track <remote>/<branch>
.fi
.if n \{\
.RE
.\}
.sp
اگر شاخه در چندین ریموت وجود داشته باشد و نام یکی از آن‌ها در متغیر پیکربندی
\fBcheckout\&.defaultRemote\fR
مشخص شده باشد، برای ابهام‌زدایی از آن استفاده خواهیم کرد، حتی اگر
\fI<branch>\fR
میان تمامی ریموت‌ها یکتا نباشد\&. برای نمونه، آن را روی
\fBcheckout\&.defaultRemote=origin\fR
تنظیم کنید تا در صورتی که
\fI<branch>\fR
مبهم باشد اما در ریموت
\fIorigin\fR
وجود داشته باشد، همیشه شاخه‌های ریموت از آنجا دریافت شوند\&. همچنین گزینه
\fBcheckout\&.defaultRemote\fR
در
\fBgit-config\fR(1)
را ببینید\&.
.sp
رفتار پیش‌فرض،
\fB\-\-guess\fR
است\&. برای غیرفعال کردن آن از
\fB\-\-no\-guess\fR
استفاده کنید\&.
.sp
رفتار پیش‌فرض می‌تواند از طریق متغیر پیکربندی
\fBcheckout\&.guess\fR
تنظیم شود\&.
.RE
.PP
\fB\-l\fR
.RS 4
لاگ ارجاع (reflog) شاخه جدید را ایجاد می‌کند؛ برای جزئیات به
\fBgit-branch\fR(1)
مراجعه فرمایید\&.
.RE
.PP
\fB\-d\fR, \fB\-\-detach\fR
.RS 4
به جای دریافت یک شاخه برای کار روی آن، یک کامیت را برای بازبینی و آزمایش‌های دورریختنی دریافت می‌کند\&. این رفتار پیش‌فرض دستور
\fBgit\fR
\fBcheckout\fR
\fI<commit>\fR
است هنگامی که
\fI<commit>\fR
نام یک شاخه نباشد\&. برای جزئیات بیشتر به بخش «سر جداشده (DETACHED HEAD)» در ادامه مراجعه کنید\&.
.RE
.PP
\fB\-\-orphan\fR \fI<new\-branch>\fR
.RS 4
شاخه جدید متولدنشده‌ای (unborn) به نام
\fI<new\-branch>\fR
ایجاد می‌کند که از
\fI<start\-point>\fR
آغاز شده و به آن جابه‌جا می‌شود\&. نخستین کامیت ساخته‌شده روی این شاخه جدید والدی نخواهد داشت و ریشه یک تاریخچه جدید خواهد بود که کاملاً از تمامی شاخه‌ها و کامیت‌های دیگر منفصل است\&.
.sp
ایندکس و درخت کاری طوری تنظیم می‌شوند که گویی پیش‌تر دستور
\fBgit\fR
\fBcheckout\fR
\fI<start\-point>\fR
را اجرا کرده‌اید\&. این به شما امکان می‌دهد با اجرای ساده
\fBgit\fR
\fBcommit\fR
\fB\-a\fR
برای ساختن کامیت ریشه، تاریخچه جدیدی را آغاز کنید که مجموعه‌ای از مسیرهای مشابه با
\fI<start\-point>\fR
را ثبت می‌نماید\&.
.sp
این گزینه زمانی مفید است که بخواهید درخت یک کامیت را بدون افشای تاریخچه کامل آن منتشر کنید\&. ممکن است بخواهید این کار را برای انتشار شاخه متن‌باز از پروژه‌ای انجام دهید که درخت فعلی آن "پاک" است، اما تاریخچه کامل آن شامل کدهای اختصاصی یا دارای محدودیت‌های دیگر است\&.
.sp
اگر می‌خواهید یک تاریخچه منفصل را شروع کنید که مجموعه‌ای از مسیرها را کاملاً متفاوت با مسیرهای
\fI<start\-point>\fR
ثبت می‌کند، باید بلافاصله پس از ایجاد شاخه یتیم (orphan)، با اجرای دستور
\fBgit\fR
\fBrm\fR
\fB\-rf\fR
\&. از بالاترین سطح درخت کاری، ایندکس و درخت کاری را پاک کنید\&. پس از آن آماده خواهید بود تا با کپی کردن فایل‌ها از جای دیگر، استخراج یک فایل تاربال و غیره، فایل‌های جدید خود را آماده کرده و درخت کاری را دوباره پر نمایید\&.
.RE
.PP
\fB\-\-ignore\-skip\-worktree\-bits\fR
.RS 4
در حالت دریافت تنک (sparse checkout)، دستور
\fBgit\fR
\fBcheckout\fR
\fB\-\-\fR
\fI<path>\fR\&.\&.\&.
تنها ورودی‌هایی را به‌روزرسانی می‌کند که با
\fI<paths>\fR
و الگوهای تنک در
\fB$GIT_DIR/info/sparse\-checkout\fR
مطابقت داشته باشند\&. این گزینه الگوهای تنک را نادیده گرفته و تمامی فایل‌های موجود در
\fI<path>\fR\&.\&.\&.
را بازمی‌گرداند\&.
.RE
.PP
\fB\-m\fR, \fB\-\-merge\fR
.RS 4
هنگام جابه‌جایی شاخه‌ها، اگر تغییرات محلی روی یک یا چند فایل داشته باشید که میان شاخه فعلی و شاخه‌ای که قصد تغییر به آن را دارید متفاوت باشند، دستور به منظور حفظ تغییرات شما در بستر کاری از تعویض شاخه خودداری می‌کند\&. با استفاده از این گزینه، تغییرات محلیِ دارای تعارض به‌طور خودکار پیش از تعویض شاخه در استش ذخیره شده و پس از آن مجدداً اعمال می‌شوند\&. اگر تغییرات محلی با تفاوت‌های میان شاخه‌ها هم‌پوشانی نداشته باشند، تغییر شاخه بدون ذخیره در استش ادامه می‌یابد\&. اگر اعمال مجدد استش منجر به تعارض شود، ورودی در لیست استش ذخیره خواهد شد\&. تعارض‌ها را برطرف کرده و پس از اتمام، دستور
\fBgit\fR
\fBstash\fR
\fBdrop\fR
را اجرا کنید، یا پیش از اجرای دستور بعدی
\fBgit\fR
\fBstash\fR
\fBpop\fR
برای اعمال مجدد تغییرات، درخت کاری را پاک کنید (برای نمونه با
\fBgit\fR
\fBreset\fR
\fB\-\-hard\fR)\&.
.sp
هنگام دریافت مسیرها از ایندکس، این گزینه به شما امکان می‌دهد ادغام دارای تعارض را در مسیرهای مشخص‌شده بازسازی کنید\&. این گزینه را نمی‌توان هنگام دریافت مسیرها از یک tree\-ish استفاده کرد\&.
.RE
.PP
\fB\-\-conflict=\fR\fI<style>\fR
.RS 4
مشابه گزینه
\fB\-\-merge\fR
در بالا است، اما نحوه نمایش تکه‌های دارای تعارض را تغییر می‌دهد و متغیر پیکربندی
\fBmerge\&.conflictStyle\fR
را بازنویسی می‌کند\&. مقادیر ممکن عبارتند از
\fBmerge\fR
(پیش‌فرض)،
\fBdiff3\fR
و
\fBzdiff3\fR\&.
.RE
.PP
\fB\-p\fR, \fB\-\-patch\fR
.RS 4
انتخاب تعاملی تکه‌ها (hunks) در تفاوت میان
\fI<tree\-ish>\fR
(یا در صورت عدم تعیین، ایندکس) و درخت کاری\&. تکه‌های انتخاب‌شده سپس به‌صورت معکوس بر روی درخت کاری (و در صورت مشخص شدن
\fI<tree\-ish>\fR،
بر روی ایندکس) اعمال می‌شوند\&.
.sp
این بدان معناست که می‌توانید از دستور
\fBgit\fR
\fBcheckout\fR
\fB\-p\fR
برای دور ریختن انتخابی ویرایش‌ها از درخت کاری فعلی خود استفاده کنید\&. برای یادگیری نحوه کار با حالت
\fB\-\-patch\fR،
به بخش "Interactive Mode" در
\fBgit-add\fR(1)
مراجعه نمایید\&.
.sp
توجه داشته باشید که این گزینه به‌طور پیش‌فرض از حالت بدون هم‌پوشانی (no overlay) استفاده می‌کند (همچنین گزینه
\fB\-\-overlay\fR
را ببینید)، و در حال حاضر از حالت هم‌پوشانی (overlay) پشتیبانی نمی‌کند\&.
.RE
.PP
\fB\-U\fR\fI<n>\fR, \fB\-\-unified=\fR\fI<n>\fR
.RS 4
تولید تفاوت‌ها (diff) با
\fI<n>\fR
خط از متن پیرامون (context)\&. تعداد خطوط بستر به‌طور پیش‌فرض برابر با
\fBdiff\&.context\fR
یا ۳ در صورت تنظیم نشدن متغیر پیکربندی است\&. (گزینه
\fB\-U\fR
بدون
\fI<n>\fR
به دلیل یک تصادف تاریخی، به‌صورت بی‌صدا به عنوان مترادفی برای
\fB\-p\fR
پذیرفته می‌شود)\&.
.RE
.PP
\fB\-\-inter\-hunk\-context=\fR\fI<n>\fR
.RS 4
نمایش بستر میان تکه‌های diff تا تعداد خطوط مشخص‌شده در
\fI<number>\fR،
که بدین ترتیب تکه‌هایی را که به یکدیگر نزدیک هستند ترکیب می‌کند\&. مقدار پیش‌فرض آن
\fBdiff\&.interHunkContext\fR
یا 0 در صورت تنظیم نشدن این گزینه در پیکربندی است\&.
.RE
.PP
\fB\-\-ignore\-other\-worktrees\fR
.RS 4
دستور
\fBgit\fR
\fBcheckout\fR
زمانی که شاخه درخواستی از قبل در درخت کاری دیگری دریافت شده یا مورد استفاده باشد، از انجام عملیات خودداری می‌کند\&. این گزینه باعث می‌شود که شاخه در هر صورت دریافت شود\&. به عبارت دیگر، شاخه می‌تواند توسط بیش از یک درخت کاری مورد استفاده قرار گیرد\&.
.RE
.PP
\fB\-\-overwrite\-ignore\fR, \fB\-\-no\-overwrite\-ignore\fR
.RS 4
رونویسی بی‌صدا روی فایل‌های نادیده‌گرفته‌شده (ignored) هنگام جابه‌جایی شاخه‌ها\&. این رفتار پیش‌فرض است\&. از گزینه
\fB\-\-no\-overwrite\-ignore\fR
برای لغو عملیات در زمانی که شاخه جدید شامل فایل‌های نادیده‌گرفته‌شده است استفاده کنید\&.
.RE
.PP
\fB\-\-recurse\-submodules\fR, \fB\-\-no\-recurse\-submodules\fR
.RS 4
استفاده از گزینه
\fB\-\-recurse\-submodules\fR
محتوای تمامی زیرماژول‌های فعال را با توجه به کامیت ثبت‌شده در پروژه مادر (superproject) به‌روزرسانی می‌کند\&. اگر تغییرات محلی در یک زیرماژول رونویسی شوند، عملیات جابه‌جایی شاخه با شکست مواجه می‌شود مگر اینکه از گزینه
\fB\-f\fR
استفاده شود\&. اگر هیچ‌چیز (یا گزینه
\fB\-\-no\-recurse\-submodules\fR)
استفاده شود، درخت‌های کاری زیرماژول‌ها به‌روزرسانی نخواهند شد\&. درست همانند
\fBgit-submodule\fR(1)،
این کار مقدار
\fBHEAD\fR
زیرماژول را جدا (detach) می‌کند\&.
.RE
.PP
\fB\-\-overlay\fR, \fB\-\-no\-overlay\fR
.RS 4
در حالت پیش‌فرضِ پوشش‌دهی (overlay)، دستور
\fBgit\fR
\fBcheckout\fR
هرگز فایل‌ها را از ایندکس یا درخت کاری حذف نمی‌کند\&. با تعیین گزینه
\fB\-\-no\-overlay\fR،
فایل‌هایی که در ایندکس و درخت کاری وجود دارند اما در
\fI<tree\-ish>\fR
حاضر نیستند، حذف می‌شوند تا دقیقاً با
\fI<tree\-ish>\fR
مطابقت پیدا کنند\&.
.RE
.PP
\fB\-\-pathspec\-from\-file=\fR\fI<file>\fR
.RS 4
مشخصه مسیر (pathspec) به جای آرگومان‌های خط فرمان، از طریق
\fI<file>\fR
ارسال می‌شود\&. اگر
\fI<file>\fR
دقیقاً
\fB\-\fR
باشد، ورودی استاندارد به کار گرفته می‌شود\&. عناصر مشخصه مسیر با
\fILF\fR
یا
\fICR\fR/\fILF\fR
از یکدیگر جدا می‌شوند\&. عناصر مشخصه مسیر می‌توانند همان‌گونه که برای متغیر پیکربندی
\fBcore\&.quotePath\fR
توضیح داده شده درون نقل‌قول قرار گیرند (به
\fBgit-config\fR(1)
مراجعه فرمایید)\&. همچنین گزینه‌های
\fB\-\-pathspec\-file\-nul\fR
و گزینه سراسری
\fB\-\-literal\-pathspecs\fR
را ببینید\&.
.RE
.PP
\fB\-\-pathspec\-file\-nul\fR
.RS 4
تنها همراه با
\fB\-\-pathspec\-from\-file\fR
معنادار است\&. عناصر مشخصه مسیر با نویسه
\fINUL\fR
جدا می‌شوند و با سایر نویسه‌ها کاملاً لفظی (شامل خطوط جدید و نقل‌قول‌ها) رفتار می‌شود\&.
.RE
.PP
\fI<branch>\fR
.RS 4
شاخه مورد نظر برای دریافت؛ اگر به یک شاخه اشاره کند (یعنی نامی که وقتی "refs/heads/" در ابتدای آن قرار می‌گیرد یک ارجاع معتبر باشد)، آن شاخه دریافت می‌شود\&. در غیر این صورت، اگر به یک کامیت معتبر ارجاع دهد،
\fBHEAD\fR
شما در وضعیت "جداشده" (detached) قرار می‌گیرد و شما دیگر روی هیچ شاخه‌ای نخواهید بود (برای جزئیات به بخش زیر مراجعه کنید)\&.
.sp
می‌توانید از ساختار
\fB@\fR{\-N}
برای ارجاع به N\-امین شاخه/کامیتِ قبلیِ دریافت‌شده با دستور "git checkout" استفاده نمایید\&. همچنین می‌توانید
\fB\-\fR
را مشخص کنید که مترادف با
\fB@\fR{\-1}
است\&.
.sp
به عنوان یک حالت خاص، می‌توانید از
\fI<rev\-a>\fR\fB\&.\&.\&.\fR\fI<rev\-b>\fR
به عنوان میان‌بری برای پایه ادغام (merge base) میان
\fI<rev\-a>\fR
و
\fI<rev\-b>\fR
در صورتی که دقیقاً یک پایه ادغام وجود داشته باشد استفاده کنید\&. شما می‌توانید حداکثر یکی از
\fI<rev\-a>\fR
و
\fI<rev\-b>\fR
را حذف کنید که در این صورت پیش‌فرض آن
\fBHEAD\fR
خواهد بود\&.
.RE
.PP
\fI<new\-branch>\fR
.RS 4
نام شاخه جدید\&.
.RE
.PP
\fI<start\-point>\fR
.RS 4
نام کامیتی که شاخه جدید از آنجا آغاز می‌شود؛ برای جزئیات به
\fBgit-branch\fR(1)
مراجعه فرمایید\&. پیش‌فرض آن
\fBHEAD\fR
است\&.
.sp
به عنوان یک حالت خاص، می‌توانید از
\fI<rev\-a>\fR\fB\&.\&.\&.\fR\fI<rev\-b>\fR
به عنوان میان‌بری برای پایه ادغام (merge base) میان
\fI<rev\-a>\fR
و
\fI<rev\-b>\fR
در صورتی که دقیقاً یک پایه ادغام وجود داشته باشد استفاده کنید\&. شما می‌توانید حداکثر یکی از
\fI<rev\-a>\fR
و
\fI<rev\-b>\fR
را حذف کنید که در این صورت پیش‌فرض آن
\fBHEAD\fR
خواهد بود\&.
.RE
.PP
\fI<tree\-ish>\fR
.RS 4
درختی که دریافت از آن انجام می‌شود (زمانی که مسیرها مشخص شده باشند)\&. در صورت عدم تعیین، از ایندکس استفاده خواهد شد\&.
.sp
به عنوان یک حالت خاص، می‌توانید از
\fI<rev\-a>\fR\fB\&.\&.\&.\fR\fI<rev\-b>\fR
به عنوان میان‌بری برای پایه ادغام میان
\fI<rev\-a>\fR
و
\fI<rev\-b>\fR
در صورتی که دقیقاً یک پایه ادغام وجود داشته باشد استفاده کنید\&. شما می‌توانید حداکثر یکی از
\fI<rev\-a>\fR
و
\fI<rev\-b>\fR
را حذف کنید که در این صورت پیش‌فرض آن
\fBHEAD\fR
خواهد بود\&.
.RE
.PP
\fB\-\-\fR
.RS 4
از تفسیر آرگومان‌های بعدی به عنوان گزینه جلوگیری می‌کند\&.
.RE
.PP
\fI<pathspec>\fR\&.\&.\&.
.RS 4
مسیرهای تحت تأثیر عملیات را محدود می‌کند\&.
.sp
برای جزئیات بیشتر، به مدخل
\fIpathspec\fR
در
\fBgitglossary\fR(7)
مراجعه کنید\&.
.RE
.SH "سر جداشده (DETACHED HEAD)"
.sp
به‌طور معمول،
\fBHEAD\fR
به یک شاخه نام‌گذاری‌شده ارجاع دارد (مانند \fBmaster\fR)\&. در همین حال، هر شاخه به یک کامیت مشخص اشاره می‌کند\&. بیایید مخزنی با سه کامیت را در نظر بگیریم که روی یکی از آن‌ها برچسب خورده و شاخه \fBmaster\fR دریافت شده است:
.sp
.if n \{\
.RS 4
.\}
.nf
           HEAD (refers to branch \*(Aqmaster\*(Aq)
            |
            v
a\-\-\-b\-\-\-c  branch \*(Aqmaster\*(Aq (refers to commit \*(Aqc\*(Aq)
    ^
    |
  tag \*(Aqv2\&.0\*(Aq (refers to commit \*(Aqb\*(Aq)
.fi
.if n \{\
.RE
.\}
.sp
.sp
هنگامی که کامیتی در این وضعیت ایجاد می‌شود، شاخه به‌روزرسانی می‌شود تا به کامیت جدید اشاره کند\&. به طور دقیق‌تر،
\fBgit\fR \fBcommit\fR
یک کامیت جدید به نام \fBd\fR ایجاد می‌کند که والد آن کامیت \fBc\fR است، و سپس شاخه \fBmaster\fR را به‌روزرسانی می‌کند تا به کامیت جدید \fBd\fR اشاره کند\&. در این حالت،
\fBHEAD\fR
همچنان به شاخه \fBmaster\fR اشاره دارد و بنابراین اکنون به‌طور غیرمستقیم به کامیت \fBd\fR ارجاع می‌دهد:
.sp
.if n \{\
.RS 4
.\}
.nf
$ edit; git add; git commit

               HEAD (refers to branch \*(Aqmaster\*(Aq)
                |
                v
a\-\-\-b\-\-\-c\-\-\-d  branch \*(Aqmaster\*(Aq (refers to commit \*(Aqd\*(Aq)
    ^
    |
  tag \*(Aqv2\&.0\*(Aq (refers to commit \*(Aqb\*(Aq)
.fi
.if n \{\
.RE
.\}
.sp
.sp
گاهی اوقات مفید است که بتوانید کامیتی را دریافت کنید که در نوک (tip) هیچ شاخه نام‌گذاری‌شده‌ای قرار ندارد، یا حتی کامیت جدیدی بسازید که توسط هیچ شاخه نام‌گذاری‌شده‌ای ارجاع داده نشده باشد\&. بیایید ببینیم چه اتفاقی می‌افتد اگر کامیت \fBb\fR را دریافت کنیم (در اینجا دو روش انجام این کار نشان داده شده است):
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout v2\&.0  # or
$ git checkout master^^

   HEAD (refers to commit \*(Aqb\*(Aq)
    |
    v
a\-\-\-b\-\-\-c\-\-\-d  branch \*(Aqmaster\*(Aq (refers to commit \*(Aqd\*(Aq)
    ^
    |
  tag \*(Aqv2\&.0\*(Aq (refers to commit \*(Aqb\*(Aq)
.fi
.if n \{\
.RE
.\}
.sp
.sp
توجه داشته باشید که صرف‌نظر از اینکه از کدام دستور چک‌اوت استفاده کنیم،
\fBHEAD\fR
اکنون مستقیماً به کامیت \fBb\fR اشاره دارد\&. این وضعیت به عنوان قرار داشتن در حالت سر جداشده (\fBHEAD\fR جداشده) شناخته می‌شود\&. این حالت به سادگی به این معناست که
\fBHEAD\fR
به یک کامیت مشخص اشاره دارد، در مقابل اینکه به یک شاخه نام‌گذاری‌شده ارجاع دهد\&. بیایید ببینیم هنگام ایجاد یک کامیت چه رخ می‌دهد:
.sp
.if n \{\
.RS 4
.\}
.nf
$ edit; git add; git commit

     HEAD (refers to commit \*(Aqe\*(Aq)
      |
      v
      e
     /
a\-\-\-b\-\-\-c\-\-\-d  branch \*(Aqmaster\*(Aq (refers to commit \*(Aqd\*(Aq)
    ^
    |
  tag \*(Aqv2\&.0\*(Aq (refers to commit \*(Aqb\*(Aq)
.fi
.if n \{\
.RE
.\}
.sp
.sp
اکنون کامیت جدیدی به نام \fBe\fR وجود دارد، اما تنها توسط
\fBHEAD\fR
ارجاع داده می‌شود\&. البته می‌توانیم در این وضعیت یک کامیت دیگر نیز اضافه کنیم:
.sp
.if n \{\
.RS 4
.\}
.nf
$ edit; git add; git commit

         HEAD (refers to commit \*(Aqf\*(Aq)
          |
          v
      e\-\-\-f
     /
a\-\-\-b\-\-\-c\-\-\-d  branch \*(Aqmaster\*(Aq (refers to commit \*(Aqd\*(Aq)
    ^
    |
  tag \*(Aqv2\&.0\*(Aq (refers to commit \*(Aqb\*(Aq)
.fi
.if n \{\
.RE
.\}
.sp
.sp
در واقع، ما می‌توانیم تمام عملیات‌های معمول گیت را انجام دهیم\&. اما بیایید ببینیم وقتی شاخه \fBmaster\fR را چک‌اوت می‌کنیم چه رخ می‌دهد:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout master

               HEAD (refers to branch \*(Aqmaster\*(Aq)
      e\-\-\-f     |
     /          v
a\-\-\-b\-\-\-c\-\-\-d  branch \*(Aqmaster\*(Aq (refers to commit \*(Aqd\*(Aq)
    ^
    |
  tag \*(Aqv2\&.0\*(Aq (refers to commit \*(Aqb\*(Aq)
.fi
.if n \{\
.RE
.\}
.sp
.sp
بسیار مهم است که درک کنیم در این نقطه هیچ چیزی به کامیت \fBf\fR ارجاع ندارد\&. در نهایت کامیت \fBf\fR (و در نتیجه کامیت \fBe\fR) توسط فرآیند روتین جمع‌آوری زباله (garbage collection) در گیت حذف خواهد شد، مگر اینکه پیش از رخ دادن آن، ارجاعی به آن ایجاد نماییم\&. اگر هنوز از کامیت \fBf\fR جابه‌جا نشده‌ایم، هر یک از دستورات زیر یک ارجاع به آن ایجاد می‌کند:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout \-b foo  # or "git switch \-c foo"  \fB(1)\fR
$ git branch foo                                 \fB(2)\fR
$ git tag foo                                    \fB(3)\fR
.fi
.if n \{\
.RE
.\}
.sp
.TS
tab(:);
r lw(\n(.lu*75u/100u).
\fB1.\fR\h'-2n':T{
یک شاخه جدید به نام
\fBfoo\fR
ایجاد می‌کند که به کامیت
\fBf\fR
اشاره دارد، و سپس
\fBHEAD\fR
را به‌روزرسانی می‌کند تا به شاخه
\fBfoo\fR
ارجاع دهد\&. به عبارت دیگر، پس از این دستور دیگر در وضعیت سر جداشده (detached
\fBHEAD\fR)
نخواهیم بود\&.
T}
\fB2.\fR\h'-2n':T{
به طور مشابه یک شاخه جدید به نام
\fBfoo\fR
ایجاد می‌کند که به کامیت
\fBf\fR
اشاره دارد، اما
\fBHEAD\fR
را در وضعیت جداشده باقی می‌گذارد\&.
T}
\fB3.\fR\h'-2n':T{
یک برچسب (tag) جدید به نام
\fBfoo\fR
ایجاد می‌کند که به کامیت
\fBf\fR
اشاره دارد، و
\fBHEAD\fR
را در وضعیت جداشده باقی می‌گذارد\&.
T}
.TE
.sp
اگر از کامیت \fBf\fR دور شده باشیم، ابتدا باید نام شیء (object name) آن را بازیابی کنیم (معمولاً با استفاده از git reflog)، و سپس می‌توانیم ارجاعی به آن ایجاد نماییم\&. برای مثال، برای مشاهده دو کامیت آخری که
\fBHEAD\fR
به آن‌ها اشاره داشته است، می‌توانیم از یکی از این دستورات استفاده کنیم:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git reflog \-2 HEAD # or
$ git log \-g \-2 HEAD
.fi
.if n \{\
.RE
.\}
.sp
.SH "ابهام‌زدایی از آرگومان‌ها (ARGUMENT DISAMBIGUATION)"
.sp
هنگامی که دستور
\fBgit\fR \fBcheckout\fR \fI<something>\fR
را اجرا می‌کنید، گیت تلاش می‌کند تا حدس بزند که آیا
\fI<something>\fR
به عنوان یک شاخه، یک کامیت یا مجموعه‌ای از فایل(ها) در نظر گرفته شده است، و سپس به آن شاخه یا کامیت جابه‌جا می‌شود، یا فایل‌های مشخص‌شده را بازیابی می‌کند\&.
.sp
در صورت وجود هرگونه ابهام، گیت با
\fI<something>\fR
به عنوان یک شاخه یا کامیت رفتار می‌کند، اما می‌توانید از دو خط تیره
\fB\-\-\fR
استفاده کنید تا گیت را مجبور سازد که پارامتر را به عنوان فهرستی از فایل‌ها و/یا دایرکتوری‌ها در نظر بگیرد، مانند زیر:
.sp
.if n \{\
.RS 4
.\}
.nf
git checkout \-\- file\&.txt
.fi
.if n \{\
.RE
.\}
.sp
.SH "مثال‌ها (EXAMPLES)"
.SS "۱. مسیرها (1. Paths)"
.sp
دنباله دستورات زیر شاخه \fBmaster\fR را دریافت می‌کند، فایل \fBMakefile\fR را به دو بازبینی قبل برمی‌گرداند، فایل \fBhello\&.c\fR را به اشتباه حذف می‌کند، و آن را دوباره از ایندکس بازیابی می‌نماید\&.
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout master             \fB(1)\fR
$ git checkout master~2 Makefile  \fB(2)\fR
$ rm \-f hello\&.c
$ git checkout hello\&.c            \fB(3)\fR
.fi
.if n \{\
.RE
.\}
.sp
.TS
tab(:);
r lw(\n(.lu*75u/100u).
\fB1.\fR\h'-2n':T{
تغییر شاخه
T}
\fB2.\fR\h'-2n':T{
برداشتن یک فایل از کامیتی دیگر
T}
\fB3.\fR\h'-2n':T{
بازیابی
\fBhello\&.c\fR
از ایندکس
T}
.TE
.sp
اگر می‌خواهید \fIتمام\fR فایل‌های منبع C را از ایندکس خارج کرده و دریافت کنید، می‌توانید بنویسید:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout \-\- \*(Aq*\&.c\*(Aq
.fi
.if n \{\
.RE
.\}
.sp
.sp
به نقل‌قول‌های اطراف \fB*\&.c\fR دقت کنید\&. فایل \fBhello\&.c\fR نیز دریافت خواهد شد، حتی اگر دیگر در درخت کاری وجود نداشته باشد، زیرا الگوی انطباق فایل (globbing) برای مطابقت با ورودی‌های موجود در ایندکس استفاده می‌شود (نه در درخت کاری توسط شل)\&.
.sp
اگر شاخه‌ای با نام نامناسب \fBhello\&.c\fR داشته باشید، این مرحله با دستور تعویض به آن شاخه اشتباه گرفته می‌شود\&. در عوض باید بنویسید:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout \-\- hello\&.c
.fi
.if n \{\
.RE
.\}
.sp
.SS "۲. ادغام (2. Merge)"
.sp
پس از کار در شاخه اشتباه، تعویض به شاخه درست با دستور زیر انجام می‌شود:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout mytopic
.fi
.if n \{\
.RE
.\}
.sp
.sp
با این حال، شاخه "اشتباه" شما و شاخه درست \fBmytopic\fR ممکن است در فایل‌هایی که به صورت محلی ویرایش کرده‌اید تفاوت داشته باشند، که در این صورت دریافت بالا با خطایی مانند این مواجه خواهد شد:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout mytopic
error: You have local changes to \*(Aqfrotz\*(Aq; not switching branches\&.
.fi
.if n \{\
.RE
.\}
.sp
.sp
می‌توانید فلگ \fB\-m\fR را به دستور بدهید که تغییرات محلی شما را به شاخه جدید منتقل می‌کند:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout \-m mytopic
Applied autostash\&.
Switched to branch \*(Aqmytopic\*(Aq
The following paths have local changes:
M       frotz
.fi
.if n \{\
.RE
.\}
.sp
.sp
پس از تعویض شاخه، اصلاحات محلی مجدداً اعمال شده و در فایل ایندکس شما ثبت \fIنمی‌شوند\fR، بنابراین دستور \fBgit\fR \fBdiff\fR به شما نشان می‌دهد که از زمان نوک شاخه جدید چه تغییراتی اعمال کرده‌اید\&.
.SS "۳. تعارض در ادغام (3. Merge conflict)"
.sp
هنگامی که گزینه \fB\-\-merge\fR (\fB\-m\fR) داده می‌شود و تغییرات محلی با تغییرات شاخه‌ای که قصد تعویض به آن را داریم هم‌پوشانی داشته باشند، تغییرات در استش ذخیره شده و پس از تعویض شاخه دوباره اعمال می‌شوند\&. اگر این فرآیند به تعارض منجر شود، ورودی استش ذخیره شده و پیامی چاپ می‌شود:
.sp
.if n \{\
.RS 4
.\}
.nf
$ git checkout \-m mytopic
Your local changes are stashed, however applying them
resulted in conflicts\&.  You can either resolve the conflicts
and then discard the stash with "git stash drop", or, if you
do not want to resolve them now, run "git reset \-\-hard" and
apply the local changes later by running "git stash pop"\&.
.fi
.if n \{\
.RE
.\}
.sp
.SH "پیکربندی (CONFIGURATION)"
.sp
تمام موارد زیر این خط در این بخش به‌طور انتخابی از مستندات \fBgit-config\fR(1) گنجانده شده‌اند\&. محتوا با آنچه در آنجا آمده یکسان است:
.PP
\fBcheckout\&.defaultRemote\fR
.RS 4
هنگامی که دستور
\fBgit\fR
\fBcheckout\fR
\fI<something>\fR
یا
\fBgit\fR
\fBswitch\fR
\fI<something>\fR
را اجرا می‌کنید و تنها یک ریموت دارید، ممکن است به‌طور ضمنی به دریافت و ردیابی مواردی نظیر
\fBorigin/\fR\fI<something>\fR
بازگردد\&. این قابلیت به محض اینکه بیش از یک ریموت با مرجع
\fI<something>\fR
داشته باشید، از کار می‌افتد\&. این تنظیم امکان تعیین نام یک ریموت ارجح را فراهم می‌کند که در هنگام ابهام‌زدایی باید همیشه برنده باشد\&. مورد استفاده معمول این است که این گزینه روی
\fBorigin\fR
تنظیم شود\&.
.sp
در حال حاضر این مورد توسط
\fBgit-switch\fR(1)
و
\fBgit-checkout\fR(1)
زمانی استفاده می‌شود که
\fBgit\fR
\fBcheckout\fR
\fI<something>\fR
یا
\fBgit\fR
\fBswitch\fR
\fI<something>\fR
شاخه
\fI<something>\fR
را روی ریموت دیگری دریافت کند، و توسط
\fBgit-worktree\fR(1)
زمانی که دستور
\fBgit\fR
\fBworktree\fR
\fBadd\fR
به یک شاخه ریموت ارجاع می‌دهد\&. این تنظیم ممکن است در آینده برای سایر دستورات یا عملکردهای شبیه به چک‌اوت نیز استفاده شود\&.
.RE
.PP
\fBcheckout\&.guess\fR
.RS 4
مقدار پیش‌فرض را برای گزینه
\fB\-\-guess\fR
یا
\fB\-\-no\-guess\fR
در دستورات
\fBgit\fR
\fBcheckout\fR
و
\fBgit\fR
\fBswitch\fR
ارائه می‌دهد\&. به
\fBgit-switch\fR(1)
و
\fBgit-checkout\fR(1)
مراجعه فرمایید\&.
.RE
.PP
\fBcheckout\&.workers\fR
.RS 4
تعداد پردازش‌های موازی (workers) مورد استفاده در زمان به‌روزرسانی درخت کاری\&. پیش‌فرض برابر یک، یعنی اجرای متوالی است\&. اگر به مقداری کمتر از یک تنظیم شود، گیت به اندازه تعداد هسته‌های منطقی در دسترس از ورکرها بهره خواهد برد\&. این تنظیم و
\fBcheckout\&.thresholdForParallelism\fR
بر تمام دستوراتی که عملیات چک‌اوت را اجرا می‌کنند تأثیر می‌گذارند؛ مانند checkout، clone، reset، sparse\-checkout و غیره\&.
.if n \{\
.sp
.\}
.RS 4
.it 1 an-trap
.nr an-no-space-flag 1
.nr an-break-flag 1
.br
.ps +1
\fBنکته\fR
.ps -1
.br
دریافت موازی معمولاً کارایی بهتری برای مخازن قرارگرفته روی SSDها یا بر بستر NFS به همراه دارد\&. برای مخازن واقع در دیسک‌های چرخان (HDD) و/یا سیستم‌هایی با تعداد اندک هسته‌های پردازشی، معمولاً دریافت متوالی پیش‌فرض کارایی بهتری از خود نشان می‌دهد\&. اندازه و سطح فشرده‌سازی یک مخزن نیز ممکن است بر میزان بهینه بودن کارکرد نسخه موازی تأثیر بگذارد\&.
.sp .5v
.RE
.RE
.PP
\fBcheckout\&.thresholdForParallelism\fR
.RS 4
هنگام اجرای دریافت موازی با تعداد اندکی فایل، هزینه ایجاد زیرپردازش‌ها و ارتباط میان‌پردازشی ممکن است بر مزایای موازی‌سازی غالب شود\&. این تنظیم به شما امکان می‌دهد حداقل تعداد فایل‌هایی را تعیین کنید که برای آن‌ها دریافت موازی باید انجام شود\&. مقدار پیش‌فرض ۱۰۰ است\&.
.RE
.SH "همچنین ببینید (SEE ALSO)"
.sp
\fBgit-switch\fR(1), \fBgit-restore\fR(1)
.SH "گیت (GIT)"
.sp
بخشی از مجموعه \fBgit\fR(1)
