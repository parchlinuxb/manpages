.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
jose-b64-dec \- داده‌های Base64 سازگار با URL را به باینری رمزگشایی می‌کند
.SH "خلاصه دستور (SYNOPSIS)"
.sp
\fBjose b64 dec\fR \-i B64 [\-O BIN]
.SH "نمای کلی (OVERVIEW)"
.sp
دستور \fBjose b64 dec\fR داده‌های Base64 سازگار با URL را به فرمت باینری رمزگشایی می‌کند\&.
.SH "گزینه‌ها (OPTIONS)"
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-i\fR
\fIFILE\fR,
\fB\-\-base64\fR=\fIFILE\fR
: خواندن داده‌های Base64 (سازگار با URL) از FILE
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-i\fR
\-,
\fB\-\-base64\fR=\- : خواندن داده‌های Base64 (سازگار با URL) از ورودی استاندارد
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-O\fR
\fIFILE\fR,
\fB\-\-binary\fR=\fIFILE\fR
: نوشتن داده‌های باینری در FILE
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
\fB\-O\fR
\-,
\fB\-\-binary\fR=\- : نوشتن داده‌های باینری در خروجی استاندارد
.RE
.SH "مثال‌ها (EXAMPLES)"
.sp
رمزگشایی یک پیام ساده:
.sp
.if n \{\
.RS 4
.\}
.nf
$ echo SGVsbG8sIFdvcmxkCg | jose b64 dec \-i\-
Hello, World
.fi
.if n \{\
.RE
.\}
.SH "نویسنده (AUTHOR)"
.sp
Nathaniel McCallum <npmccallum@redhat\&.com>
.SH "همچنین ببینید (SEE ALSO)"
.sp
\fBjose\-b64\-enc\fR(1)
