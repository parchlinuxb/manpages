.if n \{\
.RE
.\}
.SS "ویژگی‌ها (Properties)"
.PP
بیشتر ویژگی‌ها مستقیماً به تنظیمات مربوطه در فایل‌های واحد مبادله نگاشت می‌شوند\&. از آنجا که واحدهای مبادله دستور
\fBswapon\fR(8)
را فراخوانی می‌کنند، اشیاء گذرگاه آن‌ها شامل فیلدهای ضمنی
\fIExecActivate\fR
(و موارد مشابه) است که حاوی اطلاعاتی دربارهٔ پردازه‌های قابل اجرا می‌باشند\&. آن‌ها همچنین بیشتر فیلدهای مربوط به بافتار اجرا را که اشیاء Service ارائه می‌دهند به اشتراک می‌گذارند (بالا را ببینید)\&. علاوه بر این ویژگی‌ها، موارد زیر نیز وجود دارند:
.PP
\fIControlPID\fR
در صورتی که دستور
\fBswapon\fR(8)
یا
\fBswapoff\fR(8)
در حال اجرا باشد، حاوی PID آن است و در غیر این صورت 0 می‌باشد\&.
.PP
\fIResult\fR
حاوی مقداری است که دلیل شکست یک واحد مبادله را در صورت شکست خوردن توضیح می‌دهد\&. این ویژگی می‌تواند مقادیر
"success"،
"resources"،
"timeout"،
"exit\-code"،
"signal" یا
"core\-dump"
را بگیرد که معنای یکسانی با مقادیر متناظر فیلد مربوطه در اشیاء واحد سرویس دارند (بالا را ببینید)\&.
.SH "اشیاء PATH UNIT (PATH UNIT OBJECTS)"
.sp
.if n \{\
.RS 4
.\}
.nf
node /org/freedesktop/systemd1/unit/cups_2epath {
  interface org\&.freedesktop\&.systemd1\&.Path {
    properties:
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly s Unit = \*(Aq\&.\&.\&.\*(Aq;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly a(ss) Paths = [\&.\&.\&.];
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly b MakeDirectory = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly u DirectoryMode = \&.\&.\&.;
      readonly s Result = \*(Aq\&.\&.\&.\*(Aq;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly t TriggerLimitIntervalUSec = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("const")
      readonly u TriggerLimitBurst = \&.\&.\&.;
  };
  interface org\&.freedesktop\&.DBus\&.Peer { \&.\&.\&. };
