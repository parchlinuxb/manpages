.I .\|.\|.
.TP
.I "234 fnt_num_63"
تنظیم
.IR "f = 63" .
.TP
.I "235 fnt1  k[1]"
تنظیم
.IR "f = k" .
.TP
.I "236 fnt2  k[2]"
تنظیم
