.\"                                      Hey, EMACS: -*- nroff -*-
.\" First parameter, NAME, should be all caps
.\" Second parameter, SECTION, should be 1-8, maybe w/ subsection
.\" other parameters are allowed: see man(7), man(1)
.TH DIRSRV 5 "26 ژوئن 2018"
.\" Please adjust this date whenever revising the manpage.
.\"
.\" Some roff macros, for reference:
.\" .nh        disable hyphenation
.\" .hy        enable hyphenation
.\" .ad l      left justify
.\" .ad b      justify to both left and right margins
.\" .nf        disable filling
.\" .fi        enable filling
.\" .br        insert line break
.\" .sp <n>    insert n+1 empty lines
.\" for manpage-specific macros, see man(7)
.SH "نام (NAME)"
dirsrv \- پروندهٔ EnvironmentFile در systemd که بر تمامی نمونه‌های سرور دایرکتوری اثر می‌گذارد

.SH "خلاصه دستور (SYNOPSIS)"
/etc/sysconfig/dirsrv

.SH "توضیحات (DESCRIPTION)"
dirsrv
.PP
این پرونده هنگام راه‌اندازی توسط dirsrv بارگذاری (source) می‌شود تا محیط پیش‌فرض را برای تمامی نمونه‌های سرور دایرکتوری (Directory Server) تنظیم کند. برای تنظیم پیش‌فرض‌های مختص یک نمونهٔ خاص، از پرونده‌ای در همان دایرکتوری به نام
.I dirsrv-instance
استفاده کنید که در آن "instance" نام نمونهٔ سرور دایرکتوری شما است؛ برای نمونه
.I dirsrv-localhost
برای نمونهٔ
.IR slapd-localhost .
.PP
این پرونده در قالب EnvironmentFile در systemd است \- صفحهٔ راهنمای
.BR systemd.exec (5)
را ببینید.

.SH "مثال (EXAMPLE)"
LD_PRELOAD=/usr/lib64/dirsrv/lib/libjemalloc.so.2

.SH "نویسنده (AUTHOR)"
dirsrv توسط پروژهٔ ۳۸۹ (389 Project) نوشته شده است.
.SH "گزارش باگ‌ها (REPORTING BUGS)"
گزارش باگ‌ها به https://github.com/389ds/389-ds-base/issues/new
