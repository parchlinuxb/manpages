.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
"lock\-cwnd"
\- یک مقدار بولی\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
"lock\-initcwnd"
\- یک مقدار بولی\&.
.RE
.sp
.RS 4
.ie n \{\
