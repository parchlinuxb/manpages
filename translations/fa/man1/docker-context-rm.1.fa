.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-context-rm \- حذف یک یا چند بافت (context)


.SH "خلاصه (SYNOPSIS)"
\fBdocker context rm CONTEXT [CONTEXT...]\fP


.SH "شرح (DESCRIPTION)"
حذف یک یا چند بافت (context)


.SH "گزینه‌ها (OPTIONS)"
\fB-f\fP, \fB--force\fP[=false]
	اجبار در حذف یک بافت در حال استفاده


.SH "ببینید (SEE ALSO)"
\fBdocker-context(1)\fP
