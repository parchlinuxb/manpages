.SH "نام (NAME)"
kubeone-addons-list \- فهرست کردن افزونه‌های تعبیه‌شده در KubeOne


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubeone addons list [flags]\fP


.SH "توضیحات (DESCRIPTION)"
فهرست کردن افزونه‌های تعبیه‌شده در KubeOne


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	نمایش راهنمای دستور list

.PP
\fB-o\fP, \fB--output\fP="table"
	قالب خروجی (table|json).


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB-c\fP, \fB--credentials\fP=""
	فایل منبع اطلاعات هویتی و اسرار (secrets)

.PP
\fB-d\fP, \fB--debug\fP[=false]
	خروجی اشکال‌زدایی همراه با ردگیری پشته (stacktrace)

.PP
\fB-l\fP, \fB--log-format\fP="text"
	قالب ثبت گزارش (logging)

.PP
\fB-m\fP, \fB--manifest\fP="./kubeone.yaml"
	مسیر فایل پیکربندی KubeOne

.PP
\fB-t\fP, \fB--tfjson\fP=""
	منبع خروجی ترافورم در قالب JSON \- برای خواندن از ورودی استاندارد (stdin). اگر مسیر یک فایل باشد، محتوای آن استفاده می‌شود. اگر مسیر یک دایرکتوری باشد، دستور \fBterraform output -json\fR در این مسیر اجرا خواهد شد

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	خروجی با جزئیات بیشتر


.SH "مثال (EXAMPLE)"
.EX
kubeone -m mycluster.yaml -t terraformoutput.json addons list
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubeone-addons(1)\fP


