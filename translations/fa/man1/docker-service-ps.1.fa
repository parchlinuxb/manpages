.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-service-ps \- فهرست کردن وظایف یک یا چند سرویس


.SH "خلاصه (SYNOPSIS)"
\fBdocker service ps [OPTIONS] SERVICE [SERVICE...]\fP


.SH "شرح (DESCRIPTION)"
فهرست کردن وظایف یک یا چند سرویس


.SH "گزینه‌ها (OPTIONS)"
\fB-f\fP, \fB--filter\fP=
	فیلتر کردن خروجی بر اساس شرایط ارائه‌شده

.PP
\fB--format\fP=""
	چاپ آراسته وظایف با استفاده از یک الگوی Go

.PP
\fB--no-resolve\fP[=false]
	عدم نگاشت شناسه‌ها (IDs) به نام‌ها

.PP
\fB--no-trunc\fP[=false]
	عدم کوتاه کردن خروجی

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	تنها نمایش شناسه‌های وظیفه


.SH "ببینید (SEE ALSO)"
\fBdocker-service(1)\fP
