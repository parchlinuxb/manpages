.TH "UPTERM" "1" "May 2026" "Upterm 0.0.0+dev" "Upterm Manual"

.SH "نام (NAME)"
upterm-session-list \- List shared sessions


.SH "خلاصه دستور (SYNOPSIS)"
\fBupterm session list [flags]\fP


.SH "توضیحات (DESCRIPTION)"
List shared sessions.

.PP
Sockets are stored in: /build/.upterm

.PP
Follows the XDG Base Directory Specification with fallback to $HOME/.upterm
in constrained environments where XDG directories are unavailable.


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	help for list


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	enable debug level logging (log file: /build/.upterm/upterm.log).


.SH "مثال (EXAMPLE)"
.EX
  # List shared sessions:
  upterm session list
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBupterm-session(1)\fP


