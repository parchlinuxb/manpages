.\" Start URL macro. Copied from an-ext.tmac for portability
.de UR
.  ds m1 \\$1\"
.  nh
.  if \\n(mH \{\
.    \" Start diversion in a new environment.
.    do ev URL-div
.    do di URL-div
.  \}
..
.\" End URL macro. Copied from an-ext.tmac for portability
.de UE
.  ie \\n(mH \{\
.    br
.    di
.    ev
.
.    \" Has there been one or more input lines for the link text?
.    ie \\n(dn \{\
.      do HTML-NS "<a href=""\\*(m1"">"
.      \" Yes, strip off final newline of diversion and emit it.
.      do chop URL-div
.      do URL-div
\c
.      do HTML-NS </a>
.    \}
.    el \
.      do HTML-NS "<a href=""\\*(m1"">\\*(m1</a>"
\&\\$*\"
.  \}
.  el \
\\*(la\\*(m1\\*(ra\\$*\"
.
.  hy \\n(HY
..
.TH ZABBIX_AGENT2 8 "2022\-01\-06" Zabbix
.SH "نام (NAME)"
zabbix_agent2 \- عامل نسل دوم پایش زبیکس
.SH "خلاصه دستور (SYNOPSIS)"
.B zabbix_agent2
.RB [ \-c
.IR config\-file ]
.br
.B zabbix_agent2
.RB [ \-c
.IR config\-file ]
.RB [ \-v ]
.B \-p
.br
.B zabbix_agent2
.RB [ \-c
.IR config\-file ]
.RB [ \-v ]
.B \-t
.I item\-key
.br
.B zabbix_agent2
.RB [ \-c
.IR config\-file ]
.B \-R
.I runtime\-option
.br
.B zabbix_agent2
.RB [ \-c
.IR config\-file ]
.B \-T
.br
.B zabbix_agent2 \-h
.br
.B zabbix_agent2 \-V
.SH "توضیحات (DESCRIPTION)"
.B zabbix_agent2
برنامه‌ای برای پایش پارامترها و شاخص‌های کارکرد سرویس‌های گوناگون در شبکه است.
.SH "گزینه‌ها (OPTIONS)"
.IP "\fB\-c\fR, \fB\-\-config\fR \fIconfig\-file\fR"
استفاده از فایل پیکربندی جایگزین \fIconfig\-file\fR به‌جای فایل پیش‌فرض.
.IP "\fB\-R\fR, \fB\-\-runtime\-control\fR \fIruntime\-option\fR"
انجام عملکردهای مدیریتی متناسب با گزینه زمان اجرای \fIruntime\-option\fR.
.SS
.RS 4
گزینه‌های کنترل زمان اجرا:
.RS 4
.TP 4
\fBuserparameter_reload\fR
بارگذاری مجدد پارامترهای کاربری از فایل پیکربندی
.RE
.RS 4
.TP 4
\fBlog_level_increase\fR
افزایش سطح گزارش‌گیری (لاگ)
.RE
.RS 4
.TP 4
\fBlog_level_decrease\fR
کاهش سطح گزارش‌گیری (لاگ)
.RE
.RS 4
.TP 4
\fBhelp\fR
فهرست کردن گزینه‌های دردسترس برای کنترل زمان اجرا
.RE
.RS 4
.TP 4
\fBmetrics\fR
فهرست کردن شاخص‌ها و معیارهای موجود
.RE
.RS 4
.TP 4
\fBversion\fR
نمایش نسخه برنامه
.RE
.RE
.IP "\fB\-p\fR, \fB\-\-print\fR"
چاپ آیتم‌های شناخته‌شده و خروج.
برای هر آیتم یا مقادیر پیش‌فرض عمومی استفاده می‌شود یا مقادیر پیش‌فرض مشخصی برای آزمایش ارائه می‌گردد.
این مقادیر پیش‌فرض داخل براکت به عنوان پارامترهای کلید آیتم فهرست شده‌اند.
مقادیر بازگشتی درون براکت قرار گرفته و نوع مقدار بازگشتی با نویسه پایپ (|) از آن جدا شده و در ابتدای آن می‌آید.
برای پارامترهای کاربری، نوع مقدار همیشه \fBt\fR است؛ زیرا عامل نمی‌تواند تمام مقادیر بازگشتی ممکن را تشخیص دهد.
تضمینی وجود ندارد آیتم‌هایی که در اینجا فعال نمایش داده می‌شوند، هنگام استعلام از طریق سرور زبیکس یا zabbix_get از دیمن عامل در حال اجرا نیز کار کنند؛ زیرا ممکن است دسترسی‌ها یا متغیرهای محیطی متفاوت باشند.
انواع مقادیر بازگشتی عبارتند از:
.RS 4
.TP 4
d
عدد دارای بخش اعشاری.
.RE
.RS 4
.TP 4
m
پشتیبانی‌نشده.
این حالت می‌تواند به دلیل استعلام آیتمی باشد که تنها در حالت فعال (Active) کار می‌کند، مانند آیتم پایش لاگ یا آیتمی که نیازمند چندین مقدار جمع‌آوری‌شده است.
مشکلات دسترسی یا پارامترهای کاربری نادرست نیز می‌توانند منجر به وضعیت پشتیبانی‌نشده شوند.
.RE
.RS 4
.TP 4
s
متن.
حداکثر طول محدود نشده است.
.RE
.RS 4
.TP 4
t
متن.
مشابه \fBs\fR.
.RE
.RS 4
.TP 4
u
عدد صحیح بدون علامت.
.RE
.IP "\fB\-t\fR, \fB\-\-test\fR \fIitem\-key\fR"
آزمایش یک آیتم منفرد و خروج.
برای توضیحات مربوط به ساختار خروجی، بخش \fB\-\-print\fR را مشاهده کنید.
.IP "\fB\-v\fR, \fB\-\-verbose\fR"
فعال کردن خروجی پرجزئیات هنگام آزمایش آیتم یا چاپ آیتم‌های شناخته‌شده.
.IP "\fB\-T\fR, \fB\-\-test-config\fR"
اعتبارسنجی فایل پیکربندی و خروج.
.IP "\fB\-h\fR, \fB\-\-help\fR"
نمایش این راهنما و خروج.
.IP "\fB\-V\fR, \fB\-\-version\fR"
نمایش اطلاعات نسخه و خروج.
.SH "فایل‌ها (FILES)"
.TP
.I /usr/local/etc/zabbix_agent2.conf
مسیر پیش‌فرض فایل پیکربندی عامل زبیکس ۲ (چنانچه در زمان کامپایل تغییر نکرده باشد).
.SH "همچنین ببینید (SEE ALSO)"
.UR https://www.zabbix.com/manuals
مستندات
.UE
.PP
.BR zabbix_agentd (8),
.BR zabbix_get (1),
.BR zabbix_proxy (8),
.BR zabbix_sender (1),
.BR zabbix_server (8),
.BR zabbix_js (1),
.BR zabbix_web_service (8)
