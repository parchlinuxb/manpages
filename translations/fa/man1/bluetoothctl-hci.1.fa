.TH "bluetoothctl-hci" "1" "December 2024" "BlueZ" "Linux System Administration"
.SH "نام (NAME)"
bluetoothctl-hci \- زیرمنوی واسط کنترل‌کننده میزبان (HCI)
.SH "خلاصه دستور (SYNOPSIS)"
.sp
\fBbluetoothctl\fP [\-\-options] [hci.commands]
.sp
\fBنکته:\fP
.INDENT 0.0
.INDENT 3.5
این زیرمنو مستقیماً از طریق سوکت HCI با کنترل‌کننده بلوتوث ارتباط برقرار می‌کند و API واسط D\-Bus بلوتوث BlueZ را دور می‌زند. دستورات از پروتکل Host Controller Interface (HCI) استفاده می‌کنند.
.UNINDENT
.UNINDENT
.SH "دستورات (COMMANDS)"
.SS open
.sp
باز کردن کانال HCI.
.INDENT 0.0
.TP
.B نحوه استفاده (Usage)
\fB> open <index> <chan=raw,user>\fP
.TP
.B index
شماره نمایه کنترل‌کننده HCI (مانند 0, 1, 2)
.TP
.B chan
نوع کانال (raw یا user)
.TP
.B مثال باز کردن کانال user (کنترل‌کننده ابتدا باید خاموش شود)
.nf
\fB> power off\fP
\fB> hci.open 0 user\fP
\fBHCI index 0 user channel opened\fP
.fi
.sp
.TP
.B مثال باز کردن کانال user برای کنترل‌کننده HCI شماره 0
.nf
\fB> hci.open 0 user\fP
.fi
.sp
.TP
.B مثال باز کردن کانال user برای کنترل‌کننده HCI شماره 1
.nf
\fB> hci.open 1 user\fP
.fi
.sp
.TP
.B مثال باز کردن کانال user برای کنترل‌کننده HCI شماره 2
.nf
\fB> hci.open 2 user\fP
.fi
.sp
.TP
.B مثال باز کردن کانال raw برای کنترل‌کننده HCI شماره 0
.nf
\fB> hci.open 0 raw\fP
.fi
.sp
.TP
.B مثال باز کردن کانال raw برای کنترل‌کننده HCI شماره 1
.nf
\fB> hci.open 1 raw\fP
.fi
.sp
.UNINDENT
.SS cmd
.sp
ارسال دستور HCI.
.INDENT 0.0
.TP
.B نحوه استفاده (Usage)
\fB> cmd <opcode> [parameters...]\fP
.TP
.B opcode
کد عملیاتی دستور HCI در قالب هگزادسیمال (مانند 0x0c03)
.TP
.B parameters
پارامترهای اختیاری دستور به عنوان بایت‌های هگزادسیمال
.TP
.B مثال ارسال دستور بازنشانی HCI (HCI Reset)
.nf
\fB> hci.cmd 0x0c03\fP
\fBHCI Command complete:\fP
\fB00\fP
.fi
.sp
.TP
.B مثال ارسال دستور بازنشانی HCI (بدون پارامتر)
.nf
\fB> hci.cmd 0x0c03\fP
.fi
.sp
.TP
.B مثال ارسال دستور خواندن اطلاعات نسخه محلی HCI (Read Local Version Information)
.nf
\fB> hci.cmd 0x1003\fP
.fi
.sp
.TP
.B مثال ارسال دستور خواندن نشانی فیزیکی بلوتوث (Read BD Address)
.nf
\fB> hci.cmd 0x1009\fP
.fi
.sp
.TP
.B مثال ارسال دستور تنظیم فیلتر رویداد با پارامتر 0x01
.nf
\fB> hci.cmd 0x0c01 0x01\fP
.fi
.sp
.TP
.B مثال ارسال دستور تنظیم پارامترهای تبلیغاتی LE با دو پارامتر
.nf
\fB> hci.cmd 0x200f 0x00 0x08\fP
.fi
.sp
.TP
.B مثال ارسال دستور تنظیم داده‌های تبلیغاتی LE با طول و بایت‌های داده
.nf
\fB> hci.cmd 0x2008 0x20 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08\fP
.fi
.sp
.TP
.B مثال ارسال دستور تنظیم ماسک رویداد HCI
.nf
\fB> hci.cmd 0x0c05 0x02\fP
.fi
.sp
.TP
.B مثال ارسال دستور فعال‌سازی پویش HCI (Write Scan Enable)
.nf
\fB> hci.cmd 0x0c2a 0x01\fP
.fi
.sp
.TP
.B مثال ارسال دستور نوشتن کلاس دستگاه HCI (Write Class of Device)
.nf
\fB> hci.cmd 0x0c23 0x00 0x08\fP
.fi
.sp
.UNINDENT
.SS send
.sp
ارسال بسته داده HCI.
.INDENT 0.0
.TP
.B نحوه استفاده (Usage)
\fB> send <type=acl,sco,iso> <handle> [data...]\fP
.TP
.B type
نوع بسته (acl, sco یا iso)
.TP
.B handle
دستگیره اتصال (Connection handle) در قالب هگزادسیمال (مانند 0x0000)
.TP
.B data
بایت‌های داده اختیاری در قالب هگزادسیمال
.TP
.B مثال ارسال بسته داده ACL به دستگیره اتصال 0x0000
.nf
\fB> hci.send acl 0x0000\fP
.fi
.sp
.TP
.B مثال ارسال بسته خالی ACL به دستگیره 0x0000
.nf
\fB> hci.send acl 0x0000\fP
.fi
.sp
.TP
.B مثال ارسال بسته ACL همراه با داده "Hello" به دستگیره 0x0001
.nf
\fB> hci.send acl 0x0001 0x48 0x65 0x6c 0x6c 0x6f\fP
.fi
.sp
.TP
.B مثال ارسال بسته ACL همراه با داده‌های سفارشی به دستگیره 0x0010
.nf
\fB> hci.send acl 0x0010 0x01 0x02 0x03 0x04\fP
.fi
.sp
.TP
.B مثال ارسال بسته خالی SCO به دستگیره 0x0000
.nf
\fB> hci.send sco 0x0000\fP
.fi
.sp
.TP
.B مثال ارسال بسته SCO همراه با داده صوتی
.nf
\fB> hci.send sco 0x0001 0xaa 0xbb 0xcc\fP
.fi
.sp
.TP
.B مثال ارسال بسته SCO همراه با الگوی موج سینوسی
.nf
\fB> hci.send sco 0x0002 0x80 0x00 0x80 0x00\fP
.fi
.sp
.TP
.B مثال ارسال بسته خالی ISO به دستگیره 0x0000
.nf
\fB> hci.send iso 0x0000\fP
.fi
.sp
.TP
.B مثال ارسال بسته ISO همراه با نمونه داده
.nf
\fB> hci.send iso 0x0001 0x12 0x34 0x56 0x78\fP
.fi
.sp
.TP
.B مثال ارسال بسته ISO برای جریان صوتی کم‌مصرف (LE Audio stream)
.nf
\fB> hci.send iso 0x0020 0xa0 0xa1 0xa2 0xa3\fP
.fi
.sp
.UNINDENT
.SS register
.sp
ثبت گرداننده رویداد HCI (Event Handler).
.INDENT 0.0
.TP
.B نحوه استفاده (Usage)
\fB> register <event>\fP
.TP
.B event
کد رویداد HCI در قالب هگزادسیمال (مانند 0x0e)
.TP
.B مثال ثبت گرداننده برای رویداد Command Complete
.nf
\fB> register 0x0e\fP
.fi
.sp
.TP
.B مثال ثبت گرداننده برای رویداد Command Status
.nf
\fB> register 0x0f\fP
.fi
.sp
.TP
.B مثال ثبت گرداننده برای رویداد Connection Complete
.nf
\fB> register 0x03\fP
.fi
.sp
.TP
.B مثال ثبت گرداننده برای رویداد Disconnection Complete
.nf
\fB> register 0x05\fP
.fi
.sp
.TP
.B مثال ثبت گرداننده برای رویدادهای LE Meta
.nf
\fB> register 0x3e\fP
.fi
.sp
.TP
.B مثال ثبت گرداننده برای رویداد Inquiry Complete
.nf
\fB> register 0x02\fP
.fi
.sp
.TP
.B مثال ثبت گرداننده برای رویداد Role Change
.nf
\fB> register 0x22\fP
.fi
.sp
.UNINDENT
.SS unregister
.sp
لغو ثبت گرداننده رویداد HCI.
.INDENT 0.0
.TP
.B نحوه استفاده (Usage)
\fB> unregister <event>\fP
.TP
.B event
کد رویداد HCI در قالب هگزادسیمال (مانند 0x0e)
.TP
.B مثال لغو ثبت گرداننده رویداد Command Complete
.nf
\fB> unregister 0x0e\fP
.fi
.sp
.TP
.B مثال لغو ثبت گرداننده رویداد Command Status
.nf
\fB> unregister 0x0f\fP
.fi
.sp
.TP
.B مثال لغو ثبت گرداننده رویداد Connection Complete
.nf
\fB> unregister 0x03\fP
.fi
.sp
.TP
.B مثال لغو ثبت گرداننده رویداد Disconnection Complete
.nf
\fB> unregister 0x05\fP
.fi
.sp
.TP
.B مثال لغو ثبت گرداننده رویداد LE Meta
.nf
\fB> unregister 0x3e\fP
.fi
.sp
.UNINDENT
.SS close
.sp
بستن کانال HCI.
.sp
کانال HCI در حال حاضر باز را می‌بندد.
.INDENT 0.0
.TP
.B نحوه استفاده (Usage)
\fB> close\fP
.TP
.B مثال بستن کانال HCI جاری
.nf
\fB> close\fP
.fi
.sp
.UNINDENT
