.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-plugin-enable \- فعال‌سازی یک افزونه


.SH "خلاصه (SYNOPSIS)"
\fBdocker plugin enable [OPTIONS] PLUGIN\fP


.SH "شرح (DESCRIPTION)"
فعال‌سازی یک افزونه


.SH "گزینه‌ها (OPTIONS)"
\fB--timeout\fP=30
	مدت زمان انتظار کلاینت HTTP (به ثانیه)


.SH "ببینید (SEE ALSO)"
\fBdocker-plugin(1)\fP
