.\"  Language: Persian
.\"
.TH "FIREWALLD\&.ZONE" "5" "" "firewalld 2.5.1" "firewalld.zone"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
firewalld.zone \- پرونده‌های پیکربندی ناحیه firewalld
.SH "خلاصه دستور (SYNOPSIS)"
.PP
\fI/etc/firewalld/zones/zone\&.xml\fR
.PP
\fI/usr/lib/firewalld/zones/zone\&.xml\fR
.SH "توضیحات (DESCRIPTION)"
.PP
یک پرونده پیکربندی ناحیه firewalld حاوی اطلاعات مربوط به یک ناحیه است\&. این اطلاعات شامل توضیحات ناحیه، سرویس‌ها، پورت‌ها، پروتکل‌ها، مسدودسازی‌های icmp، تغییر نشانی (masquerade)، پورت‌های فوروارد (forward\-ports)، فوروارد درون‌ناحیه‌ای و قوانین زبان پیشرفته در قالب یک پرونده XML است\&. نام پرونده باید به‌صورت
\fIzone_name\fR\&.xml
باشد که در آن طول
\fIzone_name\fR
در حال حاضر به ۱۷ نویسه محدود شده است\&.
.PP
این ساختار یک پرونده پیکربندی ناحیه است:
.sp
.if n \{\
.RS 4
.\}
.nf
<?xml version="1\&.0" encoding="utf\-8"?>
<zone [version="\fIversionstring\fR"] [target="\fIACCEPT\fR|\fI%%REJECT%%\fR|\fIDROP\fR"] [ingress\-priority="\fIpriority\fR"] [egress\-priority="\fIpriority\fR"]>
    [ <interface name="\fIstring\fR"/> ]
    [ <source address="\fIaddress\fR[/\fImask\fR]"|mac="\fIMAC\fR"|ipset="\fIipset\fR"/> ]
    [ <icmp\-block\-inversion/> ]
    [ <forward/> ]





    [ <short>\fIshort description\fR</short> ]
    [ <description>\fIdescription\fR</description> ]
    [ <service name="\fIstring\fR"/> ]
    [ <port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"/> ]
    [ <protocol value="\fIprotocol\fR"/> ]
    [ <icmp\-block name="\fIstring\fR"/> ]
    [ <masquerade/> ]
    [ <forward\-port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR" [to\-port="\fIportid\fR[\-\fIportid\fR]"] [to\-addr="\fIIP address\fR"]/> ]
    [ <source\-port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"/> ]
    [
        <rule [family="\fIipv4\fR|\fIipv6\fR"] [priority="\fIpriority\fR"]>
            [ <source address="\fIaddress\fR[/\fImask\fR]"|mac="\fIMAC\fR"|ipset="\fIipset\fR" [invert="\fITrue\fR"]/> ]
            [ <destination address="\fIaddress\fR[/\fImask\fR]"|ipset="\fIipset\fR" [invert="\fITrue\fR"]/> ]
            [
                <service name="\fIstring\fR"/> |
                <port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"/> |
                <protocol value="\fIprotocol\fR"/> |
                <icmp\-block name="\fIicmptype\fR"/> |
                <icmp\-type name="\fIicmptype\fR"/> |
                <masquerade/> |
                <forward\-port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR" [to\-port="\fIportid\fR[\-\fIportid\fR]"] [to\-addr="\fIaddress\fR"]/>
            ]
            [
                <log [prefix="\fIprefix text\fR"] [level="\fIemerg\fR|\fIalert\fR|\fIcrit\fR|\fIerr\fR|\fIwarn\fR|\fInotice\fR|\fIinfo\fR|\fIdebug\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </log> |
                <nflog [group="\fIgroup id\fR"] [prefix="\fIprefix text\fR"] [queue\-size="\fIthreshold\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </nflog>
            ]
            [ <audit> [<limit value="\fIrate\fR/\fIduration\fR"/>] </audit> ]
            [
                <accept> [<limit value="\fIrate\fR/\fIduration\fR"/>] </accept> |
                <reject [type="\fIrejecttype\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </reject> |
                <drop> [<limit value="\fIrate\fR/\fIduration\fR"/>] </drop> |
                <mark set="\fImark\fR[/\fImask\fR]"> [<limit value="\fIrate\fR/\fIduration\fR"/>] </mark>
            ]
        </rule>
    ]


</zone>

.fi
.if n \{\
.RE
.\}
.PP
پیکربندی می‌تواند شامل این برچسب‌ها و مشخصه‌ها باشد\&. برخی از آن‌ها اجباری و برخی دیگر اختیاری هستند\&.
.SS "zone"
.PP
برچسب اجباری آغاز و پایان zone، ناحیه را تعریف می‌کند\&. این برچسب تنها یک‌بار می‌تواند در یک پرونده پیکربندی ناحیه استفاده شود\&. مشخصه‌های اختیاری برای ناحیه‌ها وجود دارند:
.PP
version="\fIstring\fR"
.RS 4
برای اختصاص دادن یک نسخه به ناحیه\&.
.RE
.PP
target="\fIACCEPT\fR|\fI%%REJECT%%\fR|\fIDROP\fR"
.RS 4
می‌تواند برای پذیرش (accept)، رد کردن (reject) یا انداختن (drop) هر بسته‌ای که با هیچ قانونی (پورت، سرویس و غیره) تطابق ندارد استفاده شود\&.
.sp
مقدار
\fIACCEPT\fR
خاص است: بسته‌هایی که مقصد آن‌ها میزبان نیست، صرف‌نظر از تنظیم
forward
ناحیه یا هر سیاستی که به ناحیه متصل است، به مقصدشان فوروارد خواهند شد\&.
.sp
در صورت عدم تعیین، رفتار پیش‌فرض اعمال می‌شود: ICMP پذیرفته خواهد شد و هر چیز دیگری رد (reject) می‌شود\&.
.RE
.PP
ingress\-priority="\fIpriority\fR"
.RS 4
اولویت ورودی (ingress) برای دسته‌بندی ترافیک به یک ناحیه\&. ناحیه‌ای با اولویت عددی کمتر، زودتر از ناحیه‌ای با اولویت عددی بیشتر بررسی خواهد شد\&. این ویژگی امکان سفارشی‌سازی ترتیب پردازش ناحیه‌ها را فراهم می‌کند\&.
.RE
.PP
egress\-priority="\fIpriority\fR"
.RS 4
مشابه ingress\-priority، اما برای دسته‌بندی ترافیک خروجی (egress)\&.
.RE
.SS "interface"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار استفاده شود\&. می‌توان از آن برای پیوند دادن یک رابط به یک ناحیه استفاده کرد\&. برای رابط‌هایی که با NetworkManager مدیریت می‌شوند نیازی به این برچسب ندارید، زیرا NetworkManager رابط‌ها را به‌طور خودکار به ناحیه‌ها پیوند می‌دهد\&. همچنین بخش «چگونه ناحیه را برای یک اتصال تنظیم یا تغییر دهیم؟» را در
\fBfirewalld.zones\fR(5)
ببینید\&. می‌توانید از آن به‌عنوان مکانیزم جایگزین (fallback) برای رابط‌هایی که از طریق NetworkManager قابل مدیریت نیستند استفاده کنید\&. هر ورودی رابط دقیقاً یک مشخصه دارد:
.PP
name="\fIstring\fR"
.RS 4
نام رابطی که باید به ناحیه پیوند داده شود\&.
.RE
.SS "source"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار استفاده شود\&. می‌توان از آن برای پیوند دادن یک نشانی مبدأ، محدوده نشانی، یک نشانی MAC یا یک ipset به یک ناحیه استفاده کرد\&. یک ورودی source دقیقاً یکی از این مشخصه‌ها را دارد:
.PP
address="\fIaddress\fR[/\fImask\fR]"
.RS 4
مبدأ یا یک نشانی IP یا یک نشانی IP شبکه همراه با ماسک برای IPv4 یا IPv6 است\&. خانواده شبکه (IPv4/IPv6) به‌طور خودکار شناسایی خواهد شد\&. برای IPv4، ماسک می‌تواند یک ماسک شبکه یا یک عدد ساده باشد\&. برای IPv6 ماسک یک عدد ساده است\&. استفاده از نام‌های میزبان پشتیبانی نمی‌شود\&.
.RE
.PP
mac="\fIMAC\fR"
.RS 4
مبدأ یک نشانی MAC است\&. باید به شکل XX:XX:XX:XX:XX:XX باشد\&.
.RE
.PP
ipset="\fIipset\fR"
.RS 4
مبدأ یک ipset است\&.
.RE
.SS "icmp\-block\-inversion"
.PP
یک برچسب عنصر خالی اختیاری است و تنها یک‌بار در پیکربندی یک ناحیه می‌تواند استفاده شود\&. این فلگ نحوه مدیریت مسدودسازی icmp را معکوس می‌کند\&. تنها انواع فعال‌شده ICMP پذیرفته می‌شوند و تمام انواع دیگر در ناحیه رد خواهند شد\&.
.SS "forward"
.PP
یک برچسب عنصر خالی اختیاری است و تنها یک‌بار در پیکربندی یک ناحیه می‌تواند استفاده شود\&. این فلگ فوروارد درون‌ناحیه‌ای را فعال می‌کند\&. در صورت فعال بودن، بسته‌ها بین رابط‌ها یا مبداهای درون یک ناحیه فوروارد خواهند شد، حتی اگر هدف (target) ناحیه بر روی
\fIACCEPT\fR
تنظیم نشده باشد\&.
.SS "short"
.PP
یک برچسب آغاز و پایان اختیاری است و برای ارائه یک نام خواناتر استفاده می‌شود\&.
.SS "description"
.PP
یک برچسب آغاز و پایان اختیاری برای درج توضیحات است\&.
.SS "service"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای فعال‌سازی بیش از یک ورودی سرویس استفاده شود\&. یک ورودی service دقیقاً یک مشخصه دارد:
.PP
name="\fIstring\fR"
.RS 4
نام سرویسی که باید فعال شود\&. برای دریافت فهرستی از نام‌های معتبر سرویس‌ها می‌توان از دستور
\fBfirewall\-cmd \-\-get\-services\fR
استفاده کرد\&.
.RE
.SS "port"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک ورودی پورت استفاده شود\&. تمام مشخصه‌های یک ورودی پورت اجباری هستند:
.PP
port="\fIportid\fR[\-\fIportid\fR]"
.RS 4
پورت می‌تواند یک شماره پورت منفرد
\fIportid\fR
یا یک محدوده پورت
\fIportid\fR\-\fIportid\fR
باشد\&.
.RE
.PP
protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"
.RS 4
پروتکل می‌تواند یکی از موارد
\fItcp\fR،
\fIudp\fR،
\fIsctp\fR
یا
\fIdccp\fR
باشد\&.
.RE
.SS "protocol"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک ورودی پروتکل استفاده شود\&. هر ورودی protocol دقیقاً یک مشخصه دارد:
.PP
value="\fIstring\fR"
.RS 4
پروتکل می‌تواند هر پروتکلی باشد که توسط سیستم پشتیبانی می‌شود\&. لطفاً برای مشاهده پروتکل‌های پشتیبانی‌شده به
\fI/etc/protocols\fR
نگاهی بیندازید\&.
.RE
.SS "icmp\-block"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک ورودی icmp\-block استفاده شود\&. هر برچسب icmp\-block دقیقاً یک مشخصه اجباری دارد:
.PP
name="\fIstring\fR"
.RS 4
نام نوع پروتکل پیام کنترل اینترنت (ICMP) که باید مسدود شود\&. برای دریافت فهرستی از انواع معتبر ICMP می‌توان از دستور
\fBfirewall\-cmd \-\-get\-icmptypes\fR
استفاده کرد\&.
.RE
.SS "masquerade"
.PP
یک برچسب عنصر خالی اختیاری است\&. تنها یک‌بار می‌تواند استفاده شود\&. در صورت وجود، تغییر نشانی یا مسکریدینگ (masquerading) فعال می‌شود\&.
.SS "forward\-port"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک ورودی فوروارد پورت یا بسته استفاده شود\&. مشخصه‌های اجباری و همچنین اختیاری برای پورت‌های فوروارد وجود دارد:
.sp
.it 1 an-trap
.nr an-no-space-flag 1
.nr an-break-flag 1
.br
.ps +1
\fBمشخصه‌های اجباری:\fR
.RS 4
.PP
پورت محلی و پروتکلی که باید فوروارد شود\&.
.PP
port="\fIportid\fR[\-\fIportid\fR]"
.RS 4
پورت می‌تواند یک شماره پورت منفرد
\fIportid\fR
یا یک محدوده پورت
\fIportid\fR\-\fIportid\fR
باشد\&.
.RE
.PP
protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"
.RS 4
پروتکل می‌تواند یکی از موارد
\fItcp\fR،
\fIudp\fR،
\fIsctp\fR
یا
\fIdccp\fR
باشد\&.
.RE
.RE
.sp
.it 1 an-trap
.nr an-no-space-flag 1
.nr an-break-flag 1
.br
.ps +1
\fBمشخصه‌های اختیاری:\fR
.RS 4
.PP
مقصد فوروارد\&. برای فوروارد محلی تنها
\fBto\-port\fR
را اضافه کنید\&. برای فوروارد راه دور
\fBto\-addr\fR
را اضافه کنید و در صورتی که پورت مقصد در دستگاه مقصد متفاوت باشد، می‌توانید به‌صورت اختیاری از
\fBto\-port\fR
استفاده کنید\&.
.PP
to\-port="\fIportid\fR[\-\fIportid\fR]"
.RS 4
پورت مقصد یا محدوده پورتی که باید به آن فوروارد شود\&. در صورت حذف، مقدار مشخصه port= همراه با مشخصه to\-addr استفاده خواهد شد\&.
.RE
.PP
to\-addr="\fIaddress\fR"
.RS 4
نشانی IP مقصد برای IPv4 یا IPv6\&.
.RE
.RE
.SS "source\-port"
.PP
یک برچسب عنصر خالی اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک ورودی پورت مبدأ استفاده شود\&. تمام مشخصه‌های یک ورودی پورت مبدأ اجباری هستند:
.PP
port="\fIportid\fR[\-\fIportid\fR]"
.RS 4
پورت می‌تواند یک شماره پورت منفرد
\fIportid\fR
یا یک محدوده پورت
\fIportid\fR\-\fIportid\fR
باشد\&.
.RE
.PP
protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"
.RS 4
پروتکل می‌تواند یکی از موارد
\fItcp\fR،
\fIudp\fR،
\fIsctp\fR
یا
\fIdccp\fR
باشد\&.
.RE
.SS "rule"
.PP
یک برچسب عنصر اختیاری است و می‌تواند چندین بار برای داشتن بیش از یک ورودی قانون زبان پیشرفته (rich language rule) استفاده شود\&.
.PP
ساختار کلی قانون:
.PP
.if n \{\
.RS 4
.\}
.nf
<rule [family="\fIipv4\fR|\fIipv6\fR"] [priority="\fIpriority\fR"]>
    [ <source address="\fIaddress\fR[/\fImask\fR]"|mac="\fIMAC\fR"|ipset="\fIipset\fR" [invert="\fITrue\fR"]/> ]
    [ <destination address="\fIaddress\fR[/\fImask\fR]"|ipset="\fIipset\fR" [invert="\fITrue\fR"]/> ]
    [
        <service name="\fIstring\fR"/> |
        <port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR"/> |
        <protocol value="\fIprotocol\fR"/> |
        <icmp\-block name="\fIicmptype\fR"/> |
        <icmp\-type name="\fIicmptype\fR"/> |
        <masquerade/> |
        <forward\-port port="\fIportid\fR[\-\fIportid\fR]" protocol="\fItcp\fR|\fIudp\fR|\fIsctp\fR|\fIdccp\fR" [to\-port="\fIportid\fR[\-\fIportid\fR]"] [to\-addr="\fIaddress\fR"]/>
    ]
    [
        <log [prefix="\fIprefix text\fR"] [level="\fIemerg\fR|\fIalert\fR|\fIcrit\fR|\fIerr\fR|\fIwarn\fR|\fInotice\fR|\fIinfo\fR|\fIdebug\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </log> |
        <nflog [group="\fIgroup id\fR"] [prefix="\fIprefix text\fR"] [queue\-size="\fIthreshold\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </nflog>
    ]
    [ <audit> [<limit value="\fIrate\fR/\fIduration\fR"/>] </audit> ]
    [
        <accept> [<limit value="\fIrate\fR/\fIduration\fR"/>] </accept> |
        <reject [type="\fIrejecttype\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </reject> |
        <drop> [<limit value="\fIrate\fR/\fIduration\fR"/>] </drop> |
        <mark set="\fImark\fR[/\fImask\fR]"> [<limit value="\fIrate\fR/\fIduration\fR"/>] </mark>
    ]
</rule>

.fi
.if n \{\
.RE
.\}
.PP
ساختار قانون برای فهرست‌بندی سیاه یا سفید مبدأ:
.PP
.if n \{\
.RS 4
.\}
.nf
<rule [family="\fIipv4\fR|\fIipv6\fR"] [priority="\fIpriority\fR"]>
    <source address="\fIaddress\fR[/\fImask\fR]"|mac="\fIMAC\fR"|ipset="\fIipset\fR" [invert="\fITrue\fR"]/>
    [
        <log [prefix="\fIprefix text\fR"] [level="\fIemerg\fR|\fIalert\fR|\fIcrit\fR|\fIerr\fR|\fIwarn\fR|\fInotice\fR|\fIinfo\fR|\fIdebug\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </log> |
        <nflog [group="\fIgroup id\fR"] [prefix="\fIprefix text\fR"] [queue\-size="\fIthreshold\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </nflog>
    ]
    [ <audit> [<limit value="\fIrate\fR/\fIduration\fR"/>] </audit> ]
    <accept> [<limit value="\fIrate\fR/\fIduration\fR"/>] </accept> |
    <reject [type="\fIrejecttype\fR"]> [<limit value="\fIrate\fR/\fIduration\fR"/>] </reject> |
    <drop> [<limit value="\fIrate\fR/\fIduration\fR"/>] </drop>
</rule>

.fi
.if n \{\
.RE
.\}
.PP
برای توضیحات کامل درباره قوانین زبان پیشرفته، لطفاً به
\fBfirewalld.richlanguage\fR(5)
مراجعه کنید\&.
