.IP \fBssse3\fR 4
.IX Item "ssse3"
.IP \fBatom\fR 4
.IX Item "atom"
.IP \fBsse4.1\fR 4
.IX Item "sse4.1"
.IP \fBsse4.2\fR 4
.IX Item "sse4.2"
.IP \fBavx\fR 4
.IX Item "avx"
.IP \fBavx2\fR 4
.IX Item "avx2"
.IP \fBxop\fR 4
.IX Item "xop"
.IP \fBfma3\fR 4
.IX Item "fma3"
.IP \fBfma4\fR 4
.IX Item "fma4"
.IP \fB3dnow\fR 4
.IX Item "3dnow"
.IP \fB3dnowext\fR 4
.IX Item "3dnowext"
.IP \fBbmi1\fR 4
.IX Item "bmi1"
.IP \fBbmi2\fR 4
.IX Item "bmi2"
.IP \fBcmov\fR 4
.IX Item "cmov"
.PD
.RE
.RS 4
.RE
.IP \fBARM\fR 4
.IX Item "ARM"
.RS 4
