.SS super\-with\-arguments / R1725
.sp
\fBMessage emitted:\fP
.sp
\fBConsider using Python 3 style super() without arguments\fP
.sp
\fBDescription:\fP
.sp
\fIEmitted when calling the super() builtin with the current class and instance. On Python 3 these arguments are the default and they can be omitted.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
class Fruit:
    pass


class Orange(Fruit):
    def __init__(self):
        super(Orange, self).__init__()  # [super\-with\-arguments]

