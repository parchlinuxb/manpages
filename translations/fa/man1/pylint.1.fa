.SS contextmanager\-generator\-missing\-cleanup / W0135
.sp
\fBMessage emitted:\fP
.sp
\fBThe context used in function %r will not be exited.\fP
.sp
\fBDescription:\fP
.sp
\fIUsed when a contextmanager is used inside a generator function and the cleanup is not handled.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
import contextlib


@contextlib.contextmanager
def cm():
    contextvar = \(dqacquired context\(dq
    print(\(dqcm enter\(dq)
    yield contextvar
    print(\(dqcm exit\(dq)


def genfunc_with_cm():
    with cm() as context:  # [contextmanager\-generator\-missing\-cleanup]
        yield context * 2

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
import contextlib


@contextlib.contextmanager
def good_cm_except():
    contextvar = \(dqacquired context\(dq
    print(\(dqgood cm enter\(dq)
    try:
        yield contextvar
    except GeneratorExit:
        print(\(dqgood cm exit\(dq)


def genfunc_with_cm():
    with good_cm_except() as context:
        yield context * 2


def genfunc_with_discard():
    with good_cm_except():
        yield \(dqdiscarded\(dq


@contextlib.contextmanager
def good_cm_yield_none():
    print(\(dqgood cm enter\(dq)
    yield
    print(\(dqgood cm exit\(dq)


def genfunc_with_none_yield():
    with good_cm_yield_none() as var:
        print(var)
        yield \(dqconstant yield\(dq


@contextlib.contextmanager
def good_cm_finally():
    contextvar = \(dqacquired context\(dq
    print(\(dqgood cm enter\(dq)
    try:
        yield contextvar
    finally:
        print(\(dqgood cm exit\(dq)


def good_cm_finally_genfunc():
    with good_cm_finally() as context:
        yield context * 2


@contextlib.contextmanager
def good_cm_no_cleanup():
    contextvar = \(dqacquired context\(dq
    print(\(dqcm enter\(dq)
    yield contextvar


def good_cm_no_cleanup_genfunc():
    with good_cm_no_cleanup() as context:
        yield context * 2

.EE
.UNINDENT
.UNINDENT
.sp
\fBAdditional details:\fP
.sp
Instantiating and using a contextmanager inside a generator function can
result in unexpected behavior if there is an expectation that the context is only
available for the generator function. In the case that the generator is not closed or destroyed
then the context manager is held suspended as is.
.sp
This message warns on the generator function instead of the contextmanager function
because the ways to use a contextmanager are many.
A contextmanager can be used as a decorator (which immediately has \fB__enter__\fP/\fB__exit__\fP applied)
and the use of \fBas ...\fP or discard of the return value also implies whether the context needs cleanup or not.
So for this message, warning the invoker of the contextmanager is important.
.sp
The check can create false positives if \fByield\fP is used inside an \fBif\-else\fP block without custom cleanup. Use \fBpylint: disable\fP for these.
.INDENT 0.0
.INDENT 3.5
.sp
.EX
from contextlib import contextmanager

@contextmanager
def good_cm_no_cleanup():
    contextvar = \(dqacquired context\(dq
    print(\(dqcm enter\(dq)
    if some_condition:
        yield contextvar
    else:
        yield contextvar


def good_cm_no_cleanup_genfunc():
    # pylint: disable\-next=contextmanager\-generator\-missing\-cleanup
    with good_cm_no_cleanup() as context:
        yield context * 2
.EE
.UNINDENT
.UNINDENT
.sp
\fBRelated links:\fP
.INDENT 0.0
