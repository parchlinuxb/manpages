.B class sphinx.addnodes.desc_sig_keyword_type(rawsource: str \%<https://\:docs\:.python\:.org/\:3/\:library/\:stdtypes\:.html#\:str> = \(aq\(aq, text: str \%<https://\:docs\:.python\:.org/\:3/\:library/\:stdtypes\:.html#\:str> = \(aq\(aq, *children: Element, **attributes: Any)
