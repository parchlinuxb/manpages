بازرسی پیکربندی یک کانتینر یا ایمیج.
T}
login	buildah-login(1)	T{
ورود به یک رجیستری کانتینر.
T}
logout	buildah-logout(1)	T{
خروج از یک رجیستری کانتینر.
T}
manifest	buildah-manifest(1)	T{
ایجاد و دستکاری فهرست‌های مانیفست و نمایه‌های ایمیج.
T}
mkcw	buildah-mkcw(1)	T{
تبدیل یک ایمیج کانتینری معمولی به یک ایمیج بار کاری محرمانه.
T}
mount	buildah-mount(1)	T{
سوار کردن (mount) سیستم فایل ریشه کانتینر در حال کار.
T}
prune	buildah-prune(1)	T{
پاکسازی ایمیج‌های واسط و همچنین کش ساخت و سوار کردن.
T}
pull	buildah-pull(1)	T{
دریافت یک ایمیج از مکان مشخص‌شده.
T}
push	buildah-push(1)	T{
ارسال یک ایمیج از فضای ذخیره‌سازی محلی به مکانی دیگر.
T}
rename	buildah-rename(1)	T{
تغییر نام یک کانتینر محلی.
T}
rm	buildah-rm(1)	T{
حذف یک یا چند کانتینر در حال کار.
T}
rmi	buildah-rmi(1)	T{
حذف یک یا چند ایمیج.
T}
run	buildah-run(1)	T{
اجرای یک دستور در داخل کانتینر.
T}
source	buildah-source(1)	T{
ایجاد، ارسال، دریافت و مدیریت ایمیج‌های منبع و دست‌ساخته‌های منبع مرتبط.
T}
tag	buildah-tag(1)	T{
افزودن یک نام اضافی به یک ایمیج محلی.
T}
umount	buildah-umount(1)	T{
پیاده کردن (unmount) سیستم فایل ریشه یک کانتینر در حال کار.
T}
unshare	buildah-unshare(1)	T{
اجرای یک دستور در یک فضای‌نام کاربری با نگاشت‌های شناسه اصلاح‌شده.
T}
