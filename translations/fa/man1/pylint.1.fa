    if x == \(dq\(dq:  # [use\-implicit\-booleaness\-not\-comparison\-to\-string]
        print(\(dqx is an empty string\(dq)

    if y != \(dq\(dq:  # [use\-implicit\-booleaness\-not\-comparison\-to\-string]
        print(\(dqy is not an empty string\(dq)

