.INDENT 0.0
.INDENT 3.5
.sp
.EX
fruits = [\(dqapple\(dq, \(dqorange\(dq, \(dqmango\(dq]
for fruit in fruits.copy():
    fruits.append(\(dqpineapple\(dq)

.EE
