.TH lxc-copy 1 2026-08-01 "" ""
.SH "نام (NAME)"
lxc-copy \- copy an existing container. 
.SH "خلاصه دستور (SYNOPSIS)"
'nh
.fi
.ad l
\fBlxc-copy\fR \kx
.if (\nx>(\n(.l/2)) .nr x (\n(.l/5)
