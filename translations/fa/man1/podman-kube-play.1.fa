.SH Job Fields
.TS
allbox;
l l 
l l .
\fBField\fP	\fBSupport\fP
activeDeadlineSeconds	no
selector	no (automatically set by k8s)
template	✅
backoffLimit	no
completionMode	no
completions	T{
no (set to 1 with kube generate)
T}
manualSelector	no
parallelism	T{
no (set to 1 with kube generate)
T}
podFailurePolicy	no
suspend	no
ttlSecondsAfterFinished	no
.TE

