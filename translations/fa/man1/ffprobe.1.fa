.IP \fBarmv5te\fR 4
.IX Item "armv5te"
.IP \fBarmv6\fR 4
.IX Item "armv6"
.IP \fBarmv6t2\fR 4
.IX Item "armv6t2"
.IP \fBvfp\fR 4
.IX Item "vfp"
.IP \fBvfpv3\fR 4
.IX Item "vfpv3"
.IP \fBneon\fR 4
.IX Item "neon"
.IP \fBsetend\fR 4
.IX Item "setend"
.PD
.RE
.RS 4
.RE
.IP \fBAArch64\fR 4
.IX Item "AArch64"
