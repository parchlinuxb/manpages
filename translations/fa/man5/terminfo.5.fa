\fB\%infocmp\fP(1M)،
\fB\%tabs\fP(1)،
\fB\%tic\fP(1M)،
\fB\%curses\fP(3X)،
\fB\%curs_color\fP(3X)،
\fB\%curs_terminfo\fP(3X)،
\fB\%curs_variables\fP(3X)،
\fB\%printf\fP(3)،
\fB\%term_variables\fP(3X)،
\fB\%term\fP(5)،
\fB\%user_caps\fP(5)
