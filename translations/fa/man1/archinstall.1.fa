locale_config
T}	T{
{kb_layout: lang \%<https://\:wiki\:.archlinux\:.org/\:title/\:Linux_console/\:Keyboard_configuration>, sys_enc: Character encoding \%<https://\:wiki\:.archlinux\:.org/\:title/\:Locale>, sys_lang: locale \%<https://\:wiki\:.archlinux\:.org/\:title/\:Locale>}
T}	T{
