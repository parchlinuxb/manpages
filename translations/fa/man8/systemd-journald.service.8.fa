.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
systemd-journald.service, systemd-journald.socket, systemd-journald-dev-log.socket, systemd-journald-audit.socket, systemd-journald@.service, systemd-journald@.socket, systemd-journald-varlink@.socket, systemd-journald \- سرویس ژورنال
.SH "خلاصه دستور (SYNOPSIS)"
.PP
.RS 4
systemd\-journald\&.service
.RE
.RS 4
systemd\-journald\&.socket
.RE
.RS 4
systemd\-journald\-dev\-log\&.socket
.RE
.RS 4
systemd\-journald\-audit\&.socket
.RE
.RS 4
systemd\-journald@\&.service
.RE
.RS 4
systemd\-journald@\&.socket
.RE
.RS 4
systemd\-journald\-varlink@\&.socket
.RE
.RS 4
/usr/lib/systemd/systemd\-journald
.RE
.SH "توضیحات (DESCRIPTION)"
.PP
systemd\-journald
یک سرویس سیستمی است که داده‌های ثبت لاگ را جمع‌آوری و ذخیره می‌کند\&. این سرویس بر اساس اطلاعات ثبت لاگ دریافت‌شده از منابع گوناگون، ژورنال‌های ساخت‌یافته و نمایه‌سازی‌شده را ایجاد و نگهداری می‌نماید:
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
پیام‌های لاگ هسته، از طریق kmsg
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
پیام‌های ساده لاگ سیستم، از طریق فراخوانی
\fBsyslog\fR(3)
در
libc
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
پیام‌های ساخت‌یافته لاگ سیستم از طریق رابط برنامه‌نویسی بومی ژورنال (native Journal API)،
\fBsd_journal_print\fR(3)
و
\m[blue]\fBNative Journal Protocol\fR\m[]\&\s-2\u[1]\d\s+2
را ببینید
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
خروجی استاندارد و خطای استاندارد واحدهای سرویس\&. برای جزئیات بیشتر به بخش زیر مراجعه کنید\&.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
رکوردهای حسابرسی، برگرفته از زیرسیستم حسابرسی هسته
.RE
.PP
دیمن به‌طور ضمنی فیلدهای فرادادهٔ متعددی را برای هر پیام لاگ به شیوه‌ای امن و غیرقابل جعل جمع‌آوری می‌کند\&. برای اطلاعات بیشتر درباره فراداده‌های جمع‌آوری‌شده به
\fBsystemd.journal-fields\fR(7)
مراجعه کنید\&.
.PP
داده‌های لاگ جمع‌آوری‌شده توسط ژورنال اساساً مبتنی بر متن هستند، اما در صورت نیاز می‌توانند شامل داده‌های باینری نیز باشند\&. اندازهٔ هر یک از فیلدهای تشکیل‌دهندهٔ یک رکورد لاگ ذخیره‌شده در ژورنال می‌تواند تا 2⁶⁴\-1 بایت باشد\&.
.PP
سرویس ژورنال داده‌های لاگ را یا به‌صورت پایدار در
/var/log/journal
و یا به‌صورت فرّار در
/run/log/journal/
ذخیره می‌کند (در حالت دوم، داده‌ها هنگام راه‌اندازی مجدد سیستم از بین می‌روند)\&. به‌طور پیش‌فرض، اگر در حین بوت
/var/log/journal/
وجود داشته باشد، داده‌های لاگ به‌صورت پایدار ذخیره می‌شوند، در غیر این صورت به‌طور ضمنی به ذخیره‌سازی فرّار بازمی‌گردد\&. از
\fIStorage=\fR
در
\fBjournald.conf\fR(5)
برای پیکربندی محل قرارگیری داده‌های لاگ، مستقل از وجود داشتن
/var/log/journal/
استفاده کنید\&.
.PP
توجه داشته باشید که journald در ابتدا از ذخیره‌سازی فرّار استفاده می‌کند، تا زمانی که فراخوانی
\fBjournalctl \-\-flush\fR
(یا ارسال
\fBSIGUSR1\fR
به journald) موجب شود تا به ثبت لاگ پایدار تغییر وضعیت دهد (تحت شرایط ذکرشده در بالا)\&. این عمل در زمان بوت به‌طور خودکار از طریق
"systemd\-journal\-flush\&.service"
انجام می‌شود\&.
.PP
در سیستم‌هایی که
/var/log/journal/
هنوز در آن‌ها وجود ندارد اما ثبت لاگ پایدار مورد نظر است (و از
journald\&.conf
پیش‌فرض استفاده می‌شود)، کافی است این دایرکتوری ایجاد شده و از درستی حالت‌های دسترسی و مالکیت آن اطمینان حاصل گردد:
.sp
.if n \{\
.RS 4
.\}
.nf
mkdir \-p /var/log/journal
systemd\-tmpfiles \-\-create \-\-prefix /var/log/journal
.fi
.if n \{\
.RE
.\}
.PP
برای اطلاعات درباره پیکربندی این سرویس به
\fBjournald.conf\fR(5)
مراجعه کنید\&.
.SH "ثبت لاگ جریانی (STREAM LOGGING)"
.PP
مدیر سرویس systemd به‌طور پیش‌فرض تمامی فرایندهای سرویس را در حالی فراخوانی می‌کند که خروجی استاندارد و خطای استاندارد آن‌ها به ژورنال متصل است\&. این رفتار را می‌توان از طریق تنظیمات
\fIStandardOutput=\fR/\fIStandardError=\fR
در فایل واحد تغییر داد؛ برای جزئیات به
\fBsystemd.exec\fR(5)
مراجعه کنید\&. ژورنال جریان بایت‌های لاگ دریافت‌شده از این طریق را با تقسیم جریان در خطوط جدید ("\en"، اسکی
\fB10\fR)
و بایت‌های
\fBNUL\fR،
به رکوردهای لاگ مجزا تبدیل می‌کند\&.
.PP
اگر
systemd\-journald\&.service
متوقف شود، اتصالات جریانی مرتبط با تمامی سرویس‌ها قطع می‌شوند\&. تلاش‌های بعدی سرویس برای نوشتن در آن جریان‌ها منجر به خطاهای
\fBEPIPE\fR
خواهد شد\&. به منظور واکنش مناسب در این حالت، توصیه می‌شود برنامه‌هایی که در خروجی/خطای استاندارد لاگ می‌نویسند چنین خطاهایی را نادیده بگیرند\&. اگر گرداننده سیگنال یونیکس
\fBSIGPIPE\fR
مسدود یا غیرفعال نشده باشد، چنین تلاش‌هایی برای نوشتن همچنین منجر به تولید این سیگنال‌های فرایند خواهد شد؛
\fBsignal\fR(7)
را ببینید\&. برای کاهش اثرات این مسئله، مدیر سرویس systemd به‌طور صریح و پیش‌فرض سیگنال
\fBSIGPIPE\fR
را برای تمامی فرایندهای فراخوانی‌شده غیرفعال می‌کند (این مورد را می‌توان برای هر واحد به‌طور جداگانه از طریق گزینه
\fIIgnoreSIGPIPE=\fR
تغییر داد؛ برای جزئیات به
\fBsystemd.exec\fR(5)
مراجعه کنید)\&. پس از قطع جریان‌های خروجی استاندارد/خطای استاندارد، امکان بازیابی آن‌ها وجود ندارد مگر اینکه سرویس‌های مرتبط با آن‌ها دوباره راه‌اندازی شوند\&. توجه داشته باشید که در طول عملکرد عادی،
systemd\-journald\&.service
کپی‌هایی از توصیف‌کننده‌های فایل (file descriptors) این جریان‌ها را در مدیر سرویس نگهداری می‌کند\&. اگر
systemd\-journald\&.service
با استفاده از
\fBsystemctl restart\fR
یا عملیات معادل آن به جای یک جفت دستور مجزای
\fBsystemctl stop\fR
و
\fBsystemctl start\fR
(یا عملیات معادل) راه‌اندازی مجدد شود، این اتصالات جریانی قطع نشده و در طول راه‌اندازی مجدد حفظ می‌شوند\&. بنابراین راه‌اندازی مجدد
systemd\-journald\&.service
ایمن است، اما متوقف کردن آن توصیه نمی‌شود\&.
.PP
توجه داشته باشید که فرادادهٔ رکورد لاگ برای رکوردهای منتقل‌شده از طریق چنین جریان‌های خروجی/خطای استاندارد، فرادادهٔ همتایی (peer) را بازتاب می‌دهد که جریان در ابتدا برای آن ایجاد شده بود\&. اگر اتصال جریان به فرایندهای دیگر منتقل شود (مانند فرایندهای فرزند بیشتری که از فرایند اصلی سرویس منشعب شده‌اند)، رکوردهای لاگ فرادادهٔ آن‌ها را بازتاب نخواهند داد، بلکه همچنان به توصیف فرایند اولیه ادامه می‌دهند\&. این موضوع با سایر روش‌های انتقال لاگ فهرست‌شده در بالا متفاوت است، چرا که آن‌ها ذاتاً مبتنی بر رکورد هستند و فراداده در آن‌ها همواره با تک‌تک رکوردها مرتبط است\&.
.PP
علاوه بر ثبت لاگ ضمنی خروجی/خطای استاندارد سرویس‌ها، ثبت لاگ جریانی از طریق ابزار خط فرمان
\fBsystemd-cat\fR(1)
نیز در دسترس است\&.
.PP
در حال حاضر، تعداد جریان‌های لاگ موازی که
systemd\-journald
می‌پذیرد به ۴۰۹۶ محدود است\&. هنگامی که این حد تکمیل شود، جریان‌های لاگ بیشتری ممکن است برقرار شوند اما از همان ابتدا خطای
\fBEPIPE\fR
دریافت خواهند کرد\&.
.SH "فضاهای نام ژورنال (JOURNAL NAMESPACES)"
.PP
«فضاهای نام» ژورنال هم سازوکاری برای جداسازی منطقی جریان لاگ پروژه‌های شامل یک یا چند سرویس از بقیه سیستم هستند و هم سازوکاری برای بهبود کارایی\&. چندین فضای نام ژورنال می‌توانند به‌طور هم‌زمان وجود داشته باشند که هر کدام جریان لاگ مستقل خود را تعریف می‌کنند و توسط نمونهٔ اختصاصی خود از
\fBsystemd\-journald\fR
مدیریت می‌شوند\&. فضاهای نام هم در مخزن داده و هم در رابط IPC از یکدیگر مستقل هستند\&. به‌طور پیش‌فرض، تنها یک فضای نام پیش‌فرض وجود دارد که توسط
systemd\-journald\&.service
(و واحدهای سوکت مرتبط با آن) مدیریت می‌شود\&. فضاهای نام اضافی با راه‌اندازی نمونه‌ای از الگوی سرویس
systemd\-journald@\&.service
ایجاد می‌شوند\&. نام نمونه همان شناسه فضای نام است که رشته‌ای کوتاه بوده و برای اشاره به فضای نام ژورنال استفاده می‌شود\&. واحدهای سرویس را می‌توان از طریق تنظیم
\fILogNamespace=\fR
در فایل واحد به یک فضای نام ژورنال خاص اختصاص داد؛ برای جزئیات به
\fBsystemd.exec\fR(5)
مراجعه کنید\&. سوئیچ
\fB\-\-namespace=\fR
در
\fBjournalctl\fR(1)
می‌تواند برای مشاهده جریان لاگ یک فضای نام خاص استفاده شود\&. اگر از این سوئیچ استفاده نشود، جریان لاگ فضای نام پیش‌فرض نمایش داده می‌شود، یعنی داده‌های لاگ سایر فضاهای نام قابل مشاهده نخواهند بود\&.
.PP
سرویس‌های مرتبط با یک فضای نام لاگ خاص می‌توانند از طریق
\fBsyslog\fR(3)،
پروتکل بومی ثبت لاگ ژورنال و خروجی/خطای استاندارد لاگ ثبت کنند؛ ثبت لاگ از هر سه روش انتقال به آن فضای نام مرتبط خواهد بود\&.
.PP
به‌طور پیش‌فرض، تنها فضای نام پیش‌فرض پیام‌های لاگ هسته و حسابرسی را جمع‌آوری خواهد کرد\&.
.PP
نمونهٔ
\fBsystemd\-journald\fR
مربوط به فضای نام پیش‌فرض از طریق
/etc/systemd/journald\&.conf
(پایین را ببینید) پیکربندی می‌شود، در حالی که سایر نمونه‌ها از طریق
/etc/systemd/journald@\fINAMESPACE\fR\&.conf
پیکربندی می‌گردند\&. داده‌های لاگ ژورنال برای فضای نام پیش‌فرض در
/var/log/journal/\fIMACHINE_ID\fR
(پایین را ببینید) قرار می‌گیرند در حالی که داده‌های سایر فضاهای نام در
/var/log/journal/\fIMACHINE_ID\fR\&.\fINAMESPACE\fR
واقع شده‌اند\&.
.SH "سیگنال‌ها (SIGNALS)"
.PP
SIGUSR1
.RS 4
درخواست تخلیه (flush) داده‌های ژورنال از
/run/
به
/var/
به منظور پایدارسازی آن‌ها (در صورت فعال بودن این امکان)\&. این سیگنال باید پس از سوار شدن (mount)
/var/
استفاده شود، زیرا در غیر این صورت صرف‌نظر از پیکربندی، داده‌های لاگ از
/run/
هرگز به
/var/
منتقل نمی‌شوند\&. از دستور
\fBjournalctl \-\-flush\fR
برای درخواست تخلیه فایل‌های ژورنال و انتظار برای تکمیل عملیات استفاده کنید\&. برای جزئیات به
\fBjournalctl\fR(1)
مراجعه کنید\&.
.sp
اضافه‌شده در نسخهٔ 186\&.
.RE
.PP
SIGUSR2
.RS 4
درخواست چرخش فوری فایل‌های ژورنال\&. از دستور
\fBjournalctl \-\-rotate\fR
برای درخواست چرخش فایل‌های ژورنال و انتظار برای تکمیل عملیات استفاده کنید\&.
.sp
اضافه‌شده در نسخهٔ 186\&.
.RE
.PP
SIGRTMIN+1
.RS 4
درخواست نوشتن تمامی داده‌های لاگ نوشته‌نشده روی دیسک\&. از دستور
\fBjournalctl \-\-sync\fR
برای فعال‌سازی همگام‌سازی ژورنال و انتظار برای تکمیل عملیات استفاده کنید\&.
.sp
اضافه‌شده در نسخهٔ 228\&.
.RE
.PP
SIGHUP
.RS 4
به محض دریافت سیگنال فرایند
\fBSIGHUP\fR،
\fBsystemd\-journald\fR
مقادیر پیکربندی خود را دوباره بارگذاری کرده و بافر لاگ هسته و ژورنال‌ها را برای بازتاب پیکربندی جدید به‌روزرسانی می‌کند\&. اگر
\fIReadKmsg=\fR
تغییر کرده باشد، بافر لاگ هسته به عنوان بخشی از بارگذاری مجدد تخلیه و به‌روزرسانی خواهد شد\&. ژورنال فعال (مانند پایدار یا فرّار) همچنان با پیکربندی به‌روزرسانی‌شده مورد استفاده قرار خواهد گرفت\&. با این حال، اگر حالت ذخیره‌سازی از پایدار به فرّار تغییر کرده باشد و ژورنال فعلی در حال استفاده ژورنال پایدار باشد، آنگاه ژورنال فعال به ژورنال فرّار تغییر خواهد یافت\&.
.sp
اضافه‌شده در نسخهٔ 258\&.
.RE
.SH "اعتبارنامه‌ها (CREDENTIALS)"
.PP
\fBsystemd\-journald\fR
از منطق اعتبارنامه‌های سرویس همان‌گونه که توسط
\fIImportCredential=\fR/\fILoadCredential=\fR/\fISetCredential=\fR
پیاده‌سازی شده است پشتیبانی می‌کند (برای جزئیات به
\fBsystemd.exec\fR(5)
مراجعه کنید)\&. اعتبارنامه‌های زیر در صورت ارائه استفاده می‌شوند:
.PP
\fIjournal\&.forward_to_socket\fR
.RS 4
می‌تواند حاوی نشانی سوکتی باشد که لاگ‌ها باید به آن بازارسال شوند\&.
\fIForwardToSocket=\fR
در
\fBjournald.conf\fR(5)
را ببینید\&.
.sp
اضافه‌شده در نسخهٔ 256\&.
.RE
.PP
\fIjournal\&.storage\fR
.RS 4
می‌تواند برای مشخص کردن محل ذخیره‌سازی فایل‌های ژورنال استفاده شود\&.
\fIStorage=\fR
در
\fBjournald.conf\fR(5)
را ببینید\&.
.sp
اضافه‌شده در نسخهٔ 256\&.
.RE
.SH "خط فرمان هسته (KERNEL COMMAND LINE)"
.PP
چند پارامتر پیکربندی از
journald\&.conf
را می‌توان در خط فرمان هسته بازنویسی کرد:
.PP
\fIsystemd\&.journald\&.forward_to_syslog=\fR, \fIsystemd\&.journald\&.forward_to_kmsg=\fR, \fIsystemd\&.journald\&.forward_to_console=\fR, \fIsystemd\&.journald\&.forward_to_wall=\fR
.RS 4
بازارسال پیام‌های لاگ جمع‌آوری‌شده به syslog، بافر لاگ هسته، کنسول سیستم یا wall را فعال/غیرفعال می‌کند\&.
.sp
برای اطلاعات درباره این تنظیمات به
\fBjournald.conf\fR(5)
مراجعه کنید\&.
.sp
اضافه‌شده در نسخهٔ 186\&.
.RE
.PP
\fIsystemd\&.journald\&.max_level_store=\fR, \fIsystemd\&.journald\&.max_level_syslog=\fR, \fIsystemd\&.journald\&.max_level_kmsg=\fR, \fIsystemd\&.journald\&.max_level_console=\fR, \fIsystemd\&.journald\&.max_level_wall=\fR, \fIsystemd\&.journald\&.max_level_socket=\fR
.RS 4
حداکثر سطح لاگ پیام‌هایی را که در ژورنال ذخیره می‌شوند یا به
\fBsyslog\fR(3)،
kmsg، کنسول،
\fBwall\fR(1)
یا یک سوکت بازارسال می‌گردند کنترل می‌کند\&. این گزینه‌های خط فرمان هسته تنظیمات هم‌نام در فایل
\fBjournald.conf\fR(5)
را بازنویسی می‌کنند\&.
.sp
اضافه‌شده در نسخهٔ 232\&.
.RE
.PP
توجه داشته باشید که این گزینه‌های خط فرمان هسته تنها توسط فضای نام پیش‌فرض اعمال می‌شوند؛ بخش بالا را ببینید\&.
.SH "کنترل دسترسی (ACCESS CONTROL)"
.PP
فایل‌های ژورنال به‌طور پیش‌فرض تحت مالکیت گروه سیستمی
"systemd\-journal"
بوده و توسط آن قابل خواندن هستند، اما قابل نوشتن نیستند\&. بنابراین، افزودن یک کاربر به این گروه او را قادر می‌سازد تا فایل‌های ژورنال را بخواند\&.
.PP
به‌طور پیش‌فرض، هر کاربری که شناسه UID آن خارج از محدودهٔ کاربران سیستم، کاربران پویای سرویس‌ها و کاربر nobody باشد، مجموعه فایل‌های ژورنال مختص به خود را در
/var/log/journal/
دریافت خواهد کرد\&. برای جزئیات بیشتر درباره محدوده‌های UID به
\m[blue]\fBUsers, Groups, UIDs and GIDs on systemd systems\fR\m[]\&\s-2\u[2]\d\s+2
مراجعه کنید\&. با این حال، به منظور جلوگیری از اینکه کاربر بتواند مستقیماً در این فایل‌های ژورنال بنویسد، این فایل‌ها تحت مالکیت کاربر نخواهند بود\&. در عوض، از فهرست‌های کنترل دسترسی فایل‌سیستم (ACL) استفاده می‌شود تا اطمینان حاصل شود که کاربر تنها دسترسی خواندن دریافت می‌کند\&.
.PP
به کاربران و گروه‌های دیگر نیز می‌توان از طریق فهرست‌های کنترل دسترسی فایل‌سیستم (ACL) اجازه دسترسی به فایل‌های ژورنال را اعطا کرد\&. توزیع‌ها و مدیران سیستم ممکن است دسترسی خواندن را به تمام اعضای گروه‌های سیستمی
"wheel"
و
"adm"
با دستوری مانند دستور زیر اعطا کنند:
.sp
.if n \{\
.RS 4
.\}
.nf
# setfacl \-Rnm g:wheel:rx,d:g:wheel:rx,g:adm:rx,d:g:adm:rx /var/log/journal/
.fi
.if n \{\
.RE
.\}
.PP
توجه داشته باشید که این دستور، ACLها را هم برای فایل‌های ژورنال موجود و هم برای فایل‌های ژورنال آینده که در دایرکتوری
/var/log/journal/
ایجاد می‌شوند به‌روزرسانی خواهد کرد\&.
.SH "فایل‌ها (FILES)"
.PP
/etc/systemd/journald\&.conf
.RS 4
پیکربندی رفتار
\fBsystemd\-journald\fR\&.
به
\fBjournald.conf\fR(5)
مراجعه کنید\&.
.sp
اضافه‌شده در نسخهٔ 206\&.
.RE
.PP
/run/log/journal/\fImachine\-id\fR/*\&.journal, /run/log/journal/\fImachine\-id\fR/*\&.journal~, /var/log/journal/\fImachine\-id\fR/*\&.journal, /var/log/journal/\fImachine\-id\fR/*\&.journal~
.RS 4
\fBsystemd\-journald\fR
ورودی‌ها را در فایل‌هایی در
/run/log/journal/\fImachine\-id\fR/
یا
/var/log/journal/\fImachine\-id\fR/
با پسوند
"\&.journal"
می‌نویسد\&. اگر دیمن به‌صورت ناتمام یا غیرعادی متوقف شود یا مشخص شود که فایل‌ها خراب شده‌اند، نام آن‌ها با استفاده از پسوند
"\&.journal~"
تغییر یافته و
\fBsystemd\-journald\fR
شروع به نوشتن در یک فایل جدید می‌کند\&.
/run/
زمانی استفاده می‌شود که
/var/log/journal
در دسترس نباشد، یا زمانی که
\fBStorage=volatile\fR
در فایل پیکربندی
\fBjournald.conf\fR(5)
تنظیم شده باشد\&.
.sp
هنگامی که
systemd\-journald
نوشتن در یک فایل ژورنال را متوقف می‌کند، نام آن به
"\fIoriginal\-name\fR@\fIsuffix\&.journal\fR"
(یا
"\fIoriginal\-name\fR@\fIsuffix\&.journal~\fR")
تغییر داده می‌شود\&. چنین فایل‌هایی «بایگانی‌شده» هستند و دیگر در آن‌ها نوشته نخواهد شد\&.
.sp
به‌طور کلی، خواندن یا کپی کردن هر فایل ژورنال (فعال یا بایگانی‌شده) ایمن است\&.
\fBjournalctl\fR(1)
و توابع موجود در کتابخانهٔ
\fBsd-journal\fR(3)
باید بتوانند تمامی ورودی‌هایی را که به‌طور کامل نوشته شده‌اند بخوانند\&.
.sp
systemd\-journald
به‌طور خودکار قدیمی‌ترین فایل‌های ژورنال بایگانی‌شده را برای محدود کردن میزان مصرف فضای دیسک حذف خواهد کرد\&.
\fISystemMaxUse=\fR
و تنظیمات مرتبط در
\fBjournald.conf\fR(5)
را ببینید\&.
.sp
اضافه‌شده در نسخهٔ 206\&.
.RE
.PP
/dev/kmsg, /dev/log, /run/systemd/journal/dev\-log, /run/systemd/journal/socket, /run/systemd/journal/stdout
.RS 4
سوکت‌ها و سایر مسیرهای گره فایلی که
\fBsystemd\-journald\fR
به آن‌ها گوش می‌دهد و در فایل‌سیستم قابل مشاهده هستند\&. علاوه بر این‌ها،
\fBsystemd\-journald\fR
می‌تواند بسته به اینکه
"systemd\-journald\-audit\&.socket"
فعال باشد یا خیر، با استفاده از
\fBnetlink\fR(7)
به رویدادهای حسابرسی گوش دهد\&.
.sp
اضافه‌شده در نسخهٔ 228\&.
.RE
.PP
در صورت استفاده از فضابندی نام ژورنال، این مسیرها اندکی تغییر می‌کنند تا شامل شناسه فضای نام شوند؛ بخش بالا را ببینید\&.
.SH "همچنین ببینید (SEE ALSO)"
.PP
\fBsystemd\fR(1), \fBjournalctl\fR(1), \fBjournald.conf\fR(5), \fBsystemd.journal-fields\fR(7), \fBsd-journal\fR(3), \fBsystemd-coredump\fR(8), \fBsetfacl\fR(1), \fBsd_journal_print\fR(3), \fBpydoc systemd\&.journal\fR
.SH "نکات (NOTES)"
.IP " 1." 4
Native Journal Protocol
.RS 4
\%https://systemd.io/JOURNAL_NATIVE_PROTOCOL
.RE
.IP " 2." 4
Users, Groups, UIDs and GIDs on systemd systems
.RS 4
\%https://systemd.io/UIDS-GIDS
.RE
