.nh
.TH KUBERNETES 1 "Jan 2015" "Eric Paris" "راهنمای کاربر kubernetes"

.SH "نام (NAME)"
kubectl-kuberc-set \- تنظیم مقادیر در پیکربندی kuberc


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubectl kuberc set\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
تنظیم مقادیر در فایل پیکربندی kuberc.

.PP
برای مشخص کردن تنظیم مقادیر پیش‌فرض (defaults) یا نام‌های مستعار (aliases)، از --section استفاده کنید.

.PP
برای مقادیر پیش‌فرض (defaults): مقادیر پیش‌فرض فلگ‌ها را برای دستورات kubectl تنظیم می‌کند. فلگ --command فقط باید دستور را مشخص کند (مانند "get"، "create"، "set env")، نه منابع را.

.PP
برای نام‌های مستعار (aliases): نام‌های مستعار دستورات را با مقادیر پیش‌فرض فلگ‌ها و آرگومان‌های اختیاری ایجاد می‌کند. برای گنجاندن منابع یا آرگومان‌های دیگر از --prependarg و --appendarg استفاده کنید.


.SH "گزینه‌ها (OPTIONS)"
\fB--allowlist-entry\fP=[]
	مدخل فهرست مجاز (allowlist) به قالب field=value (می‌تواند چندین بار مشخص شود)

.PP
\fB--appendarg\fP=[]
	آرگومان برای الحاق به انتهای دستور (می‌تواند چندین بار مشخص شود، فقط برای نام‌های مستعار)

.PP
\fB--command\fP=""
	دستور جهت پیکربندی (مانند 'get'، 'create'، 'set env')

.PP
\fB--kuberc\fP=""
	مسیر فایل kuberc برای استفاده در ترجیحات (preferences). این قابلیت می‌تواند با export کردن feature gate به صورت KUBECTL_KUBERC=false یا خاموش کردن ویژگی با KUBERC=off غیرفعال شود.

.PP
\fB--name\fP=""
	نام مستعار (برای --section=aliases الزامی است)

.PP
\fB--option\fP=[]
	گزینه فلگ به قالب flag=value (می‌تواند چندین بار مشخص شود)

.PP
\fB--overwrite\fP=false
	مجاز بودن بازنویسی مدخل‌های موجود

.PP
\fB--policy\fP=""
	خط‌مشی افزونه برای استفاده در پلاگین‌های اعتبارسنجی اجرایی (exec credential plugins)؛ باید یکی از 'AllowAll'، 'DenyAll' یا 'Allowlist' باشد

.PP
\fB--prependarg\fP=[]
	آرگومان برای درج در ابتدای دستور (می‌تواند چندین بار مشخص شود، فقط برای نام‌های مستعار)

.PP
\fB--section\fP=""
	بخش مورد نظر برای ویرایش: 'defaults'، 'aliases' یا 'credentialplugin'


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--as\fP=""
	نام کاربری برای جعل هویت (impersonate) در این عملیات. کاربر می‌تواند یک کاربر معمولی یا یک حساب خدمت (service account) در یک namespace باشد.

.PP
\fB--as-group\fP=[]
	گروه برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای تعیین چندین گروه تکرار شود.

.PP
\fB--as-uid\fP=""
	شناسه UID برای جعل هویت در این عملیات.

.PP
\fB--as-user-extra\fP=[]
	اطلاعات اضافی کاربر برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای مشخص کردن چندین مقدار برای یک کلید یکسان تکرار شود.

.PP
\fB--cache-dir\fP="/home/username/.kube/cache"
	دایرکتوری پیش‌فرض کش

.PP
\fB--certificate-authority\fP=""
	مسیر فایل گواهی برای مرجع صدور گواهی (certificate authority)

.PP
\fB--client-certificate\fP=""
	مسیر فایل گواهی کلاینت برای TLS

.PP
\fB--client-key\fP=""
	مسیر فایل کلید کلاینت برای TLS

.PP
\fB--cluster\fP=""
	نام کلاستر kubeconfig برای استفاده

.PP
\fB--context\fP=""
	نام کانتکست kubeconfig برای استفاده

.PP
\fB--disable-compression\fP=false
	در صورت true بودن، فشرده‌سازی پاسخ‌ها برای تمام درخواست‌ها به سرور غیرفعال می‌شود

.PP
\fB--insecure-skip-tls-verify\fP=false
	در صورت true بودن، اعتبار گواهی سرور بررسی نخواهد شد. این کار اتصالات HTTPS شما را ناامن می‌کند

.PP
\fB--kubeconfig\fP=""
	مسیر فایل kubeconfig برای استفاده در درخواست‌های CLI.

.PP
\fB--match-server-version\fP=false
	الزام به تطابق نسخه سرور با نسخه کلاینت

.PP
\fB-n\fP, \fB--namespace\fP=""
	در صورت وجود، حوزه namespace برای این درخواست CLI

.PP
\fB--password\fP=""
	رمز عبور برای احراز هویت پایه (basic authentication) در سرور API

.PP
\fB--profile\fP="none"
	نام پروفایل برای ثبت. یکی از (none|cpu|heap|goroutine|threadcreate|block|mutex|trace)

.PP
\fB--profile-output\fP="profile.pprof"
	نام فایلی که پروفایل در آن ذخیره می‌شود

.PP
\fB--request-timeout\fP="0"
	مدت زمان انتظار پیش از انصراف از یک درخواست به سرور. مقادیر غیر صفر باید شامل واحد زمانی متناظر باشند (مانند 1s، 2m، 3h). مقدار صفر یعنی درخواست‌ها هرگز منقضی نشوند (بدون timeout).

.PP
\fB-s\fP, \fB--server\fP=""
	آدرس و پورت سرور Kubernetes API

.PP
\fB--tls-server-name\fP=""
	نام سرور برای اعتبارسنجی گواهی سرور. در صورت عدم ارائه، از hostname استفاده‌شده برای برقراری ارتباط با سرور استفاده می‌شود

.PP
\fB--token\fP=""
	توکن Bearer برای احراز هویت در سرور API

.PP
\fB--user\fP=""
	نام کاربر kubeconfig برای استفاده

.PP
\fB--username\fP=""
	نام کاربری برای احراز هویت پایه در سرور API

.PP
\fB--version\fP=false
	گزینه \fB\-\-version\fP یا \fB\-\-version=raw\fP اطلاعات نسخه را چاپ کرده و خارج می‌شود؛ \fB\-\-version=vX.Y.Z...\fP نسخه گزارش‌شده را تنظیم می‌کند

.PP
\fB--warnings-as-errors\fP=false
	در نظر گرفتن هشدارهای دریافتی از سرور به عنوان خطا و خروج با کد وضعیت غیر صفر


.SH "مثال (EXAMPLE)"
.EX
  # تنظیم قالب خروجی پیش‌فرض برای دستور 'get'
  kubectl kuberc set --section defaults --command get --option output=wide
  
  # تنظیم قالب خروجی پیش‌فرض برای یک زیردستور
  kubectl kuberc set --section defaults --command "set env" --option output=yaml
  
  # ایجاد نام مستعار 'getn' برای دستور 'get' همراه با درج منبع 'nodes' در ابتدا
  kubectl kuberc set --section aliases --name getn --command get --prependarg nodes --option output=wide
  
  # ایجاد نام مستعار 'runx' برای دستور 'run' همراه با الحاق آرگومان‌ها به انتها
  kubectl kuberc set --section aliases --name runx --command run --option image=nginx --appendarg "--" --appendarg custom-arg1
  
  # بازنویسی یک مقدار پیش‌فرض موجود
  kubectl kuberc set --section defaults --command get --option output=json --overwrite
  
  # تنظیم خط‌مشی و فهرست مجاز افزونه اعتبارنامه
  kubectl kuberc set --section credentialplugin --policy Allowlist --allowlist-entry command=cloud-credential-helper
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubectl-kuberc(1)\fP


.SH "تاریخچه (HISTORY)"
ژانویه ۲۰۱۵، در ابتدا توسط Eric Paris (eparis at redhat dot com) بر پایه محتوای منبع kubernetes گردآوری شد، اما امید است که از آن زمان به بعد به طور خودکار تولید شده باشند!
