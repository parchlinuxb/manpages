.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-export \- برون‌بری فایل‌سیستم یک کانتینر در قالب یک بایگانی tar


.SH "خلاصه (SYNOPSIS)"
\fBdocker export [OPTIONS] CONTAINER\fP


.SH "شرح (DESCRIPTION)"
نام مستعار برای \fBdocker container export\fR\&.


.SH "گزینه‌ها (OPTIONS)"
\fB-o\fP, \fB--output\fP=""
	نوشتن در یک فایل، به جای STDOUT


.SH "ببینید (SEE ALSO)"
\fBdocker(1)\fP
