MemoryQoS=true|false (ALPHA - default=false)
MutablePVNodeAffinity=true|false (ALPHA - default=false)
MutablePodResourcesForSuspendedJobs=true|false (BETA - default=true)
MutableSchedulingDirectivesForSuspendedJobs=true|false (BETA - default=true)
