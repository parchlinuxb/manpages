.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
nvme-wdc-vs-temperature-stats \- نمایش آمارهای مرتبط با دما
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.nf
\fInvme wdc vs\-temperature\-stats\fR <device>
.fi
.SH "توضیحات (DESCRIPTION)"
.sp
برای دستگاه NVMe داده‌شده، آمارهای مربوط به دما را نمایش می‌دهد\&.
.sp
پارامتر <device> اجباری است و باید یک دستگاه نویسه‌ای NVMe باشد (مانند: /dev/nvme0)\&.
.sp
این دستور تنها روی دستگاه‌های WDC که از این ویژگی پشتیبانی می‌کنند کار خواهد کرد\&. نتایج برای هر دستگاه دیگری تعریف‌نشده است\&.
.sp
وضعیت و توضیحات مورد انتظار:\-
.TS
allbox tab(:);
ltB ltB.
T{
آمار (Statistic)
T}:T{
توضیحات (Description)
T}
.T&
lt lt
lt lt
lt lt
lt lt
lt lt
lt lt
lt lt
lt lt
lt lt
lt lt
lt lt
lt lt.
T{
.sp
\fBThe current composite temperature\fR
.br
(دمای ترکیبی فعلی)
T}:T{
.sp
دمای دستگاه
T}
T{
.sp
\fBWarning Composite TEMPerature threshold\fR
.br
(آستانهٔ دمای ترکیبی هشدار)
T}:T{
.sp
دمای گرم شدن بیش از حد
T}
T{
.sp
\fBCritical Composite TEMPerature threshold\fR
.br
(آستانهٔ دمای ترکیبی بحرانی)
T}:T{
.sp
دمای گرم شدن بحرانی بیش از حد
T}
T{
.sp
\fBDevice Initiated Thermal Throttling support status\fR
.br
(وضعیت پشتیبانی از تعدیل حرارتی به ابتکار دستگاه)
T}:T{
.sp
0 = پشتیبانی‌نشده، 1 = پشتیبانی‌شده
T}
T{
.sp
\fBHost Controlled Thermal Management support\fR
.br
(پشتیبانی از مدیریت حرارتی تحت کنترل میزبان)
T}:T{
.sp
0 = پشتیبانی‌نشده، 1 = پشتیبانی‌شده
T}
T{
.sp
\fBThermal Management Temperature 1 (Light throttle)\fR
.br
(دمای ۱ مدیریت حرارتی \- تعدیل ملایم)
T}:T{
.sp
دما برای شروع تعدیل ملایم
T}
T{
.sp
\fBThermal Management Temperature 1 Transition Counter\fR
.br
(شمارندهٔ انتقال به دمای ۱ مدیریت حرارتی)
T}:T{
.sp
تعداد دفعات تغییر به حالت تعدیل ملایم
T}
T{
.sp
\fBThermal Management Temperature 1 Total Time\fR
.br
(مجموع زمان دمای ۱ مدیریت حرارتی)
T}:T{
.sp
تعداد ثانیه‌های سپری‌شده در حالت تعدیل ملایم
T}
T{
.sp
\fBThermal Management Temperature 2 (Heavy throttle)\fR
.br
(دمای ۲ مدیریت حرارتی \- تعدیل سنگین)
T}:T{
.sp
دما برای شروع تعدیل سنگین
T}
T{
.sp
\fBThermal Management Temperature 2 Transition Counter\fR
.br
(شمارندهٔ انتقال به دمای ۲ مدیریت حرارتی)
T}:T{
.sp
تعداد دفعات تغییر به حالت تعدیل سنگین
T}
T{
.sp
\fBThermal Management Temperature 2 Total Time\fR
.br
(مجموع زمان دمای ۲ مدیریت حرارتی)
T}:T{
.sp
تعداد ثانیه‌های سپری‌شده در حالت تعدیل سنگین
T}
T{
.sp
\fBThermal Shutdown Threshold\fR
.br
(آستانهٔ خاموشی حرارتی)
T}:T{
.sp
دمای خاموش شدن دستگاه
T}
.TE
.sp 1
.sp
در صورت موفقیت مقدار 0 بازگردانده می‌شود، در غیر این صورت کد خطا بازگردانده خواهد شد\&.
.SH "گزینه‌ها (OPTIONS)"
.sp
هیچ گزینه‌ای وجود ندارد\&.
.SH "مثال‌ها (EXAMPLES)"
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
نمایش آمارهای دمای دستگاه:
.sp
.if n \{\
.RS 4
.\}
.nf
# nvme wdc vs\-temperature\-stats /dev/nvme0
.fi
.if n \{\
.RE
.\}
.RE
.SH "همچنین ببینید (SEE ALSO)"
.sp
\fBnvme\fR(1)
.SH "NVME"
.sp
بخشی از مجموعهٔ nvme\-user
