'\" t
.nh
.TH podman-manifest 1
.SH "نام (NAME)"
podman-manifest \- ایجاد و دستکاری فهرست‌های مانیفست و نمایه‌های ایمیج

.SH "خلاصه دستور (SYNOPSIS)"
\fBpodman manifest\fP \fIsubcommand\fP

.SH "توضیحات (DESCRIPTION)"
دستور \fBpodman manifest\fR زیردستورهایی را ارائه می‌دهد که می‌توانند برای موارد زیر استفاده شوند:

.EX
* ایجاد یک فهرست مانیفست کاربردی داکر یا نمایه ایمیج OCI.
.EE

.SH "زیردستورها (SUBCOMMANDS)"
.TS
allbox;
l l l 
l l l .
\fBدستور\fP	\fBصفحه راهنما\fP	\fBتوضیحات\fP
add	podman-manifest-add(1)	T{
افزودن یک ایمیج یا دست‌ساخته به فهرست مانیفست یا نمایه ایمیج.
T}
annotate	podman-manifest-annotate(1)	T{
افزودن و به‌روزرسانی اطلاعات درباره یک ایمیج یا دست‌ساخته در فهرست مانیفست یا نمایه ایمیج.
T}
create	podman-manifest-create(1)	T{
ایجاد یک فهرست مانیفست یا نمایه ایمیج.
T}
exists	podman-manifest-exists(1)	T{
بررسی وجود فهرست مانیفست مشخص‌شده در فضای ذخیره‌سازی محلی.
T}
inspect	podman-manifest-inspect(1)	T{
نمایش یک فهرست مانیفست یا نمایه ایمیج.
T}
push	podman-manifest-push(1)	T{
ارسال یک فهرست مانیفست یا نمایه ایمیج به یک رجیستری.
T}
remove	podman-manifest-remove(1)	T{
حذف یک مورد از فهرست مانیفست یا نمایه ایمیج.
T}
rm	podman-manifest-rm(1)	T{
حذف فهرست مانیفست یا نمایه ایمیج از فضای ذخیره‌سازی محلی.
T}
.TE

.SH "مثال‌ها (EXAMPLES)"
.SS ساخت یک فهرست مانیفست چندمعماری از یک Containerfile
با فرض اینکه \fBContainerfile\fR از دستورالعمل‌های \fBRUN\fR استفاده می‌کند، میزبان به راهی برای اجرای باینری‌های غیرمحلی نیاز دارد. پیکربندی این مورد خارج از حوزه این مثال است. ساخت موازی یک فهرست مانیفست چندمعماری به نام \fBshazam\fR در ۴ رشته می‌تواند به این صورت انجام شود:

.EX
    $ platarch=linux/amd64,linux/ppc64le,linux/arm64,linux/s390x
    $ podman build --jobs=4 --platform=$platarch --manifest shazam .
.EE

.PP
\fBنکته:\fP آرگومان \fB--jobs\fR اختیاری است. هنگام ساخت یک فهرست مانیفست چندمعماری، از گزینه \fB--tag\fR (یا \fB-t\fR) دستور \fBpodman build\fR استفاده نکنید.

.SS سرهم‌بندی یک مانیفست چندمعماری از ایمیج‌های ساخته‌شده جداگانه
با فرض اینکه ایمیج‌های \fBexample.com/example/shazam:$arch\fR به‌صورت جداگانه در میزبان‌های دیگر ساخته شده و به رجیستری \fBexample.com\fR ارسال شده‌اند. می‌توان آن‌ها را با استفاده از یک حلقه ساده در یک فهرست مانیفست ترکیب کرد و ارسال نمود:

.EX
    $ REPO=example.com/example/shazam
    $ podman manifest create $REPO:latest
    $ for IMGTAG in amd64 s390x ppc64le arm64; do   
              podman manifest add $REPO:latest docker://$REPO:IMGTAG;   
          done
    $ podman manifest push --all $REPO:latest
.EE

.PP
\fBنکته:\fP ترتیب آرگومان‌ها در دستور \fBadd\fR به صورت \fB<manifest>\fR و سپس \fB<image>\fR است. همچنین، گزینه ارسال \fB--all\fR الزامی است تا اطمینان حاصل شود که تمام محتویات ارسال می‌شوند، نه فقط بستر/معماری بومی سیستم.

.SS حذف و برچسب‌گذاری فهرست مانیفست قبل از ارسال
هنگام حذف و ارسال فهرست‌های مانیفست (برخلاف محتویات آن‌ها)، دقت ویژه‌ای لازم است. شما تقریباً همیشه می‌خواهید از زیردستورهای \fBmanifest rm\fR و \fBmanifest push --all\fR استفاده کنید. برای مثال، تغییر نام و ارسال می‌تواند به این صورت انجام شود:

.EX
    $ podman tag localhost/shazam example.com/example/shazam
    $ podman manifest rm localhost/shazam
    $ podman manifest push --all example.com/example/shazam
.EE

.SH "همچنین ببینید (SEE ALSO)"
\fBpodman(1)\fP, \fBpodman-manifest-add(1)\fP, \fBpodman-manifest-annotate(1)\fP, \fBpodman-manifest-create(1)\fP, \fBpodman-manifest-inspect(1)\fP, \fBpodman-manifest-push(1)\fP, \fBpodman-manifest-remove(1)\fP
