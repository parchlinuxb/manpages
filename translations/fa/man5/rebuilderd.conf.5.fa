.TH "rebuilderd.conf" "5" "2025-08-29"
.PP
.SH "نام (NAME)"
rebuilderd.conf \- فایل‌های پیکربندی \fBrebuilderd\fR و \fBrebuildctl\fR
.PP
.SH "خلاصه دستور (SYNOPSIS)"
.PP
/etc/rebuilderd.conf
.PP
~/.config/rebuilderd.conf
.PP
.SH "توضیحات (DESCRIPTION)"
.PP
این فایل حاوی تنظیمات و پیکربندی‌های هر دو ابزار rebuilderd و rebuildctl است.\&
.PP
.SH "گزینه‌ها (OPTIONS)"
.PP
.SS [http]
.PP
\fIbind_addr=\fR
.RS 4
نشانی مورد نظر برای اتصال (bind).\& مقدار پیش‌فرض آن 127.\&0.\&0.\&1:8484 است.\&
.PP
.RE
\fIreal_ip_header=\fR
.RS 4
اگر از پروکسی معکوس (reverse proxy) استفاده می‌کنید، از این هدر به جای آی‌پی واقعی متصل‌شونده استفاده کنید.\&
اطمینان حاصل کنید که در پروکسی معکوس فیلترهای لازم برای جلوگیری از جعل هویت (spoofing) قرار دارد.\&
این گزینه هیچ مقدار پیش‌فرضی ندارد، اما استفاده از "X-Real-IP" پیشنهاد می‌شود.\&
.PP
.RE
\fIendpoint=\fR
.RS 4
یک نقطه پایانی (endpoint) پیش‌فرض برای rebuildctl تعیین می‌کند.\& این گزینه به‌ویژه برای
تایمر همگام‌سازی مفید است.\& مقدار پیش‌فرض آن \fBhttp://127.\&0.\&0.\&1:8484\fR است.\&
.PP
.RE
.SS [auth]
.PP
\fIcookie=\fR
.RS 4
یک کوکی تصادفی برای احراز هویت مدیران سیستم.\& اگر این مقدار تنظیم نشود،
rebuilderd به‌طور خودکار یک کوکی تولید کرده و آن را در
\fB/var/lib/rebuilderd/auth-cookie\fR می‌نویسد.\& فقط در صورتی نیاز به پیکربندی این مورد دارید که
بخواهید مدیریت را از راه دور انجام دهید.\&
.PP
.RE
.SS [endpoints."https://rebuilder.example.com"]
.PP
\fIcookie=\fR
.RS 4
این بخش معمولاً فقط در \fB~/.config/rebuilderd.conf\fR پیکربندی می‌شود.\& این بخش
امکان تنظیم کوکی برای نمونه‌های جایگزین rebuilderd با گزینه \fB-H\fR را فراهم می‌کند.\& مقداری که
از طریق \fB-H\fR ارسال می‌شود باید دقیقاً با هدر بخش مطابقت داشته باشد؛ اطمینان حاصل کنید
که هیچ اسلش پایانی وجود نداشته باشد.\&
.PP
.RE
.SS [worker]
.PP
\fIauthorized_workers=\fR
.RS 4
لیست سفید کلید عمومی نمونه‌های \fBrebuilderd-worker\fR.\& برای جزئیات، بخش
احراز هویت را در \fBrebuilderd\fR(1) ببینید.\&
.PP
.RE
\fIsignup_secret=\fR
.RS 4
یک راز مشترک (shared secret) را پیکربندی می‌کند که \fBrebuilderd-worker\fR برای
پیوستن باید ارائه دهد.\& برای جزئیات، بخش احراز هویت را در \fBrebuilderd\fR(1)
ببینید.\&
.PP
.RE
.SS [schedule]
.PP
\fIretry_delay_base=\fR
.RS 4
تاخیر تلاش مجدد خودکار برای بازسازی‌های ناموفق را بر حسب ساعت پیکربندی می‌کند.\& مقدار
پیش‌فرض 24 ساعت است؛ این پایه در تعداد تلاش‌های بازسازی ضرب می‌شود؛ بنابراین
اولین تلاش مجدد پس از ۲۴ ساعت رخ می‌دهد، دومین تلاش مجدد ۴۸ ساعت پس از اولین تلاش،
و سومین تلاش مجدد ۷۲ ساعت پس از دومین تلاش خواهد بود.\& هیچ حد بالایی برای تعداد
تلاش‌های مجدد وجود ندارد؛ اگر نمی‌توانید تلاش‌های مکرر را تقبل کنید،
توصیه می‌شود این مقدار را روی عددی بالا مانند 168 (۱ هفته) یا بیشتر تنظیم کنید.\&
بازسازی‌های موفقیت‌آمیز مجدداً تکرار نمی‌شوند.\&
.PP
.RE
.SH "مثال (EXAMPLE)"
.PP
.nf
.RS 4
## پیکربندی برای دیمن http
#[http]
## نشانی مورد نظر برای اتصال. مقدار پیش‌فرض 127.0.0.1:8484 است.
#bind_addr = "0.0.0.0:8484"
## اگر از یک پروکسی معکوس استفاده می‌کنید، از این هدر به جای آی‌پی اتصال استفاده نمایید.
## اطمینان حاصل کنید پروکسی معکوس فیلترهایی برای جلوگیری از جعل هویت دارد.
#real_ip_header = "X-Real-IP"
## تعیین یک نقطه پایانی پیش‌فرض برای rebuildctl. این مورد به‌ویژه برای تایمر همگام‌سازی مفید است.
#endpoint = "http://127.0.0.1:8484"

## یک کوکی تصادفی برای مدیریت در زمان راه‌اندازی تولید شده و در /var/lib/rebuilderd/auth-cookie نوشته می‌شود
## شما می‌توانید در اینجا آن را روی یک مقدار ثابت تنظیم کنید. از `pwgen -1s 32` برای تولید آن استفاده نمایید.
## rebuildctl این کوکی را به ترتیب در ~/.config/rebuilderd.conf، /etc/rebuilderd.conf و
## /var/lib/rebuilderd/auth-cookie جستجو می‌کند.
#[auth]
#cookie = "INSECURE"

## کوکی احراز هویت بالا فقط برای نقطه پایانی پیش‌فرض استفاده می‌شود.
## شما می‌توانید نقاط پایانی متفاوتی را با `rebuildctl -H https://rebuilder.example.com status` به کار ببرید،
## در این حالت اگر بخواهید کوکی اضافه کنید باید یک بخش مانند زیر را پیکربندی نمایید.
#[endpoints."https://rebuilder.example.com"]
#cookie = "INSECURE"

## مهم: در محیط عملیاتی، اطمینان حاصل کنید که `authorized_workers` یا `signup_secret` پیکربندی شده باشد.
#[worker]
## اگر مجموعه ثابتی از ورکرها داریم، می‌توانیم کلیدها را در اینجا مجاز کنیم.
#authorized_workers = ["key1", "key2"]
## اگر بخواهیم ورکرهای جدید را به صورت پویا اضافه کنیم، می‌توانیم رمز ثبت‌نام زیر را تنظیم کنیم.
## از `pwgen -1s 32` برای تولید آن استفاده نمایید.
#signup_secret = "INSECURE"

#[schedule]
## تاخیر برای تلاش مجدد خودکار بازسازی‌های ناموفق بر حسب ساعت. مقدار پیش‌فرض ۲۴ ساعت است
## که در تعداد بازسازی‌ها ضرب می‌شود. بنابراین اولین تلاش مجدد پس از ۲۴ ساعت رخ می‌دهد،
## دومین تلاش ۴۸ ساعت پس از اولین تلاش و سومین تلاش ۷۲ ساعت پس از دومین تلاش خواهد بود.
## هیچ حد بالایی برای تلاش‌ها وجود ندارد؛ اگر تکرار مکرر برایتان مقدور نیست
## توصیه می‌شود این متغیر را روی عدد بزرگی مانند ۱۶۸ (۱ هفته) یا بیشتر بگذارید.
## بازسازی‌های موفق مجدداً تکرار نمی‌شوند.
#retry_delay_base = 24
.fi
.RE
.PP
.SH "همچنین ببینید (SEE ALSO)"
.PP
\fBrebuilderd\fR(1), \fBrebuildctl\fR(1).\&
.PP
.SH "نویسندگان (AUTHORS)"
.PP
برنامه rebuilderd در ابتدا توسط kpcyrd نوشته شده است و در https://github.com/kpcyrd/rebuilderd میزبانی می‌شود
