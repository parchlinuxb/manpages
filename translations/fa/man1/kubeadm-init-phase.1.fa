.TH KUBERNETES(1) kubernetes User Manuals
Eric Paris
Jan 2015

.SH "نام (NAME)"
kubeadm init phase \- Use this command to invoke single phase of the "init" workflow


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubeadm init phase\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
Use this command to invoke single phase of the "init" workflow


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--rootfs\fP=""
	The path to the 'real' host root filesystem. This will cause kubeadm to chroot into the provided path.

.PP
\fB--version\fP=false
	--version, --version=raw prints version information and quits; --version=vX.Y.Z... sets the reported version


.SH "همچنین ببینید (SEE ALSO)"
\fBkubeadm-init(1)\fP, \fBkubeadm-init-phase-addon(1)\fP, \fBkubeadm-init-phase-bootstrap-token(1)\fP, \fBkubeadm-init-phase-certs(1)\fP, \fBkubeadm-init-phase-control-plane(1)\fP, \fBkubeadm-init-phase-etcd(1)\fP, \fBkubeadm-init-phase-kubeconfig(1)\fP, \fBkubeadm-init-phase-kubelet-finalize(1)\fP, \fBkubeadm-init-phase-kubelet-start(1)\fP, \fBkubeadm-init-phase-mark-control-plane(1)\fP, \fBkubeadm-init-phase-preflight(1)\fP, \fBkubeadm-init-phase-show-join-command(1)\fP, \fBkubeadm-init-phase-upload-certs(1)\fP, \fBkubeadm-init-phase-upload-config(1)\fP, \fBkubeadm-init-phase-wait-control-plane(1)\fP,


