.nh
.TH "KubeOne" "1" "Feb 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
kubeone-config-print \- چاپ نمونه پیکربندی کامل KubeOne


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubeone config print [flags]\fP


.SH "توضیحات (DESCRIPTION)"
چاپ یک مانیفست نمونه پیکربندی. با استفاده از فلگ‌های مناسب می‌توانید
مانیفست پیکربندی را سفارشی‌سازی کنید. برای مشاهده مرجع کامل
مانیفست پیکربندی، دستور print را با فلگ \fB\-\-full\fR اجرا کنید.


.SH "گزینه‌ها (OPTIONS)"
\fB--api-endpoint-alternative-names\fP=[]
	فهرست نام‌های جایگزین نقطه پایانی API که با کاما جدا شده‌اند، به عنوان مثال: host.com,192.168.0.100

.PP
\fB--api-endpoint-host\fP=""
	نام میزبان یا نشانی نقطه پایانی API

.PP
\fB--api-endpoint-port\fP=6443
	درگاه نقطه پایانی API

.PP
\fB-n\fP, \fB--cluster-name\fP="demo-cluster"
	نام کلاستر

.PP
\fB--container-log-max-files\fP=5
	حداکثر تعداد فایل‌های گزارش کانتینر (ContainerLogMaxFiles)

.PP
\fB--container-log-max-size\fP="100Mi"
	حداکثر اندازه فایل گزارش کانتینر (ContainerLogMaxSize)

.PP
\fB--control-plane-hosts\fP=""
	میزبان‌های صفحه کنترل در قالب فهرستی از کلید:مقدار که با کاما جدا شده‌اند، به عنوان مثال: publicAddress:192.168.0.100,privateAddress:192.168.1.100,sshUsername:ubuntu,sshPort:22. برای چندین میزبان از رشته درون کوتیشن و جدا شده با فاصله استفاده کنید

.PP
\fB--deploy-machine-controller\fP[=true]
	استقرار machine-controller کوبرماتیک

.PP
\fB--enable-dynamic-audit-log\fP[=false]
	فعال‌سازی گزارش حسابرسی پویا (DynamicAuditLog)

.PP
\fB--enable-encryption-providers\fP[=false]
	فعال‌سازی ارائه‌دهندگان رمزنگاری (Encryption Providers)

.PP
\fB--enable-metrics-server\fP[=true]
	فعال‌سازی metrics-server

.PP
\fB--enable-openid-connect\fP[=false]
	فعال‌سازی احراز هویت OpenID Connect

.PP
\fB--enable-pod-node-selector\fP[=false]
	فعال‌سازی افزونه پذیرش PodNodeSelector

.PP
\fB--enable-pod-security-policy\fP[=false]
	فعال‌سازی PodSecurityPolicy. بدون عمل (NO-OP): این ویژگی حذف شده است

.PP
\fB--enable-static-audit-log\fP[=false]
	فعال‌سازی گزارش حسابرسی ایستا (StaticAuditLog)

.PP
\fB-f\fP, \fB--full\fP[=false]
	نمایش مانیفست کامل

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنمای print

.PP
\fB-k\fP, \fB--kubernetes-version\fP="v1.34.3"
	نسخه کوبرنتیز

.PP
\fB--node-port-range\fP=""
	محدوده درگاه مورد استفاده برای NodePort

.PP
\fB--pod-subnet\fP=""
	زیرشبکه مورد استفاده برای شبکه پادها

.PP
\fB-p\fP, \fB--provider\fP="aws"
	نام ارائه‌دهنده ابری (aws، digitalocean، gce، hetzner، equinixmetal، openstack، vsphere، none)

.PP
\fB--proxy-http\fP=""
	پروکسی HTTP مورد استفاده برای راه‌اندازی و داکر

.PP
\fB--proxy-https\fP=""
	پروکسی HTTPS مورد استفاده برای راه‌اندازی و داکر

.PP
\fB--proxy-no-proxy\fP=""
	لیست No Proxy مورد استفاده برای راه‌اندازی و داکر

.PP
\fB--service-dns\fP=""
	نام دامنه مورد استفاده برای سرویس‌ها

.PP
\fB--service-subnet\fP=""
	زیرشبکه مورد استفاده برای سرویس‌ها


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB-c\fP, \fB--credentials\fP=""
	فایل برای خواندن اطلاعات احراز هویت و اسرار

.PP
\fB-d\fP, \fB--debug\fP[=false]
	خروجی اشکال‌زدایی به همراه ردگیری پشته (stacktrace)

.PP
\fB-l\fP, \fB--log-format\fP="text"
	قالب لاگ‌گیری

.PP
\fB-m\fP, \fB--manifest\fP="./kubeone.yaml"
	مسیر به پیکربندی KubeOne

.PP
\fB-t\fP, \fB--tfjson\fP=""
	منبع خروجی terraform به صورت JSON \- برای خواندن از stdin. اگر مسیر یک فایل باشد، محتوای آن استفاده خواهد شد. اگر مسیر یک پوشه باشد، دستور \fBterraform output \-json\fR در این مسیر اجرا می‌شود

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	خروجی با جزئیات کامل


.SH "مثال (EXAMPLE)"
.EX
kubeone config print --provider digitalocean --kubernetes-version v1.34.3 --cluster-name example
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubeone-config(1)\fP


.SH "تاریخچه (HISTORY)"
