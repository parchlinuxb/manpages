.SS arguments\-out\-of\-order / W1114
.sp
\fBMessage emitted:\fP
.sp
\fBPositional arguments appear to be out of order\fP
.sp
\fBDescription:\fP
.sp
\fIEmitted  when the caller\(aqs argument names fully match the parameter names in the function signature but do not have the same order.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
def function_3_args(first_argument, second_argument, third_argument):
    \(dq\(dq\(dqThree arguments function\(dq\(dq\(dq
    return first_argument, second_argument, third_argument


def args_out_of_order():
    first_argument = 1
    second_argument = 2
    third_argument = 3

    function_3_args(  # [arguments\-out\-of\-order]
        first_argument, third_argument, second_argument
    )

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
def function_3_args(first_argument, second_argument, third_argument):
    \(dq\(dq\(dqThree arguments function\(dq\(dq\(dq
    return first_argument, second_argument, third_argument


def args_out_of_order():
    first_argument = 1
    second_argument = 2
    third_argument = 3

    function_3_args(first_argument, second_argument, third_argument)

.EE
.UNINDENT
.UNINDENT
