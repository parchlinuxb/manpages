.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-plugin-install \- نصب یک افزونه (پلاگین)


.SH "خلاصه دستور (SYNOPSIS)"
\fBdocker plugin install [OPTIONS] PLUGIN [KEY=VALUE...]\fP


.SH "شرح (DESCRIPTION)"
نصب یک افزونه (پلاگین)


.SH "گزینه‌ها (OPTIONS)"
\fB--alias\fP=""
	نام محلی برای افزونه

.PP
\fB--disable\fP[=false]
	عدم فعال‌سازی افزونه هنگام نصب

.PP
\fB--grant-all-permissions\fP[=false]
	اعطای تمام مجوزهای لازم برای اجرای افزونه


.SH "ببینید (SEE ALSO)"
\fBdocker-plugin(1)\fP
