.nh
.TH "HUGO-COMPLETION-POWERSHELL" "1" "Aug 2026" "Hugo 0.165.0" "Hugo Manual"

.SH "نام (NAME)"
hugo-completion-powershell \- تولید اسکریپت تکمیل خودکار پاورشل برای Hugo


.SH "خلاصه دستور (SYNOPSIS)"
\fBhugo completion powershell [flags]\fP


.SH "توضیحات (DESCRIPTION)"
تولید اسکریپت تکمیل خودکار برای پاورشل (powershell).

.PP
جهت بارگذاری تکمیل خودکار در نشست جاری پوستهٔ خود:

.EX
hugo completion powershell | Out-String | Invoke-Expression
.EE

.PP
برای بارگذاری تکمیل خودکار در هر نشست جدید، خروجی دستور بالا را به پروفایل powershell خود اضافه کنید.


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	راهنمای powershell

.PP
\fB--no-descriptions\fP[=false]
	غیرفعال‌سازی توضیحات تکمیل خودکار


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--clock\fP=""
	تنظیم ساعت مورد استفاده توسط Hugo، برای نمونه: \-\-clock 2021-11-06T22:30:00.00+09:00

.PP
\fB--config\fP=""
	فایل پیکربندی (پیش‌فرض: hugo.yaml|json|toml)

.PP
\fB--configDir\fP="config"
	دایرکتوری پیکربندی

.PP
\fB-d\fP, \fB--destination\fP=""
	مسیر سیستم‌فایل برای نوشتن فایل‌ها در آن

.PP
\fB-e\fP, \fB--environment\fP=""
	محیط ساخت

.PP
\fB--ignoreVendorPaths\fP=""
	نادیده گرفتن هرگونه _vendor برای مسیرهای ماژولی که با الگوی Glob داده‌شده مطابقت دارند

.PP
\fB--logLevel\fP=""
	سطح ثبت لاگ (debug|info|warn|error)

.PP
\fB--noBuildLock\fP[=false]
	عدم ایجاد فایل قفل .hugo_build.lock

.PP
\fB--quiet\fP[=false]
	ساخت در حالت بی‌صدا

.PP
\fB-M\fP, \fB--renderToMemory\fP[=false]
	رندر در حافظه (بیشتر هنگام اجرای سرور کاربرد دارد)

.PP
\fB-s\fP, \fB--source\fP=""
	مسیر سیستم‌فایل برای خواندن نسبی فایل‌ها از آن

.PP
\fB--themesDir\fP=""
	مسیر سیستم‌فایل به دایرکتوری قالب‌ها (themes)


.SH "همچنین ببینید (SEE ALSO)"
\fBhugo-completion(1)\fP
