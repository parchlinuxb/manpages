.\"     Title: toxic.conf
.\"    Author: [بخش "نویسندگان" را ببینید]
.\" Generator: DocBook XSL Stylesheets vsnapshot <http://docbook.sf.net>
.\"      Date: 2026-01-16
.\"    Manual: Toxic Manual
.\"    Source: toxic 0.16.2_r2309
.\"  Language: Persian
.\"
.TH "TOXIC\&.CONF" "5" "2026\-01\-16" "toxic 0.16.2_r2309" "Toxic Manual"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
toxic.conf \- فایل پیکربندی برای toxic
.SH "خلاصه دستور (SYNOPSIS)"
.sp
~/\&.config/tox/toxic\&.conf
.SH "توضیحات (DESCRIPTION)"
.sp
فایل \fItoxic\&.conf\fR، فایل پیکربندی اصلی برای کلاینت \fBtoxic\fR(1) است\&. این فایل از نحو پذیرفته‌شده توسط \fBlibconfig\fR استفاده می‌کند\&. خطوطی که با «//» آغاز می‌شوند، توضیحات (کامنت) هستند و نادیده گرفته خواهند شد\&.
.SH "مثال (EXAMPLE)"
.sp
.if n \{\
.RS 4
.\}
.nf
// پیکربندی رابط کاربری
ui = {
    timestamps = true;
    alerts = false;
};

// پیکربندی صدا
audio = {
    input_device = 1;
};
.fi
.if n \{\
.RE
.\}
.SH "گزینه‌ها (OPTIONS)"
.PP
\fBui\fR
.RS 4
پیکربندی مربوط به عناصر رابط کاربری\&.
.PP
\fBtimestamps\fR
.RS 4
فعال یا غیرفعال کردن برچسب‌های زمانی\&. true یا false
.RE
.PP
\fBtime_format\fR
.RS 4
انتخاب میان قالب زمانی ۲۴ ساعته و ۱۲ ساعته\&. ۲۴ یا ۱۲ را مشخص کنید\&. تنظیم timestamp_format و log_timestamp_format این تنظیم را لغو خواهد کرد\&.
.RE
.PP
\fBtimestamp_format\fR
.RS 4
رشته قالب زمان برای رابط کاربری که درون گیومه دوتایی قرار می‌گیرد\&.
\fBdate\fR(1)
را ببینید\&.
.RE
.PP
\fBlog_timestamp_format\fR
.RS 4
رشته قالب زمان برای لاگ‌گیری که درون گیومه دوتایی قرار می‌گیرد\&. (توجه: بخش زمان رشته قالب باید درون کروشه قرار گیرد تا توسط toxic تجزیه شود)\&.
\fBdate\fR(1)
را ببینید\&.
.RE
.PP
\fBalerts\fR
.RS 4
فعال یا غیرفعال کردن هشدارهای صوتی هنگام رویدادها\&. true یا false
.RE
.PP
\fBshow_notification_content\fR
.RS 4
نمایش محتوای اعلان‌های دسکتاپ\&. true یا false
.RE
.PP
\fBnative_colors\fR
.RS 4
انتخاب میان رنگ‌های بومی ترمینال و تم رنگی toxic\&. true یا false
.RE
.PP
\fBcolor_bar_bg\fR
.RS 4
تنظیم رنگ پس‌زمینه نوارهای وضعیت گفتگو\&. (black، white، gray، brown، red، green، blue، cyan، yellow، magenta، orange، pink)
.RE
.PP
\fBcolor_bar_fg\fR
.RS 4
تنظیم رنگ پیش‌زمینه (متن) نوارهای وضعیت گفتگو\&. (black، white، gray، brown، red، green، blue، cyan، yellow، magenta، orange، pink)
.RE
.PP
\fBcolor_bar_accent\fR
.RS 4
تنظیم رنگ اکسنت (تأکیدی) پیش‌زمینه نوارهای وضعیت گفتگو\&. (black، white، gray، brown، red، green، blue، cyan، yellow، magenta، orange، pink)
.RE
.PP
\fBcolor_bar_notify\fR
.RS 4
تنظیم رنگ پیش‌زمینه اعلان (و در حال نوشتن) در نوار وضعیت گفتگو\&. (black، white، gray، brown، red، green، blue، cyan، yellow، magenta، orange، pink)
.RE
.PP
\fBautolog\fR
.RS 4
فعال یا غیرفعال کردن ثبت خودکار وقایع (لاگ‌گیری)\&. true یا false
.RE
.PP
\fBshow_typing_other\fR
.RS 4
نمایش در حال تایپ بودن دیگران در گفتگوی دونفره (۱ به ۱)\&. true یا false
.RE
.PP
\fBshow_typing_self\fR
.RS 4
نمایش در حال تایپ بودن شما برای دیگران در گفتگوی دونفره (۱ به ۱)\&. true یا false
.RE
.PP
\fBshow_welcome_msg\fR
.RS 4
نمایش پیام خوش‌آمدگویی هنگام راه‌اندازی\&. true یا false
.RE
.PP
\fBshow_connection_msg\fR
.RS 4
فعال کردن اعلان‌های تغییر وضعیت اتصال دوستان\&. true یا false
.RE
.PP
\fBshow_group_connection_msg\fR
.RS 4
فعال کردن اعلان‌های تغییر وضعیت اتصال گروه\&. true یا false
.RE
.PP
\fBshow_network_info\fR
.RS 4
نمایش اطلاعات شبکه در پنجره اصلی رابط کاربری\&. true یا false (تنها در صورتی در دسترس است که toxic با قابلیت‌های آزمایشی فعال کامپایل شده باشد)
.RE
.PP
\fBnodelist_update_freq\fR
.RS 4
بسامد به‌روزرسانی فهرست گره‌های DHT بر حسب روز\&. (عدد صحیح؛ 0 برای غیرفعال کردن)
.RE
.PP
\fBautosave_freq\fR
.RS 4
بسامد ذخیره خودکار فایل داده Tox بر حسب ثانیه\&. (عدد صحیح؛ 0 برای غیرفعال کردن)
.RE
.PP
\fBhistory_size\fR
.RS 4
حداکثر تعداد خطوط تاریخچه پنجره گفتگو\&. مقدار عددی صحیح\&. (به عنوان مثال: 700)
.RE
.PP
\fBnotification_timeout\fR
.RS 4
مدت زمان نمایش اعلان بر حسب میلی‌ثانیه\&. مقدار عددی صحیح\&. (به عنوان مثال: 3000)
.RE
.PP
\fBline_join\fR
.RS 4
نشانگر زمان اتصال یا پیوستن شخصی به یک گروه\&. حداکثر ۳ نویسه برای تنظیمات line_\&.
.RE
.PP
\fBline_quit\fR
.RS 4
نشانگر زمان قطع اتصال یا خروج شخصی از یک گروه\&.
.RE
.PP
\fBline_alert\fR
.RS 4
نشانگر پیام‌های هشدار\&.
.RE
.PP
\fBline_normal\fR
.RS 4
نشانگر پیام‌های عادی\&.
.RE
.PP
\fBline_padding\fR
.RS 4
پر کردن هر خط شکسته‌شده از پیام با فاصله‌های کافی برای تراز کردن آن با ابتدای خط نخست\&. true یا false
.RE
.PP
\fBmplex_away\fR
.RS 4
تنظیم وضعیت کاربر هنگام اتصال به و قطع اتصال از GNU screen یا tmux\&. true یا false
.RE
.PP
\fBmplex_away_note\fR
.RS 4
پیام وضعیتی که هنگام تنظیم وضعیت روی away به دلیل جدا شدن (detach) از screen/tmux تنظیم می‌شود\&. هنگام اتصال مجدد (attach)، پیام وضعیت به مقدار اولیه بازگردانده می‌شود\&.
.RE
.PP
\fBgroup_part_message\fR
.RS 4
پیام خروجی که هنگام ترک گروه برای همه اعضای گفتگوی گروهی ارسال خواهد شد\&.
.sp
.if n \{\
.RS 4
.\}
.nf
گزینه‌های زیر کنترل می‌کنند که آیا در رویدادهای مشخص، زنگ ترمینال (terminal bell) به صدا درآید یا خیر\&.
برخی ترمینال‌ها هنگام دریافت زنگ، پنجره را به عنوان فوری (urgent) علامت‌گذاری می‌کنند\&. پنجره‌های فوری معمولاً در نوار وظیفه برجسته می‌شوند و حتی برخی مدیر پنجره‌ها کلیدهای میانبری برای رفتن به پنجره فوری بعدی ارائه می‌دهند\&.
این گزینه‌ها بر گزینه "alerts" تأثیری ندارند\&.
.fi
.if n \{\
.RE
.\}
.RE
.PP
\fBbell_on_message\fR
.RS 4
فعال/غیرفعال کردن زنگ ترمینال هنگام دریافت پیام\&. true یا false
.RE
.PP
\fBbell_on_filetrans\fR
.RS 4
فعال/غیرفعال کردن زنگ ترمینال هنگام دریافت انتقال فایل\&. true یا false
.RE
.PP
\fBbell_on_filetrans_accept\fR
.RS 4
فعال/غیرفعال کردن زنگ ترمینال زمانی که یک انتقال فایل پذیرفته شد\&. true یا false
.RE
.PP
\fBbell_on_invite\fR
.RS 4
فعال/غیرفعال کردن زنگ ترمینال هنگام دریافت دعوت به گروه/تماس\&. true یا false
.RE
.RE
.PP
\fBaudio\fR
.RS 4
پیکربندی مربوط به دستگاه‌های صوتی\&.
.PP
\fBinput_device\fR
.RS 4
دستگاه ورودی صوتی\&. مقدار عددی صحیح\&. این عدد متناظر است با
/lsdev in
.RE
.PP
\fBoutput_device\fR
.RS 4
دستگاه خروجی صوتی\&. مقدار عددی صحیح\&. این عدد متناظر است با
/lsdev out
.RE
.PP
\fBVAD_threshold\fR
.RS 4
آستانه تشخیص فعالیت صوتی (VAD)\&. مقدار ممیز شناور\&. مقادیر پیشنهادی ۱\&.۰\-۴۰\&.۰ است\&.
.RE
.PP
\fBconference_audio_channels\fR
.RS 4
تعداد کانال‌ها برای پخش صوتی کنفرانس\&. مقدار عددی صحیح\&. 1 (مونو) یا 2 (استریو)
.RE
.PP
\fBchat_audio_channels\fR
.RS 4
تعداد کانال‌ها برای پخش صوتی گفتگوی دونفره (۱ به ۱)\&. مقدار عددی صحیح\&. 1 (مونو) یا 2 (استریو)
.RE
.PP
\fBpush_to_talk\fR
.RS 4
فعال/غیرفعال کردن فشار دادن برای صحبت (Push\-To\-Talk) برای گفتگوهای صوتی کنفرانس (کلید فعال‌ساز F2 است)\&. true یا false
.RE
.RE
.PP
\fBtox\fR
.RS 4
پیکربندی مربوط به مسیرها\&.
.PP
\fBdownload_path\fR
.RS 4
مسیر پیش‌فرض برای بارگیری‌ها\&. مقدار رشته‌ای\&. مسیر مطلق برای فایل‌های بارگیری‌شده\&.
.RE
.PP
\fBavatar_path\fR
.RS 4
مسیر آواتار (تصویر نمایه) شما (فایل باید png\&. باشد و نباید از ۱۶\&.۳ کیلوبایت بیشتر شود)
.RE
.PP
\fBautorun_path\fR
.RS 4
مسیر هرگونه اسکریپتی که باید هنگام راه‌اندازی اجرا شود
.RE
.PP
\fBchatlogs_path\fR
.RS 4
مسیر پیش‌فرض برای تاریخچه گفتگوها (chatlogs)\&. مقدار رشته‌ای\&. مسیر مطلق برای فایل‌های تاریخچه گفتگو\&.
.RE
.PP
\fBpassword_eval\fR
.RS 4
جایگزینی اعلان گذرواژه با اجرای این دستور و استفاده از خروجی آن به عنوان گذرواژه\&.
.RE
.RE
.PP
\fBfriends\fR
.RS 4
تنظیمات اختصاصی دوستان (دارای اولویت بالاتر نسبت به تنظیمات سراسری)
.PP
\fBalias\fR
.RS 4
تنظیم نام مستعار برای این دوست\&. مقدار رشته‌ای\&.
.RE
.PP
\fBauto_accept_files\fR
.RS 4
فعال یا غیرفعال کردن پذیرش خودکار انتقال فایل‌های ورودی\&. true یا false
.RE
.PP
\fBautolog\fR
.RS 4
فعال یا غیرفعال کردن ثبت خودکار وقایع (لاگ‌گیری)\&. true یا false
.RE
.PP
\fBshow_connection_msg\fR
.RS 4
فعال کردن اعلان‌های تغییر وضعیت اتصال\&. true یا false
.RE
.PP
\fBtab_name_colour\fR
.RS 4
رنگ نام برگه (تب) پنجره دوست\&. (black، white، gray، brown، red، green، blue، cyan، yellow، magenta، orange، pink)
.RE
.RE
.PP
\fBgroupchats\fR
.RS 4
تنظیمات اختصاصی گفتگوی گروهی (دارای اولویت بالاتر نسبت به تنظیمات سراسری)
.PP
\fBautolog\fR
.RS 4
فعال یا غیرفعال کردن ثبت خودکار وقایع (لاگ‌گیری)\&. true یا false
.RE
.PP
\fBtab_name_colour\fR
.RS 4
رنگ نام برگه (تب) پنجره گروه\&. (black، white، gray، brown، red، green، blue، cyan، yellow، magenta، orange، pink)
.RE
.RE
.PP
\fBconferences\fR
.RS 4
تنظیمات اختصاصی کنفرانس (دارای اولویت بالاتر نسبت به تنظیمات سراسری)
.PP
\fBautolog\fR
.RS 4
فعال یا غیرفعال کردن ثبت خودکار وقایع (لاگ‌گیری)\&. true یا false
.RE
.PP
\fBtab_name_colour\fR
.RS 4
رنگ نام برگه (تب) پنجره کنفرانس\&. (black، white، gray، brown، red، green، blue، cyan، yellow، magenta، orange، pink)
.RE
.RE
.PP
\fBblocked_words\fR
.RS 4
فهرستی از واژگان ناوابسته به بزرگی و کوچکی حروف (case\-insensitive) که نمی‌توانند در پیام‌ها ارسال شوند\&. مقدار رشته‌ای\&. باید درون گیومه دوتایی قرار گیرد و حداکثر ۲۵۶ نویسه باشد\&.
.RE
.PP
\fBsounds\fR
.RS 4
پیکربندی مربوط به صداهای اعلان\&. مقدار ویژه "silent" می‌تواند برای غیرفعال کردن یک اعلان خاص استفاده شود\&.

هر مقدار رشته‌ای است که متناظر با مسیر مطلق یک فایل صوتی wav است\&.
.PP
\fBnotif_error\fR
.RS 4
صدایی که هنگام رخ دادن یک خطا پخش می‌شود\&.
.RE
.PP
\fBself_log_in\fR
.RS 4
صدایی که هنگام ورود شما به سیستم پخش می‌شود\&.
.RE
.PP
\fBself_log_out\fR
.RS 4
صدایی که هنگام خروج شما از سیستم پخش می‌شود\&.
.RE
.PP
\fBuser_log_in\fR
.RS 4
صدایی که هنگام برخط (آنلاین) شدن یک مخاطب پخش می‌شود\&.
.RE
.PP
\fBuser_log_out\fR
.RS 4
صدایی که هنگام برون‌خط (آفلاین) شدن یک مخاطب پخش می‌شود\&.
.RE
.PP
\fBcall_incoming\fR
.RS 4
صدایی که هنگام دریافت یک تماس ورودی پخش می‌شود\&.
.RE
.PP
\fBcall_outgoing\fR
.RS 4
صدایی که هنگام برقراری یک تماس خروجی پخش می‌شود\&.
.RE
.PP
\fBgeneric_message\fR
.RS 4
صدایی که هنگام رخ دادن یک رویداد پخش می‌شود\&.
.RE
.PP
\fBtransfer_pending\fR
.RS 4
صدایی که هنگام دریافت درخواست انتقال فایل پخش می‌شود\&.
.RE
.PP
\fBtransfer_completed\fR
.RS 4
صدایی که هنگام تکمیل انتقال فایل پخش می‌شود\&.
.RE
.RE
.PP
\fBkeys\fR
.RS 4
پیکربندی مربوط به تعامل با رابط کاربری\&. موارد پشتیبانی‌شده کنونی: کلیدهای ترکیبی با Ctrl، کلید Tab، کلیدهای PAGEUP و PAGEDOWN\&.

هر مقدار رشته‌ای است که با یک ترکیب کلید متناظر است\&.
.PP
\fBnext_tab\fR
.RS 4
ترکیب کلید برای رفتن به برگه (تب) بعدی\&.
.RE
.PP
\fBprev_tab\fR
.RS 4
ترکیب کلید برای رفتن به برگه (تب) قبلی\&.
.RE
.PP
\fBscroll_line_up\fR
.RS 4
ترکیب کلید برای پیمایش یک خط به بالا\&.
.RE
.PP
\fBscroll_line_down\fR
.RS 4
ترکیب کلید برای پیمایش یک خط به پایین\&.
.RE
.PP
\fBhalf_page_up\fR
.RS 4
ترکیب کلید برای پیمایش نیم‌صفحه به بالا\&.
.RE
.PP
\fBhalf_page_down\fR
.RS 4
ترکیب کلید برای پیمایش نیم‌صفحه به پایین\&.
.RE
.PP
\fBpage_bottom\fR
.RS 4
ترکیب کلید برای پیمایش به انتهای صفحه\&.
.RE
.PP
\fBtoggle_peerlist\fR
.RS 4
فعال یا غیرفعال کردن نمایش فهرست همتایان (peers)\&.
.RE
.PP
\fBtoggle_paste_mode\fR
.RS 4
تغییر حالت تلقی شکستن خط به عنوان فشردن کلید Enter\&.
.RE
.PP
\fBreload_config\fR
.RS 4
بارگذاری مجدد فایل پیکربندی Toxic\&.
.RE
.RE
.SH "اشکالات (BUGS)"
.sp
\-رنگ‌های غیرپیش‌فرض (gray، brown، orange و pink) در شبیه‌سازهای ترمینالی که از ۲۵۶ رنگ پشتیبانی نمی‌کنند کار نخواهند کرد\&. شبیه‌سازهای Konsole، qterminal و احتمالاً موارد دیگر نیز دارای مشکلاتی با این رنگ‌ها شناخته شده‌اند\&. اگر از screen یا tmux استفاده می‌کنید، آن را طوری پیکربندی کنید که از متغیر محیطی TERM با مقدار xterm\-256color استفاده کند\&.
.sp
\-هنگام بارگذاری مجدد فایل پیکربندی در یک نشست فعال، برخی از تغییرات رابط کاربری ممکن است دچار اشکال شوند و نیاز به راه‌اندازی مجدد کامل کلاینت داشته باشند\&.
.SH "فایل‌ها (FILES)"
.PP
