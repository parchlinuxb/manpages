.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-runner-list \- فهرست کردن رانرها.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab runner list [flags]\fP


.SH "توضیحات (DESCRIPTION)"
فهرست کردن رانرها برای یک پروژه (پیش‌فرض)، گروه یا کل نمونه (instance).

.PP
محدوده نمونه (instance) نیازمند دسترسی مدیر (administrator) است.


.SH "گزینه‌ها (OPTIONS)"
\fB-g\fP, \fB--group\fP=""
	فهرست کردن رانرها برای یک گروه. در صورت تنظیم -R/--repo نادیده گرفته می‌شود.

.PP
\fB-i\fP, \fB--instance\fP[=false]
	فهرست کردن تمام رانرهای در دسترس کاربر (در محدوده نمونه).

.PP
\fB--jq\fP=""
	فیلتر کردن خروجی JSON با یک عبارت jq.

.PP
\fB-F\fP, \fB--output\fP="text"
	قالب‌بندی خروجی به‌صورت: text یا json.

.PP
\fB-p\fP, \fB--page\fP=1
	شماره صفحه.

.PP
\fB-P\fP, \fB--per-page\fP=30
	تعداد موارد برای فهرست کردن در هر صفحه.

.PP
\fB-R\fP, \fB--repo\fP=""
	انتخاب مخزنی دیگر. می‌توانید از OWNER/REPO یا GROUP/NAMESPACE/REPO استفاده کنید. نشانی کامل URL یا نشانی Git نیز پذیرفته می‌شود.


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB-h\fP, \fB--help\fP[=false]
	نمایش راهنما برای این دستور.


.SH "مثال‌ها (EXAMPLES)"
.EX
# فهرست کردن رانرها برای پروژه فعلی
glab runner list

# فهرست کردن رانرها برای یک پروژه مشخص
glab runner list -R owner/repo

# فهرست کردن رانرها برای یک گروه
glab runner list --group mygroup

# فهرست کردن رانرها به‌صورت JSON
glab runner list --output json
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-runner(1)\fP
