.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
nvme-sed-unlock \- باز کردن قفل یک دستگاه SED Opal
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.nf
\fInvme sed unlock\fR [\-\-read\-only | \-r] [\-\-ask\-key | \-k]  <device>
.fi
.SH "توضیحات (DESCRIPTION)"
.sp
قفل دستگاه NVMe مشخص‌شده را باز می‌کند\&.
.SH "گزینه‌ها (OPTIONS)"
.PP
\-r, \-\-read\-only
.RS 4
تنظیم محدودهٔ قفل‌گذاری روی حالت فقط‌خواندنی\&.
.RE
.PP
\-k, \-\-ask\-key
.RS 4
درخواست کلید احراز هویت SED از کاربر\&.
.RE
.SH "مثال‌ها (EXAMPLES)"
.sp
nvme sed unlock /dev/nvme5n1
.SH "همچنین ببینید (SEE ALSO)"
.sp
\fBnvme\fR(1)،
\fBnvme\-sed\-lock\fR(1)
.SH "NVME"
.sp
بخشی از nvme\-cli
