.\" DO NOT MODIFY THIS FILE!  It was generated by help2man 1.49.3.
.TH VIRT-CLOUD-BOOT "1" "September 2026" "virt-cloud-boot 26.9" "User Commands"
.SH "نام (NAME)"
virt-cloud-boot \- manual page for virt-cloud-boot 26.9
.SH "توضیحات (DESCRIPTION)"
usage: virt\-cloud\-boot [\-h] [\-\-dry\-run] [\-i FILE] [\-\-fedora VER]
.TP
[\-\-fedora\-uki VER] [\-\-centos VER] [\-\-rhel VER]
[\-\-alma VER] [\-\-ubuntu VER] [\-\-imgdir DIR] [\-\-list]
[\-u USER] [\-\-password PASSWD] [\-\-package PKG]
[\-\-copy\-file FILE] [\-\-runcmd CMD] [\-\-no\-uefi] [\-\-smm]
[\-\-qemu\-vars] [\-\-secure\-boot]
[\-\-cc\-mode {none,sev,snp,tdx}] [\-\-sev] [\-\-snp] [\-\-tdx]
[\-\-log FILE] [\-\-memory MEM] [\-\-smp CPUS]
[\-\-scsi | \fB\-\-no\-scsi]\fR [\-\-sata | \fB\-\-no\-sata]\fR
[\-\-nvme | \fB\-\-no\-nvme]\fR [\-\-vblk | \fB\-\-no\-vblk]\fR
[\-\-ufs | \fB\-\-no\-ufs]\fR [\-\-ssh\-port PORT]
[\-\-ssh\-agent | \fB\-\-no\-ssh\-agent]\fR
.PP
boot cloud image
.SS "options:"
.TP
\fB\-h\fR, \fB\-\-help\fR
show this help message and exit
.TP
\fB\-\-dry\-run\fR, \fB\-\-dryrun\fR
print generated qemu command line and quit
.SS "select cloud image:"
.TP
\fB\-i\fR, \fB\-\-image\fR FILE
boot cloud image FILE
.TP
\fB\-\-fedora\fR VER
boot fedora VER
.TP
\fB\-\-fedora\-uki\fR VER
boot fedora VER (uki variant)
.TP
\fB\-\-centos\fR VER
boot centos stream VER
.TP
\fB\-\-rhel\fR VER
boot rhel VER
.TP
\fB\-\-alma\fR VER
boot almalinux VER
.TP
\fB\-\-ubuntu\fR VER
boot ubuntu VER
.TP
\fB\-\-imgdir\fR DIR
lookup fedora/centos/rhel images in DIR (default:
\fI\,/vmdisk/iso/distro\/\fP)
.TP
\fB\-\-list\fR
list cloud images in \fI\,/vmdisk/iso/distro\/\fP
.SS "setup cloud image:"
.TP
\fB\-u\fR, \fB\-\-username\fR, \fB\-\-user\fR USER
login username (default: cloud)
.TP
\fB\-\-password\fR, \fB\-\-passwd\fR PASSWD
login password (default: cloud)
.TP
\fB\-\-package\fR, \fB\-\-rpm\fR PKG
install package PKG
.TP
\fB\-\-copy\-file\fR FILE
copy FILE into the guest
.TP
\fB\-\-runcmd\fR CMD
run CMD in guest
.SS "firmware setup:"
.TP
\fB\-\-no\-uefi\fR
skip uefi firmware setup (boot with qemu default
firmware)
.TP
\fB\-\-smm\fR
use smm firmware builds (feature "require\-smm")
.TP
\fB\-\-qemu\-vars\fR, \fB\-\-qemuvars\fR
use qemu uefi vars (feature "host\-uefi\-vars")
.TP
\fB\-\-secure\-boot\fR, \fB\-\-sb\fR
enable secure boot (feature "enrolled\-keys")
.TP
\fB\-\-cc\-mode\fR {none,sev,snp,tdx}
set confidential computing mode (default: none)
.TP
\fB\-\-sev\fR
enable sev cc mode (feature "amd\-sev")
.TP
\fB\-\-snp\fR
enable snp cc mode (feature "amd\-sev\-snp")
.TP
\fB\-\-tdx\fR
enable tdx cc mode (feature "intel\-tdx")
.TP
\fB\-\-log\fR FILE
write firmware log to FILE
.SS "hardware setup:"
.TP
\fB\-\-memory\fR, \fB\-\-mem\fR MEM
assign guest memory (default: 4G)
.TP
\fB\-\-smp\fR CPUS
assign guest vcpus (default: 1)
.TP
\fB\-\-scsi\fR, \fB\-\-no\-scsi\fR
use virtio scsi (default: yes)
.TP
\fB\-\-sata\fR, \fB\-\-no\-sata\fR
use sata (q35 only, default: no)
.TP
\fB\-\-nvme\fR, \fB\-\-no\-nvme\fR
use NVMe emulation (default: no)
.TP
\fB\-\-vblk\fR, \fB\-\-no\-vblk\fR
use virtio block (default: no)
.TP
\fB\-\-ufs\fR, \fB\-\-no\-ufs\fR
use universal flash storage (default: no)
.SS "network setup:"
.TP
\fB\-\-ssh\-port\fR PORT
forward ssh connections to localhost:PORT to the guest
.TP
\fB\-\-ssh\-agent\fR, \fB\-\-no\-ssh\-agent\fR
get public ssh keys from ssh agent (default: yes)
.SH "محیط (ENVIRONMENT)"

.TP
VIRT_DISTRO_IMGDIR
default cloud image directory
.SH "نویسنده (AUTHOR)"

Gerd Hoffmann <kraxel@redhat.com>
