.TH "CRYSTAL\-TOOL\-MACRO_CODE_COVERAGE" "1" "2026-07-23" "crystal 1.21.0" "Crystal Compiler Command Line Reference Guide"
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.ss \n[.ss] 0
.nh
