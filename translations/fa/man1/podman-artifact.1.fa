'\" t
.nh
.TH podman-artifact 1
.SH "نام (NAME)"
podman-artifact \- مدیریت مصنوعات OCI در پادمن

.SH "خلاصه دستور (SYNOPSIS)"
\fBpodman artifact\fP \fIsubcommand\fP

.SH "توضیحات (DESCRIPTION)"
دستور \fBpodman artifact\fR مجموعه‌ای از زیردستورها برای مدیریت مصنوعات OCI است.

.PP
مصنوعات OCI روشی متداول برای توزیع فایل‌های مرتبط با تصاویر و کانتینرهای OCI هستند. پادمن قادر است این مصنوعات را از «مخزن مصنوعات» محلی خود مدیریت (دریافت، بررسی، ارسال) کند.

.SH "زیردستورها (SUBCOMMANDS)"
.TS
allbox;
l l l
l l l .
\fBدستور\fP	\fBصفحه راهنما\fP	\fBتوضیحات\fP
add	podman-artifact-add(1)	T{
افزودن یک مصنوع OCI به مخزن مصنوعات محلی
T}
extract	podman-artifact-extract(1)	T{
استخراج یک مصنوع OCI به یک مسیر محلی
T}
inspect	podman-artifact-inspect(1)	T{
بررسی یک مصنوع OCI
T}
ls	podman-artifact-ls(1)	T{
فهرست کردن مصنوعات OCI در مخزن محلی (نام مستعار list)
T}
pull	podman-artifact-pull(1)	T{
دریافت یک مصنوع از یک رجیستری و ذخیره آن در سطح محلی
T}
push	podman-artifact-push(1)	T{
ارسال یک مصنوع OCI از ذخیره‌ساز محلی به یک رجیستری تصویر
T}
rm	podman-artifact-rm(1)	T{
حذف یک یا چند مصنوع OCI از ذخیره‌ساز محلی
T}
.TE

.SH "همچنین ببینید (SEE ALSO)"
\fBpodman(1)\fP

