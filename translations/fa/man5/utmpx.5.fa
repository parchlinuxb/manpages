.TH "UTMPX" "5" "مه ۲۰۲۵" "man-pages" "فایلهای پیکربندی"
.SH "نام (NAME)"
utmpx \- ساختار و رکوردهای ورود کاربر و وضعیت سیستم
.SH "خلاصه (SYNOPSIS)"
.nf
.B #include <utmpx.h>
.fi
.SH "توضیحات (DESCRIPTION)"
پروندههای \fIutmpx\fR و ساختار دادههای متناظر، سوابق ورود کاربران، پایگاهداده زمانهای ورود و خروج، فرآیندهای راهاندازی و وضعیت جاری سیستم را ذخیره مینمایند.
پرونده
.I utmpx
(و همچنین
.IR utmp )
امکان کسب اطلاعات درباره افرادی را که هم‌اکنون از سیستم استفاده می‌کنند، فراهم می‌سازد. با این حال ممکن است تعداد کاربران در حال استفاده بیشتر از رکوردهای موجود باشد، زیرا همه برنامه‌ها از ثبت گزارش در این پایگاه داده استفاده نمی‌کنند.
.PP
.B هشدار:
پرونده
.I utmpx
نباید برای دسته کاربران «دیگران» (other) دسترسی نوشتن داشته باشد؛ چرا که بسیاری از ابزارهای سیستمی به درستی و دست‌نخورده بودن آن وابسته‌اند. اگر به کاربرانی غیر از مالک پرونده و گروه مالکی آن اجازه نوشتن بدهید، سیستم در معرض خطر جعل لاگ‌ها و تغییر غیرمجاز پرونده‌های سیستمی قرار خواهد گرفت.
.PP
این پرونده توالی یا دنباله‌ای از ساختارهای
.I utmpx
است که در پرونده سربرگ
.I <utmpx.h>
(و معادل آن
.I struct utmp
در
.IR <utmp.h> )
به صورت زیر تعریف شده است:
.PP
.in +4n
.EX
/* مقادیر مجاز برای فیلد ut_type */

#define EMPTY         0 /* رکورد حاوی اطلاعات معتبر نیست */
#define RUN_LVL       1 /* تغییر سطح اجرای سیستم (نگاه کنید به init(1)) */
#define BOOT_TIME     2 /* زمان راه‌اندازی سیستم (در ut_tv) */
#define NEW_TIME      3 /* زمان پس از تغییر ساعت سیستم (در ut_tv) */
#define OLD_TIME      4 /* زمان پیش از تغییر ساعت سیستم (در ut_tv) */
#define INIT_PROCESS  5 /* فرآیند مشتق‌شده از init(1) */
#define LOGIN_PROCESS 6 /* فرآیند راهبر نشست برای ورود کاربر */
#define USER_PROCESS  7 /* فرآیند عادی کاربر */
#define DEAD_PROCESS  8 /* فرآیند خاتمه‌یافته */
#define ACCOUNTING    9 /* پیاده‌سازی نشده است */

#define UT_LINESIZE      32
#define UT_NAMESIZE      32
#define UT_HOSTSIZE     256

struct exit_status {              /* نوع داده برای فیلد ut_exit */
    short e_termination;          /* وضعیت خاتمه فرآیند */
    short e_exit;                 /* وضعیت خروج فرآیند */
};

struct utmpx {
    short   ut_type;              /* نوع رکورد */
    pid_t   ut_pid;               /* شناسه PID فرآیند ورود */
    char    ut_line[UT_LINESIZE]; /* نام دستگاه ترمینال بدون پیشوند "/dev/" */
    char    ut_id[4];             /* پسوند نام ترمینال یا شناسه inittab(5) */
    char    ut_user[UT_NAMESIZE]; /* نام کاربری */
    char    ut_host[UT_HOSTSIZE]; /* نام میزبان در ورود از راه دور یا نسخه هسته */
    struct  exit_status ut_exit;  /* وضعیت خروج فرآیندی که خاتمه یافته است */

    /* فیلدهای ut_session و ut_tv در کامپایل ۳۲ و ۶۴ بیتی باید یک‌اندازه باشند */
#if __WORDSIZE == 64 && defined __WORDSIZE_COMPAT32
    int32_t ut_session;           /* شناسه نشست (getsid(2)) برای پنجره‌بندی */
    struct {
        int32_t tv_sec;           /* ثانیه */
        int32_t tv_usec;          /* میکروثانیه */
    } ut_tv;                      /* زمان ایجاد رکورد */
#else
     long   ut_session;           /* شناسه نشست */
     struct timeval ut_tv;        /* زمان ایجاد رکورد */
#endif

    int32_t ut_addr_v6[4];        /* نشانی اینترنتی میزبان راه دور (IPv4 در خانه اول) */
    char __unused[20];            /* رزرو شده برای کاربردهای آینده */
};
.EE
.in
.PP
.SS "فیلدهای ساختار struct utmpx"
فیلدهای این ساختار عبارتند از:
.TP
.I ut_type
نوع رکورد ورود یا رویداد را مشخص می‌کند (مانند
.BR BOOT_TIME ،
.BR INIT_PROCESS ،
.BR LOGIN_PROCESS ،
.BR USER_PROCESS
یا
.BR DEAD_PROCESS ).
.TP
.I ut_pid
شناسه عددی فرآیند
.RB ( PID )
مربوط به فرآیند ورود یا نشست جاری.
.TP
.I ut_line
نام فایل دستگاه ترمینال متناظر با کاربر بدون پیشوند
.I /dev/
(مانند tty1 یا pts/0).
.TP
.I ut_id
شناسه ترمینال یا پسوند نام آن یا شناسه رکورد در
.BR inittab (5)
که برای متمایز ساختن نشست‌ها و پایانه‌ها استفاده می‌شود.
.TP
.I ut_user
نام کاربری فردی که وارد سیستم شده است.
.TP
.I ut_host
نام میزبان
.RB ( Hostname )
برای اتصال و ورود از راه دور از طریق شبکه، یا نسخه هسته برای پیام‌های سطح اجرای سیستم.
.TP
.I ut_exit
وضعیت خروج فرآیندی که خاتمه یافته و با برچسب
.B DEAD_PROCESS
مشخص شده است. این فیلد شامل
.I e_termination
(سیگنال خاتمه فرآیند) و
.I e_exit
(کد بازگشتی خروج) می‌باشد که توسط
.BR init (1)
لینوکس استفاده نمی‌شود.
.TP
.I ut_session
شناسه نشست
.RB ( "Session ID" )
برای مدیریت رابط کاربری پنجره‌ای و دسته‌بندی پردازه‌ها.
.TP
.I ut_tv
زمان ایجاد یا ثبت این رکورد بر حسب ثانیه و میکروثانیه، منطبق بر ساختار زمانی
.BR gettimeofday (2).
.TP
.I ut_addr_v6
نشانی اینترنتی
.RB ( IP )
میزبان راه دور؛ در ارتباطات پروتکل اینترنت نسخه ۴ (IPv4)، تنها بخش اول یعنی
.B ut_addr_v6[0]
به کار گرفته می‌شود.
.PP
این ساختار، نام فایل خاص مربوط به ترمینال کاربر، نام کاربری ورود به سیستم و زمان ورود را به شکل فرمت زمانی تابع
.BR time (2)
ارائه می‌دهد. فیلدهای متنی و رشته‌ای در صورتی که طول آنها کمتر از اندازه فیلد باشد، به یک بایت تهی
.RB ( \[aq]\[rs]0\[aq] )
ختم می‌شوند.
.PP
اولین رکوردهایی که در این پایگاه داده ساخته می‌شوند ناشی از پردازش فایل
.BR inittab (5)
توسط فرآیند
.BR init (1)
هستند. با این وجود، پیش از پردازش هر رکورد،
.BR init (1)
با تغییر دادن
.I ut_type
به
.BR DEAD_PROCESS
و پاک‌سازی فیلدهای
.IR ut_user ،
.I ut_host
و
.I ut_time
با بایت‌های تهی، پایگاه داده utmpx را برای هر رکوردی که وضعیت آن
.B DEAD_PROCESS
یا
.B RUN_LVL
نیست و فرآیندی با شناسه
.I ut_pid
برای آن در سیستم وجود ندارد، مرتب و پاک‌سازی می‌نماید. اگر هیچ رکورد خالی با شناسه مورد نیاز
.I ut_id
یافت نشود،
.BR init (1)
یک رکورد جدید ایجاد می‌کند؛ فیلد
.I ut_id
را از inittab می‌خواند، فیلدهای
.I ut_pid
و
.I ut_time
را با مقادیر جاری تنظیم می‌کند و
.I ut_type
را برابر با
.B INIT_PROCESS
قرار می‌دهد.
.PP
برنامه‌های ورود به پایانه مانند
.BR mingetty (8)
یا
.BR agetty (8)
رکورد مربوطه را از طریق شناسه فرآیند (PID) پیدا می‌کنند،
.I ut_type
را به
.B LOGIN_PROCESS
تغییر می‌دهند، زمان
.I ut_time
را به‌روزرسانی کرده، فیلد
.I ut_line
را مقداردهی می‌کنند و منتظر برقراری اتصال و ورود می‌مانند. سپس برنامه
.BR login (1)
پس از احراز هویت موفق کاربر، فیلد
.I ut_type
را به
.B USER_PROCESS
تغییر داده،
.I ut_time
را به‌روزرسانی و فیلدهای
.I ut_host
و
.I ut_addr
را تنظیم می‌کند. بسته به پیاده‌سازی
.BR mingetty (8)
(یا
.BR agetty (8))
و
.BR login (1)،
رکوردها ممکن است به جای فیلد ارجح
.IR ut_pid ،
بر اساس
.I ut_line
مکان‌یابی شوند.
.PP
هنگامی که
.BR init (1)
تشخیص می‌دهد که فرآیندی پایان یافته است، رکورد متناظر با آن را در utmpx به کمک
.I ut_pid
پیدا می‌کند، فیلد
.I ut_type
را به
.B DEAD_PROCESS
تغییر می‌دهد و فیلدهای
.IR ut_user ،
.I ut_host
و
.I ut_time
را با بایت‌های تهی پاک می‌کند.
.PP
شبیه‌سازهای ترمینال مانند
.BR xterm (1)
مستقیماً یک رکورد از نوع
.B USER_PROCESS
ایجاد نموده و مقدار
.I ut_id
را با استفاده از پسوند نام ترمینال (نویسه‌های پس از
.IR /dev/[pt]ty )
تولید می‌کنند. اگر رکوردی از نوع
.B DEAD_PROCESS
با این شناسه بیابند، آن را بازیافت کرده و دوباره استفاده می‌کنند؛ در غیر این صورت یک رکورد تازه پدید می‌آورند. در هنگام خروج نیز در صورت امکان آن را با
.B DEAD_PROCESS
علامت‌گذاری می‌کنند و توصیه شده است که فیلدهای
.IR ut_line ،
.IR ut_time ،
.I ut_user
و
.I ut_host
را نیز با بایت تهی پاک نمایند.
.PP
برنامه
.BR telnetd (8)
یک رکورد
.B LOGIN_PROCESS
تنظیم می‌کند و باقی مراحل را مطابق روال معمول به
.BR login (1)
می‌سپارد. پس از پایان نشست شبکه،
.BR telnetd (8)
رکورد را به شیوه شرح داده شده پاک‌سازی می‌نماید.
.PP
پرونده
.I wtmp
(و همتای آن
.IR wtmpx )
تمام رخدادهای ورود و خروج را ثبت و نگهداری می‌کند. ساختار آن دقیقاً مشابه
.I utmpx
است، با این تفاوت که یک نام کاربری تهی نشان‌دهنده خروج از ترمینال مربوطه است. علاوه بر این، نام ترمینال
.B \[ti]
همراه با نام کاربری
.B shutdown
یا
.B reboot
نشان‌دهنده خاموش شدن یا راه‌اندازی مجدد سیستم است و جفت‌نام ترمینال‌های
.BR | / }
زمان قدیم و جدید سیستم را هنگامی که با دستور
.BR date (1)
تغییر داده شود، ثبت می‌کنند. پرونده
.I wtmp
توسط برنامه‌های
.BR login (1)،
.BR init (1)
و برخی نسخه‌های
.BR getty (8)
(مانند
.BR mingetty (8)
یا
.BR agetty (8))
مدیریت و نگهداری می‌شود. هیچ‌یک از این برنامه‌ها پرونده مذکور را از ابتدا ایجاد نمی‌کنند؛ بنابراین در صورتی که این پرونده حذف شود، ثبت سوابق غیرفعال می‌گردد.
.SH "فایل‌ها (FILES)"
.I /var/run/utmp
.br
.I /run/utmp
.br
.I /var/log/wtmp
.SH "نسخه‌ها (VERSIONS)"
استاندارد POSIX.1 ساختار
.I utmp
را مشخص نمی‌کند، بلکه ساختاری با نام
.I utmpx
(به عنوان بخشی از الحاقیه XSI) با مشخصات فیلدهای
.IR ut_type ،
.IR ut_pid ،
.IR ut_line ،
.IR ut_id ،
.IR ut_user
و
.I ut_tv
تعریف کرده است. استاندارد POSIX.1 طول فیلدهای
.I ut_line
و
.I ut_user
را مشخص نمی‌کند.
.PP
سیستم‌عامل لینوکس ساختار
.I utmpx
را دقیقاً همانند ساختار
.I utmp
تعریف نموده است.
.SH "استانداردها (STANDARDS)"
POSIX.1-2008، Linux.
.SH "تاریخچه (HISTORY)"
رکوردهای utmp و utmpx در لینوکس نه کاملاً منطبق بر نسخه ۷ یا BSD هستند و نه System V؛ بلکه ترکیبی از هر دو می‌باشند.
.PP
نسخه v7/BSD فیلدهای کمتری دارد؛ مهم‌تر از همه فیلد
.I ut_type
در آن وجود ندارد، که باعث می‌شود برنامه‌های سبک سنتی BSD رکوردهای خاتمه‌یافته یا مربوط به فرآیندهای ورود را نیز به عنوان کاربر فعال نمایش دهند. علاوه بر این، هیچ فایل پیکربندی برای تخصیص شیارها به نشست‌ها وجود ندارد، زیرا BSD فاقد فیلد
.I ut_id
است.
.PP
در لینوکس (همانند System V)، مقدار فیلد
.I ut_id
یک رکورد پس از مقداردهی اولیه هرگز تغییر نمی‌کند و بدون نیاز به فایل پیکربندی، آن شیار را رزرو نگاه می‌دارد. پاک کردن
.I ut_id
ممکن است منجر به شرایط رقابتی (race condition)، مخدوش شدن رکوردهای utmp/utmpx و رخنه‌های امنیتی گردد. پاک‌سازی سایر فیلدها با پر کردن بایت تهی در معناشناسی System V الزامی نبوده، اما باعث می‌شود بسیاری از برنامه‌های مبتنی بر BSD که utmp را تغییر نمی‌دهند نیز بتوانند به درستی کار کنند. سیستم‌عامل لینوکس در مورد محتوای خطوط ترمینال از قواعد BSD پیروی می‌کند.
.PP
سیستم‌عامل System V فاقد فیلدهای
.I ut_host
یا
.I ut_addr_v6
است.
.SH "نکات (NOTES)"
برخلاف برخی سیستم‌های دیگر که ثبت اطلاعات utmp را می‌توان با حذف فایل متوقف کرد، در لینوکس پرونده utmp/utmpx باید همیشه وجود داشته باشد. اگر مایلید دستور
.BR who (1)
را غیرفعال کنید، دسترسی خواندن همگانی utmp را مسدود نمایید.
.PP
فرمت این پرونده وابسته به معماری پردازنده (machine-dependent) است؛ از این رو توصیه می‌شود تنها در همان معماری که تولید شده پردازش و خوانده شود.
.PP
توجه داشته باشید که در پلتفرم‌های دوگانه (biarch) مانند x86-64 و ppc64 که می‌توانند هر دو نوع برنامه‌های ۳۲ بیتی و ۶۴ بیتی را به طور هم‌زمان اجرا کنند، اندازه فیلد
.I ut_tv
در حالت ۳۲ بیتی دقیقاً برابر با حالت ۶۴ بیتی در نظر گرفته شده است. همین موضوع در صورت وجود، برای فیلدهای
.I ut_session
و
.I ut_time
نیز صادق است. این امر اشتراک‌گذاری داده‌ها و حافظه مشترک را میان برنامه‌های ۳۲ و ۶۴ بیتی میسر می‌سازد. این سازگاری با تغییر دادن نوع
.I ut_session
به
.I int32_t
و نوع
.I ut_tv
به یک ساختار با دو فیلد
.I int32_t
شامل
.I tv_sec
و
.I tv_usec
حاصل شده است.
.PP
از آنجا که
.I ut_tv
ممکن است دقیقاً با
.I struct timeval
یکسان نباشد، به جای فراخوانی:
.PP
.in +4n
.EX
gettimeofday((struct timeval *) &ut.ut_tv, NULL);
.EE
.in
.PP
رویکرد زیر برای مقداردهی این فیلد پیشنهاد و توصیه می‌شود:
.PP
.in +4n
.EX
struct utmpx ut;
struct timeval tv;

gettimeofday(&tv, NULL);
ut.ut_tv.tv_sec = tv.tv_sec;
ut.ut_tv.tv_usec = tv.tv_usec;
.EE
.in
.SH "همچنین ببینید (SEE ALSO)"
.BR ac (1),
.BR date (1),
.BR init (1),
.BR last (1),
.BR login (1),
.BR logname (1),
.BR lslogins (1),
.BR users (1),
.BR utmpdump (1),
.BR who (1),
.BR getutent (3),
.BR getutmp (3),
.BR getutxent (3),
.BR login (3),
.BR logout (3),
.BR logwtmp (3),
.BR updwtmp (3)
