.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-plugin-rm \- حذف یک یا چند افزونه


.SH "خلاصه دستور (SYNOPSIS)"
\fBdocker plugin rm [OPTIONS] PLUGIN [PLUGIN...]\fP


.SH "شرح (DESCRIPTION)"
حذف یک یا چند افزونه


.SH "گزینه‌ها (OPTIONS)"
\fB-f\fP, \fB--force\fP[=false]
	اجبار در حذف یک افزونه فعال


.SH "ببینید (SEE ALSO)"
\fBdocker-plugin(1)\fP
