.\" Pipe this output to groff -m man -K utf8 -T utf8 | less -R
.\"
.mso an.tmac
.TH "DUNE-INTERNAL" 1 "" "Dune 3.24.2" "Dune Manual"
.\" Disable hyphenation and ragged-right
.nh
.ad l
.SH "نام (NAME)"
.P
dune\N'45'internal \- دستورات داخلی دونه (Dune)
.SH "خلاصه دستور (SYNOPSIS)"
.P
\fBdune internal\fR \fICOMMAND\fR …
.SH "دستورات (COMMANDS)"
.TP 4
\fBbootstrap\N'45'info\fR [\fIOPTION\fR]…
چاپ اطلاعات بوت‌استرپ تولیدشده برای خود دونه\N'46'
.TP 4
\fBdigest\N'45'db\fR \fICOMMAND\fR …
بررسی پایگاه‌داده دایجست دائمی دونه\N'46'
.TP 4
\fBdump\fR [\fIOPTION\fR]… \fIFILE\fR
تخلیه محتوای یک فایل ذخیره‌شده در پایگاه‌داده دائمی دونه\N'46'
.TP 4
\fBlatest\N'45'lang\N'45'version\fR [\fIOPTION\fR]…
چاپ آخرین نسخه زبان\N'46'
.TP 4
\fBsexp\N'45'pp\fR [\fB\N'45'\N'45'format\fR=\fIFORMAT\fR] [\fIOPTION\fR]… [\fIFILE\fR]
چاپ قالب‌بندی‌شده s-expressionهای خوانده‌شده از ورودی استاندارد (stdin) یا یک فایل\N'46'
.SH "گزینه‌های عمومی (COMMON OPTIONS)"
.TP 4
\fB\N'45'\N'45'help\fR[=\fIFMT\fR] (پیش‌فرض=\fBauto\fR)
نمایش این راهنما در قالب \fIFMT\fR\N'46' مقدار \fIFMT\fR باید یکی از \fBauto\fR، \fBpager\fR، \fBgroff\fR یا \fBplain\fR باشد\N'46' در حالت \fBauto\fR، چنانچه متغیر محیطی \fBTERM\fR برابر با \fBdumb\fR یا تعریف‌نشده باشد، قالب به صورت \fBpager\fR یا \fBplain\fR خواهد بود\N'46'
.TP 4
\fB\N'45'\N'45'version\fR
نمایش اطلاعات نسخه\N'46'
.SH "وضعیت خروج (EXIT STATUS)"
.P
دستور \fBdune internal\fR با کدهای زیر خارج می‌شود:
.TP 4
0
در صورت موفقیت\N'46'
.TP 4
1
در صورت بروز خطا\N'46'
.TP 4
130
اگر با یک سیگنال متوقف شود\N'46'
.SH "همچنین ببینید (SEE ALSO)"
.P
dune(1)
