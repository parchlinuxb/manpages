.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-builder-build \- ساخت یک ایمیج از Dockerfile


.SH "خلاصه (SYNOPSIS)"
\fBdocker builder build [OPTIONS] PATH | URL | -\fP


.SH "شرح (DESCRIPTION)"
ساخت یک ایمیج از Dockerfile


.SH "گزینه‌ها (OPTIONS)"
\fB--add-host\fP=
	افزودن یک نگاشت سفارشی میزبان به IP ("host:ip")

.PP
\fB--build-arg\fP=
	تنظیم متغیرهای زمان ساخت

.PP
\fB--cache-from\fP=[]
	ایمیج‌هایی که به عنوان منابع حافظه موقت (cache sources) در نظر گرفته می‌شوند

.PP
\fB--cgroup-parent\fP=""
	تنظیم cgroup والد برای دستورالعمل‌های "RUN" در طول ساخت

.PP
\fB--compress\fP[=false]
	فشرده‌سازی زمینه ساخت (build context) با استفاده از gzip

.PP
\fB--cpu-period\fP=0
	محدود کردن دوره زمان‌بند کاملاً عادلانه پردازنده (CPU CFS period)

.PP
\fB--cpu-quota\fP=0
	محدود کردن سهمیه زمان‌بند کاملاً عادلانه پردازنده (CPU CFS quota)

.PP
\fB-c\fP, \fB--cpu-shares\fP=0
	سهم‌های پردازنده (وزن نسبی)

.PP
\fB--cpuset-cpus\fP=""
	پردازنده‌های مجاز برای اجرا (0-3, 0,1)

.PP
\fB--cpuset-mems\fP=""
	حافظه‌های مجاز برای اجرا (0-3, 0,1)

.PP
\fB-f\fP, \fB--file\fP=""
	نام Dockerfile (پیش‌فرض "PATH/Dockerfile" است)

.PP
\fB--force-rm\fP[=false]
	حذف همیشگی کانتینرهای میانی

.PP
\fB--iidfile\fP=""
	نوشتن شناسه ایمیج در فایل

.PP
\fB--isolation\fP=""
	فناوری جداسازی کانتینر

.PP
\fB--label\fP=
	تنظیم متاداده برای یک ایمیج

.PP
\fB-m\fP, \fB--memory\fP=0
	محدودیت حافظه

.PP
\fB--memory-swap\fP=0
	محدودیت swap برابر با حافظه به علاوه swap؛ مقدار 1- برای فعال‌سازی swap نامحدود

.PP
\fB--network\fP="default"
	تنظیم حالت شبکه برای دستورالعمل‌های RUN در طول ساخت

.PP
\fB--no-cache\fP[=false]
	عدم استفاده از حافظه موقت هنگام ساخت ایمیج

.PP
\fB--platform\fP=""
	تنظیم بستر در صورت پشتیبانی سرور از چند بستر

.PP
\fB--pull\fP[=false]
	تلاش همیشگی برای دریافت (pull) نسخه جدیدتر ایمیج

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	مخفی‌سازی خروجی ساخت و چاپ شناسه ایمیج در صورت موفقیت

.PP
\fB--rm\fP[=true]
	حذف کانتینرهای میانی پس از ساخت موفقیت‌آمیز

.PP
\fB--security-opt\fP=[]
	گزینه‌های امنیتی

.PP
\fB--shm-size\fP=0
	اندازه "/dev/shm"

.PP
\fB--squash\fP[=false]
	ادغام لایه‌های تازه‌ساخته‌شده در یک لایه جدید یکتا

.PP
\fB-t\fP, \fB--tag\fP=
	نام و در صورت تمایل تگ در قالب "name:tag"

.PP
\fB--target\fP=""
	تنظیم مرحله هدف ساخت برای ساخته‌شدن

.PP
\fB--ulimit\fP=[]
	گزینه‌های ulimit


.SH "ببینید (SEE ALSO)"
\fBdocker-builder(1)\fP
