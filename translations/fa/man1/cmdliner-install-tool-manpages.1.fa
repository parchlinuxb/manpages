.\" Pipe this output to groff -m man -K utf8 -T utf8 | less -R
.\"
.mso an.tmac
.TH "CMDLINER-INSTALL-TOOL-MANPAGES" 1 "" "Cmdliner v2.1.1" "Cmdliner Manual"
.\" Disable hyphenation and ragged-right
.nh
.ad l
.SH "نام (NAME)"
.P
cmdliner\-install\-tool\-manpages \- نصب صفحات راهنمای ابزارهای مبتنی بر cmdliner
.SH "خلاصه دستور (SYNOPSIS)"
.P
\fBcmdliner install tool\-manpages\fR [\fB\-\-dry\-run\fR] [\fB\-\-update\-opam\-install\fR=\fIPKG\N'46'install\fR] [\fIگزینه‌ها\fR]… \fITOOLEXEC[:NAME]\fR… \fIMANDIR\fR
.SH "توضیحات (DESCRIPTION)"
.P
دستور \fBcmdliner install tool\-manpages\fR صفحات راهنمای ابزار و زیردستورهای آن را در دایرکتوری‌های پوشه \fBman\fR نصب می‌کند\N'46' در صورت نیاز، دایرکتوری‌ها ایجاد می‌شوند\N'46' از گزینه \fB\-\-dry\-run\fR برای مشاهده مسیرهایی که نوشته خواهند شد استفاده کنید\N'46' مثال:
.P
.nf
\fBcmdliner install tool\-manpages\fR \fB\N'46'/mytool\fR \fB/usr/local/share/man\fR
.fi
.P
توجه داشته باشید که دستور \fBinstall tool\-support\fR نیز همانند این دستور صفحات راهنما را نصب می‌کند\N'46'
.SH "شناسه‌ها (ARGUMENTS)"
.TP 4
\fIMANDIR\fR (اجباری)
مسیر ریشه دایرکتوری \fBman\fR برای نصب صفحات راهنما\N'46'
.TP 4
\fITOOLEXEC[:NAME]\fR (اجباری)
فایل اجرایی ابزار (\fITOOLEXEC\fR)\N'46' در صورتی که مسیر صریح فایل مشخص نشده باشد، در متغیر \fBPATH\fR جستجو می‌شود\N'46' مقدار \fINAME\fR نام ابزار است؛ در صورت عدم تعیین، از نام پایه \fITOOLEXEC\fR با حذف پسوند \fB\N'46'exe\fR استخراج می‌شود\N'46' قابل تکرار است\N'46'
.SH "گزینه‌ها (OPTIONS)"
.TP 4
\fB\-\-dry\-run\fR
فایل‌ها را نصب نکن، فقط مسیرهایی را که نوشته خواهند شد نمایش بده\N'46'
.TP 4
\fB\-\-update\-opam\-install\fR=\fIPKG\N'46'install\fR
فایل \fIPKG\N'46'install\fR در opam را به‌روزرسانی یا ایجاد کن و انتقال‌های نصب را از فایل‌های نصب‌شده به بخش‌های متناظر opam install اضافه کن\N'46' در صورت مشخص شدن \fB\-\-dry\-run\fR نیز انجام می‌شود\N'46'
.SH "گزینه‌های عمومی (COMMON OPTIONS)"
.TP 4
\fB\-\-help\fR[=\fIFMT\fR] (پیش‌فرض=\fBauto\fR)
نمایش این راهنما در قالب \fIFMT\fR\N'46' مقدار \fIFMT\fR باید یکی از مقادیر \fBauto\fR، \fBpager\fR، \fBgroff\fR یا \fBplain\fR باشد\N'46' با مقدار \fBauto\fR، هرگاه متغیر محیطی \fBTERM\fR برابر \fBdumb\fR یا تعریف‌نشده باشد، قالب به‌صورت \fBpager\fR یا \fBplain\fR خواهد بود\N'46'
.TP 4
\fB\-\-version\fR
نمایش اطلاعات نسخه\N'46'
.SH "وضعیت خروج (EXIT STATUS)"
.P
دستور \fBcmdliner install tool\-manpages\fR با مقادیر زیر خارج می‌شود:
.TP 4
0
در صورت موفقیت\N'46'
.TP 4
123
در صورت بروز خطاهای کلی گزارش‌شده در خروجی استاندارد خطا\N'46'
.TP 4
124
در صورت بروز خطاهای تجزیه خط فرمان\N'46'
.TP 4
125
در صورت بروز خطاهای داخلی غیرمنتظره (باگ‌ها)\N'46'
.SH "همچنین ببینید (SEE ALSO)"
.P
cmdliner(1)
