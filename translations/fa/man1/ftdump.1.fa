.TH FTDUMP 1 "March 2026" "FreeType 2.14.3"
.
.
.SH "نام (NAME)"
.
ftdump \- استخراج‌کننده ساده اطلاعات فونت
.
.
.SH "خلاصه دستور (SYNOPSIS)"
.
.B ftdump
.RI [ options ]
.I fontname
.
.
.SH "توضیحات (DESCRIPTION)"
.
.B ftdump
اطلاعات مرتبط با یک فایل فونت را که برای FreeType اهمیت دارد فهرست می‌کند.
.
.PP
این برنامه بخشی از بسته نمایش و دموهای FreeType است.
.
.
.SH "گزینه‌ها (OPTIONS)"
.
.TP
.B \-c, \-C
چاپ پوشش نگاشت نویسه‌ها (charmap coverage).
.
.TP
.B \-n
چاپ جدول‌های نام SFNT.
.
.TP
.B \-p
چاپ برنامه‌های TrueType.
.
.TP
.B \-t
چاپ فهرست جدول‌های SFNT.
.
.TP
.B \-u
تولید خروجی در قالب UTF-8.
.
.TP
.B \-v
نمایش نسخه.
.
.\" eof
