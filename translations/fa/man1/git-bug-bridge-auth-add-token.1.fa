.TH "GIT-BUG" "1" "Apr 2019" "Generated from git-bug's source code" ""

.SH "نام (NAME)"
git-bug-bridge-auth-add-token \- ذخیره یک توکن جدید


.SH "خلاصه دستور (SYNOPSIS)"
\fBgit-bug bridge auth add-token [TOKEN] [flags]\fP


.SH "توضیحات (DESCRIPTION)"
ذخیره یک توکن جدید


.SH "گزینه‌ها (OPTIONS)"
\fB-t\fP, \fB--target\fP=""
	مقصد پل. مقادیر معتبر عبارتند از [github,gitlab,jira,launchpad-preview]

.PP
\fB-l\fP, \fB--login\fP=""
	نام کاربری در سیستم ردیاب باگ راه دور

.PP
\fB-u\fP, \fB--user\fP=""
	کاربری که توکن به آن اضافه می‌شود. مقدار پیش‌فرض کاربر فعلی است

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای add-token


.SH "همچنین ببینید (SEE ALSO)"
\fBgit-bug-bridge-auth(1)\fP
