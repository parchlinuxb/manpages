.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
nvme-intel-lat-stats \- دریافت آمار تأخیر اختصاصی اینتل برای دستگاه NVMe و بازگرداندن ساختار نتیجه
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.nf
\fInvme intel lat\-stats\fR <device> [\-\-write | \-w] [\-\-raw\-binary | \-b]
.fi
.SH "توضیحات (DESCRIPTION)"
.sp
برای دستگاه NVMe داده‌شده، آمار تأخیر اختصاصی شرکت اینتل (Intel) را بازیابی کرده و نتیجه و ساختار بازگردانده‌شده را ارائه می‌دهد\&.
.sp
پارامتر <device> اجباری است و می‌تواند یک دستگاه کاراکتری NVMe (مانند /dev/nvme0) یا یک دستگاه بلوکی فضای نام (مانند /dev/nvme0n1) باشد\&.
.sp
در صورت موفقیت، ساختار ممکن است بسته به فلگ‌های گزینه به یکی از چندین روش بازگردانده شود؛ ساختار ممکن است توسط برنامه تجزیه شود یا بافر خام در خروجی استاندارد (stdout) چاپ شود\&.
.SH "گزینه‌ها (OPTIONS)"
.PP
\-b, \-\-raw\-binary
.RS 4
چاپ بافر خام در خروجی استاندارد (stdout)\&. ساختار توسط برنامه تجزیه نمی‌شود\&. این گزینه بر گزینه‌های اختصاصی سازنده و خوانا برای انسان اولویت دارد\&.
.RE
.PP
\-w, \-\-write
.RS 4
دریافت آمار نوشتن\&. آمار خواندن به‌صورت پیش‌فرض بازگردانده می‌شود\&.
.RE
.SH "مثال‌ها (EXAMPLES)"
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
دریافت آمار خواندن
.sp
.if n \{\
.RS 4
.\}
.nf
# nvme intel lat\-stats /dev/nvme0
.fi
.if n \{\
.RE
.\}
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
دریافت آمار نوشتن
.sp
.if n \{\
.RS 4
.\}
.nf
# nvme intel lat\-stats /dev/nvme0 \-w
.fi
.if n \{\
.RE
.\}
.RE
.SH "همچنین ببینید (SEE ALSO)"
.sp
\fBnvme\fR(1)
.SH "NVME"
.sp
بخشی از مجموعهٔ nvme\-user
