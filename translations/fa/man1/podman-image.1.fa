'\" t
.nh
.TH podman-image 1
.SH "نام (NAME)"
podman-image \- مدیریت ایمیج‌ها در پادمن

.SH "خلاصه دستور (SYNOPSIS)"
\fBpodman image\fP \fIsubcommand\fP

.SH "توضیحات (DESCRIPTION)"
دستور \fBimage\fP امکان مدیریت ایمیج‌ها را فراهم می‌کند.

.SH "دستورات (COMMANDS)"
.TS
allbox;
l l l
l l l .
\fBدستور\fP	\fBصفحه راهنما\fP	\fBتوضیحات\fP
build	podman-build(1)	T{
ساخت یک کانتینر با استفاده از Dockerfile.
T}
diff	podman-image-diff(1)	T{
بررسی تغییرات روی فایل‌سیستم یک ایمیج.
T}
exists	podman-image-exists(1)	T{
بررسی وجود یک ایمیج در ذخیره‌ساز محلی.
T}
history	podman-history(1)	T{
نمایش تاریخچه یک ایمیج.
T}
import	podman-import(1)	T{
وارد کردن یک tarball و ذخیره آن به عنوان یک ایمیج فایل‌سیستم.
T}
inspect	podman-image-inspect(1)	T{
نمایش پیکربندی یک ایمیج.
T}
list	podman-images(1)	T{
فهرست کردن ایمیج‌های کانتینر روی سیستم (نام مستعار ls).
T}
load	podman-load(1)	T{
بارگذاری یک ایمیج از آرشیو داکر.
T}
mount	podman-image-mount(1)	T{
سوار کردن (mount) فایل‌سیستم ریشه یک ایمیج.
T}
prune	podman-image-prune(1)	T{
حذف تمام ایمیج‌های بلااستفاده از ذخیره‌ساز محلی.
T}
pull	podman-pull(1)	T{
دریافت یک ایمیج از یک رجیستری.
T}
push	podman-push(1)	T{
ارسال یک ایمیج از ذخیره‌ساز محلی به مقصدی دیگر.
T}
rm	podman-rmi(1)	T{
حذف یک یا چند ایمیج ذخیره‌شده در سطح محلی.
T}
save	podman-save(1)	T{
ذخیره یک ایمیج در docker-archive یا oci.
T}
scp	podman-image-scp(1)	T{
کپی امن یک ایمیج از یک میزبان به میزبان دیگر.
T}
search	podman-search(1)	T{
جستجوی یک ایمیج در یک رجیستری.
T}
sign	podman-image-sign(1)	T{
ایجاد یک امضا برای یک ایمیج.
T}
tag	podman-tag(1)	T{
افزودن یک نام اضافی به یک ایمیج محلی.
T}
tree	podman-image-tree(1)	T{
چاپ سلسله‌مراتب لایه‌های یک ایمیج در قالب ساختار درختی.
T}
trust	podman-image-trust(1)	T{
مدیریت خط‌مشی اعتماد به ایمیج در رجیستری کانتینر.
T}
unmount	podman-image-unmount(1)	T{
پیاده کردن (unmount) فایل‌سیستم ریشه یک ایمیج.
T}
untag	podman-untag(1)	T{
حذف یک یا چند نام از یک ایمیج ذخیره‌شده در سطح محلی.
T}
.TE

.SH "همچنین ببینید (SEE ALSO)"
\fBpodman(1)\fP
