.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_indxbib_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY \%indxbib
.RB [ \-w ]
.RB [ \-c\~\c
.IR \%common-words-file ]
.RB [ \-d\~\c
.IR dir ]
.RB [ \-f\~\c
.IR \%list-file ]
.RB [ \-h\~\c
.IR \%min-hash-table-size ]
.RB [ \-i\~\c
.IR \%excluded-fields ]
.RB [ \-k\~\c
.IR \%max-keys-per-record ]
.RB [ \-l\~\c
.IR \%min-key-length ]
.RB [ \-n\~\c
.IR \%threshold ]
.RB [ \-o\~\c
.IR file ]
.RB [ \-t\~\c
.IR \%max-key-length ]
.RI [ file\~ .\|.\|.]
.YS
.
.
.P
.SY \%indxbib
.B \-\-help
.YS
.
.
.P
.SY \%indxbib
.B \-v
.YS
.
.SY \%indxbib
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
دستور
.I \%indxbib
یک نمایه معکوس از پایگاه‌های داده کتاب‌شناختی در هر
.I file
می‌سازد تا سرعت دسترسی به آن‌ها توسط
.MR \%refer 1 ،
.MR \%lookbib 1
و
.MR lkbib 1
افزایش یابد.
.
این برنامه در یک فایل موقت می‌نویسد و سپس نام آن را به
.RI file \%.i
تغییر می‌دهد.
.
اگر هیچ عملوند
.I file
مشخص نشده باشد و هیچ گزینه
.B \-o
نیز داده نشده باشد،
.I \%indxbib
نام نمایه را
.IR \%Ind\%.i
می‌گذارد.
.
.
.PP
پایگاه‌های داده کتاب‌شناختی با خطوط خالی به رکوردها تقسیم می‌شوند.
.
درون یک رکورد،
هر فیلد با یک نویسه
.B %
در ابتدای خط آغاز می‌شود.
.
فیلدها دارای یک نام تک‌حرفی هستند که پس از نویسه
.B %
قرار می‌گیرد.
.
.
.PP
دستور
.I \%indxbib
مقادیر تنظیم‌شده توسط گزینه‌های
.BR \-c ،
.BR \-l ،
.BR \-n
و
.B \-t
را در نمایه ذخیره می‌کند:
برنامه‌هایی که در نمایه جستجو می‌کنند، این مقادیر را تفسیر کرده، کلیدها را به درستی دور می‌ریزند یا کوتاه می‌کنند، و با استفاده از کلیدهای اصلی تایید می‌کنند که هر رکورد یافت‌شده با استفاده از نمایه، واقعاً حاوی آن کلیدها باشد.
.
این بدان معناست که کاربر نمایه نیازی به دانستن این موضوع ندارد که آیا این گزینه‌ها در زمان ایجاد نمایه استفاده شده‌اند یا خیر، مشروط بر آن‌که تمام کلیدهای مورد جستجو در طول نمایه‌سازی دور ریخته نشده باشند و کاربر حداقل آن بخش از هر کلید را ارائه دهد که پس از کوتاه‌سازی در طول نمایه‌سازی باقی می‌مانده است.
.
همچنین
.I \%indxbib
مقدار تنظیم‌شده توسط گزینه
.B \-i
را در نمایه ذخیره می‌کند تا برای اعتبارسنجی رکوردهای یافت‌شده با استفاده از آن به کار رود.
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
.B \-\-help
یک پیام راهنمای استفاده نمایش می‌دهد، در حالی که
.B \-v
و
.B \%\-\-version
اطلاعات نسخه را نشان می‌دهند؛
سپس همگی خارج می‌شوند.
.
.
.TP 8n \" "-d dir" + 2n
.BI \-c\~ common-words-file
خواندن فهرست کلمات رایج از
.I common-words-file
به جای
.IR \%/usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%eign .
.
.
.TP
.BI \-d\~ dir
استفاده از
.I dir
به‌عنوان نام دایرکتوری جهت ذخیره در نمایه،
به جای نامی که توسط
.MR getcwd 2
بازگردانده می‌شود.
.
معمولاً
.I dir
یک پیوند نمادین خواهد بود که مقصد آن دایرکتوری کاری فعلی است.
.
.
.TP
.BI \-f\~ list-file
خواندن فایل‌هایی که باید نمایه‌سازی شوند از
.IR list-file .
.
اگر
.I list-file
برابر با
.B \-
باشد، فایل‌ها از جریان ورودی استاندارد خوانده می‌شوند.
.
گزینه
.B \-f
حداکثر یک بار می‌تواند مشخص شود.
.
.
.TP
.BI \-h\~ min-hash-table-size
استفاده از اولین عدد اول بزرگ‌تر یا مساوی با
آرگومان برای اندازه جدول درهم‌سازی.
.
مقادیر بزرگ‌تر
معمولاً جستجو را سریع‌تر می‌کنند،
اما اندازه فایل نمایه را بزرگ‌تر کرده
و موجب می‌شوند
.I \%indxbib
حافظه بیشتری مصرف کند.
.
اندازه پیش‌فرض جدول درهم‌سازی ۹۹۷ است.
.
.
.TP
.BI \-i\~ excluded-fields
عدم نمایه‌سازی محتوای فیلدهایی که نام آن‌ها در
.I excluded-fields
آمده است.
.
نام‌های فیلدها هر کدام یک نویسه هستند.
.
اگر این گزینه مشخص نشود،
.I \%indxbib
فیلدهای
.BR X ،
.BR Y
و
.B Z
را مستثنی می‌کند.
.
.
.TP
.BI \-k\~ max-keys-per-record
استفاده از کلیدهایی به ازای هر رکورد ورودی، نه بیشتر از آنچه در آرگومان مشخص شده است.
.
اگر این گزینه مشخص نشود،
حداکثر مقدار ۱۰۰ است.
.
.
.TP
.BI \-l\~ min-key-length
دور ریختن هر کلیدی که طول آن بر حسب نویسه کوتاه‌تر از مقدار
آرگومان باشد.
.
اگر این گزینه مشخص نشود،
حداقل طول کلید
۳ خواهد بود.
.
.
.TP
.BI \-n\~ threshold
دور ریختن
.I threshold
کلمه از رایج‌ترین کلمات موجود در فایل کلمات رایج.
.
اگر این گزینه مشخص نشود،
۱۰۰ کلمه از رایج‌ترین کلمات دور ریخته می‌شوند.
.
.
.TP
.BI \-o\~ basename
نام‌گذاری نمایه به صورت
.RI basename \%.i .
.
.
.TP
.BI \-t\~ max-key-length
کوتاه‌سازی کلیدها به
.I max-key-length
نویسه.
.
اگر این گزینه مشخص نشود،
کلیدها به ۶ نویسه کوتاه می‌شوند.
.
.
.TP
.B \-w
نمایه‌سازی کل فایل‌ها.
.
هر فایل یک رکورد جداگانه در نظر گرفته می‌شود.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
دستور
.I \%indxbib
در صورت اجرای موفقیت‌آمیز با وضعیت
.BR 0 ،
اگر نتواند آرگومان‌های خط فرمان را تفسیر کند با وضعیت
.B 2
و در صورت مواجهه با خطا در حین اجرا با وضعیت
.B 1
خارج می‌شود.
.
.
.\" ====================================================================
.SH "فایل‌ها (FILES)"
.\" ====================================================================
.
.TP
.RI \%file \%.i
نمایه برای
.I file
.
.
.TP
.I \%Ind\%.i
نام پیش‌فرض نمایه
.
.
.TP
.I \%/usr/\:\%share/\:\%groff/\:\%1.24.1/\:\%eign
شامل فهرست کلمات رایج است.
.
نام سنتی
.RI \[lq] eign \[rq]
مخفف عبارت \[lq]English ignored [word list]\[rq] است.
.
.
.TP
.IR \%indxbib XXXXXX
فایل موقت
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
\[lq]Some Applications of Inverted Indexes on the Unix System\[rq],
by M.\& E.\& Lesk,
1978,
AT&T Bell Laboratories Computing Science Technical Report No.\& 69.
.
.
.LP
.MR \%refer 1 ،
.MR lkbib 1 ،
.MR \%lookbib 1
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_indxbib_1_man_C]
.do rr *groff_indxbib_1_man_C
.
.
