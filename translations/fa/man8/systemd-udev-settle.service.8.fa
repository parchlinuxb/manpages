.TH "SYSTEMD\-UDEV\-SETTLE\&.SERVICE" "8" "" "systemd 261.2" "systemd-udev-settle.service"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
