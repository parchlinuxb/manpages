.\"  -*- nroff -*-
.\"
.\" ldverify.1
.\"
.\" Man page created from source and usage information by
.\" Cesare Falco <c.falco@ubuntu.com>, August 2008
.\"
.TH LDVERIFY 1 2016-07-21 0.176 "MAME laserdisc data checker"
.\"
.\" NAME chapter
.SH "نام (NAME)"
ldverify \- اعتبارسنجی فایل‌های Laserdisc در شبیه‌ساز MAME
.\"
.\" SYNOPSIS chapter
.SH "خلاصه دستور (SYNOPSIS)"
.B ldverify \fR[\fIavifile.avi\fR|\fIchdfile.chd\fR]
.\"
.\" DESCRIPTION chapter
.SH "توضیحات (DESCRIPTION)"
.B ldverify
ابزاری است که فایل‌های ویدیویی ضبط‌شده از لیزردیسک در قالب AVI یا CHD را پیمایش کرده و از نبود هرگونه ناهنجاری و نقص در داده‌های VBI (فاصله خاموشی عمودی) اطمینان حاصل می‌کند.
.SH "همچنین ببینید (SEE ALSO)"
.BR ldresample (1),
.BR mame (6),
.BR mess (6)
