.TH IP\-IOAM 8 "05 Jul 2021" "iproute2" "Linux"
.SH "نام (NAME)"
ip-ioam \- مدیریت فضای نام و شِمای درونباندی عملیات، مدیریت و نگهداری (IOAM) در IPv6
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.ad l
.in +8
.ti -8
.B ip ioam
.RI " { " COMMAND " | "
.BR help " }"
.sp
.ti -8

.ti -8
.B ip ioam namespace show

.ti -8
.B ip ioam namespace add
.I ID
.BR " [ "
.B data
.I DATA32
.BR "]"
.BR " [ "
.B wide
.I DATA64
.BR "]"

.ti -8
.B ip ioam namespace del
.I ID

.ti -8
.B ip ioam schema show

.ti -8
.B ip ioam schema add
.I ID DATA

.ti -8
.B ip ioam schema del
.I ID

.ti -8
.B ip ioam namespace set
.I ID
.B schema
.RI " { " ID " | "
.BR none " }"

.ti -8
.B ip ioam monitor

.SH "توضیحات (DESCRIPTION)"
دستور
.B "ip ioam"
برای پیکربندی پارامترهای داخلی In-situ OAM در IPv6 (به اختصار IOAM6)، یعنی فضاهای نام و شِماهای IOAM استفاده می‌شود.
.PP
این پارامترها همچنین نگاشت بین یک فضای نام IOAM و یک شِمای IOAM را شامل می‌شوند.
.PP
دستور
.B "ip ioam monitor"
داده‌های دریافت شده IOAM را نمایش می‌دهد.

.SH "مثال‌ها (EXAMPLES)"
.PP
.SS "پیکربندی یک فضای نام IOAM (شناسه ID = 1) همراه با داده ۳۲ بیتی و داده عریض ۶۴ بیتی"
.nf
# ip ioam namespace add 1 data 0xdeadbeef wide 0xcafec0caf00dc0de
.fi
.PP
.SS "پیوند دادن یک شِمای موجود IOAM (شناسه ID = 7) به یک فضای نام موجود IOAM (شناسه ID = 1)"
.nf
# ip ioam namespace set 1 schema 7
.fi
.SH "همچنین ببینید (SEE ALSO)"
.br
.BR ip-route (8)
.SH "نویسنده (AUTHOR)"
Justin Iurman <justin.iurman@uliege.be>
