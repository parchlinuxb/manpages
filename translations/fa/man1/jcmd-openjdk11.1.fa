.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
jcmd \- ابزار ارسال درخواست‌های عیب‌یابی و کنترل به ماشین مجازی جاوا (JVM) (نسخه ۱۱)
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.if n \{\
.RS 4
.\}
.nf
\fBjcmd\fR [\fB\-l\fR|\fB\-h\fR|\fB\-help\fR]
.fi
.if n \{\
.RE
.\}
.sp
.if n \{\
.RS 4
.\}
.nf
\fBjcmd\fR \fIpid\fR|\fImain\-class\fR \fBPerfCounter\&.print\fR
.fi
.if n \{\
.RE
.\}
.sp
.if n \{\
.RS 4
.\}
.nf
\fBjcmd\fR \fIpid\fR|\fImain\-class\fR \fB\-f\fR \fIfilename\fR
.fi
.if n \{\
.RE
.\}
.sp
.if n \{\
.RS 4
.\}
.nf
\fBjcmd\fR \fIpid\fR|\fImain\-class\fR \fIcommand\fR[ \fIarguments\fR]
.fi
.if n \{\
.RE
.\}
.SH "توضیحات (DESCRIPTION)"
.PP
ابزار
\fBjcmd\fR
برای ارسال درخواست‌های دستورات عیب‌یابی به ماشین مجازی جاوا (JVM) استفاده می‌شود\&. این ابزار باید روی همان ماشینی اجرا شود که JVM در حال اجرا است، و باید دارای همان شناسه‌های کاربری و گروهی مؤثر (UID/GID) باشد که برای راه‌اندازی JVM استفاده شده‌اند\&.
.if n \{\
.sp
.\}
.RS 4
.it 1 an-trap
.nr an-no-space-flag 1
.nr an-break-flag 1
.br
.ps +1
\fBنکته\fR
.ps -1
.br
.TS
allbox tab(:);
l.
T{
.PP
برای فراخوانی دستورات عیب‌یابی از راه دور یا با شناسه‌های کاربری متفاوت، می‌توانید از رابط
\fBcom\&.sun\&.management\&.DiagnosticCommandMBean\fR
استفاده کنید\&. برای اطلاعات بیشتر درباره رابط
\fBDiagnosticCommandMBean\fR ،
مستندات API را در نشانی زیر ببینید:
http://docs\&.oracle\&.com/javase/8/docs/jre/api/management/extension/com/sun/management/DiagnosticCommandMBean\&.html
T}
.TE
.sp 1
.sp .5v
.RE
.PP
اگر
\fBjcmd\fR
را بدون آرگومان یا با گزینه
\fB\-l\fR
اجرا کنید، فهرستی از شناسه‌های فرآیند (PID) جاوای در حال اجرا را همراه با کلاس اصلی (main class) و آرگومان‌های خط فرمانی که برای راه‌اندازی فرآیند استفاده شده‌اند، چاپ می‌کند\&. اجرای
\fBjcmd\fR
با گزینه
\fB\-h\fR
یا
\fB\-help\fR
پیام راهنمای این ابزار را چاپ می‌کند\&.
.PP
اگر شناسه فرآیند (\fIpid\fR) یا کلاس اصلی (\fImain\-class\fR) را به عنوان نخستین آرگومان مشخص کنید،
\fBjcmd\fR
درخواست دستور عیب‌یابی را به فرآیند جاوای دارای شناسه مشخص‌شده یا به تمام فرآیندهای جاوا با نام کلاس اصلی مشخص‌شده ارسال می‌کند\&. همچنین می‌توانید با مشخص کردن
\fB0\fR
به عنوان شناسه فرآیند، درخواست دستور عیب‌یابی را به تمام فرآیندهای جاوای در دسترس ارسال کنید\&. از یکی از موارد زیر به عنوان درخواست دستور عیب‌یابی استفاده کنید:
.PP
Perfcounter\&.print
.RS 4
شمارنده‌های کارایی (performance counters) موجود برای فرآیند جاوای مشخص‌شده را چاپ می‌کند\&. فهرست شمارنده‌های کارایی ممکن است در فرآیندهای مختلف جاوا متفاوت باشد\&.
.RE
.PP
\-f \fIfilename\fR
.RS 4
نام فایلی که دستورات عیب‌یابی از آن خوانده شده و به فرآیند جاوای مشخص‌شده ارسال می‌شوند\&. فقط با گزینه
\fB\-f\fR
استفاده می‌شود\&. هر دستور در فایل باید در یک خط مجزا نوشته شود\&. خطوطی که با علامت پوند (\fB#\fR) آغاز می‌شوند نادیده گرفته خواهند شد\&. پردازش فایل زمانی پایان می‌یابد که تمام خطوط خوانده شوند یا خطی حاوی کلمه کلیدی
\fBstop\fR
خوانده شود\&.
.RE
.PP
\fIcommand\fR [\fIarguments\fR]
.RS 4
دستوری که باید به فرآیند جاوای مشخص‌شده ارسال شود\&. فهرست دستورات عیب‌یابی موجود برای یک فرآیند معین را می‌توان با ارسال دستور
\fBhelp\fR
به آن فرآیند به دست آورد\&. هر دستور عیب‌یابی مجموعه‌ای از آرگومان‌های ویژه خود را دارد\&. برای مشاهده توضیحات، ساختار نحوی و فهرست آرگومان‌های موجود برای یک دستور، از نام آن دستور به عنوان آرگومان دستور
\fBhelp\fR
استفاده کنید\&.
.sp
\fBنکته:\fR
اگر هر یک از آرگومان‌ها حاوی فاصله (space) باشند، باید آن‌ها را درون علامت‌های نقل‌قول تکی یا دوتایی (\fB\*(Aq\fR
یا
\fB"\fR)
قرار دهید\&. افزون بر این، برای جلوگیری از پردازش نقل‌قول‌ها توسط پوسته سیستم‌عامل (shell)، باید نقل‌قول‌های تکی یا دوتایی را با یک بک‌اسلش (\fB\e\fR) اسکیپ کنید\&. در غیر این صورت می‌توانید این آرگومان‌ها را ابتدا درون نقل‌قول تکی و سپس درون نقل‌قول دوتایی (یا برعکس) محصور کنید\&.
.RE
.SH "گزینه‌ها (OPTIONS)"
.PP
گزینه‌ها مانعة‌الجمع هستند (نمی‌توان هم‌زمان بیش از یکی را به کار برد)\&.
.PP
\-f \fIfilename\fR
.RS 4
دستورات را از فایل مشخص‌شده می‌خواند\&. این گزینه تنها در صورتی قابل استفاده است که شناسه فرآیند یا کلاس اصلی را به عنوان نخستین آرگومان مشخص کرده باشید\&. هر دستور در فایل باید در یک خط مجزا نوشته شود\&. خطوطی که با علامت پوند (\fB#\fR) آغاز می‌شوند نادیده گرفته خواهند شد\&. پردازش فایل زمانی پایان می‌یابد که تمام خطوط خوانده شوند یا خطی حاوی کلمه کلیدی
\fBstop\fR
خوانده شود\&.
.RE
.PP
\-h
.br
\-help
.RS 4
پیام راهنما را چاپ می‌کند\&.
.RE
.PP
\-l
.RS 4
فهرست شناسه‌های فرآیندهای جاوای در حال اجرا را به همراه کلاس اصلی و آرگومان‌های خط فرمان چاپ می‌کند\&.
.RE
.SH "همچنین ببینید (SEE ALSO)"
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
jps(1)
.RE
.br
'pl 8.5i
'bp
