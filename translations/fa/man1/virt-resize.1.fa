.BR guestfs \|(3),
.BR guestfish \|(1),
.BR lvm \|(8),
.BR pvresize \|(8),
.BR lvresize \|(8),
.BR resize2fs \|(8),
.BR ntfsresize \|(8),
.BR btrfs \|(8),
.BR xfs_growfs \|(8),
.BR resize.f2fs \|(8),
.BR virsh \|(1),
.BR parted \|(8),
.BR truncate \|(1),
.BR fallocate \|(1),
.BR grub \|(8),
.BR grub\-install \|(8),
.BR virt\-rescue \|(1),
.BR virt\-sparsify \|(1),
.BR virt\-alignment\-scan \|(1),
http://libguestfs.org
