.\" Pipe this output to groff -m man -K utf8 -T utf8 | less -R
.\"
.mso an.tmac
.TH "DUNE-TOP" 1 "" "Dune 3.24.2" "Dune Manual"
.\" Disable hyphenation and ragged-right
.nh
.ad l
.SH "نام (NAME)"
.P
dune\N'45'top \N'45' چاپ فهرستی از رهنمودهای toplevel برای گنجاندن دایرکتوری‌ها و بارگذاری فایل‌های cma
.SH "خلاصه دستور (SYNOPSIS)"
.P
\fBdune top\fR [\fIگزینه\fR]… [\fIپوشه\fR]
.SH "توضیحات (DESCRIPTION)"
.P
چاپ فهرستی از رهنمودهای toplevel برای گنجاندن دایرکتوری‌ها و بارگذاری فایل‌های cma\N'46'
.P
خروجی \fBdune ocaml top\fR باید در یک toplevel ارزیابی شود تا کتابخانه‌ها در آن در دسترس قرار گیرند\N'46'
.P
در بسیاری از toplevelها می‌توان با استفاده از دستور \fB#use_output\fR به این هدف رسید، مانند \fB#use_output "dune ocaml top"\fR\N'46'
.SH "گزینه‌ها (OPTIONS)"
.TP 4
\fB\N'45'\N'45'action\N'45'stderr\N'45'on\N'45'success\fR=\fIVAL\fR
مشابه \fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success\fR اما برای خطای استاندارد به جای خروجی استاندارد\N'46' یک پیش‌فرض مناسب برای مخازن بزرگ یکپارچه (mono-repositories) به صورت \fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success=swallow \N'45'\N'45'action\N'45'stderr\N'45'on\N'45'success=must\N'45'be\N'45'empty\fR است\N'46' این اطمینان حاصل می‌کند که ساخت موفقیت‌آمیز یک خروجی خالی و «پاک» دارد\N'46'
.TP 4
\fB\N'45'\N'45'action\N'45'stdout\N'45'on\N'45'success\fR=\fIVAL\fR
تعیین نحوه برخورد با خروجی استاندارد اکشن‌ها در صورت موفقیت\N'46' مقادیر ممکن عبارتند از: \fBprint\fR برای چاپ مستقیم در خروجی Dune، \fBswallow\fR برای نادیده گرفتن کامل آن و \fBmust\N'45'be\N'45'empty\fR برای اجبار به اینکه اکشن هیچ چیزی چاپ نکرده باشد\N'46' با مقدار \fBmust\N'45'be\N'45'empty\fR، اگر اکشن چیزی در خروجی استاندارد چاپ کرده باشد، Dune آن را ناموفق تلقی می‌کند\N'46' مقدار پیش‌فرض \fBprint\fR است\N'46'
.TP 4
\fB\N'45'\N'45'build\N'45'info\fR
نمایش اطلاعات ساخت\N'46'
.TP 4
\fB\N'45'\N'45'context\fR=\fICONTEXT\fR (پیش‌فرض=\fBdefault\fR)
انتخاب کانتکست برای ساخت/اجرای top\N'46'
.TP 4
\fB\N'45'\N'45'display\N'45'separate\N'45'messages\fR
جداسازی پیام‌های خطا با یک خط خالی\N'46'
.TP 4
\fB\N'45'\N'45'error\N'45'reporting\fR=\fIVAL\fR (پیش‌فرض=\fBdeterministic\fR)
کنترل زمان گزارش خطاهای ساخت\N'46' مقدار \fBearly\fR خطاها را به محض شناسایی گزارش می‌دهد\N'46' مقدار \fBdeterministic\fR خطاها را در پایان ساخت و با ترتیبی قطعی گزارش می‌دهد\N'46' مقدار \fBtwice\fR هر خطا را دو بار گزارش می‌دهد: یک بار به محض شناسایی و بار دیگر در پایان ساخت با ترتیبی قطعی\N'46'
.TP 4
\fB\N'45'f\fR, \fB\N'45'\N'45'force\fR
اجبار به اجرای مجدد اکشن‌های مرتبط با نام‌های مستعار (alias)، حتی اگر وابستگی‌های آن‌ها تغییری نکرده باشد\N'46'
.TP 4
\fB\N'45'\N'45'file\N'45'watcher\fR=\fIVAL\fR (پیش‌فرض=\fBautomatic\fR)
سازوکار تشخیص تغییرات در سورس‌کد\N'46' مقدار Automatic باعث می‌شود dune یک برنامه خارجی را برای تشخیص تغییرات اجرا کند\N'46' مقدار Manual برای اطلاع‌رسانی دستی تغییر فایل‌ها به dune است\N'46'
.TP 4
\fB\N'45'\N'45'passive\N'45'watch\N'45'mode\fR
مشابه [\N'45'\N'45'watch]، اما فرآیند ساخت تنها زمانی آغاز می‌شود که از خارج از طریق یک RPC دستور داده شود\N'46'
.TP 4
\fB\N'45'\N'45'sandbox\fR=\fIVAL\fR (پیش‌فرض از متغیر محیطی \fBDUNE_SANDBOX\fR)
تنظیم حالت ایزوله‌سازی (sandboxing)\N'46' برخی اکشن‌ها نیازمند حالت ایزوله‌سازی خاصی هستند و این تنظیم را نادیده می‌گیرند\N'46' مقادیر مجاز عبارتند از: none، symlink، copy، hardlink\N'46'
.TP 4
\fB\N'45'\N'45'stop\N'45'on\N'45'first\N'45'error\fR
متوقف کردن ساخت به محض برخورد با اولین خطا\N'46'
.TP 4
\fB\N'45'w\fR, \fB\N'45'\N'45'watch\fR
به جای خاتمه ساخت پس از تکمیل، به طور مداوم منتظر تغییرات فایل‌ها می‌ماند\N'46'
.TP 4
\fB\N'45'\N'45'wait\N'45'for\N'45'filesystem\N'45'clock\fR
ابزار Dune محتوای فایل‌ها را برای افزایش کارایی افزایشی خلاصه‌سازی (digest) می‌کند\N'46' این خلاصه‌ها خودشان کش می‌شوند\N'46' در برخی موارد، Dune برای اطمینان از صحت عملکرد باید برخی از ورودی‌های کش خلاصه را حذف کند\N'46' این گزینه باعث می‌شود Dune منتظر پیش رفتن ساعت سیستم فایل بماند تا نیازی به حذف چیزی نداشته باشد\N'46' احتمالاً نیازی به این گزینه نخواهید داشت؛ این گزینه بیشتر برای توسعه‌دهندگان Dune کاربرد دارد تا تست‌های کش خلاصه‌سازی Dune بازتولیدپذیرتر شوند\N'46'
.SH "گزینه‌های عمومی (COMMON OPTIONS)"
.P
این گزینه‌ها میان تمامی دستورات مشترک هستند\N'46'
.TP 4
\fB\N'45'\N'45'always\N'45'show\N'45'command\N'45'line\fR
همیشه خط فرمان کامل برنامه‌های اجراشده توسط dune را نمایش می‌دهد\N'46'
.TP 4
\fB\N'45'\N'45'auto\N'45'promote\fR
ترفیع خودکار فایل‌ها\N'46' این کار مشابه اجرای دستور \fBdune promote\fR پس از ساخت است\N'46'
.TP 4
\fB\N'45'\N'45'build\N'45'dir\fR=\fIFILE\fR (پیش‌فرض از متغیر محیطی \fBDUNE_BUILD_DIR\fR)
پوشه مشخص‌شده برای ساخت\N'46' در صورت عدم تعیین، _build استفاده می‌شود\N'46'
.TP 4
\fB\N'45'\N'45'cache\fR=\fIVAL\fR (پیش‌فرض از متغیر محیطی \fBDUNE_CACHE\fR)
فعال یا غیرفعال کردن کش Dune (یکی از مقادیر \fBdisabled\fR، \fBenabled\N'45'except\N'45'user\N'45'rules\fR یا \fBenabled\fR)\N'46' مقدار پیش‌فرض `enabled\N'45'except\N'45'user\N'45'rules\N'39' است\N'46'
.TP 4
\fB\N'45'\N'45'cache\N'45'check\N'45'probability\fR=\fIVAL\fR (پیش‌فرض از متغیر محیطی \fBDUNE_CACHE_CHECK_PROBABILITY\fR)
بررسی بازتولیدپذیری ساخت از طریق اجرای مجدد تصادفی قوانین و مقایسه نتایج با موارد ذخیره‌شده در کش Dune\N'46' نکته: افزایش احتمال این بررسی‌ها سرعت ساخت را کاهش می‌دهد\N'46' احتمال پیش‌فرض صفر است، یعنی هیچ قانونی بررسی نمی‌شود\N'46'
.TP 4
\fB\N'45'\N'45'cache\N'45'storage\N'45'mode\fR=\fIVAL\fR (پیش‌فرض از متغیر محیطی \fBDUNE_CACHE_STORAGE_MODE\fR)
حالت ذخیره‌سازی کش Dune (یکی از مقادیر \fBauto\fR، \fBhardlink\fR یا \fBcopy\fR)\N'46' مقدار پیش‌فرض `hardlink\N'39' است\N'46'
.TP 4
\fB\N'45'\N'45'config\N'45'file\fR=\fIFILE\fR
بارگذاری این فایل پیکربندی به جای فایل پیش‌فرض\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'backtraces\fR
همیشه ردیابی برگشتی (backtrace) استثناها را چاپ می‌کند\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'dependency\N'45'path\fR
در صورت بروز خطا، مسیر وابستگی را از هدف‌های مشخص‌شده در خط فرمان تا قانونی که شکست خورده چاپ می‌کند\N'46'
.TP 4
\fB\N'45'\N'45'debug\N'45'package\N'45'logs\fR (پیش‌فرض از متغیر محیطی \fBDUNE_DEBUG_PACKAGE_LOGS\fR)
همیشه لاگ‌های استاندارد را هنگام ساخت بسته‌ها چاپ می‌کند\N'46'
.TP 4
\fB\N'45'\N'45'default\N'45'target\fR=\fITARGET\fR (پیش‌فرض=\fB@@default\fR)
تنظیم هدف پیش‌فرضی که در صورت عدم تعیین به \fBdune build\fR داده می‌شود\N'46'
.TP 4
\fB\N'45'\N'45'diff\N'45'command\fR=\fIVAL\fR (پیش‌فرض از متغیر محیطی \fBDUNE_DIFF_COMMAND\fR)
دستور پوسته برای مقایسه (diff) فایل‌ها\N'46' برای غیرفعال کردن چاپ تفاوت‌ها از \N'45' استفاده کنید\N'46'
.TP 4
\fB\N'45'\N'45'disable\N'45'promotion\fR (پیش‌فرض از متغیر محیطی \fBDUNE_DISABLE_PROMOTION\fR)
غیرفعال کردن تمامی قوانین ترفیع\N'46'
.TP 4
\fB\N'45'\N'45'display\fR=\fIMODE\fR
کنترل حالت نمایش Dune\N'46' برای جزئیات بیشتر به \fBdune\N'45'config(5)\fR مراجعه کنید\N'46' مقادیر مجاز برای این گزینه عبارتند از progress، verbose، short، quiet یا tui\N'46'
.TP 4
\fB\N'45'\N'45'dump\N'45'gc\N'45'stats\fR=\fIFILE\fR
تخلیه آمار زباله‌روب (GC) در یک فایل پس از تکمیل ساخت\N'46'
.TP 4
\fB\N'45'\N'45'help\fR[=\fIFMT\fR] (پیش‌فرض=\fBauto\fR)
نمایش این راهنما در قالب \fIFMT\fR\N'46' مقدار \fIFMT\fR باید یکی از \fBauto\fR، \fBpager\fR، \fBgroff\fR یا \fBplain\fR باشد\N'46' در حالت \fBauto\fR، هرگاه متغیر محیطی \fBTERM\fR برابر با \fBdumb\fR یا تعریف‌نشده باشد، قالب به صورت \fBpager\fR یا \fBplain\fR خواهد بود\N'46'
.TP 4
\fB\N'45'\N'45'ignore\N'45'promoted\N'45'rules\fR
نادیده گرفتن قوانین با (mode promote)، به جز مواردی با (only \N'46'\N'46'\N'46')\N'46' متغیر %{ignoring_promoted_rules} در فایل‌های dune مشخص می‌کند که این گزینه ارسال شده است یا خیر\N'46'
.TP 4
\fB\N'45'\N'45'instrument\N'45'with\fR=\fIBACKENDS\fR (پیش‌فرض از متغیر محیطی \fBDUNE_INSTRUMENT_WITH\fR)
فعال‌سازی ابزاردقیق‌سازی (instrumentation) توسط \fBBACKENDS\fR\N'46' مقدار \fBBACKENDS\fR فهرستی از نام‌های کتابخانه‌ها است که با کاما جدا شده‌اند و هر کدام باید یک بک‌اند ابزاردقیق‌سازی را تعریف کرده باشند\N'46'
.TP 4
\fB\N'45'j\fR \fIJOBS\fR (پیش‌فرض از متغیر محیطی \fBDUNE_JOBS\fR)
اجرای حداکثر \fIJOBS\fR دستور به طور همزمان\N'46' مقدار \fIJOBS\fR باید یک عدد صحیح مثبت یا \fBauto\fR برای تشخیص خودکار تعداد هسته‌ها (پیش‌فرض) باشد\N'46'
.TP 4
\fB\N'45'\N'45'no\N'45'buffer\fR
عدم بافر کردن خروجی دستورات اجراشده توسط dune\N'46' به طور پیش‌فرض dune خروجی زیردستورات را بافر می‌کند تا از تداخل خروجی دستورات همزمان جلوگیری شود\N'46' با این حال، این مسئله ممکن است هنگام اشکال‌زدایی تست‌های طولانی مشکل‌ساز شود\N'46' با گزینه \fB\N'45'\N'45'no\N'45'buffer\fR، دستورات دسترسی مستقیم به ترمینال خواهند داشت\N'46' توجه داشته باشید که در این حالت خروجی آن‌ها در فایل لاگ ثبت نخواهد شد\N'46' بهتر است از این گزینه همراه با \fB\N'45'j 1\fR استفاده کنید تا از تداخل خروجی‌ها جلوگیری شود\N'46' علاوه بر این، استفاده از \fB\N'45'\N'45'verbose\fR نیز پیشنهاد می‌شود تا مطمئن شوید دستورات پیش از اجرا چاپ می‌شوند\N'46'
.TP 4
\fB\N'45'\N'45'no\N'45'config\fR
عدم بارگذاری فایل پیکربندی\N'46'
.TP 4
\fB\N'45'\N'45'no\N'45'print\N'45'directory\fR
عدم نمایش پیام‌های "Entering directory"\N'46'
.TP 4
\fB\N'45'\N'45'only\N'45'packages\fR=\fIPACKAGES\fR
نادیده گرفتن استنزاهایی (stanza) که به بسته‌ای ارجاع می‌دهند که در \fBPACKAGES\fR نیست\N'46' مقدار \fBPACKAGES\fR فهرستی از نام‌های بسته‌هاست که با کاما از هم جدا شده‌اند\N'46' توجه داشته باشید که این کار تاثیری مشابه حذف استنزاهای مربوطه از فایل‌های dune دارد\N'46' این گزینه عمدتاً برای انتشار بسته‌ها کاربرد دارد\N'46' در زمان توسعه، احتمالاً ترجیح می‌دهید یک هدف مشخص مثل \fB<package>\N'46'install\fR را بسازید\N'46'
.TP 4
\fB\N'45'p\fR \fIPACKAGES\fR, \fB\N'45'\N'45'for\N'45'release\N'45'of\N'45'packages\fR=\fIPACKAGES\fR (الزامی)
میان‌بری برای \fB\N'45'\N'45'release \N'45'\N'45'pkg=disabled \N'45'\N'45'only\N'45'packages PACKAGE\fR\N'46' برای ساخت مواردی که واقعاً مورد نیاز هستند و دستیابی به ساخت‌های بازتولیدپذیر هنگامی که پروژه شامل چندین بسته است، باید از این گزینه در فایل‌های \fI<package>\N'46'opam\fR خود استفاده کنید\N'46'
.TP 4
\fB\N'45'\N'45'pkg\fR=\fIVAL\fR
فعال یا غیرفعال کردن مدیریت بسته\N'46' رفتار پیش‌فرض بستگی به وجود یا عدم وجود دایرکتوری lock دارد\N'46'
.TP 4
\fB\N'45'\N'45'profile\fR=\fIVAL\fR (پیش‌فرض از متغیر محیطی \fBDUNE_PROFILE\fR)
انتخاب پروفایل ساخت، مثلاً \fBdev\fR یا \fBrelease\fR\N'46' پیش‌فرض \fBdev\fR است\N'46'
.TP 4
\fB\N'45'\N'45'promote\N'45'install\N'45'files\fR[=\fIVAL\fR] (پیش‌فرض=\fBtrue\fR)
ترفیع هرگونه فایل تولیدشده <package>\N'46'install به درخت منبع\N'46'
.TP 4
\fB\N'45'\N'45'release\fR
قرار دادن \fBdune\fR در حالت بازتولیدپذیر \fIrelease\fR\N'46' میان‌بری برای \fB\N'45'\N'45'root \N'46' \N'45'\N'45'ignore\N'45'promoted\N'45'rules \N'45'\N'45'no\N'45'config \N'45'\N'45'profile release \N'45'\N'45'always\N'45'show\N'45'command\N'45'line \N'45'\N'45'promote\N'45'install\N'45'files \N'45'\N'45'require\N'45'dune\N'45'project\N'45'file \N'45'\N'45'default\N'45'target @install\fR\N'46' باید از این گزینه برای ساخت‌های نهایی انتشار استفاده کنید\N'46' به عنوان مثال، باید این گزینه را در فایل‌های \fI<package>\N'46'opam\fR خود به کار ببرید\N'46' مگر اینکه از قبل از \fB\N'45'p\fR استفاده کرده باشید، چرا که \fB\N'45'p\fR این گزینه را در بر دارد\N'46'
.TP 4
\fB\N'45'\N'45'require\N'45'dune\N'45'project\N'45'file\fR[=\fIVAL\fR] (پیش‌فرض=\fBtrue\fR)
شکست در صورت عدم وجود فایل dune\N'45'project\N'46'
.TP 4
\fB\N'45'\N'45'root\fR=\fIDIR\fR (پیش‌فرض از متغیر محیطی \fBDUNE_ROOT\fR)
استفاده از این پوشه به عنوان ریشه فضای کاری به جای حدس زدن آن\N'46' توجه داشته باشید که این گزینه تفسیر هدف‌های داده‌شده در خط فرمان را تغییر نمی‌دهد\N'46' این گزینه فقط برای اسکریپت‌ها در نظر گرفته شده است\N'46'
.TP 4
\fB\N'45'\N'45'store\N'45'orig\N'45'source\N'45'dir\fR (پیش‌فرض از متغیر محیطی \fBDUNE_STORE_ORIG_SOURCE_DIR\fR)
ذخیره مکان اصلی منبع در متادیتای dune\N'45'package\N'46'
.TP 4
\fB\N'45'\N'45'target\N'45'exec\fR=\fITOOLCHAIN=CMD\fR (پیش‌فرض از متغیر محیطی \fBDUNE_TARGET_EXEC\fR)
دستور بسته‌بندی برای اجرای فایل‌های اجرایی هدف هنگام کامپایل متقاطع (cross-compiling)\N'46' قالب: TOOLCHAIN=CMD (مانند \N'39'windows=wine\N'39')\N'46'
.TP 4
\fB\N'45'\N'45'terminal\N'45'persistence\fR=\fIMODE\fR
تغییر نحوه نمایش لاگ نتایج ساخت در کنسول بین بازسازی‌ها در حالت \fB\N'45'\N'45'watch\fR\N'46' حالت‌های پشتیبانی‌شده: \fBpreserve\fR، \fBclear\N'45'on\N'45'rebuild\fR، \fBclear\N'45'on\N'45'rebuild\N'45'and\N'45'flush\N'45'history\fR\N'46'
.TP 4
\fB\N'45'\N'45'trace\N'45'file\fR=\fIFILE\fR
خروجی داده‌های ردیابی در قالب catapult (سازگار با chrome://tracing)\N'46'
.TP 4
\fB\N'45'\N'45'verbose\fR
مشابه \fB\N'45'\N'45'display verbose\fR
.TP 4
\fB\N'45'\N'45'version\fR
نمایش اطلاعات نسخه\N'46'
.TP 4
\fB\N'45'\N'45'watch\N'45'exclusions\fR=\fIREGEX\fR
افزودن یک عبارت باقاعده POSIX که دایرکتوری‌های منطبق را از \fB`dune build \N'45'\N'45'watch`\fR مستثنی می‌کند\N'46' گزینه \fB\N'45'\N'45'watch\N'45'exclusions\fR را می‌توان برای افزودن چندین استثنا تکرار کرد\N'46' نقطه‌ویرگول نیز می‌تواند به عنوان جداکننده استفاده شود\N'46' در صورت عدم ارائه استثناها، مجموعه‌ای استاندارد از استثناها اعمال می‌شود؛ اما اگر \fIیک یا چند\fR \fB\N'45'\N'45'watch\N'45'exclusions\fR مشخص شود، \fBهیچ‌یک\fR از استثناهای استاندارد اعمال نخواهد شد\N'46' استثناهای استاندارد عبارتند از: ^_opam /_opam ^_esy /_esy ^\N'92'\N'46'#\N'46'* /\N'92'\N'46'#\N'46'* ~$ ^#[^#]*#$ /#[^#]*#$ ^4913$ /4913$ /\N'46'git /\N'46'hg :/windows
.TP 4
\fB\N'45'\N'45'workspace\fR=\fIFILE\fR (پیش‌فرض از متغیر محیطی \fBDUNE_WORKSPACE\fR)
استفاده از این فایل فضای کاری مشخص به جای جستجوی آن\N'46'
.TP 4
\fB\N'45'x\fR \fIVAL\fR (پیش‌فرض از متغیر محیطی \fBDUNE_CROSS_TARGET\fR)
کامپایل متقاطع با استفاده از این زنجیره ابزار (toolchain)\N'46'
.SH "راهنمای بیشتر (MORE HELP)"
.P
برای دریافت راهنمای یک دستور خاص از `\fBdune\fR \fICOMMAND\fR \N'45'\N'45'help\N'39' استفاده کنید\N'46'
.SH "وضعیت خروج (EXIT STATUS)"
.P
دستور \fBdune top\fR با کدهای زیر خارج می‌شود:
.TP 4
0
در صورت موفقیت\N'46'
.TP 4
1
در صورت بروز خطا\N'46'
.TP 4
130
اگر با یک سیگنال متوقف شده باشد\N'46'
.SH "محیط (ENVIRONMENT)"
.P
این متغیرهای محیطی بر اجرای \fBtop\fR اثر می‌گذارند:
.TP 4
\fBDUNE_BUILD_DIR\fR
پوشه مشخص‌شده برای ساخت\N'46' در صورت عدم تعیین، _build استفاده می‌شود\N'46'
.TP 4
\fBDUNE_CACHE\fR
فعال یا غیرفعال کردن کش Dune (یکی از مقادیر \fBdisabled\fR، \fBenabled\N'45'except\N'45'user\N'45'rules\fR یا \fBenabled\fR)\N'46' مقدار پیش‌فرض `enabled\N'45'except\N'45'user\N'45'rules\N'39' است\N'46'
.TP 4
\fBDUNE_CACHE_CHECK_PROBABILITY\fR
بررسی بازتولیدپذیری ساخت از طریق اجرای مجدد تصادفی قوانین و مقایسه نتایج با موارد ذخیره‌شده در کش Dune\N'46' نکته: افزایش احتمال این بررسی‌ها سرعت ساخت را کاهش می‌دهد\N'46' احتمال پیش‌فرض صفر است، یعنی هیچ قانونی بررسی نمی‌شود\N'46'
.TP 4
\fBDUNE_CACHE_STORAGE_MODE\fR
حالت ذخیره‌سازی کش Dune (یکی از مقادیر \fBauto\fR، \fBhardlink\fR یا \fBcopy\fR)\N'46' مقدار پیش‌فرض `hardlink\N'39' است\N'46'
.TP 4
\fBDUNE_CROSS_TARGET\fR
کامپایل متقاطع با استفاده از این زنجیره ابزار\N'46'
.TP 4
\fBDUNE_DEBUG_PACKAGE_LOGS\fR
همیشه لاگ‌های استاندارد را هنگام ساخت بسته‌ها چاپ می‌کند\N'46'
.TP 4
\fBDUNE_DIFF_COMMAND\fR
دستور پوسته برای مقایسه فایل‌ها\N'46' برای غیرفعال کردن چاپ تفاوت‌ها از \N'45' استفاده کنید\N'46'
.TP 4
\fBDUNE_DISABLE_PROMOTION\fR
غیرفعال کردن تمامی قوانین ترفیع\N'46'
.TP 4
\fBDUNE_INSTRUMENT_WITH\fR
فعال‌سازی ابزاردقیق‌سازی توسط \fBBACKENDS\fR\N'46' مقدار \fBBACKENDS\fR فهرستی از نام‌های کتابخانه‌هاست که با کاما جدا شده‌اند و هر کدام باید یک بک‌اند ابزاردقیق‌سازی را تعریف کرده باشند\N'46'
.TP 4
\fBDUNE_JOBS\fR
اجرای حداکثر \fIJOBS\fR دستور به طور همزمان\N'46' مقدار \fIJOBS\fR باید یک عدد صحیح مثبت یا \fBauto\fR برای تشخیص خودکار تعداد هسته‌ها (پیش‌فرض) باشد\N'46'
.TP 4
\fBDUNE_PROFILE\fR
پروفایل ساخت\N'46' در صورت عدم تعیین برابر با \fBdev\fR یا در صورت تنظیم \N'45'p برابر با \fBrelease\fR\N'46'
.TP 4
\fBDUNE_ROOT\fR
استفاده از این پوشه به عنوان ریشه فضای کاری به جای حدس زدن آن\N'46' توجه داشته باشید که این گزینه تفسیر هدف‌های داده‌شده در خط فرمان را تغییر نمی‌دهد\N'46' این گزینه فقط برای اسکریپت‌ها در نظر گرفته شده است\N'46'
.TP 4
\fBDUNE_SANDBOX\fR
حالت ایزوله‌سازی پیش‌فرض\N'46' (مشاهده کنید \N'45'\N'45'sandbox)
.TP 4
\fBDUNE_STORE_ORIG_SOURCE_DIR\fR
ذخیره مکان اصلی منبع در متادیتای dune\N'45'package\N'46'
.TP 4
\fBDUNE_TARGET_EXEC\fR
دستور بسته‌بندی برای اجرای فایل‌های اجرایی هدف هنگام کامپایل متقاطع\N'46' قالب: TOOLCHAIN=CMD (مانند \N'39'windows=wine\N'39')\N'46'
.TP 4
\fBDUNE_WORKSPACE\fR
استفاده از این فایل فضای کاری مشخص به جای جستجوی آن\N'46'
.SH "اشکالات (BUGS)"
.P
گزارش اشکالات را در https://github\N'46'com/ocaml/dune/issues بررسی کنید
.SH "همچنین ببینید (SEE ALSO)"
.P
dune(1)
