    def __aenter__(self):
        pass

    def __aexit__(self, *exc):
        pass


async def foo():
    async with AsyncContextManager():
        pass

.EE
.UNINDENT
.UNINDENT
.sp
\fBAdditional details:\fP
.sp
Async context manager doesn\(aqt implement \fB__aenter__\fP and \fB__aexit__\fP\&. It can\(aqt be emitted when using Python < 3.5.
