.I "237 fnt3  k[3]"
تنظیم
.IR "f = k" .
.TP
.I "238 fnt4  k[+4]"
تنظیم
.IR "f = k" .
.TP
.I "239 xxx1  k[1]  x[k]"
رشتهٔ ویژهٔ
.I x
با
.I k
بایت.
.TP
.I "240 xxx2  k[2]  x[k]"
رشتهٔ ویژهٔ
.I x
با
.I k
بایت.
