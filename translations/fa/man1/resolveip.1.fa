'\" t
.\"
.TH "\fBRESOLVEIP\fR" "1" "5 March 2025" "MariaDB 11.8" "MariaDB Database System"
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.\" resolveip
.SH "نام (NAME)"
resolveip \- تبدیل نام میزبان به نشانی IP یا برعکس
.SH "خلاصه دستور (SYNOPSIS)"
.HP \w'\fBresolveip\ [\fR\fB\fIگزینه‌ها\fR\fR\fB]\ {\fR\fB\fIنام_میزبان\fR\fR\fB|\fR\fB\fIنشانی\-ip\fR\fR\fB}\ \&.\&.\&.\fR\ 'u
\fBresolveip [\fR\fB\fIگزینه‌ها\fR\fR\fB] {\fR\fB\fIنام_میزبان\fR\fR\fB|\fR\fB\fIنشانی\-ip\fR\fR\fB} \&.\&.\&.\fR
.SH "توضیحات (DESCRIPTION)"
.PP
ابزار
.B resolveip
نام‌های میزبان را به نشانی‌های IP و برعکس ترجمه و تفکیک می‌کند.
.PP
اجرای
.B resolveip
به شکل زیر است:
.sp
.if n \{\
.RS 4
.\}
.nf
shell> \fBresolveip [\fR\fB\fIگزینه‌ها\fR\fR\fB] {\fR\fB\fIنام_میزبان\fR\fR\fB|\fR\fB\fIنشانی\-ip\fR\fR\fB} \&.\&.\&.\fR
.fi
.if n \{\
.RE
.\}
.PP
.B resolveip
از گزینه‌های زیر پشتیبانی می‌کند:
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
.\" resolveip: help option
.\" help option: resolveip
\fB\-\-help\fR,
\fB\-\-info\fR,
\fB\-?\fR,
\fB\-I\fR
.sp
نمایش پیام راهنما و خروج.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
.\" resolveip: silent option
.\" silent option: resolveip
\fB\-\-silent\fR,
\fB\-s\fR
.sp
حالت بی‌صدا؛ تولید خروجی کمتر.
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
.\" resolveip: version option
.\" version option: resolveip
\fB\-\-version\fR,
\fB\-V\fR
.sp
نمایش اطلاعات نگارش و خروج.
.RE
