.\" -*- nroff -*-
.TH DTRACE 1
.SH "نام (NAME)"
dtrace \- ابزار سازگاری ردیابی پویا DTrace مبتنی بر SystemTap

.\" macros
.\" do not nest SAMPLEs
.de SAMPLE
.br

.nr oldin \\n(.i
.RS
.nf
.nh
..
.de ESAMPLE
.hy
.fi
.RE
.in \\n[oldin]u

..

.SH "خلاصه دستور (SYNOPSIS)"

.br
.B dtrace \-s \fIfile\fR [\fBOPTIONS\fR]

.SH "توضیحات (DESCRIPTION)"

دستور
.B dtrace
توصیف‌های پروب تعریف‌شده در
.I file.d
را از طریق گزینه
.B \-h
به یک فایل هدر پروب یا از طریق گزینه
.B \-G
به یک فایل توصیف پروب تبدیل می‌کند.

.SH "گزینه‌ها (OPTIONS)"
.PP
.TP
.B \-h
تولید فایل هدر systemtap.

.TP
.B \-G
تولید فایل آبجکت تعریف پروب systemtap. این گزینه کامپایلر C را با مجموعه‌ای معقول از فلگ‌های کامپایلر فراخوانی می‌کند. در صورت نیاز به افزودن گزینه‌های بیشتر، فلگ‌های موجود در متغیر محیطی
.B CFLAGS
به کامپایلر منتقل خواهند شد. اگر این میزان کنترل کافی نیست، از گزینه
.B \-k
برای نگهداری فایل C تولیدشده و کامپایل دستی آن استفاده کنید.

.TP
.B \-o \fIfile\fR
نام فایل خروجی را تعیین می‌کند. اگر گزینه
.B \-G
داده شود، فایل خروجی
.I file.o
نامیده خواهد شد؛ اگر گزینه
.B \-h
داده شود، فایل خروجی
.I file.h
نام خواهد گرفت.

.TP
.B \-C
اجرای پیش‌پردازنده cpp روی فایل ورودی در هنگام استفاده از گزینه
.BR \-h .

.TP
.B \-I \fIfile\fR
مسیر include مشخص‌شده را در صورت استفاده از گزینه
.B \-C
به cpp ارسال می‌کند.

.TP
.B \-k
نگهداری فایل‌های موقت، به عنوان مثال کد منبع زبان C مربوط به گزینه
.BR \-G .

.SH "مثال‌ها (EXAMPLES)"

ابزار Systemtap با پشتیبانی از پروب‌های ایستا در برنامه‌های کاربری dtrace سازگاری کامل در سطح کد منبع دارد.
با فرض فایلی به نام
.I test.d
شامل محتوای زیر:
.SAMPLE
provider sdt_probes
{
  probe test_0 (int type);
  probe test_1 (struct astruct node);
};
struct astruct {int a; int b;};
.ESAMPLE
سپس دستور
.I "dtrace\ \-s\ test.d\ \-G"
فایل تعریف پروب
.I test.o
را ایجاد خواهد کرد و دستور
.I "dtrace\ \-s\ test.d\ \-h"
فایل هدر پروب
.I test.h
را تولید خواهد نمود.
سپس برنامه کاربردی می‌تواند از ماکروهای تولیدشده به این صورت استفاده کند:
.SAMPLE
#include "test.h"
 \.\.\.
struct astruct s;
 \.\.\.
SDT_PROBES_TEST_0(value);
 \.\.\.
if (SDT_PROBES_TEST_1_ENABLED())
    SDT_PROBES_TEST_1(expensive_function(s));
.ESAMPLE

.SH "سمافورها (SEMAPHORES)"

سمافورها متغیرهای پرچمی هستند که توسط پروب‌ها برای دور زدن پردازش‌های بالقوه سنگین جهت آماده‌سازی آرگومان‌های پروب‌هایی که شاید حتی فعال نباشند استفاده می‌شوند. این متغیرها هنگام اجرای اسکریپت مرتبط، به طور خودکار توسط systemtap مقداردهی/پاکسازی می‌شوند؛ بنابراین هزینه آماده‌سازی آرگومان تنها در صورت نیاز پرداخت می‌شود. این متغیرهای سمافور درون فایل آبجکت
.I "test.o"
تعریف می‌شوند که در نتیجه باید به برنامه کاربردی پیوند (link) داده شوند.
.PP
گاهی اوقات متغیرهای سمافور نه ضروری هستند و نه مفید. صرف‌نظر کردن از آن‌ها می‌تواند فرایند ساخت را با حذف فایل اضافی
.I "test.o"
ساده کند. برای حذف وابستگی به متغیرهای سمافور، هدر
.I "<sys/sdt.h>"
را پیش از
.I "test.h"
در برنامه قرار دهید:
.SAMPLE
#include <sys/sdt.h>
#include "test.h"
 \.\.\.
struct astruct s;
 \.\.\.
SDT_PROBES_TEST_0(value);
 \.\.\.
if (SDT_PROBES_TEST_1_ENABLED())
   SDT_PROBES_TEST_1(cheap_function(s));
.ESAMPLE
در این حالت، آزمایش ()ENABLED روی مقدار 1 ثابت خواهد بود.

.SH "همچنین ببینید (SEE ALSO)"
.nh
.nf
