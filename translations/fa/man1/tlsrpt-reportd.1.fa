.TH "TLSRPT\-REPORTD" "1" "2026-09-01" "tlsrpt\-reportd" "tlsrpt\-reportd"
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.ss \n[.ss] 0
.nh
.ad l
.de URL
\fI\\$2\fP <\\$1>\\$3
..
.als MTO URL
.if \n[.g] \{\
.  mso www.tmac
.  am URL
.    ad l
