'\" t
.nh
.TH podman-volume 1
.SH "نام (NAME)"
podman-volume \- ابزار ساده مدیریت حجم‌ها

.SH "خلاصه دستور (SYNOPSIS)"
\fBpodman volume\fP \fIزیردستور\fP

.SH "توضیحات (DESCRIPTION)"
دستور \fBpodman volume\fP مجموعه‌ای از زیردستورها برای مدیریت حجم‌ها است.

.SH "زیردستورات (SUBCOMMANDS)"
.TS
allbox;
l l l 
l l l .
\fBدستور\fP	\fBصفحه راهنما\fP	\fBتوضیحات\fP
create	podman-volume-create(1)	ایجاد یک حجم جدید.
exists	podman-volume-exists(1)	T{
بررسی وجود داشتن یک حجم مشخص.
T}
export	podman-volume-export(1)	برون‌بری حجم به یک فایل tar خارجی.
import	podman-volume-import(1)	T{
درون‌ریزی محتوای یک فایل tarball به داخل یک حجم موجود پادمن.
T}
inspect	podman-volume-inspect(1)	T{
دریافت اطلاعات دقیق درباره یک یا چند حجم.
T}
ls	podman-volume-ls(1)	T{
فهرست کردن تمام حجم‌های موجود.
T}
mount	podman-volume-mount(1)	سوار کردن (mount) سیستم‌فایل یک حجم.
prune	podman-volume-prune(1)	حذف حجم‌های استفاده‌نشده.
reload	podman-volume-reload(1)	T{
بارگذاری مجدد تمام حجم‌ها از افزونه‌های حجم.
T}
rename	podman-volume-rename(1)	تغییر نام یک حجم.
rm	podman-volume-rm(1)	حذف یک یا چند حجم.
unmount	podman-volume-unmount(1)	پیاده کردن (unmount) یک حجم.
.TE

.SH "همچنین ببینید (SEE ALSO)"
\fBpodman(1)\fP

.SH "تاریخچه (HISTORY)"
