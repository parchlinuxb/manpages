.TH "GIT-BUG" "1" "Apr 2019" "Generated from git-bug's source code" ""

.SH "نام (NAME)"
git-bug-bug-show \- نمایش جزئیات یک باگ


.SH "خلاصه دستور (SYNOPSIS)"
\fBgit-bug bug show [BUG_ID] [flags]\fP


.SH "توضیحات (DESCRIPTION)"
نمایش جزئیات یک باگ


.SH "گزینه‌ها (OPTIONS)"
\fB--field\fP=""
	انتخاب فیلد برای نمایش. مقادیر معتبر عبارتند از [author,authorEmail,createTime,lastEdit,humanId,id,labels,shortId,status,title,actors,participants]

.PP
\fB-f\fP, \fB--format\fP="default"
	انتخاب سبک قالب‌بندی خروجی. مقادیر معتبر عبارتند از [default,json,org-mode]

.PP
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای show


.SH "همچنین ببینید (SEE ALSO)"
\fBgit-bug-bug(1)\fP
