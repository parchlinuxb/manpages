.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-stack-rm \- حذف یک یا چند پشته (stack)


.SH "خلاصه (SYNOPSIS)"
\fBdocker stack rm [OPTIONS] STACK [STACK...]\fP


.SH "شرح (DESCRIPTION)"
حذف یک یا چند پشته (stack)


.SH "گزینه‌ها (OPTIONS)"
\fB-d\fP, \fB--detach\fP[=true]
	عدم انتظار برای تکمیل حذف پشته


.SH "ببینید (SEE ALSO)"
\fBdocker-stack(1)\fP
