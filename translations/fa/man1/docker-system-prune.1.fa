.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-system-prune \- حذف داده‌های استفاده‌نشده


.SH "خلاصه (SYNOPSIS)"
\fBdocker system prune [OPTIONS]\fP


.SH "شرح (DESCRIPTION)"
حذف داده‌های استفاده‌نشده


.SH "گزینه‌ها (OPTIONS)"
\fB-a\fP, \fB--all\fP[=false]
	حذف تمام ایمیج‌های استفاده‌نشده، نه فقط موارد معلق (dangling)

.PP
\fB--filter\fP=
	ارائه مقادیر فیلتر (مانند "label==")

.PP
\fB-f\fP, \fB--force\fP[=false]
	عدم درخواست تاییدیه

.PP
\fB--volumes\fP[=false]
	پاکسازی حجم‌های ناشناس (anonymous volumes)


.SH "ببینید (SEE ALSO)"
\fBdocker-system(1)\fP
