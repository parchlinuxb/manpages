.TH "tuned.conf" "5" "13 مارس 2012" "Jan Kaluža" "راهنمای پارچ لینوکس"
.SH "نام (NAME)"
tuned.conf \- پرونده تعریف نمایه TuneD
.SH "توضیحات (DESCRIPTION)"
این صفحه راهنما قالب پرونده‌های تعریف نمایه TuneD 2.0 را مستند می‌کند.
تعریف نمایه در پرونده
/etc/tuned/profiles/<profile_name>/tuned.conf
یا
/usr/lib/tuned/profiles/<profile_name>/tuned.conf
ذخیره می‌شود، که در آن پوشه
/etc/tuned/profiles/
اولویت بالاتری دارد.
.PP
پرونده
\fBtuned.conf\fR
نمایه را پیکربندی می‌کند و ساختاری در قالب ini دارد.

.SH "بخش اصلی (MAIN SECTION)"
بخش اصلی با عنوان «[main]» نام‌گذاری شده و می‌تواند شامل گزینه‌های زیر باشد:

.TP
include=
نمایه‌ای با نام مشخص‌شده را فراخوانی می‌کند. این ویژگی به شما اجازه می‌دهد نمایه جدیدی را بر پایه یک نمایه موجود ایجاد کنید. در صورتی که پارامترهای متناقضی در نمایه جدید و نمایه پایه وجود داشته باشد، مقادیر نمایه جدید اعمال خواهند شد.

.SH "پلاگین‌ها (PLUGINS)"
هر بخش دیگر یک افزونه (پلاگین) را تعریف می‌کند. نام بخش به عنوان نام افزونه استفاده شده و در گزارش‌ها برای شناسایی آن به کار می‌رود. برای بهینه‌سازی یک دستگاه خاص، در هر زمان تنها یک افزونه از یک نوع می‌تواند فعال باشد. تداخل‌ها به‌طور پیش‌فرض با ادغام گزینه‌های هر دو افزونه برطرف می‌شوند. این رفتار را می‌توان با گزینه «replace» تغییر داد.
.PP
هر بخش افزونه می‌تواند شامل فیلدهای زیر باشد:

.TP
type=
نوع افزونه. در حال حاضر افزونه‌های رسمی زیر در دسترس هستند: audio, bootloader, cpu, disk, eeepc_she, modules, mounts, net, script, scsi_host, selinux, scheduler, sysctl, sysfs, systemd, usb, video, vm. این فهرست ممکن است کامل نباشد. اگر TuneD را از طریق بسته RPM نصب کرده‌اید، می‌توانید با دستور زیر افزونه‌های موجود را مشاهده کنید:
.B rpm -ql tuned | grep 'plugins/plugin_.*.py$'
پوشه افزونه‌ها را که توسط این دستور بازگردانده می‌شود برای دیدن تمام افزونه‌ها (مثلاً افزونه‌های شخص ثالث) بررسی کنید.

.TP
devices=
فهرستی از دستگاه‌ها با کاما جدا شده که باید توسط این افزونه بهینه‌سازی شوند. اگر این گزینه حذف شود، تمام دستگاه‌های شناسایی‌شده تنظیم خواهند شد.
.TP
replace=1
اگر بین دو افزونه تداخلی وجود داشته باشد (یعنی دو افزونه از یک نوع برای پیکربندی دستگاه‌های یکسان تلاش کنند)، افزونه‌ای که بعداً تعریف شده است جایگزین تمام گزینه‌های افزونه قبلی می‌شود.
.LP
افزونه‌ها همچنین می‌توانند گزینه‌های اختصاصی خود را داشته باشند.

.SH "مثال‌ها (EXAMPLES)"
.nf
[main]
# شامل کردن افزونه‌های تعریف‌شده در نمایه "included".
include=included

# تعریف افزونه my_sysctl
[my_sysctl]
type=sysctl
# این افزونه جایگزین هرگونه افزونه sysctl موجود در نمایه "included" می‌شود
replace=1
# مقدار پیش‌فرض ۲۵۶ کیلوبایت در آزمایش‌ها عملکرد خوبی داشته است.
net.core.rmem_default = 262144
net.core.wmem_default = 262144

# تعریف افزونه my_script
# هر دو اسکریپت (profile.sh از این نمایه و اسکریپت نمایه "included")
# اجرا خواهند شد، زیرا اگر گزینه "replace=1" نباشد
# رفتار پیش‌فرض ادغام است.
[my_script]
type=script
script=${i:PROFILE_DIR}/profile.sh
.fi

.SH "همچنین ببینید (SEE ALSO)"
.LP
.BR tuned (8)
