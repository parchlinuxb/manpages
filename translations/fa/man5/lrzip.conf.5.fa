.TH "lrzip.conf" "5" "January 2009, updated May 2019" "" ""
.SH "نام (NAME)"
lrzip.conf \- پرونده پیکربندی lrzip
.SH "توضیحات (DESCRIPTION)"
.PP
این پرونده در صورت استفاده، توسط برنامه
.B lrzip
خوانده و تجزیه شده و گزینه‌ها به برنامه ارسال می‌شوند\&. برخی از گزینه‌ها ممکن است از طریق خط فرمان لغو (override) شوند\&. گزینه‌های دیگر ثابت هستند\&.
.PP
پرونده پیکربندی باید
.B lrzip\&.conf
نامیده شود\&. برنامه
.B lrzip
به‌طور خودکار پرونده را در یکی از این سه مکان جستجو می‌کند:
.nf
$PWD \- دایرکتوری جاری
/etc/lrzip
$HOME/\&.lrzip
.fi
.PP
پارامترها به شیوه
.B PARAMETER\&=VALUE
تنظیم می‌شوند که در آن هر خطی که با یک
.B #
شروع شود یا خالی باشد، نادیده گرفته خواهد شد\&.
مقادیر پارامترها به حروف بزرگ و کوچک حساس نیستند مگر در مواردی که مشخص شده باشد\&.
.PP
.SH "مثال پرونده پیکربندی (CONFIG FILE EXAMPLE)"
.nf
# این یک توضیح است.

# اندازه پنجره فشرده‌سازی بر حسب ۱۰۰ مگابایت. معمولاً توسط برنامه انتخاب می‌شود. (-w)
# WINDOW = 20
# سطح فشرده‌سازی ۱ تا ۹ (پیش‌فرض ۷). (-L)
# COMPRESSIONLEVEL = 7
# استفاده از تنظیم -U، حافظه رم نامحدود. Yes یا No
# UNLIMITED = NO
# روش فشرده‌سازی: rzip، gzip، bzip2، lzo، یا lzma (پیش‌فرض)، یا zpaq. (-n -g -b -l --lzma -z)
# در صورت مشخص شدن در اینجا، گزینه‌های خط فرمان قابل استفاده نخواهند بود.
# COMPRESSIONMETHOD = lzma
# انجام آزمون LZO. پیش‌فرض = YES (-T )
# LZOTEST = NO
# بررسی هش هنگام استخراج/از فشرده خارج کردن، (-c)
# HASHCHECK = YES
# نمایش مقدار HASH هنگام فشرده‌سازی حتی اگر جزئیات (Verbose) خاموش باشد، YES (-H)
# SHOWHASH = YES

# دایرکتوری خروجی پیش‌فرض (-O)
# OUTPUTDIRECTORY = location
# میزان جزئیات خروجی، YES یا MAX (v, vv)
# VERBOSITY = max
# نمایش پیشرفت هنگام پردازش پرونده، YES یا no (گزینه NO = -q)
# SHOWPROGRESS = YES

# تنظیم Niceness. مقدار پیش‌فرض ۱۹ است. محدوده مجاز از -20 تا 19 است (-N)
# NICE = 19

# نگه‌داشتن پرونده‌های خروجی خراب یا آسیب‌دیده، YES (-K)
# KEEPBROKEN = YES

# حذف پرونده منبع پس از فشرده‌سازی (-D)
# این پارامتر و مقدار آن به حروف بزرگ و کوچک حساس هستند
# مقدار باید برای فعال‌سازی روی YES باشد

# DELETEFILES = NO

# جایگزینی پرونده موجود lrzip هنگام فشرده‌سازی (-f)
# این پارامتر و مقدار آن به حروف بزرگ و کوچک حساس هستند
# مقدار باید برای فعال‌سازی روی YES باشد

# REPLACEFILE = YES

# بازنویسی برای دایرکتوری موقت. فقط زمانی معتبر است که stdin/out یا Test استفاده شود
# TMPDIR = /tmp

# تعیین استفاده از رمزگذاری هنگام فشرده‌سازی YES، NO (-e)
# ENCRYPT = NO

.fi
.PP
.SH "نکات (NOTES)"
.PP
هنگام استفاده از
.B DELETEFILES
یا
.B REPLACEFILE
مراقب باشید، زیرا هیچ هشداری داده نخواهد شد و
.B lrzip
به‌سادگی پرونده منبع را حذف کرده یا پرونده خروجی را جایگزین خواهد کرد!
.PP
.SH "همچنین ببینید (SEE ALSO)"
.BR lrzip (1)
