'\" t
.TH "ORG\&.FREEDESKTOP\&.PORTABLE1" "5" "" "systemd 261.2" "org.freedesktop.portable1"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
org.freedesktop.portable1 \- رابط دی‌باس سرویس مدیریت سرویس‌های پرتابل سیستم‌دی (systemd-portabled)
.SH "توضیحات (DESCRIPTION)"
.PP
\fBsystemd-portabled.service\fR(8)
یک سرویس سیستمی است که می‌تواند برای متصل کردن (attach)، جدا کردن (detach) و بازرسی سرویس‌های پرتابل به کار رود\&. این صفحه رابط کاربری D\-Bus را شرح می‌دهد\&.
.SH "شیء MANAGER (THE MANAGER OBJECT)"
.PP
این سرویس رابط‌های زیر را روی شیء Manager در گذرگاه ارائه می‌دهد:
.sp
.if n \{\
.RS 4
.\}
.nf
node /org/freedesktop/portable1 {
  interface org\&.freedesktop\&.portable1\&.Manager {
    methods:
      GetImage(in  s image,
               out o object);
      ListImages(out a(ssbtttso) images);
      GetImageOSRelease(in  s image,
                        out a{ss} os_release);
      GetImageMetadata(in  s image,
                       in  as matches,
                       out s image,
                       out ay os_release,
                       out a{say} units);
      GetImageMetadataWithExtensions(in  s image,
                                     in  as extensions,
                                     in  as matches,
                                     in  t flags,
                                     out s image,
                                     out ay os_release,
                                     out a{say} extensions,
                                     out a{say} units);
      GetImageState(in  s image,
                    out s state);
      GetImageStateWithExtensions(in  s image,
                                  in  as extensions,
                                  in  t flags,
                                  out s state);
      AttachImage(in  s image,
                  in  as matches,
                  in  s profile,
                  in  b runtime,
                  in  s copy_mode,
                  out a(sss) changes);
      AttachImageWithExtensions(in  s image,
                                in  as extensions,
                                in  as matches,
                                in  s profile,
                                in  s copy_mode,
                                in  t flags,
                                out a(sss) changes);
      DetachImage(in  s image,
                  in  b runtime,
                  out a(sss) changes);
      DetachImageWithExtensions(in  s image,
                                in  as extensions,
                                in  t flags,
                                out a(sss) changes);
      ReattachImage(in  s image,
                    in  as matches,
                    in  s profile,
                    in  b runtime,
                    in  s copy_mode,
                    out a(sss) changes_removed,
                    out a(sss) changes_updated);
      ReattachImageWithExtensions(in  s image,
                                  in  as extensions,
                                  in  as matches,
                                  in  s profile,
                                  in  s copy_mode,
                                  in  t flags,
                                  out a(sss) changes_removed,
                                  out a(sss) changes_updated);
      RemoveImage(in  s image);
      MarkImageReadOnly(in  s image,
                        in  b read_only);
      SetImageLimit(in  s image,
                    in  t limit);
      SetPoolLimit(in  t limit);
    properties:
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly s PoolPath = \*(Aq\&.\&.\&.\*(Aq;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly t PoolUsage = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly t PoolLimit = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly as Profiles = [\*(Aq\&.\&.\&.\*(Aq, \&.\&.\&.];
  };
  interface org\&.freedesktop\&.DBus\&.Peer { \&.\&.\&. };
  interface org\&.freedesktop\&.DBus\&.Introspectable { \&.\&.\&. };
  interface org\&.freedesktop\&.DBus\&.Properties { \&.\&.\&. };
};
.fi
.if n \{\
.RE
.\}
.SS "متدها (Methods)"
.PP
\fBGetImage()\fR
می‌تواند برای دریافت مسیر شیء تصویر برای تصویری با نام مشخص‌شده به کار رود\&.
.PP
\fBListImages()\fR
آرایه‌ای از تمام تصویرهای شناخته‌شدهٔ فعلی را بازمی‌گرداند\&. ساختارهای موجود در این آرایه شامل فیلدهای زیر هستند: نام تصویر، نوع، فلگ فقط‌خواندنی، زمان ایجاد، زمان تغییر، فضای فعلی دیسک، میزان استفاده و مسیر شیء تصویر\&.
.PP
\fBGetImageOSRelease()\fR
اطلاعات انتشار سیستم‌عامل (OS release) یک تصویر را بازیابی می‌کند\&. این متد آرایه‌ای از جفت‌های کلید\-مقدار خوانده‌شده از فایل
\fBos-release\fR(5)
در داخل تصویر را بازمی‌گرداند و برای شناسایی سیستم‌عامل مورد استفاده در یک سرویس پرتابل مفید است\&.
.PP
\fBGetImageMetadata()\fR
متاداده‌های مرتبط با یک تصویر را بازیابی می‌کند\&. این متد نام تصویر، محتوای
\fBos-release\fR(5)
تصویر را در قالب یک آرایه بایت (قابل استریم)، و فهرستی از واحدهای پرتابل موجود در تصویر را در قالب یک رشته (نام واحد) و آرایه‌ای از بایت‌ها شامل محتوا بازمی‌گرداند\&.
.PP
\fBGetImageMetadataWithExtensions()\fR
متاداده‌های مرتبط با یک تصویر را بازیابی می‌کند\&. این متد یک ابرمجموعه از
\fBGetImageMetadata()\fR
است که فهرستی از اکستنشن‌ها (افزونه‌ها) را به عنوان پارامتر ورودی اضافه دارد، که این اکستنشن‌ها از طریق
\fBAttachImageWithExtensions()\fR
روی تصویر اصلی سوار (overlay) شده‌اند\&. مسیر هر اکستنشن و یک آرایه بایت شامل محتوای فایل extension\-release مربوطه بازگردانده می‌شود؛ برای هر اکستنشنِ نام‌برده در آرگومان‌های ورودی، یک چنین ساختاری بازگردانده خواهد شد\&.
.PP
\fBGetImageState()\fR
وضعیت تصویر را به صورت یکی از رشته‌های زیر بازمی‌یابد:
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
detached
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
attached
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
attached\-runtime
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
enabled
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
enabled\-runtime
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
running
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
running\-runtime
.RE
.PP
\fBGetImageStateWithExtensions()\fR
یک ابرمجموعه از
\fBGetImageState()\fR
است، همراه با پشتیبانی افزوده از فهرستی از اکستنشن‌ها به عنوان پارامترهای ورودی، که در صورتی که تصویر به آن روش خاص متصل شده باشد، برای استعلام وضعیت لازم است\&. پارامتر
\fIflags\fR
در حال حاضر بلااستفاده بوده و برای اهداف آینده رزرو شده است\&.
.PP
\fBAttachImage()\fR
یک تصویر پرتابل را به سیستم متصل می‌کند\&. این متد یک مسیر یا نام تصویر، فهرستی از رشته‌ها که برای جستجوی فایل‌های واحد (unit files) در داخل تصویر استفاده می‌شوند (تطابق جزئی یا کامل)، یک رشته که نشان می‌دهد از کدام پروفایل پرتابل برای تصویر استفاده شود (برای فهرستی از پروفایل‌های موجود به ویژگی
\fIProfiles\fR
مراجعه کنید)، یک مقدار بولی که مشخص می‌کند آیا تصویر فقط برای نشست بوت فعلی متصل شود یا خیر، و یک رشته که نشان‌دهندهٔ حالت کپی ترجیحی است (اینکه تصویر کپی شود یا فقط پیوند نمادین/symlink ایجاد گردد) با مقادیر ممکن زیر را دریافت می‌کند:
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
(empty)
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
copy
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
symlink
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
mixed
.RE
.sp
اگر یک رشتهٔ خالی ارسال شود، پرونده‌های drop\-in پروفایل امنیتی و تصویرها به‌صورت پیوند نمادین (symlink) متصل می‌شوند در حالی که فایل‌های واحد کپی خواهند شد؛ مقدار
\fIcopy\fR
کپی می‌کند،
\fIsymlink\fR
در صورت امکان پیوند زدن را ترجیح می‌دهد (برای مثال: یک واحد باید از یک تصویر کپی شود)، و
\fImixed\fR
پیوند زدن منابع متعلق به سیستم‌عامل (مانند پروفایل پرتابل واقع در درخت /usr/ میزبان) را ترجیح می‌دهد اما منابع متعلق به تصویر پرتابل (مانند فایل‌های واحد و تصویرها) را کپی می‌کند\&. این متد فهرستی از تغییرات اعمال‌شده روی سیستم را بازمی‌گرداند (به‌عنوان مثال، کدام واحد اضافه شده و اکنون به‌عنوان یک سرویس سیستمی در دسترس است)\&. هر تغییر به‌صورت یک سه‌تایی از رشته‌ها نمایش داده می‌شود: نوع تغییر اعمال‌شده، مسیری که تغییر روی آن اعمال شده، و منبع (در صورت وجود)\&. نوع تغییر اعمال‌شده یکی از مقادیر ممکن زیر خواهد بود:
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
copy
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
symlink
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
write
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
mkdir
.RE
.sp
توجه داشته باشید که اگر واحدی که در تصویر وجود دارد از قبل روی سیستم موجود باشد، تصویر نمی‌تواند متصل شود\&. همچنین توجه داشته باشید که این متد تنها پس از تکمیل تمام عملیات‌های ذکرشده بازمی‌گردد، و با توجه به حجم ورودی/خروجی (I/O) درگیر، ممکن است مدتی طول بکشد\&.
.PP
به جای مسیر تصویر، می‌توان یک دایرکتوری دارای نسخهٔ
"\&.v/"
مشخص کرد؛ برای جزئیات به
\fBsystemd.v\fR(7)
مراجعه کنید\&.
.PP
به جای مسیر دایرکتوری، می‌توان یک دایرکتوری دارای نسخهٔ
"\&.v/"
مشخص کرد؛ برای جزئیات به
\fBsystemd.v\fR(7)
مراجعه کنید\&.
.PP
\fBAttachImageWithExtensions()\fR
یک تصویر پرتابل را به سیستم متصل می‌کند\&. این متد یک ابرمجموعه از
\fBAttachImage()\fR
است با این تفاوت که فهرستی از اکستنشن‌ها را به عنوان پارامتر ورودی اضافه دارد، که روی تصویر اصلی سوار (overlay) می‌شوند\&. هنگامی که از این متد استفاده می‌شود، جدا کردن باید با ارسال همان آرگومان‌ها از طریق متد
\fBDetachImageWithExtensions()\fR
انجام شود\&. برای جزئیات بیشتر در مورد این قابلیت، مدخل
\fIMountImages=\fR
در
\fBsystemd.exec\fR(5)
و
\fBsystemd-sysext\fR(8)
را ببینید\&.
.PP
\fBDetachImage()\fR
یک تصویر پرتابل را از سیستم جدا می‌کند\&. این متد مسیر یا نام یک تصویر و یک مقدار بولی را دریافت می‌کند که مشخص می‌سازد آیا تصویری که باید جدا شود، تنها برای نشست بوت فعلی متصل شده بود یا به صورت دائمی\&. این متد فهرستی از تغییرات اعمال‌شده روی سیستم را بازمی‌گرداند (برای مثال، کدام واحد حذف شده و دیگر به عنوان یک سرویس سیستمی در دسترس نیست)\&. هر تغییر به صورت یک سه‌تایی از رشته‌ها نمایش داده می‌شود: نوع تغییر اعمال‌شده، مسیری که تغییر روی آن اعمال شده، و منبع (در صورت وجود)\&. نوع تغییر اعمال‌شده یکی از مقادیر ممکن زیر خواهد بود:
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
unlink
.RE
.sp
توجه داشته باشید که اگر واحدی که در تصویر وجود دارد در حال اجرا باشد، تصویر نمی‌تواند جدا شود\&. همچنین توجه داشته باشید که این متد تنها پس از تکمیل تمام عملیات‌های ذکرشده بازمی‌گردد، و با توجه به حجم ورودی/خروجی (I/O) درگیر، ممکن است مدتی طول بکشد\&.
.PP
\fBDetachImageWithExtensions()\fR
یک تصویر پرتابل را از سیستم جدا می‌کند\&. این متد یک ابرمجموعه از
\fBDetachImage()\fR
است، با این تفاوت که فهرستی از اکستنشن‌ها را به عنوان پارامتر ورودی اضافه دارد که از طریق
\fBAttachImageWithExtensions()\fR
روی تصویر اصلی سوار شده بودند\&.
.PP
\fBReattachImage()\fR
اثرات متد
\fBAttachImage()\fR
و متد
\fBDetachImage()\fR
را با هم ترکیب می‌کند\&. تفاوت در این است که اتصال مجدد (reattach) یک تصویر در حالی که یک یا چند واحد آن در حال اجرا هستند مجاز است\&. در صورتی که هیچ تصویر منطبقی متصل نشده باشد، عملیات اتصال مجدد با شکست مواجه خواهد شد\&. پارامترهای ورودی با متد
\fBAttachImage()\fR
مطابقت دارند، و پارامترهای بازگشتی ترکیبی از پارامترهای بازگشتی متد
\fBDetachImage()\fR
(آرایه اول، واحدهایی که حذف شدند) و متد
\fBAttachImage()\fR
(آرایه دوم، واحدهایی که به‌روزرسانی یا اضافه شدند) هستند\&.
.PP
\fBReattachImageWithExtensions()\fR
یک تصویر پرتابل را مجدداً به سیستم متصل می‌کند\&. این متد یک ابرمجموعه از
\fBReattachImage()\fR
است، با افزودن فهرستی از اکستنشن‌ها به عنوان پارامتر ورودی که روی تصویر اصلی سوار خواهند شد\&. برای جزئیات بیشتر در مورد این قابلیت، مدخل
\fIMountImages=\fR
در
\fBsystemd.exec\fR(5)
و
\fBsystemd-sysext\fR(8)
را ببینید\&.
.PP
\fBRemoveImage()\fR
تصویر با نام مشخص‌شده را حذف می‌کند\&.
.PP
\fBMarkImageReadOnly()\fR
وضعیت فلگ فقط‌خواندنی یک تصویر را تغییر می‌دهد (روشن/خاموش می‌کند)\&.
.PP
\fBSetPoolLimit()\fR
یک سقف سهمیهٔ کلی (quota limit) برای استخر (pool) تصویرها تعیین می‌کند\&.
.PP
\fBSetImageLimit()\fR
یک سقف سهمیه به ازای هر تصویر تعیین می‌کند\&.
.PP
متدهای
\fBAttachImageWithExtensions()\fR،
\fBDetachImageWithExtensions()\fR
و
\fBReattachImageWithExtensions()\fR
به جای مقادیر بولی، گزینه‌ها را به صورت فلگ دریافت می‌کنند تا امکان گسترش‌پذیری فراهم شود\&.
\fISD_SYSTEMD_PORTABLE_FORCE_ATTACH\fR
بررسی‌های امنیتی مبنی بر عدم اجرای واحدها هنگام متصل یا جدا شدن تصویر را دور می‌زند\&.
\fISD_SYSTEMD_PORTABLE_FORCE_EXTENSION\fR
بررسیِ مطابقت فایل
extension\-release\&.\fINAME\fR
در تصویر اکستنشن با نام تصویر را دور می‌زند\&. آن‌ها به شرح زیر تعریف شده‌اند:
.sp
.if n \{\
.RS 4
.\}
.nf
#define SD_SYSTEMD_PORTABLE_RUNTIME            (UINT64_C(1) << 0)
#define SD_SYSTEMD_PORTABLE_FORCE_ATTACH       (UINT64_C(1) << 1)
#define SD_SYSTEMD_PORTABLE_FORCE_EXTENSION    (UINT64_C(1) << 2)
.fi
.if n \{\
.RE
.\}
.SS "ویژگی‌ها (Properties)"
.PP
\fIPoolPath\fR
مسیر سیستم پرونده را که تصویرها در آن نوشته می‌شوند مشخص می‌کند\&.
.PP
\fIPoolUsage\fR
اندازهٔ استفادهٔ فعلی از استخر تصویرها را به بایت مشخص می‌کند\&.
.PP
\fIPoolLimit\fR
سقف اندازهٔ استخر تصویرها را به بایت مشخص می‌کند\&.
.PP
\fIProfiles\fR
پروفایل‌های زمان اجرای موجود برای سرویس‌های پرتابل را مشخص می‌کند\&.
.SH "شیء IMAGE (THE IMAGE OBJECT)"
.PP
این سرویس رابط‌های زیر را روی شیء Image در گذرگاه ارائه می‌دهد:
.sp
.if n \{\
.RS 4
.\}
.nf
node /org/freedesktop/portable1 {
  interface org\&.freedesktop\&.portable1\&.Image {
    methods:
      GetOSRelease(out a{ss} os_release);
      GetMetadata(in  as matches,
                  out s image,
                  out ay os_release,
                  out a{say} units);
      GetMetadataWithExtensions(in  as extensions,
                                in  as matches,
                                in  t flags,
                                out s image,
                                out ay os_release,
                                out a{say} extensions,
                                out a{say} units);
      GetState(out s state);
      GetStateWithExtensions(in  as extensions,
                             in  t flags,
                             out s state);
      Attach(in  as matches,
             in  s profile,
             in  b runtime,
             in  s copy_mode,
             out a(sss) changes);
      AttachWithExtensions(in  as extensions,
                           in  as matches,
                           in  s profile,
                           in  s copy_mode,
                           in  t flags,
                           out a(sss) changes);
      Detach(in  b runtime,
             out a(sss) changes);
      DetachWithExtensions(in  as extensions,
                           in  t flags,
                           out a(sss) changes);
      Reattach(in  as matches,
               in  s profile,
               in  b runtime,
               in  s copy_mode,
               out a(sss) changes_removed,
               out a(sss) changes_updated);
      ReattachWithExtensions(in  as extensions,
                             in  as matches,
                             in  s profile,
                             in  s copy_mode,
                             in  t flags,
                             out a(sss) changes_removed,
                             out a(sss) changes_updated);
      Remove();
      MarkReadOnly(in  b read_only);
      SetLimit(in  t limit);
    properties:
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly s Name = \*(Aq\&.\&.\&.\*(Aq;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly s Path = \*(Aq\&.\&.\&.\*(Aq;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly s Type = \*(Aq\&.\&.\&.\*(Aq;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly b ReadOnly = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly t CreationTimestamp = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly t ModificationTimestamp = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly t Usage = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly t Limit = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly t UsageExclusive = \&.\&.\&.;
      @org\&.freedesktop\&.DBus\&.Property\&.EmitsChangedSignal("false")
      readonly t LimitExclusive = \&.\&.\&.;
  };
  interface org\&.freedesktop\&.DBus\&.Peer { \&.\&.\&. };
  interface org\&.freedesktop\&.DBus\&.Introspectable { \&.\&.\&. };
  interface org\&.freedesktop\&.DBus\&.Properties { \&.\&.\&. };
};
.fi
.if n \{\
.RE
.\}
.SS "متدها (Methods)"
.PP
متدهای زیر همان عملیات متناظر با متدهای روی شیء
Manager
را پیاده‌سازی می‌کنند (بالا را ببینید)\&. با این حال، این متدها روی شیء تصویر عمل می‌کنند و بنابراین پارامتر نام تصویر را دریافت نمی‌کنند\&. فراخوانی مستقیم متدها روی شیء Manager این مزیت را دارد که نیازی به فراخوانی
\fBGetImage()\fR
برای دریافت شیء تصویر مربوط به یک نام تصویر خاص نیست\&. بنابراین فراخوانی متدها روی شیء Manager یک بهینه‌سازی در رفت‌وبرگشت (round trip) به شمار می‌آید\&. فهرست متدها:
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
GetOSRelease()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
GetMetadata()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
GetMetadataWithExtensions()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
GetState()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
Attach()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
AttachWithExtensions()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
Detach()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
DetachWithExtensions()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
Reattach()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
ReattachWithExtensions()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
Remove()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
MarkReadOnly()
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
SetLimit()
.RE
.SS "ویژگی‌ها (Properties)"
.PP
\fIName\fR
نام تصویر را مشخص می‌کند\&.
.PP
\fIPath\fR
مسیر سیستم پرونده را که تصویر در آن ذخیره شده است مشخص می‌کند\&.
.PP
\fIType\fR
نوع تصویر را مشخص می‌کند\&.
.PP
\fIReadOnly\fR
مشخص می‌کند که آیا تصویر فقط‌خواندنی است یا خیر\&.
.PP
\fICreationTimestamp\fR
برچسب زمان ایجاد تصویر را مشخص می‌کند\&.
.PP
\fIModificationTimestamp\fR
برچسب زمان تغییر تصویر را مشخص می‌کند\&.
.PP
\fIUsage\fR
میزان مصرف دیسک توسط تصویر را مشخص می‌کند\&.
.PP
\fILimit\fR
سقف مصرف دیسک توسط تصویر را مشخص می‌کند\&.
.PP
\fIUsageExclusive\fR
میزان مصرف اختصاصی دیسک توسط تصویر را مشخص می‌کند\&.
.PP
\fILimitExclusive\fR
سقف مصرف اختصاصی دیسک توسط تصویر را مشخص می‌کند\&.
.SH "سازگاری نسخه (VERSION COMPATIBILITY)"
.PP
این رابط‌های D\-Bus از
\m[blue]\fBدستورالعمل‌های معمول نسخه‌بندی رابط\fR\m[]\&\s-2\u[1]\d\s+2
پیروی می‌کنند\&.
.SH "تاریخچه (HISTORY)"
.SS "شیء Manager"
.PP
\fBGetImageStateWithExtensions()\fR
در نسخه ۲۵۱ اضافه شد\&.
.SS "شیء Image"
.PP
\fBGetStateWithExtensions()\fR
در نسخه ۲۵۱ اضافه شد\&.
.PP
\fBReattachWithExtensions()\fR
در نسخه ۲۵۴ اضافه شد\&.
.SH "همچنین ببینید (SEE ALSO)"
.PP
\fBsystemd\fR(1), \fBsystemd-portabled.service\fR(8), \fBportablectl\fR(1)
.SH "نکات (NOTES)"
.IP " 1." 4
دستورالعمل‌های معمول نسخه‌بندی رابط
.RS 4
