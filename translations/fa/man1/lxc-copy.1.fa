{-n, --name \fIname\fR} [-P, --lxcpath \fIpath\fR] {-N, --newname \fInewname\fR} [-p, --newpath \fInewpath\fR] [-B, --backingstorage \fIbackingstorage\fR] [-s, --snapshot] [-a, --allowrunning] [-K, --keepname] [-D, --keepdata] [-M, --keepmac] [-L, --fssize \fIsize [unit]\fR] [-- hook arguments]
'in \n(.iu-\nxu
