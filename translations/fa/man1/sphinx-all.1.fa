.B class sphinx.addnodes.production(rawsource: str \%<https://\:docs\:.python\:.org/\:3/\:library/\:stdtypes\:.html#\:str> = \(aq\(aq, text: str \%<https://\:docs\:.python\:.org/\:3/\:library/\:stdtypes\:.html#\:str> = \(aq\(aq, *children, **attributes: Any)
