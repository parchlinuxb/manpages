.TH ROUTE 8 "2014\-02\-17" "net\-tools" "راهنمای مدیر سیستم لینوکس"
.SH "نام (NAME)"
route \- نمایش و دستکاری جدول مسیریابی IP در هسته لینوکس
.SH "خلاصه دستور (SYNOPSIS)"
.B route
.RB [ \-CFvnNee ]
.RB [ \-A
.IR family
.RB | \-4 | \-6 ]
.TP
.B route
.RB [ \-v ]
.RB [ \-A
.IR family
.RB | \-4 | \-6 ]
.B add
.RB [ \-net | \-host ]
.I target
.RB [ netmask
.IR Nm ]
.RB [ gw
.IR Gw ]
.RB [ metric
.IR N ]
.RB [ mss
.IR M ]
.RB [ window
.IR W ]
.RB [ irtt
.IR I ]
.RB [ reject ]
.RB [ mod ]
.RB [ dyn ]
.RB [ reinstate ]
.RB [[ dev ]
.IR If ]
.TP
.B route
.RB [ \-v ]
.RB [ \-A
.IR family
.RB | \-4 | \-6 ]
.B del
.RB [ \-net | \-host ]
.I target
.RB [ gw
.IR Gw ]
.RB [ netmask
.IR Nm ]
