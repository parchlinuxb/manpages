\fBonly_generic.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
def divide_x_by_y(x: float, y: float):
    try:
        print(x / y)
    except ArithmeticError as e:
        print(
            f\(dqThere was an OverflowError, a ZeroDivisionError or a FloatingPointError: {e}\(dq
        )

.EE
