.TH "dcm2img" 1 "Thu Jul 9 2026 18:43:40" "Version 3.7.0" "OFFIS DCMTK" \" -*- nroff -*-
.nh
.SH "نام (NAME)"
dcm2img \- تبدیل تصاویر DICOM به قالب‌های استاندارد تصویر
.PP

.SH "خلاصه دستور (SYNOPSIS)"
.PP
.PP
.nf
dcm2img [گزینه‌ها] dcmfile-in [bitmap-out]
.fi
.PP
.SH "توضیحات (DESCRIPTION)"
.PP
ابزار \fBdcm2img\fP یک تصویر دایکام (DICOM) را می‌خواند، داده‌های پیکسلی را مطابق با گزینه‌های پردازش تصویر انتخاب‌شده تبدیل می‌کند و تصویری را در یکی از قالب‌های عمومی تصویر زیر می‌نویسد: BMP، PGM/PPM، PNG، TIFF، JPEG یا JPEG-LS\&. این ابزار هم از تصاویر دایکام غیرفشرده و هم از تصاویر فشرده‌شده با JPEG، JPEG-LS و RLE پشتیبانی می‌کند\&.
.SH "پارامترها (PARAMETERS)"
.PP
.PP
.nf
dcmfile-in  نام فایل ورودی DICOM جهت تبدیل ("-" برای ورودی استاندارد stdin)

bitmap-out  نام فایل خروجی برای نوشتن (پیش‌فرض: خروجی استاندارد stdout)
.fi
.PP
.SH "گزینه‌ها (OPTIONS)"
.PP
.SS "گزینه‌های عمومی (general options)"
.PP
.nf
  -h    --help
          چاپ این متن راهنما و خروج

        --version
          چاپ اطلاعات نسخه و خروج

        --arguments
          چاپ آرگومان‌های بسط‌یافته خط فرمان

  -q    --quiet
          حالت خاموش، عدم چاپ هشدارها و خطاها

  -v    --verbose
          حالت پرگویی، چاپ جزئیات پردازش

  -d    --debug
          حالت اشکال‌زدایی، چاپ اطلاعات دیباگ

  -ll   --log-level  [l]evel: string constant
          (fatal, error, warn, info, debug, trace)
          استفاده از سطح l برای ثبت‌کننده لاگ

  -lc   --log-config  [f]ilename: string
          استفاده از فایل پیکربندی f برای لاگر
.fi
.PP
.SS "گزینه‌های ورودی (input options)"
.PP
.nf
قالب فایل ورودی:

  +f    --read-file
          خواندن قالب فایل یا مجموعه داده (پیش‌فرض)

  +fo   --read-file-only
          فقط خواندن قالب فایل

  -f    --read-dataset
          خواندن مجموعه داده بدون اطلاعات متای فایل

سینتکس انتقال ورودی:

  -t=   --read-xfer-auto
          استفاده از تشخیص خودکار TS (پیش‌فرض)

  -td   --read-xfer-detect
          نادیده گرفتن TS مشخص‌شده در متاسرآیند فایل

  -te   --read-xfer-little
          خواندن با TS صریح VR و ترتیب بایت little endian

  -tb   --read-xfer-big
          خواندن با TS صریح VR و ترتیب بایت big endian

  -ti   --read-xfer-implicit
          خواندن با TS ضمنی VR و ترتیب بایت little endian
.fi
.PP
.SS "گزینه‌های پردازش تصویر (image processing options)"
.PP
.nf
انتخاب فریم:

  +F    --frame  [n]umber: integer
          انتخاب فریم مشخص‌شده (پیش‌فرض: 1)

  +Fr   --frame-range  [n]umber [c]ount: integer
          انتخاب c فریم با شروع از فریم n

  +Fa   --all-frames
          انتخاب همه فریم‌ها

چرخش:

  +Rl   --rotate-left
          چرخش تصویر به چپ (۹۰- درجه)

  +Rr   --rotate-right
          چرخش تصویر به راست (۹۰+ درجه)

  +Rtd  --rotate-top-down
          چرخش تصویر از بالا به پایین (۱۸۰ درجه)

وارونه‌سازی (قرینه‌سازی):

  +Lh   --flip-horizontally
          قرینه‌سازی افقی تصویر

  +Lv   --flip-vertically
          قرینه‌سازی عمودی تصویر

  +Lhv  --flip-both-axes
          قرینه‌سازی تصویر در هر دو محور افقی و عمودی

مقیاس‌بندی:

  +a    --recognize-aspect
          تشخیص نسبت ابعاد پیکسل هنگام مقیاس‌بندی (پیش‌فرض)

  -a    --ignore-aspect
          نادیده گرفتن نسبت ابعاد پیکسل هنگام مقیاس‌بندی

  +i    --interpolate  [n]umber of algorithm: integer
          استفاده از درون‌یابی هنگام مقیاس‌بندی (1\&.\&.4، پیش‌فرض: 1)

  -i    --no-interpolation
          عدم استفاده از درون‌یابی هنگام مقیاس‌بندی

  -S    --no-scaling
          عدم مقیاس‌بندی، نادیده گرفتن نسبت ابعاد پیکسل (پیش‌فرض)

  +Sxf  --scale-x-factor  [f]actor: float
          مقیاس‌بندی محور x با ضریب f، محاسبه خودکار محور y

  +Syf  --scale-y-factor  [f]actor: float
          مقیاس‌بندی محور y با ضریب f، محاسبه خودکار محور x

  +Sxv  --scale-x-size  [n]umber: integer
          مقیاس‌بندی محور x به n پیکسل، محاسبه خودکار محور y

  +Syv  --scale-y-size  [n]umber: integer
          مقیاس‌بندی محور y به n پیکسل، محاسبه خودکار محور x

تبدیل فضای رنگی (فقط برای تصاویر فشرده‌شده با JPEG):

  +cp   --conv-photometric
          تبدیل در صورت تفسیر نورسنجی YCbCr (پیش‌فرض)

  +cl   --conv-lossy
          تبدیل YCbCr به RGB در صورت JPEG با اتلاف (lossy)

  +cg   --conv-guess
          تبدیل به RGB در صورت حدس‌زدن YCbCr توسط کتابخانه

  +cgl  --conv-guess-lossy
          تبدیل به RGB در صورت JPEG با اتلاف و حدس‌زدن
          YCbCr توسط کتابخانه زیربنایی JPEG

  +ca   --conv-always
          همیشه YCbCr به RGB تبدیل شود

  +cn   --conv-never
          هرگز فضای رنگی تبدیل نشود

بیت‌های ذخیره‌شده:

  +bs  --bits-stored-fix
         اصلاح مقدار ناسازگار بیت‌های ذخیره‌شده (BitsStored) (پیش‌فرض)

  # اگر مقدار BitsStored در جریان بیتی فشرده‌شده کوچکتر از مقدار
  # موجود در مجموعه داده DICOM باشد، مقدار در مجموعه داده به‌روزرسانی می‌شود
  # (فقط برای تصاویر فشرده‌شده با JPEG)

  -bs  --bits-stored-keep
         حفظ مقدار ناسازگار بیت‌های ذخیره‌شده (BitsStored)

  # حفظ مقدار BitsStored حتی در صورت ناسازگاری با جریان بیتی
  # فشرده‌شده\&. این ممکن است به رمزگشایی صحیح برخی از تصاویر
  # معیوب کمک کند (فقط برای تصاویر فشرده‌شده با JPEG)

گزینه‌های دورزدن خطا برای کدگذاری‌های نادرست (فقط تصاویر فشرده‌شده با JPEG):

  +w6   --workaround-pred6
          فعال‌سازی راهکار دورزدن خطا برای تصاویر بدون افت JPEG
          دارای سرریز در پیش‌بینی‌کننده ۶

  # تصاویر DICOM با ۱۶ بیت بر پیکسل در دنیای واقعی مشاهده شده‌اند
  # که با JPEG بدون افت فشرده شده‌اند و نیاز به رسیدگی ویژه دارند
  # زیرا رمزگذار دچار سرریز عدد صحیح ۱۶ بیتی در پیش‌بینی‌کننده ۶
  # شده است، که باید هنگام خروج از فشردگی جبران (بازسازی) شود\&.
  # این گزینه رمزگشایی صحیح چنین تصاویر معیوبی را ممکن می‌سازد،
  # اما در عین حال باعث رمزگشایی نادرست تصاویر با فشرده‌سازی صحیح
  # خواهد شد\&. با احتیاط استفاده شود\&.

  +wi   --workaround-incpl
          فعال‌سازی راهکار دورزدن خطا برای داده‌های ناقص JPEG

  # این گزینه باعث می‌شود dcm2img داده‌های ناقص JPEG در انتهای یک
  # قطعه فشرده‌شده را نادیده بگیرد و خروج از فشردگی فریم بعدی را
  # از قطعه بعدی (در صورت وجود) آغاز کند\&. این قابلیت امکان رمزگشایی
  # تصاویری با داده‌های ناقص JPEG را فراهم می‌سازد\&.

  +wc   --workaround-cornell
          فعال‌سازی راهکار ترمیمی برای تصاویر ۱۶ بیتی بدون افت JPEG
          کورنل (Cornell) با سرریز جدول هافمن

  # یکی از نخستین پیاده‌سازی‌های متن‌باز فشرده‌سازی JPEG بدون افت،
  # کتابخانه "Cornell"، دارای باگی شناخته‌شده است که هنگام فشرده‌سازی
  # تصاویر با ۱۶ بیت در هر نمونه به مقادیر نامعتبر در جدول هافمن
  # می‌انجامد\&. این گزینه راهکاری ترمیمی را فعال می‌کند که رمزگشایی
  # صحیح چنین تصاویری را ممکن می‌سازد\&.

تبدیل modality LUT:

  -M    --no-modality
          نادیده گرفتن تبدیل modality LUT ذخیره‌شده

  +M    --use-modality
          استفاده از تبدیل modality LUT (پیش‌فرض)

تبدیل VOI LUT:

  -W    --no-windowing
          عدم اعمال پنجره‌بندی VOI (پیش‌فرض)

  +Wi   --use-window  [n]umber: integer
          استفاده از n-امین پنجره VOI از فایل تصویر

  +Wl   --use-voi-lut  [n]umber: integer
          استفاده از n-امین جدول تبدیل VOI (VOI LUT) از فایل تصویر

  +Wm   --min-max-window
          محاسبه پنجره VOI با استفاده از الگوریتم min-max

  +Wn   --min-max-window-n
          محاسبه پنجره VOI با استفاده از الگوریتم min-max،
          با نادیده گرفتن مقادیر فرین (اکستریم)

  +Wr   --roi-min-max-window  [l]eft [t]op [w]idth [h]eight: integer
          محاسبه پنجره ROI با استفاده از الگوریتم min-max،
          ناحیه مورد نظر توسط l,t,w,h مشخص می‌شود

  +Wh   --histogram-window  [n]umber: integer
          محاسبه پنجره VOI با استفاده از الگوریتم هیستوگرام،
          با نادیده گرفتن n درصد

  +Ww   --set-window  [c]enter [w]idth: float
          محاسبه پنجره VOI با استفاده از مرکز c و پهنای w

  +Wfl  --linear-function
          تنظیم تابع VOI LUT روی LINEAR (خطی)

  +Wfs  --sigmoid-function
          تنظیم تابع VOI LUT روی SIGMOID (سیگموئید)

تبدیل presentation LUT:

  +Pid  --identity-shape
          تنظیم شکل presentation LUT روی IDENTITY

  +Piv  --inverse-shape
          تنظیم شکل presentation LUT روی INVERSE

  +Pod  --lin-od-shape
          تنظیم شکل presentation LUT روی LIN OD

اورلی (لایه‌های روکش):

  -O    --no-overlays
          عدم نمایش لایه‌های روکش (اورلی‌ها)

  +O    --display-overlay  [n]umber: integer
          نمایش لایه روکش n (از 0\&.\&.16، مقدار 0=همه، پیش‌فرض: +O 0)

  +Omr  --ovl-replace
          استفاده از حالت روکش "Replace" (جایگزینی)
          (پیش‌فرض برای روکش‌های گرافیکی)

  +Omt  --ovl-threshold
          استفاده از حالت روکش "Threshold Replace" (جایگزینی با آستانه)

  +Omc  --ovl-complement
          استفاده از حالت روکش "Complement" (متمم)

  +Omv  --ovl-invert
          استفاده از حالت روکش "Invert Bitmap" (معکوس‌سازی بیت‌مپ)

  +Omi  --ovl-roi
          استفاده از حالت روکش "Region of Interest" (ناحیه مورد نظر)
          (پیش‌فرض برای روکش‌های ROI)

  +Osf  --set-foreground  [d]ensity: float
          تنظیم چگالی پیش‌زمینه روکش (0\&.\&.1، پیش‌فرض: 1)

  +Ost  --set-threshold  [d]ensity: float
          تنظیم چگالی آستانه روکش (0\&.\&.1، پیش‌فرض: 0\&.5)

تبدیل display LUT:

  +Dm   --monitor-file  [f]ilename: string
          کالیبره‌سازی خروجی مطابق با ویژگی‌های مانیتور
          تعریف‌شده در فایل f

  +Dp   --printer-file  [f]ilename: string
          کالیبره‌سازی خروجی مطابق با ویژگی‌های چاپگر
          تعریف‌شده در فایل f

  +Da   --ambient-light  [a]mbient light: float
          مقدار نور محیط (cd/m^2، پیش‌فرض: فایل f)

  +Di   --illumination  [i]llumination: float
          مقدار روشنایی (cd/m^2، پیش‌فرض: فایل f)

  +Dn   --min-density  [m]inimum optical density: float
          مقدار Dmin (پیش‌فرض: غیرفعال، فقط با +Dp)

  +Dx   --max-density  [m]aximum optical density: float
          مقدار Dmax (پیش‌فرض: غیرفعال، فقط با +Dp)

  +Dg   --gsd-function
          استفاده از GSDF برای کالیبراسیون (پیش‌فرض برای +Dm/+Dp)

  +Dc   --cielab-function
          استفاده از تابع CIELAB برای کالیبراسیون

سازگاری:

  +Ma   --accept-acr-nema
          پذیرش تصاویر ACR-NEMA بدون تفسیر نورسنجی

  +Mp   --accept-palettes
          پذیرش تگ‌های ویژگی پالت نادرست
          (0028,111x) و (0028,121x)

  +Mc   --check-lut-depth
          بررسی مقدار سوم توصیف‌گر LUT، مقایسه با
          عمق بیت مورد انتظار بر اساس داده‌های LUT

  +Mm   --ignore-mlut-depth
          نادیده گرفتن مقدار سوم توصیف‌گر modality LUT،
          تعیین خودکار بیت به ازای هر مدخل جدول

  +Mv   --ignore-vlut-depth
          نادیده گرفتن مقدار سوم توصیف‌گر VOI LUT،
          تعیین خودکار بیت به ازای هر مدخل جدول

قالب TIFF:

  +Tl   --compr-lzw
          فشرده‌سازی LZW (پیش‌فرض)

  +Tr   --compr-rle
          فشرده‌سازی RLE

  +Tn   --compr-none
          بدون فشرده‌سازی

  +Pd   --predictor-default
          بدون پیش‌بینی‌کننده LZW (پیش‌فرض)

  +Pn   --predictor-none
          پیش‌بینی‌کننده LZW شماره ۱ (بدون پیش‌بینی)

  +Ph   --predictor-horz
          پیش‌بینی‌کننده LZW شماره ۲ (تفاضل افقی)

  +Rs   --rows-per-strip  [r]ows: integer (default: 0)
          تعداد سطر در هر نوار (strip)، پیش‌فرض 8K در هر نوار

قالب PNG:

  +il   --interlace
          ایجاد فایل درهم‌بافته / اینترلیس (پیش‌فرض)

  -il   --nointerlace
          ایجاد فایل غیر درهم‌بافته

  +mf   --meta-file
          ایجاد اطلاعات متای فایل PNG (پیش‌فرض)

  -mf   --meta-none
          عدم ایجاد اطلاعات متای فایل PNG

قالب JPEG:

  +Jq   --compr-quality  [q]uality: integer (0\&.\&.100, default: 90)
          مقدار کیفیت برای فشرده‌سازی (به درصد)

  +Js4  --sample-444
          نمونه‌برداری 4:4:4 (بدون زیرنمونه‌برداری)

  +Js2  --sample-422
          زیرنمونه‌برداری 4:2:2 (زیرنمونه‌برداری افقی
          مؤلفه‌های رنگی کروما، پیش‌فرض)

  +Js1  --sample-411
          زیرنمونه‌برداری 4:1:1 (زیرنمونه‌برداری افقی و عمودی
          مؤلفه‌های رنگی کروما)

قالب JPEG-LS:

  +Trl  --rendered-lossless
          فشرده‌سازی بدون افت تصویر رندرشده (پیش‌فرض)

  +Tll  --true-lossless
          فشرده‌سازی بدون افت تصویر خام

  +f8   --force-8-bit
          اجبار عمق بیت خروجی به ۸ بیت
          (همراه با --true-lossless قابل استفاده نیست)

سایر تبدیلات:

  +G    --grayscale
          تبدیل تصویر رنگی به مقیاس خاکستری (تک‌رنگ)

  +P    --change-polarity
          تغییر قطبیت (معکوس کردن خروجی پیکسل‌ها)

  +C    --clip-region  [l]eft [t]op [w]idth [h]eight: integer
          برش ناحیه‌ای از تصویر (l, t, w, h)
.fi
.PP
.SS "گزینه‌های خروجی (output options)"
.PP
.nf
عمومی:

  -im   --image-info
          چاپ جزئیات تصویر (نیاز به حالت پرگویی دارد)

  -o    --no-output
          عدم ایجاد هیچ‌گونه خروجی (مفید همراه با -im)

تولید نام فایل (فقط با --frame-range یا --all-frames):

  +Fc   --use-frame-counter
          استفاده از شمارنده مبتنی بر صفر برای نام فایل‌ها (پیش‌فرض)

  +Fn   --use-frame-number
          استفاده از شماره مطلق فریم برای نام فایل‌ها

قالب تصویر:

  +oa   --write-auto
          تعیین قالب فایل از روی پسوند نام فایل
          (پیش‌فرض برای فایل‌ها)

  # اگر نام فایل خروجی فاقد پسوند یا حاوی پسوندی ناشناخته/پشتیبانی‌نشده
  # باشد، یک هشدار چاپ شده و یک فایل BMP نوشته می‌شود (نگاه کنید به --write-bmp)\&.

  +op   --write-raw-pnm
          نوشتن PGM/PPM باینری ۸ بیتی

  +opb  --write-8-bit-pnm
          نوشتن PGM/PPM اسکی (ASCII) ۸ بیتی (پیش‌فرض برای stdout)

  +opw  --write-16-bit-pnm
          نوشتن PGM/PPM اسکی (ASCII) ۱۶ بیتی

  +opn  --write-n-bit-pnm  [n]umber: integer
          نوشتن PGM/PPM اسکی (ASCII) n بیتی (1\&.\&.32)

  +ob   --write-bmp
          نوشتن BMP ۸ بیتی (تک‌رنگ) یا ۲۴ بیتی (رنگی)

  +obp  --write-8-bit-bmp
          نوشتن BMP پالتی ۸ بیتی (فقط تک‌رنگ)

  +obt  --write-24-bit-bmp
          نوشتن BMP رنگ واقعی ۲۴ بیتی (truecolor)

  +obr  --write-32-bit-bmp
          نوشتن BMP رنگ واقعی ۳۲ بیتی (truecolor)

  +ot   --write-tiff
          نوشتن TIFF ۸ بیتی (تک‌رنگ) یا ۲۴ بیتی (رنگی)

  +on   --write-png
          نوشتن PNG ۸ بیتی (تک‌رنگ) یا ۲۴ بیتی (رنگی)

  +on2  --write-16-bit-png
          نوشتن PNG ۱۶ بیتی (تک‌رنگ) یا ۴۸ بیتی (رنگی)

  +oj   --write-jpeg
          نوشتن JPEG با اتلاف ۸ بیتی (baseline)

  +ol   --write-jpls
          نوشتن JPEG-LS
.fi
.PP
.SH "نکات (NOTES)"
.PP
الگوریتم‌های درون‌یابی ترجیحی زیر را می‌توان با استفاده از گزینه \fI--interpolate\fP انتخاب کرد:

.PP
.IP "\(bu" 2
1 = الگوریتم مقیاس‌بندی آزاد همراه با درون‌یابی از جعبه‌ابزار pbmplus
.IP "\(bu" 2
2 = الگوریتم مقیاس‌بندی آزاد همراه با درون‌یابی از مجله c't
.IP "\(bu" 2
3 = الگوریتم بزرگ‌نمایی با درون‌یابی دولخطی (bilinear) از Eduard Stanescu
.IP "\(bu" 2
4 = الگوریتم بزرگ‌نمایی با درون‌یابی دومکعبی (bicubic) از Eduard Stanescu
.PP

.PP
گزینه \fI--write-tiff\fP تنها زمانی در دسترس است که DCMTK با پشتیبانی از کتابخانه خارجی TIFF یعنی \fBlibtiff\fP پیکربندی و کامپایل شده باشد\&. در دسترس بودن گزینه‌های فشرده‌سازی TIFF به پیکربندی \fBlibtiff\fP بستگی دارد\&.

.PP
گزینه \fI--write-png\fP تنها زمانی در دسترس است که DCMTK با پشتیبانی از کتابخانه خارجی PNG یعنی \fBlibpng\fP پیکربندی و کامپایل شده باشد\&. گزینه \fI--interlace\fP بارگذاری تدریجی تصویر هنگام خواندن فایل PNG را فعال می‌کند\&. تنها شمار اندکی از برنامه‌ها به اطلاعات متا (TEXT) در فایل PNG توجه می‌کنند\&.
.SH "سینتکس‌های انتقال (TRANSFER SYNTAXES)"
.PP
ابزار \fBdcm2img\fP از سینتکس‌های انتقال زیر برای ورودی (\fIdcmfile-in\fP) پشتیبانی می‌کند:

.PP
.PP
.nf
LittleEndianImplicitTransferSyntax             1\&.2\&.840\&.10008\&.1\&.2
LittleEndianExplicitTransferSyntax             1\&.2\&.840\&.10008\&.1\&.2\&.1
DeflatedExplicitVRLittleEndianTransferSyntax   1\&.2\&.840\&.10008\&.1\&.2\&.1\&.99 (*)
BigEndianExplicitTransferSyntax                1\&.2\&.840\&.10008\&.1\&.2\&.2
JPEGLSLosslessTransferSyntax                   1\&.2\&.840\&.10008\&.1\&.2\&.4\&.80
JPEGLSLossyTransferSyntax                      1\&.2\&.840\&.10008\&.1\&.2\&.4\&.81
JPEGProcess10_12TransferSyntax                 1\&.2\&.840\&.10008\&.1\&.2\&.4\&.55
JPEGProcess14SV1TransferSyntax                 1\&.2\&.840\&.10008\&.1\&.2\&.4\&.70
JPEGProcess14TransferSyntax                    1\&.2\&.840\&.10008\&.1\&.2\&.4\&.57
JPEGProcess1TransferSyntax                     1\&.2\&.840\&.10008\&.1\&.2\&.4\&.50
JPEGProcess2_4TransferSyntax                   1\&.2\&.840\&.10008\&.1\&.2\&.4\&.51
JPEGProcess6_8TransferSyntax                   1\&.2\&.840\&.10008\&.1\&.2\&.4\&.53
RLELosslessTransferSyntax                      1\&.2\&.840\&.10008\&.1\&.2\&.5
.fi
.PP

.PP
(*) در صورت فعال بودن پشتیبانی zlib در زمان کامپایل
.SH "ثبت گزارش (LOGGING)"
.PP
سطح خروجی گزارش‌گیری ابزارهای مختلف خط فرمان و کتابخانه‌های زیربنایی می‌تواند توسط کاربر مشخص شود\&. به‌طور پیش‌فرض، فقط خطاها و هشدارها در جریان خطای استاندارد نوشته می‌شوند\&. با استفاده از گزینه \fI--verbose\fP پیام‌های اطلاع‌رسانی مانند جزئیات پردازش نیز گزارش می‌شوند\&. گزینه \fI--debug\fP را می‌توان برای دریافت جزئیات بیشتر در مورد فعالیت‌های داخلی، برای نمونه جهت اهداف اشکال‌زدایی، به کار برد\&. سایر سطوح لاگ را می‌توان با استفاده از گزینه \fI--log-level\fP انتخاب کرد\&. در حالت \fI--quiet\fP فقط خطاهای مهلک گزارش می‌شوند\&. در چنین رخدادهای خطای شدیدی، برنامه معمولاً خاتمه می‌یابد\&. برای جزئیات بیشتر درباره سطوح مختلف لاگ، به مستندات ماژول "oflog" مراجعه کنید\&.

.PP
در صورتی که خروجی گزارش‌ها باید درون فایل نوشته شود (اختیاراً همراه با چرخش فایل لاگ)، در syslog (یونیکس) یا event log (ویندوز)، می‌توان از گزینه \fI--log-config\fP استفاده کرد\&. این فایل پیکربندی همچنین امکان هدایت پیام‌های خاص به یک جریان خروجی معین و فیلتر کردن پیام‌ها بر اساس ماژول یا برنامه‌ای که در آن تولید شده‌اند را فراهم می‌کند\&. یک فایل پیکربندی نمونه در \fI<etcdir>/logger\&.cfg\fP ارائه شده است\&.
.SH "خط فرمان (COMMAND LINE)"
.PP
تمامی ابزارهای خط فرمان از نشانه‌گذاری زیر برای پارامترها استفاده می‌کنند: کروشه‌ها مقادیر اختیاری را در بر می‌گیرند (۰-۱)، سه نقطه انتهایی نشان می‌دهد که مقادیر متعدد مجاز است (۱-n)، و ترکیب هر دو به معنای ۰ تا n مقدار است\&.

.PP
گزینه‌های خط فرمان با یک علامت پیشوند '+' یا '-' از پارامترها متمایز می‌شوند\&. معمولاً ترتیب و موقعیت گزینه‌های خط فرمان اختیاری است (یعنی می‌توانند در هر جایی ظاهر شوند)\&. با این حال، اگر گزینه‌ها مانعة‌الجمع باشند، راست‌ترین گزینه لحاظ می‌شود\&. این رفتار با قواعد ارزیابی استاندارد شل‌های معمول یونیکس مطابقت دارد\&.

.PP
علاوه بر این، می‌توان یک یا چند فایل دستور را با استفاده از علامت '@' به عنوان پیشوند نام فایل مشخص کرد (مانند \fI@command\&.txt\fP)\&. چنین آرگومانی پیش از هرگونه ارزیابی بیشتر با محتوای فایل متنی مربوطه جایگزین می‌شود (چندین فاصله متوالی به عنوان یک جداکننده منفرد در نظر گرفته می‌شوند مگر اینکه میان دو علامت نقل‌قول قرار گرفته باشند)\&. لطفاً توجه داشته باشید که یک فایل دستور نمی‌تواند شامل فایل دستور دیگری باشد\&. این رویکرد ساده اما موثر به کاربر اجازه می‌دهد تا ترکیب‌های رایج گزینه‌ها/پارامترها را خلاصه کرده و از خط فرمان‌های طولانی و گیج‌کننده جلوگیری نماید (یک نمونه در فایل \fI<datadir>/dumppat\&.txt\fP ارائه شده است)\&.
.SH "محیط (ENVIRONMENT)"
.PP
ابزار \fBdcm2img\fP تلاش می‌کند واژه‌نامه‌های داده‌های DICOM مشخص‌شده در متغیر محیطی \fIDCMDICTPATH\fP را بارگذاری کند\&. به‌طور پیش‌فرض، یعنی اگر متغیر محیطی \fIDCMDICTPATH\fP تنظیم نشده باشد، فایل \fI<datadir>/dicom\&.dic\fP بارگذاری می‌شود مگر اینکه دیکشنری درون برنامه تعبیه شده باشد (پیش‌فرض در ویندوز)\&.

.PP
رفتار پیش‌فرض باید ترجیح داده شود و متغیر محیطی \fIDCMDICTPATH\fP تنها زمانی استفاده شود که واژه‌نامه‌های داده‌ای جایگزین مورد نیاز باشند\&. متغیر محیطی \fIDCMDICTPATH\fP دارای قالبی مشابه متغیر \fIPATH\fP در شل یونیکس است که در آن علامت دونقطه (":") ورودی‌ها را جدا می‌کند\&. در سیستم‌های ویندوز، از یک نقطه-ویرگول (";") به عنوان جداکننده استفاده می‌شود\&. کد دیکشنری داده‌ها تلاش خواهد کرد هر فایل مشخص‌شده در متغیر محیطی \fIDCMDICTPATH\fP را بارگذاری کند\&. بارگذاری نشدن هیچ دیکشنری داده‌ای یک خطا به شمار می‌رود\&.
.SH "فایل‌ها (FILES)"
.PP
\fI<datadir>/camera\&.lut\fP - فایل نمونه ویژگی‌های یک دوربین
.br
\fI<datadir>/monitor\&.lut\fP - فایل نمونه ویژگی‌های یک مانیتور
.br
\fI<datadir>/printer\&.lut\fP - فایل نمونه ویژگی‌های یک چاپگر
.br
\fI<datadir>/scanner\&.lut\fP - فایل نمونه ویژگی‌های یک اسکنر
