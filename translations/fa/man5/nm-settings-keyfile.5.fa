.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
nm-settings-keyfile \- توضیحات افزونه تنظیمات \fIkeyfile\fR
.SH "توضیحات (DESCRIPTION)"
.PP
برنامه NetworkManager بر پایه‌ی مفهوم پروفایل‌های اتصال عمل می‌کند که حاوی پیکربندی شبکه هستند (برای جزئیات به
\fBnm-settings-nmcli\fR(5)
مراجعه کنید)\&. این پروفایل‌ها می‌توانند در قالب‌های مختلفی ذخیره شوند\&. NetworkManager از افزونه‌ها برای خواندن و نوشتن داده‌ها استفاده می‌کند\&. افزونه‌ها را می‌توان در
\fBNetworkManager.conf\fR(5)
پیکربندی کرد\&.
.PP
افزونه‌ی
\fIkeyfile\fR
یک افزونه‌ی همه‌منظوره است که از تمام انواع اتصال و قابلیت‌های موجود در NetworkManager پشتیبانی می‌کند\&. این فایل‌ها دارای قالبی به سبک \&.ini هستند و در مسیرهای
/etc/NetworkManager/system\-connections/،
/usr/lib/NetworkManager/system\-connections/
و
/run/NetworkManager/system\-connections/
قرار دارند\&. این افزونه همواره فعال است و به‌طور خودکار برای ذخیره هر اتصالی که توسط سایر افزونه‌های فعال پشتیبانی نمی‌شود استفاده خواهد شد\&. به دلایل امنیتی، این افزونه فایل‌هایی را که توسط هر کاربری غیر از \*(Aqroot\*(Aq قابل خواندن یا نوشتن باشند نادیده می‌گیرد، زیرا ممکن است کلیدهای خصوصی و گذرواژه‌ها به‌صورت متن آشکار درون فایل ذخیره شده باشند\&.
.SH "قالب فایل (FILE FORMAT)"
.PP
قالب پیکربندی
\fIkeyfile\fR
یک قالب ساده به سبک \&.ini است\&. این ساختار از بخش‌ها (گروه‌ها)یی از جفت‌های کلید-مقدار تشکیل شده است\&. اطلاعات بیشتر درباره قالب عمومی keyfile را می‌توانید در
\m[blue]\fBقالب key file در GLib\fR\m[]\&\s-2\u[1]\d\s+2
بیابید (خطوطی که با \*(Aq#\*(Aq آغاز می‌شوند کامنت هستند، فهرست‌ها با نویسه‌ی
;
از هم جدا می‌شوند و غیره)\&.
.PP
هر بخش متناظر با نام یک تنظیم است که در مشخصات تنظیمات (\fBnm-settings-nmcli\fR(5)) شرح داده شده است\&. هر جفت کلید/مقدار در یک بخش، یکی از ویژگی‌های مشخص‌شده در آن سند است\&.
.PP
بیشتر ویژگی‌ها با همان قالبی که در مشخصات آمده است در
\fIkeyfile\fR
نوشته می‌شوند\&. با این حال، استفاده از برخی مقادیر برای انسان دشوار است، بنابراین در
\fIkeyfile\fR
به روش‌هایی خواناتر ذخیره می‌شوند\&. این ویژگی‌ها که با مشخصات اصلی تفاوت دارند در ادامه شرح داده شده‌اند\&. به عنوان مثال، آدرس‌های IP به صورت آرایه‌ای از اعداد صحیح نوشته نمی‌شوند، بلکه به شکلی خواناتر مانند "1\&.2\&.3\&.4/12 1\&.2\&.3\&.254" ثبت می‌گردند\&. همچنین برخی از فهرست‌های مقادیر پیچیده (مانند addresses، routes، routing\-rules)، به جای استفاده از فهرستی جداشده با نقطه‌ویرگول، برای هر عنصر از یک جفت کلید-مقدار استفاده می‌کنند که کلید آن حالت مفرد نام ویژگی به همراه یک نمایه عددی است (مانند address1، address2، \&.\&.\&.)\&.
.PP
کاربران می‌توانند فایل‌های اتصال
\fIkeyfile\fR
را به صورت دستی ایجاد کرده یا تغییر دهند، حتی اگر این روش توصیه شده برای مدیریت پروفایل‌ها نباشد\&. با این حال، در صورت انجام این کار، باید NetworkManager را از تغییرات اعمال‌شده مطلع سازند (برای مثال از طریق
\fInmcli con (re)load\fR)\&.
.PP
\fBمثال‌هایی از پیکربندی keyfile\fR. 
.sp
.if n \{\
.RS 4
.\}
.nf
\fBیک نمونه پیکربندی برای شبکه اترنت (ethernet):\fR
[connection]
id=Main eth0
uuid=27afa607\-ee36\-43f0\-b8c3\-9d245cdc4bb3
type=802\-3\-ethernet
autoconnect=true

[ipv4]
method=auto

[802\-3\-ethernet]
mac\-address=00:23:5a:47:1f:71
            
.fi
.if n \{\
.RE
.\}

.sp
.if n \{\
.RS 4
.\}
.nf
\fBیک نمونه پیکربندی برای WPA\-EAP (پروتکل PEAP با MSCHAPv2) و گذرواژه با درخواست همیشگی (always\-ask secret):\fR
[connection]
id=CompanyWIFI
uuid=cdac6154\-a33b\-4b15\-9904\-666772cfa5ee
type=wifi
autoconnect=false

[wifi]
ssid=CorpWLAN
mode=infrastructure
security=802\-11\-wireless\-security

[wifi\-security]
key\-mgmt=wpa\-eap

[ipv4]
method=auto

[ipv6]
method=auto

[802\-1x]
eap=peap;
identity=joe
ca\-cert=/home/joe/\&.cert/corp\&.crt
phase1\-peapver=1
phase2\-auth=mschapv2
password\-flags=2
            
.fi
.if n \{\
.RE
.\}

.sp
.if n \{\
.RS 4
.\}
.nf
\fBیک نمونه پیکربندی برای openvpn:\fR
[connection]
id=RedHat\-openvpn
uuid=7f9b3356\-b210\-4c0e\-8123\-bd116c9c280f
type=vpn
timestamp=1385401165

[vpn]
service\-type=org\&.freedesktop\&.NetworkManager\&.openvpn
connection\-type=password
password\-flags=3
remote=ovpn\&.my\-company\&.com
cipher=AES\-256\-CBC
reneg\-seconds=0
port=443
username=joe
ca=/etc/openvpn/ISCA\&.pem
tls\-remote=ovpn\&.my\-company\&.com

[ipv6]
method=auto

[ipv4]
method=auto
ignore\-auto\-dns=true
never\-default=true
            
.fi
.if n \{\
.RE
.\}

.sp
.if n \{\
.RS 4
.\}
.nf
\fBیک نمونه پیکربندی برای پل (bridge) و درگاه پل (bridge port):\fR
[connection]                                 [connection]
id=MainBridge                                id=br\-port\-1
uuid=171ae855\-a0ab\-42b6\-bd0c\-60f5812eea9d    uuid=d6e8ae98\-71f8\-4b3d\-9d2d\-2e26048fe794
interface\-name=MainBridge                    interface\-name=em1
type=bridge                                  type=ethernet
                                             controller=MainBridge
[bridge]                                     port\-type=bridge
interface\-name=MainBridge
            
.fi
.if n \{\
.RE
.\}

.sp
.if n \{\
.RS 4
.\}
.nf
\fBیک نمونه پیکربندی برای VLAN:\fR
[connection]
id=VLAN for building 4A
uuid=8ce1c9e0\-ce7a\-4d2c\-aa28\-077dda09dd7e
interface\-name=VLAN\-4A
type=vlan

[vlan]
interface\-name=VLAN\-4A
parent=eth0
id=4
            
.fi
.if n \{\
.RE
.\}
.SH "جزئیات (DETAILS)"
.PP
متغیرهای افزونه‌ی
\fIkeyfile\fR
برای اکثر ویژگی‌های NetworkManager دارای نگاشت یک‌به‌یک هستند\&. بدین معنا که یک ویژگی NetworkManager در keyfile به عنوان متغیری با همان نام و در همان قالب ذخیره می‌شود\&. برای این قاعده چندین استثنا وجود دارد که هدف اصلی آن‌ها ساده‌تر کردن نحو keyfile برای کاربران است\&. استثناهایی که به طور ویژه توسط افزونه‌ی
\fIkeyfile\fR
مدیریت می‌شوند در ادامه فهرست شده‌اند\&. برای اطلاع از تمام تنظیمات و ویژگی‌های موجود و توضیحات آن‌ها به
\fBnm-settings-nmcli\fR(5)
مراجعه کنید\&.
.PP
\fBنام‌های مستعار (Aliases)\fR. تایپ کردن یا به خاطر سپردن برخی از نام‌های تنظیمات NetworkManager دشوار است\&. بنابراین
\fIkeyfile\fR
نام‌های مستعاری را ارائه می‌دهد که می‌توان به جای نام‌های اصلی از آن‌ها استفاده کرد\&.
.RS 4
\fIsetting name                 keyfile alias\fR
.RE
.RS 4
802\-3\-ethernet            =  ethernet
.RE
.RS 4
802\-11\-wireless           =  wifi
.RE
.RS 4
802\-11\-wireless\-security  =  wifi\-security
.RE
.sp
.it 1 an-trap
.nr an-no-space-flag 1
.nr an-break-flag 1
.br
.B جدول\ \&۱.\ \&تنظیم (بخش) 802\-11\-wireless
.TS
allbox tab(:);
lB lB lB lB.
