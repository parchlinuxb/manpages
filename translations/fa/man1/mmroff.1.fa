.
.
.\" Save and disable compatibility mode (for, e.g., Solaris 10/11).
.do nr *groff_mmroff_1_man_C \n[.cp]
.cp 0
.
.\" Define fallback for groff 1.23's MR macro if the system lacks it.
.nr do-fallback 0
.if !\n(.f           .nr do-fallback 1 \" mandoc
.if  \n(.g .if !d MR .nr do-fallback 1 \" older groff
.if !\n(.g           .nr do-fallback 1 \" non-groff *roff
.if \n[do-fallback]  \{\
.  de MR
.    ie \\n(.$=1 \
.      I \%\\$1
.    el \
.      IR \%\\$1 (\\$2)\\$3
.  .
.\}
.rr do-fallback
.
.
.\" ====================================================================
.SH "خلاصه دستور (SYNOPSIS)"
.\" ====================================================================
.
.SY mmroff
.RB [ \-x ]
.IR groff-argument \~.\|.\|.
.YS
.
.
.P
.SY mmroff
.B \-\-help
.YS
.
.
.P
.SY mmroff
.B \%\-\-version
.YS
.
.
.\" ====================================================================
.SH "توضیحات (DESCRIPTION)"
.\" ====================================================================
.
.I mmroff
یک پیشخوان (wrapper) ساده برای
.IR groff
است که به منظور بسط دادن ارجاعات داخلی در اسناد
.I m\%m
به کار می‌رود؛ به
.MR groff_mm 7
مراجعه کنید.
.
این برنامه دستور
.I groff
را همراه با گزینه
.B \-mm
دو بار اجرا می‌کند؛
بار نخست همراه با گزینه‌های
.B \-z
و
.B \-rRef=1
برای پر کردن فایل‌های مرجع و نمایه با مدخل‌های متناظر آن‌ها،
و سپس بدون آن‌ها برای تولید سند نهایی.
.
همچنین گنجاندن تصاویر PostScript را با ماکروی
.B PIC
مدیریت می‌کند.
.
اسنادی که از این قابلیت‌های
.I "groff mm"
(ماکروهای
.BR INITI ،
.BR IND ،
.BR INDP ،
.BR INITR ،
.BR SETR ،
.BR GETHN ،
.BR GETPN ،
.BR GETR ،
.BR GETST
و
.BR PIC )
استفاده نمی‌کنند، نیازی به
.IR \%mmroff
ندارند.
.
.
.\" ====================================================================
.SH "گزینه‌ها (OPTIONS)"
.\" ====================================================================
.
.B \-\-help
پیام راهنمای استفاده را نمایش می‌دهد، در حالی که
.B \%\-\-version
اطلاعات نسخه را نشان می‌دهد؛
هر دو گزینه پس از اجرا خارج می‌شوند.
.
.
.TP
.B \-x
فایل فهرست مراجع را ایجاد یا به‌روزرسانی کرده و خارج می‌شود.
.
.
.\" ====================================================================
.SH "محیط (ENVIRONMENT)"
.\" ====================================================================
.
به‌طور معمول،
جداکننده مسیر در متغیرهای محیطی که به
.I PATH
ختم می‌شوند، دونقطه (:) است؛
این موضوع ممکن است بسته به سیستم‌عامل متفاوت باشد.
.
برای نمونه،
ویندوز به جای آن از نقطه-ویرگول (;) استفاده می‌کند.
.
.
.TP
.I GROFF_BIN_PATH
دستورات
.I groff
را در این دایرکتوری‌ها جستجو می‌کند و پس از آن به سراغ موارد موجود در
.I PATH
می‌رود.
.
در صورت عدم تنظیم،
دایرکتوری محل نصب فایل‌های اجرایی GNU
.IR roff ،
یعنی
.IR /usr/\:\%bin ،
پیش از
.I PATH
جستجو می‌شود.
.
.
.\" ====================================================================
.SH "وضعیت خروج (EXIT STATUS)"
.\" ====================================================================
.
دستور
.I mmroff
با وضعیت
.B 0
خارج می‌شود اگر گزینه‌های
.B \-\-help
یا
.B \%\-\-version
مشخص شده باشند،
یا اگر گزینه
.B \-x
مشخص شده باشد و برنامه با موفقیت فایل فهرست مراجع را ایجاد کرده یا به‌روزرسانی کند.
.
این برنامه با وضعیت
.B 1
خارج می‌شود اگر قادر به ایجاد فایل‌های لازم نباشد.
.
در غیر این صورت،
با وضعیت خروج
.IR groff
خارج می‌شود.
.
.
.\" ====================================================================
.SH "نویسندگان (AUTHORS)"
.\" ====================================================================
.
دستور
.I mmroff
توسط
.MT jh@\:axis\:.se
J\[o ad]rgen H\[a ad]gg
.ME
از لوند، سوئد نوشته شده است.
.
.
.\" ====================================================================
.SH "همچنین ببینید (SEE ALSO)"
.\" ====================================================================
.
.MR groff_mm 7 ،
.MR groff_mmse 7 ،
.MR groff 1 ،
.MR \%troff 1 ،
.MR \%tbl 1 ،
.MR \%pic 1 ،
.MR \%eqn 1
.
.
.\" Restore compatibility mode (for, e.g., Solaris 10/11).
.cp \n[*groff_mmroff_1_man_C]
.do rr *groff_mmroff_1_man_C
.
.
