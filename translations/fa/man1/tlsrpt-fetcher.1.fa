.TH "TLSRPT\-FETCHER" "1" "2026-09-01" "tlsrpt\-fetcher" "tlsrpt\-fetcher"
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.ss \n[.ss] 0
.nh
.ad l
.de URL
\fI\\$2\fP <\\$1>\\$3
..
