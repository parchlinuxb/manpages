.br
animation-duration: 
.br
type: integer 
.br
optional: true 
.br
default: 250 
.br
description: مدت زمان پویانمایی بر حسب میلی‌ثانیه 
.br
actions: 
.br
type: array 
.br
Default values: [] 
.br
