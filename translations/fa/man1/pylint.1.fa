.SS cell\-var\-from\-loop / W0640
.sp
\fBMessage emitted:\fP
.sp
\fBCell variable %s defined in loop\fP
.sp
\fBDescription:\fP
.sp
\fIA variable used in a closure is defined in a loop. This will result in all closures using the same value for the closed\-over variable.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
def teacher_greeting(names):
    greetings = []
    for name in names:

        def greet():
            # do something
            print(f\(dqHello, {name}!\(dq)  # [cell\-var\-from\-loop]

        if name.isalpha():
            greetings.append(greet)

    for greet in greetings:
        # the \(dqname\(dq variable is evaluated when the function is called here,
        # which is the last value it had in the loop \- \(dqNot\-A\-Name\(dq
        greet()


teacher_greeting([\(dqGraham\(dq, \(dqJohn\(dq, \(dqTerry\(dq, \(dqEric\(dq, \(dqTerry\(dq, \(dqMichael\(dq])
# \(dqHello, Michael!\(dq
# \(dqHello, Michael!\(dq
# \(dqHello, Michael!\(dq
# \(dqHello, Michael!\(dq
# \(dqHello, Michael!\(dq

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.sp
\fBfunctools.partial.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
import functools


def teacher_greeting(names):
    greetings = []
    for name in names:
        if name.isalpha():
            # \(dqname\(dq is evaluated when the partial is created here, so this
            # does not do lazy evaluation
            greetings.append(functools.partial(print, f\(dqHello, {name}!\(dq))

    for greet in greetings:
        # \(gapartial\(gas are called like functions, but you\(aqve already passed the
        # arguments to them
        greet()


teacher_greeting([\(dqGraham\(dq, \(dqJohn\(dq, \(dqTerry\(dq, \(dqEric\(dq, \(dqTerry\(dq, \(dqMichael\(dq])
# \(dqHello, Graham!\(dq
# \(dqHello, John!\(dq
# \(dqHello, Eric!\(dq
# \(dqHello, Terry!\(dq
# \(dqHello, Michael!\(dq

.EE
.UNINDENT
.UNINDENT
.sp
\fBnew_function.py\fP:
.INDENT 0.0
.INDENT 3.5
.sp
.EX
def teacher_greeting(names):
    def greet(name):
        # do something
        print(f\(dqHello, {name}!\(dq)

    for name in names:
        if name.isalpha():
            # we\(aqre passing the value of \(dqname\(dq to the function here
            greet(name)


teacher_greeting([\(dqGraham\(dq, \(dqJohn\(dq, \(dqTerry\(dq, \(dqEric\(dq, \(dqTerry\(dq, \(dqMichael\(dq])
# \(dqHello, Graham!\(dq
# \(dqHello, John!\(dq
# \(dqHello, Eric!\(dq
# \(dqHello, Terry!\(dq
# \(dqHello, Michael!\(dq

.EE
