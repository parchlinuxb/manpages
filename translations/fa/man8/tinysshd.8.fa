.TH tinysshd 8
.SH "نام (NAME)"
tinysshd \- دیمن کوچک، مینیمال و امن SSH
.SH "خلاصه دستور (SYNOPSIS)"
.B tinysshd
[ \fIگزینه‌ها\fR ]
.I keydir
.SH "توضیحات (DESCRIPTION)"
.B tinysshd
یک سرور مینیمال SSH است که تنها زیرمجموعه‌ای از ویژگی‌های پروتکل SSHv2 را پیاده‌سازی می‌کند.
.sp
.B tinysshd
تنها از رمزنگاری امن پشتیبانی می‌کند (حداقل امنیت ۱۲۸ بیتی، محافظت‌شده در برابر حملات زمان‌بندی حافظه نهان).
.sp
.B tinysshd
الگوریتم‌های رمزنگاری قدیمی‌تر را پیاده‌سازی نمی‌کند (مانند RSA، DSA، HMAC\-MD5، HMAC\-SHA1، 3DES، RC4 و غیره).
.sp
.B tinysshd
قابلیت‌های ناامن را پیاده‌سازی نمی‌کند (مانند احراز هویت مبتنی بر گذرواژه یا احراز هویت مبتنی بر میزبان).
.sp
.B tinysshd
ویژگی‌هایی از قبیل پروتکل SSH1، فشرده‌سازی، فوروارد پورت، فوروارد عامل (agent)، فوروارد X11 و موارد مشابه را ندارد.
.sp
.B tinysshd
از تخصیص پویای حافظه استفاده نمی‌کند (عدم بروز خطاهای تخصیص حافظه و غیره).
.SH "گزینه‌ها (OPTIONS)"
.TP
.B \-q
عدم نمایش پیام‌های خطا
.TP
.B \-Q
چاپ پیام‌های خطا (پیش‌فرض)
.TP
.B \-v
چاپ اطلاعات بیشتر و جزئیات
.TP
.B \-s
فعال‌سازی رمزنگاری مدرن (پیش‌فرض)
.sp
امضا: \- ssh\-ed25519
.sp
تبادل کلید: \- curve25519\-sha256
.sp
متقارن: \- chacha20\-poly1305@openssh.com
.TP
.B \-S
غیرفعال‌سازی رمزنگاری مدرن
.TP
.B \-p
فعال‌سازی رمزنگاری پساکوانتومی (پیش‌فرض)
.sp
امضا: \- در حال توسعه (هنوز پیاده‌سازی نشده است)
.sp
تبادل کلید: \- sntrup761x25519\-sha512@openssh.com
.sp
متقارن: \- chacha20\-poly1305@openssh.com
.TP
.B \-P
غیرفعال‌سازی رمزنگاری پساکوانتومی
.TP
.B \-l
استفاده از syslog به‌جای خروجی خطای استاندارد (مناسب برای اجرا از طریق inetd)
.TP
.B \-L
عدم استفاده از syslog، استفاده از خروجی خطای استاندارد (پیش‌فرض)
.TP
.B \-x \fIname=command
افزودن دستور زیرسیستم (نمونه: sftp=/usr/libexec/openssh/sftp\-server)
.TP
.B \-e \fIcommand
اجرای دستور داده‌شده به‌جای باز کردن شل (غیرفعال‌کننده درخواست‌های کانال \fIexec\fR/\fIsubsystem\fR)
.TP
.I keydir
دایرکتوری حاوی کلیدهای TinySSH، معمولاً /etc/tinyssh/sshkeydir
.SH "احراز هویت (AUTHORIZATION)"
.B tinysshd
تنها از احراز هویت کلید عمومی از طریق
.B AuthorizedKeysFile
در مسیر ~/.ssh/authorized_keys پشتیبانی می‌کند. هر خط از این فایل حاوی یک کلید در قالب "keytype base64-encoded-key comment" است.
.B tinyssh
تنها از نوع کلید "ssh-ed25519" پشتیبانی می‌کند.
.sp
نمونه ~/.ssh/authorized_keys:
.nf
.RS 2
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILV5AGhGQ1QVXjBWhTKJP3vrqE3isL4ivisBailQ14gS comment
.RE
.fi
.SH "اجرا (RUNNING)"
.TP
.B TCPSERVER
.nf
tcpserver \-HRDl0 0.0.0.0 22 /usr/sbin/tinysshd \-v /etc/tinyssh/sshkeydir &
.fi
.TP
.B BUSYBOX
.nf
busybox tcpsvd 0 22 tinysshd \-v /etc/tinyssh/sshkeydir &
.fi
.TP
.B INETD
.RS 4
/etc/inetd.conf:
.RS 4
.nf
ssh stream tcp nowait root /usr/sbin/tinysshd tinysshd \-l \-v /etc/tinyssh/sshkeydir
.fi
.RE
.RE
.TP
.B SYSTEMD
.RS 4
tinysshd.socket:
.RS 4
.nf
[Unit]
Description=TinySSH server socket
ConditionPathExists=!/etc/tinyssh/disable_tinysshd

[Socket]
ListenStream=22
Accept=yes

[Install]
WantedBy=sockets.target
.fi
.RE
.RE
.sp
.RS 4
tinysshd@.service:
.RS 4
.nf
[Unit]
Description=Tiny SSH server
After=network.target auditd.service

[Service]
ExecStartPre=\-/usr/sbin/tinysshd\-makekey \-q /etc/tinyssh/sshkeydir
EnvironmentFile=\-/etc/default/tinysshd
ExecStart=/usr/sbin/tinysshd ${TINYSSHDOPTS} \-\- /etc/tinyssh/sshkeydir
KillMode=process
SuccessExitStatus=111
StandardInput=socket
StandardError=journal

[Install]
WantedBy=multi\-user.target
.fi
.RE
.RE
.SH "همچنین ببینید (SEE ALSO)"
.BR tinysshd\-makekey (8),
.BR tinysshd\-printkey (8)
.sp
.nf
https://tinyssh.org
.fi
