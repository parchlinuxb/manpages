.\" DO NOT MODIFY THIS FILE!  It was generated by help2man 1.49.3.
.TH NIMPRETTY "1" "April 2026" "nimpretty 2.2.10" "User Commands"
.SH "نام (NAME)"
nimpretty \- Nimpretty
.SH "توضیحات (DESCRIPTION)"
nimpretty \- Nim Pretty Printer Version 0.2
.IP
(c) 2017 Andreas Rumpf
.SS "Usage:"
.IP
nimpretty [options] nimfiles...
.SH "گزینه‌ها (OPTIONS)"
.TP
\fB\-\-out\fR:file
set the output file (default: overwrite the input file)
.TP
\fB\-\-outDir\fR:dir
set the output dir (default: overwrite the input files)
.TP
\fB\-\-stdin\fR
read input from stdin and write output to stdout
.TP
\fB\-\-indent\fR:N[=0]
set the number of spaces that is used for indentation
\fB\-\-indent\fR:0 means autodetection (default behaviour)
.TP
\fB\-\-maxLineLen\fR:N
set the desired maximum line length (default: 80)
.TP
\fB\-\-version\fR
show the version
.TP
\fB\-\-help\fR
show this help
