.PU
.TH wvWml 1 
.SH "نام (NAME)"
wvHtml \- convert msword documents to WML
.SH "خلاصه دستور (SYNOPSIS)"
.ll +8
.B wvWml in_word_doc out_wml_doc
.ll -8
.br
.SH "توضیحات (DESCRIPTION)"
.I wvWml converts word documents into WML,
suitable for viewing on PDAs such as
web-phones.
.SH MORE INFORMATION
http://wvware.sourceforge.net
.SH "همچنین ببینید (SEE ALSO)"
.BR wvAbw(1),
.BR wvWare(1),
.BR wvHtml(1),
.BR wvLatex(1),
.BR wvCleanLatex(1),
.BR wvPS(1),
.BR wvDVI(1),
.BR wvPDF(1),
.BR wvRTF(1),
.BR wvText(1),
.BR wvMime(1),
.BR catdoc(1), 
.BR word2x(1)
.SH "نویسنده (AUTHOR)"
