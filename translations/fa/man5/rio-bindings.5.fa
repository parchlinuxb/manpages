.SH "سفارشی‌سازی (CUSTOMIZATION)"
.PP
کلیدهای میان‌بر را می‌توان با افزودن ورودی‌ها به بخش \fB[bindings]\fR در فایل پیکربندی سفارشی‌سازی کرد:
.PP
.nf
.RS 4
[[bindings\&.keys]]
key = "q"
with = "super"
action = "Quit"

[[bindings\&.keys]]
key = "Enter"
with = "ctrl|shift"
action = "CreateWindow"
.fi
.RE
.PP
