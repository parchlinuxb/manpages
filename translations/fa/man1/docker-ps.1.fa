.nh
.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker-ps \- فهرست کردن کانتینرها


.SH "خلاصه دستور (SYNOPSIS)"
\fBdocker ps [OPTIONS]\fP


.SH "شرح (DESCRIPTION)"
نام مستعار برای \fBdocker container ls\fR\&.


.SH "گزینه‌ها (OPTIONS)"
\fB-a\fP, \fB--all\fP[=false]
	نمایش تمام کانتینرها (پیش‌فرض فقط کانتینرهای در حال اجرا را نمایش می‌دهد)

.PP
\fB-f\fP, \fB--filter\fP=
	فیلتر کردن خروجی بر اساس شرایط ارائه‌شده

.PP
\fB--format\fP=""
	قالب‌بندی خروجی با استفاده از یک الگوی سفارشی:
\&'table':            چاپ خروجی در قالب جدول همراه با سرستون‌ها (پیش‌فرض)
\&'table TEMPLATE':   چاپ خروجی در قالب جدول با استفاده از الگوی Go داده‌شده
\&'json':             چاپ در قالب JSON
\&'TEMPLATE':         چاپ خروجی با استفاده از الگوی Go داده‌شده.
برای اطلاعات بیشتر درباره قالب‌بندی خروجی با الگوها به https://docs.docker.com/go/formatting مراجعه کنید

.PP
\fB-n\fP, \fB--last\fP=-1
	نمایش n کانتینر ایجادشده اخیر (شامل تمام وضعیت‌ها)

.PP
\fB-l\fP, \fB--latest\fP[=false]
	نمایش آخرین کانتینر ایجادشده (شامل تمام وضعیت‌ها)

.PP
\fB--no-trunc\fP[=false]
	کوتاه نکردن خروجی

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	تنها نمایش شناسه‌های کانتینر

.PP
\fB-s\fP, \fB--size\fP[=false]
	نمایش اندازه کل فایل‌ها


.SH "ببینید (SEE ALSO)"
\fBdocker(1)\fP
