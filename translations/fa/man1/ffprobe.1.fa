.IP \fBpentium2\fR 4
.IX Item "pentium2"
.IP \fBpentium3\fR 4
.IX Item "pentium3"
.IP \fBpentium4\fR 4
.IX Item "pentium4"
.IP \fBk6\fR 4
.IX Item "k6"
.IP \fBk62\fR 4
.IX Item "k62"
