.TH man 1 "2026-06-08" "0.18.2" "Profanity XMPP client"

.SH "نام (NAME)"
/export

.SH "توضیحات (DESCRIPTION)"
Exports contacts to a csv file.

.SH "خلاصه دستور (SYNOPSIS)"
/export <filepath>

.LP

.SH ARGUMENTS
.PP
\fB<filepath>\fR
.RS 4
Path to the output file.
.RE

.SH "مثال‌ها (EXAMPLES)"
/export /path/to/output.csv

.LP
/export ~/contacts.csv

.LP
