.SH "نام (NAME)"
openssl\-verify \- ابزار اعتبارسنجی گواهی‌های X.509
.SH "خلاصه دستور (SYNOPSIS)"
.IX Header "SYNOPSIS"
\&\fBopenssl\fR \fBverify\fR
[\fB\-help\fR]
[\fB\-CRLfile\fR \fIfilename\fR|\fIuri\fR]
