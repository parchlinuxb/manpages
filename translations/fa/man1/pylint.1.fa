.sp
\fBConsider using a decorator instead of calling classmethod\fP
.sp
\fBDescription:\fP
.sp
\fIUsed when a class method is defined without using the decorator syntax.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
class Fruit:
    COLORS = []

    def __init__(self, color):
        self.color = color

    def pick_colors(cls, *args):
        \(dq\(dq\(dqclassmethod to pick fruit colors\(dq\(dq\(dq
        cls.COLORS = args

    pick_colors = classmethod(pick_colors)  # [no\-classmethod\-decorator]

.EE
