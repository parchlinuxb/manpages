.IX Title "bt-device 1"
.TH bt-device 1 "2014-08-01" "" "bluez-tools"
.\" For nroff, turn off justification.  Always turn off hyphenation; it makes
.\" way too many mistakes in technical documents.
.if n .ad l
.nh
.SH "نام (NAME)"
bt-device \- مدیریت دستگاههای بلوتوث از خط فرمان
.SH "خلاصه دستور (SYNOPSIS)"
.IX Header "خلاصه دستور (SYNOPSIS)"
bt-device [\s-1گزینه‌ها...\s0]
.PP
گزینه‌های راهنما:
  \-h, \-\-help
.PP
گزینه‌های برنامه:
  \-a, \-\-adapter=<name|mac>
  \-l, \-\-list
  \-c, \-\-connect=<mac>
  \-d, \-\-disconnect=<name|mac>
  \-r, \-\-remove=<name|mac>
  \-i, \-\-info=<name|mac>
  \-s, \-\-services <name|mac> [<pattern>]
  \-\-set <name|mac> <property> <value>
  \-v, \-\-verbose
.SH "توضیحات (DESCRIPTION)"
.IX Header "توضیحات (DESCRIPTION)"
این ابزار برای مدیریت دستگاه‌های بلوتوث به کار می‌رود. شما می‌توانید دستگاه‌های اضافه‌شده را فهرست کنید، به یک دستگاه جدید متصل شوید، اتصال دستگاه را قطع کنید، دستگاه اضافه‌شده را حذف کنید، اطلاعات دستگاه را مشاهده نمایید، سرویس‌های دستگاه راه دور را شناسایی کنید یا ویژگی‌های دستگاه را تغییر دهید.
.SH "گزینه‌ها (OPTIONS)"
.IX Header "گزینه‌ها (OPTIONS)"
\&\fB\-h, \-\-help\fR
    نمایش راهنما
.PP
\&\fB\-a, \-\-adapter <name|mac>\fR
    مشخص کردن آداپتور مورد استفاده با نام یا نشانی \s-1MAC\s0 آن
    (اگر این گزینه مشخص نشود \- از آداپتور پیش‌فرض استفاده می‌شود)
.PP
\&\fB\-l, \-\-list\fR
    فهرست کردن دستگاه‌های اضافه‌شده
.PP
\&\fB\-c, \-\-connect <mac>\fR
    اتصال به دستگاه راه دور با نشانی \s-1MAC\s0 آن، دریافت تمام رکوردهای \s-1SDP\s0
    و سپس آغاز فرآیند جفت‌سازی (pairing)
.PP
\&\fB\-d, \-\-disconnect <name|mac>\fR
    قطع اتصال یک دستگاه راه دور مشخص با پایان دادن به
    اتصال سطح پایین \s-1ACL\s0.
.PP
\&\fB\-r, \-\-remove\fR
    حذف دستگاه (و همچنین اطلاعات جفت‌سازی)
.PP
\&\fB\-i, \-\-info\fR
    نمایش اطلاعات درباره دستگاه (تمام ویژگی‌ها را بازمی‌گرداند)
.PP
\&\fB\-s, \-\-services <name|mac> [<pattern>]\fR
    آغاز فرآیند شناسایی سرویس برای دریافت رکوردهای سرویس راه دور؛
    پارامتر `pattern` می‌تواند برای تعیین UUIDهای خاص استفاده شود
.PP
\&\fB\-\-set <property> <value>\fR
    تغییر ویژگی‌های دستگاه (برای دیدن فهرست ویژگی‌های موجود، بخش
    \s-1DEVICE PROPERTIES\s0 را ببینید)
.PP
\&\fB\-v, \-\-verbose\fR
    نمایش رکوردهای سرویس راه دور با جزئیات کامل (بر حالت شناسایی
    سرویس تأثیر می‌گذارد)
.SH "ویژگی‌های دستگاه (DEVICE PROPERTIES)"
.IX Header "ویژگی‌های دستگاه (DEVICE PROPERTIES)"
string  Address [ro]
        نشانی دستگاه بلوتوث (\s-1MAC\s0) مربوط به دستگاه راه دور.
.PP
string  Name [ro]
        نام دستگاه بلوتوث راه دور.
.PP
string  Icon [ro]
        نام آیکون پیشنهادی مطابق با مشخصات نام‌گذاری آیکون freedesktop.org.
.PP
uint32  Class [ro]
        کلاس دستگاه بلوتوث دستگاه راه دور.
.PP
list    UUIDs [ro]
        فهرستی از UUIDهای ۱۲۸ بیتی که سرویس‌های راه دور در دسترس را نشان می‌دهند.
.PP
boolean Paired [ro]
        نشان می‌دهد که آیا دستگاه راه دور جفت شده است یا خیر.
.PP
boolean Connected [ro]
        نشان می‌دهد که آیا دستگاه راه دور در حال حاضر متصل است یا خیر.
.PP
boolean Trusted [rw]
        نشان می‌دهد که آیا دستگاه راه دور مورد اعتماد در نظر گرفته می‌شود یا خیر.
.PP
boolean Blocked [rw]
        اگر روی true تنظیم شود، هرگونه اتصال ورودی از دستگاه بلافاصله رد خواهد شد.
.PP
string Alias [rw]
        نام مستعار دستگاه راه دور. از نام مستعار می‌توان برای داشتن
        یک نام دوستانه متفاوت برای دستگاه راه دور استفاده کرد.
.PP
.Vb 3
\&        در صورتی که هیچ نام مستعاری تنظیم نشده باشد، نام اصلی دستگاه
\&        راه دور را بازمی‌گرداند. تنظیم یک رشته خالی به عنوان نام مستعار،
\&        آن را دوباره به نام دستگاه راه دور برمی‌گرداند.
.Ve
.PP
boolean LegacyPairing [ro]
        اگر دستگاه فقط از سازوکار جفت‌سازی قدیمی (پیش از نسخه ۲.۱)
        پشتیبانی کند، روی true تنظیم می‌شود.
.SH "نویسنده (AUTHOR)"
.IX Header "نویسنده (AUTHOR)"
Alexander Orlenko <zxteam@gmail.com>.
.SH "همچنین ببینید (SEE ALSO)"
.IX Header "همچنین ببینید (SEE ALSO)"
\&\fIbt\-adapter\fR\|(1) \fIbt\-agent\fR\|(1) \fIbt\-network\fR\|(1)
