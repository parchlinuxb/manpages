.TH "FVWMMFL" "1" "2026-06-28" "\ \&" "Fvwm Modules"
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.ss \n[.ss] 0
.nh
.ad l
.de URL
\fI\\$2\fP <\\$1>\\$3
