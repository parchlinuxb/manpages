.  IR fields ] " "\c
.  RB [ \-O | \-\-sort\ \c
.  IR sort_fields ] " "\c
.  RB [ \-\-nameprefixes ] " "\c
.  RB [ \-\-separator\ \c
.  IR separator ] " "\c
.  RI [ device_name ]
.  CME
..
.CMD_INFOLONG
