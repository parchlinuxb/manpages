.TH "PACCACHE" "8" "2025\-12\-11" "Pacman\-contrib 1\&.13\&.1" "راهنمای Pacman\-contrib"
.ie  \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
