.TH "DOCKER" "1" "Aug 2026" "Docker Community" "Docker User Manuals"

.SH "نام (NAME)"
docker\-swarm\-leave \- ترک کردن swarm

.SH "خلاصه دستور (SYNOPSIS)"
\fBdocker swarm leave [OPTIONS]\fP

.SH "شرح (DESCRIPTION)"
ترک کردن swarm

.SH "گزینه‌ها (OPTIONS)"
\fB-f\fP, \fB--force\fP[=false]
	اجبار این گره به ترک swarm، با نادیده گرفتن هشدارها

.SH "همچنین ببینید (SEE ALSO)"
\fBdocker-swarm(1)\fP
