.fam C
{"class":"RTCM2","type":14,"station_id":652,"zcount":1657.2,
        "seqnum":3,"length":1,"station_health":6,"week":601,"hour":109,
        "leapsecs":15}
.fam
.fi
.if n .RE
.SS "نوع ۱۶: پیام ویژه (Special Message)"
.sp
.it 1 an-trap
.nr an-no-space-flag 1
.nr an-break-flag 1
.br
.B جدول ۲۷. پیام ویژه
.TS
allbox tab(:);
ltB ltB ltB.
