.SH "نام (NAME)"
git-bug-bridge-auth-rm \- حذف یک اعتبارنامه


.SH "خلاصه دستور (SYNOPSIS)"
\fBgit-bug bridge auth rm BRIDGE_ID [flags]\fP


.SH "توضیحات (DESCRIPTION)"
حذف یک اعتبارنامه احراز هویت.


.SH "گزینه‌ها (OPTIONS)"
\fB-h\fP, \fB--help\fP[=false]
	راهنما برای rm


