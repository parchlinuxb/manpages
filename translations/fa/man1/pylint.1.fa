\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
fruits = {\(dqapple\(dq, \(dqorange\(dq, \(dqmango\(dq}
for fruit in fruits:
    fruits.add(fruit + \(dqyum\(dq)  # [modified\-iterating\-set]

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
fruits = {\(dqapple\(dq, \(dqorange\(dq, \(dqmango\(dq}
for fruit in fruits.copy():
    fruits.add(fruit + \(dqyum\(dq)

.EE
.UNINDENT
.UNINDENT
.sp
Created by the modified_iteration \%<https://\:github\:.com/\:pylint-dev/\:pylint/\:blob/\:main/\:build/\:lib/\:pylint/\:checkers/\:modified_iterating_checker\:.py> checker.
.SS multiple\-class\-sub\-patterns / E1904
.sp
\fBMessage emitted:\fP
.sp
\fBMultiple sub\-patterns for attribute %s\fP
.sp
\fBDescription:\fP
.sp
\fIEmitted when there is more than one sub\-pattern for a specific attribute in a class pattern.\fP
.sp
\fBProblematic code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
class Book:
    __match_args__ = (\(dqtitle\(dq, \(dqyear\(dq)

    def __init__(self, title, year):
        self.title = title
        self.year = year


def func(item: Book):
    match item:
        case Book(\(dqabc\(dq, title=\(dqabc\(dq):  # [multiple\-class\-sub\-patterns]
            ...
        case Book(year=2000, year=2001):  # [multiple\-class\-sub\-patterns]
            ...

.EE
.UNINDENT
.UNINDENT
.sp
\fBCorrect code:\fP
.INDENT 0.0
.INDENT 3.5
.sp
.EX
class Book:
    __match_args__ = (\(dqtitle\(dq, \(dqyear\(dq)

    def __init__(self, title, year):
        self.title = title
        self.year = year


def func(item: Book):
    match item:
        case Book(title=\(dqabc\(dq):
            ...
        case Book(year=2000):
            ...

.EE
.UNINDENT
.UNINDENT
.sp
