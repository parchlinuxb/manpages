'\" t
.nh
.TH podman-system 1
.SH "نام (NAME)"
podman-system \- مدیریت پادمن

.SH "خلاصه دستور (SYNOPSIS)"
\fBpodman system\fP \fIsubcommand\fP

.SH "توضیحات (DESCRIPTION)"
دستور system امکان مدیریت سیستم و منابع پادمن را فراهم می‌کند.

.SH "دستورات (COMMANDS)"
.TS
allbox;
l l l 
l l l .
\fBCommand\fP	\fBMan Page\fP	\fBDescription\fP
check	podman-system-check(1)	T{
انجام بررسی‌های یکپارچگی و سلامت روی فضای ذخیره‌سازی ایمیج و کانتینر.
T}
connection	podman-system-connection(1)	T{
مدیریت مقصد(ها) برای سرویس(های) پادمن
T}
hyperv-prep	podman-system-hyperv-prep(1)	T{
دستوری برای مدیر سیستم ویندوز جهت آماده‌سازی میزبان برای اجرای ماشین‌های پادمن مبتنی بر Hyper-V
T}
df	podman-system-df(1)	نمایش میزان فضای دیسک مصرفی پادمن.
events	podman-events(1)	نظارت بر رویدادهای پادمن
info	podman-info(1)	T{
نمایش اطلاعات سیستمی مربوط به پادمن.
T}
migrate	podman-system-migrate(1)	T{
انتقال کانتینرهای موجود به نگارش جدید پادمن.
T}
prune	podman-system-prune(1)	T{
حذف تمام پادها، کانتینرها، ایمیج‌ها، شبکه‌ها و داده‌های ولوم بلااستفاده.
T}
renumber	podman-system-renumber(1)	T{
انتقال شماره‌های قفل برای مدیریت تغییر حداکثر تعداد قفل‌ها.
T}
reset	podman-system-reset(1)	T{
بازنشانی فضای ذخیره‌سازی به وضعیت اولیه.
T}
service	podman-system-service(1)	اجرای یک سرویس API
.TE

.SH "همچنین ببینید (SEE ALSO)"
\fBpodman(1)\fP
