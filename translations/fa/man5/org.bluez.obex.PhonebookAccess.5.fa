.TH "org.bluez.obex.PhonebookAccess" "5" "اکتبر 2023" "BlueZ" "مدیریت سیستم لینوکس"
.SH "نام (NAME)"
org.bluez.obex.PhonebookAccess \- مستندات واسط کاربری دفترچه تلفن OBEX بلوتوث
.SH "واسط (INTERFACE)"
.INDENT 0.0
