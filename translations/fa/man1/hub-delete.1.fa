.TH "hub-delete" "1" "12 Jul 2024" "hub version 2.14.2" "hub manual"
.nh
.ad l
.SH "نام (NAME)"
hub\-delete \- حذف مخزن در گیت‌هاب
.SH "خلاصه دستور (SYNOPSIS)"
.P
\fB\fChub delete\fR [\-y] [\fIORGANIZATION\fP/]\fINAME\fP
.SH "گزینه‌ها (OPTIONS)"
.PP
\-y, \-\-yes
.RS 4
صرف‌نظر کردن از اعلان تأیید و حذف فوری مخزن.
.RE
.PP
[\fIORGANIZATION\fP/]\fINAME\fP
.RS 4
نام مخزن در گیت‌هاب.
.RE
.br
.SH "مثال‌ها (EXAMPLES)"
.PP
.RS 4
.nf
$ hub delete recipes
[ personal repo deleted on GitHub ]

$ hub delete sinatra/recipes
[ repo deleted in GitHub organization ]
.fi
.RE
.SH "همچنین ببینید (SEE ALSO)"
.P
hub\-init(1), hub(1)
