.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
nvme-wdc-cap-diag \- دریافت لاگ عیب‌یابی دستگاه WDC و ذخیرهٔ آن در فایل\&.
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.nf
\fInvme wdc cap\-diag\fR <device> [\-\-output\-file=<FILE>, \-o <FILE>] [\-\-transfer\-size=<SIZE>, \-s <SIZE>]
.fi
.SH "توضیحات (DESCRIPTION)"
.sp
برای دستگاه NVMe داده‌شده، درخواست ثبت عیب‌یابی (Capture\-Diagnostics) ویژهٔ سازندهٔ WDC را ارسال کرده و نتیجه را در یک فایل ذخیره می‌کند\&.
.sp
پارامتر <device> دستگاه کاراکتری اجباری NVMe است (مانند: /dev/nvme0)\&.
.sp
این دستور تنها روی دستگاه‌های WDC که از این قابلیت پشتیبانی می‌کنند کار خواهد کرد\&. نتایج برای هر دستگاه دیگری تعریف‌نشده است\&.
.SH "گزینه‌ها (OPTIONS)"
.PP
\-o <FILE>, \-\-output\-file=<FILE>
.RS 4
فایل خروجی؛ پیش‌فرض شماره سریال دستگاه به همراه پسوند "cap_diag" است\&.
.RE
.PP
\-s <SIZE>, \-\-transfer\-size=<SIZE>
.RS 4
اندازهٔ انتقال داده؛ پیش‌فرض 0x10000 (۶۵۵۳۶ در مبنای ۱۰) بایت است\&.
.RE
.SH "مثال‌ها (EXAMPLES)"
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
دریافت لاگ ثبت عیب‌یابی از دستگاه و ذخیره در فایل پیش‌فرض در دایرکتوری جاری (مانند STM00019F3F9cap_diag\&.bin):
.sp
.if n \{\
.RS 4
.\}
.nf
# nvme wdc cap\-diag /dev/nvme0
.fi
.if n \{\
.RE
.\}
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
دریافت لاگ ثبت عیب‌یابی از دستگاه و ذخیره در فایل تعیین‌شده در دایرکتوری جاری (مانند testSTM00019F3F9cap_diag\&.bin):
.sp
.if n \{\
.RS 4
.\}
.nf
# nvme wdc cap\-diag /dev/nvme0 \-o test
.fi
.if n \{\
.RE
.\}
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
دریافت لاگ ثبت عیب‌یابی از دستگاه و ذخیره در فایل تعیین‌شده با مسیر کامل (مانند /tmp/testSTM00019F3F9cap_diag\&.bin):
.sp
.if n \{\
.RS 4
.\}
.nf
# nvme wdc cap\-diag /dev/nvme0 \-o /tmp/test
.fi
.if n \{\
.RE
.\}
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
دریافت لاگ ثبت عیب‌یابی از دستگاه با انتقال داده در تکه‌های ۶۴ کیلوبایتی و ذخیره در فایل پیش‌فرض در دایرکتوری جاری (مانند STM00019F3F9internal_fw_log\&.bin):
.sp
.if n \{\
.RS 4
.\}
.nf
# nvme wdc cap\-diag /dev/nvme0 \-s 0x10000
.fi
.if n \{\
.RE
.\}
.RE
.sp
.RS 4
.ie n \{\
\h'-04'\(bu\h'+03'\c
.\}
.el \{\
.sp -1
.IP \(bu 2.3
.\}
دریافت لاگ ثبت عیب‌یابی از دستگاه با انتقال داده در تکه‌های ۱۶ کیلوبایتی و ذخیره در فایل پیش‌فرض در دایرکتوری جاری (مانند STM00019F3F9internal_fw_log\&.bin):
.sp
.if n \{\
.RS 4
.\}
.nf
# nvme wdc cap\-diag /dev/nvme0 \-s 16384
.fi
.if n \{\
.RE
.\}
.RE
.SH "NVME"
.sp
بخشی از مجموعهٔ nvme\-user
.SH "همچنین ببینید (SEE ALSO)"
.BR nvme (1)
