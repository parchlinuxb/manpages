.TE

.SH Deployment Fields
.TS
allbox;
l l 
l l .
\fBField\fP	\fBSupport\fP
replicas	T{
✅ (the actual replica count is ignored and set to 1)
T}
selector	✅
template	✅
minReadySeconds	no
strategy\&.type	no
strategy\&.rollingUpdate\&.maxSurge	no
strategy\&.rollingUpdate\&.maxUnavailable	no
revisionHistoryLimit	no
