.nh
.TH KUBERNETES 1 "Jan 2015" "Eric Paris" "راهنمای کاربر kubernetes"

.SH "نام (NAME)"
kubectl-config-set-credentials \- تنظیم یک مدخل کاربر در kubeconfig


.SH "خلاصه دستور (SYNOPSIS)"
\fBkubectl config set-credentials\fP [OPTIONS]


.SH "توضیحات (DESCRIPTION)"
تنظیم یک مدخل کاربر در kubeconfig.

.PP
مشخص کردن نامی که از قبل وجود دارد، فیلدهای جدید را بر روی مقادیر موجود ادغام می‌کند.

.EX
    Client-certificate flags:
    --client-certificate=certfile --client-key=keyfile

    Bearer token flags:
    --token=bearer_token

    Basic auth flags:
    --username=basic_user --password=basic_password
.EE

.PP
توکن حامل (Bearer token) و احراز هویت پایه (basic auth) مانعة‌الجمع هستند.


.SH "گزینه‌ها (OPTIONS)"
\fB--auth-provider\fP=""
	ارائه‌دهنده احراز هویت (auth provider) برای مدخل کاربر در kubeconfig

.PP
\fB--auth-provider-arg\fP=[]
	آرگومان‌های 'key=value' برای ارائه‌دهنده احراز هویت

.PP
\fB--client-certificate\fP=""
	مسیر فایل گواهینامه کلاینت برای مدخل کاربر در kubeconfig

.PP
\fB--client-key\fP=""
	مسیر فایل کلید کلاینت برای مدخل کاربر در kubeconfig

.PP
\fB--embed-certs\fP=false
	جاسازی گواهینامه/کلید کلاینت برای مدخل کاربر در kubeconfig

.PP
\fB--exec-api-version\fP=""
	نسخه API برای افزونه اعتبارسنجی exec در مدخل کاربر در kubeconfig

.PP
\fB--exec-arg\fP=[]
	آرگومان‌های جدید برای دستور افزونه اعتبارسنجی exec در مدخل کاربر در kubeconfig

.PP
\fB--exec-command\fP=""
	دستور برای افزونه اعتبارسنجی exec در مدخل کاربر در kubeconfig

.PP
\fB--exec-env\fP=[]
	مقادیر متغیر محیطی 'key=value' برای افزونه اعتبارسنجی exec

.PP
\fB--exec-interactive-mode\fP=""
	حالت تعاملی (InteractiveMode) افزونه اعتبارسنجی exec برای مدخل کاربر در kubeconfig

.PP
\fB--exec-provide-cluster-info\fP=false
	ویژگی ProvideClusterInfo افزونه اعتبارسنجی exec برای مدخل کاربر در kubeconfig

.PP
\fB--password\fP=""
	رمز عبور برای مدخل کاربر در kubeconfig

.PP
\fB--token\fP=""
	توکن برای مدخل کاربر در kubeconfig

.PP
\fB--username\fP=""
	نام کاربری برای مدخل کاربر در kubeconfig


.SH "گزینه‌های به ارث رسیده از دستورات والد (OPTIONS INHERITED FROM PARENT COMMANDS)"
\fB--as\fP=""
	نام کاربری برای جعل هویت (impersonate) در این عملیات. کاربر می‌تواند یک کاربر معمولی یا یک حساب خدمت (service account) در یک فضای نام باشد.

.PP
\fB--as-group\fP=[]
	گروه برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای تعیین چندین گروه تکرار شود.

.PP
\fB--as-uid\fP=""
	شناسه UID برای جعل هویت در این عملیات.

.PP
\fB--as-user-extra\fP=[]
	اطلاعات اضافی کاربر برای جعل هویت در این عملیات؛ این فلگ می‌تواند برای مشخص کردن چندین مقدار برای یک کلید یکسان تکرار شود.

.PP
\fB--cache-dir\fP="/home/username/.kube/cache"
	دایرکتوری پیش‌فرض کش

.PP
\fB--certificate-authority\fP=""
	مسیر فایل گواهینامه برای مرجع صدور گواهینامه (certificate authority)

.PP
\fB--cluster\fP=""
	نام کلاستر kubeconfig برای استفاده

.PP
\fB--context\fP=""
	نام کانتکست kubeconfig برای استفاده

.PP
\fB--disable-compression\fP=false
	در صورت true بودن، انصراف از فشرده‌سازی پاسخ‌ها برای تمام درخواست‌ها به سرور

.PP
\fB--insecure-skip-tls-verify\fP=false
	در صورت true بودن، اعتبار گواهینامه سرور بررسی نخواهد شد. این کار اتصالات HTTPS شما را ناامن می‌کند

.PP
\fB--kubeconfig\fP=""
	استفاده از یک فایل خاص kubeconfig

.PP
\fB--kuberc\fP=""
	مسیر فایل kuberc برای استفاده در ترجیحات (preferences). این قابلیت می‌تواند با export کردن feature gate به صورت KUBECTL_KUBERC=false یا خاموش کردن ویژگی با KUBERC=off غیرفعال شود.

.PP
\fB--match-server-version\fP=false
	الزام به تطابق نسخه سرور با نسخه کلاینت

.PP
\fB-n\fP, \fB--namespace\fP=""
	در صورت وجود، دامنهٔ فضای نام (namespace) برای این درخواست CLI

.PP
\fB--profile\fP="none"
	نام پروفایل برای ثبت. یکی از موارد (none|cpu|heap|goroutine|threadcreate|block|mutex|trace)

.PP
\fB--profile-output\fP="profile.pprof"
	نام فایلی که پروفایل در آن نوشته می‌شود

.PP
\fB--request-timeout\fP="0"
	مدت زمان انتظار پیش از انصراف از یک درخواست به سرور. مقادیر غیر صفر باید شامل واحد زمانی متناظر باشند (مانند 1s، 2m، 3h). مقدار صفر یعنی درخواست‌ها هرگز دچار وقفه زمانی (timeout) نشوند.

.PP
\fB-s\fP, \fB--server\fP=""
	آدرس و پورت سرور Kubernetes API

.PP
\fB--tls-server-name\fP=""
	نام سرور برای استفاده در اعتبارسنجی گواهینامه سرور. در صورت عدم ارائه، از نام هاست مورد استفاده برای برقراری ارتباط با سرور استفاده می‌شود

.PP
\fB--user\fP=""
	نام کاربر kubeconfig برای استفاده

.PP
\fB--version\fP=false
	گزینه \fB\-\-version\fP یا \fB\-\-version=raw\fP اطلاعات نسخه را چاپ کرده و خارج می‌شود؛ \fB\-\-version=vX.Y.Z...\fP نسخه گزارش‌شده را تنظیم می‌کند

.PP
\fB--warnings-as-errors\fP=false
	در نظر گرفتن هشدارهای دریافتی از سرور به عنوان خطا و خروج با کد وضعیت غیر صفر


.SH "مثال (EXAMPLE)"
.EX
  # فقط تنظیم فیلد "client-key" در مدخل "cluster-admin"،
  # بدون دستکاری سایر مقادیر
  kubectl config set-credentials cluster-admin --client-key=~/.kube/admin.key
  
  # تنظیم احراز هویت پایه برای مدخل "cluster-admin"
  kubectl config set-credentials cluster-admin --username=admin --password=uXFGweU9l35qcif
  
  # جاسازی داده‌های گواهینامه کلاینت در مدخل "cluster-admin"
  kubectl config set-credentials cluster-admin --client-certificate=~/.kube/admin.crt --embed-certs=true
  
  # فعال‌سازی ارائه‌دهنده احراز هویت Google Compute Platform برای مدخل "cluster-admin"
  kubectl config set-credentials cluster-admin --auth-provider=gcp
  
  # فعال‌سازی ارائه‌دهنده احراز هویت OpenID Connect برای مدخل "cluster-admin" با آرگومان‌های اضافی
  kubectl config set-credentials cluster-admin --auth-provider=oidc --auth-provider-arg=client-id=foo --auth-provider-arg=client-secret=bar
  
  # حذف مقدار پیکربندی "client-secret" برای ارائه‌دهنده احراز هویت OpenID Connect در مدخل "cluster-admin"
  kubectl config set-credentials cluster-admin --auth-provider=oidc --auth-provider-arg=client-secret-
  
  # فعال‌سازی افزونه جدید اعتبارسنجی exec برای مدخل "cluster-admin"
  kubectl config set-credentials cluster-admin --exec-command=/path/to/the/executable --exec-api-version=client.authentication.k8s.io/v1beta1
  
  # فعال‌سازی افزونه جدید اعتبارسنجی exec برای مدخل "cluster-admin" در حالت تعاملی
  kubectl config set-credentials cluster-admin --exec-command=/path/to/the/executable --exec-api-version=client.authentication.k8s.io/v1beta1 --exec-interactive-mode=Never
  
  # تعریف آرگومان‌های جدید افزونه اعتبارسنجی exec برای مدخل "cluster-admin"
  kubectl config set-credentials cluster-admin --exec-arg=arg1 --exec-arg=arg2
  
  # ایجاد یا به‌روزرسانی متغیرهای محیطی افزونه اعتبارسنجی exec برای مدخل "cluster-admin"
  kubectl config set-credentials cluster-admin --exec-env=key1=val1 --exec-env=key2=val2
  
  # حذف متغیرهای محیطی افزونه اعتبارسنجی exec برای مدخل "cluster-admin"
  kubectl config set-credentials cluster-admin --exec-env=var-to-remove-
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBkubectl-config(1)\fP


.SH "تاریخچه (HISTORY)"
ژانویه ۲۰۱۵، در ابتدا توسط Eric Paris (eparis at redhat dot com) بر پایه محتوای منبع kubernetes گردآوری شد، اما امید است که از آن زمان به بعد به طور خودکار تولید شده باشند!
