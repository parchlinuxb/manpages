.TH "PARTCLONE\&.RESTORE" "8" "09/07/2026" "partclone.restore" "Partclone User Manual"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------

  .SH "نام (NAME)"
partclone.restore \- بازیابی ایمیج‌های partclone روی یک دستگاه\&.

  .SH "خلاصه دستور (SYNOPSIS)"

    .HP \w'\fBpartclone\&.restore\fR\ 'u

      \fBpartclone\&.restore\fR
       {[\fB\-s\fR\ |\ \fB\-\-source\fR]\ \fIsource\fR}
       {[[\fB\-o\fR\ |\ \fB\-\-output\fR]\ [\fB\-O\fR\ |\ \fB\-\-overwrite\fR]]\ \fItarget\fR}
       [[\fB\-dX\fR\ |\ \fB\-\-debug=X\fR]]
       [[\fB\-\-restore_raw_file\fR]]
       [[\fB\-z\fR\ |\ \fB\-\-buffer_size\fR]]
       [[\fB\-N\fR\ |\ \fB\-\-ncurses\fR]]
       [[\fB\-q\fR\ |\ \fB\-\-quiet\fR]]
       [[\fB\-f\fR\ |\ \fB\-\-UI\-fresh\fR]]
       [[\fB\-F\fR\ |\ \fB\-\-force\fR]]
       [[\fB\-I\fR\ |\ \fB\-\-ignore_fschk\fR]]
       [[\fB\-\-ignore_crc\fR]]
       [[\fB\-C\fR\ |\ \fB\-\-nocheck\fR]]
       [[\fB\-R\fR\ |\ \fB\-\-rescue\fR]]
       [[\fB\-L\fR\ |\ \fB\-\-logfile\fR]\ \fIlogfile\fR]
       [[\fB\-w\fR\ |\ \fB\-\-skip_write_error\fR]]
       [[\fB\-\-write\-direct\-io\fR]]
       [[\fB\-w\fR\ |\ \fB\-\-skip_write_error\fR]]
       [[\fB\-E\fR\ |\ \fB\-\-offset=X\fR]]
       [[\fB\-T\fR\ |\ \fB\-\-btfiles\fR]]
       [[\fB\-t\fR\ |\ \fB\-\-btfiles_torrent\fR]]
       [[\fB\-B\fR\ |\ \fB\-\-no_block_detail\fR]]


  .SH "توضیحات (DESCRIPTION)"

    .PP
\fBpartclone\&.restore\fR
بخشی از پروژه
\fBPartclone\fR
برای بازیابی تمامی ایمیج‌های ساخته‌شده توسط partclone\&.[fstype] یا partclone\&.dd است\&. Partclone ابزارهایی برای پشتیبان‌گیری از بلوک‌های استفاده‌شده فراهم می‌کند و با استفاده از کتابخانه‌های موجود، برای سازگاری بالاتر با سیستم فایل طراحی شده است؛ به عنوان نمونه از e2fslibs برای خواندن بلوک‌های استفاده‌شده پارتیشن ext2 استفاده می‌شود\&.

    .PP
سیستم‌های فایل پشتیبانی‌شده توسط
\fBPartclone\fR
شامل btrfs، ext2، ext3، ext4، reiserfs، reiser4، xfs و jfs برای لینوکس است\&. همچنین از برخی سیستم‌های عامل غیرلینوکسی نیز پشتیبانی می‌کند، مانند: NTFS، FAT، EXFAT (برای ویندوز)، HFS plus (مک‌اواس اپل)، UFS2 (فری‌بی‌اس‌دی)، VMFS (وی‌ام‌ویر وی‌اسفیر)\&.
.PP
تمامی ابزارهای partclone را می‌توان مانند partclone\&.xxx اجرا کرد که بسیار شبیه fsck یا mkfs است\&. برای نمونه، جهت پشتیبان‌گیری/بازیابی hfsplus، کافی است partclone\&.hfsp را اجرا کنید\&.

  .SH "گزینه‌ها (OPTIONS)"

    .PP
این برنامه از نحو معمول خط فرمان گنو پیروی می‌کند که در آن گزینه‌های طولانی با دو خط تیره (`\-\*(Aq) شروع می‌شوند\&. خلاصه‌ای از گزینه‌ها در زیر آمده است\&.

      .PP
\fB\-s \fR\fB\fIFILE\fR\fR, \fB\-\-source \fR\fB\fIFILE\fR\fR
.RS 4

          پرونده مبدأ FILE\&. پرونده FILE بسته به اقدام شما می‌تواند یک فایل ایمیج (ساخته‌شده با partclone) یا یک دستگاه باشد\&. به‌طور معمول، مبدأ پشتیبان‌گیری یک دستگاه است و مبدأ بازیابی، یک فایل ایمیج\&.
.sp

          دریافت داده‌ها از خط لوله (pipeline) تنها برای بازیابی پشتیبانی می‌شود؛ کافی است گزینه \-s را نادیده بگیرید یا از \*(Aq\-\*(Aq برای دریافت داده از ورودی استاندارد (stdin) استفاده کنید\&.

      .RE
      .PP
\fB\-o \fR\fB\fIFILE\fR\fR, \fB\-\-output \fR\fB\fIFILE\fR\fR
.RS 4

          پرونده مقصد FILE\&. پرونده FILE بسته به اقدام شما می‌تواند یک فایل ایمیج (که partclone تولید خواهد کرد) یا یک دستگاه باشد\&. به‌طور معمول، مقصد پشتیبان‌گیری یک فایل ایمیج است و مقصد بازیابی یک دستگاه\&.
.sp

          ارسال داده‌ها به خط لوله (pipeline) نیز تنها برای پشتیبان‌گیری پشتیبانی می‌شود؛ کافی است گزینه \-o را نادیده بگیرید یا از \*(Aq\-\*(Aq برای ارسال داده به خروجی استاندارد (stdout) استفاده کنید\&.

      .RE
      .PP
\fB\-O \fR\fB\fIFILE\fR\fR, \fB\-\-overwrite \fR\fB\fIFILE\fR\fR
.RS 4

          بازنویسی FILE؛ در صورت وجود بازنویسی می‌شود\&.

      .RE
      .PP
\fB\-\-restore_raw_file\fR
.RS 4

          ایجاد فایل خام ویژه برای دستگاه loop\&.

      .RE
      .PP
\fB\-L \fR\fB\fIFILE\fR\fR, \fB\-\-logfile \fR\fB\fIFILE\fR\fR
.RS 4

          تعیین مسیر ویژه برای ثبت اطلاعات لاگ partclone\&. (پیش‌فرض /var/log/partclone\&.log)

      .RE
      .PP
\fB\-R\fR, \fB\-\-rescue\fR
.RS 4

          ادامه دادن پس از خطاهای خواندن دیسک\&.

      .RE
      .PP
\fB\-C\fR, \fB\-\-no_check\fR
.RS 4

          عدم بررسی اندازه دستگاه و فضای خالی\&.

      .RE
      .PP
\fB\-N\fR, \fB\-\-ncurses\fR
.RS 4

          استفاده از رابط کاربری متنی Ncurses\&.

      .RE
       .PP
\fB\-X\fR, \fB\-\-dialog\fR
.RS 4

          خروجی پیام‌ها در قالب دایالوگ (Dialog Format)\&.

      .RE
       .PP
\fB\-I\fR, \fB\-\-ignore_fschk\fR
.RS 4

          نادیده گرفتن بررسی سیستم فایل\&.

      .RE
       .PP
\fB\-\-ignore_crc\fR
.RS 4

          نادیده گرفتن خطای بررسی crc\&.

      .RE
       .PP
\fB\-F\fR, \fB\-\-force\fR
.RS 4

          اجبار به ادامه فرآیند\&.

      .RE
       .PP
\fB\-f \fR\fB\fIsec\fR\fR, \fB\-\-UI\-fresh \fR\fB\fIsec\fR\fR
.RS 4

          تعیین ثانیه مشخص برای فاصله به‌روزرسانی رابط کاربری\&.

      .RE
       .PP
\fB\-z \fR\fB\fIsize\fR\fR, \fB\-\-buffer_size \fR\fB\fIsize\fR\fR
.RS 4

          اندازه بافر خواندن/نوشتن (پیش‌فرض: 1048576)

      .RE
       .PP
\fB\-q\fR, \fB\-\-quiet\fR
.RS 4

          غیرفعال کردن پیام‌های پیشرفت\&.

      .RE
       .PP
\fB\-d\fR\fB\fIlevel\fR\fR, \fB\-\-debug \fR\fB\fIlevel\fR\fR
.RS 4

          تنظیم سطح اشکال‌زدایی [1|2|3]

      .RE
      .PP
\fB\-h\fR, \fB\-\-help\fR
.RS 4

          نمایش خلاصه گزینه‌ها\&.

      .RE
      .PP
\fB\-v\fR, \fB\-\-version\fR
.RS 4

          نمایش نسخه برنامه\&.

      .RE

  .SH "فایل‌ها (FILES)"

      .PP
/var/log/partclone\&.log
.RS 4

          پرونده لاگ
partclone\&.restore

      .RE

  .SH "مثال‌ها (EXAMPLES)"

.sp
.if n \{\
.RS 4
.\}
.nf
 بازیابی /dev/hda1 از hda1\&.img و نمایش اطلاعات اشکال‌زدایی:
  partclone\&.restore \-d \-s hda1\&.img \-o /dev/hda1

 بازیابی ایمیج از clonezilla (چندبخشی، gzip) با مبدأ ورودی استاندارد (stdin):
  cat  sda1\&.ext3\-ptcl\-img\&.gz\&.a*  | gunzip \-c | partclone\&.restore \-d \-s \- \-o /dev/sda1

 بازیابی ایمیج خام از partclone\&.dd:
  partclone\&.dd  \-d  \-c  \-s  /dev/sda1  \-o  \- | partclone\&.restore \-d \-s \- \-o /dev/sdb1

.fi
.if n \{\
.RE
.\}
.sp

  .SH "پیام‌های تشخیصی (DIAGNOSTICS)"

    .PP
پیام‌های تشخیصی زیر ممکن است در
stderr
صادر شوند:

    .PP
\fBpartclone\&.restore\fR
کدهای بازگشتی زیر را ارائه می‌دهد که می‌توان از آن‌ها در اسکریپت‌ها استفاده کرد:

    .\" line length increase to cope w/ tbl weirdness
.ll +(\n(LLu * 62u / 100u)
.TS
ll.
\fICode\fR	\fIDiagnostic\fR

        T{
\fB0\fR
T}
        T{
برنامه با موفقیت خارج شد\&.
T}

        T{
\fB1\fR
T}
        T{
فرآیند کلون یا بازیابی ناموفق به نظر می‌رسد\&.
T}

    .TE
.\" line length decrease back to previous value
.ll -(\n(LLu * 62u / 100u)
.sp

