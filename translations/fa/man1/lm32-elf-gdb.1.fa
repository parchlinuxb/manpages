.\" Set up some character translations and predefined strings.  \*(-- will
.\" give an unbreakable dash, \*(PI will give pi, \*(L" will give a left
.\" double quote, and \*(R" will give a right double quote.  \*(C+ will
.\" give a nicer C++.  Capital omega is used to do unbreakable dashes and
.\" therefore won't be available.  \*(C` and \*(C' expand to `' in nroff,
.\" nothing in troff, for use with C<>.
.tr \(*W-
.ds C+ C\v'-.1v'\h'-1p'\s-2+\h'-1p'+\s0\v'.1v'\h'-1p'
.ie n \{\
.    ds -- \(*W-
.    ds PI pi
.    if (\n(.H=4u)&(1m=24u) .ds -- \(*W\h'-12u'\(*W\h'-12u'-\" diablo 10 pitch
.    if (\n(.H=4u)&(1m=20u) .ds -- \(*W\h'-12u'\(*W\h'-8u'-\"  diablo 12 pitch
.    ds L" ""
.    ds R" ""
.    ds C` ""
.    ds C' ""
'br\}
.el\{\
.    ds -- \|\(em\|
.    ds PI \(*p
.    ds L" ``
.    ds R" ''
.    ds C`
.    ds C'
'br\}
.\"
.\" Escape single quotes in literal strings from groff's Unicode transform.
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\"
.\" If the F register is >0, we'll generate index entries on stderr for
.\" titles (.TH), headers (.SH), subsections (.SS), items (.Ip), and index
.\" entries marked with X<> in POD.  Of course, you'll have to process the
.\" output yourself in some meaningful fashion.
.\"
.\" Avoid warning from groff about undefined register 'F'.
.de IX
..
.nr rF 0
.if \n(.g .if rF .nr rF 1
.if (\n(rF:(\n(.g==0)) \{\
.    if \nF \{\
.        de IX
.        tm Index:\\$1\t\\n%\t"\\$2"
..
.        if !\nF==2 \{\
.            nr % 0
.            nr F 2
.        \}
.    \}
.\}
.rr rF
.\"
.\" Accent mark definitions (@(#)ms.acc 1.5 88/02/08 SMI; from UCB 4.2).
.\" Fear.  Run.  Save yourself.  No user-serviceable parts.
.    \" fudge factors for nroff and troff
.if n \{\
.    ds #H 0
.    ds #V .8m
.    ds #F .3m
.    ds #[ \f1
.    ds #] \fP
.\}
.if t \{\
.    ds #H ((1u-(\\\\n(.fu%2u))*.13m)
.    ds #V .6m
.    ds #F 0
.    ds #[ \&
.    ds #] \&
.\}
.    \" simple accents for nroff and troff
.if n \{\
.    ds ' \&
.    ds ` \&
.    ds ^ \&
.    ds , \&
.    ds ~ ~
.    ds /
.\}
.if t \{\
.    ds ' \\k:\h'-(\\n(.wu*8/10-\*(#H)'\'\h"|\\n:u"
.    ds ` \\k:\h'-(\\n(.wu*8/10-\*(#H)'\`\h'|\\n:u'
.    ds ^ \\k:\h'-(\\n(.wu*10/11-\*(#H)'^\h'|\\n:u'
.    ds , \\k:\h'-(\\n(.wu*8/10)',\h'|\\n:u'
.    ds ~ \\k:\h'-(\\n(.wu-\*(#H-.1m)'~\h'|\\n:u'
.    ds / \\k:\h'-(\\n(.wu*8/10-\*(#H)'\z\(sl\h'|\\n:u'
.\}
.    \" troff and (daisy-wheel) nroff accents
.ds : \\k:\h'-(\\n(.wu*8/10-\*(#H+.1m+\*(#F)'\v'-\*(#V'\z.\h'.2m+\*(#F'.\h'|\\n:u'\v'\*(#V'
.ds 8 \h'\*(#H'\(*b\h'-\*(#H'
.ds o \\k:\h'-(\\n(.wu+\w'\(de'u-\*(#H)/2u'\v'-.3n'\*(#[\z\(de\v'.3n'\h'|\\n:u'\*(#]
.ds d- \h'\*(#H'\(pd\h'-\w'~'u'\v'-.25m'\f2\(hy\fP\v'.25m'\h'-\*(#H'
.ds D- D\\k:\h'-\w'D'u'\v'-.11m'\z\(hy\v'.11m'\h'|\\n:u'
.ds th \*(#[\v'.3m'\s+1I\s-1\v'-.3m'\h'-(\w'I'u*2/3)'\s-1o\s+1\*(#]
.ds Th \*(#[\s+2I\s-2\h'-\w'I'u*3/5'\v'-.3m'o\v'.3m'\*(#]
.ds ae a\h'-(\w'a'u*4/10)'e
.ds Ae A\h'-(\w'A'u*4/10)'E
.    \" corrections for vroff
.if v .ds ~ \\k:\h'-(\\n(.wu*9/10-\*(#H)'\s-2\u~\d\s+2\h'|\\n:u'
.if v .ds ^ \\k:\h'-(\\n(.wu*10/11-\*(#H)'\v'-.4m'^\v'.4m'\h'|\\n:u'
.    \" for low resolution devices (crt and lpr)
.if \n(.H>23 .if \n(.V>19 \
\{\
.    ds : e
.    ds 8 ss
.    ds o a
.    ds d- d\h'-1'\(ga
.    ds D- D\h'-1'\(hy
.    ds th \o'bp'
.    ds Th \o'LP'
.    ds ae ae
.    ds Ae AE
.\}
.rm #[ #] #H #V #F C
.\" ========================================================================
.\"
.IX Title "GDB 1"
.TH GDB 1 "2025-12-20" "gdb-17.1" "GNU Development Tools"
.\" For nroff, turn off justification.  Always turn off hyphenation; it makes
.\" way too many mistakes in technical documents.
.if n .ad l
.nh
.SH "نام (NAME)"
lm32-elf-gdb \- اشکال‌زدای گنو (The GNU Debugger)
.SH "خلاصه دستور (SYNOPSIS)"
.IX Header "SYNOPSIS"
gdb [\s-1OPTIONS\s0] [\fIprog\fR|\fIprog\fR \fIprocID\fR|\fIprog\fR \fIcore\fR]
.SH "توضیحات (DESCRIPTION)"
.IX Header "DESCRIPTION"
هدف از یک اشکال‌زدا مانند \s-1GDB\s0 این است که به شما امکان دهد ببینید در حین اجرای یک برنامه دیگر، در «درون» آن چه می‌گذرد \-\- یا این‌که آن برنامه در لحظه از کار افتادن (crash) مشغول انجام چه کاری بوده است.
.PP
ابزار \s-1GDB\s0 می‌تواند چهار کارکرد اصلی (به همراه موارد دیگر در پشتیبانی از آن‌ها) را برای کمک به شما در به دام انداختن باگ‌ها در حین وقوع انجام دهد:
.IP "\(bu" 4
اجرای برنامه شما با تعیین هر آنچه ممکن است بر رفتار آن اثر بگذارد.
.IP "\(bu" 4
متوقف ساختن برنامه تحت شرایط تعیین‌شده.
.IP "\(bu" 4
بررسی آنچه رخ داده است، هنگامی که برنامه شما متوقف شده باشد.
.IP "\(bu" 4
تغییر چیزهایی درون برنامه شما، به گونه‌ای که بتوانید اثر اصلاح یک باگ را بیازمایید و سپس به سراغ باگ دیگر بروید.
.PP
می‌توانید از \s-1GDB\s0 برای اشکال‌زدایی برنامه‌های نوشته‌شده به زبان‌های C، \*(C+، Fortran و Modula\-2 استفاده کنید.
.PP
ابزار \s-1GDB\s0 با دستور پوسته \f(CW\*(C`gdb\*(C'\fR فراخوانی می‌شود. پس از راه‌اندازی، دستورات را از ترمینال می‌خواند تا زمانی که با دستور \f(CW\*(C`quit\*(C'\fR یا \f(CW\*(C`exit\*(C'\fR در \s-1GDB\s0 فرمان خروج به آن بدهید. می‌توانید با استفاده از دستور \f(CW\*(C`help\*(C'\fR از راهنمای برخطِ خودِ \s-1GDB\s0 کمک بگیرید.
.PP
شما می‌توانید \f(CW\*(C`gdb\*(C'\fR را بدون هیچ آرگومان یا گزینه‌ای اجرا کنید؛ اما معمول‌ترین شیوه شروع \s-1GDB\s0 با یک یا دو آرگومان است که در آن یک برنامه اجرایی به عنوان آرگومان مشخص می‌شود:
.PP
.Vb 1
\&        gdb program
.Ve
.PP
همچنین می‌توانید کار را با مشخص کردن همزمان یک برنامه اجرایی و یک فایل core آغاز کنید:
.PP
.Vb 1
\&        gdb program core
.Ve
.PP
اگر می‌خواهید یک پردازش در حال اجرا را اشکال‌زدایی کنید، می‌توانید به جای آن یک شناسه پردازش (\s-1ID\s0) را به عنوان آرگومان دوم تعیین کرده یا از گزینه
\&\f(CW\*(C`\-p\*(C'\fR
استفاده کنید:
.PP
.Vb 2
\&        gdb program 1234
\&        gdb \-p 1234
.Ve
.PP
که این کار \s-1GDB\s0 را به پردازش \f(CW1234\fR متصل (attach) می‌کند. با استفاده از گزینه
.B \-p
می‌توانید نام فایل \fIprogram\fR را نادیده بگیرید.
.PP
در اینجا برخی از پرکاربردترین دستورات \s-1GDB\s0 آورده شده است:
.IP "\fBbreak [\fR\fIfile\fR\fB:][\fR\fIfunction\fR\fB|\fR\fIline\fR\fB]\fR" 4
.IX Item "break [file:][function|line]"
تنظیم نقطه توقف (breakpoint) در \fIfunction\fR یا \fIline\fR (در \fIfile\fR).
.IP "\fBrun [\fR\fIarglist\fR\fB]\fR" 4
.IX Item "run [arglist]"
شروع اجرای برنامه شما (همراه با \fIarglist\fR، در صورت مشخص شدن).
.IP "\fBbt\fR" 4
.IX Item "bt"
ردیابی پشته (Backtrace): نمایش پشته فراخوانی برنامه.
.IP "\fBprint\fR \fIexpr\fR" 4
.IX Item "print expr"
نمایش مقدار عبارت \fIexpr\fR.
.IP "\fBc\fR" 4
.IX Item "c"
ادامه اجرای برنامه شما (پس از توقف، برای نمونه در یک نقطه توقف).
.IP "\fBnext\fR" 4
.IX Item "next"
اجرای خط بعدی برنامه (پس از توقف)؛ رد شدن از روی هرگونه فراخوانی تابع در آن خط (\fIover\fR).
.IP "\fBedit [\fR\fIfile\fR\fB:]\fR\fIfunction\fR" 4
.IX Item "edit [file:]function"
مشاهده خطی از برنامه که هم‌اکنون در آن متوقف شده است.
.IP "\fBlist [\fR\fIfile\fR\fB:]\fR\fIfunction\fR" 4
.IX Item "list [file:]function"
چاپ متن کد برنامه در مجاورت نقطه‌ای که هم‌اکنون در آن متوقف شده است.
.IP "\fBstep\fR" 4
.IX Item "step"
اجرای خط بعدی برنامه (پس از توقف)؛ ورود به درون هر فراخوانی تابع در آن خط (\fIinto\fR).
.IP "\fBhelp [\fR\fIname\fR\fB]\fR" 4
.IX Item "help [name]"
نمایش اطلاعات درباره دستور \fIname\fR در \s-1GDB\s0، یا اطلاعات کلی درباره شیوه استفاده از \s-1GDB.\s0
.IP "\fBquit\fR" 4
.IX Item "quit"
.PD 0
.IP "\fBexit\fR" 4
.IX Item "exit"
.PD
خروج از \s-1GDB.\s0
.PP
برای مطالعه جزئیات کامل پیرامون \s-1GDB\s0، کتاب
\fIUsing \s-1GDB: A\s0 Guide to the \s-1GNU\s0 Source-Level Debugger\fR
اثر ریچارد ام. استالمن (Richard M. Stallman) و رولند اچ. پش (Roland H. Pesch) را ببینید. همین متن به صورت برخط در قالب مدخل \f(CW\*(C`gdb\*(C'\fR در برنامه \f(CW\*(C`info\*(C'\fR نیز در دسترس است.
.SH "گزینه‌ها (OPTIONS)"
.IX Header "OPTIONS"
هر آرگومانی غیر از گزینه‌ها، یک فایل اجرایی و فایل core (یا شناسه پردازش \s-1ID\s0) را مشخص می‌کند؛ یعنی نخستین آرگومان یافت‌شده بدون گزینه، معادل گزینه
.B \-\-se
است، و آرگومان دوم (در صورت وجود)، چنانچه نام یک فایل باشد، معادل گزینه
.B \-c
خواهد بود. بسیاری از گزینه‌ها دارای هر دو شکل بلند و کوتاه هستند؛ هر دو شکل در اینجا نشان داده شده‌اند. شکل‌های بلند در صورتی که به اندازه کافی خلاصه شوند تا نامبهم و یکتا باشند نیز شناخته می‌شوند.
.PP
شکل‌های کوتاه در اینجا با
.B \-
و شکل‌های بلند با
.B \-\-
نشان داده شده‌اند تا چگونگی نمایش آن‌ها در
.B \-\-help
منعکس شود. با این حال، \s-1GDB\s0 تمامی قواعد زیر را برای اغلب گزینه‌ها به رسمیت می‌شناسد:
.ie n .IP """\-\-option=\fIvalue\fP""" 4
.el .IP "\f(CW\-\-option=\f(CIvalue\f(CW\fR" 4
.IX Item "--option=value"
.PD 0
.ie n .IP """\-\-option \fIvalue\fP""" 4
.el .IP "\f(CW\-\-option \f(CIvalue\f(CW\fR" 4
.IX Item "--option value"
.ie n .IP """\-option=\fIvalue\fP""" 4
.el .IP "\f(CW\-option=\f(CIvalue\f(CW\fR" 4
.IX Item "-option=value"
.ie n .IP """\-option \fIvalue\fP""" 4
.el .IP "\f(CW\-option \f(CIvalue\f(CW\fR" 4
.IX Item "-option value"
.ie n .IP """\-\-o=\fIvalue\fP""" 4
.el .IP "\f(CW\-\-o=\f(CIvalue\f(CW\fR" 4
.IX Item "--o=value"
.ie n .IP """\-\-o \fIvalue\fP""" 4
.el .IP "\f(CW\-\-o \f(CIvalue\f(CW\fR" 4
.IX Item "--o value"
.ie n .IP """\-o=\fIvalue\fP""" 4
.el .IP "\f(CW\-o=\f(CIvalue\f(CW\fR" 4
.IX Item "-o=value"
.ie n .IP """\-o \fIvalue\fP""" 4
.el .IP "\f(CW\-o \f(CIvalue\f(CW\fR" 4
.IX Item "-o value"
.PD
.PP
تمامی گزینه‌ها و آرگومان‌های خط فرمان که وارد می‌کنید به ترتیب متوالی پردازش می‌شوند. این ترتیب زمانی که از گزینه
.B \-x
استفاده می‌شود دارای اهمیت است.
.IP "\fB\-\-help\fR" 4
.IX Item "--help"
.PD 0
.IP "\fB\-h\fR" 4
.IX Item "-h"
.PD
فهرست کردن تمامی گزینه‌ها همراه با توضیحات کوتاه.
.IP "\fB\-\-symbols=\fR\fIfile\fR" 4
.IX Item "--symbols=file"
.PD 0
.IP "\fB\-s\fR \fIfile\fR" 4
.IX Item "-s file"
.PD
خواندن جدول نمادها (symbol table) از \fIfile\fR.
.IP "\fB\-\-write\fR" 4
.IX Item "--write"
فعال‌سازی امکان نوشتن درون فایل‌های اجرایی و فایل‌های core.
.IP "\fB\-\-exec=\fR\fIfile\fR" 4
.IX Item "--exec=file"
.PD 0
.IP "\fB\-e\fR \fIfile\fR" 4
.IX Item "-e file"
.PD
استفاده از \fIfile\fR به عنوان فایل اجرایی جهت اجرا در صورت لزوم، و همچنین برای بررسی داده‌های خالص در ارتباط با یک فایل core dump.
.IP "\fB\-\-se=\fR\fIfile\fR" 4
.IX Item "--se=file"
خواندن جدول نمادها از \fIfile\fR و استفاده از آن به عنوان فایل اجرایی.
.IP "\fB\-\-core=\fR\fIfile\fR" 4
.IX Item "--core=file"
.PD 0
.IP "\fB\-c\fR \fIfile\fR" 4
.IX Item "-c file"
.PD
استفاده از \fIfile\fR به عنوان یک core dump جهت بررسی.
.IP "\fB\-\-command=\fR\fIfile\fR" 4
.IX Item "--command=file"
.PD 0
.IP "\fB\-x\fR \fIfile\fR" 4
.IX Item "-x file"
.PD
اجرای دستورات \s-1GDB\s0 از داخل \fIfile\fR.
.IP "\fB\-\-eval\-command=\fR\fIcommand\fR" 4
.IX Item "--eval-command=command"
.PD 0
.IP "\fB\-ex\fR \fIcommand\fR" 4
.IX Item "-ex command"
.PD
اجرای دستور مشخص‌شده (\fIcommand\fR) در \s-1GDB.\s0
.IP "\fB\-\-init\-eval\-command=\fR\fIcommand\fR" 4
.IX Item "--init-eval-command=command"
.PD 0
.IP "\fB\-iex\fR" 4
.IX Item "-iex"
.PD
اجرای دستور مشخص‌شده (\fIcommand\fR) در \s-1GDB\s0 پیش از بارگذاری برنامه فرعی و تحت بررسی (inferior).
.IP "\fB\-\-directory=\fR\fIdirectory\fR" 4
.IX Item "--directory=directory"
.PD 0
.IP "\fB\-d\fR \fIdirectory\fR" 4
.IX Item "-d directory"
.PD
افزودن \fIdirectory\fR به مسیر جستجوی فایل‌های منبع (source files).
.IP "\fB\-\-nh\fR" 4
.IX Item "--nh"
عدم اجرای دستورات از
\&\fI~/.config/gdb/gdbinit\fR،
\&\fI~/.gdbinit\fR،
\&\fI~/.config/gdb/gdbearlyinit\fR
یا
\&\fI~/.gdbearlyinit\fR.
.IP "\fB\-\-nx\fR" 4
.IX Item "--nx"
.PD 0
.IP "\fB\-n\fR" 4
.IX Item "-n"
.PD
عدم اجرای دستورات از هیچ‌یک از فایل‌های راه‌اندازی
\&\fI.gdbinit\fR
یا
\&\fI.gdbearlyinit\fR.
.IP "\fB\-\-quiet\fR" 4
.IX Item "--quiet"
.PD 0
.IP "\fB\-\-silent\fR" 4
.IX Item "--silent"
.IP "\fB\-q\fR" 4
.IX Item "-q"
.PD
حالت «بی‌صدا» (Quiet). عدم چاپ پیام‌های مقدماتی و حق نشر. این پیام‌ها در حالت دسته‌ای (batch mode) نیز نمایش داده نمی‌شوند.
.IP "\fB\-\-batch\fR" 4
.IX Item "--batch"
اجرا در حالت دسته‌ای (batch mode). پس از پردازش تمام فایل‌های دستوری تعیین‌شده با
.B \-x
(و فایل
\&\fI.gdbinit\fR
در صورت مهار نشدن) با وضعیت \f(CW0\fR خارج می‌شود. در صورت وقوع خطا در اجرای دستورات \s-1GDB\s0 درون فایل‌های دستوری، با وضعیتی غیرصفر خارج می‌شود.
.Sp
حالت دسته‌ای می‌تواند برای اجرای \s-1GDB\s0 به عنوان یک فیلتر مفید باشد، برای نمونه جهت دریافت و اجرای یک برنامه روی رایانه‌ای دیگر؛ به منظور کاربردی‌تر ساختن این امر، پیام
.Sp
.Vb 1
\&        Program exited normally.
.Ve
.Sp
(که معمولاً هر زمان برنامه‌ای تحت کنترل \s-1GDB\s0 خاتمه می‌یابد صادر می‌شود) هنگام اجرا در حالت دسته‌ای صادر نمی‌گردد.
.IP "\fB\-\-batch\-silent\fR" 4
.IX Item "--batch-silent"
اجرا در حالت دسته‌ای، دقیقاً مانند
.BR \-\-batch ،
اما کاملاً بی‌صدا. تمامی خروجی‌های \s-1GDB\s0 مهار می‌شوند (خروجی stderr دست‌نخورده باقی می‌ماند). این گزینه بسیار ساکت‌تر از
.B \-\-silent
بوده و برای یک نشست تعاملی بلااستفاده خواهد بود.
.Sp
این گزینه به ویژه هنگام استفاده از مقصدهایی (targets) که برای نمونه پیام‌های \fBLoading section\fR چاپ می‌کنند مفید است.
.Sp
توجه داشته باشید مقصدهایی که خروجی خود را به جای نوشتن مستقیم در \f(CW\*(C`stdout\*(C'\fR از طریق \s-1GDB\s0 ارائه می‌دهند نیز بی‌صدا خواهند شد.
.IP "\fB\-\-args\fR \fIprog\fR \fB[\fR\fIarglist\fR\fB]\fR" 4
.IX Item "--args prog [arglist]"
تغییر تفسیر خط فرمان به گونه‌ای که آرگومان‌های پس از این گزینه، به عنوان آرگومان به برنامه تحت بررسی (inferior) ارسال شوند. به عنوان مثال، دستور زیر را در نظر بگیرید:
.Sp
.Vb 1
\&        gdb ./a.out \-q
.Ve
.Sp
این دستور \s-1GDB\s0 را با
.B \-q
شروع می‌کند و پیام مقدماتی را چاپ نمی‌نماید. از سوی دیگر، استفاده از:
.Sp
.Vb 1
\&        gdb \-\-args ./a.out \-q
.Ve
.Sp
ابزار \s-1GDB\s0 را همراه با پیام مقدماتی اجرا کرده و گزینه را به برنامه تحت بررسی منتقل می‌سازد.
.IP "\fB\-\-pid=\fR\fIpid\fR" 4
.IX Item "--pid=pid"
اتصال \s-1GDB\s0 به یک برنامه از پیش در حال اجرا، با شناسه پردازش (\s-1PID\s0) \fIpid\fR.
.IP "\fB\-\-tui\fR" 4
.IX Item "--tui"
باز کردن رابط کاربری متنی ترمینال (Terminal User Interface).
.IP "\fB\-\-readnow\fR" 4
.IX Item "--readnow"
خواندن تمامی نمادها از فایل نمادهای مشخص‌شده در همان نخستین دسترسی.
.IP "\fB\-\-readnever\fR" 4
.IX Item "--readnever"
عدم خواندن فایل‌های نماد.
.IP "\fB\-\-return\-child\-result\fR" 4
.IX Item "--return-child-result"
کد خروج \s-1GDB\s0 همانند کد خروج فرزند (پردازش زیردست) خواهد بود.
.IP "\fB\-\-configuration\fR" 4
.IX Item "--configuration"
چاپ جزئیات مربوط به پیکربندی \s-1GDB\s0 و سپس خروج.
.IP "\fB\-\-version\fR" 4
.IX Item "--version"
چاپ اطلاعات نسخه و سپس خروج.
.IP "\fB\-\-cd=\fR\fIdirectory\fR" 4
.IX Item "--cd=directory"
اجرای \s-1GDB\s0 با استفاده از \fIdirectory\fR به عنوان دایرکتوری کاری، به جای دایرکتوری جاری.
.IP "\fB\-\-data\-directory=\fR\fIdirectory\fR" 4
.IX Item "--data-directory=directory"
.PD 0
.IP "\fB\-D\fR" 4
.IX Item "-D"
.PD
اجرای \s-1GDB\s0 با استفاده از \fIdirectory\fR به عنوان دایرکتوری داده‌های آن. دایرکتوری داده جایی است که \s-1GDB\s0 فایل‌های کمکی خود را در آن جستجو می‌کند.
.IP "\fB\-\-fullname\fR" 4
.IX Item "--fullname"
.PD 0
.IP "\fB\-f\fR" 4
.IX Item "-f"
.PD
ویرایشگر Emacs هنگام اجرای \s-1GDB\s0 به عنوان یک زیرپردازش این گزینه را تنظیم می‌کند. این گزینه به \s-1GDB\s0 می‌گوید هر بار که یک فریم پشته نمایش داده می‌شود (که شامل هر بار توقف برنامه نیز می‌شود)، نام کامل فایل و شماره خط را در قالبی استاندارد و قابل تشخیص خروجی دهد. این قالب قابل تشخیص شبیه دو کاراکتر \fB\e032\fR است که پس از آن‌ها نام فایل، شماره خط و موقعیت کاراکتر که با دونقطه جدا شده‌اند، و سپس یک خط جدید می‌آید. برنامه رابط Emacs-to-GDB از این دو کاراکتر \fB\e032\fR به عنوان نشانه‌ای برای نمایش کد منبع آن فریم استفاده می‌کند.
.IP "\fB\-b\fR \fIbaudrate\fR" 4
.IX Item "-b baudrate"
تنظیم سرعت خط (نرخ باد یا بیت در ثانیه) برای هر رابط سریالی که توسط \s-1GDB\s0 جهت اشکال‌زدایی از راه دور استفاده می‌شود.
.IP "\fB\-l\fR \fItimeout\fR" 4
.IX Item "-l timeout"
تنظیم مهلت زمانی (timeout)، بر حسب ثانیه، برای اشکال‌زدایی از راه دور.
.IP "\fB\-\-tty=\fR\fIdevice\fR" 4
.IX Item "--tty=device"
اجرا با استفاده از \fIdevice\fR برای ورودی و خروجی استاندارد برنامه شما.
.SH "محیط (ENVIRONMENT)"
.IX Header "ENVIRONMENT"
.SH "همچنین ببینید (SEE ALSO)"
.IX Header "SEE ALSO"
مستندات کامل \s-1GDB\s0 در قالب یک کتابچه راهنمای Texinfo نگهداری می‌شود. اگر برنامه‌های \f(CW\*(C`info\*(C'\fR و \f(CW\*(C`gdb\*(C'\fR و مستندات Texinfo مربوط به \s-1GDB\s0 به درستی روی سیستم شما نصب شده باشند، اجرای دستور
.PP
.Vb 1
\&        info gdb
.Ve
.PP
باید دسترسی شما به کتابچه کامل راهنما را فراهم سازد.
.PP
\&\fIUsing \s-1GDB: A\s0 Guide to the \s-1GNU\s0 Source-Level Debugger\fR,
Richard M. Stallman and Roland H. Pesch, July 1991.
