.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
trace-cmd-mem \- نمایش مصرف حافظه در رویدادهای مشخص kmem
.SH "خلاصه دستور (SYNOPSIS)"
.sp
\fBtrace\-cmd mem\fR [\fIOPTIONS\fR][\fIinput\-file\fR]
.SH "توضیحات (DESCRIPTION)"
.sp
دستور \fBtrace\-cmd\fR(1) \fBmem\fR نیازمند اجرای \fBtrace\-cmd record\fR با فعال‌سازی رویدادهای زیر است:
.sp
.if n \{\
.RS 4
.\}
.nf
kmalloc
kmalloc_node
kfree
kmem_cache_alloc
kmem_cache_alloc_node
kmem_cache_alloc_free
.fi
.if n \{\
.RE
.\}
.sp
سپس مقدار درخواست‌شده و مقدار آزادشده و همچنین توابعی را که تخصیص حافظه را فراخوانی کرده‌اند می‌خواند\&. پس از آن، مقدار نهایی بایت‌های درخواست‌شده و تخصیص‌یافته را همراه با مقدار کل تخصیص‌یافته و درخواست‌شده، و همچنین حداکثر میزان تخصیص و درخواست در طول اجرا گزارش می‌کند\&. این دستور مقدار بایت‌های هدررفته (تخصیص‌یافته \- درخواست‌شده) که آزاد نشده‌اند و همچنین بیشترین مقدار هدررفت در طول اجرا را گزارش می‌دهد\&. این فهرست بر اساس بایت‌های هدررفته پس از اجرا، به‌صورت نزولی مرتب می‌شود\&.
.sp
.if n \{\
.RS 4
.\}
.nf
        Function                Waste   Alloc   req             TotAlloc     TotReq             MaxAlloc     MaxReq     MaxWaste
        \-\-\-\-\-\-\-\-                \-\-\-\-\-   \-\-\-\-\-   \-\-\-             \-\-\-\-\-\-\-\-     \-\-\-\-\-\-             \-\-\-\-\-\-\-\-     \-\-\-\-\-\-     \-\-\-\-\-\-\-\-
  rb_allocate_cpu_buffer        768     2304    1536                2304       1536                 2304       1536     768
         alloc_pipe_info        400     1152    752                 1152        752                 1152        752     400
          instance_mkdir        252     544     292                  544        292                  544        292     252
               __d_alloc        215     1086560 1086345          1087208    1086993              1086560    1086345     215
          get_empty_filp        72      2304    2232                4864       4712                 4864       4712     152
                mm_alloc        40      960     920                  960        920                  960        920     40
           prepare_creds        32      192     160                 1728       1440                 1728       1440     288
    tracing_buffers_open        8       32      24                    32         24                   32         24     8
                  do_brk        0       0       0                    368        368                  368        368     0
journal_add_journal_head        0       6048    6048                6048       6048                 6048       6048     0
           journal_start        0       0       0                   1224       1224                   48         48     0
     __rb_allocate_pages        0       3289856 3289856          3289856    3289856              3289856    3289856     0
          anon_vma_alloc        0       0       0                    936        936                  864        864     0
                                                        [\&.\&.\&.]
.fi
.if n \{\
.RE
.\}
.SH "گزینه‌ها (OPTIONS)"
.PP
\fB\-i\fR \fIinput\-file\fR
.RS 4
به‌طور پیش‌فرض، trace\-cmd hist فایل
\fItrace\&.dat\fR
را می‌خواند\&. اما گزینهٔ
\fB\-i\fR
به‌جای آن،
\fIinput\-file\fR
داده‌شده را باز می‌کند\&. توجه داشته باشید که فایل ورودی را می‌توان به‌عنوان آخرین مورد در خط فرمان نیز مشخص کرد\&.
.RE
.SH "همچنین ببینید (SEE ALSO)"
.sp
trace\-cmd(1), trace\-cmd\-record(1), trace\-cmd\-report(1), trace\-cmd\-start(1), trace\-cmd\-stop(1), trace\-cmd\-extract(1), trace\-cmd\-reset(1), trace\-cmd\-hist(1), trace\-cmd\-split(1), trace\-cmd\-listen(1)
