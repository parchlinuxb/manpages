.TH man 1 "2026-06-08" "0.18.2" "Profanity XMPP client"

.SH "نام (NAME)"
/alias

.SH "توضیحات (DESCRIPTION)"
Add, remove or list command aliases.

.SH "خلاصه دستور (SYNOPSIS)"
/alias list

.LP
/alias add <name> <value>

.LP
/alias remove <name>

.LP

.SH ARGUMENTS
.PP
\fBlist\fR
.RS 4
List all aliases.
.RE
.PP
\fBadd <name> <value>\fR
.RS 4
Add a new command alias. The alias name must not contain any space characters.
.RE
.PP
\fBremove <name>\fR
.RS 4
Remove a command alias.
.RE

.SH "مثال‌ها (EXAMPLES)"
/alias add friends /who online friends

.LP
/alias add /q /quit

.LP
/alias add urg /msg odin@valhalla.edda [URGENT]

.LP
/alias add afk /status set away "Away From Keyboard"

.LP
/alias remove q

.LP
/alias list

.LP
