.\" Pipe this output to groff -m man -K utf8 -T utf8 | less -R
.\"
.mso an.tmac
.TH "DUNE-SHOW" 1 "" "Dune 3.24.2" "Dune Manual"
.\" Disable hyphenation and ragged-right
.nh
.ad l
.SH "نام (NAME)"
dune-show \- گروه دستوری برای نمایش اطلاعات درباره فضای کاری
.SH "خلاصه دستور (SYNOPSIS)"
.P
\fBdune show\fR \fICOMMAND\fR …
.SH "دستورها (COMMANDS)"
.TP 4
\fBaliases\fR [\fIOPTION\fR]… [\fIDIR\fR]…
چاپ نام‌های مستعار در یک دایرکتوری مشخص\N'46' عملکردی مشابه ls دارد\N'46'
.TP 4
\fBcontexts\fR [\fIOPTION\fR]…
فهرست کردن زمینه‌های ساخت موجود در فضای کاری\N'46'
.TP 4
\fBdepexts\fR [\fIOPTION\fR]…
چاپ فهرست تمام depextهای موجود\N'46'
.TP 4
\fBenv\fR [\fIOPTION\fR]… [\fIPATH\fR]
چاپ محیط یک دایرکتوری\N'46'
.TP 4
\fBexternal\N'45'lib\N'45'deps\fR [\fIOPTION\fR]…
چاپ کتابخانه‌های خارجی مورد نیاز برای ساخت پروژه\N'46' این یک مجموعه تقریبی از کتابخانه‌ها است\N'46'
.TP 4
\fBinstalled\N'45'libraries\fR [\fIOPTION\fR]…
چاپ کتابخانه‌های نصب‌شده روی سیستم\N'46'
.TP 4
\fBlocation\fR [\fIOPTION\fR]… \fIPROG\fR
چاپ مسیر فایل اجرایی با استفاده از منطق تفکیک مشابه [dune exec]\N'46'
.TP 4
\fBopam\N'45'files\fR [\fIOPTION\fR]…
چاپ اطلاعات درباره فایل‌های opam کشف‌شده\N'46'
.TP 4
\fBpackage\N'45'entries\fR [\fIOPTION\fR]…
چاپ اطلاعات درباره ورودی‌های هر بسته\N'46'
.TP 4
\fBpkg\fR \fICOMMAND\fR …
زیردستورهای مرتبط با مدیریت بسته
.TP 4
\fBpp\fR [\fIOPTION\fR]… \fIFILE\fR
ساخت یک FILE مشخص و چاپ خروجی پیش‌پردازش‌شده\N'46'
.TP 4
\fBrules\fR [\fIOPTION\fR]… [\fITARGET\fR]…
تخلیه قواعد ساخت\N'46'
.TP 4
\fBtargets\fR [\fIOPTION\fR]… [\fIDIR\fR]…
چاپ هدف‌ها در یک دایرکتوری مشخص\N'46' عملکردی مشابه ls دارد\N'46'
.TP 4
\fBtests\fR [\fIOPTION\fR]…
چاپ آزمون‌های تعریف‌شده در پروژه\N'46' قالب خروجی این دستور آزمایشی است و ممکن است بدون هشدار تغییر کند\N'46'
.TP 4
\fBworkspace\fR [\fIOPTION\fR]… [\fIDIRS\fR]…
چاپ توصیفی از ساختار فضای کاری\N'46' اگر چند دایرکتوری DIRS مشخص شوند، تنها آن دایرکتوری‌های فضای کاری در نظر گرفته می‌شوند\N'46'
.SH "گزینه‌های مشترک (COMMON OPTIONS)"
.TP 4
\fB\N'45'\N'45'help\fR[=\fIFMT\fR] (default=\fBauto\fR)
نمایش این راهنما در قالب \fIFMT\fR\N'46' مقدار \fIFMT\fR باید یکی از \fBauto\fR، \fBpager\fR، \fBgroff\fR یا \fBplain\fR باشد\N'46' با مقدار \fBauto\fR، هرگاه متغیر محیطی \fBTERM\fR برابر \fBdumb\fR باشد یا تعریف نشده باشد، قالب به صورت \fBpager\fR یا \fBplain\fR خواهد بود\N'46'
.TP 4
\fB\N'45'\N'45'version\fR
نمایش اطلاعات نسخه\N'46'
.SH "وضعیت خروج (EXIT STATUS)"
.P
دستور \fBdune show\fR با یکی از وضعیت‌های زیر خارج می‌شود:
.TP 4
0
در صورت موفقیت\N'46'
.TP 4
1
در صورت بروز خطا\N'46'
.TP 4
130
در صورتی که با یک سیگنال متوقف شده باشد\N'46'
.SH "همچنین ببینید (SEE ALSO)"
.P
dune(1)