\&\fBnbdfuse\fR\|(1),
\&\fBnbdinfo\fR\|(1),
\&\fBnbdsh\fR\|(1),
\&\fBnbdublk\fR\|(1),
\&\fBblkdiscard\fR\|(8),
\&\fBqemu\-img\fR\|(1).
