.nh
.TH "glab" "1" "Sep 2026" "Auto generated by spf13/cobra" ""

.SH "نام (NAME)"
glab-issue-list \- List project issues.


.SH "خلاصه دستور (SYNOPSIS)"
\fBglab issue list [flags]\fP


.SH "توضیحات (DESCRIPTION)"
Defaults to open items. Use \fB--group\fR to list for a group
instead of the current project.


.SH "گزینه‌ها (OPTIONS)"
\fB-A\fP, \fB--all\fP[=false]
	Get all issues.

.PP
\fB-a\fP, \fB--assignee\fP=""
	Filter issue by assignee \&.

.PP
\fB--author\fP=""
	Filter issue by author \&.

.PP
\fB-c\fP, \fB--closed\fP[=false]
	Get only closed issues.

.PP
\fB-C\fP, \fB--confidential\fP[=false]
	Filter by confidential issues.

.PP
\fB-e\fP, \fB--epic\fP=0
	List issues belonging to a given epic (requires --group, no pagination support).

.PP
\fB-g\fP, \fB--group\fP=""
	Select a group or subgroup. Ignored if a repo argument is set.

.PP
\fB--in\fP="title,description"
	Search in: title, description.

.PP
\fB-t\fP, \fB--issue-type\fP=""
	Filter issue by its type. Options: issue, incident, test_case.

.PP
\fB-i\fP, \fB--iteration\fP=0
	Filter issue by iteration \&.

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression.

.PP
\fB-l\fP, \fB--label\fP=[]
	Filter issue by label \&. Multiple labels can be comma-separated or specified by repeating the flag.

.PP
\fB-m\fP, \fB--milestone\fP=""
	Filter issue by milestone \&.

.PP
\fB--not-assignee\fP=""
	Filter issue by not being assigned to \&.

.PP
\fB--not-author\fP=""
	Filter issue by not being by author(s) \&.

.PP
\fB--not-label\fP=[]
	Filter issue by lack of label \&. Multiple labels can be comma-separated or specified by repeating the flag.

.PP
\fB--order\fP="created_at"
	Order issue by \&. Order options: created_at, updated_at, priority, due_date, relative_position, label_priority, milestone_due, popularity, weight.

.PP
\fB-O\fP, \fB--output\fP="text"
	Options: 'text' or 'json'.

.PP
\fB-F\fP, \fB--output-format\fP="details"
	Options: 'details', 'ids', 'urls'.

.PP
\fB-p\fP, \fB--page\fP=1
	Page number.

.PP
\fB-P\fP, \fB--per-page\fP=30
	Number of items to list per page.

.PP
\fB-R\fP, \fB--repo\fP=""
	Select another repository. You can use either OWNER/REPO or GROUP/NAMESPACE/REPO. The full URL or Git URL is also accepted.

.PP
\fB--search\fP=""
	Search  in the fields defined by '--in'.

.PP
\fB-s\fP, \fB--sort\fP="desc"
	Sort direction for --order field: asc or desc.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-h\fP, \fB--help\fP[=false]
	Show help for this command.


.SH "مثال (EXAMPLE)"
.EX
glab issue list --all
glab issue ls --all
glab issue list --assignee=@me
glab issue list --milestone release-2.0.0 --opened
.EE


.SH "همچنین ببینید (SEE ALSO)"
\fBglab-issue(1)\fP
