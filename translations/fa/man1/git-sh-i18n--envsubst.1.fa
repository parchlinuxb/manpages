.TH "GIT\-SH\-I18N\-\-ENVSUBST" "1" "2026\-06\-29" "Git 2\&.55\&.0" "Git Manual"
.\" -----------------------------------------------------------------
.\" * Define some portability stuff
.\" -----------------------------------------------------------------
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.\" http://bugs.debian.org/507673
.\" http://lists.gnu.org/archive/html/groff/2009-02/msg00013.html
.\" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
.ie \n(.g .ds Aq \(aq
.el       .ds Aq '
.\" -----------------------------------------------------------------
.\" * set default formatting
.\" -----------------------------------------------------------------
.\" disable hyphenation
.nh
.\" disable justification (adjust text to left margin only)
.ad l
.\" -----------------------------------------------------------------
.\" * MAIN CONTENT STARTS HERE *
.\" -----------------------------------------------------------------
.SH "نام (NAME)"
git-sh-i18n--envsubst \- نسخه اختصاصی envsubst(1) در گیت برای حالت‌های پشتیبان i18n
.SH "خلاصه دستور (SYNOPSIS)"
.sp
.nf
eval_gettext () {
        printf "%s" "$1" | (
                export PATH $(\fIgit sh\-i18n\-\-envsubst\fR \-\-variables "$1");
                \fIgit sh\-i18n\-\-envsubst\fR "$1"
        )
}
.fi
.sp
.SH "توضیحات (DESCRIPTION)"
.sp
این دستوری نیست که کاربر نهایی هرگز بخواهد آن را اجرا کند\&. به هیچ عنوان\&. این مستندات برای افرادی است که اسکریپت‌های زیرساختی (plumbing) را بررسی می‌کنند یا در حال نوشتن موارد جدید هستند\&.
.sp
برنامه
\fIgit sh\-i18n\-\-envsubst\fR
نسخه ساده‌شده گیت از برنامه
\fBenvsubst\fR(\fB1\fR)
گنو است که همراه با بسته GNU gettext ارائه می‌شود\&. این ابزار به صورت داخلی توسط
\fBgit-sh-i18n\fR(1)
برای درون‌یابی و جایگزینی متغیرهای ارسال‌شده به تابع
\fBeval_gettext\fR
استفاده می‌شود\&.
.sp
هیچ تضمینی در مورد رابط این ابزار داده نمی‌شود و ممکن است این برنامه بدون هشدار قبلی در نسخه بعدی گیت حذف شود\&. از آن استفاده نکنید\&.
.SH "گیت (GIT)"
.sp
بخشی از مجموعه \fBgit\fR(1)
